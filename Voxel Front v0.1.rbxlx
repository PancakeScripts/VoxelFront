						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Trails</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">15474ccd123c712a0af50f5100000be6</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC5A041FA21204A89933EBD5E28C989FE">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Viewport: harita ile ekran arasındaki dönüşüm (kaydırma + yakınlaştırma).
-- Saf matematik; Roblox API'si yok. Birim: zoom = tile başına ekran pikseli.
-- Ekran koordinatları görünüm çerçevesinin sol üst köşesine göredir.
--
-- Sınırlar:
--   * Uzaklaşma: kamera, haritayı sığdıran görünümden en fazla `zoomOutSlack` (varsayılan %20) daha geniş olabilir.
--   * Kaydırma: kamera haritanın dışına, kamera boyutunun en fazla `panOvershoot` (varsayılan %40) kadar taşabilir.

local Viewport = {}
Viewport.__index = Viewport

export type Options = {
	zoomOutSlack: number?,
	panOvershoot: number?,
	maxZoom: number?,
}

export type Viewport = typeof(setmetatable(
	{} :: {
		mapW: number,
		mapH: number,
		viewW: number,
		viewH: number,
		zoom: number,
		minZoom: number,
		maxZoom: number,
		zoomOutSlack: number,
		panOvershoot: number,
		x: number, -- haritanın sol üst köşesinin ekran konumu
		y: number,
	},
	Viewport
))

local DEFAULT_SLACK = 0.2
local DEFAULT_OVERSHOOT = 0.4
local DEFAULT_MAX_ZOOM = 32

local function clampNum(v: number, lo: number, hi: number): number
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

-- Haritanın tamamını ekrana sığdıran zoom.
local function fitZoom(mapW: number, mapH: number, viewW: number, viewH: number): number
	return math.min(viewW / mapW, viewH / mapH)
end

-- Bir eksende izin verilen konum aralığı. Harita kenarı ekranda
-- [(1 - ov) * view - mapPx, ov * view] içinde kalır; aralık ters çıkarsa ortalanır.
local function axisRange(viewPx: number, mapPx: number, overshoot: number): (number, number)
	local lo = (1 - overshoot) * viewPx - mapPx
	local hi = overshoot * viewPx
	if lo > hi then
		local mid = (lo + hi) / 2
		return mid, mid
	end
	return lo, hi
end

function Viewport.new(mapW: number, mapH: number, viewW: number, viewH: number, options: Options?): Viewport
	assert(mapW > 0 and mapH > 0 and viewW > 0 and viewH > 0, "dimensions must be positive")
	local opts: Options = options or {}
	local self = setmetatable({
		mapW = mapW,
		mapH = mapH,
		viewW = viewW,
		viewH = viewH,
		zoom = 1,
		minZoom = 0.1,
		maxZoom = opts.maxZoom or DEFAULT_MAX_ZOOM,
		zoomOutSlack = opts.zoomOutSlack or DEFAULT_SLACK,
		panOvershoot = opts.panOvershoot or DEFAULT_OVERSHOOT,
		x = 0,
		y = 0,
	}, Viewport)
	self:fit()
	return self
end

function Viewport.updateMinZoom(self: Viewport)
	self.minZoom = fitZoom(self.mapW, self.mapH, self.viewW, self.viewH) / (1 + self.zoomOutSlack)
end

function Viewport.clampPosition(self: Viewport)
	local w = self.mapW * self.zoom
	local h = self.mapH * self.zoom
	local loX, hiX = axisRange(self.viewW, w, self.panOvershoot)
	local loY, hiY = axisRange(self.viewH, h, self.panOvershoot)
	self.x = clampNum(self.x, loX, hiX)
	self.y = clampNum(self.y, loY, hiY)
end

-- Başlangıç görünümü: harita ekranı tamamen kaplar (dışı görünmez; taşan kenarlar kaydırarak görülür) ve ortalanır.
-- En çok uzaklaşma yine tüm haritayı sığdıran görünüme göre (minZoom).
function Viewport.fit(self: Viewport)
	self:updateMinZoom()
	local cover = math.max(self.viewW / self.mapW, self.viewH / self.mapH)
	self.zoom = clampNum(cover, self.minZoom, self.maxZoom)
	self.x = (self.viewW - self.mapW * self.zoom) / 2
	self.y = (self.viewH - self.mapH * self.zoom) / 2
end

function Viewport.resize(self: Viewport, viewW: number, viewH: number)
	if viewW <= 0 or viewH <= 0 then
		return
	end
	self.viewW = viewW
	self.viewH = viewH
	self:updateMinZoom()
	self.zoom = clampNum(self.zoom, self.minZoom, self.maxZoom)
	self:clampPosition()
end

function Viewport.panBy(self: Viewport, dx: number, dy: number)
	self.x += dx
	self.y += dy
	self:clampPosition()
end

-- Ekran noktasının (sx, sy) altındaki harita noktası yerinde kalacak şekilde zoom'u değiştirir.
function Viewport.zoomAt(self: Viewport, sx: number, sy: number, newZoom: number)
	local z = clampNum(newZoom, self.minZoom, self.maxZoom)
	local wx = (sx - self.x) / self.zoom
	local wy = (sy - self.y) / self.zoom
	self.zoom = z
	self.x = sx - wx * z
	self.y = sy - wy * z
	self:clampPosition()
end

-- Dünya noktası (wx, wy; tile birimi) ekranın ortasına gelecek şekilde konumlanır, zoom verilir.
function Viewport.centerOn(self: Viewport, wx: number, wy: number, zoom: number)
	self.zoom = clampNum(zoom, self.minZoom, self.maxZoom)
	self.x = self.viewW / 2 - wx * self.zoom
	self.y = self.viewH / 2 - wy * self.zoom
	self:clampPosition()
end

-- Ekranın ortasındaki dünya noktası (tile birimi).
function Viewport.center(self: Viewport): (number, number)
	return (self.viewW / 2 - self.x) / self.zoom, (self.viewH / 2 - self.y) / self.zoom
end

-- Ekran noktası -> tile koordinatı (x, y). Harita dışındaysa nil.
function Viewport.screenToTile(self: Viewport, sx: number, sy: number): (number?, number?)
	local tx = math.floor((sx - self.x) / self.zoom)
	local ty = math.floor((sy - self.y) / self.zoom)
	if tx < 0 or ty < 0 or tx >= self.mapW or ty >= self.mapH then
		return nil, nil
	end
	return tx, ty
end

-- Haritanın ekrandaki konumu ve boyutu (ImageLabel için).
function Viewport.rect(self: Viewport): (number, number, number, number)
	return self.x, self.y, self.mapW * self.zoom, self.mapH * self.zoom
end

return Viewport
]]></ProtectedString>
