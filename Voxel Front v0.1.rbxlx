				<Item class="ModuleScript" referent="RBXEF318513095A4804BDED4CB47227B422">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- WorldLayer: harita boyutunda üç şeffaf katman (alt: izler, yollar ve menzil daireleri; orta: yapı simgeleri;
-- üst: efektler ve çubuklar).
-- İçindeki her şey ÖLÇEK (Scale) koordinatıyla yerleşir: katman haritayla birlikte kaydırılıp büyütüldüğü için
-- çocukların konumu/boyu her karede yeniden hesaplanmaz (yalnız katmanın kendisi taşınır).
-- Dönmüş çizgiler doğru çıkar çünkü harita yatay ve dikey aynı oranda büyür.

local WorldLayer = {}
WorldLayer.__index = WorldLayer

export type WorldLayer = typeof(setmetatable(
	{} :: {
		under: Frame,
		mid: Frame,
		over: Frame,
		w: number,
		h: number,
	},
	WorldLayer
))

local function layer(parent: Instance, name: string, z: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.ZIndex = z
	f.Active = false
	f.ClipsDescendants = false
	f.Parent = parent
	return f
end

function WorldLayer.new(parent: Instance, mapW: number, mapH: number, zUnder: number, zOver: number, zMid: number?): WorldLayer
	return setmetatable({
		under = layer(parent, "WorldUnder", zUnder),
		mid = layer(parent, "WorldStructures", zMid or zUnder + 1),
		over = layer(parent, "WorldOver", zOver),
		w = mapW,
		h = mapH,
	}, WorldLayer)
end

-- Harita görüntüsünün ekrandaki yeri: (x, y) sol üst köşe, zoom = tile başına piksel.
function WorldLayer.place(self: WorldLayer, x: number, y: number, zoom: number)
	local pos = UDim2.fromOffset(x, y)
	local size = UDim2.fromOffset(self.w * zoom, self.h * zoom)
	self.under.Position = pos
	self.under.Size = size
	self.mid.Position = pos
	self.mid.Size = size
	self.over.Position = pos
	self.over.Size = size
end

-- Tile koordinatından (ondalıklı) katman içi konum.
function WorldLayer.at(self: WorldLayer, x: number, y: number): UDim2
	return UDim2.fromScale(x / self.w, y / self.h)
end

-- Tile birimiyle boy (+ en az piksel).
function WorldLayer.size(self: WorldLayer, wTiles: number, hTiles: number, minPxW: number?, minPxH: number?): UDim2
	return UDim2.new(wTiles / self.w, minPxW or 0, hTiles / self.h, minPxH or 0)
end

-- Bir Frame'i (x0,y0)-(x1,y1) arasında `thick` tile kalınlığında çizgi yapar (uçlar kalınlığın yarısı kadar uzatılır,
-- böylece ardışık parçalar arasında boşluk kalmaz).
function WorldLayer.line(self: WorldLayer, f: Frame, x0: number, y0: number, x1: number, y1: number, thick: number, minPx: number)
	local dx, dy = x1 - x0, y1 - y0
	local len = math.sqrt(dx * dx + dy * dy) + thick
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale((x0 + x1) / 2 / self.w, (y0 + y1) / 2 / self.h)
	f.Size = UDim2.new(len / self.w, minPx, thick / self.h, minPx)
	f.Rotation = math.deg(math.atan2(dy, dx))
end

return WorldLayer
]]></ProtectedString>
						<string name="ScriptGuid">{239C950A-ADA3-4E9C-83F8-83CC3558FBD2}</string>
