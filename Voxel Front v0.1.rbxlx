						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">624560e9eb8305f10afdb98300001ca5</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX4A561E00A5EB4EC3BA7809F4EE574014">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Tutorial: yeni oyuncunun ilk solo maçı, adım adım. RoWorld src/client/UI/Tutorial.luau ve src/shared/Data/Tutorial.luau'dan
-- uyarlandı (AGPL-3.0, © 2026 Snick Co.); değerler ve sıra onunki, metinler bizim kontrollerimize göre. Bir seferde tek hedef:
--   * ekranın üstünde (üst barın altında) kart: "2 / 6", tek satır, gerekiyorsa ilerleme çubuğu ve Skip;
--   * dokunulacak / tıklanacak yerde işaret (içe kapanan iki halka, nokta, altında "Tap here" / "Click here"); oyuncu emir
--     verince NUDGE_S boyunca gizlenir, ekran dışındaysa kenarda durur;
--   * biten adımda kart kısa süre yeşile döner ("Nice!", ses), sonra sıradaki gelir; sonda "Tutorial complete!" kartı.
-- Başlangıç adımında kart yok (üstte başlangıç şeridi var): işaret geniş boş bir yeri gösterir, AUTO_SPAWN_S'de oyuncu adına
-- seçilir. Şehir adımında altın bir şehir fiyatına tamamlanır. Yapılamayan adım STEP_MAX_S'de atlanır (hiçbir adımda takılınmaz).
-- Tutorial sürerken saldırı çubuğu RATIO_CAP'te durur; saldırı adımından sonra emirler ordunun tavanının TROOP_FLOOR'unu evde
-- bırakır; tutorial'dan sonra ilk ROOKIE_MATCHES maçta ROOKIE_FLOOR (t:floor, Client.orderRatio).
-- Her adım sunucuya bildirilir: Creator Hub > Analytics > Funnels > "Tutorial" (Server.Profile.FUNNEL).
--
--   Tutorial.watchNewPlayer(menu)   yeni oyuncu ana menüde bekliyorsa ilk maçı tutorial olarak başlatır
--   Tutorial.new(deps) -> t         t:begin() / t:onOrder(owner, boat) / t:stop(how) / t:floor(mine) / t.active

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Fonts = require(Shared:WaitForChild("Fonts"))

local Tutorial = {}
Tutorial.__index = Tutorial

-- (RoWorld Data/Tutorial değerleri)
Tutorial.AUTO_SPAWN_S = 12
Tutorial.GROW_READY = 0.3
Tutorial.EARLY_S = 2.0
Tutorial.CONTACT_WAIT_S = 25
Tutorial.RATIO_GOAL = 0.35
Tutorial.RATIO_LOW = 0.3
Tutorial.RATIO_HIGH = 0.4
Tutorial.RATIO_HOLD_S = 0.2
Tutorial.RATIO_MAX_S = 30
Tutorial.STEP_MAX_S = 75
Tutorial.NUDGE_S = 5
Tutorial.DONE_S = 0.9
Tutorial.END_S = 9
Tutorial.RATIO_CAP = 0.5
Tutorial.TROOP_FLOOR = 0.25
Tutorial.FLOOR_ARM = 0.35
Tutorial.FLOOR_ARM_S = 10
Tutorial.ROOKIE_MATCHES = 5
Tutorial.ROOKIE_FLOOR = 0.2
Tutorial.START_DELAY_S = 0.9
Tutorial.NO_TARGET_S = 3 -- (büyüme adımları: kara yoluyla boş komşu kara yoksa — ada dolduysa — adım bu sürede atlanır)
Tutorial.FLOOR_REASON = "Troops low. Let them grow back"
Tutorial.FLOOR_TIP = string.format(
	"Keep %d%% of your army at home, or neighbours walk right in. In your first %d matches, attacks hold that much back.",
	math.floor(Tutorial.ROOKIE_FLOOR * 100 + 0.5),
	Tutorial.ROOKIE_MATCHES
)

local AMBER = Color3.fromRGB(255, 181, 71)
local GREEN = Color3.fromRGB(34, 197, 94)
local CARD_BG = Color3.fromRGB(15, 23, 42)
local WHITE = Color3.fromRGB(241, 245, 249)

-- Adımlar (sırayla). touch / desktop: kartın yazısı; %s komşunun adı. funnel: Server.Profile.FUNNEL'daki adım.
Tutorial.STEPS = {
	{ id = "spawn", funnel = 2, touch = "Tap the map to start your nation", desktop = "Click the map to start your nation" },
	{ id = "expand", funnel = 3, touch = "Tap the land next to you, then press Attack", desktop = "Click the land next to you to take it" },
	{
		id = "grow",
		funnel = 4,
		touch = "Tap empty land, then press Attack",
		desktop = "Click empty land to expand",
		wait = "Now let your troops refill",
		early = "Done! Next time, let the bar fill",
	},
	{ id = "attack", funnel = 5, touch = "Tap %s, then press Attack", desktop = "Click %s's land to attack them" },
	{
		id = "ratio",
		funnel = 6,
		touch = "Tap 35% on the Attack bar. Keep troops home!",
		desktop = "Click 35% on the Attack bar. Keep troops home!",
		tooMuch = "Too many! Set it to 35%",
	},
	{
		id = "city",
		funnel = 7,
		touch = "Open BUILD, pick City, tap your land",
		desktop = "Pick City (1) and click your land",
		note = "Here is gold for your first City",
	},
}
local ATTACK_STEP = 4

-- Yeni oyuncu ------------------------------------------------------------------------------------------------------

-- Yeni oyuncunun ilk maçı kendiliğinden başlar (RoWorld UIRoot._check_new_player): sunucunun profil kaydı gelene dek
-- bekler (yavaş telefonda geç yüklenen oyun için süre sınırı yok), ana menü START_DELAY_S boyunca ekranda kalırsa başlatır.
-- Oyuncu o sırada kendisi solo oynarsa tutorial o maçta çalışır (Session.tutorial "pending" -> "run"); online maça
-- giderse bir sonraki solo maçında. Studio: workspace özniteliği DevTutorial = true ise yeni sayılır.
function Tutorial.watchNewPlayer(menu: any)
	local Session = require(Shared:WaitForChild("Session")) :: any
	if Session.tutorial ~= nil then
		return -- (bu oturumda karar verildi)
	end
	task.spawn(function()
		local me = Players.LocalPlayer
		local dev = RunService:IsStudio() and workspace:GetAttribute("DevTutorial") == true
		while not dev and me:GetAttribute("FrontlineNew") == nil do
			task.wait(0.5)
		end
		if Session.tutorial ~= nil or not (dev or me:GetAttribute("FrontlineNew") == true) then
			return
		end
		Session.tutorial = "pending"
		local since: number? = nil
		while Session.tutorial == "pending" do
			if menu.current == menu.main and menu.open == "main" then
				since = since or os.clock()
				if os.clock() - (since :: number) >= Tutorial.START_DELAY_S then
					menu:startTutorial()
					return
				end
			else
				since = nil
			end
			task.wait(0.1)
		end
	end)
end

-- Arayüz -------------------------------------------------------------------------------------------------------------

--- Bir arayüz öğesinin ekrandaki ortası (görünmüyorsa nil).
function Tutorial.center(g: GuiObject?): Vector2?
	if g == nil or not g.Visible then
		return nil
	end
	return g.AbsolutePosition + g.AbsoluteSize / 2
end

local function corner(parent: Instance, r: UDim)
	local c = Instance.new("UICorner")
	c.CornerRadius = r
	c.Parent = parent
end

local function label(parent: Instance, name: string, size: number, color: Color3, weight: Enum.FontWeight): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.FontFace = Font.fromId(Fonts.ID, weight)
	l.TextSize = size
	l.TextColor3 = color
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.TextWrapped = true
	l.Text = ""
	l.ZIndex = 96
	l.Parent = parent
	return l
end

function Tutorial.new(deps: any)
	local self = setmetatable({}, Tutorial)
	self.deps = deps
	self.active = false
	self.i = 0
	self.stepT = 0
	self.idle = 99
	self.flash = 0
	self.flashText = ""
	self.ending = 0
	self.matchesBefore = 0
	self.floorTold = false
	self.runAt = nil
	local gui: ScreenGui = deps.gui

	-- kart
	local card = Instance.new("Frame")
	card.Name = "TutorialCard"
	card.AnchorPoint = Vector2.new(0.5, 0)
	card.BackgroundColor3 = CARD_BG
	card.BackgroundTransparency = 0.08
	card.BorderSizePixel = 0
	card.ZIndex = 95
	card.Visible = false
	corner(card, UDim.new(0, 12))
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = AMBER
	stroke.Transparency = 0.5
	stroke.Thickness = 1.5
	stroke.Parent = card
	self.count = label(card, "Count", 12, AMBER, Enum.FontWeight.ExtraBold)
	self.count.TextXAlignment = Enum.TextXAlignment.Center
	self.text = label(card, "Text", 14, WHITE, Enum.FontWeight.Bold)
	self.note = label(card, "Note", 11, Color3.fromRGB(148, 163, 184), Enum.FontWeight.Bold)
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.BackgroundColor3 = Color3.new(1, 1, 1)
	bar.BackgroundTransparency = 0.85
	bar.BorderSizePixel = 0
	bar.ZIndex = 96
	corner(bar, UDim.new(0.5, 0))
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = AMBER
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(0, 1)
	fill.ZIndex = 97
	corner(fill, UDim.new(0.5, 0))
	fill.Parent = bar
	bar.Parent = card
	local skip = Instance.new("TextButton")
	skip.Name = "Skip"
	skip.BackgroundColor3 = Color3.fromRGB(51, 65, 85)
	skip.BackgroundTransparency = 0.3
	skip.BorderSizePixel = 0
	skip.FontFace = Font.fromId(Fonts.ID, Enum.FontWeight.Bold)
	skip.TextSize = 12
	skip.TextColor3 = WHITE
	skip.Text = "Skip"
	skip.ZIndex = 97
	corner(skip, UDim.new(0, 8))
	skip.Parent = card
	skip.Activated:Connect(function()
		if self.ending > 0 then
			self:_hide()
		elseif self.active then
			self:stop("skipped")
		end
	end)
	card.Parent = gui
	self.card, self.stroke, self.bar, self.fill, self.skip = card, stroke, bar, fill, skip

	-- dokunma işareti
	local mark = Instance.new("Frame")
	mark.Name = "TutorialMark"
	mark.AnchorPoint = Vector2.new(0.5, 0.5)
	mark.BackgroundTransparency = 1
	mark.Size = UDim2.fromOffset(0, 0)
	mark.ZIndex = 94
	mark.Visible = false
	local function ring(name: string, thick: number): Frame
		local r = Instance.new("Frame")
		r.Name = name
		r.AnchorPoint = Vector2.new(0.5, 0.5)
		r.Position = UDim2.fromScale(0.5, 0.5)
		r.BackgroundTransparency = 1
		r.ZIndex = 94
		corner(r, UDim.new(0.5, 0))
		local s = Instance.new("UIStroke")
		s.Color = AMBER
		s.Thickness = thick
		s.Parent = r
		r.Parent = mark
		return r
	end
	self.ringA = ring("RingA", 3)
	self.ringB = ring("RingB", 2)
	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(12, 12)
	dot.BackgroundColor3 = AMBER
	dot.BorderSizePixel = 0
	dot.ZIndex = 95
	corner(dot, UDim.new(0.5, 0))
	dot.Parent = mark
	local tap = Instance.new("TextLabel")
	tap.Name = "Tap"
	tap.AnchorPoint = Vector2.new(0.5, 0)
	tap.Position = UDim2.new(0.5, 0, 0.5, 26)
	tap.AutomaticSize = Enum.AutomaticSize.XY
	tap.Size = UDim2.new()
	tap.BackgroundColor3 = Color3.fromRGB(14, 20, 38)
	tap.BackgroundTransparency = 0.15
	tap.FontFace = Font.fromId(Fonts.ID, Enum.FontWeight.Bold)
	tap.TextSize = 13
	tap.TextColor3 = WHITE
	tap.Text = if deps.touch then "Tap here" else "Click here"
	tap.ZIndex = 95
	corner(tap, UDim.new(0.5, 0))
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 9)
	pad.PaddingRight = UDim.new(0, 9)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = tap
	tap.Parent = mark
	-- işaret fareyi / dokunmayı tutmaz: altındaki haritaya tıklanır (RoWorld MOUSE_IGNORE)
	for _, g in mark:GetDescendants() do
		if g:IsA("GuiObject") then
			g.Interactable = false
			g.Active = false
		end
	end
	mark.Interactable = false
	mark.Active = false
	mark.Parent = gui
	self.mark = mark
	return self
end

function Tutorial._hide(self: any)
	self.ending = 0
	self.card.Visible = false
	self.mark.Visible = false
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
end

-- Kartın yazısı ve düzeni (çubuk / not satırı varsa uzar).
function Tutorial._setCard(self: any, count: string, text: string, barFrac: number?, note: string?, done: boolean?)
	local deps = self.deps
	local screen = deps.gui.AbsoluteSize
	local w = math.floor(math.min(460, screen.X * 0.92))
	local h = 52 + (if note then 16 else 0) + (if barFrac then 8 else 0)
	self.card.Size = UDim2.fromOffset(w, h)
	local skipW = 56
	self.count.Text = count
	self.count.Position = UDim2.fromOffset(8, 0)
	self.count.Size = UDim2.fromOffset(40, h)
	self.count.Visible = count ~= ""
	local x0 = if count ~= "" then 52 else 14
	local tw = w - x0 - skipW - 18
	self.text.Text = text
	self.text.Position = UDim2.fromOffset(x0, 6)
	self.text.Size = UDim2.fromOffset(tw, 40)
	self.note.Visible = note ~= nil
	self.note.Text = note or ""
	self.note.Position = UDim2.fromOffset(x0, 44)
	self.note.Size = UDim2.fromOffset(tw, 14)
	self.bar.Visible = barFrac ~= nil
	self.bar.Position = UDim2.fromOffset(x0, h - 12)
	self.bar.Size = UDim2.fromOffset(tw, 5)
	self.fill.Size = UDim2.fromScale(math.clamp(barFrac or 0, 0, 1), 1)
	self.skip.Position = UDim2.fromOffset(w - skipW - 10, math.floor((h - 32) / 2))
	self.skip.Size = UDim2.fromOffset(skipW, 32)
	local col = if done then GREEN else AMBER
	self.stroke.Color = col
	self.count.TextColor3 = col
	self.fill.BackgroundColor3 = col
	self.card.BackgroundColor3 = if done then Color3.fromRGB(20, 83, 45) else CARD_BG
	local origin = deps.gui.AbsolutePosition
	self.card.Position = UDim2.fromOffset(screen.X / 2, deps.topY() - origin.Y)
	self.card.Visible = true
end

-- İşaret: mutlak ekran noktası (nil: gizli); ekran dışındaysa kenarda. onMap: haritadaki bir yer (arayüzün üstüne
-- çıkmasın diye haritanın açık kısmında tutulur: deps.freeRect).
function Tutorial._setMark(self: any, p: Vector2?, onMap: boolean?)
	if p == nil or self.idle < Tutorial.NUDGE_S then
		self.mark.Visible = false
		return
	end
	local gui = self.deps.gui
	local origin, size = gui.AbsolutePosition, gui.AbsoluteSize
	local ax, ay = p.X, p.Y
	if onMap and self.deps.freeRect then
		local x0, y0, x1, y1 = self.deps.freeRect()
		ax, ay = math.clamp(ax, x0, x1), math.clamp(ay, y0, y1)
	end
	local x = math.clamp(ax - origin.X, 24, size.X - 24)
	local y = math.clamp(ay - origin.Y, 24, size.Y - 48)
	self.mark.Position = UDim2.fromOffset(x, y)
	self.mark.Visible = true
	local t = os.clock()
	for k, r in { self.ringA, self.ringB } do
		local ph = (t * 0.9 + (k - 1) * 0.5) % 1
		local d = 56 - 36 * ph
		r.Size = UDim2.fromOffset(d, d)
		r:FindFirstChildOfClass("UIStroke").Transparency = 0.2 + 0.7 * ph
	end
end

-- Akış ---------------------------------------------------------------------------------------------------------------

function Tutorial.begin(self: any)
	if self.active then
		return
	end
	self.active = true
	self.i = 1
	self.stepT = 0
	self.idle = 99
	self.flash = 0
	self.shown = 0
	self.seenPlaying = false
	self.waitStart = os.clock()
	self.deps.report(1) -- "Started"
	self.conn = RunService.RenderStepped:Connect(function(dt: number)
		local ok, err = pcall(self.update, self, dt)
		if not ok then
			warn("[Frontline] tutorial: " .. tostring(err))
			self:stop("left")
		end
	end)
end

-- how: "done" | "skipped" | "left" (maçtan çıktı / elendi / tur bitti)
function Tutorial.stop(self: any, how: string)
	if not self.active then
		return
	end
	self.active = false
	self.mark.Visible = false
	local step = Tutorial.STEPS[self.i]
	self.deps.finish(how, if step then step.funnel else 8)
	if how == "done" then
		self.deps.report(8) -- "Completed"
		self.deps.sound("tutorialDone")
		self.ending = Tutorial.END_S
		self:_setCard("", "Tutorial complete! You're ready to conquer the world.", nil, nil, true)
		self.skip.Text = "OK"
		task.delay(Tutorial.END_S, function()
			if not self.active and self.ending > 0 then
				self:_hide()
			end
		end)
	else
		self:_hide()
	end
end

-- Oyuncu bir saldırı / genişleme / gemi emri verdi (Client.floatAttack).
function Tutorial.onOrder(self: any, owner: number, boat: boolean)
	self.idle = 0
	if not self.active or self.flash > 0 then
		return
	end
	local step = Tutorial.STEPS[self.i]
	if not step then
		return
	end
	if step.id == "expand" and owner == 0 and not boat then
		self:_done(nil)
	elseif step.id == "grow" and owner == 0 then
		self:_done(if self.waiting then step.early else nil)
	elseif step.id == "attack" and owner ~= 0 then
		self:_done(nil)
	end
end

-- Adım bitti: kart yeşil (DONE_S; erken genişlemede EARLY_S), ses, huni adımı; passed: süresi doldu, atlandı (bildirilmez).
function Tutorial._done(self: any, text: string?, passed: boolean?)
	local step = Tutorial.STEPS[self.i]
	if not passed and step then
		self.deps.report(step.funnel)
		self.deps.sound("tutorialStep")
	end
	self.flash = if text then Tutorial.EARLY_S else (if passed then 0 else Tutorial.DONE_S)
	self.flashText = text or "Nice!"
	self.i += 1
	self.stepT = 0
	self.shown = 0
	self.waiting = false
	self.target = nil
	self.noTarget = 0
	if self.i > #Tutorial.STEPS then
		self.flash = 0
		self:stop("done")
		return
	end
	if Tutorial.STEPS[self.i].id == "city" then
		self.deps.giveCityGold()
	end
end

-- Ordunun evde kalacak payı (0 = yok): tutorial'ın saldırı adımından itibaren TROOP_FLOOR, sonra ilk maçlarda ROOKIE_FLOOR.
-- Taban ordu tavanının FLOOR_ARM'ına ulaşınca ya da oyun FLOOR_ARM_S sürünce kurulur (yeni ülke tavanın altında başlar).
function Tutorial.floor(self: any, mine: any): number
	if mine == nil or (mine.max or 0) <= 0 then
		return 0
	end
	local played = if self.runAt then os.clock() - self.runAt else 0
	if played < Tutorial.FLOOR_ARM_S and mine.troops < Tutorial.FLOOR_ARM * mine.max then
		return 0
	end
	if self.active then
		return if self.i >= ATTACK_STEP then Tutorial.TROOP_FLOOR else 0
	end
	return if self.matchesBefore < Tutorial.ROOKIE_MATCHES then Tutorial.ROOKIE_FLOOR else 0
end

-- Taban bir emri kırptı: ilk maçlarda bir kez nedeni söylenir (RoWorld Coach "floor").
function Tutorial.floorUsed(self: any)
	if not self.active and not self.floorTold then
		self.floorTold = true
		self.deps.toast(Tutorial.FLOOR_TIP)
	end
end

function Tutorial.update(self: any, dt: number)
	if not self.active then
		return
	end
	local deps = self.deps
	local phase = deps.phase()
	self.idle += dt
	if phase == "run" and self.runAt == nil then
		self.runAt = os.clock()
	end
	-- maçtan çıktı / elendi / tur bitti: tutorial biter (oyuncu henüz maça girerken bir süre beklenir)
	if deps.playing() then
		self.seenPlaying = true
	elseif self.seenPlaying or os.clock() - self.waitStart > 20 then
		self:stop("left")
		return
	end
	if phase == "ended" then
		self:stop("left")
		return
	end
	local count = string.format("%d / %d", self.i, #Tutorial.STEPS)
	-- biten adımın yeşil kartı bir an durur
	if self.flash > 0 then
		self.flash -= dt
		self:_setCard(string.format("%d / %d", self.i - 1, #Tutorial.STEPS), self.flashText, nil, nil, true)
		self.mark.Visible = false
		return
	end
	local step = Tutorial.STEPS[self.i]
	local text = if deps.touch then step.touch else step.desktop
	if step.id == "spawn" then
		-- kart yok (başlangıç şeridi var); işaret geniş boş bir yerde, AUTO_SPAWN_S'de oyuncu adına seçilir
		self.card.Visible = false
		if deps.spawned() or phase == "run" then
			self:_done(nil)
			self.flash = 0 -- (başlangıç şeridi zaten görünüyor)
			return
		end
		self.stepT += dt
		self.scanT = (self.scanT or 0) - dt
		if (self.target == nil or not deps.isFree(self.target)) and self.scanT <= 0 then
			self.scanT = 0.5
			self.target = deps.spawnSpot()
		end
		self.idle = 99
		self:_setMark(if self.target then deps.tileScreen(self.target) else nil, true)
		if self.stepT >= Tutorial.AUTO_SPAWN_S and self.target then
			deps.spawnAt(self.target)
			self.stepT = -2 -- (bir kez; sunucu cevabı gelene dek beklenir)
		end
		return
	end
	if phase ~= "run" then
		self.card.Visible = false
		self.mark.Visible = false
		return
	end
	self.stepT += dt
	local limit = if step.id == "ratio" then Tutorial.RATIO_MAX_S else Tutorial.STEP_MAX_S
	if self.stepT >= limit then
		self:_done(nil, true)
		return
	end
	-- hedef yeri her yarım saniyede bir yenilenir (tarama)
	self.scanT = (self.scanT or 0) - dt
	local rescan = self.scanT <= 0
	if rescan then
		self.scanT = 0.5
	end
	local markAt: Vector2? = nil
	local onMap = false
	local barFrac: number? = nil
	-- büyüme adımlarında boş komşu kara kalmadıysa adım atlanır
	local needsLand = step.id == "expand" or (step.id == "grow" and not self.waiting)
	if needsLand and self.target == nil and self.stepT > 1 then
		self.noTarget = (self.noTarget or 0) + dt
		if self.noTarget >= Tutorial.NO_TARGET_S then
			self:_done(nil, true)
			return
		end
	else
		self.noTarget = 0
	end
	local note: string? = nil
	if step.id == "expand" then
		if rescan then
			self.target = deps.emptyNeighbor(self.target)
		end
		markAt = deps.cardAttack()
		if markAt == nil and self.target then
			markAt, onMap = deps.tileScreen(self.target), true
		end
	elseif step.id == "grow" then
		local mine = deps.mine()
		local need = if mine then Tutorial.GROW_READY * mine.max else 0
		local f = if need > 0 then math.clamp(mine.troops / need, 0, 1) else 1
		self.shown = math.max(f, self.shown or 0)
		self.waiting = self.shown < 1
		barFrac = self.shown
		if self.waiting then
			text = step.wait
			markAt = deps.troopsScreen()
		else
			if rescan then
				self.target = deps.emptyNeighbor(self.target)
			end
			markAt = deps.cardAttack()
			if markAt == nil and self.target then
				markAt, onMap = deps.tileScreen(self.target), true
			end
		end
	elseif step.id == "attack" then
		if rescan then
			self.target, self.targetName = deps.enemyNeighbor(self.target)
		end
		if self.target == nil then
			-- komşu yoksa CONTACT_WAIT_S sonra atlanır
			if self.stepT >= Tutorial.CONTACT_WAIT_S then
				self:_done(nil, true)
				return
			end
			text = if deps.touch then (string.gsub(step.touch, "%%s", "a neighbour")) else "Click a neighbour's land to attack them"
		else
			text = string.format(text, self.targetName or "?")
			markAt = deps.cardAttack()
			if markAt == nil then
				markAt, onMap = deps.tileScreen(self.target), true
			end
		end
	elseif step.id == "ratio" then
		local r = deps.ratio()
		if r > Tutorial.RATIO_HIGH + 1e-6 then
			text = step.tooMuch
		end
		if r >= Tutorial.RATIO_LOW - 1e-6 and r <= Tutorial.RATIO_HIGH + 1e-6 then
			self.hold = (self.hold or 0) + dt
			if self.hold >= Tutorial.RATIO_HOLD_S then
				self.hold = 0
				self:_done(nil)
				return
			end
		else
			self.hold = 0
		end
		self.idle = 99
		markAt = deps.sliderScreen(Tutorial.RATIO_GOAL)
	elseif step.id == "city" then
		if deps.hasCity() then
			self:_done(nil)
			return
		end
		note = step.note
		self.idle = 99
		markAt = deps.cityScreen()
	end
	self:_setCard(count, text, barFrac, note, false)
	self:_setMark(markAt, onMap)
end

return Tutorial
]]></ProtectedString>
