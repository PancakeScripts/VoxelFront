				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX9AAD517F4B094F05A1C15566D0AC216B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- OnlineConfig: Solo Online kimlere açık. Üç durum:
--   "off"       kimse göremez (kapatma anahtarı: süren maçlar biter, yenisi açılmaz)
--   "allowlist" yalnız izin listesindekiler (yayında deneme)
--   "public"    herkes
-- Team Online (takım maçları) ayrıca açılır / kapanır (TEAMS_DEFAULT_MODE, aynı üç durum); Solo Online kapalıysa o da kapalıdır.
-- Kodda DEFAULT_MODE, TEAMS_DEFAULT_MODE ve ALLOWLIST yazılıdır. Yayınlamadan değiştirmek için DataStore "frontline_config" /
-- anahtar "online":
--   "off" | "allowlist" | "public"  ya da  { "mode": "allowlist", "teams": "off", "users": [123, 456] }
--   (users listeye eklenir; teams yoksa TEAMS_DEFAULT_MODE)
-- (Creator Hub > Data Stores'tan ya da Studio'dan yazılır.) Her sunucu değeri REFRESH_S'de bir okur.

local OnlineConfig = {}

OnlineConfig.DEFAULT_MODE = "public"
--- Team Online: herkese açık (2026-11-05).
OnlineConfig.TEAMS_DEFAULT_MODE = "public"
--- İzin listesi (Roblox kullanıcı kimlikleri). 504990884: oyunun geliştiricisi.
OnlineConfig.ALLOWLIST = { 504990884 }
OnlineConfig.STORE = "frontline_config"
OnlineConfig.KEY = "online"
OnlineConfig.REFRESH_S = 60

OnlineConfig.mode = OnlineConfig.DEFAULT_MODE
OnlineConfig.teamsMode = OnlineConfig.TEAMS_DEFAULT_MODE
OnlineConfig.extra = {} :: { [number]: boolean }

local function valid(mode: any): boolean
	return mode == "off" or mode == "allowlist" or mode == "public"
end

--- Bu sunucuda eşleştirme (Hub) çalışır mı. Kimin göreceğini mode / allowed belirler.
function OnlineConfig.enabled(): boolean
	return true
end

--- DataStore değerini çözer: mode, ek kullanıcılar, Team Online'ın durumu. Tanınmayan değer: kodun varsayılanı.
function OnlineConfig.parse(v: any): (string, { [number]: boolean }, string)
	local extra: { [number]: boolean } = {}
	local mode = v
	local teams = OnlineConfig.TEAMS_DEFAULT_MODE
	if type(v) == "table" then
		mode = v.mode
		if valid(v.teams) then
			teams = v.teams
		end
		if type(v.users) == "table" then
			for _, u in v.users do
				local id = tonumber(u)
				if id and id > 0 then
					extra[math.floor(id)] = true
				end
			end
		end
	end
	if not valid(mode) then
		mode = OnlineConfig.DEFAULT_MODE
	end
	return mode, extra, teams
end

--- İzin listesinde mi. Studio'nun çok oyunculu testindeki oyuncular (Player1, Player2...: kimlikleri sıfır ya da negatif,
--- yalnız Studio'da olur) da listede sayılır.
local function listed(userId: number): boolean
	return userId <= 0 or table.find(OnlineConfig.ALLOWLIST, userId) ~= nil or OnlineConfig.extra[userId] == true
end

--- Bu kullanıcı Solo Online'ı görebilir mi (şu anki duruma göre).
function OnlineConfig.allowed(userId: number): boolean
	local mode = OnlineConfig.mode
	if mode == "public" then
		return true
	elseif mode == "off" then
		return false
	end
	return listed(userId)
end

--- Bu kullanıcı Team Online'ı görebilir mi (Solo Online da açık olmalı).
function OnlineConfig.allowedTeams(userId: number): boolean
	if not OnlineConfig.allowed(userId) then
		return false
	end
	local mode = OnlineConfig.teamsMode
	if mode == "public" then
		return true
	elseif mode == "off" then
		return false
	end
	return listed(userId)
end

--- Değeri şimdi ve her REFRESH_S'de okur; değişince onChange çağrılır. Okunamazsa son bilinen durum kalır.
--- deps (testte): read() -> değer, every (sn), stop() -> true olunca durur.
function OnlineConfig.start(onChange: () -> (), deps: { [string]: any }?)
	local d = deps or {}
	local function read(): (boolean, any)
		if d.read then
			return pcall(d.read)
		end
		return pcall(function()
			return game:GetService("DataStoreService"):GetDataStore(OnlineConfig.STORE):GetAsync(OnlineConfig.KEY)
		end)
	end
	local function refresh()
		local ok, v = read()
		if not ok then
			return
		end
		local mode, extra, teams = OnlineConfig.parse(v)
		local changed = mode ~= OnlineConfig.mode or teams ~= OnlineConfig.teamsMode
		for id in extra do
			if not OnlineConfig.extra[id] then
				changed = true
			end
		end
		for id in OnlineConfig.extra do
			if not extra[id] then
				changed = true
			end
		end
		OnlineConfig.mode, OnlineConfig.extra, OnlineConfig.teamsMode = mode, extra, teams
		if changed then
			print("[Online] mode " .. mode .. ", teams " .. teams)
			onChange()
		end
	end
	task.spawn(function()
		while not (d.stop and d.stop()) do
			refresh()
			task.wait(d.every or OnlineConfig.REFRESH_S)
		end
	end)
end

return OnlineConfig
]]></ProtectedString>
					<string name="ScriptGuid">{965FF256-49C5-4AD0-AE23-F86BAF6DBA69}</string>
