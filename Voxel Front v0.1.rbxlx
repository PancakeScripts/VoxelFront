				<Item class="ModuleScript" referent="RBXAE0278219AC1435EA83A42B331B92845">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- SamGeom: repo SAMRadiusPass geometrisi (Roblox API'si yok, testlenir).
--   * Aynı gruptaki SAM menzilleri tek birleşik şekil gibi çizilir: bir dairenin, gruptaki başka bir dairenin İÇİNDE
--     kalan yayları atlanır (computeUncoveredArcs). Tamamen başka dairenin içindeki daire hiç çizilmez.
--   * Halka kesiklidir: çevre boyunca `dash` tile çizgi, `gap` tile boşluk; desen `shift` tile kaydırılır (döndürme).
--     Açılar radyan, ekran koordinatında (y aşağı): atan2(dy, dx).

local SamGeom = {}

local TWO_PI = 2 * math.pi
local EPS = 1e-9

export type Circle = { x: number, y: number, r: number }
export type Arc = { number } -- { başlangıç, bitiş } radyan, 0 <= a < b <= 2π

local function norm(a: number): number
	a = a % TWO_PI
	if a < 0 then
		a += TWO_PI
	end
	return a
end

-- Kapsanan aralıkları birleştirir (sarmal aralıklar ikiye bölünür).
function SamGeom.merge(list: { Arc }): { Arc }
	local flat: { Arc } = {}
	for _, it in list do
		local s, e = norm(it[1]), norm(it[2])
		if e < s then
			flat[#flat + 1] = { s, TWO_PI }
			flat[#flat + 1] = { 0, e }
		else
			flat[#flat + 1] = { s, e }
		end
	end
	if #flat == 0 then
		return {}
	end
	table.sort(flat, function(a: Arc, b: Arc): boolean
		return a[1] < b[1]
	end)
	local out: { Arc } = {}
	local cur = { flat[1][1], flat[1][2] }
	for i = 2, #flat do
		local it = flat[i]
		if it[1] <= cur[2] + EPS then
			cur[2] = math.max(cur[2], it[2])
		else
			out[#out + 1] = cur
			cur = { it[1], it[2] }
		end
	end
	out[#out + 1] = cur
	return out
end

-- `a` dairesinin, `all` içindeki diğer daireler tarafından örtülmeyen yayları.
function SamGeom.uncovered(a: Circle, all: { Circle }): { Arc }
	local covered: { Arc } = {}
	for _, b in all do
		if b ~= a then
			local dx, dy = b.x - a.x, b.y - a.y
			local d2 = dx * dx + dy * dy
			if d2 > EPS then
				local diff = b.r - a.r
				if diff >= 0 and d2 <= diff * diff + EPS then
					return {} -- a tamamen b'nin içinde
				end
				local maxD = a.r + b.r
				if d2 < maxD * maxD - EPS then
					local d = math.sqrt(d2)
					local cosPhi = (a.r * a.r + d2 - b.r * b.r) / (2 * a.r * d)
					local phi = math.acos(math.clamp(cosPhi, -1, 1))
					local theta = math.atan2(dy, dx)
					covered[#covered + 1] = { theta - phi, theta + phi }
				end
			end
		end
	end
	local merged = SamGeom.merge(covered)
	if #merged == 0 then
		return { { 0, TWO_PI } }
	end
	local out: { Arc } = {}
	local cursor = 0
	for _, m in merged do
		if m[1] > cursor + EPS then
			out[#out + 1] = { cursor, m[1] }
		end
		cursor = math.max(cursor, m[2])
	end
	if cursor < TWO_PI - EPS then
		out[#out + 1] = { cursor, TWO_PI }
	end
	return out
end

-- Kesikli halkanın görünen parçaları (radyan, 0..2π), `arcs` ile kırpılmış. Repo kesik deseni: açı (-π..π] x yarıçap
-- + kaydırma, `dash + gap` periyotla; ilk `dash` kısmı görünür.
function SamGeom.dashes(r: number, arcs: { Arc }, dash: number, gap: number, shift: number): { Arc }
	local out: { Arc } = {}
	if r <= 0 or #arcs == 0 then
		return out
	end
	local period = dash + gap
	local lo, hi = -math.pi * r + shift, math.pi * r + shift
	local k0 = math.floor(lo / period) - 1
	local k1 = math.ceil(hi / period)
	local function clip(a0: number, a1: number)
		for _, arc in arcs do
			local s, e = math.max(a0, arc[1]), math.min(a1, arc[2])
			if e > s + 1e-6 then
				out[#out + 1] = { s, e }
			end
		end
	end
	for k = k0, k1 do
		-- açı aralığı (-π..π] içinde
		local t0 = (k * period - shift) / r
		local t1 = (k * period + dash - shift) / r
		t0 = math.max(t0, -math.pi)
		t1 = math.min(t1, math.pi)
		if t1 > t0 then
			-- 0..2π'ye çevir (negatif kısım 2π eklenerek)
			if t1 <= 0 then
				clip(t0 + TWO_PI, t1 + TWO_PI)
			elseif t0 >= 0 then
				clip(t0, t1)
			else
				clip(t0 + TWO_PI, TWO_PI)
				clip(0, t1)
			end
		end
	end
	return out
end

return SamGeom
]]></ProtectedString>
