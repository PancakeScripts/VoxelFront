					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- NetDiff: online maçta listeleri (oyuncular, yapılar, gemiler) her gönderimde baştan değil, yalnız değişen kısmıyla gönderir.
-- İstemci önceki listeye uygulayıp tam listeyi kurar; oyun kodu aynı listeyi görür. Solo'da (LocalNet) kullanılmaz.
-- Liste = `key` alanı kimlik olan kayıtlar; alan değerleri sayı / dize / boolean ya da bunların düz tablosu (bb, costs).
--
-- Paket: { s = sıra, f = true (tam liste)?, u = { değişen kayıtların değişen alanları (anahtar dahil) },
--          x = { silinen anahtarlar }?, n = { { anahtar, boşalan alan adları... } }? }
-- Hareket paketi (gemiler): `move` alanı verilen kodlayıcıda yalnız anahtarı ve o alanı değişen kayıtlar u yerine
-- m tamponuna yazılır (anahtar sıralı: varint(zigzag anahtar farkı) varint(değer)); mf = alan adı. Anahtar tamsayı (eksi
-- olabilir: ticaret gemileri), değer 0..2^32 tamsayı.
-- Tam pakette u tüm kayıtlardır. Fark paketi yalnız bir öncekinin üstüne uygulanır; tabanı olmayan istemci tam paketi bekler
-- (sunucu durumu isteyen istemciye bir sonraki gönderimde tam paketi ayrıca yollar).

local NetDiff = {}

local function writeVar(b: buffer, o: number, v: number): number
	while v >= 128 do
		buffer.writeu8(b, o, v % 128 + 128)
		o += 1
		v = v // 128
	end
	buffer.writeu8(b, o, v)
	return o + 1
end

local function readVar(b: buffer, o: number, len: number): (number?, number)
	local v, mul = 0, 1
	for _ = 1, 5 do
		if o >= len then
			return nil, o
		end
		local x = buffer.readu8(b, o)
		o += 1
		v += (x % 128) * mul
		if x < 128 then
			return v, o
		end
		mul *= 128
	end
	return nil, o
end

local function packable(v: any): boolean
	return type(v) == "number" and v >= 0 and v < 4294967296 and v % 1 == 0
end

local function packableKey(v: any): boolean
	return type(v) == "number" and v > -2147483648 and v < 2147483648 and v % 1 == 0
end

local function same(a: any, b: any): boolean
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	for k, v in a do
		if b[k] ~= v then
			return false
		end
	end
	for k in b do
		if a[k] == nil then
			return false
		end
	end
	return true
end

--- Sunucu: bir liste akışının kodlayıcısı. move: yalnız bu alanı değişen kayıtlar tamponda gider (gemi konumu).
function NetDiff.encoder(key: string, move: string?): any
	local enc = { seq = 0, prev = {} :: { [any]: any }, list = {} :: { any } }

	--- Yeni listenin öncekine göre fark paketi (liste sonra tam paket için saklanır).
	function enc.diff(list: { any }): any
		enc.seq += 1
		local prev = enc.prev
		local now: { [any]: any } = {}
		local u: { any } = {}
		local n: { any }? = nil
		for _, e in list do
			local id = e[key]
			now[id] = e
			local old = prev[id]
			if old == nil then
				table.insert(u, e)
			else
				local ch: { [string]: any }? = nil
				for k, v in e do
					if not same(v, old[k]) then
						ch = ch or { [key] = id }
						;(ch :: any)[k] = v
					end
				end
				if ch then
					table.insert(u, ch)
				end
				local gone: { any }? = nil
				for k in old do
					if e[k] == nil then
						gone = gone or { id }
						table.insert(gone :: { any }, k)
					end
				end
				if gone then
					n = n or {}
					table.insert(n :: { any }, gone)
				end
			end
		end
		local x: { any }? = nil
		for id in prev do
			if now[id] == nil then
				x = x or {}
				table.insert(x :: { any }, id)
			end
		end
		enc.prev = now
		enc.list = list
		local m: buffer? = nil
		if move ~= nil and #u > 0 then
			-- yalnız anahtar + hareket alanından oluşan değişimler tampona
			local moves: { any } = {}
			local rest: { any } = {}
			for _, ch in u do
				local only = prev[ch[key]] ~= nil and packableKey(ch[key]) and packable(ch[move])
				if only then
					for k in ch do
						if k ~= key and k ~= move then
							only = false
							break
						end
					end
				end
				table.insert(if only then moves else rest, ch)
			end
			if #moves > 0 then
				table.sort(moves, function(a: any, b: any): boolean
					return a[key] < b[key]
				end)
				local tmp = buffer.create(#moves * 10)
				local o, last = 0, 0
				for _, ch in moves do
					local gap = ch[key] - last -- (yalnız ilki eksi olabilir: zigzag)
					o = writeVar(tmp, o, if gap >= 0 then gap * 2 else -gap * 2 - 1)
					o = writeVar(tmp, o, ch[move])
					last = ch[key]
				end
				local out = buffer.create(o)
				buffer.copy(out, 0, tmp, 0, o)
				m = out
				u = rest
			end
		end
		return { s = enc.seq, u = u, x = x, n = n, m = m, mf = if m then move else nil }
	end

	--- Son listenin tam paketi (durumu isteyen istemciye).
	function enc.full(): any
		return { s = enc.seq, f = true, u = enc.list }
	end

	return enc
end

--- İstemci: bir liste akışının çözücüsü. apply(paket) -> tam liste (tabanı yoksa ya da eskiyse nil).
function NetDiff.decoder(key: string): any
	local dec = { seq = -1, byId = nil :: { [any]: any }?, order = {} :: { any } }

	function dec.apply(p: any): { any }?
		if type(p) ~= "table" or type(p.s) ~= "number" or type(p.u) ~= "table" then
			return nil
		end
		if p.f then
			local byId: { [any]: any } = {}
			local order = {}
			for _, e in p.u do
				byId[e[key]] = e
				table.insert(order, e[key])
			end
			dec.byId, dec.order, dec.seq = byId, order, p.s
			return p.u
		end
		local byId = dec.byId
		if byId == nil or p.s ~= dec.seq + 1 then
			return nil -- (taban yok ya da bu paket zaten tam pakette)
		end
		dec.seq = p.s
		if typeof(p.m) == "buffer" and type(p.mf) == "string" then
			-- hareket tamponu: sıralı (anahtar, değer) çiftleri
			local u = table.clone(p.u)
			local b: buffer = p.m
			local len = buffer.len(b)
			local o, id = 0, 0
			while o < len do
				local gap, v
				gap, o = readVar(b, o, len)
				v, o = readVar(b, o, len)
				if gap == nil or v == nil then
					break
				end
				id += if gap % 2 == 0 then gap // 2 else -(gap + 1) // 2
				table.insert(u, { [key] = id, [p.mf] = v })
			end
			p = table.clone(p)
			p.u = u
		end
		if p.x then
			for _, id in p.x do
				byId[id] = nil
			end
		end
		local order = dec.order
		for _, ch in p.u do
			local id = ch[key]
			local old = byId[id]
			if old == nil then
				byId[id] = ch
				table.insert(order, id)
			else
				-- yeni tablo: oyun kodunun elindeki eski kayıt değişmez
				local e = table.clone(old)
				for k, v in ch do
					e[k] = v
				end
				byId[id] = e
			end
		end
		if p.n then
			for _, gone in p.n do
				local e = byId[gone[1]]
				if e then
					e = table.clone(e)
					for i = 2, #gone do
						e[gone[i]] = nil
					end
					byId[gone[1]] = e
				end
			end
		end
		local list = {}
		local kept = {}
		for _, id in order do
			local e = byId[id]
			if e ~= nil and kept[id] == nil then
				kept[id] = true
				table.insert(list, e)
			end
		end
		-- sıra listesi yalnız yaşayanlarla (silinenler birikmez)
		local fresh = {}
		for _, e in list do
			table.insert(fresh, e[key])
		end
		dec.order = fresh
		return list
	end

	return dec
end

--- İstemci: maç akışlarının (istatistik, gemiler) çözücüleri. Sıkıştırılmamış paket (solo) olduğu gibi geçer.
function NetDiff.inbound(): any
	local players = NetDiff.decoder("pid")
	local structs = NetDiff.decoder("tile")
	local boats = NetDiff.decoder("id") -- (konumlar hareket tamponunda gelir)
	local self = {}
	--- İstatistik paketi: tam hali ya da (tabanı henüz yoksa) nil.
	function self.stats(payload: any): any?
		if type(payload) ~= "table" or payload.z == nil then
			return payload
		end
		local pl = players.apply(payload.players)
		local st = structs.apply(payload.structs)
		if pl == nil or st == nil then
			return nil
		end
		local out = table.clone(payload)
		out.players = pl
		out.structs = st
		out.z = nil
		return out
	end
	function self.boats(payload: any): { any }?
		if type(payload) ~= "table" or payload.z == nil then
			return payload
		end
		return boats.apply(payload.b)
	end
	return self
end

return NetDiff
]]></ProtectedString>
