					<ProtectedString name="Source"><![CDATA[--!strict
-- Net (sunucu): remote nesnelerini tek klasörde oluşturur. İstemci klasörü görünce hepsi hazırdır.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

export type Remotes = {
	getMap: RemoteFunction,
	getState: RemoteFunction,
	intent: RemoteEvent,
	delta: RemoteEvent,
	stats: RemoteEvent,
	notice: RemoteEvent,
	boats: RemoteEvent,
	fx: RemoteEvent,
	attacks: RemoteEvent,
	compact: boolean, -- gerçek ağ: listeler yalnız değişenle, harita değişimleri sıkı biçimde gider (Shared.NetDiff, Delta)
}

function Net.create(protocol: any): Remotes
	local folder = Instance.new("Folder")
	folder.Name = protocol.Folder

	local function make(className: string, name: string): any
		local obj = Instance.new(className)
		obj.Name = name
		obj.Parent = folder
		return obj
	end

	local remotes: Remotes = {
		getMap = make("RemoteFunction", protocol.GetMap),
		getState = make("RemoteFunction", protocol.GetState),
		intent = make("RemoteEvent", protocol.Intent),
		delta = make("RemoteEvent", protocol.Delta),
		stats = make("RemoteEvent", protocol.Stats),
		notice = make("RemoteEvent", protocol.Notice),
		boats = make("RemoteEvent", protocol.Boats),
		fx = make("RemoteEvent", protocol.Fx),
		attacks = make("RemoteEvent", protocol.Attacks),
		compact = true,
	}
	-- Klasör en son bağlanır: istemci klasörü görünce içindekiler hazırdır.
	folder.Parent = ReplicatedStorage
	return remotes
end

return Net
]]></ProtectedString>
