					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- WaterComp: su tile'larının bağlı bileşen numarası (istemci). Savaş gemisi önizlemesinde "imlecin altındaki denizde
-- hazır limanım var mı?" sorusu için (repo PlayerImpl.warshipSpawn: limanın komşu suyu, tıklanan suyla aynı bileşende
-- olmalı). Sunucudaki World.waterComp ile aynı tanım: 4 komşuluk, su = terrain 0.
-- Harita büyük olduğu için (2000x1000) tek seferde değil, kare başına küçük dilimlerle hesaplanır (step); bitene kadar
-- of() nil döner ve önizleme "herhangi bir hazır liman" yedeğine düşer. Satır tarama (scanline) dolgusu: yığın küçük kalır.
-- Roblox API'si yok (testlenir).

local WaterComp = {}
WaterComp.__index = WaterComp

export type WaterComp = typeof(setmetatable(
	{} :: {
		terrain: buffer,
		w: number,
		h: number,
		labels: buffer, -- u32: 0 = kara / henüz yok, 1.. = bileşen
		count: number, -- verilen son bileşen numarası
		scan: number, -- tarama imleci (sonraki bakılacak tile)
		stack: { number }, -- bekleyen tohumlar (aynı bileşen)
		current: number, -- doldurulan bileşen (0 = yok)
		done: boolean,
	},
	WaterComp
))

function WaterComp.new(terrain: buffer, w: number, h: number): WaterComp
	return setmetatable({
		terrain = terrain,
		w = w,
		h = h,
		labels = buffer.create(w * h * 4),
		count = 0,
		scan = 0,
		stack = {},
		current = 0,
		done = false,
	}, WaterComp)
end

local function isFreeWater(self: WaterComp, t: number): boolean
	return buffer.readu8(self.terrain, t) == 0 and buffer.readu32(self.labels, t * 4) == 0
end

-- (x, y) satırında, [x0, x1] aralığındaki etiketsiz su parçalarının her biri için bir tohum yığına konur.
local function pushRuns(self: WaterComp, y: number, x0: number, x1: number)
	if y < 0 or y >= self.h then
		return
	end
	local row = y * self.w
	local inRun = false
	for x = x0, x1 do
		local free = isFreeWater(self, row + x)
		if free and not inRun then
			self.stack[#self.stack + 1] = row + x
		end
		inRun = free
	end
end

-- En çok `budget` tile etiketler (yaklaşık). Hepsi bittiyse true.
function WaterComp.step(self: WaterComp, budget: number): boolean
	if self.done then
		return true
	end
	local w, size = self.w, self.w * self.h
	local labels = self.labels
	local work = 0
	while work < budget do
		if #self.stack == 0 then
			-- yeni bileşen ara
			self.current = 0
			while self.scan < size and not isFreeWater(self, self.scan) do
				self.scan += 1
				work += 0.05 -- tarama ucuz ama bedava değil
				if work >= budget then
					return false
				end
			end
			if self.scan >= size then
				self.done = true
				return true
			end
			self.count += 1
			self.current = self.count
			self.stack[1] = self.scan
		end
		local seed = table.remove(self.stack) :: number
		if isFreeWater(self, seed) then
			local y = seed // w
			local row = y * w
			local x = seed - row
			local l, r = x, x
			while l > 0 and isFreeWater(self, row + l - 1) do
				l -= 1
			end
			while r < w - 1 and isFreeWater(self, row + r + 1) do
				r += 1
			end
			local id = self.current
			for xx = l, r do
				buffer.writeu32(labels, (row + xx) * 4, id)
			end
			work += r - l + 1
			pushRuns(self, y - 1, l, r)
			pushRuns(self, y + 1, l, r)
		end
	end
	return false
end

-- Tile'ın su bileşeni; kara ise ya da henüz hesaplanmadıysa nil.
function WaterComp.of(self: WaterComp, tile: number): number?
	if tile < 0 or tile >= self.w * self.h then
		return nil
	end
	local c = buffer.readu32(self.labels, tile * 4)
	if c == 0 then
		return nil
	end
	return c
end

-- Kara tile'ının dört komşusundan biri `comp` bileşenindeyse true (liman bu denize açılıyor mu).
function WaterComp.touches(self: WaterComp, tile: number, comp: number): boolean
	local w, h = self.w, self.h
	local x, y = tile % w, tile // w
	return (x > 0 and self:of(tile - 1) == comp)
		or (x < w - 1 and self:of(tile + 1) == comp)
		or (y > 0 and self:of(tile - w) == comp)
		or (y < h - 1 and self:of(tile + w) == comp)
end

return WaterComp
]]></ProtectedString>
						<string name="ScriptGuid">{A34E5457-62D0-43F2-9ECC-E74F607596E0}</string>
