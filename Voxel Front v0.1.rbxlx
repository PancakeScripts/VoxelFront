					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Fit legacy/runtime labels into their bounds without enlarging their chosen font.
local TextFit = {}
function TextFit.fit(o: Instance)
  -- ("NoTextFit" öznitelikli yazı kendi genişliğini ayarlar: AutomaticSize, mağaza fiyat satırları)
  if not o:IsA("TextLabel") or o.TextScaled or o:GetAttribute("NoTextFit") then return end
  local limit=o:FindFirstChildOfClass("UITextSizeConstraint")
  if not limit then
   limit=Instance.new("UITextSizeConstraint")
   limit.MinTextSize=1
   limit.Parent=o
  end
  local function update()
   (limit :: UITextSizeConstraint).MaxTextSize=math.max(1,math.floor(o.TextSize))
  end
  update()
  o.TextScaled=true
  o:GetPropertyChangedSignal("TextSize"):Connect(update)
end
function TextFit.bind(root: Instance)
 for _,o in root:GetDescendants() do TextFit.fit(o) end
 root.DescendantAdded:Connect(TextFit.fit)
end
return TextFit
]]></ProtectedString>
