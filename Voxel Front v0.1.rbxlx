-- Credits: How to Play penceresinin altındaki kenarlıklı "CREDITS & LICENSE" çerçevesi ve altındaki "Source" satırı
-- (oyunda İngilizce; RoWorld'ün credits düzeni örnek alındı). Lisans gereği:
--   * OpenFront (AGPL-3.0 + bölüm 7 ek şartları): "© OpenFront and Contributors" görünür kalır; oyun OpenFront'un resmi
--     sürümü gibi gösterilmez, onay ima edilmez.
--   * AGPL bölüm 5: değiştirilmiş sürüm notu ve ilgili tarih (MODIFIED); lisans ve "ABSOLUTELY NO WARRANTY" notu.
--   * AGPL bölüm 13: oyuncuya kaynak kodun yeri (SOURCE_REPO). Roblox'ta bağlantı (URL) yazılmaz: depo yalnız adıyla.
--   * RoWorld (AGPL-3.0, © 2026 Snick Co.): kodundan uyarlanan kısımlar var (telif notu yeterli; liste zorunlu değil).
--   * Ulus listesi OpenFront'tan (CC BY-SA 4.0); harita verisi Natural Earth + NOAA ETOPO1 (kamu malı; atfı zorunlu değil).
-- "Source" satırındaki logo: Assets.Icons.creditsLogo (boşsa logo yok, yalnız yazı).

local Credits = {}

--- Oyunun adı (credits'te oyuncuya görünen).
Credits.GAME = "Voxel Front"
--- Kaynak kodun GitHub deposu ("kullanıcı/depo", bağlantısız).
Credits.SOURCE_REPO = "PancakeScripts/VoxelFront"
--- Değiştirilmiş sürümün tarihi (AGPL 5a); yayında güncellenir.
Credits.MODIFIED = "November 2026"

Credits.TITLE = "CREDITS & LICENSE"

--- Çerçevedeki paragraflar (sırayla).
function Credits.paragraphs(): { string }
	return {
		Credits.GAME .. " is a modified version of OpenFront. © OpenFront and Contributors. Last modified: " .. Credits.MODIFIED .. ".",
		Credits.GAME .. " is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License, version 3, with the additional terms in its LICENSE file. It comes with ABSOLUTELY NO WARRANTY. The license comes with " .. Credits.GAME .. "'s source code.",
		"Parts adapted from RoWorld, © 2026 Snick Co. (GNU AGPL v3).",
		"Nation list adapted from OpenFront (CC BY-SA 4.0). Maps made with Natural Earth and NOAA ETOPO1 data (public domain).",
		Credits.GAME .. " is not affiliated with or endorsed by OpenFront.",
	}
end

return Credits
]]></ProtectedString>
