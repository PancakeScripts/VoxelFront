					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- CameraFocus: kendi toprağına yumuşak kamera geçişi (alttaki isim alanına tıklama / C tuşu; repo TransformHandler
-- centerCamera + GoToPlayerEvent zoom). Hedef = toprağın ağırlık merkezi; zoom = sınır kutusu ekranın `fill` kadarını
-- kaplayacak şekilde (Look.Camera). Geçiş ease-out ile, zoom logaritmik aralıkta (yakınlaşma/uzaklaşma eşit hızda hissedilir).
-- Roblox API'si yok (testlenir).

local CameraFocus = {}

export type Cfg = { duration: number, fill: number, minZoom: number, maxZoom: number }
export type Anim = { t0: number, dur: number, x0: number, y0: number, z0: number, x1: number, y1: number, z1: number }

-- Hedef merkez ve zoom. (minX..maxX, minY..maxY) kutusu merkez etrafında görünür kalmalı.
function CameraFocus.target(cfg: Cfg, minX: number, minY: number, maxX: number, maxY: number, cx: number, cy: number, viewW: number, viewH: number): (number, number, number)
	local wx, wy = cx + 0.5, cy + 0.5
	local halfW = math.max(wx - minX, maxX + 1 - wx, 4)
	local halfH = math.max(wy - minY, maxY + 1 - wy, 4)
	local z = math.min(viewW * cfg.fill / (2 * halfW), viewH * cfg.fill / (2 * halfH))
	return wx, wy, math.clamp(z, cfg.minZoom, cfg.maxZoom)
end

local function ease(t: number): number
	local u = 1 - t
	return 1 - u * u * u -- ease-out cubic
end

function CameraFocus.start(now: number, cfg: Cfg, x0: number, y0: number, z0: number, x1: number, y1: number, z1: number): Anim
	return { t0 = now, dur = math.max(0.05, cfg.duration), x0 = x0, y0 = y0, z0 = z0, x1 = x1, y1 = y1, z1 = z1 }
end

-- Geçişin o anki (merkez x, y, zoom) değeri ve bitip bitmediği.
function CameraFocus.sample(a: Anim, now: number): (number, number, number, boolean)
	local t = math.clamp((now - a.t0) / a.dur, 0, 1)
	local k = ease(t)
	local z = math.exp(math.log(a.z0) + (math.log(a.z1) - math.log(a.z0)) * k)
	-- merkez, zoom ile tutarlı ilerlesin diye ekran uzayında doğrusal: önce yaklaşma/uzaklaşma, konum da aynı eğriyle
	local x = a.x0 + (a.x1 - a.x0) * k
	local y = a.y0 + (a.y1 - a.y0) * k
	return x, y, z, t >= 1
end

return CameraFocus
]]></ProtectedString>
						<string name="ScriptGuid">{46E0989B-3D39-400A-8F6A-FDE197421FB3}</string>
