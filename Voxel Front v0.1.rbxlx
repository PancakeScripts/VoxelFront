					<Item class="ModuleScript" referent="RBX19553FB75F64400F80EBF477DB9FC175">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Build: yapı kurma ya da şehir yükseltme (OpenFront kuralları).
--   * Yapı yalnızca kendi toprağına kurulur; tıklanan nokta yeterli değilse yarıçap 15 içinde, diğer yapılardan en az 15 uzak
--     en yakın kendi tile'ı seçilir.
--   * Maliyet kurulu yapı sayısına bağlıdır (şehir: min(1M, 2^n * 125K), kule: min(250K, (n+1) * 50K)); altın hemen düşer.
--   * İnşaat süresince (şehir 2 sn, kule 5 sn) yapı etki etmez.
--   * Yükseltme (repo): tıklanan yere 15 tile içindeki aynı türden EN YAKIN yapı benimse, bitmişse ve silinmiyorsa +1 seviye
--     (Simulation.upgradeTarget); maliyet yeni yapı kurma maliyetiyle aynı. Savunma karakolu yükseltilmez.
--   * Silo 1M sabit, 10 sn; SAM min(3M, n x 1.5M), 30 sn. Seviye = aynı anda hazır füze sayısı (SAM'da ayrıca menzil artar).

local Build = {}
Build.__index = Build

export type Build = typeof(setmetatable(
	{} :: { kind: string, pid: number, what: any, tile: any, upgrade: boolean, done: boolean },
	Build
))

function Build.new(pid: number, what: any, tile: any, upgrade: boolean): Build
	return setmetatable({ kind = "build", pid = pid, what = what, tile = tile, upgrade = upgrade, done = false }, Build)
end

local function validTile(size: number, tile: any): boolean
	return type(tile) == "number" and tile == tile and tile >= 0 and tile < size and tile % 1 == 0
end

function Build.init(self: Build, sim: any)
	self.done = true
	local world, cfg, pid = sim.world, sim.cfg, self.pid
	if self.what ~= "city" and self.what ~= "post" and self.what ~= "port" and self.what ~= "silo" and self.what ~= "sam" and self.what ~= "factory" then
		sim:emit(pid, "badTarget")
		return
	end
	if not validTile(world.size, self.tile) then
		sim:emit(pid, "badTile")
		return
	end
	if sim.phase ~= "run" then
		sim:emit(pid, "notStarted")
		return
	end
	if not sim.spawned[pid] then
		sim:emit(pid, "notSpawned")
		return
	end

	if self.upgrade then
		if self.what == "post" then
			sim:emit(pid, "badTarget")
			return
		end
		local city = sim:upgradeTarget(pid, self.what, self.tile)
		if not city then
			sim:emit(pid, if self.what == "port" then "noPortHere" elseif self.what == "silo" then "noSiloHere" elseif self.what == "sam" then "noSamHere" elseif self.what == "factory" then "noFactoryHere" else "noCity")
			return
		end
		local cost = sim:structureCost(pid, self.what)
		if sim.gold[pid] < cost then
			sim:emit(pid, "noGold")
			return
		end
		sim.gold[pid] -= cost
		sim:upgradeCity(city)
		return
	end

	if self.what ~= "port" and world:ownerAt(self.tile) ~= pid then
		sim:emit(pid, "notOwned")
		return
	end
	local site = if self.what == "port" then sim:findPortSite(pid, self.tile) else sim:findStructureSite(pid, self.tile)
	if not site then
		sim:emit(pid, "noSpace")
		return
	end
	local cost = sim:structureCost(pid, self.what)
	if sim.gold[pid] < cost then
		sim:emit(pid, "noGold")
		return
	end
	sim.gold[pid] -= cost
	local ticks = if self.what == "city" then cfg.CITY_BUILD_TICKS
		elseif self.what == "port" then cfg.PORT_BUILD_TICKS
		elseif self.what == "silo" then cfg.SILO_BUILD_TICKS
		elseif self.what == "sam" then cfg.SAM_BUILD_TICKS
		elseif self.what == "factory" then cfg.FACTORY_BUILD_TICKS
		else cfg.POST_BUILD_TICKS
	sim:addStructure(site, self.what, pid, ticks)
end

function Build.tick(_self: Build, _sim: any) end

return Build
]]></ProtectedString>
							<string name="ScriptGuid">{4E6A08E0-34EE-46C3-BC4B-6DAF28087BB0}</string>
