				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Format: sayı yazımı repo renderNumber ile aynı kurallarla (aşağı yuvarlar, yukarı değil):
--   999 -> "999", 1234 -> "1.23K", 12345 -> "12.3K", 123456 -> "123K", 1234567 -> "1.23M", 12345678 -> "12.3M",
--   1234567890 -> "1.23B", 12345678901 -> "12.3B". Asker sayıları da altın da bununla yazılır.

local Format = {}

function Format.number(n: number): string
	n = math.max(n, 0)
	if n >= 10_000_000_000 then
		return string.format("%.1fB", math.floor(n / 100_000_000) / 10)
	elseif n >= 1_000_000_000 then
		return string.format("%.2fB", math.floor(n / 10_000_000) / 100)
	elseif n >= 10_000_000 then
		return string.format("%.1fM", math.floor(n / 100_000) / 10)
	elseif n >= 1_000_000 then
		return string.format("%.2fM", math.floor(n / 10_000) / 100)
	elseif n >= 100_000 then
		return tostring(math.floor(n / 1000)) .. "K"
	elseif n >= 10_000 then
		return string.format("%.1fK", math.floor(n / 100) / 10)
	elseif n >= 1000 then
		return string.format("%.2fK", math.floor(n / 10) / 100)
	end
	return tostring(math.floor(n))
end

return Format
]]></ProtectedString>
