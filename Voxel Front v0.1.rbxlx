				<Item class="ModuleScript" referent="RBXE729BF7EF078490997EDC4A50B10BF01">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- MapCheck: online maçta istemcinin haritası sunucununkiyle aynı mı (Shared.MapHash). Sunucu ara sıra son gönderdiği harita
-- paketinden sonraki parmak izini yollar ({ s = paket sırası, h }); istemci o pakete kadar her şeyi uygulayıp beklerken
-- (Drip boşken) kendi parmak iziyle karşılaştırır. Tutmazsa "desync" döner: istemci haritayı baştan ister.
-- Drip hep meşgulse (yoğun savaş) ardı ardına FORCE_AFTER denetim atlandıktan sonra bekleyenler hemen uygulanır.
-- Roblox API'si kullanmaz (testlenebilir).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local MapHash = require(Shared:WaitForChild("MapHash"))

local MapCheck = {}
MapCheck.__index = MapCheck

MapCheck.FORCE_AFTER = 1 -- (bir denetim atlandıysa sonrakinde beklenmez: en geç ~20 sn'de bir denetim)

function MapCheck.new(): any
	return setmetatable({ h = 0, after = math.huge, pending = nil :: any, skipped = 0, checks = 0, desyncs = 0 }, MapCheck)
end

--- Tam durum yüklendi (harita tamponu, durumun paket sırası). Bu sıradaki denetim atlanır: tam durum henüz
--- gönderilmemiş değişimleri de içerebilir.
function MapCheck.load(self: any, owners: buffer, size: number, seq: number)
	self.h = MapHash.full(owners, size)
	self.after = seq
	self.pending = nil
end

--- Bir tile uygulandı (eski ve yeni ağ değeri).
function MapCheck.apply(self: any, tile: number, old: number, new: number)
	self.h = MapHash.step(self.h, tile, old, new)
end

--- Sunucunun parmak izi geldi.
function MapCheck.receive(self: any, sum: any)
	if type(sum) == "table" and type(sum.s) == "number" and type(sum.h) == "number" then
		self.pending = sum
	end
end

--- Her kare. lastSeq: uygulanmak üzere alınan son harita paketi; busy: Drip'te bekleyen var mı; flush: hepsini hemen uygula.
--- Döner: "ok" | "desync" | nil (bu karede denetim yok).
function MapCheck.step(self: any, lastSeq: number, busy: boolean, flush: () -> ()): string?
	local c = self.pending
	if c == nil then
		return nil
	end
	if c.s <= self.after or lastSeq > c.s then
		-- tam durumla çakışan ya da yenisi gelmeden kontrol edilemeyen denetim
		self.pending = nil
		if lastSeq > c.s then
			self.skipped += 1
		end
		return nil
	end
	if lastSeq < c.s then
		return nil -- (o paket henüz gelmedi)
	end
	if busy then
		if self.skipped < MapCheck.FORCE_AFTER then
			return nil
		end
		flush()
	end
	self.pending = nil
	self.skipped = 0
	self.checks += 1
	if self.h ~= c.h then
		self.desyncs += 1
		return "desync"
	end
	return "ok"
end

return MapCheck
]]></ProtectedString>
						<string name="ScriptGuid">{3B31F37A-806B-4318-A289-0DE0328290A3}</string>
