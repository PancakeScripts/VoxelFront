					<Item class="ModuleScript" referent="RBX687783025FAA4209BA40408179196C40">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Trade: liman ticareti (OpenFront PortExecution + TradeShipExecution kuralları).
--   * Her hazır liman 10 tickte bir, seviyesi kadar kez 1/oran şansıyla gemi çıkarır (art arda ret sayacı şansı artırır).
--       oran = max(1, floor(100 / boost^2 / (ret+1) / doygunluk))
--       boost = 1 + 0.5 * clamp((6 - L) / 5, 0, 1) / L   (L: oyuncunun toplam liman seviyesi)
--       doygunluk(N) = max(1 - sigmoid(N, ln2/50, 330), 0.25 * (1 - sigmoid(N, ln2/100, 800)))   (N: haritadaki gemi sayısı)
--   * Hedef: başka oyuncuların, aynı su kütlesindeki limanları. Seviye kadar ağırlık; en yakın max(4, n/3) liman
--     (300'den uzaksa) ikinci kez sayılır.
--   * Gemi tick başına 1 tile gider. Varınca iki limanın sahibi de aynı altını alır:
--       altın = floor(75000 / (1 + e^(-0.03 (yol - 300))) + 50 * yol)
--   * Hedef liman yıkılırsa ya da ikisi aynı sahibe geçerse gemi yok olur.

local Trade = {}
Trade.__index = Trade

local LN2 = 0.6931471805599453

local function sigmoid(v: number, rate: number, mid: number): number
	return 1 / (1 + math.exp(-rate * (v - mid)))
end

function Trade.saturation(n: number): number
	local damping = 1 - sigmoid(n, LN2 / 50, 330)
	local plateau = 0.25 * (1 - sigmoid(n, LN2 / 100, 800))
	return math.max(damping, plateau)
end

function Trade.boost(levels: number): number
	if levels <= 0 then
		return 1
	end
	return 1 + 0.5 * math.clamp((6 - levels) / 5, 0, 1) / levels
end

function Trade.spawnRate(rejections: number, numShips: number, levels: number): number
	local b = Trade.boost(levels)
	local base = 100 / (b * b)
	return math.max(1, math.floor(base / (rejections + 1) / Trade.saturation(numShips)))
end

function Trade.gold(cfg: any, dist: number): number
	return math.floor(cfg.TRADE_GOLD_MAX / (1 + math.exp(-cfg.TRADE_GOLD_RATE * (dist - cfg.TRADE_SHORT_RANGE))) + cfg.TRADE_GOLD_PER_TILE * dist)
end

local function manhattan(w: number, a: number, b: number): number
	return math.abs(a % w - b % w) + math.abs(a // w - b // w)
end

-- Limanın toplam seviyesi (oyuncunun hazır limanları).
local function portLevels(sim: any, pid: number): number
	local n = 0
	for _, st in sim.structList do
		if st.pid == pid and st.type == "port" and st.ready then
			n += st.level
		end
	end
	return n
end

-- Kaynak limandan ağırlıklı hedef limanlar. (olasılık listesi)
local function tradingPorts(sim: any, src: any): { any }
	local world, cfg = sim.world, sim.cfg
	local w = world.width
	local comps: { [number]: boolean } = {}
	local nb: { number } = {}
	local n = world:neighbors(src.tile, nb)
	for k = 1, n do
		local c = world:waterComponent(nb[k])
		if c ~= 0 then
			comps[c] = true
		end
	end
	local ports: { any } = {}
	for _, st in sim.structList do
		if st.type == "port" and st.ready and st.pid ~= src.pid and sim.alive[st.pid] and sim.parts.Diplomacy.canTrade(sim, src.pid, st.pid) then
			local m = world:neighbors(st.tile, nb)
			for k = 1, m do
				local c = world:waterComponent(nb[k])
				if c ~= 0 and comps[c] then
					ports[#ports + 1] = st
					break
				end
			end
		end
	end
	table.sort(ports, function(a: any, b: any): boolean
		local da, db = manhattan(w, src.tile, a.tile), manhattan(w, src.tile, b.tile)
		if da ~= db then
			return da < db
		end
		return a.tile < b.tile
	end)
	local weighted: { any } = {}
	local close = math.clamp(#ports / 3, 4, math.max(#ports, 4))
	for i, p in ports do
		for _ = 1, p.level do
			weighted[#weighted + 1] = p
		end
		local tooClose = manhattan(w, src.tile, p.tile) < cfg.TRADE_SHORT_RANGE
		if not tooClose and sim.parts.Diplomacy.isAllied(sim, src.pid, p.pid) then
			for _ = 1, p.level do
				weighted[#weighted + 1] = p
			end
		end
		if not tooClose and i <= close then
			for _ = 1, p.level do
				weighted[#weighted + 1] = p
			end
		end
	end
	return weighted
end

-- Hazır bir limanın kontrol anı.
function Trade.portTick(sim: any, st: any)
	local levels = portLevels(sim, st.pid)
	local spawn = false
	for _ = 1, st.level do
		local rate = Trade.spawnRate(st.rejections or 0, sim.tradeCount, levels)
		if sim.rng:int(1, rate) == 1 then
			st.rejections = 0
			spawn = true
			break
		end
		st.rejections = (st.rejections or 0) + 1
	end
	if not spawn then
		return
	end
	local list = tradingPorts(sim, st)
	if #list == 0 then
		return
	end
	local dst = list[sim.rng:int(1, #list)]
	sim:addExecution(Trade.new(st, dst))
end

-- Execution --------------------------------------------------------------------

export type Trade = typeof(setmetatable(
	{} :: { kind: string, id: number, pid: number, src: any, dst: any, path: { number }, idx: number, done: boolean, counted: boolean, lastSafe: number, captured: boolean, traveled: number },
	Trade
))

local nextId = 0

function Trade.new(src: any, dst: any): Trade
	nextId += 1
	return setmetatable({ kind = "trade", id = -nextId, pid = src.pid, src = src, dst = dst, path = {}, idx = 1, done = false, counted = false, lastSafe = 0, captured = false, traveled = 0 }, Trade)
end

function Trade.position(self: Trade): number
	return self.path[math.min(self.idx, #self.path)]
end

function Trade.finish(self: Trade, sim: any)
	if self.done then
		return
	end
	self.done = true
	if self.counted then
		sim.tradeCount = math.max(0, sim.tradeCount - 1)
	end
end

function Trade.init(self: Trade, sim: any)
	self.done = true
	local key = self.src.tile * sim.world.size + self.dst.tile
	local route = sim.routeCache[key]
	if route == nil then
		-- bu tick'te rota aramalarına çok zaman gittiyse bu ticaret gemisi atlanır (sonraki kontrollerde yeniden denenir)
		if sim.parts.Naval.nodesThisTick > sim.cfg.NAV_TICK_BUDGET then
			return
		end
		-- ters yön önbellekteyse onu çevirerek kullan
		local back = sim.routeCache[self.dst.tile * sim.world.size + self.src.tile]
		if back then
			route = table.move(back, 1, #back, 1, {})
			local n = #route
			for i = 1, n // 2 do
				route[i], route[n + 1 - i] = route[n + 1 - i], route[i]
			end
		elseif back == false then
			route = false
		else
			route = sim.parts.Naval.portRoute(sim.world, self.src.tile, self.dst.tile, sim.cfg.TRADE_ROUTE_MAX_NODES) or false
		end
		sim.routeCache[key] = route
	end
	if not route then
		return
	end
	self.path = route :: { number }
	self.idx = 1
	self.done = false
	self.counted = true
	self.lastSafe = sim.tickNo
	sim.tradeCount += 1
end

-- Savaş gemisi ele geçirir: gemi artık geçirenin; en yakın kendi limanına gider ve altını ona öder. Limanı yoksa batar.
function Trade.capture(self: Trade, sim: any, ws: any): boolean
	if self.done or self.captured then
		return false
	end
	local world = sim.world
	local cur = self:position()
	local w = world.width
	local comp = world:waterComponent(cur)
	local nb: { number } = {}
	local best, bestD = nil, math.huge
	for _, st in sim.structList do
		if st.pid == ws.pid and st.type == "port" and st.ready then
			local d = math.abs(st.tile % w - cur % w) + math.abs(st.tile // w - cur // w)
			if d < bestD then
				local n = world:neighbors(st.tile, nb)
				for k = 1, n do
					if world:waterComponent(nb[k]) == comp then
						best, bestD = st, d
						break
					end
				end
			end
		end
	end
	self.captured = true
	local victim = self.pid
	sim:emit(victim, "tradeCaptured", ws.pid)
	self.pid = ws.pid
	sim.parts.Nation.shipLost(sim, victim, cur, ws.pid, "trade")
	if not best then
		self:finish(sim)
		return true
	end
	local route = sim.parts.Naval.waterRoute(world, cur, best.tile, sim.cfg.WARSHIP_ROUTE_MAX_NODES)
	if not route then
		self:finish(sim)
		return true
	end
	self.dst = best
	self.path = route
	self.idx = 1
	return true
end

function Trade.tick(self: Trade, sim: any)
	if self.done then
		return
	end
	local src, dst = self.src, self.dst
	if self.captured then
		if sim.structByTile[dst.tile] ~= dst or dst.pid ~= self.pid or not sim.alive[self.pid] then
			self:finish(sim)
			return
		end
	elseif
		sim.structByTile[dst.tile] ~= dst
		or dst.pid == src.pid
		or not sim.alive[dst.pid]
		or not sim.alive[src.pid]
		or not sim.parts.Diplomacy.canTrade(sim, src.pid, dst.pid)
	then
		-- hedef liman yıkıldı, ya da iki liman da aynı sahibe geçti
		self:finish(sim)
		return
	end
	self.idx += 1
	self.traveled += 1
	if sim.parts.Warship.isWaterShore(sim.world, self.path[math.min(self.idx, #self.path)], sim.shoreTmp) then
		self.lastSafe = sim.tickNo
	end
	if self.idx <= #self.path then
		return
	end
	local gold = Trade.gold(sim.cfg, self.traveled)
	if self.captured then
		sim:addGold(self.pid, gold, self.path[#self.path])
	else
		sim:addGold(src.pid, gold, src.tile)
		sim:addGold(dst.pid, gold, dst.tile)
	end
	self:finish(sim)
end

return Trade
]]></ProtectedString>
							<string name="ScriptGuid">{E7A8F2A7-1E9A-4BE1-9761-76E1A0E806A7}</string>
