				</Item>
				<Item class="ModuleScript" referent="RBXEFAF14E2593A4F9299CBDA68D084E59A">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- TeamLobbyTests: Team Online lobileri (LobbyRules takım kuralları, LobbyDirectory'de iki tür lobi). RoWorld tests/team_lobbies.luau'dan
-- 2-4 takıma uyarlandı (AGPL-3.0, © 2026 Snick Co.). Oyunda çalışmaz; Studio'da elle:
-- require(game.ServerScriptService.Server.Dev.TeamLobbyTests).run()  -> { passed, failed, lines }

local Lobbies = script.Parent.Parent.Lobbies
local LobbyRules = require(Lobbies.LobbyRules)
local LobbyStore = require(Lobbies.LobbyStore)
local LobbyDirectory = require(Lobbies.LobbyDirectory)
local Catalog = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Maps"):WaitForChild("Catalog"))

local TeamLobbyTests = {}

function TeamLobbyTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end
	local TEAM, FFA = LobbyRules.MODE_TEAM, LobbyRules.MODE_FFA

	-- kurallar
	do
		local counts, same = {}, 0
		for i = 0, 299 do
			local prev = (i % 3) + 2
			local n = LobbyRules.pick_teams(prev, (i * 0.618) % 1)
			counts[n] = (counts[n] or 0) + 1
			if n == prev then
				same += 1
			end
		end
		expect(same == 0, "takım sayısı bir öncekiyle aynı gelmez")
		expect((counts[2] or 0) > 0 and (counts[3] or 0) > 0 and (counts[4] or 0) > 0 and counts[5] == nil and counts[1] == nil, "takım sayısı yalnız 2, 3, 4")
		expect(LobbyRules.pick_teams(nil, 0) == 2 and LobbyRules.pick_teams(nil, 0.99) == 4, "önceki yokken üçü de gelebilir")
	end
	expect(LobbyRules.team_max(50, 3) == 48 and LobbyRules.team_max(45, 2) == 44 and LobbyRules.team_max(40, 4) == 40, "oyuncu sınırı takım sayısının katı")
	do
		local rec = { id = "T", map = "europe", starts = 100, max = 48, mode = TEAM, teams = 3, players = 0, status = "open" }
		local d = LobbyRules.decode(rec)
		expect(d.mode == TEAM and d.teams == 3 and LobbyRules.mode_of(d) == TEAM, "kayıt türü ve takım sayısını korur")
		local f = LobbyRules.decode({ id = "F", map = "europe", starts = 100, max = 50 })
		expect(f.mode == nil and f.teams == nil and LobbyRules.mode_of(f) == FFA, "eski kayıt: herkes kendi için")
		local spec = LobbyRules.take_spec(1, { "u" }, 0, nil, TEAM)
		expect(LobbyRules.fits(d, spec) and not LobbyRules.fits(f, spec), "takım isteği yalnız takım lobisine oturur")
		local fspec = LobbyRules.take_spec(1, { "u" }, 0)
		expect(LobbyRules.fits(f, fspec) and not LobbyRules.fits(d, fspec), "Solo Online isteği takım lobisine oturmaz")
		local v = LobbyRules.public_view(d, 0)
		expect(v.mode == TEAM and v.teams == 3 and LobbyRules.public_view(f, 0).mode == FFA and LobbyRules.public_view(f, 0).teams == nil, "istemcinin gördüğü tür ve takım sayısı")
	end

	-- dizin: iki tür lobi
	local clock = 9000
	local function tnow()
		return clock
	end
	local store = LobbyStore.localstore(tnow)
	local rng = Random.new(7)
	local ids, reserved = 0, 0
	local created = {} -- { map, teams? } sırayla
	local function maps()
		local out = {}
		for _, id in Catalog.order do
			table.insert(out, { id = id, name = Catalog[id].name, max = Catalog[id].onlineMax })
		end
		return out
	end
	local hub = LobbyDirectory.new({
		store = store,
		teleport = {
			reserve = function()
				reserved += 1
				return "code" .. reserved, "psid" .. reserved
			end,
			send = function()
				return true
			end,
		},
		maps = maps,
		now = tnow,
		rand = function()
			return rng:NextNumber()
		end,
		new_id = function()
			ids += 1
			return "L" .. ids
		end,
		wait = function() end,
		kinds = function()
			return { FFA, TEAM }
		end,
		log = function(text)
			local map, rest = string.match(text, "created %S+ on (%S+) %((.-)%)")
			if map then
				table.insert(created, { map = map, teams = tonumber(string.match(rest, ", (%d) teams")) })
			end
		end,
	})
	hub:refresh()
	local ffa, team = hub:view(FFA), hub:view(TEAM)
	expect(#ffa == LobbyRules.TARGET_OPEN and #team == LobbyRules.TARGET_OPEN, "her türden bir lobi açık (" .. #ffa .. " solo, " .. #team .. " takım)")
	expect(#hub:view() == #ffa + #team, "türsüz görünüm ikisini de içerir")
	local t1 = team[1]
	expect(t1 and t1.mode == TEAM and t1.teams and t1.teams >= 2 and t1.teams <= 4 and t1.max % t1.teams == 0, string.format("takım lobisi: %s takım, %s oyuncu (katı)", tostring(t1 and t1.teams), tostring(t1 and t1.max)))
	expect(ffa[1].mode == FFA and ffa[1].teams == nil, "solo lobide takım yok")

	-- katılma türe göre
	local ok1, _, l1 = hub:join({ "a" }, { mode = TEAM })
	local ok2, _, l2 = hub:join({ "b" })
	expect(ok1 and l1 and LobbyRules.mode_of(l1) == TEAM and ok2 and l2 and LobbyRules.mode_of(l2) == FFA, "takım isteyen takım lobisine, solo isteyen solo lobiye oturur")

	-- sıra: solo lobiler doluyken takım sırası beklemez
	do
		for _, v in store.list() do
			local r = LobbyRules.decode(v)
			if LobbyRules.mode_of(r) == FFA then
				r.players = r.max
				store.put(r, 900)
			end
		end
		hub:refresh()
		local res = {}
		for _, e in { { "s1", FFA }, { "t1", TEAM } } do
			hub:enqueue({
				key = e[1],
				since = clock,
				mode = e[2],
				members = function()
					return { e[1] }
				end,
				done = function(o, why)
					res[e[1]] = if o then "seated" else why
				end,
			})
		end
		-- (solo: dolu lobi gizlenir ama yerine yenisi hemen açılır; o da doldurulursa bekler)
		for _, v in store.list() do
			local r = LobbyRules.decode(v)
			if LobbyRules.mode_of(r) == FFA then
				r.players = r.max
				store.put(r, 900)
			end
		end
		hub:serve_queue()
		expect(res.t1 == "seated", "takım sırası solo maçların doluluğundan etkilenmez")
		expect(res.s1 == nil and hub:queued("s1") ~= nil, "solo oyuncu yer açılana dek sırada")
		hub:dequeue("s1")
	end

	-- uzun süre: her tür hep açık, harita ve takım sayısı arka arkaya tekrarlanmaz
	do
		table.clear(created)
		local gapsF, gapsT = 0, 0
		for _ = 1, 400 do
			clock += 3
			hub:refresh()
			if #hub:view(FFA) == 0 then
				gapsF += 1
			end
			if #hub:view(TEAM) == 0 then
				gapsT += 1
			end
		end
		local lastMap: { [string]: string } = {}
		local lastTeams, mapRepeats, teamRepeats, teamMade, ffaMade = nil, 0, 0, 0, 0
		local seenTeams = {}
		for _, c in created do
			local kind = if c.teams then TEAM else FFA
			if lastMap[kind] == c.map then
				mapRepeats += 1
			end
			lastMap[kind] = c.map
			if c.teams then
				teamMade += 1
				seenTeams[c.teams] = true
				if c.teams == lastTeams then
					teamRepeats += 1
				end
				lastTeams = c.teams
			else
				ffaMade += 1
			end
		end
		expect(gapsF == 0 and gapsT == 0, string.format("20 dakika boyunca iki türde de hep katılınabilir maç var (%d / %d kez yok)", gapsF, gapsT))
		expect(mapRepeats == 0 and teamMade > 3 and ffaMade > 3, string.format("aynı türde harita arka arkaya gelmez (%d solo, %d takım maçı, %d tekrar)", ffaMade, teamMade, mapRepeats))
		expect(teamRepeats == 0 and seenTeams[2] and seenTeams[3] and seenTeams[4], "takım sayısı arka arkaya gelmez, 2 / 3 / 4 hepsi gelir")
	end

	return { passed = passed, failed = failed, lines = lines }
end

return TeamLobbyTests
]]></ProtectedString>
