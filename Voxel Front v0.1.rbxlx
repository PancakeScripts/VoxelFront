				<Item class="ModuleScript" referent="RBXB1C692CD2CD84CECA2B10C3CB81841BC">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Ordered, independently expiring battle notifications. Plain text only.
-- push(message, duration?, color?): color = kartın arka planı (RoWorld EventFeed kategorileri: CombatFeed.GOOD / BAD /
-- ALERT / INFO / ALLIANCE; verilmezse BAD). Yazı ve süre çubuğu koyu lacivert, kenar rengin koyusu. Aynı yazı 4 sn içinde ikinci kez gelirse eklenmez (RoWorld duplicate_message).
local Fonts = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Fonts"))
local CombatFeed = {}
CombatFeed.__index = CombatFeed
CombatFeed.GOOD = Color3.fromRGB(74, 222, 128)
CombatFeed.BAD = Color3.fromRGB(248, 113, 113)
CombatFeed.ALERT = Color3.fromRGB(251, 146, 60)
CombatFeed.INFO = Color3.fromRGB(148, 163, 184)
CombatFeed.ALLIANCE = Color3.fromRGB(167, 139, 250)
local DUPLICATE_S = 4
local lastShown: { [string]: number } = {}
function CombatFeed.new(gui: ScreenGui): any
 local root = Instance.new("Frame")
 root.Name = "CombatFeed"; root.BackgroundTransparency = 1
 root.Position = UDim2.fromScale(.008, .17); root.Size = UDim2.fromScale(.235, .54)
 root.ZIndex = 40; root.Parent = gui
 local layout = Instance.new("UIListLayout")
 layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Padding = UDim.new(.0103, 0); layout.Parent = root
 return setmetatable({root=root, queue={}, active={}, serial=0, generation=0}, CombatFeed)
end
function CombatFeed.pump(self: any)
 while #self.active < 5 and #self.queue > 0 do
  local item=table.remove(self.queue,1)
  self.serial+=1
  local card=Instance.new("Frame")
  card.Name="Notice"..self.serial;card.LayoutOrder=self.serial
  local tone=item.color or CombatFeed.BAD
  local ink=Color3.fromRGB(15,23,42)
  card.Size=UDim2.new(1,0,.1132,0);card.BackgroundColor3=tone
  card.BackgroundTransparency=.05;card.BorderSizePixel=0;card.ZIndex=40
  local aspect=Instance.new("UIAspectRatioConstraint");aspect.AspectRatio=6;aspect.AspectType=Enum.AspectType.FitWithinMaxSize;aspect.Parent=card
  local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(.106,0);corner.Parent=card
  local stroke=Instance.new("UIStroke");stroke.Color=tone:Lerp(Color3.new(0,0,0),.35);stroke.Transparency=.2;stroke.Parent=card
  local text=Instance.new("TextLabel");text.Name="Message";text.BackgroundTransparency=1
  text.Position=UDim2.fromScale(.025,.091);text.Size=UDim2.fromScale(.95,.773)
  text.Text=item.message;text.RichText=false;text.TextWrapped=true;text.TextScaled=true
  text.FontFace = Fonts.main;text.TextColor3=ink
  text.TextXAlignment=Enum.TextXAlignment.Left;text.ZIndex=41
  local limit=Instance.new("UITextSizeConstraint");limit.MinTextSize=1;limit.MaxTextSize=14;limit.Parent=text;text.Parent=card
  local progress=Instance.new("Frame");progress.Name="Lifetime";progress.BorderSizePixel=0
  progress.BackgroundColor3=ink;progress.BackgroundTransparency=.55;progress.Position=UDim2.fromScale(0,.955);progress.Size=UDim2.fromScale(1,.045);progress.ZIndex=41;progress.Parent=card
  table.insert(self.active,card);card.Parent=self.root
  if self.changed then self.changed() end
  game:GetService("TweenService"):Create(progress,TweenInfo.new(item.duration,Enum.EasingStyle.Linear),{Size=UDim2.fromScale(0,.045)}):Play()
  local generation=self.generation
  task.delay(item.duration,function()
   if generation~=self.generation then return end
   local at=table.find(self.active,card);if at then table.remove(self.active,at) end
   card:Destroy();self:pump();if self.changed then self.changed() end
  end)
 end
end
function CombatFeed.push(self: any,message: string,duration: number?,color: Color3?)
 local now=os.clock()
 if lastShown[message] and now-lastShown[message]<DUPLICATE_S then return end
 lastShown[message]=now
 if #self.queue>=10 then table.remove(self.queue,1) end -- (bekleyen çok birikirse en eskisi düşer)
 table.insert(self.queue,{message=message,duration=duration or 9,color=color});self:pump()
end
function CombatFeed.clear(self: any)
 self.generation+=1;table.clear(self.queue)
 for _,card in self.active do card:Destroy() end
 table.clear(self.active)
 if self.changed then self.changed() end
end
return CombatFeed
]]></ProtectedString>
						<string name="ScriptGuid">{C33A58A6-8CFD-48B2-90EE-AF15F68BD028}</string>
