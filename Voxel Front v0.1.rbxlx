						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Rng: seed'li, deterministik rastgele sayı üreteci. Repodaki PseudoRandom ile AYNI algoritma (sfc32; seed splitmix32
-- ile dört duruma açılır, düşük entropili seed'ler 12 adım ısıtılarak dağıtılır). Aynı seed repoyla aynı diziyi verir.
-- Roblox'un Random sınıfı yerine bu kullanılır: Core saf kalır ve aynı seed aynı oyunu verir.

local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { s0: number, s1: number, s2: number, s3: number }, Rng))

local band, bxor, bor, lshift, rshift = bit32.band, bit32.bxor, bit32.bor, bit32.lshift, bit32.rshift
local M = 0xFFFFFFFF

-- a * b'nin alt 32 biti (JS Math.imul ile aynı bit deseni; a, b işaretsiz 32 bit)
local function imul(a: number, b: number): number
	local al, ah = band(a, 0xFFFF), rshift(a, 16)
	local bl, bh = band(b, 0xFFFF), rshift(b, 16)
	local mid = band(ah * bl + al * bh, 0xFFFF)
	return band(mid * 65536 + al * bl, M)
end

local function nextRaw(self: Rng): number
	local t = band(band(self.s0 + self.s1, M) + self.s3, M)
	self.s3 = band(self.s3 + 1, M)
	local s1 = self.s1
	self.s0 = bxor(s1, rshift(s1, 9))
	local s2 = self.s2
	self.s1 = band(s2 + lshift(s2, 3), M)
	s2 = bor(lshift(s2, 21), rshift(s2, 11))
	self.s2 = band(s2 + t, M)
	return t
end

function Rng.new(seed: number): Rng
	-- seed | 0: 32 bite kırpılır (kesirli kısım atılır)
	local h = band(math.floor(seed), M)
	local function split(): number
		h = band(h + 0x9E3779B9, M)
		local t = bxor(h, rshift(h, 16))
		t = imul(t, 0x21F0AAAD)
		t = bxor(t, rshift(t, 15))
		t = imul(t, 0x735A2D97)
		return bxor(t, rshift(t, 15))
	end
	local self = setmetatable({ s0 = split(), s1 = 0, s2 = 0, s3 = 0 }, Rng)
	self.s1 = split()
	self.s2 = split()
	self.s3 = split()
	for _ = 1, 12 do
		nextRaw(self)
	end
	return self
end

-- [0, 2^32) arası tamsayı
function Rng.nextU32(self: Rng): number
	return nextRaw(self)
end

-- [0, 1)
function Rng.float(self: Rng): number
	return nextRaw(self) / 4294967296
end

-- [lo, hi] arası tamsayı (uçlar dahil). Repodaki nextInt(lo, hi + 1) ile aynı sonucu verir.
function Rng.int(self: Rng, lo: number, hi: number): number
	return lo + math.floor(nextRaw(self) / 4294967296 * (hi - lo + 1))
end

return Rng
]]></ProtectedString>
