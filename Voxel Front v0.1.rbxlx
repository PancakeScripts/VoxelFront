						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- ConfigTests: Solo Online'ın kapatma anahtarı ve izin listesi (Server.OnlineConfig). Oyunda çalışmaz; Studio'da elle:
-- require(game.ServerScriptService.Server.Dev.ConfigTests).run()  -> { passed, failed, lines }  (birkaç saniye sürer)

local OnlineConfig = require(script.Parent.Parent.OnlineConfig)

local ConfigTests = {}

function ConfigTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end
	local savedMode, savedExtra = OnlineConfig.mode, OnlineConfig.extra
	local dev = OnlineConfig.ALLOWLIST[1]

	-- değer çözme
	local m, e = OnlineConfig.parse("off")
	expect(m == "off" and next(e) == nil, "\"off\" kapatır")
	m = OnlineConfig.parse("public")
	expect(m == "public", "\"public\" herkese açar")
	m = OnlineConfig.parse(nil)
	expect(m == OnlineConfig.DEFAULT_MODE, "değer yoksa kodun varsayılanı (" .. OnlineConfig.DEFAULT_MODE .. ")")
	m = OnlineConfig.parse("yes please")
	expect(m == OnlineConfig.DEFAULT_MODE, "tanınmayan değer varsayılana döner")
	m, e = OnlineConfig.parse({ mode = "allowlist", users = { 111, "222", -5, "x" } })
	expect(m == "allowlist" and e[111] and e[222] and not e[-5], "tablo: kip ve eklenen kullanıcılar (bozuklar atılır)")

	-- kime açık
	OnlineConfig.mode, OnlineConfig.extra = "allowlist", { [111] = true }
	expect(OnlineConfig.allowed(dev) and OnlineConfig.allowed(111) and not OnlineConfig.allowed(999), "izin listesi: geliştirici ve eklenen açık, başkası kapalı")
	OnlineConfig.mode = "off"
	expect(not OnlineConfig.allowed(dev) and not OnlineConfig.allowed(111), "kapalı: geliştirici dahil kimse")
	OnlineConfig.mode = "public"
	expect(OnlineConfig.allowed(999), "herkese açık: herkes")

	-- canlı değişim: okunan değer değişince haber verilir; okunamazsa son durum kalır
	OnlineConfig.mode, OnlineConfig.extra = "allowlist", {}
	local value: any = "allowlist"
	local broken = false
	local changes = 0
	local stop = false
	OnlineConfig.start(function()
		changes += 1
	end, {
		read = function()
			if broken then
				error("DataStoreService: InternalServerError")
			end
			return value
		end,
		every = 0.05,
		stop = function()
			return stop
		end,
	})
	task.wait(0.2)
	expect(changes == 0, "değişmeyen değer haber vermez")
	value = "off"
	task.wait(0.2)
	expect(changes == 1 and OnlineConfig.mode == "off", "kapatma anahtarı: bir sonraki okumada kapanır")
	broken = true
	task.wait(0.2)
	expect(changes == 1 and OnlineConfig.mode == "off", "okunamazsa son durum kalır")
	broken = false
	value = { mode = "allowlist", users = { 333 } }
	task.wait(0.2)
	expect(changes == 2 and OnlineConfig.allowed(333) and OnlineConfig.allowed(dev), "yeniden açılır, eklenen hesap girer")
	value = { mode = "allowlist", users = {} }
	task.wait(0.2)
	expect(changes == 3 and not OnlineConfig.allowed(333), "listeden çıkarılan hesap kapanır")
	stop = true
	task.wait(0.1)

	OnlineConfig.mode, OnlineConfig.extra = savedMode, savedExtra
	return { passed = passed, failed = failed, lines = lines }
end

return ConfigTests
]]></ProtectedString>
