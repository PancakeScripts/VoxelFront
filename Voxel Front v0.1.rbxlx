				</Item>
				<Item class="ModuleScript" referent="RBXBE959E4F17B748D9852565B5309744C8">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Reference-resolution scaling. Frames use Scale; the properties Roblox only takes in pixels (text size
-- caps, stroke thickness, offset corners) are multiplied by k here, so everything shrinks/grows with the
-- screen in the same proportion. Reference = the Studio viewport the UI is designed in: there k = 1, so
-- a playtest looks exactly like edit mode.
local UiScale = {}

local REF_W, REF_H = 1013, 598
local k = 1
local listeners: { (number) -> () } = {}

local function compute(): number
	local cam = workspace.CurrentCamera
	if not cam then
		return 1
	end
	local v = cam.ViewportSize
	if v.X < 1 or v.Y < 1 then
		return 1
	end
	return math.min(v.X / REF_W, v.Y / REF_H)
end

function UiScale.k(): number
	return k
end

-- fn(k) now and on every viewport change.
function UiScale.onChanged(fn: (number) -> ())
	table.insert(listeners, fn)
	fn(k)
end

-- Each tracked pixel property keeps its 1080p value (ref); a write that isn't ours becomes the new ref.
type Track = { inst: Instance, prop: string, ref: any, last: any, apply: (any) -> any }
local tracks: { [Instance]: { Track } } = {}

local function write(t: Track)
	(t.inst :: any)[t.prop] = t.apply(t.ref)
	-- read back: the engine stores floats at lower precision, compare against what it actually holds
	t.last = (t.inst :: any)[t.prop]
end

local function track(inst: Instance, prop: string, apply: (any) -> any)
	local t: Track = { inst = inst, prop = prop, ref = (inst :: any)[prop], last = nil, apply = apply }
	local list = tracks[inst]
	if not list then
		list = {}
		tracks[inst] = list
		inst.Destroying:Connect(function()
			tracks[inst] = nil
		end)
	end
	table.insert(list :: { Track }, t)
	write(t)
	inst:GetPropertyChangedSignal(prop):Connect(function()
		local v = (inst :: any)[prop]
		if v ~= t.last then
			t.ref = v
			write(t)
		end
	end)
end

local function px(v: number): number
	return math.max(1, math.floor(v * k + 0.5))
end

local function fit(inst: Instance)
	if tracks[inst] then
		return
	end
	if inst:IsA("UITextSizeConstraint") then
		track(inst, "MinTextSize", function(v)
			return px(v)
		end)
		track(inst, "MaxTextSize", function(v)
			return px(v)
		end)
	elseif inst:IsA("UIStroke") then
		track(inst, "Thickness", function(v)
			return v * k
		end)
	elseif inst:IsA("UICorner") then
		track(inst, "CornerRadius", function(v)
			return UDim.new(v.Scale, v.Offset * k)
		end)
	elseif inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		if not (inst :: any).TextScaled then
			track(inst, "TextSize", function(v)
				return px(v)
			end)
		end
	end
end

-- Scale pixel-only properties of root and all its (current and future) descendants.
function UiScale.bind(root: Instance)
	fit(root)
	for _, d in root:GetDescendants() do
		fit(d)
	end
	root.DescendantAdded:Connect(function(d)
		-- let the creating code finish setting properties first
		task.defer(function()
			if d.Parent then
				fit(d)
			end
		end)
	end)
end

local function refresh()
	local nk = compute()
	if math.abs(nk - k) < 1e-4 then
		return
	end
	k = nk
	for _, list in tracks do
		for _, t in list do
			write(t)
		end
	end
	for _, fn in listeners do
		task.spawn(fn, k)
	end
end

local camConn: RBXScriptConnection? = nil
local function hookCamera()
	if camConn then
		camConn:Disconnect()
	end
	local cam = workspace.CurrentCamera
	if cam then
		camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
	end
	refresh()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)
k = compute()
hookCamera()

return UiScale
]]></ProtectedString>
						<string name="ScriptGuid">{D7F8A830-C063-42CF-87DD-2E277BA3F0A4}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">UiScale</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">4d010ee70765aa4f0af516e400000e57</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX4C853B7E2B2045678E601069E0401CF7">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Icons: yalnızca Assets'e girdiğin kendi görsellerin (rbxassetid://...) kullanılır. Hazır/gömülü simge yok:
-- kimlik boşsa görsel boş kalır ve çağıran yazı/emoji yedeğini (Assets.Fallback) kullanır.
-- Yapı şekilleri (şehir daire, liman beşgen, fabrika altıgen, savunma sekizgen, SAM kare, silo üçgen) koddan
-- çizilir. Icons.raw da koddan üretilen desenler için (ray deseni).

local AssetService = game:GetService("AssetService")

local Icons = {}

local contents: { [string]: Content } = {}
local failed = false

local function newImage(size: number, pixels: buffer, height: number?): Content?
	if failed then
		return nil
	end
	local h = height or size
	local ok, res = pcall(function(): Content
		local img = AssetService:CreateEditableImage({ Size = Vector2.new(size, h) })
		img:WritePixelsBuffer(Vector2.zero, Vector2.new(size, h), pixels)
		return Content.fromObject(img)
	end)
	if not ok then
		failed = true
		warn("[Frontline] could not open icon image (EditableImage): " .. tostring(res))
		return nil
	end
	return res
end

-- Görseli ImageLabel'a koyar: yalnız Assets kimliği (boş değilse). Koyabildiyse true.
function Icons.apply(img: ImageLabel | ImageButton, _key: string?, assetId: string?): boolean
	if type(assetId) == "string" and assetId ~= "" then
		img.Image = assetId
		return true
	end
	return false
end

-- Kullanıcı görseli var mı?
function Icons.available(_key: string?, assetId: string?): boolean
	return type(assetId) == "string" and assetId ~= ""
end

local SHAPE_SIZE = 128
local SHAPE_R = 0.9 -- şeklin dış yarıçapı ([-1, 1] karesinde); dışa taşan vurgu bandına yer kalır

-- tür -> (kenar sayısı, dönüş açısı); 0 kenar = daire
local SIDES: { [string]: { number } } = {
	city = { 0, 0 },
	port = { 5, -math.pi / 2 }, -- beşgen, sivri ucu yukarı
	factory = { 6, 0 }, -- altıgen
	post = { 8, math.pi / 8 }, -- sekizgen, düz kenarlar eksenlere paralel
	sam = { 4, math.pi / 4 }, -- kare
	silo = { 3, -math.pi / 2 }, -- üçgen, sivri ucu yukarı
}

-- Şeklin işaretli uzaklığı (içeride negatif).
local function distance(kind: string, x: number, y: number): number
	local s = SIDES[kind] or SIDES.city
	local n, rot = s[1], s[2]
	if n == 0 then
		return math.sqrt(x * x + y * y) - SHAPE_R
	end
	local apothem = SHAPE_R * math.cos(math.pi / n)
	local d = -math.huge
	for k = 0, n - 1 do
		-- kenar normali: iki köşenin ortası yönünde
		local a = rot + (k + 0.5) * 2 * math.pi / n
		d = math.max(d, x * math.cos(a) + y * math.sin(a))
	end
	return d - apothem
end

-- Yapı şekli maskesi (beyaz; ImageColor3 ile boyanır). inset = kenar kalınlığı (kare boyuna oran; 0 = dış şekil,
-- negatif = dışa doğru genişler).
function Icons.shape(kind: string, inset: number): Content?
	local key = "shape_" .. kind .. "_" .. string.format("%.4f", inset)
	local c = contents[key]
	if c then
		return c
	end
	if failed then
		return nil
	end
	local size = SHAPE_SIZE
	local px = 2 / size -- bir pikselin [-1, 1] karesindeki boyu
	local shift = inset * 2
	local buf = buffer.create(size * size * 4)
	for j = 0, size - 1 do
		local y = (j + 0.5) * px - 1
		for i = 0, size - 1 do
			local x = (i + 0.5) * px - 1
			local d = distance(kind, x, y) + shift
			local a = math.clamp(0.5 - d / px, 0, 1) -- kenarda yumuşak geçiş
			local o = (j * size + i) * 4
			buffer.writeu8(buf, o, 255)
			buffer.writeu8(buf, o + 1, 255)
			buffer.writeu8(buf, o + 2, 255)
			buffer.writeu8(buf, o + 3, math.floor(a * 255 + 0.5))
		end
	end
	local made = newImage(size, buf)
	if made then
		contents[key] = made
	end
	return made
end

-- Şeklin kenarının (inset kalınlığında) içinde kalan en büyük kare: (kenar / kare boyu, merkezin dikey kayması / kare boyu).
-- Yapının ortasındaki görsel bu kareye sığdırılır: çerçevenin dışına ve kenar çizgisinin üstüne taşmaz. (Üçgende kare biraz
-- aşağıda, geniş kısımda daha büyük sığar.)
local boxes: { [string]: { number } } = {}
function Icons.innerBox(kind: string, inset: number): (number, number)
	local key = kind .. "_" .. string.format("%.4f", inset)
	local b = boxes[key]
	if b then
		return b[1], b[2]
	end
	local shift = inset * 2
	local function fits(h: number, cy: number): boolean
		for _, sx in { -1, 1 } do
			for _, sy in { -1, 1 } do
				if distance(kind, sx * h, cy + sy * h) + shift > 0 then
					return false
				end
			end
		end
		return true
	end
	local bestH, bestY = 0, 0
	for step = -15, 15 do
		local cy = step * 0.02
		local lo, hi = 0, 1
		for _ = 1, 20 do
			local mid = (lo + hi) / 2
			if fits(mid, cy) then
				lo = mid
			else
				hi = mid
			end
		end
		if lo > bestH + 1e-4 then
			bestH, bestY = lo, cy
		end
	end
	-- [-1, 1] biriminden kare boyuna oran: kenar 2h / 2 = h, kayma cy / 2
	boxes[key] = { bestH, bestY / 2 }
	return bestH, bestY / 2
end

-- Kodla üretilen küçük desen (ör. ray deseni): w x h RGBA piksel buffer'ı; aynı anahtar bir kez üretilir.
function Icons.raw(key: string, w: number, h: number, pixels: () -> buffer): Content?
	local k = "raw_" .. key
	local c = contents[k]
	if c then
		return c
	end
	if failed then
		return nil
	end
	local made = newImage(w, pixels(), h)
	if made then
		contents[k] = made
	end
	return made
end

function Icons.ok(): boolean
	return not failed
end

return Icons
]]></ProtectedString>
						<string name="ScriptGuid">{20893496-D131-4A6B-A102-ED63079DEB80}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Icons</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">15474ccd123c712a0af50f5100000bd8</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXA3A75D2272A04B02A3BAF29D53F92533">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- MapPalette: tile baytı -> piksel rengi (OpenFront arazi renkleri). Roblox API'si yok.
-- Tile baytı: bit7 kara, bit6 kıyı, bit5 okyanus, bit0-4 yükseklik / derinlik.
-- Pikseller RGBA, bellekte R,G,B,A sırasıyla.

local MapPalette = {}

local OCEAN = { 71, 133, 181 } -- #4785b5
local SAND = { 204, 203, 158 } -- #CCCB9E
local PLAINS = { 190, 220, 138 } -- #BEDC8A
local HIGHLAND = { 220, 203, 158 } -- #DCCB9E
local MOUNTAIN = { 230, 230, 230 } -- #e6e6e6

local function clamp(v: number): number
	return math.max(0, math.min(255, v))
end

-- Tek tile baytının rengi (r, g, b).
function MapPalette.colorOf(tb: number): (number, number, number)
	local isLand = bit32.band(tb, 0x80) ~= 0
	local isShore = bit32.band(tb, 0x40) ~= 0
	local m = bit32.band(tb, 0x1F)
	if isLand then
		if isShore then
			return SAND[1], SAND[2], SAND[3]
		elseif m < 10 then
			return PLAINS[1], clamp(PLAINS[2] - 2 * m), PLAINS[3]
		elseif m < 20 then
			local k = m - 10
			return clamp(HIGHLAND[1] + 2 * k), clamp(HIGHLAND[2] + 2 * k), clamp(HIGHLAND[3] + 2 * k)
		end
		local k = m // 2
		return clamp(MOUNTAIN[1] + k), clamp(MOUNTAIN[2] + k), clamp(MOUNTAIN[3] + k)
	end
	if isShore then
		-- kıyı suyu: %70 okyanus + %30 beyaz
		return math.floor(0.7 * OCEAN[1] + 76.5 + 0.5), math.floor(0.7 * OCEAN[2] + 76.5 + 0.5), math.floor(0.7 * OCEAN[3] + 76.5 + 0.5)
	end
	local d = math.min(m, 10)
	return clamp(OCEAN[1] - d), clamp(OCEAN[2] - d), clamp(OCEAN[3] - d)
end

-- tile baytı buffer'ından RGBA piksel buffer'ı üretir. pace (isteğe bağlı): ara ara çağrılır (kare bütçesi).
function MapPalette.buildPixels(tileBytes: buffer, pace: (() -> ())?): buffer
	local size = buffer.len(tileBytes)
	local pixels = buffer.create(size * 4)
	local cache: { [number]: number } = {}
	for i = 0, size - 1 do
		if pace and i % 65536 == 0 then
			pace()
		end
		local tb = buffer.readu8(tileBytes, i)
		local packed = cache[tb]
		if not packed then
			local r, g, b = MapPalette.colorOf(tb)
			packed = r + g * 256 + b * 65536 + 255 * 16777216
			cache[tb] = packed
		end
		buffer.writeu32(pixels, i * 4, packed)
	end
	return pixels
end

return MapPalette
]]></ProtectedString>
						<string name="ScriptGuid">{B2F5A944-A0C8-4167-8027-3B1AC6E681DC}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
