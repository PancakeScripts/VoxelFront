					<ProtectedString name="Source"><![CDATA[--!strict
-- Wallet: oyuncunun Medals'ı, kasaları ve kozmetikleri (DataStore "frontline_wallet", anahtar "u<UserId>"; yalnız sunucu yazar).
-- RoWorld src/server/Purchases.luau ve src/server/Rewards.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.).
--
-- Kayıt: { medals, earned, day, dayAll, daySolo, credits = { crate = n }, receipts = { id }, owned = { [eşya] = true },
--   equipped = { skin?, flag? }, cratesBought, paid }
--   day / dayAll / daySolo: UTC günü ve o gün kazanılan Medals (2x'ten önce; günlük sınır yalnız solo:
--   Shared.Medals.SOLO_DAILY_CAP; online maçlarda sınır yok).
--
-- Satın alma = kaydedilmiş hak: Roblox'un ProcessReceipt'i hakkı kayda yazar, ancak sonra "granted" der (Roblox yazana dek
-- yeniden dener; aynı makbuz iki kez verilmez: PurchaseId saklanır). Kasa hakkı kasa açılınca harcanır.
-- Online maçın sonucu sunucunun kendi ölçümüdür (Wallet.pay; MatchServer). Solo maç oyuncunun cihazında çalışır: sonucu
-- istemcinin sözüdür; türlenir ve sınırlanır (Medals.sanitize), maçın bu sunucunun saatiyle gerçekten sürdüğünden uzun
-- olamaz ("soloStart"tan bu yana) ve o gerçek sürenin Medals.soloCap'inden fazlasını ödemez.
--
-- İstemci -> sunucu (ReplicatedStorage.FrontlineWallet, RemoteEvent): ("soloStart", mode) | ("soloResult", report)
--   | ("shop", "open", yer) | ("shop", "click", ürün): satın alma hunisi "Purchase" (Creator Hub > Analytics > Funnels):
--   1 Opened (mağaza / kasa penceresi açıldı; alan: yer) -> 2 Clicked (Robux penceresi açıldı; alan: ürün) ->
--   3 Bought | Not Bought (Roblox'un PromptProductPurchaseFinished / PromptGamePassPurchaseFinished'ı; alan: ürün)
-- Sınırlar (RoWorld ServerMain gibi): oyuncu başına saniyede en çok MAX_REQUESTS_PER_SEC kayıt isteği (kasa aç, equip, test
-- kasası) ve MAX_EVENTS_PER_SEC huni olayı; fazlası reddedilir. Bir oyuncunun aynı anda tek isteği işlenir. Bütün DataStore
-- istekleri Server.DsGate'ten geçer (sunucunun bütçesine göre bekler, sınıra takılanı yeniden dener).
-- Equip hemen geçerli olur (bellekte; istemciye ve maça hemen gider); kayda oyuncu EQUIP_SAVE_S boyunca başka bir şey
-- seçmezse yalnız son seçimle yazılır (hızlı tıklamalar tek yazma olur). Ondan önce başka bir yazma olursa (kasa, Medals)
-- bekleyen seçim onunla birlikte yazılır; oyuncu çıkarken ve sunucu kapanırken bekleyen yazılır.
-- Yarım kalan yazmalar sayılır (RoWorld Purchases.settle): Wallet.settle(kullanıcı, en çok sn) o oyuncunun yazmaları
-- bitene dek bekler (maç sunucusu ışınlamadan önce çağırır); sunucu kapanırken (BindToClose) bütün yazmaların bitmesi beklenir.
-- Mağaza (Shared.ShopFlags): ("claimDaily") günlük ödül (17 saatte bir 10-50 Medals); ("buyRegion") oyuncunun girişteki
--   bölgesinin bayrağı Medals ile (bir kez; alınca teklif bir daha çıkmaz); ("buyFlag", id) günün bayrağı Medals ile;
--   ("flagIntent", id) Robux penceresi açılmadan önce hangi bayrağın alındığı (ürün nadirlik başına bir tane: shopflag_epic /
--   _legendary; makbuz geldiğinde o bayrak, geçersizse günün aynı nadirlikteki sahip olunmayan bayrağı, o da yoksa
--   bayrağın Medals fiyatı verilir). Alınan bayrak hemen giyilir. Günün bayrakları oyuncu başına günde bir kez seçilip kayda
--   yazılır (dailyDay / dailyIds): gün içinde değişmez.
-- İstemci -> sunucu (ReplicatedStorage.FrontlineWalletCall, RemoteFunction):
--   ("inv") -> inv | ("openCrate") -> (ok, eşya | hata) | ("equip", "skin" | "flag", id | false) -> (ok, hata?)
--   Studio'da: ("devCrate") -> bir kasa hakkı (ürün kimlikleri boşken denemek için)
-- Sunucu -> istemci: ("inv", inv) | ("medals", { lines, total, balance, mode, day })
--   inv = { medals, owned = { id }, equipped, crates, cratesBought, double, cratesAllowed, day = { used, max } }

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared:WaitForChild("Assets"))
local Telemetry = require(Shared:WaitForChild("Telemetry"))
local DsGate = require(script.Parent:WaitForChild("DsGate"))
local Medals = require(Shared:WaitForChild("Medals"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local ShopFlags = require(Shared:WaitForChild("ShopFlags"))
local LocalizationService = game:GetService("LocalizationService")

local Wallet = {}

Wallet.STORE = "frontline_wallet"
Wallet.REMOTE = "FrontlineWallet"
Wallet.CALL = "FrontlineWalletCall"
Wallet.RECEIPTS_KEPT = 100
Wallet.MAX = 1000000000
Wallet.MAX_CREDITS = 1000
--- Oyuncu başına saniyede en çok kayıt isteği (RoWorld MAX_CREDIT_USES_PER_SEC) ve huni olayı (MAX_ANALYTICS_PER_SEC).
Wallet.MAX_REQUESTS_PER_SEC = 2
Wallet.MAX_EVENTS_PER_SEC = 6
--- Equip'ten sonra bu kadar başka seçim olmazsa kayda yazılır (sn).
Wallet.EQUIP_SAVE_S = 2
--- Solo sonucunun iddia edebileceği gerçek süreye pay (raporun yolu, saatin tanesi), dakika.
Wallet.SLACK_MIN = 0.25
--- Developer product -> verdiği hak ve sayısı (Assets.Products'taki kimlikle).
Wallet.GRANTS = {
	crate = { kind = "crate", count = 1 },
	crate_first = { kind = "crate", count = 1, firstOnly = true },
	crate3 = { kind = "crate", count = 3 },
	crate10 = { kind = "crate", count = 10 },
	shopflag_epic = { kind = "shopflag", rarity = "epic", count = 1 },
	shopflag_legendary = { kind = "shopflag", rarity = "legendary", count = 1 },
	-- Medal paketleri (normal mağaza)
	medals_small = { kind = "medals", amount = 500, count = 1 },
	medals_medium = { kind = "medals", amount = 1500, count = 1 },
	medals_large = { kind = "medals", amount = 4000, count = 1 },
	medals_huge = { kind = "medals", amount = 10000, count = 1 },
	-- solo maçın tek seferlik ürünleri ve Take Over: kaydedilmiş hak (anı gelince kullanılır: Wallet.useCredit)
	solo_troops2x = { kind = "solo_troops2x", count = 1 },
	solo_gold2x = { kind = "solo_gold2x", count = 1 },
	solo_troops10k = { kind = "solo_troops10k", count = 1 },
	solo_troops30k = { kind = "solo_troops30k", count = 1 },
	solo_troops70k = { kind = "solo_troops70k", count = 1 },
	solo_troops200k = { kind = "solo_troops200k", count = 1 },
	solo_gold100k = { kind = "solo_gold100k", count = 1 },
	solo_gold500k = { kind = "solo_gold500k", count = 1 },
	solo_gold2m = { kind = "solo_gold2m", count = 1 },
	solo_gold10m = { kind = "solo_gold10m", count = 1 },
	takeover = { kind = "takeover", count = 1 },
	takeover_online = { kind = "takeover_online", count = 1 },
}
--- Oyuncunun kullandırabileceği haklar (Wallet.useCredit).
Wallet.USABLE = {
	solo_troops2x = true, solo_gold2x = true, solo_troops10k = true, solo_troops30k = true, solo_troops70k = true,
	solo_troops200k = true, solo_gold100k = true, solo_gold500k = true, solo_gold2m = true, solo_gold10m = true,
	takeover = true, takeover_online = true,
}

type Record = {
	medals: number,
	earned: number,
	day: number,
	dayAll: number,
	daySolo: number,
	credits: { [string]: number },
	receipts: { string },
	owned: { [string]: boolean },
	equipped: { skin: string?, flag: string? },
	cratesBought: number,
	paid: boolean,
	dailyAt: number, -- son günlük ödülün alındığı an (os.time)
	dailyLast: number, -- son alınan günlük ödülün miktarı (CLAIMED iken o görünür)
	regionBought: boolean, -- bölge bayrağı alındı (teklif bir daha çıkmaz)
	dailyDay: number, -- günün bayrakları hangi UTC günü için seçildi
	dailyIds: { string }, -- o günün bayrakları
}

local store: any = nil
local records: { [Player]: Record } = {}
local double: { [Player]: boolean } = {}
local allowCrates: { [Player]: boolean } = {}
local solo: { [Player]: { mode: string, at: number, payouts: number } } = {}
--- Bir solo maçın en çok kaç sonucu ödenir: sonu ve Take Over'ın verdiği her yeni hayat (RoWorld MAX_SOLO_PAYOUTS).
Wallet.MAX_SOLO_PAYOUTS = 4
local remote: RemoteEvent? = nil
--- oyuncunun girişteki bölgesi (LocalizationService; "TR" gibi) ve Robux ile almak üzere olduğu mağaza bayrağı
local region: { [Player]: string } = {}
local flagIntent: { [number]: string } = {}
--- satın alma hunisi: oyuncunun açık oturumu ve tıkladığı ürün
local funnel: { [Player]: { id: string, product: string?, pending: boolean } } = {}
local PLACES = { crates = true, shop = true, gameover = true, menu = true, solo = true }

local function productKey(id: number, pass: boolean): string?
	if pass then
		for k, v in Assets.GamePasses :: any do
			if v == id and v ~= 0 then
				return k
			end
		end
		return nil
	end
	for k, v in Assets.Products :: any do
		if v == id and v ~= 0 then
			return k
		end
	end
	return nil
end

local function finished(p: Player, key: string?, bought: boolean)
	local f = funnel[p]
	if f == nil or not f.pending or key == nil or f.product ~= key then
		return
	end
	f.pending = false
	Telemetry.funnel(p, "Purchase", f.id, 3, if bought then "Bought" else "Not Bought", { key })
end

local function today(): number
	return math.floor(os.time() / 86400)
end

local function count(x: any): number
	local n = tonumber(x) or 0
	return if n ~= n then 0 else math.clamp(math.floor(n), 0, Wallet.MAX)
end

local function clean(v: any): Record
	if type(v) ~= "table" then
		v = {}
	end
	local rec: Record = {
		medals = count(v.medals),
		earned = count(v.earned),
		day = count(v.day),
		dayAll = count(v.dayAll),
		daySolo = count(v.daySolo),
		credits = {},
		receipts = {},
		owned = {},
		equipped = {},
		cratesBought = count(v.cratesBought),
		paid = v.paid == true,
		dailyAt = (function(): number
			-- (zaman damgası: count()'un 1 milyar sınırına takılmamalı; os.time() ~1.8 milyar)
			local t = tonumber(v.dailyAt) or 0
			return if t ~= t then 0 else math.clamp(math.floor(t), 0, 1e11)
		end)(),
		dailyLast = count(v.dailyLast),
		regionBought = v.regionBought == true,
		dailyDay = count(v.dailyDay),
		dailyIds = {},
	}
	if type(v.dailyIds) == "table" then
		for _, id in v.dailyIds do
			local it = Cosmetics.item(id)
			if it ~= nil and it.shop then
				table.insert(rec.dailyIds, id)
			end
		end
	end
	if rec.day ~= today() then
		rec.day = today()
		rec.dayAll = 0
		rec.daySolo = 0
	end
	if type(v.credits) == "table" then
		for k, n in v.credits do
			if type(k) == "string" and type(n) == "number" and n == n then
				rec.credits[k] = math.clamp(math.floor(n), 0, Wallet.MAX_CREDITS)
			end
		end
	end
	if type(v.receipts) == "table" then
		for _, r in v.receipts do
			if type(r) == "string" then
				table.insert(rec.receipts, r)
			end
		end
	end
	if type(v.owned) == "table" then
		for id, on in v.owned do
			if on == true and Cosmetics.item(id) ~= nil then
				rec.owned[id] = true
			end
		end
	end
	if type(v.equipped) == "table" then
		for _, slot in { "skin", "flag" } do
			local id = v.equipped[slot]
			local it = Cosmetics.item(id)
			if it ~= nil and it.kind == slot and rec.owned[id] then
				(rec.equipped :: any)[slot] = id
			end
		end
	end
	return rec
end

--- Bir sonraki günlük ödülün miktarı (10-50): oyuncuya ve son alışına göre sabit, mağazada önceden görünür.
local function dailyAmount(userId: number, dailyAt: number): number
	local seed = ((math.abs(userId) % 1000003) * 7919 + (dailyAt % 10000019)) % 2147483647
	return Random.new(seed):NextInteger(ShopFlags.DAILY_REWARD_MIN, ShopFlags.DAILY_REWARD_MAX)
end

local function key(userId: number): string
	return "u" .. tostring(userId)
end

--- Henüz kayda yazılmamış equip seçimi: kullanıcı -> { skin = id | false, flag = id | false } (false = çıkarıldı).
--- Her yeni seçimde yeni tablo (yazılırken gelen daha yeni seçim silinmesin).
local pendingEquip: { [number]: { [string]: any } } = {}
--- kullanıcı -> şu an süren yazma sayısı
local inflight: { [number]: number } = {}

local function overlay(rec: Record, pv: { [string]: any })
	for slot, id in pv do
		if id == false then
			(rec.equipped :: any)[slot] = nil
		elseif rec.owned[id] then
			(rec.equipped :: any)[slot] = id
		end
	end
end

--- Kaydın değişikliği (UpdateAsync, 3 deneme; DsGate'ten). fn(rec) false dönerse yazılmaz. Bekleyen equip seçimi her
--- yazmaya eklenir. Başarılıysa son kayıt, yoksa nil. Bekler.
local update
local function writeOnce(userId: number, fn: (Record) -> boolean): Record?
	for attempt = 1, 3 do
		local result: Record? = nil
		local wrote = false
		local pv: { [string]: any }? = nil
		local ok, err = pcall(function()
			store:UpdateAsync(key(userId), function(old: any): any
				local rec = clean(old)
				pv = pendingEquip[userId]
				if pv then
					overlay(rec, pv)
				end
				result = rec
				wrote = false
				if not fn(rec) then
					return nil
				end
				wrote = true
				return rec
			end)
		end)
		if ok then
			if wrote and pv ~= nil and pendingEquip[userId] == pv then
				pendingEquip[userId] = nil -- (bu yazmayla kayda geçti)
			end
			return result
		end
		warn("[Wallet] store write failed: " .. tostring(err))
		task.wait(attempt * 2)
	end
	return nil
end
update = function(userId: number, fn: (Record) -> boolean): Record?
	if store == nil or userId <= 0 then
		return nil
	end
	inflight[userId] = (inflight[userId] or 0) + 1
	local ok, rec = pcall(writeOnce, userId, fn)
	local n = (inflight[userId] or 1) - 1
	inflight[userId] = if n > 0 then n else nil
	if not ok then
		warn("[Wallet] " .. tostring(rec))
		return nil
	end
	return rec
end

--- `userId`'nin süren yazmaları bitene dek bekler (en çok maxS). Hepsi bittiyse true. Bekler.
function Wallet.settle(userId: number, maxS: number): boolean
	local t0 = os.clock()
	while inflight[userId] ~= nil and os.clock() - t0 < maxS do
		task.wait(0.1)
	end
	return inflight[userId] == nil
end

function Wallet.inventory(p: Player): any
	local rec = records[p]
	local owned = {}
	if rec then
		for id in rec.owned do
			table.insert(owned, id)
		end
		table.sort(owned)
	end
	local day = if rec and rec.day == today() then rec.daySolo else 0
	-- mağaza: bölge bayrağı (alınmadıysa ve sahip değilse), günlük ödülün hazır olmasına kalan, günün bayrakları
	local shop: any = nil
	if rec then
		local rf = Cosmetics.flagOf(region[p])
		local d, left = ShopFlags.day()
		shop = {
			region = if rf and not rec.regionBought and not rec.owned[rf.id] then rf.id else nil,
			dailyIn = math.max(0, rec.dailyAt + ShopFlags.DAILY_REWARD_S - os.time()),
			-- (alınabilirken vereceği miktar; alındıysa alınan miktar)
			dailyAmount = if os.time() - rec.dailyAt >= ShopFlags.DAILY_REWARD_S or rec.dailyLast <= 0
				then dailyAmount(p.UserId, rec.dailyAt)
				else rec.dailyLast,
			flags = if rec.dailyDay == d then table.clone(rec.dailyIds) else {},
			resetIn = left,
		}
	end
	return {
		credits = if rec then table.clone(rec.credits) else {},
		shop = shop,
		medals = if rec then rec.medals else 0,
		owned = owned,
		equipped = if rec then table.clone(rec.equipped) else {},
		crates = if rec then (rec.credits.crate or 0) else 0,
		cratesBought = if rec then rec.cratesBought else 0,
		double = double[p] == true,
		cratesAllowed = allowCrates[p] == true,
		loaded = rec ~= nil,
		day = { soloUsed = day, soloMax = Medals.SOLO_DAILY_CAP },
	}
end

local function notify(p: Player)
	if remote and p.Parent ~= nil then
		remote:FireClient(p, "inv", Wallet.inventory(p))
	end
end

local function remember(p: Player, rec: Record?)
	if rec ~= nil and p.Parent ~= nil then
		local pv = pendingEquip[p.UserId]
		if pv then
			overlay(rec, pv) -- (yazılırken seçilen daha yeni equip ekranda kalsın)
		end
		records[p] = rec
		notify(p)
	end
end

--- Bekleyen equip seçimini kayda yazar (yoksa bir şey yapmaz). Bekler.
local function flushEquip(userId: number, p: Player?)
	if pendingEquip[userId] == nil then
		return
	end
	local rec = update(userId, function(_r: Record): boolean
		return true
	end)
	if rec and p then
		remember(p, rec)
	end
end

local saveAt: { [number]: number } = {}
local function scheduleEquipSave(p: Player)
	local uid = p.UserId
	local t = os.clock()
	saveAt[uid] = t
	task.delay(Wallet.EQUIP_SAVE_S, function()
		if saveAt[uid] ~= t then
			return -- (arada yeni seçim: o yazacak)
		end
		saveAt[uid] = nil
		flushEquip(uid, p)
	end)
end

--- Bir maçın Medals'ı (sonuç + mod). Günlük sınır ve 2x Medals uygulanır; istemciye dökümü gider. Ödenen toplam. Bekler.
--- capRealMinutes: solo maçın gerçek süresi (tavan için; online'da nil). card: maç sonu ekranının kartları (online;
--- Medals.Tracker.card), istemciye dökümle gider.
function Wallet.pay(p: Player, result: any, mode: string, capRealMinutes: number?, card: any?): number
	local pay = Medals.payout(result, mode)
	local lines, base = pay.lines, pay.total
	if capRealMinutes ~= nil then
		local cap = Medals.soloCap(capRealMinutes)
		if base > cap then
			-- (o kadar gerçek sürenin ödeyebileceğinden fazlası: her satır aynı oranda küçülür)
			local k = cap / base
			base = 0
			local kept = {}
			for _, line in lines do
				line[2] = math.floor(line[2] * k)
				if line[2] > 0 then
					base += line[2]
					table.insert(kept, line)
				end
			end
			lines = kept
		end
	end
	local isSolo = Medals.isSolo(mode)
	local twice = double[p] == true
	local paid, allowed = 0, 0
	local rec = update(p.UserId, function(r: Record): boolean
		local room = if isSolo then math.max(0, Medals.SOLO_DAILY_CAP - r.daySolo) else math.huge
		allowed = math.min(base, room)
		paid = if twice then allowed * 2 else allowed
		if paid <= 0 then
			return false
		end
		r.medals = math.min(r.medals + paid, Wallet.MAX)
		r.earned = math.min(r.earned + paid, Wallet.MAX)
		r.dayAll += allowed
		if isSolo then
			r.daySolo += allowed
		end
		return true
	end)
	local shown = table.clone(lines)
	if rec == nil then
		-- (ödenecek bir şey yok ya da kayıt yazılamadı: ekran yine kartları ve sıfırı göstersin)
		if remote and p.Parent ~= nil then
			remote:FireClient(p, "medals", { lines = {}, total = 0, balance = if records[p] then records[p].medals else 0, mode = mode, card = card, failed = true })
		end
		return 0
	end
	if records[p] ~= nil or p.Parent ~= nil then
		remember(p, rec)
	end
	if allowed < base then
		table.insert(shown, { "limit", allowed - base })
	end
	if twice and allowed > 0 then
		table.insert(shown, { "double", allowed })
	end
	if remote and p.Parent ~= nil then
		remote:FireClient(p, "medals", {
			lines = shown,
			total = paid,
			balance = rec.medals,
			mode = mode,
			limited = allowed < base,
			card = card,
			day = { soloUsed = rec.daySolo, soloMax = Medals.SOLO_DAILY_CAP, solo = isSolo },
		})
	end
	if paid > 0 and p.Parent ~= nil then
		Telemetry.event(p, "Medals Earned", paid, { mode })
	end
	return paid
end

function Wallet.soloStarted(p: Player, mode: any)
	if type(mode) ~= "string" or not Medals.isSolo(mode) then
		solo[p] = nil
		return
	end
	solo[p] = { mode = mode, at = os.clock(), payouts = 0 }
end

--- İstemcinin solo sonucu (bir başlangıç başına bir kez ödenir). Bekler.
function Wallet.soloResult(p: Player, report: any): number
	local m = solo[p]
	if m == nil or m.payouts >= Wallet.MAX_SOLO_PAYOUTS then
		return 0
	end
	local t = os.clock()
	local real = math.max(0, (t - m.at) / 60)
	local r = Medals.sanitize(report, real + Wallet.SLACK_MIN)
	-- (bir hayatın sonucu: sonraki hayat buradan sayılır; maçtan çıktıysa bitti)
	m.payouts += 1
	m.at = t
	if r.left then
		solo[p] = nil
	end
	return Wallet.pay(p, r, m.mode, real)
end

--- Roblox ProcessReceipt: hakkı kaydet, sonra "granted" (kaydedilmeden asla).
function Wallet.processReceipt(info: any): Enum.ProductPurchaseDecision
	local userId = tonumber(info and info.PlayerId)
	local product = tonumber(info and info.ProductId)
	local receipt = if info and type(info.PurchaseId) == "string" then info.PurchaseId else nil
	local grant = nil
	if product and product ~= 0 then
		for name, id in Assets.Products :: any do
			if id == product then
				grant = Wallet.GRANTS[name]
			end
		end
	end
	if userId == nil or receipt == nil or grant == nil then
		warn("[Wallet] unknown receipt for product " .. tostring(product))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local rec = update(userId, function(r: Record): boolean
		if table.find(r.receipts, receipt) then
			return false -- (verilmişti: yeniden deneme)
		end
		if grant.kind == "shopflag" then
			-- mağaza bayrağı: oyuncunun seçtiği; geçersizse günün aynı nadirlikte sahip olmadığı; yoksa Medals fiyatı
			local function fits(id: any): boolean
				local it = Cosmetics.item(id)
				return it ~= nil and it.shop == true and it.rarity == grant.rarity and not r.owned[id]
			end
			local pick = flagIntent[userId]
			if not fits(pick) then
				pick = nil
				for _, id in r.dailyIds do
					if fits(id) then
						pick = id
						break
					end
				end
			end
			if pick then
				r.owned[pick] = true
				r.equipped.flag = pick
			else
				local price = (ShopFlags.PRICES :: any)[grant.rarity]
				r.medals = math.min(r.medals + (if price then price.medals else 0), Wallet.MAX)
			end
		elseif grant.kind == "medals" then
			r.medals = math.min(r.medals + grant.amount, Wallet.MAX)
		else
			r.credits[grant.kind] = math.min((r.credits[grant.kind] or 0) + grant.count, Wallet.MAX_CREDITS)
		end
		if grant.kind == "crate" then
			r.cratesBought += grant.count
		end
		table.insert(r.receipts, receipt)
		while #r.receipts > Wallet.RECEIPTS_KEPT do
			table.remove(r.receipts, 1)
		end
		r.paid = true
		return true
	end)
	if rec == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if grant.kind == "shopflag" then
		flagIntent[userId] = nil
	end
	local p = Players:GetPlayerByUserId(userId)
	if p then
		remember(p, rec)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

--- Kaydedilmiş bir hakkı harcar (solo ürünü, Take Over): kayıtta tek yazmada. (ok, hata?) Bekler.
function Wallet.useCredit(p: Player, kind: any): (boolean, string?)
	if type(kind) ~= "string" or not Wallet.USABLE[kind] then
		return false, "unknown"
	end
	local spent = false
	local rec = update(p.UserId, function(r: Record): boolean
		spent = false
		if (r.credits[kind] or 0) <= 0 then
			return false
		end
		r.credits[kind] -= 1
		spent = true
		return true
	end)
	if rec == nil then
		return false, "store unavailable"
	end
	remember(p, rec)
	if spent then
		if kind == "takeover" or kind == "takeover_online" then
			Telemetry.event(p, "Takeover Used", 1, { if kind == "takeover" then "Solo" else "Public" })
		else
			Telemetry.event(p, "Solo Boost Used", 1, { kind })
		end
	end
	return spent, if spent then nil else "no credit"
end

--- Harcanan hak kullanılamadıysa geri verilir (sunucu: online Take Over'ın hedefi o arada düştü). Bekler.
function Wallet.refundCredit(p: Player, kind: string)
	local rec = update(p.UserId, function(r: Record): boolean
		r.credits[kind] = math.min((r.credits[kind] or 0) + 1, Wallet.MAX_CREDITS)
		return true
	end)
	remember(p, rec)
end

--- Günün bayraklarını (yeni günse) seçip kayda yazar: gün içinde aynı kalır. Bekler.
function Wallet.ensureDaily(p: Player)
	local rec = records[p]
	local d = ShopFlags.day()
	if rec == nil or rec.dailyDay == d then
		return
	end
	local saved = update(p.UserId, function(r: Record): boolean
		if r.dailyDay == d then
			return false
		end
		r.dailyDay = d
		r.dailyIds = ShopFlags.pick(r.owned, d, p.UserId)
		return true
	end)
	remember(p, saved)
end

--- Günlük ödül: 17 saatte bir rastgele 10-50 Medals. (ok, miktar | hata) Bekler.
function Wallet.claimDaily(p: Player): (boolean, any)
	local amount = 0
	local why = "not ready"
	local rec = update(p.UserId, function(r: Record): boolean
		local now = os.time()
		if now - r.dailyAt < ShopFlags.DAILY_REWARD_S then
			why = "not ready"
			amount = 0
			return false
		end
		amount = dailyAmount(p.UserId, r.dailyAt) -- (mağazada gösterilen miktar)
		r.dailyAt = now
		r.dailyLast = amount
		r.medals = math.min(r.medals + amount, Wallet.MAX)
		r.earned = math.min(r.earned + amount, Wallet.MAX)
		return true
	end)
	if rec == nil then
		return false, "store unavailable"
	end
	remember(p, rec)
	if amount <= 0 then
		return false, why
	end
	Telemetry.event(p, "Daily Reward", amount)
	return true, amount
end

--- Medals ile mağaza alışverişi: ("region") bölge bayrağı ya da günün bayrağı (id). Alınan giyilir. (ok, hata?) Bekler.
function Wallet.buyWithMedals(p: Player, what: any): (boolean, string?)
	local id: string? = nil
	local price = 0
	local isRegion = what == "region"
	if isRegion then
		local rf = Cosmetics.flagOf(region[p])
		if rf == nil then
			return false, "no region flag"
		end
		id = rf.id
		price = ShopFlags.REGION_PRICE
	else
		local it = Cosmetics.item(what)
		if it == nil or not it.shop then
			return false, "unknown item"
		end
		id = it.id
		price = (ShopFlags.PRICES :: any)[it.rarity].medals
	end
	local why = "store unavailable"
	local done = false
	local rec = update(p.UserId, function(r: Record): boolean
		done = false
		if r.owned[id :: string] then
			why = "owned"
			return false
		end
		if isRegion and r.regionBought then
			why = "bought"
			return false
		end
		if not isRegion and (r.dailyDay ~= ShopFlags.day() or not table.find(r.dailyIds, id :: string)) then
			why = "not today"
			return false
		end
		if r.medals < price then
			why = "not enough"
			return false
		end
		r.medals -= price
		r.owned[id :: string] = true
		r.equipped.flag = id
		if isRegion then
			r.regionBought = true
		end
		done = true
		return true
	end)
	if rec == nil then
		return false, "store unavailable"
	end
	remember(p, rec)
	if done then
		local what = if isRegion then "Region Flag" else "Shop Flag"
		Telemetry.event(p, "Medals Spent", price, { what })
	end
	return done, if done then nil else why
end

--- Kasa aç: bir kasa hakkı harcanır, sahip olunmayan bir eşya eklenir (Cosmetics.roll); yuvası boşsa giyilir. Bekler.
function Wallet.openCrate(p: Player): (boolean, string?)
	local rng = Random.new()
	local got: string? = nil
	local why = "no crate"
	local rec = update(p.UserId, function(r: Record): boolean
		got = nil
		if (r.credits.crate or 0) <= 0 then
			why = "no crate"
			return false
		end
		local id = Cosmetics.roll(r.owned, rng:NextNumber(), rng:NextNumber())
		if id == nil then
			why = "everything owned"
			return false
		end
		r.credits.crate -= 1
		r.owned[id] = true
		local it = Cosmetics.item(id)
		if it ~= nil and (r.equipped :: any)[it.kind] == nil then
			(r.equipped :: any)[it.kind] = id
		end
		got = id
		return true
	end)
	if rec == nil then
		return false, "store unavailable"
	end
	remember(p, rec)
	if got == nil then
		return false, why
	end
	local gotItem = Cosmetics.item(got)
	Telemetry.event(p, "Crate Opened", 1, { if gotItem then Cosmetics.rarity(gotItem.rarity).name else "Unknown" })
	return true, got
end

--- Sahip olunan bir eşyayı yuvasına giy ya da yuvayı boşalt (id false). Bekler.
function Wallet.equip(p: Player, slot: any, id: any): (boolean, string?)
	if slot ~= "skin" and slot ~= "flag" then
		return false, "bad slot"
	end
	if id ~= false then
		local it = Cosmetics.item(id)
		if it == nil or it.kind ~= slot then
			return false, "unknown item"
		end
	end
	-- (hemen bellekte geçerli; kayda biraz sonra, son seçimle: scheduleEquipSave)
	local rec = records[p]
	if rec == nil then
		return false, "not loaded"
	end
	if id ~= false and not rec.owned[id] then
		return false, "not owned"
	end
	(rec.equipped :: any)[slot] = if id == false then nil else id
	local pv = table.clone(pendingEquip[p.UserId] or {})
	pv[slot] = id
	pendingEquip[p.UserId] = pv
	notify(p)
	scheduleEquipSave(p)
	if id ~= false then
		Telemetry.event(p, "Item Equipped", 1, { if slot == "skin" then "Skin" else "Flag" })
	end
	return true, nil
end

--- Oyuncunun maçta gösterdiği: { skin?, flag? } (hiçbir şey giyilmemişse nil).
function Wallet.equipped(p: Player): any
	local rec = records[p]
	if rec == nil or (rec.equipped.skin == nil and rec.equipped.flag == nil) then
		return nil
	end
	return table.clone(rec.equipped)
end

local function checkPass(p: Player)
	local id = Assets.GamePasses.medals2x
	if type(id) ~= "number" or id == 0 then
		double[p] = false
		return
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(p.UserId, id)
	end)
	double[p] = ok and owns == true
end

local function checkPolicy(p: Player)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(p)
	 end)
	-- (bilinmiyorsa kısıtlı sayılır; Studio'da deneme için açık)
	if ok and type(info) == "table" then
		allowCrates[p] = (info :: any).ArePaidRandomItemsRestricted == false
	else
		allowCrates[p] = RunService:IsStudio()
	end
	p:SetAttribute("FrontlineCrates", allowCrates[p])
end

local function arrive(p: Player)
	checkPolicy(p)
	checkPass(p)
	-- (oyuncunun o anki bölgesi: mağazadaki bölge bayrağı)
	local okR, code = pcall(function()
		return LocalizationService:GetCountryRegionForPlayerAsync(p)
	end)
	if okR and type(code) == "string" then
		region[p] = code
	end
	local got: any = nil
	local ok = false
	if store ~= nil and p.UserId > 0 then
		for attempt = 1, 5 do
			ok, got = pcall(function()
				return store:GetAsync(key(p.UserId))
			end)
			if ok or p.Parent == nil then
				break
			end
			task.wait(attempt * 2)
		end
	end
	if p.Parent == nil then
		return
	end
	if ok then
		records[p] = clean(got)
	elseif p.UserId <= 0 then
		records[p] = clean(nil) -- (Studio'nun yerel sunucusundaki deneme oyuncuları)
	else
		warn("[Wallet] could not read the record of " .. tostring(p.UserId))
	end
	notify(p)
	Wallet.ensureDaily(p)
end

function Wallet.start()
	if ReplicatedStorage:FindFirstChild(Wallet.REMOTE) then
		return
	end
	local okStore, s = pcall(function()
		return DataStoreService:GetDataStore(Wallet.STORE)
	end)
	store = if okStore then DsGate.wrap(s) else nil
	local ev = Instance.new("RemoteEvent")
	ev.Name = Wallet.REMOTE
	ev.Parent = ReplicatedStorage
	remote = ev
	local fn = Instance.new("RemoteFunction")
	fn.Name = Wallet.CALL
	fn.Parent = ReplicatedStorage
	MarketplaceService.ProcessReceipt = Wallet.processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(p: Player, passId: number, bought: boolean)
		finished(p, productKey(passId, true), bought)
		if bought and passId == Assets.GamePasses.medals2x and passId ~= 0 then
			double[p] = true
			notify(p)
		end
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId: number, productId: number, bought: boolean)
		local p = Players:GetPlayerByUserId(userId)
		if p then
			finished(p, productKey(productId, false), bought)
		end
	end)
	Players.PlayerAdded:Connect(function(p: Player)
		task.spawn(arrive, p)
	end)
	for _, p in Players:GetPlayers() do
		task.spawn(arrive, p)
	end
	Players.PlayerRemoving:Connect(function(p: Player)
		task.spawn(flushEquip, p.UserId, nil) -- (bekleyen equip seçimi kayda)
		saveAt[p.UserId] = nil
		records[p] = nil
		double[p] = nil
		allowCrates[p] = nil
		solo[p] = nil
		funnel[p] = nil
		region[p] = nil
	end)
	-- sunucu kapanırken bekleyen equip seçimleri yazılır (en çok birkaç saniye)
	game:BindToClose(function()
		local list = {}
		for uid in pendingEquip do
			table.insert(list, uid)
		end
		for _, uid in list do
			task.spawn(flushEquip, uid, nil)
		end
		-- (bekleyen equip seçimleri ve süren bütün yazmalar: Medals ödemeleri, kasalar; Roblox en çok 30 sn verir)
		local t = os.clock()
		while (next(pendingEquip) ~= nil or next(inflight) ~= nil) and os.clock() - t < 25 do
			task.wait(0.2)
		end
	end)
	-- oyuncu başına saniyelik sınır (RoWorld ServerMain: credit / analytics bütçeleri)
	local windows: { [Player]: { t: number, req: number, ev: number } } = {}
	local function allow(p: Player, kind: string): boolean
		local now = os.clock()
		local w = windows[p]
		if w == nil or now - w.t >= 1 then
			w = { t = now, req = 0, ev = 0 }
			windows[p] = w
		end
		local win = w :: { t: number, req: number, ev: number }
		if kind == "req" then
			if win.req >= Wallet.MAX_REQUESTS_PER_SEC then
				return false
			end
			win.req += 1
		else
			if win.ev >= Wallet.MAX_EVENTS_PER_SEC then
				return false
			end
			win.ev += 1
		end
		return true
	end
	Players.PlayerRemoving:Connect(function(p: Player)
		windows[p] = nil
	end)
	ev.OnServerEvent:Connect(function(p: Player, what: any, a: any, b: any)
		if not allow(p, "ev") then
			return
		end
		if what == "soloStart" then
			Wallet.soloStarted(p, a)
		elseif what == "soloResult" then
			Wallet.soloResult(p, a)
		elseif what == "shop" and type(b) == "string" then
			if a == "open" and PLACES[b] then
				local f = { id = HttpService:GenerateGUID(false), product = nil, pending = false }
				funnel[p] = f
				Telemetry.funnel(p, "Purchase", f.id, 1, "Opened", { b })
			elseif a == "click" and funnel[p] ~= nil and ((Assets.Products :: any)[b] ~= nil or (Assets.GamePasses :: any)[b] ~= nil) then
				local f = funnel[p] :: any
				f.product = b
				f.pending = true
				Telemetry.funnel(p, "Purchase", f.id, 2, "Clicked", { b })
			end
		end
	end)
	local busy: { [Player]: boolean } = {}
	fn.OnServerInvoke = function(p: Player, what: any, a: any, b: any): (any, any)
		if what == "inv" then
			if records[p] and records[p].dailyDay ~= ShopFlags.day() and not busy[p] and allow(p, "req") then
				busy[p] = true
				pcall(Wallet.ensureDaily, p) -- (gün döndü: yeni günün bayrakları)
				busy[p] = nil
			end
			return Wallet.inventory(p), nil
		end
		if what == "flagIntent" then
			local it = Cosmetics.item(a)
			if it and it.shop then
				flagIntent[p.UserId] = it.id
			end
			return true, nil
		end
		if busy[p] then
			return false, "busy"
		end
		if not allow(p, "req") then
			return false, "too fast"
		end
		busy[p] = true
		local ok, r1, r2 = pcall(function(): (any, any)
			if what == "openCrate" then
				return Wallet.openCrate(p)
			elseif what == "equip" then
				return Wallet.equip(p, a, b)
			elseif what == "useCredit" and a ~= "takeover_online" then
				-- (online Take Over'ın hakkını yalnız maç sunucusu harcar: MatchServer)
				return Wallet.useCredit(p, a)
			elseif what == "claimDaily" then
				return Wallet.claimDaily(p)
			elseif what == "buyRegion" then
				return Wallet.buyWithMedals(p, "region")
			elseif what == "buyFlag" then
				return Wallet.buyWithMedals(p, a)
			elseif what == "devCrate" and RunService:IsStudio() then
				local rec = update(p.UserId, function(r: Record): boolean
					r.credits.crate = math.min((r.credits.crate or 0) + 1, Wallet.MAX_CREDITS)
					return true
				end)
				remember(p, rec)
				return rec ~= nil, nil
			end
			return false, "unknown"
		end)
		busy[p] = nil
		if not ok then
			warn("[Wallet] " .. tostring(r1))
			return false, "error"
		end
		return r1, r2
	end
end

return Wallet
]]></ProtectedString>
