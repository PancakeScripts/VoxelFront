						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">662b0abb37a5a9fc0b00fc9100019533</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXB8EAC182DBDB482791A7B18559C35025">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- SoloShop: solo maçın tek seferlik Robux ürünleri (yalnız o maç için; online maçta yok).
--   Ekranın solunda ortada (StarterGui > FrontlineSolo > Left): x2 Gold ve x2 Troops teklifleri (arkalarında dönen ışık
--   ışınları Assets.Shop.sunrays, ortada görsel, altında ad ve Robux fiyatı) ve Shop düğmesi (Assets.Shop.soloShopButton).
--   Shop, solo mağaza penceresini açar (FrontlineMenu > SoloShopCard): bütün solo ürünleri, yalnız Robux ile.
-- Satın alma kayda hak olarak yazılır (Server.Wallet); oyuncu solo maçta hayattayken hak harcanır ve maça uygulanır
-- (Shared.Match.boost). O an uygulanamazsa (maç yok, düşmüş) hak sonraki solo maça kalır. x2 zaten etkinse yenisi harcanmaz.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared:WaitForChild("Assets"))
local Crates = require(script.Parent:WaitForChild("Crates"))
local Shop = require(script.Parent:WaitForChild("Shop"))
local ButtonDepth = require(script.Parent:WaitForChild("ButtonDepth"))
local Toast = require(script.Parent:WaitForChild("Toast"))

local SoloShop = {}
SoloShop.__index = SoloShop

--- Solo mağazadaki sıra; x2'ler soldaki tekliflerde de.
SoloShop.ITEMS = {
	{ key = "solo_troops2x", title = "x2 TROOPS", sub = "Troops grow twice as fast", short = "x2 Troops" },
	{ key = "solo_gold2x", title = "x2 GOLD", sub = "Twice the gold income", short = "x2 Gold" },
	{ key = "solo_troops10k", title = "+10K TROOPS", sub = "Added to your army now" },
	{ key = "solo_troops30k", title = "+30K TROOPS", sub = "Added to your army now" },
	{ key = "solo_troops70k", title = "+70K TROOPS", sub = "Added to your army now" },
	{ key = "solo_troops200k", title = "+200K TROOPS", sub = "Added to your army now" },
	{ key = "solo_gold100k", title = "+100K GOLD", sub = "Added to your gold now" },
	{ key = "solo_gold500k", title = "+500K GOLD", sub = "Added to your gold now" },
	{ key = "solo_gold2m", title = "+2M GOLD", sub = "Added to your gold now" },
	{ key = "solo_gold10m", title = "+10M GOLD", sub = "Added to your gold now" },
}
local LEFT = { Gold2x = "solo_gold2x", Troops2x = "solo_troops2x" }
local SPIN_DEG_PER_S = 25

local function productId(key: string): number
	local id = (Assets.Products :: any)[key]
	return if type(id) == "number" then id else 0
end

--- Sol sütun, üstteki Feedback düğmesinin altı ile alttaki "?" düğmesinin üstü arasındaki boşluğun ortasına yerleşir (her
--- ekranda; arada MARGIN_PX pay); boşluk büyükse en çok ekranın MAX_SHARE'i kadar yüksek olur.
local MARGIN_PX = 10
local MAX_SHARE = 0.58

--- deps = { localMatch, online: boolean, open = fn(card), close = fn(), menuOpen = fn() -> boolean,
---   topGuard: GuiObject? (Feedback düğmesi), bottomGuard: GuiObject? (alttaki "?" düğmesi) }
function SoloShop.new(gui: ScreenGui, card: Frame, deps: any)
	local self = setmetatable({}, SoloShop) :: any
	self.gui = gui
	self.left = gui:WaitForChild("Left") :: Frame
	self.card = card
	self.deps = deps
	self.active = false
	self.inv = nil :: any
	self.using = false
	-- soldaki teklifler
	for name, key in LEFT do
		local item = self.left:FindFirstChild(name)
		if item then
			local rays = item:FindFirstChild("Sunrays") :: ImageLabel?
			if rays and Assets.has(Assets.Shop.sunrays) then
				rays.Image = Assets.Shop.sunrays
			end
			local b = item:FindFirstChild("Button") :: ImageButton
			local img = b:FindFirstChild("Image") :: ImageLabel?
			if img and Assets.has((Assets.ShopImages :: any)[key]) then
				img.Image = (Assets.ShopImages :: any)[key]
			end
			local price = item:FindFirstChild("Price")
			local ic = price and price:FindFirstChild("Icon") :: ImageLabel?
			if ic and Assets.has(Assets.Shop.robux) then
				ic.Image = Assets.Shop.robux
			end
			b.Activated:Connect(function()
				self:_buy(key)
			end)
		end
	end
	local shopItem = self.left:FindFirstChild("Shop")
	if shopItem then
		local b = shopItem:FindFirstChild("Button") :: ImageButton
		local img = b:FindFirstChild("Image") :: ImageLabel?
		if img and Assets.has(Assets.Shop.soloShopButton) then
			img.Image = Assets.Shop.soloShopButton
		end
		b.Activated:Connect(function()
			self:_build()
			deps.open(card)
			if self.remote then
				self.remote:FireServer("shop", "open", "solo")
			end
		end)
	end
	;(card:WaitForChild("Close") :: TextButton).Activated:Connect(function()
		deps.close()
	end)
	-- fiyatlar (Roblox'tan)
	task.spawn(function()
		for name, key in LEFT do
			local id = productId(key)
			local item = self.left:FindFirstChild(name)
			local t = item and item:FindFirstChild("Price") and item.Price:FindFirstChild("Text") :: TextLabel?
			if id ~= 0 and t then
				local p = Crates.priceOf(id)
				if p then
					t.Text = tostring(p)
				end
			end
		end
	end)
	-- haklar (satın alınan ürünler) gelince maça uygulanır
	task.spawn(function()
		local remote = ReplicatedStorage:WaitForChild("FrontlineWallet", 60) :: RemoteEvent?
		local fn = ReplicatedStorage:WaitForChild("FrontlineWalletCall", 60) :: RemoteFunction?
		self.remote = remote
		self.fn = fn
		if remote then
			remote.OnClientEvent:Connect(function(what: any, data: any)
				if what == "inv" and type(data) == "table" then
					self.inv = data
					self:_use()
				end
			end)
		end
	end)
	-- görünürlük (yalnız solo maçta, menü kapalıyken) ve dönen ışınlar
	RunService.RenderStepped:Connect(function(dt: number)
		local show = self.active and not deps.online and not deps.menuOpen()
		if self.left.Visible ~= show then
			self.left.Visible = show
			if show then
				self:_refreshLeft()
			end
		end
		if show then
			self:_fit()
			for name in LEFT do
				local item = self.left:FindFirstChild(name)
				local rays = item and item:FindFirstChild("Sunrays") :: ImageLabel?
				if rays and item.Visible then
					rays.Rotation = (rays.Rotation + SPIN_DEG_PER_S * dt) % 360
				end
			end
		end
	end)
	return self
end

--- Sol sütunu Feedback ile "?" düğmeleri arasına sığdırır (değişmediyse dokunmaz).
function SoloShop._fit(self: any)
	local deps = self.deps
	local gui = self.gui
	local origin = gui.AbsolutePosition.Y
	local screenH = gui.AbsoluteSize.Y
	local fb = deps.topGuard :: GuiObject?
	local help = deps.bottomGuard :: GuiObject?
	local top = if fb and fb.Visible then fb.AbsolutePosition.Y + fb.AbsoluteSize.Y + MARGIN_PX else origin + screenH * 0.1
	local bottom = if help and help.Visible then help.AbsolutePosition.Y - MARGIN_PX else origin + screenH * 0.78
	-- (büyütülmüş görseller ve sunray'ler sütunun dışına taşar: taşma oranı saniyede bir ölçülür, yer ona göre ayrılır)
	local left0 = self.left
	local now = os.clock()
	if left0.AbsoluteSize.Y > 0 and now - (self.overAt or -1e9) > 1 then
		self.overAt = now
		local lo, hi = math.huge, -math.huge
		for _, d in left0:GetDescendants() do
			if d:IsA("GuiObject") and d.Visible and d.AbsoluteSize.Y > 0 then
				lo = math.min(lo, d.AbsolutePosition.Y)
				hi = math.max(hi, d.AbsolutePosition.Y + d.AbsoluteSize.Y)
			end
		end
		local h0 = left0.AbsoluteSize.Y
		if lo < math.huge then
			self.overTop = math.max(0, left0.AbsolutePosition.Y - lo) / h0
			self.overBot = math.max(0, hi - (left0.AbsolutePosition.Y + h0)) / h0
		end
	end
	local ot, ob = self.overTop or 0, self.overBot or 0
	local avail = math.max(0, bottom - top)
	local want = math.min(avail / (1 + ot + ob), screenH * MAX_SHARE)
	local y = math.floor(top + ot * want + (avail - want * (1 + ot + ob)) / 2 - origin + 0.5)
	local h = math.floor(want + 0.5)
	local left = self.left
	if left.Position.Y.Offset ~= y or left.Size.Y.Offset ~= h or left.Position.Y.Scale ~= 0 then
		left.AnchorPoint = Vector2.new(0, 0)
		left.Position = UDim2.new(left.Position.X.Scale, 0, 0, y)
		left.Size = UDim2.new(left.Size.X.Scale, 0, 0, h)
	end
end

--- Solo maç başladı / bitti (Client onPlay / onMenu).
function SoloShop.setActive(self: any, on: boolean)
	self.active = on and not self.deps.online
	if self.active then
		task.delay(1, function()
			self:_use()
		end)
	end
end

function SoloShop._boosts(self: any): any
	local lm = self.deps.localMatch
	return if lm and lm.boosts then lm.boosts(Players.LocalPlayer) else { troops = false, gold = false }
end

--- Soldaki x2 teklifleri: zaten etkinse gizli.
function SoloShop._refreshLeft(self: any)
	local b = self:_boosts()
	for name, key in LEFT do
		local item = self.left:FindFirstChild(name) :: GuiObject?
		if item then
			local on = if key == "solo_troops2x" then b.troops else b.gold
			item.Visible = not on and productId(key) ~= 0
		end
	end
end

function SoloShop._buy(self: any, key: string)
	local id = productId(key)
	if id == 0 then
		return
	end
	if self.remote then
		self.remote:FireServer("shop", "open", "solo")
		self.remote:FireServer("shop", "click", key)
	end
	MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
end

--- Bekleyen hakları solo maça uygular (hayattayken; x2 zaten etkinse o hak sonraki maça kalır).
function SoloShop._use(self: any)
	local lm = self.deps.localMatch
	local inv = self.inv
	if self.using or not self.active or inv == nil or self.fn == nil or lm == nil or lm.boost == nil then
		return
	end
	local lp = Players.LocalPlayer
	if not lm.canBoost(lp) then
		return
	end
	local credits = inv.credits or {}
	local b = self:_boosts()
	for _, it in SoloShop.ITEMS do
		local n = tonumber(credits[it.key]) or 0
		local blocked = (it.key == "solo_troops2x" and b.troops) or (it.key == "solo_gold2x" and b.gold)
		if n > 0 and not blocked then
			self.using = true
			local ok, spent = pcall(function()
				return self.fn:InvokeServer("useCredit", it.key)
			end)
			if ok and spent == true and lm.boost(lp, it.key) then
				Toast.show(it.title .. " activated!", true, Shop.rewardSound())
			end
			self.using = false
			self:_refreshLeft()
			if self.card.Visible then
				self:_build()
			end
			task.delay(1.1, function()
				self:_use() -- (saniyede 2 istek sınırı: kalanlar sırayla)
			end)
			return
		end
	end
end

--- Solo mağaza penceresinin kartları (yalnız Robux; x2 etkinse ACTIVE).
function SoloShop._build(self: any)
	local items = self.card:FindFirstChild("Items") :: ScrollingFrame
	local template = self.card:FindFirstChild("ItemTemplate") :: Frame
	for _, c in items:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local b = self:_boosts()
	for i, it in SoloShop.ITEMS do
		local id = productId(it.key)
		if id ~= 0 then
			local c = template:Clone()
			c.Name = it.key
			c.LayoutOrder = i
			c.Visible = true
			;(c:FindFirstChild("Image") :: ImageLabel).Image = (Assets.ShopImages :: any)[it.key] or ""
			;(c:FindFirstChild("Title") :: TextLabel).Text = it.title
			;(c:FindFirstChild("Sub") :: TextLabel).Text = it.sub
			;(c:FindFirstChild("Note") :: TextLabel).Text = "This match only"
			c.Parent = items
			local rb = c:FindFirstChild("BuyRobux") :: TextButton
			local mb = c:FindFirstChild("BuyMedals") :: TextButton
			mb.Visible = false
			local right = mb.Position.X.Scale + mb.Size.X.Scale
			rb.Size = UDim2.new(right - rb.Position.X.Scale, 0, rb.Size.Y.Scale, rb.Size.Y.Offset)
			local active = (it.key == "solo_troops2x" and b.troops) or (it.key == "solo_gold2x" and b.gold)
			local owned = c:FindFirstChild("Owned") :: TextLabel
			owned.Text = "ACTIVE"
			owned.Visible = active
			rb.Visible = not active
			if not active then
				ButtonDepth.add(rb)
				Shop.setButton(rb, "…", Assets.Shop.robux)
				task.spawn(function()
					local p = Crates.priceOf(id)
					if p and rb.Parent then
						Shop.setButton(rb, tostring(p), Assets.Shop.robux)
					end
				end)
				rb.Activated:Connect(function()
					self:_buy(it.key)
				end)
			end
		end
	end
	items.CanvasPosition = Vector2.zero
end

return SoloShop
