					<ProtectedString name="Source"><![CDATA[--!strict
-- PlayerColors: oyuncu kimliğinden (pid) ve türünden renk. Tür: 0 insan, 1 ulus, 2 bot.
-- Renkler OpenFront varsayılan temasındaki paletlerden gelir (insan: canlı, ulus: yumuşak, bot: gri tonlar).
-- Tür bilgisi istemciye sunucudan gelir (setKind); bilinmeyen oyuncu insan sayılır.
-- Takım maçında (setTeam) takımdaki herkes takımın ana renginin bir tonunu alır (Core/Teams.BASE).

local Teams = require(script.Parent:WaitForChild("Core"):WaitForChild("Teams"))

-- Palet verisi: OpenFront varsayılan teması (src/client/render/gl/default-theme.json), sayısal veri.
local Palettes = {
	human = { "#a3e635", "#84cc16", "#10b981", "#34d399", "#2dd4bf", "#4ade80", "#6ee7b7", "#86efac", "#97ffbb", "#baffc9", "#e6fad2", "#22c55e", "#43be54", "#52b788", "#30b2b4", "#e6fffa", "#dcf0fa", "#e9d5ff", "#ccccff", "#dcdcff", "#cae1ff", "#93c5fd", "#7dd3fc", "#63cafd", "#38bdf8", "#60a5fa", "#3b82f6", "#4f46e5", "#7c3aed", "#9333ea", "#b388ff", "#a78bfa", "#d946ef", "#a855f7", "#be5cfb", "#c084fc", "#f0abfc", "#f472b6", "#ec4899", "#dc2626", "#ef4444", "#eb4b4b", "#f56565", "#f87171", "#fb7185", "#fda4af", "#fca5a5", "#ffcce5", "#fad7e1", "#fbebf5", "#f0f0c8", "#fafad2", "#fff0c8", "#ffdfba", "#fcd34d", "#fbbf24", "#eab308", "#ca8a04", "#f59e0b", "#fb923c", "#f97316", "#ea580c", "#854d0e" },
	nation = { "#719bfa", "#51c9ad", "#f46a86", "#20a18f", "#b682ed", "#68b9fa", "#f2bb31", "#bc4b87", "#fb8e7d", "#2193e0", "#cb454f", "#847ce2", "#25b5ae", "#ef6a9a", "#659e41", "#40cd9b", "#dcc536", "#c54476", "#2fa465", "#c94363", "#40c5d9", "#e670ac", "#3596c8", "#e0d64c", "#e28420", "#fbaf94", "#e38be8", "#4ba3f7", "#f66d67", "#8362cd", "#b668c8", "#59e0ad", "#b14f9f", "#337bd0", "#a2a8fb", "#cb4a2a", "#fb8a9d", "#77b154", "#219ea5", "#e2a527", "#fcc586", "#40c8c1", "#c562b2", "#c1cf5c", "#6985e7", "#dd577e", "#c37de2", "#5ccb89", "#915dc5", "#fb942c", "#bf9cfb", "#1880c6", "#ef773b", "#ee87d9", "#85b2fb", "#6b6cd0", "#7fc76f", "#aa6cd4", "#ee9d26", "#28b989", "#fcc86b", "#7cdd93", "#9e8af9", "#42abd8", "#3ab59a", "#9575e2", "#9cd879", "#fcb542", "#e05d3d", "#cf93fb", "#538ae6", "#a355b4", "#ceaf24", "#f57050", "#22a479", "#fb83bf", "#f8cc43", "#8495fa", "#d974c5", "#54b66e", "#58beec", "#5872d2", "#e05860", "#25b1c5", "#d15d9a", "#219bba", "#fcb274" }, -- ulus: RoWorld src/shared/Data/Nations.luau (AGPL-3.0, © 2026 Snick Co.)
	bot = { "#96a08c", "#a0a096", "#aaaa8c", "#aaaa78", "#96a078", "#96aa82", "#96aa96", "#82aa82", "#8ca08c", "#789664", "#788c78", "#64aa82", "#78a096", "#82a096", "#78aaaa", "#78a0be", "#8296aa", "#8296a0", "#8c96a0", "#8ca0aa", "#96a0a0", "#6478a0", "#78828c", "#8282a0", "#8c828c", "#8c78a0", "#968296", "#968ca0", "#a082a0", "#aa96aa", "#a078be", "#a07882", "#aa788c", "#aa8278", "#aa8282", "#b48c8c", "#be82a0", "#be7878", "#be8c78", "#bea064", "#aa8c64", "#a08c82", "#aa9682", "#a09678", "#a0968c", "#a08c96", "#a096a0", "#968c96", "#b4a0a0" },
}

-- Ulus renkleri ADINA göre (her haritada, her turda ve menü arka planında aynı): RoWorld src/shared/Data/Nations.luau'daki
