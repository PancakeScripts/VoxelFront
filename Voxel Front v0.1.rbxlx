					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Sound: ses efektleri. Kimlikler ReplicatedStorage > Shared > Assets içindeki Assets.Sounds'ta; boş olan çalmaz.
-- Her ses SoundService altında bir kez kurulur; çalarken kopyalanır (üst üste binebilir), bitince silinir.
-- Assets.SoundCooldown: aynı sesin en sık çalma aralığı.
-- Sound.pop: toprak büyürken "expand" sesi RoWorld'deki ritimle (AudioDirector.pop, AGPL-3.0, © 2026 Snick Co.): ses
-- sayısı kazanılan toprağın hızına göre saniyede 2'den 20'ye çıkar; uzun büyümede perde yavaşça yükselir, kazanmaya
-- yaklaştıkça biraz daha; büyük lokmada daha yüksek ses. "conquered" (fetih) çalarken 0.65 sn pop susar.
-- Sound.playOr: uzun ses bekleme süresindeyse yerine kısa onay sesi (RoWorld order_ack).
-- Düğmeler: tık sesi "click"; düğmenin "ClickSound" özniteliği başka bir anahtar verir ("" = sessiz; o anahtarın kimliği
-- Assets.Sounds'ta boşsa yerine "click" çalar). Fareyle üstüne gelince "hover".

local SoundService = game:GetService("SoundService")
local Assets = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Assets"))

local Sound = {}
Sound.enabled = true

local folder: Folder? = nil
local base: { [string]: Sound } = {}
local last: { [string]: number } = {}
local live = 0
local MAX_LIVE = 24

local function getBase(key: string): Sound?
	local id = (Assets.Sounds :: any)[key]
	if not Assets.has(id) then
		return nil
	end
	local s = base[key]
	if s then
		return s
	end
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "FrontlineSounds"
		f.Parent = SoundService
		folder = f
	end
	local snd = Instance.new("Sound")
	snd.Name = key
	snd.SoundId = id
	snd.Volume = (Assets.SoundVolume :: any)[key] or Assets.SoundVolume.default
	snd.Parent = folder
	base[key] = snd
	return snd
end

-- ses çalarken toprak büyüme sesleri bu kadar susar (RoWorld HUSH_POPS)
local HUSH: { [string]: number } = { conquered = 0.65 }
local hushUntil = -1e9

-- Sesi çalar (ayarlardan kapalıysa, kimlik boşsa ya da bekleme süresi dolmadıysa çalmaz). Çaldıysa true.
-- pitch (isteğe bağlı): çalma hızı (1 = normal).
function Sound.play(key: string, volumeScale: number?, pitch: number?): boolean
	if not Sound.enabled then
		return false
	end
	local now = os.clock()
	local cd = (Assets.SoundCooldown :: any)[key] or Assets.SoundCooldown.default
	if now - (last[key] or -100) < cd then
		return false
	end
	local b = getBase(key)
	if not b or live >= MAX_LIVE then
		return false
	end
	last[key] = now
	local s = b:Clone()
	if volumeScale then
		s.Volume = b.Volume * volumeScale
	end
	if pitch then
		s.PlaybackSpeed = math.clamp(pitch, 0.25, 4)
	end
	s.Parent = b.Parent
	live += 1
	s.Ended:Once(function()
		live -= 1
		s:Destroy()
	end)
	s:Play()
	task.delay(10, function()
		if s.Parent then
			live -= 1
			s:Destroy()
		end
	end)
	local h = HUSH[key]
	if h then
		hushUntil = math.max(hushUntil, now + h)
	end
	return true
end

-- Uzun ses (ör. saldırı) bekleme süresindeyse yerine kısa onay sesi çalar (RoWorld COOLDOWNS -> order_ack).
function Sound.playOr(key: string, fallback: string)
	if Sound.enabled and not Sound.play(key) then
		Sound.play(fallback)
	end
end

-- Toprak büyüme sesi (RoWorld AudioDirector.pop; değerler aynı). Hız: saniyede kazanılan tile.
local POP_SLOW, POP_FAST = 40, 600
local POP_RATE_MIN, POP_RATE_MAX, POP_CURVE = 2, 20, 2
local POP_SMOOTH_S = 0.45
local POP_PER_BATCH, POP_SECOND_S = 2, 0.05
local POP_PITCH_MIN, POP_PITCH_MAX = 0.8, 1.1
local POP_WARM_S, POP_COOL_S, POP_RUN_GAP_S = 15, 6, 0.7
local POP_JITTER = 0.012
local POP_PROGRESS_LIFT = 0.05
local POP_DB_MIN, POP_DB_MAX, POP_BIG = -9, -3, 60

local popDebt, popSpeed, popLast, popRunLast, popHeat = 0, 0, -1e9, -1e9, 0

local function popRate(speed: number): number
	if speed <= POP_SLOW then
		return POP_RATE_MIN * math.max(speed, 0) / POP_SLOW
	end
	local k = math.min(math.log(speed / POP_SLOW) / math.log(POP_FAST / POP_SLOW), 1)
	return POP_RATE_MIN + (POP_RATE_MAX - POP_RATE_MIN) * k ^ POP_CURVE
end

-- Oyuncunun toprağı bu toplu güncellemede `tiles` büyüdü (yaklaşık 10 kez / sn çağrılır); progress 0..1 kazanmaya yakınlık.
function Sound.pop(tiles: number, progress: number?)
	if tiles <= 0 or not Sound.enabled or not Assets.has((Assets.Sounds :: any).expand) then
		return
	end
	local now = os.clock()
	local dt = math.clamp(now - popLast, 0.1, 3)
	popLast = now
	popSpeed += (tiles / dt - popSpeed) * (1 - math.exp(-dt / POP_SMOOTH_S))
	local speed = popSpeed
	-- ses başına toprak: yavaşta sabit, üstünde hız / oran
	local per = if speed <= POP_SLOW then POP_SLOW / POP_RATE_MIN else speed / popRate(speed)
	popDebt = math.min(popDebt + tiles, math.max(POP_BIG, per * 2))
	if popDebt < per then
		return
	end
	local n = math.min(math.floor(popDebt / per), POP_PER_BATCH)
	local bite = popDebt
	popDebt = math.min(popDebt - n * per, per)
	-- art arda büyüdükçe ısınır (perde yükselir), sessizlikte soğur
	local quiet = now - popRunLast
	popRunLast = now
	if quiet <= POP_RUN_GAP_S then
		popHeat = math.min(1, popHeat + quiet / POP_WARM_S)
	else
		popHeat = math.max(0, popHeat - (quiet - POP_RUN_GAP_S) / POP_COOL_S)
	end
	local lift = 1 + POP_PROGRESS_LIFT * math.clamp(progress or 0, 0, 1)
	local pitch = (POP_PITCH_MIN + (POP_PITCH_MAX - POP_PITCH_MIN) * popHeat) * lift
	local db = POP_DB_MIN + (POP_DB_MAX - POP_DB_MIN) * math.sqrt(math.clamp(bite / POP_BIG, 0, 1))
	local scale = 10 ^ ((db - POP_DB_MAX) / 20) -- (en büyük lokma = Assets.SoundVolume.expand)
	local function strike()
		if os.clock() < hushUntil then
			return
		end
		Sound.play("expand", scale, pitch * (1 + (math.random() * 2 - 1) * POP_JITTER))
	end
	strike()
	if n >= 2 then
		task.delay(POP_SECOND_S, strike)
	end
end

-- Bir arayüzdeki (ve sonradan eklenen) tüm düğmelere tık ve üstüne gelme sesi bağlar.
function Sound.bindClicks(root: Instance)
	local function hook(d: Instance)
		if d:IsA("GuiButton") and not d:GetAttribute("NoClickSound") then
			d.Activated:Connect(function()
				local k = d:GetAttribute("ClickSound")
				if k == nil then
					Sound.play("click")
				elseif type(k) == "string" and k ~= "" then
					-- (open / confirm / close / tab boşsa düğme yine de "click" sesini çalar)
					Sound.play(if Assets.has((Assets.Sounds :: any)[k]) then k else "click")
				end
			end)
			d.MouseEnter:Connect(function()
				Sound.play("hover")
			end)
		end
	end
	for _, d in root:GetDescendants() do
		hook(d)
	end
	root.DescendantAdded:Connect(hook)
end

return Sound
]]></ProtectedString>
