					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- OpenFront PlayerExecution.removeClusters kurallarının Luau uyarlaması.
-- Kaynak: be6ce241b3c589f8b25b862ed44b0064a17bed7b (AGPL-3.0, CREDITS.md).
-- Sınır kümeleri 8, gerçek toprak bağlantısı 4 komşuludur. Krater bir çıkış
-- değildir; deniz/açık araziye ulaşabilen veya müttefikçe çevrili alan alınmaz.
local Territory = {}
Territory.__index = Territory

function Territory.new(world: any): any
	return setmetatable({ world = world, seen = buffer.create(world.size * 4), gen = 0,
		stack = {}, nb = {}, nb8 = {}, last = {}, versions = {}, pid = 0, sim = nil }, Territory)
end

function Territory.bump(self: any, count: number?): number
	local n = count or 1
	if self.gen + n >= 0xFFFFFFFF then
		buffer.fill(self.seen, 0, 0)
		self.gen = 0
	end
	local first = self.gen + 1
	self.gen += n
	return first
end

local function mark(self: any, t: number, gen: number)
	buffer.writeu32(self.seen, t * 4, gen)
end
local function stamp(self: any, t: number): number
	return buffer.readu32(self.seen, t * 4)
end
local function edge(w: any, t: number): boolean
	return t < w.width or t >= w.size - w.width or t % w.width == 0 or t % w.width == w.width - 1
end
local function shore(self: any, t: number): boolean
	local w = self.world
	local n = w:neighbors(t, self.nb)
	for i = 1, n do if not w:isLand(self.nb[i]) then return true end end
	return false
end
local function neighbors8(w: any, t: number, out: any): number
	local n, width, x = 0, w.width, t % w.width
	local north, south = t >= width, t < w.size - width
	if x > 0 then
		if north then n += 1; out[n] = t - width - 1 end
		n += 1; out[n] = t - 1
		if south then n += 1; out[n] = t + width - 1 end
	end
	if north then n += 1; out[n] = t - width end
	if south then n += 1; out[n] = t + width end
	if x < width - 1 then
		if north then n += 1; out[n] = t - width + 1 end
		n += 1; out[n] = t + 1
		if south then n += 1; out[n] = t + width + 1 end
	end
	return n
end
local function boxOf(w: any, tiles: any): any
	local b = { w.width, w.height, -1, -1 }
	for _, t in tiles do
		local x, y = t % w.width, t // w.width
		b[1], b[2], b[3], b[4] = math.min(b[1], x), math.min(b[2], y), math.max(b[3], x), math.max(b[4], y)
	end
	return b
end
local function contains(a: any, b: any): boolean
	return a[1] <= b[1] and a[2] <= b[2] and a[3] >= b[3] and a[4] >= b[4]
end

-- DFS sonucu repodaki gibi keşif sırasındadır (yığından çıkma sırası değil).
function Territory.fill(self: any, starts: any, diag: boolean, include: any, gen: number?): any
	local g = gen or self:bump()
	local result, stack = {}, self.stack
	table.clear(stack)
	for _, t in starts do
		if stamp(self, t) ~= g and include(t) then
			mark(self, t, g); result[#result + 1] = t; stack[#stack + 1] = t
		end
	end
	local w, nb = self.world, if diag then self.nb8 else self.nb
	while #stack > 0 do
		local t = table.remove(stack)
		local n = if diag then neighbors8(w, t, nb) else w:neighbors(t, nb)
		for i = 1, n do
			local u = nb[i]
			if stamp(self, u) ~= g and include(u) then
				mark(self, u, g); result[#result + 1] = u; stack[#stack + 1] = u
			end
		end
	end
	return result
end

function Territory.clusters(self: any): (any, any)
	local border = self.world:orderedBorderOf(self.pid)
	local member = self:bump(2)
	for _, t in border do if t ~= -1 then mark(self, t, member) end end
	local clusters, boxes = {}, {}
	for _, t in border do
		if t ~= -1 and stamp(self, t) ~= member + 1 then
			local c = self:fill({t}, true, function(u: number) return stamp(self, u) == member end, member + 1)
			clusters[#clusters + 1] = c
			boxes[#boxes + 1] = boxOf(self.world, c)
		end
	end
	return clusters, boxes
end


function Territory.captor(self: any, tiles: any): number?
	local counts, order = {}, {}
	local w, sim, pid = self.world, self.sim, self.pid
	for _, t in tiles do
		local n = w:neighbors(t, self.nb)
		for i = 1, n do
			local p = w:ownerAt(self.nb[i])
			if p ~= 0 and p ~= pid and not sim.parts.Diplomacy.isAllied(sim, p, pid) then
				if not counts[p] then counts[p] = 0; order[#order + 1] = p end
				counts[p] += 1
			end
		end
	end
	local best, troops = nil, 0
	for _, p in order do
		for i = 1, sim.executionCount do
			local e = sim.executions[i]
			if e and e.kind == 'attack' and not e.done and e.pid == p and e.target == pid and e.troops > troops then
				best, troops = p, e.troops
			end
		end
	end
	if best then return best end
	local most = 0
	for _, p in order do if counts[p] > most then best, most = p, counts[p] end end
	return best
end


function Territory.annex(self: any, tiles: any, capturing: number)
	local w, sim, pid = self.world, self.sim, self.pid
	if w:tilesOwnedBy(pid) == #tiles then sim.parts.Attack.conquerPlayer(sim, capturing, pid, tiles[1]) end
	for _, t in tiles do w:setOwner(t, capturing) end
	sim:checkEliminated(pid)
end

-- Current upstream classification: clean neutral land is an escape; fallout is a wall.
function Territory.classify(self: any, cluster: any, box: any, same: boolean?): number
 local w,pid=self.world,self.pid
 local enemy,open,only=false,false,0
 local eb={math.huge,math.huge,-1,-1}
 for _,t in cluster do
  if edge(w,t) or shore(self,t) then return 0 end
  local n=w:neighbors(t,self.nb)
  for i=1,n do
   local u=self.nb[i];local p=w:ownerAt(u)
   if same and p==0 then return 0 end
   if p~=0 and p~=pid then
    if same and only~=0 and only~=p then return 0 end
    only=p;enemy=true
   elseif p==0 and not w:hasFallout(u) then open=true end
   if (p~=0 and p~=pid) or (not same and p==0 and w:hasFallout(u)) then
    local x,y=u%w.width,u//w.width
    eb[1],eb[2],eb[3],eb[4]=math.min(eb[1],x),math.min(eb[2],y),math.max(eb[3],x),math.max(eb[4],y)
   end
  end
 end
 if not enemy or open or not contains(eb,box) then return 0 end
 return if same then only else 1
end

function Territory.pinched(self: any, cluster: any): boolean
 local w,pid=self.world,self.pid
 for _,t in cluster do
  if w:ownerAt(t)~=pid or t>=w.size-w.width or w:ownerAt(t+w.width)==pid then continue end
  local x,below=t%w.width,t+w.width
  if (x<w.width-1 and w:ownerAt(below+1)==pid and w:ownerAt(t+1)~=pid)
   or (x>0 and w:ownerAt(below-1)==pid and w:ownerAt(t-1)~=pid) then return true end
 end
 return false
end

function Territory.enclosed(self: any, start: number, box: any): boolean
 local w,pid,gen,stack=self.world,self.pid,self:bump(),self.stack
 table.clear(stack);stack[1]=start;mark(self,start,gen)
 while #stack>0 do
  local t=table.remove(stack);local x,y=t%w.width,t//w.width
  if x<box[1]-1 or y<box[2]-1 or x>box[3]+1 or y>box[4]+1 or edge(w,t) then return false end
  local n=w:neighbors(t,self.nb)
  for i=1,n do
   local u=self.nb[i]
   if stamp(self,u)==gen then continue end
   local p=w:ownerAt(u)
   if p==pid then mark(self,u,gen);stack[#stack+1]=u
   elseif p==0 and (not w:isLand(u) or not w:hasFallout(u)) then return false end
  end
 end
 return true
end

function Territory.reject(self: any, start: number, gen: number, box: any)
 local w,pid,stack=self.world,self.pid,self.stack
 table.clear(stack);stack[1]=start;mark(self,start,gen)
 while #stack>0 do
  local t=table.remove(stack);local n=w:neighbors(t,self.nb)
  for i=1,n do
   local u=self.nb[i]
   if stamp(self,u)==gen or w:ownerAt(u)~=pid then continue end
   local x,y=u%w.width,u//w.width
   if x>=box[1]-1 and y>=box[2]-1 and x<=box[3]+1 and y<=box[4]+1 then
    mark(self,u,gen);stack[#stack+1]=u
   end
  end
 end
end

function Territory.removeCluster(self: any, cluster: any, box: any, known: number?, pinch: boolean): boolean
 local w,pid=self.world,self.pid
 if #cluster==0 then return false end
 for _,t in cluster do if w:ownerAt(t)~=pid then return false end end
 if not pinch then
  local capturing=known or self:captor(cluster)
  if not capturing or not self:enclosed(cluster[1],box) then return false end
  self:annex(self:fill({cluster[1]},false,function(t) return w:ownerAt(t)==pid end),capturing)
  return true
 end
 local gen=self:bump();local removed=false
 for _,t in cluster do
  if w:tilesOwnedBy(pid)==0 then break end
  if stamp(self,t)==gen or w:ownerAt(t)~=pid then continue end
  if not self:enclosed(t,box) then self:reject(t,gen,box);continue end
  local tiles=self:fill({t},false,function(u) return w:ownerAt(u)==pid end,gen)
  if #tiles>0 then
   local capturing=known or self:captor(tiles)
   if capturing then self:annex(tiles,capturing);removed=true end
  end
 end
 return removed
end

-- Typed hot loop keeps full-area ranking inexpensive on large maps.
local function measureArea(owner: buffer, seen: buffer, width: number, total: number,
 pid: number, base: number, gen: number, start: number, stack: {number}): number
 -- Scanline flood: same 4-way component, a stack entry per horizontal run.
 table.clear(stack);stack[1]=start
 local top,count=1,0
 while top>0 do
  local t=stack[top];stack[top]=nil;top-=1
  if buffer.readu32(seen,t*4)>=base then continue end
  local row=t-t%width;local left,right=t,t
  while left>row and buffer.readu32(seen,(left-1)*4)<base and buffer.readu16(owner,(left-1)*2)==pid do left-=1 end
  while right<row+width-1 and buffer.readu32(seen,(right+1)*4)<base and buffer.readu16(owner,(right+1)*2)==pid do right+=1 end
  for u=left,right do buffer.writeu32(seen,u*4,gen) end
  count+=right-left+1
  local above,below=false,false
  for u=left,right do
   if row>=width then
    local v=u-width
    local eligible=buffer.readu32(seen,v*4)<base and buffer.readu16(owner,v*2)==pid
    if eligible and not above then top+=1;stack[top]=v end
    above=eligible
   end
   if row<total-width then
    local v=u+width
    local eligible=buffer.readu32(seen,v*4)<base and buffer.readu16(owner,v*2)==pid
    if eligible and not below then top+=1;stack[top]=v end
    below=eligible
   end
  end
 end
 return count
end

-- Memoized four-neighbor areas: rank actual territory, not its border length.
function Territory.measure(self: any, clusters: any): (any, any, any, number)
 local w,pid=self.world,self.pid
 local base=self:bump(#clusters*4+16)
 local areas,ids,sizes={}, {}, {};local nextId,maximum=1,0
 local stack=self.stack
 for i,c in clusters do
  local tileIds={};ids[i]=tileIds;local biggest=0
  for j,t in c do
   if stamp(self,t)>=base then
    local id=stamp(self,t)-base+1;tileIds[j]=id;biggest=math.max(biggest,areas[id]);continue
   end
   if w:ownerAt(t)~=pid then continue end
   local id=nextId;nextId+=1;tileIds[j]=id
   local gen=base+id-1
   if self.gen<gen then self:bump(gen-self.gen) end
   local size=measureArea(w.owner,self.seen,w.width,w.size,pid,base,gen,t,stack)
   areas[id]=size;biggest=math.max(biggest,size)
  end
  sizes[i]=biggest;maximum=math.max(maximum,biggest)
 end
 return areas,ids,sizes,maximum
end

function Territory.evaluatePinch(self: any, cluster: any, maximum: number, ids: any, areas: any)
 local w,pid=self.world,self.pid;local gen=self:bump()
 for j,start in cluster do
  if w:tilesOwnedBy(pid)==0 then break end
  local id=ids[j]
  if id and areas[id]>=maximum then continue end
  if w:ownerAt(start)~=pid or stamp(self,start)>=gen then continue end
  local tiles=self:fill({start},false,function(t) return w:ownerAt(t)==pid end,gen)
  if #tiles>=maximum then continue end
  local fallout=false
  for _,t in tiles do
   local n=w:neighbors(t,self.nb)
   for k=1,n do if w:hasFallout(self.nb[k]) then fallout=true;break end end
   if fallout then break end
  end
  if not fallout or not self:enclosed(start,boxOf(w,tiles)) then continue end
  local capturing=self:captor(tiles)
  if capturing then self:annex(tiles,capturing) end
 end
end

-- Eight-way scanline labelling for interior-rim checks; no full tile-result allocation.
local function labelConnected8(owner: buffer, seen: buffer, width: number, total: number,
 pid: number, gen: number, start: number, stack: {number}, clusterIndex: any, ids: any, id: number)
 table.clear(stack);stack[1]=start;local top=1
 while top>0 do
  local t=stack[top];stack[top]=nil;top-=1
  if buffer.readu32(seen,t*4)==gen then continue end
  local row=t-t%width;local left,right=t,t
  while left>row and buffer.readu32(seen,(left-1)*4)~=gen and buffer.readu16(owner,(left-1)*2)==pid do left-=1 end
  while right<row+width-1 and buffer.readu32(seen,(right+1)*4)~=gen and buffer.readu16(owner,(right+1)*2)==pid do right+=1 end
  for u=left,right do
   buffer.writeu32(seen,u*4,gen)
   local c=clusterIndex[u];if c then ids[c]=id end
  end
  local above,below=false,false
  for u=math.max(row,left-1),math.min(row+width-1,right+1) do
   if row>=width then
    local v=u-width
    local eligible=buffer.readu32(seen,v*4)~=gen and buffer.readu16(owner,v*2)==pid
    if eligible and not above then top+=1;stack[top]=v end
    above=eligible
   end
   if row<total-width then
    local v=u+width
    local eligible=buffer.readu32(seen,v*4)~=gen and buffer.readu16(owner,v*2)==pid
    if eligible and not below then top+=1;stack[top]=v end
    below=eligible
   end
  end
 end
end

function Territory.check(self: any, sim: any, pid: number)
 self.sim,self.pid=sim,pid
 local clusters,boxes=self:clusters()
 if #clusters==0 then return end
 local pinches={}
 for i,c in clusters do pinches[i]=self:pinched(c) end
 if #clusters==1 then
  local surrounding=self:classify(clusters[1],boxes[1],true)
  local removed=false
  if surrounding~=0 and not sim.parts.Diplomacy.isAllied(sim,surrounding,pid) then
   removed=self:removeCluster(clusters[1],boxes[1],surrounding,pinches[1])
  end
  if not removed and pinches[1] then
   local areas,ids,_,maximum=self:measure(clusters)
   self:evaluatePinch(clusters[1],maximum,ids[1],areas)
  end
  return
 end
 local areas,ids,sizes,maximum=self:measure(clusters)
 local largest=1
 local function boxArea(b) return (b[3]-b[1]+1)*(b[4]-b[2]+1) end
 for i=2,#clusters do
  if sizes[i]>sizes[largest] or (sizes[i]==sizes[largest] and
   (boxArea(boxes[i])>boxArea(boxes[largest]) or (boxArea(boxes[i])==boxArea(boxes[largest]) and #clusters[i]>#clusters[largest]))) then largest=i end
 end
 local classes,removed={},{}
 for i,c in clusters do if i~=largest then classes[i]=self:classify(c,boxes[i]) end end
 local surrounding=self:classify(clusters[largest],boxes[largest],true)
 if surrounding~=0 and not sim.parts.Diplomacy.isAllied(sim,surrounding,pid) then
  removed[largest]=self:removeCluster(clusters[largest],boxes[largest],surrounding,pinches[largest])
 end
 for i,c in clusters do
  if self.world:tilesOwnedBy(pid)==0 then break end
  if classes[i]==1 then removed[i]=self:removeCluster(c,boxes[i],nil,pinches[i]) end
 end
 -- Inner crater/enclave rims must not annex their enclosing continent.
 local territoryIds,clusterIndex,nextId={},nil,0
 local function sameTerritory(a,b)
  -- Whole-component annexation cannot split a surviving measured component.
  -- A shared 4-way component therefore proves 8-way connectivity without rescanning it.
  if self.world:ownerAt(clusters[a][1])==pid and self.world:ownerAt(clusters[b][1])==pid
   and ids[a][1]~=nil and ids[a][1]==ids[b][1] then return true end
  if territoryIds[a] and territoryIds[b] then return territoryIds[a]==territoryIds[b] end
  if not clusterIndex then
   clusterIndex={};for i,c in clusters do for _,t in c do clusterIndex[t]=i end end
  end
  local start=if not territoryIds[b] then b else a
  if self.world:ownerAt(clusters[start][1])~=pid then return false end
  nextId+=1;territoryIds[start]=nextId
  local w=self.world
  labelConnected8(w.owner,self.seen,w.width,w.size,pid,self:bump(),clusters[start][1],self.stack,clusterIndex,territoryIds,nextId)
  return territoryIds[a]~=nil and territoryIds[a]==territoryIds[b]
 end
 for i,c in clusters do
  if self.world:tilesOwnedBy(pid)==0 then break end
  if removed[i] or not pinches[i] then continue end
  local hole=false
  for j=1,#clusters do if i~=j and contains(boxes[j],boxes[i]) and sameTerritory(i,j) then hole=true;break end end
  if not hole then self:evaluatePinch(c,maximum,ids[i],areas) end
 end
end

function Territory.step(self: any, sim: any)
	for pid = 1, sim.playerCount do
		if not sim.alive[pid] or not sim.spawned[pid] then continue end
		local last = self.last[pid]
		if not last then last = sim.tickNo + pid % 20; self.last[pid] = last end
		if sim.tickNo - last <= 20 and self.world:tilesOwnedBy(pid) >= 100 then continue end
		local version = self.world.territoryVersion[pid] or 0
		if self.versions[pid] == version then continue end
		self.last[pid], self.versions[pid] = sim.tickNo, version
		self:check(sim, pid)
	end
end

function Territory.reset(self: any)
	table.clear(self.last); table.clear(self.versions)
end

return Territory
]]></ProtectedString>
