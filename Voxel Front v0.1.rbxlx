			<Item class="ModuleScript" referent="RBXA4312B4596AA4A1A8CE7824D03E8E20B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Assets: oyundaki TÜM görseller tek yerde. Kendi görselini kullanmak için ilgili satıra
--   "rbxassetid://1234567890"
-- yaz. Boş ("") bırakılan her şey için oyun kendi çizdiği yedek şekli (renkli daire/kare, harf ya da emoji) kullanır,
-- yani hiçbirini doldurmak zorunda değilsin. Görseller beyaz/açık renkli ve şeffaf arka planlı olursa en iyi görünür
-- (yapı ve gemi görselleri sahibinin rengiyle boyanır: Tint = true).
--
-- Not: Roblox'ta yüklediğin görselin "Image" kimliğini kullan (Decal kimliği değil). Studio > Asset Manager > Images'tan
-- sağ tık > "Copy Asset ID".

local Assets = {}

-- Haritadaki yapı simgeleri (sahibinin renginde gösterilir)
Assets.Structures = {
	city = "rbxassetid://122422117124232",
	factory = "rbxassetid://130222461074208",
	port = "rbxassetid://119614266384716",
	post = "rbxassetid://73117108687615", -- savunma kulesi
	silo = "rbxassetid://120575600909220",
	sam = "rbxassetid://119634867469914",
}

-- Birimler
Assets.Units = {
	transport = "rbxassetid://104931822240911", -- nakliye gemisi (asker taşıyan)
	warship = "rbxassetid://104931822240911", -- savaş gemisi
	trade = "", -- ticaret gemisi
	trainEngine = "", -- tren lokomotifi
	trainCar = "", -- tren vagonu
	atom = "", -- atom bombası haritada uçarken (boş: renk değiştiren efektli nokta; alt bar görseli Assets.BuildBar'da)
	hydro = "", -- hidrojen bombası haritada uçarken (boş: efektli nokta)
	mirv = "", -- MIRV haritada uçarken (boş: efektli nokta)
	warhead = "", -- MIRV savaş başlığı
	shell = "", -- savaş gemisi mermisi
	samMissile = "", -- SAM füzesi
}

-- Alt bardaki (BUILD) düğmelerin görselleri: yalnız orada kullanılır. Boş bırakılan yapı / savaş gemisi düğmesi
-- Assets.Structures / Assets.Units.warship görselini kullanır; bombaların haritada uçarkenki görseli Assets.Units'te ayrıdır.
Assets.BuildBar = {
	city = "",
	factory = "",
	port = "",
	post = "",
	silo = "",
	sam = "",
	warship = "",
	atom = "rbxassetid://78102265986352", -- atom bombası düğmesi
	hydro = "rbxassetid://96741621637023", -- hidrojen bombası düğmesi
	mirv = "rbxassetid://123017207644725", -- MIRV düğmesi
}

-- Kurma modunda fare imleci (boşsa normal imleç + haritada yarı saydam önizleme)
Assets.Cursors = {
	city = "",
	factory = "",
	port = "",
	post = "",
	silo = "",
	sam = "",
	warship = "",
	atom = "",
	hydro = "",
	mirv = "",
}

-- Sağ tık (mobilde dokunma) menüsü simgeleri
Assets.Radial = {
	info = "",
	attack = "", -- kılıç
	boat = "",
	ally = "", -- el sıkışma
	breakAlly = "", -- hain / ittifakı boz
	build = "",
	delete = "",
	donateGold = "",
	donateTroops = "rbxassetid://99541904091864",
	back = "",
	close = "",
	segment = "", -- (isteğe bağlı) dilim arka planı; boşsa yuvarlak düğmeler
}

-- Efektler
Assets.Fx = {
	conquest = "", -- fetihte çıkan çapraz kılıçlar
	explosion = "", -- nükleer patlama parlaması
	samExplosion = "", -- SAM önleme patlaması
}

-- Küçük simgeler (HUD ve isim üstü)
Assets.Icons = {
	gold = "rbxassetid://124499641793376",
	troops = "rbxassetid://99541904091864",
	crown = "rbxassetid://139619317252927",
	alliance = "",
	embargo = "",
	traitor = "",
	request = "",
	buildConfirm = "rbxassetid://99632269971204", -- mobil kurma onayı penceresi: onay düğmesi (boşsa "OK" yazısı)
	buildCancel = "rbxassetid://96635819509039", -- mobil kurma onayı penceresi: iptal düğmesi (boşsa "X" yazısı)
	topExit = "rbxassetid://96344264753579", -- üst bardaki çıkış düğmesi: basınca oyun durur, "GAME PAUSED" penceresi açılır (boşsa 🚪)
	settings = "", -- oyunda alt barın solundaki ayarlar düğmesi (boşsa ⚙)
	help = "", -- oyunda ayarlar düğmesinin üstündeki nasıl oynanır düğmesi (boşsa ?)
	creditsLogo = "rbxassetid://125090887717033", -- How to Play > Credits altındaki "Source" satırında depo adının solundaki logo (boşsa logo yok)
}

-- Panel gölgesi (9-slice, tools/make_shadow.py): 20 px yuvarlak köşeli koyu kutu, kenardan 32 px'te söner
Assets.PanelShadow = "rbxassetid://99199298849636"
-- Ana menü: oyun logosu StarterGui FrontlineMenu.Main.Logo'nun Image'ında (Studio'dan yazılır).
-- Kenar karartması (StarterGui FrontlineMenu.Shade.Vignette) ve logo arkası ışığı (Main.TitleGlow),
-- tools/make_menu_fx.py; görseller StarterGui'de doğrudan atalı: vignette rbxassetid://73288087899036, glow rbxassetid://110509468159144

-- Harita seçimi: haritanın tam hali (tools/make_map_thumbs.py)
Assets.MapThumbs = {
	world = "rbxassetid://91640962069399",
	europe = "rbxassetid://138656918859174",
	asia = "rbxassetid://132778860668535",
	africa = "rbxassetid://74817988130404",
	namerica = "rbxassetid://113822313907168",
	samerica = "rbxassetid://77818188071649",
}

-- Ses efektleri: "rbxassetid://..." (Audio kimliği). Boş olanlar çalmaz. Liste repo SoundEffectController'dan + ekler.
Assets.Sounds = {
	-- arayüz
	click = "rbxassetid://116394299154002", -- herhangi bir düğmeye basınca (menü, HUD, sağ tık menüsü, üst bar; boşken ses yok). Tek bir tuşta
	-- istemezsen o tuşa NoClickSound = true özniteliğini ver (üstüne gelme sesi de çalmaz).
	hover = "rbxassetid://119354387183704", -- fareyle bir düğmenin üstüne gelince (PC)
	open = "", -- bir pencere açan düğmeler (Play, ?, ayarlar, Party, public maç satırları...)
	close = "", -- pencereyi kapatan düğmeler (Back, OK, Got it!, X)
	confirm = "", -- maçı başlatan / katılan düğmeler (PLAY, JOIN)
	tab = "", -- How to Play penceresindeki How to Play / Credits sekmeleri
	slider = "rbxassetid://127829361473403", -- saldırı gücü kaydırıcısı (kısa tık)
	error = "rbxassetid://131661013076677", -- yapılamayan işlem (yetersiz altın, geçersiz yer ...)
	notify = "rbxassetid://98797174600699", -- bilgi yazısı (toast)
	-- oyun akışı
	spawn = "rbxassetid://116394299154002", -- başlangıç yeri seçildi
	gameStart = "rbxassetid://137977737906734", -- başlangıç fazı bitti, oyun başladı
	countdownTick = "rbxassetid://137872392480008", -- başlangıç fazının son 5 saniyesinde her saniye
	queueStart = "rbxassetid://96362701378961", -- online bekleme odası açıldı
	tutorialStep = "rbxassetid://124743961969068", -- tutorial'da bir adım bitti (kart yeşil)
