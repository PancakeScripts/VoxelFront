							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Boat: nakliye gemisi (denizden çıkarma). OpenFront kuralları:
--   * Ulus / bot başına en fazla BOAT_MAX, insan oyuncu başına PLAYER_BOAT_MAX gemi; asker oranı gemide taşınır (ratio).
--   * Gemi hedefe en yakın ulaşılabilir kıyıya iner (Naval.findLanding), suyla en yakın kendi kıyısından yola çıkar.
--   * Tick başına 1 tile yol alır.
--   * Varınca iniş tile'ı fethedilir ve oradan başlayan bir saldırı (Attack, source=iniş) başlar; gemideki asker saldırıya geçer.
--   * Varışta iniş yeri artık saldıranınsa asker %25 kayıpla geri döner.

local Boat = {}
Boat.__index = Boat

export type Boat = typeof(setmetatable(
	{} :: {
		id: number,
		kind: string,
		pid: number,
		tile: any,
		ratio: any,
		troops: number,
		target: number,
		path: { number },
		idx: number,
		dst: number,
		done: boolean,
	},
	Boat
))

local nextId = 0

function Boat.new(pid: number, tile: any, ratio: any): Boat
	nextId += 1
	return setmetatable({
		id = nextId,
		kind = "boat",
		pid = pid,
		tile = tile,
		ratio = ratio,
		troops = 0,
		target = 0,
		path = {},
		idx = 1,
		dst = 0,
		done = false,
	}, Boat)
end

local function validTile(size: number, tile: any): boolean
	return type(tile) == "number" and tile == tile and tile >= 0 and tile < size and tile % 1 == 0
end

-- Geminin şu anki tile'ı (istemciye çizim için).
function Boat.position(self: Boat): number
	return self.path[math.min(self.idx, #self.path)]
end

function Boat.finish(self: Boat, sim: any, refund: number?)
	if self.done then
		return
	end
	self.done = true
	sim.boatCount[self.pid] = math.max(0, (sim.boatCount[self.pid] or 0) - 1)
	if refund and refund > 0 and sim.alive[self.pid] then
		sim.troops[self.pid] += refund
	end
end

function Boat.init(self: Boat, sim: any)
	self.done = true
	local world, cfg, pid = sim.world, sim.cfg, self.pid
	local N = sim.parts.Naval

	if not validTile(world.size, self.tile) then
		sim:emit(pid, "badTile")
		return
	end
	local ratio = self.ratio
	if type(ratio) ~= "number" or ratio ~= ratio or ratio <= 0 or ratio > 1 then
		sim:emit(pid, "badTarget")
		return
	end
	if sim.phase ~= "run" then
		sim:emit(pid, "notStarted")
		return
	end
	if not sim.spawned[pid] then
		sim:emit(pid, "notSpawned")
		return
	end
	if (sim.boatCount[pid] or 0) >= (if sim.isBot[pid] then cfg.BOAT_MAX else cfg.PLAYER_BOAT_MAX) then
		sim:emit(pid, "noBoats")
		return
	end
	local target = world:ownerAt(self.tile)
	if target == pid or (target ~= 0 and not (sim.alive[target] and sim.spawned[target])) then
		sim:emit(pid, "badTarget")
		return
	end
	if target ~= 0 and sim.parts.Diplomacy.isAllied(sim, pid, target) then
		sim:emit(pid, if sim.parts.Diplomacy.sameTeam(sim, pid, target) then "teammate" else "allied")
		return
	end

	local comps = N.reachableComps(world, pid)
	if next(comps) == nil then
		sim:emit(pid, "noShore")
		return
	end
	local dst = N.findLanding(world, target, self.tile, comps)
	if not dst then
		sim:emit(pid, "noLanding")
		return
	end
	local route = N.findRoute(world, pid, dst)
	if not route then
		sim:emit(pid, "noRoute")
		return
	end
	local amount = math.floor(sim.troops[pid] * ratio)
	-- Repo AI boats send 20% even when that is below the human click minimum.
	if amount < (if sim.isNation[pid] then 1 else cfg.ATTACK_MIN_TROOPS) then
		sim:emit(pid, "noTroops")
		return
	end

	-- repo TransportShipExecution.init: gemi kalkınca hedeften gelen ittifak isteği reddedilir (botlar hariç).
	-- Ambargo (sınır kırmızısı) iniş anında, saldırı başlarken konur.
	if target ~= 0 and (not sim.isBot[target] or sim.isNation[target]) and (not sim.isBot[pid] or sim.isNation[pid]) then
		local D = sim.parts.Diplomacy
		local req = D.findRequest(sim, target, pid)
		if req then
			D.reject(sim, req)
		end
	end
	sim.troops[pid] -= amount
	sim.boatCount[pid] = (sim.boatCount[pid] or 0) + 1
	self.troops = amount
	self.target = target
	self.path = N.smooth(world, route)
	self.dst = dst
	self.idx = 1
	self.done = false
	if target ~= 0 then sim:emit(target, "boatInbound", pid) end
end

function Boat.tick(self: Boat, sim: any)
	if self.done then
		return
	end
	if not sim.alive[self.pid] then
		self:finish(sim)
		return
	end
	self.idx += 1
	if self.idx <= #self.path then
		return
	end

	-- Vardı.
	local world, pid = sim.world, self.pid
	if world:ownerAt(self.dst) == pid then
		self:finish(sim, self.troops * (1 - sim.cfg.ATTACK_RETREAT_MALUS / 100))
		sim:emit(pid, "boatReturned")
		return
	end
	-- (bildirim: indiği yerin sahibine "kıyına asker çıktı", gemi sahibine "indi")
	local victim = world:ownerAt(self.dst)
	sim:emit(pid, "boatLanded", if victim ~= 0 then victim else nil)
	if victim ~= 0 then
		sim:emit(victim, "boatLandedOnYou", pid)
	end
	local troops = self.troops
	self.troops = 0
	self:finish(sim)
	world:setOwner(self.dst, pid)
	sim:addExecution(sim.parts.Attack.new(pid, self.target, 0, { troops = troops, source = self.dst }))
end

return Boat
]]></ProtectedString>
