local Teams = require(Shared:WaitForChild("Core"):WaitForChild("Teams"))
local MapPalette = require(script.MapPalette)
local MapRenderer = require(script.MapRenderer)
local Viewport = require(script.Viewport)
local Alignment = require(script.Alignment)
local Hud = require(script.Hud)
local Menu = require(script.Menu)
local WorldLayer = require(script.WorldLayer)
local Trails = require(script.Trails)
local Fx = require(script.Fx)
local Radial = require(script.Radial)
local Rails = require(script.Rails)
local RailGeom = require(script.RailGeom)
local Sound = require(script.Sound)
local Assets = require(Shared:WaitForChild("Assets"))
local Look = require(Shared:WaitForChild("Look"))
local Format = require(Shared:WaitForChild("Format"))
local Sites = require(Shared:WaitForChild("Sites"))
local Structures = require(script.Structures)
local Drip = require(script.Drip)
local CameraFocus = require(script.CameraFocus)
local WaterComp = require(script.WaterComp)
local SamRings = require(script.SamRings)

local NOTICES = {
	badTile = "Invalid spot.",
	notLand = "You can't settle here: water.",
	tooClose = "This belongs to someone else.",
	locked = "Starting point can no longer be changed.",
	badTarget = "Invalid target.",
	notStarted = "The game hasn't started yet.",
	notSpawned = "Pick a starting point first.",
	noTroops = "Not enough troops.",
	noBorder = "You don't border this target.",
	tooMany = "Too many attacks in progress.",
	eliminated = "You were eliminated! You lost all your land.",
	tookOver = "You took over the nation!",
	noGold = "Not enough gold.",
	notOwned = "You can only build on your own land.",
	noSpace = "No room here (15 tiles between structures).",
	noCity = "You have no nearby city to upgrade.",
	noBoats = "You can have at most 10 boats.",
	noShore = "You need a shore to send a boat.",
	noLanding = "No reachable shore near the target.",
	noRoute = "No water route found for the boat.",
	noPort = "You have no ready port in this sea.",
	noPortHere = "You have no nearby port to upgrade.",
	noSilo = "No ready silo (build a silo or wait for a missile slot to refill).",
	noSiloHere = "You have no nearby silo to upgrade.",
	noSamHere = "You have no nearby SAM to upgrade.",
	noFactoryHere = "You have no nearby factory to upgrade.",
	nukeInbound = "An ATOM bomb is incoming!",
	hydroInbound = "A HYDROGEN bomb is incoming!!",
	nukeHit = "Atom bomb hit!",
	hydroHit = "Hydrogen bomb hit!",
	samHit = "Your SAM shot down a bomb.",
	nukeDown = "A SAM shot down your bomb!",
	nukeOwn = "You can't bomb your own land.",
	nukeAlly = "You can't bomb your ally.",
	allied = "You can't attack an ally.",
	teammate = "You can't attack a teammate.",
	allyNo = "Alliance request can't be sent.",
	allyBot = "You can't ally with bots.",
	allyWait = "You can't send another request to the same player within 30s.",
	allyNew = "Alliance formed!",
	allyRejected = "Your alliance request was rejected.",
	allyBroken = "Your ally broke the alliance!",
	allyNoExt = "Renewal is only possible in the alliance's last 30 seconds.",
	allyRenewed = "Alliance renewed.",
	allyNone = "No alliance/request with this player.",
	joined = "Go! Pick your starting point on the map.",
	donateNotAlly = "You can only donate to your ally.",
	donateWait = "You can donate to the same player once every 10s.",
	donatedGold = "Gold sent.",
	donatedTroops = "Troops sent.",
	gotGold = "Your ally sent you gold!",
	gotTroops = "Your ally sent you troops!",
	deleteWait = "You must wait a bit before deleting a structure (30s).",
	deleteNone = "You have no nearby structure to delete.",
	deleteMarked = "Structure will be demolished in 30s.",
	mirvInbound = "☄ A MIRV was launched at you!",
	waiting = "Game in progress: you'll join when the next round starts. Spectate for now!",
	allyExpired = "Alliance expired.",
}
local WHEEL_STEP = 1.2
local CLICK_MAX_TRAVEL = 6 -- fare: bu kadar pikselden az hareket = tık
local TAP_MAX_TRAVEL = 12 -- dokunma

-- Arayüz iskeleti ---------------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "FrontlineMap"
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
pcall(function()
	(gui :: any).ScreenInsets = Enum.ScreenInsets.None
end)
gui.DisplayOrder = 0
gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
-- Arayüzler StarterGui'den gelir (Studio'da düzenlenebilir): FrontlineHud, FrontlineMenu.
-- Oyunda karakter (avatar) yok (Players.CharacterAutoLoads = false: harita 2B, düşen/yeniden doğan avatar boşuna yük).
-- Karakter doğmayınca Roblox StarterGui'yi PlayerGui'ye kopyalamaz; burada kopyalanır. Karakter açıksa onun kopyası beklenir.
local StarterGui = game:GetService("StarterGui")
local function starterUi(name: string): ScreenGui
	local have = playerGui:FindFirstChild(name)
	if have then
		return have :: ScreenGui
	end
	if Players.CharacterAutoLoads and not require(Shared:WaitForChild("Session")).reloaded then -- menüye dönüşte kopyayı biz sildik, beklenmez
		local waited = playerGui:WaitForChild(name, 10)
		if waited then
			return waited :: ScreenGui
		end
	end
	local src = StarterGui:WaitForChild(name, 30)
	assert(src, "[Frontline] StarterGui > " .. name .. " not found")
	local copy = src:Clone() :: ScreenGui
	copy.Parent = playerGui
	return copy
end
local hudGui = starterUi("FrontlineHud")
local menuGui = starterUi("FrontlineMenu")
-- Text caps / strokes follow the screen size (1920x1080 reference), like the Scale-sized frames.
local UiScale = require(script.UiScale)
UiScale.bind(hudGui)
UiScale.bind(menuGui)
-- Panellerin altına yumuşak gölge
require(script.Shadow).addAll(menuGui, { "Main/Dock", "Main/PartyPanel", "SettingsCard", "HelpCard", "FeedbackCard", "EndCard", "PartyCard", "Setup/Panel/Body/MapCard", "Setup/Panel/Body/Difficulty", "Setup/Panel/Body/Play", "OnlineSetup/Panel/Body/MapCard", "OnlineSetup/Panel/Body/Stats", "OnlineSetup/Panel/Body/Play", "TeamSetup/Panel/Body/MapCard", "TeamSetup/Panel/Body/Stats", "TeamSetup/Panel/Body/Play", "CratesCard", "CrateReel/Strip", "ShopCard", "SoloShopCard" })
-- maç hazırlık pencereleri (solo / Solo Online): gölgeleri %30 daha hafif
for _, name in { "Setup", "OnlineSetup", "TeamSetup" } do
	require(script.Shadow).add((menuGui :: any)[name].Panel.Body, nil, nil, 0.7)
end
-- Kabarık düğmeler (altta koyu taban)
require(script.ButtonDepth).addAll(menuGui, { "Main/Dock/Play", "Setup/Panel/Body/Play", "Setup/Panel/Back", "Setup/Panel/Body/ChooseMap", "MapPicker/Panel/Back", "SettingsCard/Back", "FeedbackCard/Send", "FeedbackCard/Close", "Setup/Panel/Body/Difficulty/easy", "Setup/Panel/Body/Difficulty/normal", "Setup/Panel/Body/Difficulty/hard", "Setup/Panel/Body/Difficulty/insane", "OnlineSetup/Panel/Body/Play", "OnlineSetup/Panel/Back", "TeamSetup/Panel/Body/Play", "TeamSetup/Panel/Back", "PartyCard/InviteFriends", "PartyCard/LeaveParty", "PartyCard/Close", "EndCard/Play", "EndCard/MenuButton", "HelpCard/Back", "CratesCard/Close", "CratesCard/Tabs/CratesTab", "CratesCard/Tabs/CollectionTab", "CratesCard/CratePage/Open", "CratesCard/CollectionPage/Filter/Skins", "CratesCard/CollectionPage/Filter/Flags", "CratesCard/CratePage/Buy/Buy1", "CratesCard/CratePage/Buy/Buy3", "CratesCard/CratePage/Buy/Buy10", "CratesCard/CratePage/Index/Skins", "CratesCard/CratePage/Index/Flags", "CrateReel/Skip", "CratesCard/IndexBack", "GameOver/Buttons/PlayAgain", "GameOver/Buttons/Spectate", "GameOver/Buttons/ToTitle", "ShopCard/Close", "SoloShopCard/Close" })
require(script.Shadow).addAll(hudGui, { "TopBar", "Banner", "Toast", "BottomBar", "Hover", "Diplo", "Attacks", "TargetCard", "BuildConfirm", "Leaderboard/Expanded" })
-- Sağ tık menüsü kodla kurulur, en üstte
local radialGui = Instance.new("ScreenGui")
radialGui.Name = "FrontlineRadial"
radialGui.ResetOnSpawn = false
radialGui.IgnoreGuiInset = true
radialGui.DisplayOrder = 30
pcall(function()
	(radialGui :: any).ScreenInsets = Enum.ScreenInsets.None
end)
radialGui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Name = "MapFrame"
frame.Size = UDim2.fromScale(1, 1)
frame.BackgroundColor3 = Color3.fromRGB(10, 18, 34)
frame.BorderSizePixel = 0
frame.ClipsDescendants = true
frame.Active = true
frame.Parent = gui

-- Düğme / kaydırıcı olayları: işlevler aşağıda (oyun mantığı tanımlandıktan sonra) atanır.
local hudCb = {
	onBuild = function(_id: string) end,
	onFocus = function() end,
	onHoverBuild = function(_id: string?) end,
	onRatio = function(_r: number) end,
	onDiplo = function(_kind: string) end,
	onCancel = function(_target: number) end,
	onRequest = function(_from: number, _accept: boolean) end,
	onCard = function(_kind: string) end,
	onBuildConfirm = function(_ok: boolean) end,
}
local hud = Hud.new(hudGui, hudCb)
local radial = Radial.new(radialGui)
local menuCb = {
	onPause = function(): boolean
		return false
	end,
	onResume = function() end,
	onVisibility = function(open: boolean)
		hudGui.Enabled = not open
		radialGui.Enabled = not open
		if open then radial:close() end
	end,
	onPlay = function() end,
	onMenu = function() end,
	onSettings = function(_s: any) end,
}
local menu = Menu.new(menuGui, menuCb, Config.VERSION)
menu:bindHud(hud.settingsButton, hud.helpButton) -- (oyunda alt barın solundaki ayarlar ve "?" düğmeleri)
-- Düğme sesleri (RoWorld): pencere açan "open", kapatan "close", maçı başlatan / katılan "confirm", sekmeler "tab";
-- geri kalanı "click" (Sound.bindClicks, düğmenin ClickSound özniteliği)
for path, key in {
	["Main/Dock/Play"] = "open", ["Main/Dock/Help"] = "open", ["Main/Dock/SoloOnline"] = "open", ["Main/Dock/TeamOnline"] = "open",
	["Main/PartyPanel/Invite"] = "open", ["Setup/Panel/Body/ChooseMap"] = "open",
	["Setup/Panel/Body/Play"] = "confirm", ["OnlineSetup/Panel/Body/Play"] = "confirm", ["TeamSetup/Panel/Body/Play"] = "confirm",
	["Setup/Panel/Back"] = "close", ["OnlineSetup/Panel/Back"] = "close", ["TeamSetup/Panel/Back"] = "close", ["MapPicker/Panel/Back"] = "close",
	["SettingsCard/Back"] = "close", ["HelpCard/Back"] = "close", ["PartyCard/Close"] = "close",
	["HelpCard/Tabs/HowToPlay"] = "tab", ["HelpCard/Tabs/Credits"] = "tab",
} do
	local cur: Instance? = menuGui
	for part in string.gmatch(path, "[^/]+") do
		cur = cur and cur:FindFirstChild(part)
	end
	if cur then
		cur:SetAttribute("ClickSound", key)
	end
end
hud.settingsButton:SetAttribute("ClickSound", "open")
hud.helpButton:SetAttribute("ClickSound", "open")
Sound.bindClicks(hudGui)
Sound.bindClicks(menuGui)
Sound.bindClicks(radialGui)
Sound.bindClicks(playerGui:WaitForChild("FrontlineTopbar")) -- (üst bardaki çıkış tuşu; Menu.new kurar)
-- Online maç sunucusundaysa (ayrılmış sunucu; Studio'da yerel maç) ana menü yerine bekleme odası açılır.
local Online = require(script.Online)
local online = Online.detect(script)
if online then
	menu:hide()
	hudGui.Enabled = false
else
	menu:showMain() -- herkes ana menüde başlar
	menu:bindOnline() -- Solo / Team Online satırları (sunucuda online açıksa)
	menu:bindParty() -- PARTY tuşu ve penceresi
	require(script.Tutorial).watchNewPlayer(menu) -- (yeni oyuncu: ilk maçı kendiliğinden tutorial olarak başlar)
	require(script.Analytics).watchTitle(menu) -- (Onboarding hunisi: ana menü göründü)
end

-- Menü: arkada ayrı küçük harita döner. Seçilen harita bellekte ancak PLAY'e basılınca kurulur.
do
	-- (arka plan müziği: ana menü / bekleme odası; Assets.Music; ayarlardaki Menu music / Game music anahtarları)
	require(script.Music).setEnabled(menu.settings.menuMusic ~= false, menu.settings.gameMusic ~= false)
	require(script.Music).set("menu")
	Sound.enabled = menu.settings.sounds ~= false
	menuCb.onSettings = function(st: any)
		Sound.enabled = st.sounds ~= false
		require(script.Music).setEnabled(st.menuMusic ~= false, st.gameMusic ~= false)
	end
	local started = false
	menuCb.onPlay = function()
		local S = require(Shared:WaitForChild("Session")) :: any
		if S.tutorial == "pending" then
			S.tutorial = "run" -- (yeni oyuncu PLAY'e kendisi bastı: tutorial bu maçta)
		end
		started = true
	end
	local Session = require(Shared:WaitForChild("Session"))
	local bgMap = if online then online.map else Session.map
	local menuMap = require(script.MenuMap).start(menuGui, bgMap)
	-- (id: Solo Online penceresindeki sıradaki maçın haritası; nil: seçili solo harita)
	;(menuCb :: any).onMapChange = function(id: string?)
		local want = id or Session.map
		if want == bgMap then
			return
		end
		bgMap = want
		menuMap:destroy()
		menuMap = require(script.MenuMap).start(menuGui, want)
	end
	if online then
		online.wait(menuGui) -- maç başlayana dek
	else
		while not started do
			task.wait()
		end
	end
	menuMap:destroy()
	hudGui.Enabled = false
	local loading = Instance.new("TextLabel")
	loading.Name = "Loading"
	loading.BackgroundColor3 = Color3.fromRGB(10, 14, 24)
	loading.BorderSizePixel = 0
	loading.Size = UDim2.fromScale(1, 1)
	loading.FontFace = Fonts.main
	loading.TextColor3 = Color3.new(1, 1, 1)
	loading.TextSize = 28
	loading.Text = "Loading map..."
	loading.ZIndex = 200
	loading.Parent = menuGui
	;(menuCb :: any).loaded = function()
		loading:Destroy()
		hudGui.Enabled = true
		require(script.Music).set("game") -- (harita yüklendi, maç başlıyor: maç müziği)
	end
	task.wait()
end

-- Haritayı al -----------------------------------------------------------------

-- Botlarla maç bu cihazda çalışır: Match, ağ yerine LocalNet ile konuşur. Online'da maç sunucudadır (gerçek remote'lar).
local localNet = if online then online.net() else require(Shared:WaitForChild("LocalNet")).new(Players.LocalPlayer)
local okMatch, localMatch = pcall(function()
	if online then
		return online.match()
	end
	-- (yalnız Studio: workspace'in "DevTeams" özniteliği 2..4 ise solo maç takımlı başlar; takım maçını yerelde denemek için)
	local devTeams = if RunService:IsStudio() then workspace:GetAttribute("DevTeams") else nil
	local started = require(Shared:WaitForChild("Match")).start(function()
		return localNet
	end, true, require(Shared:WaitForChild("Session")).map, nil, if type(devTeams) == "number" then devTeams else nil)
	started.join(Players.LocalPlayer)
	return started
end)
if not okMatch then
	(menuCb :: any).loaded()
	hud:error("Could not start the match: " .. tostring(localMatch))
	return
end
local getMap = localNet.getMap
local getState = localNet.getState
local intentRemote = localNet.intent
local deltaRemote = localNet.delta
local statsRemote = localNet.stats
local noticeRemote = localNet.notice
local boatsRemote = localNet.boats
local fxRemote = localNet.fx
local attacksRemote = localNet.attacks

local okInvoke, reply = pcall(function()
	return getMap:InvokeServer()
end)
if not okInvoke or type(reply) ~= "table" then
	(menuCb :: any).loaded()
	hud:error("Could not get map: " .. tostring(reply))
	return
end

local mapW: number = reply.width
local mapH: number = reply.height
-- Harita verisi maçla paylaşılır (iki kez çözülüp bellekte tutulmaz).
local tileBytes = localMatch.tileBytes
local terrain = localMatch.terrain

local BLOCKS = MapRenderer.blockCount(mapW, mapH)
local editables: { any } = {}
local okImage, imageErr = pcall(function()
	for i = 1, BLOCKS do
		local _, _, bw, bh = MapRenderer.blockRect(i, mapW, mapH)
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(bw, bh) })
		-- bütçe dolduysa hata vermeden nil dönebilir
		assert(image, "not enough memory for the map on this device")
		editables[i] = image
	end
end)
if not okImage then
	(menuCb :: any).loaded()
	hud:error(
		"Could not create EditableImage: "
			.. tostring(imageErr)
			.. "  (Enable Mesh/Image API permission in Game Settings > Security.)"
	)
	return
end

task.wait()
local t0 = os.clock()
local myPid = 0 -- bu oyuncunun pid'si (sunucudan gelir)
local renderer = MapRenderer.new(editables, mapW, mapH, MapPalette.buildPixels(tileBytes), PlayerColors.rgb, function(pid: number, r: number, g: number, b: number)
	if pid == myPid then
		return 230, 230, 230 -- yerel oyuncunun sınırı açık gri/beyaz (OpenFront focusedBorderColor #e6e6e6)
	end
	return PlayerColors.border(r, g, b)
end)
