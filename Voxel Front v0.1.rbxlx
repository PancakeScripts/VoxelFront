						<string name="Name">LobbyStore</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">1c14f2467dd4fbf50afa546d0000ef28</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXD539AC16D721449E8A32C9F7FA0F3F5B">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- SharedClock: online lobiler için tüm sunucuların anlaştığı saat (başlama zamanları, tazelemeler, kilitler bir sunucuda yazılıp
-- diğerlerinde okunur). Roblox sunucularının kendi saatleri (os.time) dakikalarca farklı olabilir; bu yüzden her sunucu
-- Roblox'un arka uç saatine farkını ölçer: bir DataStore yazımının DataStoreKeyInfo.UpdatedTime değeri arka uçta damgalanır,
-- çağrının ortasındaki yerel saatle kıyaslanır (hata: gidiş-dönüşün yarısı). Ara ara yeniden ölçülür; DataStore yoksa
-- (API erişimi kapalı Studio) fark 0 — orada zaten tek sunucu vardır.
-- RoWorld src/server/Lobbies/SharedClock.luau'dan alındı (AGPL-3.0, © 2026 Snick Co.); değişiklik: DataStore adı.
--
--   SharedClock.start(deps?)  şimdi ve her RESYNC_S'de ölç (deps: datastore, millis, log — testte verilebilir)
--   SharedClock.now()         os.time() + fark (saniye, kesirli)
--   SharedClock.ready()       bir kez ölçüldü ya da vazgeçildi (lobi planlaması bunu bekler)

local SharedClock = {}

SharedClock.STORE = "frontline_clock"
SharedClock.KEY = "probe"
--- Her ölçüm bu kadar anahtardan rastgele birine yazar: tek anahtar birkaç saniyede bir yazım kabul eder; çok sunucu aynı
--- anahtara yazınca yazımlar reddedilir (RoWorld'de ~880 sunucuda yaşandı).
SharedClock.KEYS = 256
SharedClock.RESYNC_S = 20 * 60
--- İlk ölçümü bu kadar bekledikten sonra vazgeçilir (lobiler durmasın).
SharedClock.READY_TIMEOUT_S = 15
--- Gidiş-dönüşü bundan uzun süren ölçüm kullanılmaz (fazla belirsiz).
SharedClock.MAX_RTT_S = 4.0

SharedClock.offset = 0.0
SharedClock.synced = false
SharedClock._started_at = os.clock()
SharedClock._given_up = false

local function millis(): number
	return DateTime.now().UnixTimestampMillis
end

function SharedClock.now(): number
	return os.time() + SharedClock.offset
end

function SharedClock.ready(): boolean
	return SharedClock.synced
		or SharedClock._given_up
		or os.clock() - SharedClock._started_at > SharedClock.READY_TIMEOUT_S
end

--- Tek ölçüm (bekler). Fark güncellendiyse true.
function SharedClock.measure(deps: { [string]: any }?): boolean
	local d = deps or {}
	local store = d.datastore
	if store == nil then
		local ok, ds = pcall(function()
			return game:GetService("DataStoreService"):GetDataStore(SharedClock.STORE)
		end)
		if not ok then
			return false
		end
		store = ds
	end
	local t0 = (d.millis or millis)()
	local ok, info = pcall(function()
		local key = SharedClock.KEY .. tostring(math.random(1, SharedClock.KEYS))
		local _, key_info = store:UpdateAsync(key, function(old: any): any
			return (tonumber(old) or 0) + 1
		end)
		return key_info
	end)
	local t1 = (d.millis or millis)()
	if not ok or info == nil or type(info.UpdatedTime) ~= "number" then
		return false
	end
	local rtt = (t1 - t0) / 1000.0
	if rtt > SharedClock.MAX_RTT_S then
		return false
	end
	-- arka uç yazımı çağrının içinde bir yerde damgaladı: ortası varsayılır
	local backend_s = info.UpdatedTime / 1000.0
	local local_mid_s = (t0 + t1) / 2000.0
	-- os.time() ve DateTime aynı yerel saati kullanır: fark os.time()'a da uyar
	SharedClock.offset = backend_s - local_mid_s
	SharedClock.synced = true
	if d.log then
		d.log(string.format("[SharedClock] offset %+.1fs (rtt %.0fms)", SharedClock.offset, rtt * 1000))
	end
	return true
end

--- Şimdi (arka planda) ve her RESYNC_S'de ölç. İlk denemeler başarısızsa beklemekten vazgeçer.
function SharedClock.start(deps: { [string]: any }?)
	SharedClock._started_at = os.clock()
	task.spawn(function()
		local tries = 0
		while not SharedClock.measure(deps) do
			tries += 1
			if tries >= 3 then
				SharedClock._given_up = true
				break
			end
			task.wait(2)
		end
		while true do
			task.wait(SharedClock.RESYNC_S)
			SharedClock.measure(deps)
		end
	end)
end

return SharedClock
]]></ProtectedString>
