						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Shadow: panellerin çevresine yumuşak gölge, her yana eşit (koyu haritada da görünsün diye %70 koyu, 32 px).
-- Gölge panelin kardeşidir (çocuk olsa panelin üstünde çizilirdi); panelin ekrandaki yerini ve görünürlüğünü izler.
-- Düzen (UIListLayout / UIGridLayout) içindeki öğelere eklenmez: kardeş gölge düzende yer kaplardı.

local Assets = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Assets"))

local PAD = 35
local RADIUS = 20 -- görseldeki köşe yuvarlaklığı (tools/make_shadow.py ile aynı)
local OFFSET_Y = 0
local TRANSPARENCY = 0.6

local Shadow = {}

-- parent / z (isteğe bağlı): gölge başka bir yere konur (ör. kaydırılan listedeki kart: liste gölgeyi kesmesin), o z'de.
-- strength (isteğe bağlı): koyuluğun çarpanı (0.7 = %30 daha hafif); verilmezse 1.
function Shadow.add(target: GuiObject, parentOverride: Instance?, z: number?, strength: number?)
	local parent = parentOverride or target.Parent
	if not parent or (parentOverride == nil and parent:FindFirstChildWhichIsA("UIGridStyleLayout")) or Assets.PanelShadow == "" then
		return
	end
	local s = Instance.new("ImageLabel")
	s.Name = target.Name .. "Shadow"
	s.BackgroundTransparency = 1
	s.Image = Assets.PanelShadow
	s.ImageColor3 = Color3.new(0, 0, 0)
	s.ImageTransparency = 1 - (1 - TRANSPARENCY) * (strength or 1)
	s.ScaleType = Enum.ScaleType.Slice
	s.SliceCenter = Rect.new(PAD + RADIUS, PAD + RADIUS, PAD + RADIUS + 4, PAD + RADIUS + 4)
	s.Active = false
	local function place()
		local p = parent :: any
		local pos = target.AbsolutePosition - p.AbsolutePosition
		local size = target.AbsoluteSize
		s.Position = UDim2.fromOffset(pos.X - PAD, pos.Y - PAD + OFFSET_Y)
		s.Size = UDim2.fromOffset(size.X + PAD * 2, size.Y + PAD * 2)
		s.Visible = target.Visible
		s.ZIndex = z or target.ZIndex - 1
	end
	for _, prop in { "AbsolutePosition", "AbsoluteSize", "Visible", "ZIndex" } do
		target:GetPropertyChangedSignal(prop):Connect(place)
	end
	;(parent :: any):GetPropertyChangedSignal("AbsolutePosition"):Connect(place)
	target.Destroying:Connect(function()
		s:Destroy()
	end)
	place()
	s.Parent = parent
end

-- root altındaki yollar ("A/B"); bulunamayan atlanır.
function Shadow.addAll(root: Instance, paths: { string })
	for _, path in paths do
		local cur: Instance? = root
		for part in string.gmatch(path, "[^/]+") do
			cur = cur and cur:FindFirstChild(part)
		end
		if cur and cur:IsA("GuiObject") then
			Shadow.add(cur)
		end
	end
end

return Shadow
]]></ProtectedString>
