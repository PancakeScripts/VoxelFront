						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Diplo: tek tick'lik diplomasi niyeti (istek, kabul, ret, bozma, yenileme, ambargo). Kurallar Diplomacy modülünde.

local Diplo = {}
Diplo.__index = Diplo

function Diplo.new(pid: number, action: string, target: any, on: any?)
	return setmetatable({ kind = "diplo", pid = pid, action = action, target = target, on = on, done = false }, Diplo)
end

function Diplo.init(self: any, sim: any)
	self.done = true
	local D = sim.parts.Diplomacy
	local pid, t = self.pid, self.target
	if type(t) ~= "number" or t ~= t or t % 1 ~= 0 or t < 1 or t > sim.playerCount or t == pid then
		sim:emit(pid, "badTarget")
		return
	end
	if sim.phase ~= "run" then
		sim:emit(pid, "notStarted")
		return
	end
	if not sim.alive[t] or not sim.spawned[t] or not sim.spawned[pid] then
		sim:emit(pid, "badTarget")
		return
	end
	local a = self.action
	if a == "ally" then
		D.sendRequest(sim, pid, t)
	elseif a == "allyAccept" then
		local req = D.findRequest(sim, t, pid)
		if req then
			D.accept(sim, req)
		else
			sim:emit(pid, "allyNone")
		end
	elseif a == "allyReject" then
		local req = D.findRequest(sim, t, pid)
		if req then
			D.reject(sim, req)
		end
	elseif a == "breakAlly" then
		if D.allianceOf(sim, pid, t) then -- (takım arkadaşlığı bozulmaz)
			D.breakAlliance(sim, pid, t)
		else
			sim:emit(pid, "allyNone")
		end
	elseif a == "extendAlly" then
		D.extend(sim, pid, t)
	elseif a == "embargo" then
		if D.sameTeam(sim, pid, t) then
			sim:emit(pid, "teammate")
		elseif self.on == false then
			D.stopEmbargo(sim, pid, t)
		else
			D.addEmbargo(sim, pid, t, false)
		end
	end
end

function Diplo.tick(_self: any, _sim: any) end

return Diplo
]]></ProtectedString>
							<string name="ScriptGuid">{4B4EA312-9906-474E-9A3B-70D355201350}</string>
