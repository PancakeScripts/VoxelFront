						<string name="Name">StoreTests</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">1c14f2467dd4fbf50afa546d0000ef2c</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX73D9D104D4B147969806A68F86D491FA">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- DirectoryTests: LobbyDirectory, aynı depoyu paylaşan iki normal sunucuyla (RoWorld tests/lobbies.luau'daki dizin testlerinden
-- uyarlandı, AGPL-3.0, © 2026 Snick Co.). Oyunda çalışmaz; Studio'da elle:
-- require(game.ServerScriptService.Server.Dev.DirectoryTests).run()  -> { passed, failed, lines }

local Lobbies = script.Parent.Parent.Lobbies
local LobbyRules = require(Lobbies.LobbyRules)
local LobbyStore = require(Lobbies.LobbyStore)
local LobbyDirectory = require(Lobbies.LobbyDirectory)
local Catalog = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Maps"):WaitForChild("Catalog"))

local DirectoryTests = {}

function DirectoryTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end

	local clock = 5000
	local function tnow()
		return clock
	end
	local store = LobbyStore.localstore(tnow)
	local reserved, sent, teleport_ok = 0, {}, true
	local rng = Random.new(3)
	local ids = 0
	local created = {} -- oluşturulan lobilerin haritaları, sırayla (deps.log'dan)
	local function maps()
		local out = {}
		for _, id in Catalog.order do
			table.insert(out, { id = id, name = Catalog[id].name, max = Catalog[id].onlineMax })
		end
		return out
	end
	local function make_hub(name)
		local s = setmetatable({}, { __index = store })
		s.lock = function(n, ttl)
			return store.lock(n, ttl, name)
		end
		return LobbyDirectory.new({
			store = s,
			teleport = {
				reserve = function()
					reserved += 1
					return "code" .. reserved, "psid" .. reserved
				end,
				send = function(players, code, data)
					if not teleport_ok then
						return false, "nope"
					end
					table.insert(sent, { players = players, code = code, data = data })
					return true
				end,
			},
			maps = maps,
			now = tnow,
			rand = function()
				return rng:NextNumber()
			end,
			new_id = function()
				ids += 1
				return "L" .. ids
			end,
			wait = function() end,
			log = function(text)
				local map = string.match(text, "created %S+ on (%S+)")
				if map then
					table.insert(created, map)
				end
			end,
		})
	end
	local hub1, hub2 = make_hub("hub1"), make_hub("hub2")
	hub1:refresh()
	hub2:refresh()
	expect(#store.list() == LobbyRules.TARGET_OPEN, "ilk sunucu lobiyi oluşturur, ikincisi (kilit dolu) tekrar oluşturmaz")
	expect(#hub2:view() == LobbyRules.TARGET_OPEN and hub2:view()[1].id == hub1:view()[1].id, "iki sunucu aynı lobiyi gösterir")
	local first = hub1:view()[1]
	expect(first.max == Catalog[first.map].onlineMax, "lobi haritasının oyuncu sınırıyla açılır (" .. first.map .. " " .. first.max .. ")")
	expect(first.starts_in == LobbyRules.MIN_LEAD_S - LobbyRules.JOIN_CLOSE_S and first.players == 0 and first.joinable, "görünüm: süre, bekleyen, katılınabilir")

	-- katılma
	local ok, msg = hub2:join({ "p1" })
	expect(ok and #sent == 1 and sent[1].code ~= nil and sent[1].data.lobby == first.id and sent[1].data.map == first.map, "katılan lobinin sunucusuna ışınlanır")
	expect(store.get(first.id).players == 1, "katılım bir koltuk ayırır")
	tel = nil
	teleport_ok = false
	ok, msg = hub1:join({ "p2" })
	expect(not ok and store.get(first.id).players == 1, "başarısız ışınlanmada koltuk geri verilir: " .. tostring(msg))
	teleport_ok = true

	-- depo meşgulken: birkaç deneme, sonra bu sunucunun listesinden katılım
	do
		local real = store.take
		local calls = 0
		store.take = function()
			calls += 1
			error("MemoryStoreService: Request was throttled")
		end
		local before = #sent
		local ok1, msg1 = hub1:join({ "flood1" })
		store.take = real
		expect(ok1 and #sent == before + 1 and calls == LobbyDirectory.JOIN_TRIES, "depo meşgul: yeniden denenir, sonra listeden katılınır: " .. tostring(msg1))
	end

	-- katılımı kapanan lobi listeden çıkar, sıradaki gösterilir
	do
		local rec = store.get(first.id)
		local saved = clock
		clock = rec.starts - LobbyRules.JOIN_CLOSE_S + 1
		hub1:refresh()
		local listed = false
		for _, v in hub1:view() do
			if v.id == first.id then
				listed = true
			end
		end
		expect(not listed and #hub1:view() >= 1, "başlamak üzere olan lobi gizlenir, sıradaki gösterilir")
		local nxt = hub1:view()[1]
		expect(nxt ~= nil and nxt.map ~= first.map, "sıradaki lobinin haritası farklı (" .. first.map .. " -> " .. tostring(nxt and nxt.map) .. ")")
		clock = saved
	end

	-- dolan lobi gizlenir ve yerine yenisi açılır
	do
		clock += 60
		hub1:refresh()
		local cur = hub1:view()[1]
		local rec = store.get(cur.id)
		rec.players = rec.max
		store.put(rec, 900)
		hub1:refresh()
		local listed = false
		for _, v in hub1:view() do
			if v.id == cur.id then
				listed = true
			end
		end
		expect(not listed and #hub1:view() == LobbyRules.TARGET_OPEN, "dolu lobi gizlenir, yerine yenisi açılır")
	end

	-- uzun süre: harita hiç arka arkaya tekrarlanmaz, hep katılınabilir bir lobi vardır
	do
		local last, repeats, gaps, made = nil, 0, 0, 0
		local seen = {}
		table.clear(created)
		for _ = 1, 400 do
			clock += 3
			hub1:refresh()
			hub2:refresh()
			if #hub1:view() == 0 then
				gaps += 1
			end
		end
		for _, map in created do
			made += 1
			seen[map] = true
			if map == last then
				repeats += 1
			end
			last = map
		end
		local kinds = 0
		for _ in seen do
			kinds += 1
		end
		expect(gaps == 0, "20 dakika boyunca her an katılınabilir bir maç var (" .. gaps .. " kez yok)")
		expect(repeats == 0 and made > 3, "ardışık maçlarda harita hiç tekrarlanmaz (" .. made .. " maç, " .. repeats .. " tekrar)")
		expect(kinds >= 4, "farklı haritalar gelir (" .. kinds .. " çeşit)")
		local stale = 0
		for _, v in store.list() do
			if v.status == "open" and v.starts < clock - LobbyDirectory.STALE_AFTER_S then
				stale += 1
			end
		end
		expect(stale == 0, "kimsenin katılmadığı eski lobiler silinir")
	end

	-- iki sunucudan 70 kişi aynı anda: hiçbir lobi sınırını aşmaz, sığmayanlar NO_ROOM alır
	do
		clock += 1
		hub1:refresh()
		hub2:refresh()
		local room_total = 0
		for _, v in hub1:view() do
			room_total += v.max - v.players
		end
		local okn, room = 0, 0
		for i = 1, 70 do
			local h = if i % 2 == 0 then hub1 else hub2
			local o, why = h:join({ "bulk" .. i })
			if o then
				okn += 1
			elseif why == LobbyDirectory.NO_ROOM then
				room += 1
			end
		end
		local over = false
		for _, v in store.list() do
			if v.players > v.max then
				over = true
			end
		end
		expect(not over, "hiçbir lobide sınırdan fazla oyuncu yok")
		expect(okn == math.min(70, room_total) and room == 70 - okn, string.format("%d kişi oturdu, %d kişi 'yer yok' aldı (açık maçlarda toplam %d yer)", okn, room, room_total))
		-- tüm açık maçlar dolduğunda gelen "yer yok" alır
		local extra = 0
		for _, v in store.list() do
			if v.status == "open" and v.starts > clock + LobbyRules.JOIN_CLOSE_S then
				local r = LobbyRules.decode(v)
				r.players = r.max
				store.put(r, 900)
			end
		end
		hub1:refresh()
		local _, why = hub1:join({ "late" })
		expect(why == LobbyDirectory.NO_ROOM or why == nil, "her maç doluyken gelen 'yer yok' alır ya da yeni açılan maça oturur: " .. tostring(why))
	end

	-- sıra: yer yokken bekler, yeni maç açılınca oturur; süre aşılınca çıkarılır
	do
		local results = {}
		local function entry(k, alive)
			return {
				key = k,
				since = clock,
				members = function()
					return if alive() then { k } else nil
				end,
				done = function(o, why)
					results[k] = if o then "seated" else why
				end,
			}
		end
		local here = true
		hub1:enqueue(entry("q1", function()
			return true
		end))
		hub1:enqueue(entry("q2", function()
			return here
		end))
		expect(hub1:queue_size() == 2, "iki oyuncu sırada")
		-- yeni maç açılana kadar zaman ilerler
		clock += LobbyRules.LOBBY_INTERVAL_S
		hub1:refresh()
		here = false
		hub1:serve_queue()
		expect(results.q1 == "seated" and results.q2 == "gone" and hub1:queue_size() == 0, "açılan maça sıradaki oturur, oyundan çıkan sıradan düşer")
		hub1:enqueue(entry("q3", function()
			return true
		end))
		clock += LobbyDirectory.QUEUE_MAX_S + 1
		hub1:serve_queue()
		expect(results.q3 == "timeout", "çok uzun bekleyen sıradan çıkar ve haber verilir")
		expect(hub1:dequeue("none") == false, "sırada olmayanı çıkarmak sorun çıkarmaz")
	end

	-- kilidi alamayan sunucu her tazelemede değil, 8-16 sn sonra yeniden ister
	do
		local asks = 0
		local held = true
		local s3 = setmetatable({}, { __index = LobbyStore.localstore(tnow) })
		s3.list = function()
			return {}
		end
		s3.lock = function()
			asks += 1
			return not held
		end
		local hub3 = LobbyDirectory.new({
			store = s3,
			teleport = { reserve = function()
				return "c", "p"
			end, send = function()
				return true
			end },
			maps = maps,
			now = tnow,
			rand = function()
				return 0.5
			end,
			new_id = function()
				return "x"
			end,
		})
		for _ = 1, 4 do
			hub3:refresh()
			clock += 3
		end
		expect(asks == 1, "kilit 12 sn içinde yalnız bir kez istenir (" .. asks .. ")")
		clock += 1
		hub3:refresh()
		expect(asks == 2, "bekleme bitince yeniden istenir")
	end

	return { passed = passed, failed = failed, lines = lines }
end

return DirectoryTests
]]></ProtectedString>
						<string name="ScriptGuid">{E757385E-5C2C-48D1-902E-3A51BFF63D28}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">DirectoryTests</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">1c14f2467dd4fbf50afa546d0000f412</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXF2A0832F66D14F15B64C3C24A77D67FF">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- MatchHostTests: maç sunucusunun lobi tarafı (RoWorld tests/lobbies.luau'daki MatchHost testlerinden uyarlandı, AGPL-3.0,
-- © 2026 Snick Co.). Oyunda çalışmaz; Studio'da elle:
-- require(game.ServerScriptService.Server.Dev.MatchHostTests).run()  -> { passed, failed, lines }

local Lobbies = script.Parent.Parent.Lobbies
local LobbyRules = require(Lobbies.LobbyRules)
local LobbyStore = require(Lobbies.LobbyStore)
local LobbyDirectory = require(Lobbies.LobbyDirectory)
local MatchHost = require(Lobbies.MatchHost)
local Catalog = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Maps"):WaitForChild("Catalog"))

local MatchHostTests = {}

function MatchHostTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end

	local clock = 5000
	local function tnow()
		return clock
	end
	local store = LobbyStore.localstore(tnow)
	local reserved = 0
	local ids = 0
	local hub = LobbyDirectory.new({
		store = store,
		teleport = {
			reserve = function()
				reserved += 1
				return "code" .. reserved, "psid" .. reserved
			end,
			send = function()
				return true
			end,
		},
		maps = function()
			local out = {}
			for _, id in Catalog.order do
				table.insert(out, { id = id, name = Catalog[id].name, max = Catalog[id].onlineMax })
			end
			return out
		end,
		now = tnow,
		rand = function()
			return 0.3
		end,
		new_id = function()
			ids += 1
			return "L" .. ids
		end,
		wait = function() end,
	})
	hub:refresh()
	local first = hub:view()[1]
	local rec = store.get(first.id)
	local back = {}
	local function new_host(psid)
		return MatchHost.new({
			store = store,
			psid = psid,
			now = tnow,
			to_hub = function(players)
				for _, p in players do
					table.insert(back, p)
				end
				return true
			end,
		})
	end

	-- kayıt bulunamazsa nil; bulunursa harita ve sınır
	local lost = new_host("nope")
	expect(not lost:lookup() and lost:starts_in() == nil, "başka sunucunun kaydı yok: lobi bilinmez, geri sayım yok")
	local host = new_host(rec.psid)
	expect(host:lookup() and host.lobby.id == first.id, "maç sunucusu lobisini PrivateServerId ile bulur")
	expect(host.lobby.map == first.map and host.lobby.max == Catalog[first.map].onlineMax, "lobinin haritası ve sınırı (" .. first.map .. " " .. host.lobby.max .. ")")

	-- iki koltuk alınır; biri gelir, biri hiç gelmez
	expect(hub:join({ "u1" }) and hub:join({ "u2" }), "iki oyuncu koltuk alır")
	expect(store.get(first.id).players == 2, "kayıtta 2 oyuncu")
	host:set_present(1)
	host:set_roster({ "u1" })
	host:_sync()
	expect(store.get(first.id).players == 2, "yolda olanın koltuğu hemen geri verilmez")
	clock += LobbyRules.ARRIVE_S
	host:_sync()
	expect(store.get(first.id).players == 1 and host.released == 1, "ARRIVE_S içinde gelmeyenin koltuğu geri verilir")
	-- gelen ayrılır
	host:set_present(0)
	host:set_roster({})
	host:_sync()
	expect(store.get(first.id).players == 0, "bekleme odasından ayrılanın koltuğu geri verilir")
	-- yeniden gelir: kayıt buradakilerden az olamaz
	host:set_present(1)
	host:set_roster({ "u1" })
	host:_sync()
	expect(store.get(first.id).players >= 1, "buradaki insanlar kayıtta sayılır")

	-- geri sayım
	local wait = host:starts_in()
	expect(wait ~= nil and wait > 0 and wait <= rec.starts - clock, "başlamaya geri sayar (" .. tostring(wait) .. " sn)")
	clock = rec.starts + 1
	expect(host:starts_in() == 0, "başlama zamanı geldi")

	-- ilk gelen geç gelse de istemcisi açılsın diye kısa bekleme
	do
		local h2 = new_host(rec.psid)
		h2:lookup()
		h2:set_present(1)
		expect(h2:starts_in() == MatchHost.MIN_WAIT_AFTER_FIRST_S, "son anda gelen ilk oyuncu için " .. MatchHost.MIN_WAIT_AFTER_FIRST_S .. " sn beklenir")
	end

	-- yanlış saatle çok ileriye yazılmış kayıt: MAX_AHEAD_S'den fazla beklenmez
	do
		local far = table.clone(rec)
		far.id = "FAR"
		far.psid = "psid-far"
		far.starts = clock + 100000
		store.put(far, 900)
		store.bind_psid("psid-far", "FAR", 900)
		local h3 = new_host("psid-far")
		h3:lookup()
		expect(h3:starts_in() <= LobbyRules.MAX_AHEAD_S, "saati ileri bir kayıtta en çok " .. LobbyRules.MAX_AHEAD_S .. " sn beklenir")
		store.remove("FAR")
	end

	-- başlayınca katılım listesinden çıkar, sıradaki lobi açılır
	host:start(1)
	expect(store.get(first.id).status == "started" and host.started, "başlayan lobi 'started'")
	hub:refresh()
	local listed = false
	for _, v in hub:view() do
		if v.id == first.id then
			listed = true
		end
	end
	expect(not listed and #hub:view() >= 1, "başlamış lobi listelenmez, yerine yenisi var")
	local ok_late = hub:join({ "late" }, { id = first.id })
	expect(not ok_late, "başlamış maça katılınamaz")

	-- maç sürerken kayıt tazelenir
	clock += 10
	host:_beat()
	expect(store.get(first.id).beat == clock, "maç sürerken kayıt tazelenir")

	-- bitiş: kayıt silinir, herkes geri döner
	host:finish()
	expect(store.get(first.id) == nil and host.finished, "maç bitince kayıt silinir")
	local ok_back = host:return_to_hub({ "u1" })
	expect(ok_back and #back == 1 and back[1] == "u1", "maçtan sonra herkes normal sunucuya")
	expect(host:return_to_hub({}), "kimse yoksa geri dönüş sorunsuz")

	-- tick: kayıt bulunana dek arar, sonra eşitler (depo hatası tick'i bozmaz)
	do
		local broken = setmetatable({}, { __index = store })
		broken.lobby_for_psid = function()
			error("MemoryStoreService: Request was throttled")
		end
		local h4 = MatchHost.new({ store = broken, psid = "x", now = tnow, to_hub = function()
			return true
		end })
		h4:tick(MatchHost.LOOKUP_RETRY_S)
		expect(h4.lobby == nil and not h4._busy, "depo hatasında tick düşmez, sonra yeniden dener")
	end

	return { passed = passed, failed = failed, lines = lines }
end

return MatchHostTests
]]></ProtectedString>
						<string name="ScriptGuid">{D5129641-FEFF-4DD5-9CC7-EBF454697A96}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">MatchHostTests</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">1c14f2467dd4fbf50afa546d000102b8</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXEB73D3821CD2494481FD6B80492F01B8">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- SoakTest: online maç yük testi. Studio'da (Play çalışırken, sunucu tarafında) gerçek MatchServer + Match ile bir online maç
-- açar ve içine sahte oyuncular sokar. Sahte oyuncu Roblox hesabı ya da bağlantı değildir: sunucunun bellekte tuttuğu bir
-- kayıttır; niyetlerini (spawn, saldırı, yapı, gemi, bomba, ittifak) istemciden gelenle aynı yoldan gönderir, ara sıra çıkıp
-- yeniden girer. Maç bitince sıradaki harita açılır. Her REPORT_S'de tick hızı, en uzun kare, bellek, gönderilen veri ve
-- hatalar yazılır (Output'ta "[Soak]"; _G.FrontlineSoak). Oyunda çalışmaz; Studio'da elle:
-- require(game.ServerScriptService.Server.Dev.SoakTest).start({ players = 50, minutes = 30 })
-- Takım maçı: { teams = 2..4 } (sahte oyuncuların bir kısmı 2-3 kişilik partilerle gelir: aynı takıma düşmeleri denetlenir).

local LogService = game:GetService("LogService")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local Server = script.Parent.Parent
local LobbyStore = require(Server.Lobbies.LobbyStore)
local MatchServer = require(Server.MatchServer)
local Catalog = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Maps"):WaitForChild("Catalog"))

local SoakTest = {}

SoakTest.REPORT_S = 30
--- Bir sahte oyuncu bu aralıkta (sn) bir niyet gönderir.
SoakTest.THINK_S = { 0.5, 2.0 }
--- Bu aralıkla bir sahte oyuncu çıkar; bir sonrakinde çıkan geri girer.
SoakTest.CHURN_S = 20

local BUILDS = { "city", "city", "port", "factory", "post", "silo", "sam" }

-- Bir sahte oyuncunun bir kararı (gerçek oyuncunun yapabildikleri; sunucu her niyeti kendisi doğrular).
local function act(m: any, sim: any, world: any, f: any, all: { any }, rng: Random, nb: { number })
	local pid = m.pidOf(f)
	if not pid or not sim.alive[pid] then
		return
	end
	if sim.phase == "spawn" then
		if not sim.spawned[pid] then
			for _ = 1, 30 do
				local t = rng:NextInteger(0, world.size - 1)
				if world:isLand(t) and world:ownerAt(t) == 0 then
					m.intent(f, { type = "spawn", tile = t })
					break
				end
			end
		end
		return
	end
	if sim.phase ~= "run" then
		return
	end
	local border = world:orderedBorderOf(pid)
	local b = -1
	if #border > 0 then
		for _ = 1, 8 do
			b = border[rng:NextInteger(1, #border)]
			if b ~= -1 then
				break
			end
		end
	end
	if b == -1 then
		return
	end
	local roll = rng:NextNumber()
	if roll < 0.7 then
		-- sınırın öte yanına (komşu ya da sahipsiz kara) saldırı
		local k = world:neighbors(b, nb)
		for _ = 1, k do
			local u = nb[rng:NextInteger(1, k)]
			if world:isLand(u) and world:ownerAt(u) ~= pid then
				m.intent(f, { type = "attack", target = world:ownerAt(u), ratio = rng:NextNumber(0.15, 0.5), tile = u })
				return
			end
		end
	elseif roll < 0.83 then
		m.intent(f, { type = "build", what = BUILDS[rng:NextInteger(1, #BUILDS)], tile = b })
	elseif roll < 0.86 then
		m.intent(f, { type = "upgrade", what = "city", tile = b })
	elseif roll < 0.91 then
		-- gemi: rastgele bir kara tile'ına çıkarma ya da sudan savaş gemisi
		local t = rng:NextInteger(0, world.size - 1)
		if world:isLand(t) then
			m.intent(f, { type = "boat", tile = t, ratio = 0.3 })
		else
			m.intent(f, { type = "warship", tile = t })
		end
	elseif roll < 0.93 then
		local t = rng:NextInteger(0, world.size - 1)
		if world:isLand(t) and world:ownerAt(t) ~= pid then
			m.intent(f, { type = "nuke", what = if rng:NextNumber() < 0.9 then "atom" else "hydro", tile = t })
		end
	elseif roll < 0.97 then
		-- ittifak: gelen istekleri kabul et, başka bir sahte oyuncuya istek gönder
		for _, r in sim.dip.requests do
			if r.to == pid then
				m.intent(f, { type = "allyAccept", target = r.from })
				return
			end
		end
		local other = m.pidOf(all[rng:NextInteger(1, #all)])
		if other and other ~= pid and sim.alive[other] then
			m.intent(f, { type = "ally", target = other })
		end
	else
		-- bağış / iptal (nadir)
		m.intent(f, { type = "cancel", target = 0 })
	end
end

-- Bir maç: kayıt, maç sunucusu, sahte oyuncular; maç kapanınca döner.
local function runMatch(mapId: string, n: number, stopAt: number, log: (string) -> (), report: any, teams: number?)
	local now = os.time
	local store = LobbyStore.localstore(now)
	local id = "soak-" .. mapId .. "-" .. math.floor(os.clock())
	local t0 = now()
	store.put({ id = id, map = mapId, map_name = Catalog[mapId].name, max = n, starts = t0 + 3, created = t0, players = 0, status = "open", code = "soak", psid = id, mode = if teams then "team" else nil, teams = teams }, 7200)
	store.bind_psid(id, id, 7200)
	local srv: any = nil
	srv = MatchServer.start({
		store = store,
		psid = id,
		now = now,
		cleanup = true,
		log = log,
		to_hub = function(list: { any }): (boolean, string?)
			for _, p in list do
				srv.leave(p)
			end
			return true, nil
		end,
	})
	local fakes = {}
	local present = {}
	local joinData = {} -- (takım maçı: ilk oyuncular 3'erli partilerle gelir)
	for i = 1, n do
		local f = { Name = "Soak" .. i, DisplayName = "Soak" .. i, UserId = -100 - i }
		fakes[i] = f
		present[f] = true
		if teams and i <= 12 then
			joinData[f] = { party = { key = "soakparty" .. ((i - 1) // 3), leader = -100 - ((i - 1) // 3) * 3 - 1 } }
		end
		srv.arrive(f, joinData[f] or {})
	end
	log(string.format("match on %s with %d test players%s", mapId, n, if teams then ", " .. teams .. " teams" else ""))
	local partyChecked = false

	local rng = Random.new()
	local nb = {}
	local nextAt = {}
	local churnAt = os.clock() + SoakTest.CHURN_S
	-- ölçüm: kare süreleri, tick hızı
	local frames, worstDt = 0, 0
	local hb = RunService.Heartbeat:Connect(function(dt: number)
		frames += 1
		worstDt = math.max(worstDt, dt)
	end)
	local reportAt = os.clock() + SoakTest.REPORT_S
	local lastTick, lastAt = 0, os.clock()
	local startedAt = os.clock()
	while not srv.done do
		local t = os.clock()
		if t > stopAt then
			log("time is up")
			srv.shutdown()
			break
		end
		local m = srv.match()
		if m and srv.phase() == "playing" then
			local sim = m.sim
			local world = sim.world
			if teams and not partyChecked and sim.phase == "run" then
				-- partiler aynı takımda mı, takımlar dengeli mi
				partyChecked = true
				local split = 0
				for g = 0, 3 do
					local t0 = nil
					for i = g * 3 + 1, g * 3 + 3 do
						local pid = m.pidOf(fakes[i])
						local t = pid and sim.team[pid]
						if t then
							t0 = t0 or t
							if t ~= t0 then
								split += 1
							end
						end
					end
				end
				local per = {}
				for _, f in fakes do
					local pid = m.pidOf(f)
					local t = pid and sim.team[pid] or 0
					per[t] = (per[t] or 0) + 1
				end
				local parts = {}
				for t = 0, teams do
					table.insert(parts, string.format("%d:%d", t, per[t] or 0))
				end
				report.partySplit = split
				log(string.format("teams check: %d party members on another team; humans per team %s", split, table.concat(parts, " ")))
			end
			for _, f in fakes do
				if present[f] and t >= (nextAt[f] or 0) then
					nextAt[f] = t + rng:NextNumber(SoakTest.THINK_S[1], SoakTest.THINK_S[2])
					local ok, err = pcall(act, m, sim, world, f, fakes, rng, nb)
					if not ok then
						log("test player error: " .. tostring(err))
					end
				end
			end
			if t >= churnAt then
				churnAt = t + SoakTest.CHURN_S
				local away = nil
				for _, g in fakes do
					if not present[g] then
						away = g
						break
					end
				end
				if away then
					srv.arrive(away, joinData[away] or {}) -- (maç sürerken giren izler)
					present[away] = true
				else
					local f = fakes[rng:NextInteger(1, n)]
					srv.leave(f)
					present[f] = false
				end
			end
		end
		if t >= reportAt then
			reportAt = t + SoakTest.REPORT_S
			local sim = m and m.sim
			local tick = if sim then sim.tickNo else 0
			local tps = (tick - lastTick) / (t - lastAt)
			lastTick, lastAt = tick, t
			local alive, here = 0, 0
			for _, f in fakes do
				if present[f] then
					here += 1
					local pid = m and m.pidOf(f)
					if pid and sim.alive[pid] then
						alive += 1
					end
				end
			end
			local mem = Stats:GetTotalMemoryUsageMb()
			local lua = Stats:GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.LuaHeap)
			local send = Stats.DataSendKbps
			local fps = frames / SoakTest.REPORT_S
			local row = {
				map = mapId,
				min = (t - startedAt) / 60,
				phase = if sim then sim.phase else srv.phase(),
				tps = tps,
				worst = worstDt * 1000,
				fps = fps,
				mem = mem,
				lua = lua,
				send = send,
				here = here,
				alive = alive,
				players = if sim then sim.playerCount else 0,
				execs = if sim then sim.executionCount else 0,
				structs = if sim then #sim.structList else 0,
			}
			table.insert(report.rows, row)
			log(string.format(
				"%s %.1fmin %s ticks/s %.1f | worst frame %.0fms, %.0f fps | mem %.0fMB (lua %.0fMB) | send %.1f KB/s | test players %d here, %d alive | ids %d, executions %d, structures %d | errors %d",
				mapId, row.min, row.phase, tps, row.worst, fps, mem, lua, send, here, alive, row.players, row.execs, row.structs, report.errors
			))
			frames, worstDt = 0, 0
		end
		task.wait(0.1)
	end
	hb:Disconnect()
	while not srv.done do
		task.wait(0.5)
	end
	log(string.format("match on %s closed after %.1f min", mapId, (os.clock() - startedAt) / 60))
end

function SoakTest.start(opts: { [string]: any }?)
	local o = opts or {}
	local n = o.players or 50
	local minutes = o.minutes or 30
	local maps = o.maps or { "asia", "world", "europe" }
	local report = { rows = {}, lines = {}, errors = 0, running = true }
	_G.FrontlineSoak = report
	local function log(s: string)
		print("[Soak] " .. s)
		table.insert(report.lines, s)
	end
	local errConn = LogService.MessageOut:Connect(function(msg: string, kind: Enum.MessageType)
		if kind == Enum.MessageType.MessageError or (kind == Enum.MessageType.MessageWarning and string.find(msg, "error", 1, true)) then
			report.errors += 1
			if report.errors <= 20 then
				table.insert(report.lines, "ERR " .. string.sub(msg, 1, 300))
			end
		end
	end)
	task.spawn(function()
		local stopAt = os.clock() + minutes * 60
		local round = 0
		while os.clock() < stopAt do
			round += 1
			local ok, err = pcall(runMatch, maps[(round - 1) % #maps + 1], n, stopAt, log, report, o.teams)
			if not ok then
				log("match failed: " .. tostring(err))
				break
			end
		end
		errConn:Disconnect()
		report.running = false
		log("done")
	end)
	return report
end

return SoakTest
]]></ProtectedString>
