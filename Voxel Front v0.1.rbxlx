						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Nuke: atom / hidrojen bombası + SAM önleme (OpenFront NukeExecution, SAMLauncherExecution, MissileSiloExecution kuralları).
--   * Fırlatma: en yakın hazır silodan (yapım bitmiş, boş füze yuvası var). Atom 750K, hidrojen 5M. Silo füzeyi koyunca yuva 90 tick doluyor;
--     silonun seviyesi = yuva sayısı (seviye yükseltmek aynı anda daha çok füze demek).
--   * Hedef: kendi / müttefik toprağı dahil; müttefiki vurmak ittifakı bozabilir.
--   * Uçuş: 10 tile/tick (eğri boyunca). Yol repodaki gibi kübik Bézier yayı: kontrol noktaları kaynağın 1/4 ve 3/4'ünde, ekranda
--     yukarı doğru max(mesafe/3, 50) tile yüksekte (harita sınırına kırpılır). Yalnızca hedefe ya da siloya 150 tile içindeki
--     bölümde SAM tarafından vurulabilir.
--   * Fırlatınca: etkilenen müttefikler (ağırlıklı tile > 100: iç 1, dış 0.5; ya da bir yapısı vurulacaksa) ittifakı bozar (fırlatan hain olur).
--   * Patlama: repo gibi merkezden bağlı yayılım; iç yarıçap kesin, dışta her komşu denemesi %50.
--     Sahipli tile sahipsiz olur, vurulan kara tile'ına serpinti konur (waterNukes=false).
--     Etkilenen oyuncunun askeri (saldırıdaki ve gemideki dahil) her vurulan tile için 5 x asker / kalan tile kadar azalır.
--     Dış yarıçap içindeki tüm yapılar ve gemiler (fırlatanın ve müttefiklerinin dışındakiler) yok olur.
--     Atom: iç 12 / dış 30. Hidrojen: iç 80 / dış 100.
--   * SAM: menzil = 150 - 480/(seviye+5) (seviye 1 = 70); yükseltme sırasında menzil 45 tickte yavaşça artar. Seviye kadar eş zamanlı füze,
--     her füze 90 tick doluyor. Düşman bombasını yolu menzile girerse kesin önler (füze 12 tile/tick, bomba 10). Önce hidrojen, sonra hedefe yakın olan.

local Nuke = {}
Nuke.__index = Nuke

export type Nuke = typeof(setmetatable(
	{} :: {
		kind: string,
		id: number,
		pid: number,
		what: string,
		tile: number,
		src: number,
		total: number,
		pts: { number },
		age: number,
		done: boolean,
		targeted: boolean,
		hitAt: number,
		samPid: number,
		perTick: number, -- pts / tick (hız / SPACING)
		wait: number, -- (savaş başlığı) uçmadan önce bekleme tick'i
		warhead: boolean, -- MIRV savaş başlığı: istemciye tek tek yollanmaz, ittifak bozmaz
		target: number, -- (MIRV) hedef oyuncu
		untargetable: boolean, -- (MIRV gövdesi) SAM vuramaz (repo)
		blast: { number }?, -- fırlatmada hesaplanan, merkezden bağlı patlama alanı
	},
	Nuke
))

local nextId = 300000
local SPACING = 2 -- pts örnekleme aralığı (tile)
local PER_TICK = 5 -- 10 tile/tick / SPACING

local function validTile(size: number, tile: any): boolean
	return type(tile) == "number" and tile == tile and tile >= 0 and tile < size and tile % 1 == 0
end

local function pushFx(sim: any, kind: string, tile: number, r: number, nuke: any?)
	local l = sim.fx
	if not l then
		l = {}
		sim.fx = l
	end
	if nuke then
		-- kalkış: istemci yayı bir kez alır, bombayı ve izi kendisi o yay üzerinde ilerletir
		table.insert(l, { k = kind, tile = tile, r = r, id = nuke.id, pid = nuke.pid, w = nuke.what, pts = nuke.pts, rate = nuke.perTick * 10 })
	else
		table.insert(l, { k = kind, tile = tile, r = r })
	end
end

function Nuke.new(pid: number, what: string, tile: any): Nuke
	nextId += 1
	return setmetatable({
		kind = "nuke",
		id = nextId,
		pid = pid,
		what = what,
		tile = tile,
		src = 0,
		total = 1,
		pts = {},
		age = 0,
		done = false,
		targeted = false,
		hitAt = -1,
		samPid = 0,
		perTick = PER_TICK,
		wait = 0,
		warhead = false,
		target = 0,
		untargetable = false,
		blast = nil,
	}, Nuke)
end

-- Yapı seviyesi/zamanından SAM menzili.
function Nuke.samRange(cfg: any, st: any, tick: number): number
	local target = cfg.SAM_MAX_RANGE - 480 / (st.level + 5)
	local el = tick - st.upTick
	if el >= cfg.SAM_UPGRADE_TICKS then
		return target
	end
	return st.upFrom + (target - st.upFrom) * el / cfg.SAM_UPGRADE_TICKS
end

function Nuke.magnitude(cfg: any, what: string): (number, number)
	local m = if what == "hydro" then cfg.NUKE_HYDRO elseif what == "warhead" then cfg.NUKE_WARHEAD else cfg.NUKE_ATOM
	return m[1], m[2]
end

-- Repo NukeExecution.tilesToDestroy (waterNukes=false) + GameMap.bfs.
-- Yalnız kabul edilen hücreler üzerinden yayılır. Reddedilen komşu başka
-- yönden yeniden denenebilir; tüm halkada bağımsız delik açmak aynı şey değildir.
function Nuke.blastTiles(world: any, cfg: any, what: string, center: number, rng: any): { number }
	local inner, outer = Nuke.magnitude(cfg, what)
	local inner2, outer2 = inner * inner, outer * outer
	local w, cx, cy = world.width, center % world.width, center // world.width
	local seen, result, stack, nb = {}, {}, {}, {}
	local function visit(t: number)
		if seen[t] then return end
		local d2 = (t % w - cx) ^ 2 + (t // w - cy) ^ 2
		if d2 > outer2 or (d2 > inner2 and rng:int(0, 1) ~= 0) then return end
		seen[t] = true; result[#result + 1] = t; stack[#stack + 1] = t
	end
	visit(center)
	while #stack > 0 do
		local t = table.remove(stack)
		local n = world:neighbors(t, nb)
		for i = 1, n do visit(nb[i]) end
	end
	return result
end

-- Şu anki MIRV fiyatı (repo: 25M + her fırlatılan MIRV için 15M; tüm oyunda ortak sayaç).
function Nuke.mirvCost(sim: any): number
	return sim.cfg.MIRV_COST_BASE + sim.cfg.MIRV_COST_STEP * (sim.mirvsLaunched or 0)
end

function Nuke.position(self: Nuke): number
	return Nuke.positionAt(self, self.age)
end

-- age. tickteki konum (yay üzerinde 10 x age tile ilerlemiş nokta). pts 2 tile aralıklı örneklerdir.
function Nuke.positionAt(self: Nuke, age: number): number
	local pts = self.pts
	local i = math.min(#pts, math.floor(math.max(0, age - self.wait) * self.perTick) + 1)
	return pts[i]
end

local function dist(w: number, a: number, b: number): number
	local dx, dy = a % w - b % w, a // w - b // w
	return math.sqrt(dx * dx + dy * dy)
end

-- Bézier yayı: 2 tile aralıklı tile listesi ve uçuş süresi (tick).
local function buildPath(world: any, src: number, dst: number, speed: number, coarse: boolean?): ({ number }, number)
	local w, h = world.width, world.height
	local x0, y0, x3, y3 = src % w, src // w, dst % w, dst // w
	local dx, dy = x3 - x0, y3 - y0
	local d = math.sqrt(dx * dx + dy * dy)
	local H = math.max(d / 3, 50)
	local x1, y1 = x0 + dx / 4, math.clamp(y0 + dy / 4 - H, 0, h - 1)
	local x2, y2 = x0 + dx * 3 / 4, math.clamp(y0 + dy * 3 / 4 - H, 0, h - 1)
	local n = if coarse then math.max(24, math.ceil(d * 1.2)) else math.max(64, math.ceil(d * 6))
	local xs, ys, cum = { x0 }, { y0 }, { 0 }
	for i = 1, n do
		local t = i / n
		local u = 1 - t
		local a, b, c, e = u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t
		local x, y = a * x0 + b * x1 + c * x2 + e * x3, a * y0 + b * y1 + c * y2 + e * y3
		xs[i + 1], ys[i + 1] = x, y
		cum[i + 1] = cum[i] + math.sqrt((x - xs[i]) ^ 2 + (y - ys[i]) ^ 2)
	end
	local len = cum[n + 1]
	local pts: { number } = {}
	local j = 1
	local count = math.floor(len / SPACING)
	for k = 0, count do
		local s = k * SPACING
		while j < n and cum[j + 1] < s do
			j += 1
		end
		local seg = cum[j + 1] - cum[j]
		local f = if seg > 0 then (s - cum[j]) / seg else 0
		local x = math.clamp(math.floor(xs[j] + (xs[j + 1] - xs[j]) * f), 0, w - 1)
		local y = math.clamp(math.floor(ys[j] + (ys[j + 1] - ys[j]) * f), 0, h - 1)
		pts[#pts + 1] = y * w + x
	end
	pts[#pts + 1] = dst
	return pts, math.max(1, math.ceil(len / speed))
end

-- Başlatma ----------------------------------------------------------------------

local function readySilo(sim: any, pid: number, tile: number): any?
	local w = sim.world.width
	local best, bestD = nil, math.huge
	for _, st in sim.structList do
		if st.pid == pid and st.type == "silo" and st.ready and #st.queue < st.level then
			local d = math.abs(st.tile % w - tile % w) + math.abs(st.tile // w - tile // w)
			if d < bestD then
				best, bestD = st, d
			end
		end
	end
	return best
end
Nuke.readySilo = readySilo

-- İttifak bozma: fırlatılırken etkilenecek müttefikler.
local function breakAllies(self: Nuke, sim: any)
	local D = sim.parts.Diplomacy
	local allies = D.alliesOf(sim, self.pid)
	if #allies == 0 then
		return
	end
	local world, cfg = sim.world, sim.cfg
	local w = world.width
	local inner, outer = Nuke.magnitude(cfg, self.what)
	local cx, cy = self.tile % w, self.tile // w
	local isAlly: { [number]: boolean } = {}
	for _, a in allies do
		isAlly[a] = true
	end
	local counts: { [number]: number } = {}
	local hit: { [number]: boolean } = {}
	for y = math.max(0, cy - outer), math.min(world.height - 1, cy + outer) do
		for x = math.max(0, cx - outer), math.min(w - 1, cx + outer) do
			local d2 = (x - cx) ^ 2 + (y - cy) ^ 2
			if d2 <= outer * outer then
				local o = world:ownerAt(y * w + x)
				if o ~= 0 and isAlly[o] then
					counts[o] = (counts[o] or 0) + (if d2 <= inner * inner then 1 else 0.5)
					if counts[o] > cfg.NUKE_ALLIANCE_THRESHOLD then
						hit[o] = true
					end
				end
			end
		end
	end
	for _, st in sim.structList do
		if isAlly[st.pid] and (st.tile % w - cx) ^ 2 + (st.tile // w - cy) ^ 2 <= outer * outer then
			hit[st.pid] = true
		end
	end
	for a in hit do
		D.breakAlliance(sim, self.pid, a)
	end
end

function Nuke.init(self: Nuke, sim: any)
	if self.warhead then
		-- MIRV savaş başlığı: ayrılmada hazır kuruldu (fiyat, silo, ittifak kontrolü yok)
		self.done = false
		return
	end
	self.done = true
	local world, cfg, pid = sim.world, sim.cfg, self.pid
	if self.what ~= "atom" and self.what ~= "hydro" and self.what ~= "mirv" then
		sim:emit(pid, "badTarget")
		return
	end
	if not validTile(world.size, self.tile) then
		sim:emit(pid, "badTile")
		return
	end
	if sim.phase ~= "run" then
		sim:emit(pid, "notStarted")
		return
	end
	if not sim.spawned[pid] then
		sim:emit(pid, "notSpawned")
		return
	end
	-- Repo PlayerImpl.nukeSpawn: kendi toprağına da müttefike de atılabilir, yalnız takım arkadaşının toprağına atılamaz.
	-- Müttefikin toprağını eşikten fazla vurursa / yapısını vurursa ittifak bozulur (breakAllies).
	-- MIRV yalnız bir oyuncunun toprağına (repo: hasOwner).
	local target = world:ownerAt(self.tile)
	if self.what == "mirv" and target == 0 then
		sim:emit(pid, "badTarget")
		return
	end
	if target ~= 0 and sim.parts.Diplomacy.sameTeam(sim, pid, target) then
		sim:emit(pid, "teammate")
		return
	end
	local silo = readySilo(sim, pid, self.tile)
	if not silo then
		sim:emit(pid, "noSilo")
		return
	end
	local cost = if self.what == "hydro" then cfg.NUKE_COST_HYDRO elseif self.what == "mirv" then Nuke.mirvCost(sim) else cfg.NUKE_COST_ATOM
	if sim.gold[pid] < cost then
		sim:emit(pid, "noGold")
		return
	end
	sim.gold[pid] -= cost
	table.insert(silo.queue, sim.tickNo)
	self.src = silo.tile
	if self.what == "mirv" then
		-- repo MirvExecution: önce hedefin üstünde yükseğe (ayrılma noktası) gider, orada 350 savaş başlığına bölünür
		sim.mirvsLaunched = (sim.mirvsLaunched or 0) + 1
		self.target = target
		self.untargetable = true
		local w = world.width
		local bx, by = self.tile % w, self.tile // w
		local sx = math.floor((bx + silo.tile % w) / 2)
		local sy = math.max(0, by - 500) + 50
		self.sep = math.clamp(sy, 0, world.height - 1) * w + math.clamp(sx, 0, w - 1)
		self.perTick = cfg.MIRV_SPEED / SPACING
		self.pts, self.total = buildPath(world, silo.tile, self.sep, cfg.MIRV_SPEED)
		if target ~= 0 then
			-- ittifak bozulur, ilişki -100 (repo)
			local D = sim.parts.Diplomacy
			if D.isAllied(sim, pid, target) then
				D.breakAlliance(sim, pid, target)
			end
			D.updateRelation(sim, target, pid, -100)
			D.updateRelation(sim, pid, target, -100)
		end
	else
		self.pts, self.total = buildPath(world, silo.tile, self.tile, cfg.NUKE_SPEED)
	end
	self.done = false
	pushFx(sim, "launch", self.tile, 0, self)
	if self.what ~= "mirv" then
		self.blast = Nuke.blastTiles(world, cfg, self.what, self.tile, sim.parts.Rng.new(sim.tickNo))
		breakAllies(self, sim)
	end
	local owner = world:ownerAt(self.tile)
	if owner ~= 0 and owner ~= pid then
		sim:emit(owner, if self.what == "hydro" then "hydroInbound" elseif self.what == "mirv" then "mirvInbound" else "nukeInbound", pid)
	end
end

-- MIRV ayrılma: hedef oyuncunun toprağına en çok 350 başlık (aralarında en az 55 tile manhattan, merkezden 1500 tile
-- içinde; ilk hedef tıklanan nokta). Başlıklar ayrılma noktasından 22-26 tile/tick hızla, 0-15 tick rastgele bekleyip iner.
local function separate(self: Nuke, sim: any)
	local world, cfg = sim.world, sim.cfg
	local w, h = world.width, world.height
	local bx, by = self.tile % w, self.tile // w
	local R = cfg.MIRV_RANGE
	local spread = cfg.MIRV_SPREAD
	local targets: { number } = { self.tile }
	local tx: { number } = { bx }
	local ty: { number } = { by }
	local rng = sim.rng
	local tp = self.target
	-- hedef tile'ları: rastgele denemeler (repo tryGenerateTarget); ızgara hücreleriyle çakışma kontrolü hızlı
	local cell = spread
	local grid: { [number]: { number } } = {}
	local function gkey(x: number, y: number): number
		return (y // cell) * 100000 + (x // cell)
	end
	local function put(i: number)
		local k = gkey(tx[i], ty[i])
		local l = grid[k]
		if not l then
			l = {}
			grid[k] = l
		end
		table.insert(l, i)
	end
	put(1)
	local function overlaps(x: number, y: number): boolean
		local gx, gy = x // cell, y // cell
		for dy = -1, 1 do
			for dx = -1, 1 do
				local l = grid[(gy + dy) * 100000 + (gx + dx)]
				if l then
					for _, i in l do
						if math.abs(tx[i] - x) + math.abs(ty[i] - y) < spread then
							return true
						end
					end
				end
			end
		end
		return false
	end
	if tp ~= 0 then
		for _ = 1, cfg.MIRV_WARHEADS * 30 do
			if #targets >= cfg.MIRV_WARHEADS then
				break
			end
			local x = bx + rng:int(-R, R)
			local y = by + rng:int(-R, R)
			if x >= 0 and x < w and y >= 0 and y < h and (x - bx) ^ 2 + (y - by) ^ 2 <= R * R then
				local t = y * w + x
				if world:isLand(t) and world:ownerAt(t) == tp and not overlaps(x, y) then
					targets[#targets + 1] = t
					tx[#tx + 1], ty[#ty + 1] = x, y
					put(#targets)
				end
			end
		end
	end
	-- uzaktakiler önce (repo: merkezden uzaklığa göre sıralı, hız kademeleri)
	table.sort(targets, function(a: number, b: number): boolean
		return math.abs(a % w - bx) + math.abs(a // w - by) > math.abs(b % w - bx) + math.abs(b // w - by)
	end)
	local list = {}
	for i, t in targets do
		local speedOff = if i <= 70 then 0 elseif i <= 140 then 1 elseif i <= 210 then 2 elseif i <= 280 then 3 else 4
		local wh = Nuke.new(self.pid, "warhead", t)
		wh.warhead = true
		wh.src = self.sep
		wh.wait = rng:int(0, 15)
		local speed = cfg.WARHEAD_SPEED + speedOff
		wh.perTick = speed / SPACING
		wh.pts, wh.total = buildPath(world, self.sep, t, speed, true)
		wh.total += wh.wait
		wh.done = false
		sim:addExecution(wh)
		list[#list + 1] = { id = wh.id, t = t, n = wh.total - wh.wait, w = wh.wait }
	end
	-- istemciye tek olay: başlıkların yolunu istemci kendisi çizer
	local l = sim.fx
	if not l then
		l = {}
		sim.fx = l
	end
	table.insert(l, { k = "mirvSplit", pid = self.pid, src = self.sep, list = list })
	table.insert(l, { k = "end", id = self.id, tile = 0, r = 0 })
end

-- Patlama -----------------------------------------------------------------------

local function shrink(h: number, n: number, before: number, factor: number): number
	for i = 0, n - 1 do
		h -= factor * h / math.max(1, before - i)
		if h <= 0 then
			return 0
		end
	end
	return h
end

local function detonate(self: Nuke, sim: any)
	local world, cfg = sim.world, sim.cfg
	local w = world.width
	local inner, outer = Nuke.magnitude(cfg, self.what)
	local inner2, outer2 = inner * inner, outer * outer
	local cx, cy = self.tile % w, self.tile // w
	local hits: { [number]: number } = {}
	local D = sim.parts.Diplomacy
	-- (bildirim: dış yarıçaptaki düşman yapıları yıkılacak; sahibine "X destroyed your City")
	for _, st in sim.structList do
		if st.pid ~= self.pid and not D.isAllied(sim, self.pid, st.pid) and (st.tile % w - cx) ^ 2 + (st.tile // w - cy) ^ 2 < outer2 then
			sim:emit(st.pid, "structDestroyed", self.pid, st.type)
		end
	end
	local blast = self.blast or Nuke.blastTiles(world, cfg, self.what, self.tile, sim.parts.Rng.new(sim.tickNo))
	for _, t in blast do
		if world:isLand(t) then
			local o = world:ownerAt(t)
			if o ~= 0 then
				hits[o] = (hits[o] or 0) + 1
				world:setOwner(t, 0)
			end
			world:setFallout(t)
		end
	end

	-- asker kaybı
	for p, n in hits do
		local before = world:tilesOwnedBy(p) + n
		sim.troops[p] = shrink(sim.troops[p], n, before, cfg.NUKE_DEATH_FACTOR)
		for k = 1, sim.executionCount do
			local e = sim.executions[k]
			if e and not e.done and e.pid == p and (e.kind == "attack" or e.kind == "boat") and type(e.troops) == "number" then
				e.troops = shrink(e.troops, n, before, cfg.NUKE_DEATH_FACTOR)
			end
		end
		if not self.warhead then
			sim:emit(p, if self.what == "hydro" then "hydroHit" else "nukeHit")
		end
	end

	local function friendly(owner: number): boolean
		return owner == self.pid or D.isAllied(sim, self.pid, owner)
	end
	-- dış yarıçaptaki yapılar
	for _, st in table.clone(sim.structList) do
		if not friendly(st.pid) and (st.tile % w - cx) ^ 2 + (st.tile // w - cy) ^ 2 < outer2 then
			sim:removeStructure(st)
		end
	end
	-- dış yarıçaptaki gemiler
	for k = 1, sim.executionCount do
		local e = sim.executions[k]
		if e and not e.done and (e.kind == "boat" or e.kind == "trade" or e.kind == "warship") and not friendly(e.pid) then
			local p = e:position()
			if (p % w - cx) ^ 2 + (p // w - cy) ^ 2 < outer2 then
				e:finish(sim)
			end
		end
	end
	pushFx(sim, self.what, self.tile, outer)
	table.insert(sim.fx, { k = "end", id = self.id, tile = 0, r = 0 })
end

-- SAM'ın bombayı önleyebileceği ilk (uçuş içinde) an: döner = kaç tick sonra, yoksa nil.
local function interceptDelay(self: Nuke, sim: any, sam: any): number?
	local cfg, w = sim.cfg, sim.world.width
	local maxK = self.total - 1 - self.age
	for k = 0, maxK do
		local p = Nuke.positionAt(self, self.age + k)
		local targetable = dist(w, p, self.tile) < cfg.NUKE_TARGETABLE_RANGE or dist(w, p, self.src) < cfg.NUKE_TARGETABLE_RANGE
		if targetable then
			local d = dist(w, sam.tile, p)
			if d <= Nuke.samRange(cfg, sam, sim.tickNo + k) and k >= math.ceil(d / cfg.SAM_MISSILE_SPEED) then
				return k
			end
		end
	end
	return nil
end

-- Her tick: silo/SAM yuvalarını yeniler, SAM'lar kendilerine göre hedef alır.
function Nuke.step(sim: any)
	local cfg = sim.cfg
	local anyNuke = false
	local nukes: { any } = {}
	for k = 1, sim.executionCount do
		local e = sim.executions[k]
		if e and e.kind == "nuke" and not e.done then
			anyNuke = true
			if not e.targeted then
				table.insert(nukes, e)
			end
		end
	end
	for _, st in sim.structList do
		if (st.type == "silo" or st.type == "sam") and st.ready then
			local cd = if st.type == "silo" then cfg.SILO_COOLDOWN else cfg.SAM_COOLDOWN
			while #st.queue > 0 and sim.tickNo - st.queue[1] >= cd do
				table.remove(st.queue, 1)
			end
			if st.type == "sam" and anyNuke and #st.queue < st.level then
				local D = sim.parts.Diplomacy
				local cand: { any } = {}
				local reach = Nuke.samRange(cfg, st, sim.tickNo) + cfg.NUKE_TARGETABLE_RANGE
				local w = sim.world.width
				for _, n in nukes do
					-- çok uzaktaki bombalar hiç hesaplanmaz (MIRV'de yüzlerce başlık var)
					if not n.targeted and not n.untargetable and n.pid ~= st.pid and (dist(w, st.tile, n.tile) <= reach or dist(w, st.tile, n.src) <= reach) and not D.isAllied(sim, st.pid, n.pid) then
						table.insert(cand, n)
					end
				end
				table.sort(cand, function(a: any, b: any): boolean
					if (a.what == "hydro") ~= (b.what == "hydro") then
						return a.what == "hydro"
					end
					return dist(sim.world.width, st.tile, a.tile) < dist(sim.world.width, st.tile, b.tile)
				end)
				for _, n in cand do
					if #st.queue >= st.level then
						break
					end
					local delay = interceptDelay(n, sim, st)
					if delay then
						table.insert(st.queue, sim.tickNo)
						n.targeted = true
						n.hitAt = sim.tickNo + delay
						n.samPid = st.pid
						-- SAM füzesi görünür (repo SAMMissile): fırlatma gecikmesi sonrası önleme noktasına uçar
						local hitPos = Nuke.positionAt(n, n.age + delay)
						local flight = math.max(1, math.ceil(dist(sim.world.width, st.tile, hitPos) / cfg.SAM_MISSILE_SPEED))
						sim:pushFx({ k = "samShot", from = st.tile, to = hitPos, n = flight, wait = math.max(0, delay - flight), pid = st.pid })
					end
				end
			end
		end
	end
end

function Nuke.finish(self: Nuke, _sim: any)
	self.done = true
end

function Nuke.tick(self: Nuke, sim: any)
	if self.done then
		return
	end
	self.age += 1
	if self.targeted and sim.tickNo >= self.hitAt then
		self.done = true
		pushFx(sim, "sam", Nuke.position(self), 8)
		table.insert(sim.fx, { k = "end", id = self.id, tile = 0, r = 0 })
		sim:emit(self.samPid, "samHit")
		if not self.warhead then
			sim:emit(self.pid, "nukeDown")
		end
		return
	end
	if self.age >= self.total then
		self.done = true
		if self.what == "mirv" then
			separate(self, sim)
		else
			detonate(self, sim)
		end
	end
end

return Nuke
]]></ProtectedString>
							<string name="ScriptGuid">{D2664A37-B39B-4A12-A46B-6CDC4387686D}</string>
