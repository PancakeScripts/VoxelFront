					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Music: arka plan müziği. Kimlikler ReplicatedStorage > Shared > Assets içindeki Assets.Music'te: menu ve game için ikişer
-- parça. Parçalar sırayla çalar (1, 2, 1, 2 ...); yalnız biri doluysa o döngüyle çalar; ikisi de boşsa müzik yok. Her parça
-- her başladığında Assets.MusicStart'taki saniyeden başlar.
-- Music.set("menu" | "game"): o an çalan müzik FADE_S'de söner, yenisi FADE_S'de yükselir. Ses düzeyi parça başına
-- Assets.MusicVolume.
-- Music.setEnabled(menuOn, gameOn): ayarlardaki "Menu music" / "Game music" anahtarları; kapalı müzik söner ve duraklar,
-- açılınca kaldığı yerden devam eder.
-- Sesler SoundService > FrontlineMusic'te durur: istemci ana menüye dönerken baştan kurulduğunda (Online.reboot) müzik
-- kesilmeden yeni ekrana geçer.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Assets = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Assets"))

local Music = {}
Music.FADE_S = 1.2

local function folder(): Folder
	local f = SoundService:FindFirstChild("FrontlineMusic")
	if f and f:IsA("Folder") then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = "FrontlineMusic"
	nf.Parent = SoundService
	return nf
end

local function fade(s: Sound, to: number, done: (() -> ())?)
	local t = TweenService:Create(s, TweenInfo.new(Music.FADE_S, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Volume = to })
	if done then
		t.Completed:Once(done)
	end
	t:Play()
end

-- Bir yerin dolu parçaları (sırasıyla).
local function tracks(mood: string): { string }
	local out = {}
	local list = (Assets.Music :: any)[mood]
	if type(list) == "string" then
		list = { list }
	end
	for _, id in (if type(list) == "table" then list else {}) do
		if Assets.has(id) then
			table.insert(out, id)
		end
	end
	return out
end

-- Parçanın başlangıç saniyesi (Assets.MusicStart; parçanın Assets.Music'teki sırasına göre; yoksa 0).
local function startOf(mood: string, id: string): number
	local list = (Assets.Music :: any)[mood]
	local starts = (Assets :: any).MusicStart and (Assets :: any).MusicStart[mood]
	if type(list) ~= "table" or type(starts) ~= "table" then
		return 0
	end
	local i = table.find(list, id)
	return if i then math.max(0, tonumber(starts[i]) or 0) else 0
end

-- Parçanın ses düzeyi (Assets.MusicVolume; parçanın Assets.Music'teki sırasına göre; tek sayı verilmişse hepsi o).
local function volumeOf(mood: string, id: string): number
	local v = (Assets :: any).MusicVolume
	if type(v) == "number" then
		return v
	end
	local list = (Assets.Music :: any)[mood]
	local vols = if type(v) == "table" then v[mood] else nil
	if type(list) ~= "table" or type(vols) ~= "table" then
		return 0.3
	end
	local i = table.find(list, id)
	return math.clamp(if i then tonumber(vols[i]) or 0.3 else 0.3, 0, 1)
end

-- Ayarlarda açık mı ("menuOn" / "gameOn" öznitelikleri; yoksa açık).
local function allowed(f: Folder, mood: string): boolean
	return f:GetAttribute(mood .. "On") ~= false
end

-- O anki yerin müziği: açık ve parça varsa çalar / devam eder ve yükselir; değilse söner ve duraklar.
local function apply(f: Folder, mood: string)
	local list = tracks(mood)
	local s = f:FindFirstChild(mood) :: Sound?
	if #list == 0 or not allowed(f, mood) then
		if s then
			local snd = s
			fade(snd, 0, function()
				if f:GetAttribute("Mood") ~= mood or not allowed(f, mood) or #tracks(mood) == 0 then
					snd:Pause()
				end
			end)
		end
		return
	end
	if s == nil then
		local ns = Instance.new("Sound")
		ns.Name = mood
		ns.Volume = 0
		ns.Parent = f
		-- parça bitince sıradaki (tek parça varsa Looped olduğundan Ended gelmez)
		ns.Ended:Connect(function()
			local l = tracks(mood)
			if #l == 0 or f:GetAttribute("Mood") ~= mood or not allowed(f, mood) then
				return
			end
			local i = (tonumber(ns:GetAttribute("Track")) or 1) % #l + 1
			ns:SetAttribute("Track", i)
			ns.SoundId = l[i]
			ns.Volume = volumeOf(mood, l[i]) -- (her parça kendi ses düzeyinde)
			ns.TimePosition = startOf(mood, l[i])
			ns:Play()
		end)
		s = ns
	end
	local snd = s :: Sound
	snd.Looped = #list == 1 and startOf(mood, list[1]) == 0 -- (başlangıç saniyesi olan parça kendi döngüsüyle: Ended)
	if snd.IsPaused and snd.TimePosition > 0 and table.find(list, snd.SoundId) then
		snd:Resume() -- (kapatılıp açıldı: kaldığı yerden)
	elseif not snd.IsPlaying then
		snd:SetAttribute("Track", 1)
		snd.SoundId = list[1]
		snd.TimePosition = startOf(mood, list[1])
		snd:Play()
	end
	fade(snd, volumeOf(mood, snd.SoundId))
end

--- Çalacak müzik: "menu" (ana menü, bekleme odası) ya da "game" (maç).
function Music.set(mood: string)
	local f = folder()
	if f:GetAttribute("Mood") == mood then
		return
	end
	f:SetAttribute("Mood", mood)
	-- çalan diğer müzik söner, sonra durur (bu arada yeniden seçilmediyse)
	for _, s in f:GetChildren() do
		if s:IsA("Sound") and s.Name ~= mood then
			fade(s, 0, function()
				if f:GetAttribute("Mood") ~= s.Name then
					s:Stop()
				end
			end)
		end
	end
	apply(f, mood)
end

--- Ayarlar: menü ve maç müziği açık mı.
function Music.setEnabled(menuOn: boolean, gameOn: boolean)
	local f = folder()
	local changed = f:GetAttribute("menuOn") ~= menuOn or f:GetAttribute("gameOn") ~= gameOn
	f:SetAttribute("menuOn", menuOn)
	f:SetAttribute("gameOn", gameOn)
	local mood = f:GetAttribute("Mood")
	if changed and type(mood) == "string" then
		apply(f, mood)
	end
end

return Music
]]></ProtectedString>
