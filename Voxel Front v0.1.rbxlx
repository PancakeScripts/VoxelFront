					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- StructMath: yapı simgesi boyu ve renkleri (repo structure.vert.glsl / structure.frag.glsl). Roblox API'si yok (testlenir).

local StructMath = {}

export type Cfg = {
	iconSize: number,
	dotsZoom: number,
	dotScale: number,
	shrinkZoom: number,
	growZoom: number,
	maxPx: number,
	scale: { [string]: number },
}

-- repo: zoom <= dots -> dotScale; zoom >= grow -> zoom / grow; arada min(1, zoom / shrink)
function StructMath.iconScale(c: Cfg, zoom: number): number
	if zoom <= c.dotsZoom then
		return c.dotScale
	elseif zoom >= c.growZoom then
		return zoom / c.growZoom
	end
	return math.min(1, zoom / c.shrinkZoom)
end

-- Simge karesinin (şekil dahil) piksel boyu; tam sayıya yuvarlanır (gereksiz güncelleme olmasın).
function StructMath.px(c: Cfg, kind: string, zoom: number): number
	local s = c.iconSize * StructMath.iconScale(c, zoom) * (c.scale[kind] or 1)
	return math.floor(math.min(s, c.maxPx * (c.scale[kind] or 1)) + 0.5)
end

function StructMath.dots(c: Cfg, zoom: number): boolean
	return zoom <= c.dotsZoom
end

-- HSV parlaklığını k ile çarpar (repo darken(rgb, vScale)): ton ve doygunluk korunur. 0..255 girer/çıkar.
function StructMath.darken(r: number, g: number, b: number, k: number): (number, number, number)
	return math.floor(r * k + 0.5), math.floor(g * k + 0.5), math.floor(b * k + 0.5)
end

return StructMath
]]></ProtectedString>
						<string name="ScriptGuid">{D3200947-818A-4AED-BD94-07E120120187}</string>
