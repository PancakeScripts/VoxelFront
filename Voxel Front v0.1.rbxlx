				</Item>
				<Item class="ModuleScript" referent="RBXFCAF6AB3499D4AF1925C18AF3E15C7DF">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Naval: gemi için iniş yeri ve su rotası bulma (Roblox API'siz, saf mantık).
--
-- OpenFront kuralı: gemi, hedefe en yakın "ulaşılabilir kıyıya" (50 tile içinde, hedef sahibine ait, saldıranın kıyı
-- sularıyla aynı su kütlesinde) iner. Çıkış noktası, o iniş yerine suyla en yakın kendi kıyı tile'ıdır.
-- Burada rota, iniş yerinden başlayan genişlik öncelikli aramayla bulunur; saldıranın kıyısına değen ilk su tile'ı çıkış olur.

local Naval = {}

local MAX_LANDING_DIST = 50
local MAX_SEARCH_NODES = 200000

-- Hızlı su A* (repo AStar.Water karşılığı) ------------------------------------------------------------
-- Eski genişlik-öncelikli arama 2000x1000 haritada okyanus aşırı rotalarda 100-300 ms sürüyordu (tick takılması).
-- Burada: 8 yönlü A* (çaprazda köşe kesmek yok), oktil sezgisel x1.4 ağırlık (az düğüm, yumuşatma sonrası fark
-- edilmez), düğüm durumu dünya başına bir kez ayrılan buffer'larda (tablo/hash yok; her aramada "nesil" damgası).
-- Farklı su kütleleri arasında hiç arama yapılmaz.

local HEUR_W = 1.4
local SQ2 = 14
local ST = 10

type Scratch = { gen: buffer, g: buffer, parent: buffer, stamp: number, closed: buffer }

local function scratch(world: any): Scratch
	local s = world.navScratch
	if not s then
		local n = world.size
		s = {
			gen = buffer.create(n * 4),
			g = buffer.create(n * 4),
			parent = buffer.create(n * 4),
			closed = buffer.create(n * 4),
			stamp = 0,
		}
		world.navScratch = s
	end
	return s
end

Naval.stats = { direct = 0, coarseOk = 0, fallback = 0, skip = 0 }

-- Bu tick'te harcanan arama düğümleri (Simulation her tick sıfırlar); isteğe bağlı bütçe için.
Naval.nodesThisTick = 0
Naval.pace = nil :: (() -> ())? -- uzun aramalarda çağrılır (kare bütçesi; Match atar)

-- starts: başlangıç su tile'ları; goal: hedef su tile'ı. Döner: başlangıçtan hedefe tile listesi (yumuşatılmamış) ya da nil.
function Naval.astar(world: any, starts: { number }, goal: number, maxNodes: number, corridor: any?): { number }?
	-- corridor (isteğe bağlı): { region: tile->bölge buffer, mark: bölge başına u32, stamp } — yalnız işaretli bölgelerdeki tile'lar gezilir
	if not world:isWater(goal) then
		return nil
	end
	local comp = world:waterComponent(goal)
	local w, h = world.width, world.height
	local terrain = world.terrain
	local S = scratch(world)
	S.stamp += 1
	local stamp = S.stamp
	local gen, gb, par, closed = S.gen, S.g, S.parent, S.closed
	local gx, gy = goal % w, goal // w
	-- ikili yığın: f değerleri ve düğümler paralel dizilerde
	local hf: { number } = {}
	local hn: { number } = {}
	local hsize = 0
	local function push(f: number, node: number)
		hsize += 1
		local i = hsize
		while i > 1 do
			local p = i // 2
			if hf[p] <= f then
				break
			end
			hf[i], hn[i] = hf[p], hn[p]
			i = p
		end
		hf[i], hn[i] = f, node
	end
	local function pop(): number
		local top = hn[1]
		local lf, ln = hf[hsize], hn[hsize]
		hf[hsize], hn[hsize] = nil :: any, nil :: any
		hsize -= 1
		if hsize > 0 then
			local i = 1
			while true do
				local l = i * 2
				if l > hsize then
					break
				end
				local r = l + 1
				local c = if r <= hsize and hf[r] < hf[l] then r else l
				if hf[c] >= lf then
					break
				end
				hf[i], hn[i] = hf[c], hn[c]
				i = c
			end
			hf[i], hn[i] = lf, ln
		end
		return top
	end
	local function heur(t: number): number
		local dx = math.abs(t % w - gx)
		local dy = math.abs(t // w - gy)
		local mn = if dx < dy then dx else dy
		local mx = if dx < dy then dy else dx
		return (ST * (mx - mn) + SQ2 * mn) * HEUR_W
	end
	local any = false
	for _, s in starts do
		if s >= 0 and s < world.size and buffer.readu8(terrain, s) == 0 and world:waterComponent(s) == comp then
			buffer.writeu32(gen, s * 4, stamp)
			buffer.writeu32(gb, s * 4, 0)
			buffer.writei32(par, s * 4, -1)
			push(heur(s), s)
			any = true
		end
	end
	if not any then
		return nil
	end
	local expanded = 0
	while hsize > 0 do
		local t = pop()
		if buffer.readu32(closed, t * 4) == stamp then
			continue
		end
		buffer.writeu32(closed, t * 4, stamp)
		if t == goal then
			Naval.nodesThisTick += expanded
			local path: { number } = {}
			local cur = t
			while cur ~= -1 do
				path[#path + 1] = cur
				cur = buffer.readi32(par, cur * 4)
			end
			-- ters çevir: başlangıçtan hedefe
			local n = #path
			for i = 1, n // 2 do
				path[i], path[n + 1 - i] = path[n + 1 - i], path[i]
			end
			return path
		end
		expanded += 1
		if expanded % 512 == 0 and Naval.pace then
			Naval.pace()
		end
		if expanded > maxNodes then
			Naval.nodesThisTick += expanded
			return nil
		end
		local x, y = t % w, t // w
		local g0 = buffer.readu32(gb, t * 4)
		-- 8 komşu (çaprazda iki yan komşu da su olmalı)
		local wN = y > 0 and buffer.readu8(terrain, t - w) == 0
		local wS = y < h - 1 and buffer.readu8(terrain, t + w) == 0
		local wW = x > 0 and buffer.readu8(terrain, t - 1) == 0
		local wE = x < w - 1 and buffer.readu8(terrain, t + 1) == 0
		for k = 1, 8 do
			local u, cost, ok
			if k == 1 then
				u, cost, ok = t - w, ST, wN
			elseif k == 2 then
				u, cost, ok = t + w, ST, wS
			elseif k == 3 then
				u, cost, ok = t - 1, ST, wW
			elseif k == 4 then
				u, cost, ok = t + 1, ST, wE
			elseif k == 5 then
				u, cost, ok = t - w - 1, SQ2, wN and wW and buffer.readu8(terrain, t - w - 1) == 0
			elseif k == 6 then
				u, cost, ok = t - w + 1, SQ2, wN and wE and buffer.readu8(terrain, t - w + 1) == 0
			elseif k == 7 then
				u, cost, ok = t + w - 1, SQ2, wS and wW and buffer.readu8(terrain, t + w - 1) == 0
			else
				u, cost, ok = t + w + 1, SQ2, wS and wE and buffer.readu8(terrain, t + w + 1) == 0
			end
			if ok and corridor and buffer.readu32(corridor.mark, buffer.readu32(corridor.region, u * 4) * 4) ~= corridor.stamp then
				ok = false
			end
			if ok and buffer.readu32(closed, u * 4) ~= stamp then
				local ng = g0 + cost
				if buffer.readu32(gen, u * 4) ~= stamp or ng < buffer.readu32(gb, u * 4) then
					buffer.writeu32(gen, u * 4, stamp)
					buffer.writeu32(gb, u * 4, ng)
					buffer.writei32(par, u * 4, t)
					push(ng + heur(u), u)
				end
			end
		end
	end
	Naval.nodesThisTick += expanded
	return nil
end

-- Bir kara tile'ının yanındaki su tile'ları.
local function waterNeighbors(world: any, t: number): { number }
	local out: { number } = {}
	local nb: { number } = {}
	local n = world:neighbors(t, nb)
	for k = 1, n do
		if world:isWater(nb[k]) then
			out[#out + 1] = nb[k]
		end
	end
	return out
end

-- Saldıranın kıyı tile'larının değdiği su kütleleri.
function Naval.reachableComps(world: any, pid: number): { [number]: boolean }
	local comps: { [number]: boolean } = {}
	for t in world:borderOf(pid) do
		local c = world:shoreComponent(t)
		if c then
			comps[c] = true
		end
	end
	return comps
end

-- `tile`a en yakın iniş kıyısı: hedef sahibine ait, kıyıda, ulaşılabilir su kütlesine bakan kara tile'ı.
function Naval.findLanding(world: any, targetOwner: number, tile: number, comps: { [number]: boolean }): number?
	local seen: { [number]: boolean } = { [tile] = true }
	local frontier: { number } = { tile }
	local nb: { number } = {}
	local nbc: { number } = {}
	local dist = 0
	while #frontier > 0 and dist <= MAX_LANDING_DIST do
		local nextFrontier: { number } = {}
		for _, t in frontier do
			if world:isLand(t) and world:ownerAt(t) == targetOwner then
				-- Kıyı mı ve komşu su kütlesi ulaşılabilir mi?
				local n = world:neighbors(t, nbc)
				for k = 1, n do
					local c = world:waterComponent(nbc[k])
					if c ~= 0 and comps[c] then
						return t
					end
				end
			end
			local n = world:neighbors(t, nb)
			for k = 1, n do
				local u = nb[k]
				if not seen[u] then
					seen[u] = true
					nextFrontier[#nextFrontier + 1] = u
				end
			end
		end
		frontier = nextFrontier
		dist += 1
	end
	return nil
end

-- İniş yerine (dst) giden su rotası: çıkış suyundan iniş yerinin yanındaki suya kadar tile listesi. Yoksa nil.
function Naval.findRoute(world: any, pid: number, dst: number): ({ number }?, number?)
	-- hedef kıyının yanındaki su (ve su kütlesi)
	local goals = waterNeighbors(world, dst)
	if #goals == 0 then
		return nil, nil
	end
	local comps: { [number]: number } = {}
	for _, g in goals do
		comps[world:waterComponent(g)] = g
	end
	-- çıkış: aynı su kütlesine bakan, hedefe kuş uçuşu en yakın kendi kıyı tile'ım (repo: en yakın kıyı)
	local w = world.width
	local dx0, dy0 = dst % w, dst // w
	local best, bestD, bestGoal = nil, math.huge, nil
	local nb: { number } = {}
	for t in world:borderOf(pid) do
		if world:isLand(t) then
			local n = world:neighbors(t, nb)
			for k = 1, n do
				local u = nb[k]
				if world:isWater(u) then
					local g = comps[world:waterComponent(u)]
					if g then
						local d = (t % w - dx0) ^ 2 + (t // w - dy0) ^ 2
						if d < bestD then
							best, bestD, bestGoal = t, d, g
						end
					end
				end
			end
		end
	end
	if not best or not bestGoal then
		return nil, nil
	end
	return Naval.route(world, waterNeighbors(world, best), bestGoal, MAX_SEARCH_NODES), best
end

-- Rotayı yumuşatır: görüş hattı (düz çizgi tamamen su) olan en uzak noktaya atlar, çizgiyi tile tile yürür.
local function clearLine(world: any, a: number, b: number): { number }?
	local w = world.width
	local x0, y0, x1, y1 = a % w, a // w, b % w, b // w
	local steps = math.max(math.abs(x1 - x0), math.abs(y1 - y0))
	local out: { number } = {}
	for i = 1, steps do
		local x = x0 + math.floor((x1 - x0) * i / steps + 0.5)
		local y = y0 + math.floor((y1 - y0) * i / steps + 0.5)
		local t = y * w + x
		if not world:isWater(t) then
			return nil
		end
		-- köşeden sızmayı engelle: çapraz geçişte yan komşulardan biri su olmalı
		local px, py = out[#out] and out[#out] % w or x0, out[#out] and out[#out] // w or y0
		if x ~= px and y ~= py and not (world:isWater(py * w + x) or world:isWater(y * w + px)) then
			return nil
		end
		out[i] = t
	end
	return out
end

-- Hiyerarşik rota (repo AStar.WaterHierarchical / AbstractGraph fikri) ----------------------------------------
-- Harita CxC hücrelere bölünür; her hücredeki su, hücre içinde birbirine bağlı BÖLGELERE ayrılır (taşkın doldurma).
-- Komşu hücrelerin bölgeleri, sınırda yan yana iki su tile'ı varsa bağlıdır. Bu grafik kesindir: grafikte yol
-- varsa gerçek su yolu da vardır. Rota önce bölge grafiğinde bulunur (az düğüm), sonra yalnız o bölgelerin
-- (ve komşularının) tile'larında ince A* ile çizilir — arama dar bir koridorla sınırlı olduğu için hızlıdır.
local C = 8

function Naval.prepare(world: any)
	if world.navGraph then
		return
	end
	scratch(world) -- ince A* buffer'ları da baştan ayrılsın (ilk aramada takılma olmasın)
	local w, h = world.width, world.height
	local terrain = world.terrain
	local cw, ch = math.ceil(w / C), math.ceil(h / C)
	local region = buffer.create(world.size * 4) -- tile -> bölge kimliği (1..R), kara 0
	local repTile: { number } = {}
	local regionCount = 0
	local stack: { number } = {}
	for cy = 0, ch - 1 do
		local y0, y1 = cy * C, math.min(h - 1, cy * C + C - 1)
		for cx = 0, cw - 1 do
			local x0, x1 = cx * C, math.min(w - 1, cx * C + C - 1)
			local mx, my = (x0 + x1) / 2, (y0 + y1) / 2
			for y = y0, y1 do
				for x = x0, x1 do
					local t = y * w + x
					if buffer.readu8(terrain, t) == 0 and buffer.readu32(region, t * 4) == 0 then
						regionCount += 1
						local r = regionCount
						local best, bestD = t, math.huge
						buffer.writeu32(region, t * 4, r)
						local top = 1
						stack[1] = t
						while top > 0 do
							local u = stack[top]
							top -= 1
							local ux, uy = u % w, u // w
							local d = (ux - mx) ^ 2 + (uy - my) ^ 2
							if d < bestD then
								best, bestD = u, d
							end
							if ux > x0 then
								local v = u - 1
								if buffer.readu8(terrain, v) == 0 and buffer.readu32(region, v * 4) == 0 then
									buffer.writeu32(region, v * 4, r)
									top += 1
									stack[top] = v
								end
							end
							if ux < x1 then
								local v = u + 1
								if buffer.readu8(terrain, v) == 0 and buffer.readu32(region, v * 4) == 0 then
									buffer.writeu32(region, v * 4, r)
									top += 1
									stack[top] = v
								end
							end
							if uy > y0 then
								local v = u - w
								if buffer.readu8(terrain, v) == 0 and buffer.readu32(region, v * 4) == 0 then
									buffer.writeu32(region, v * 4, r)
									top += 1
									stack[top] = v
								end
							end
							if uy < y1 then
								local v = u + w
								if buffer.readu8(terrain, v) == 0 and buffer.readu32(region, v * 4) == 0 then
									buffer.writeu32(region, v * 4, r)
									top += 1
									stack[top] = v
								end
							end
						end
						repTile[r] = best
					end
				end
			end
		end
	end
	-- komşuluk: hücre sınırlarında (doğu ve güney kenarı) yan yana su
	local adj: { { number } } = table.create(regionCount)
	for r = 1, regionCount do
		adj[r] = {}
	end
	local seen: { [number]: boolean } = {}
	local function link(a: number, b: number)
		if a == b then
			return
		end
		local k = if a < b then a * 1048576 + b else b * 1048576 + a
		if not seen[k] then
			seen[k] = true
			table.insert(adj[a], b)
			table.insert(adj[b], a)
		end
	end
	for cy = 0, ch - 1 do
		for cx = 0, cw - 1 do
			local x1 = math.min(w - 1, cx * C + C - 1)
			local y1 = math.min(h - 1, cy * C + C - 1)
			if x1 + 1 < w then
				for y = cy * C, y1 do
					local t = y * w + x1
					local ra, rb = buffer.readu32(region, t * 4), buffer.readu32(region, (t + 1) * 4)
					if ra ~= 0 and rb ~= 0 then
						link(ra, rb)
					end
				end
			end
			if y1 + 1 < h then
				for x = cx * C, x1 do
					local t = y1 * w + x
					local ra, rb = buffer.readu32(region, t * 4), buffer.readu32(region, (t + w) * 4)
					if ra ~= 0 and rb ~= 0 then
						link(ra, rb)
					end
				end
			end
		end
	end
	world.navGraph = {
		region = region,
		rep = repTile,
		adj = adj,
		count = regionCount,
		gen = buffer.create((regionCount + 1) * 4),
		g = buffer.create((regionCount + 1) * 4),
		par = buffer.create((regionCount + 1) * 4),
		closed = buffer.create((regionCount + 1) * 4),
		mark = buffer.create((regionCount + 1) * 4),
		stamp = 0,
		mstamp = 0,
	}
end

-- Bölge grafiğinde A*: bölge listesi (başlangıçtan hedefe) ya da nil.
local function regionPath(world: any, G: any, rs: number, rg: number, maxNodes: number): { number }?
	local w = world.width
	G.stamp += 1
	local stamp = G.stamp
	local gen, gb, par, closed, adj, rep = G.gen, G.g, G.par, G.closed, G.adj, G.rep
	local gt = rep[rg]
	local gx, gy = gt % w, gt // w
	local hf: { number } = {}
	local hn: { number } = {}
	local hsize = 0
	local function push(f: number, node: number)
		hsize += 1
		local i = hsize
		while i > 1 do
			local p = i // 2
			if hf[p] <= f then
				break
			end
			hf[i], hn[i] = hf[p], hn[p]
			i = p
		end
		hf[i], hn[i] = f, node
	end
	local function pop(): number
		local top = hn[1]
		local lf, ln = hf[hsize], hn[hsize]
		hf[hsize], hn[hsize] = nil :: any, nil :: any
		hsize -= 1
		if hsize > 0 then
			local i = 1
			while true do
				local l = i * 2
				if l > hsize then
					break
				end
				local r = l + 1
				local c = if r <= hsize and hf[r] < hf[l] then r else l
				if hf[c] >= lf then
					break
				end
				hf[i], hn[i] = hf[c], hn[c]
				i = c
			end
			hf[i], hn[i] = lf, ln
		end
		return top
	end
	buffer.writeu32(gen, rs * 4, stamp)
	buffer.writeu32(gb, rs * 4, 0)
	buffer.writei32(par, rs * 4, -1)
	push(0, rs)
	local expanded = 0
	while hsize > 0 do
		local r = pop()
		if buffer.readu32(closed, r * 4) ~= stamp then
			buffer.writeu32(closed, r * 4, stamp)
			if r == rg then
				Naval.nodesThisTick += expanded
				local out: { number } = {}
				local cur = r
				while cur ~= -1 do
					out[#out + 1] = cur
					cur = buffer.readi32(par, cur * 4)
				end
				return out
			end
			expanded += 1
			if expanded % 512 == 0 and Naval.pace then
				Naval.pace()
			end
			if expanded > maxNodes then
				break
			end
			local rt = rep[r]
			local rx, ry = rt % w, rt // w
			local g0 = buffer.readu32(gb, r * 4)
			for _, u in adj[r] do
				if buffer.readu32(closed, u * 4) ~= stamp then
					local ut = rep[u]
					local ux, uy = ut % w, ut // w
					local ng = g0 + math.floor(math.sqrt((ux - rx) ^ 2 + (uy - ry) ^ 2) * ST + 0.5)
					if buffer.readu32(gen, u * 4) ~= stamp or ng < buffer.readu32(gb, u * 4) then
						buffer.writeu32(gen, u * 4, stamp)
						buffer.writeu32(gb, u * 4, ng)
						buffer.writei32(par, u * 4, r)
						local dx, dy = math.abs(ux - gx), math.abs(uy - gy)
						local mn = if dx < dy then dx else dy
						local mx = if dx < dy then dy else dx
						push(ng + (ST * (mx - mn) + SQ2 * mn) * 1.1, u)
					end
				end
			end
		end
	end
	Naval.nodesThisTick += expanded
	return nil
end

-- Su rotası (başlangıçlardan hedefe tile listesi, yumuşatılmamış). Kısa mesafede doğrudan A*, uzakta bölge grafiği + koridor.
function Naval.route(world: any, starts: { number }, goal: number, maxNodes: number): { number }?
	if #starts == 0 or not world:isWater(goal) then
		return nil
	end
	local w = world.width
	local comp = world:waterComponent(goal)
	local start = nil
	for _, s in starts do
		if world:isWater(s) and world:waterComponent(s) == comp then
			start = s
			break
		end
	end
	if not start then
		return nil
	end
	local dist = math.abs(start % w - goal % w) + math.abs(start // w - goal // w)
	if dist <= C * 6 then
		-- yakın: doğrudan A* (küçük sınırla; kara dili yüzünden uzun dolaşma gerekiyorsa bölge grafiğine geçilir)
		local p = Naval.astar(world, starts, goal, math.min(maxNodes, 4000))
		if p then
			Naval.stats.direct += 1
			return p
		end
	end
	Naval.prepare(world)
	local G = world.navGraph
	local rs = buffer.readu32(G.region, start * 4)
	local rg = buffer.readu32(G.region, goal * 4)
	local regions = regionPath(world, G, rs, rg, 60000)
	if not regions then
		Naval.stats.skip += 1
		return nil
	end
	-- 1) hızlı inceltme: ardışık bölge temsilcileri arası düz çizgi; olmazsa yalnız o iki (komşu) bölgede küçük A*
	do
		local n = #regions
		local pts: { number } = { start }
		local regs: { number } = { rs }
		for i = n - 1, 2, -1 do -- regions hedeften başlangıca sıralı
			pts[#pts + 1] = G.rep[regions[i]]
			regs[#regs + 1] = regions[i]
		end
		pts[#pts + 1] = goal
		regs[#regs + 1] = rg
		local path: { number } = { start }
		local ok = true
		for i = 1, #pts - 1 do
			local a, b = pts[i], pts[i + 1]
			if a ~= b then
				local seg = clearLine(world, a, b)
				if not seg then
					G.mstamp += 1
					buffer.writeu32(G.mark, regs[i] * 4, G.mstamp)
					buffer.writeu32(G.mark, regs[i + 1] * 4, G.mstamp)
					local loc = Naval.astar(world, { a }, b, 600, { region = G.region, mark = G.mark, stamp = G.mstamp })
					if not loc then
						ok = false
						break
					end
					seg = table.move(loc, 2, #loc, 1, {})
				end
				for _, t in seg :: { number } do
					path[#path + 1] = t
				end
			end
		end
		if ok then
			Naval.stats.coarseOk += 1
			return path
		end
	end
	-- 2) koridor: yoldaki bölgeler + komşuları
	G.mstamp += 1
	local ms = G.mstamp
	local mark = G.mark
	for _, r in regions do
		buffer.writeu32(mark, r * 4, ms)
		for _, u in G.adj[r] do
			buffer.writeu32(mark, u * 4, ms)
		end
	end
	local path = Naval.astar(world, { start }, goal, maxNodes, { region = G.region, mark = mark, stamp = ms })
	if path then
		Naval.stats.coarseOk += 1
		return path
	end
	Naval.stats.fallback += 1
	return Naval.astar(world, starts, goal, math.min(maxNodes, 150000))
end

function Naval.smooth(world: any, path: { number }): { number }
	-- Görüş hattı ile kısaltma; ileriye en çok LOOK nokta bakılır (eskisi tüm yola bakıyordu: uzun rotada O(n²) yavaşlık).
	local LOOK = 48
	local result: { number } = { path[1] }
	local i = 1
	local n = #path
	while i < n do
		local best, seg = i + 1, nil :: { number }?
		for j = math.min(n, i + LOOK), i + 2, -1 do
			local s = clearLine(world, path[i], path[j])
			if s then
				best, seg = j, s
				break
			end
		end
		if not seg then
			seg = { path[i + 1] }
		end
		for _, t in seg :: { number } do
			result[#result + 1] = t
		end
		i = best
	end
	return result
end

-- İki kıyı tile'ı (liman) arasındaki su rotası: a'nın yanındaki sudan b'nin yanındaki suya, yumuşatılmış.
-- Ortak su kütlesi yoksa veya çok uzaksa nil.
function Naval.portRoute(world: any, a: number, b: number, maxNodes: number): { number }?
	local starts = waterNeighbors(world, a)
	local goals = waterNeighbors(world, b)
	if #starts == 0 or #goals == 0 then
		return nil
	end
	-- ortak su kütlesi
	local compA: { [number]: boolean } = {}
	for _, t in starts do
		compA[world:waterComponent(t)] = true
	end
	local goal = nil
	for _, t in goals do
		if compA[world:waterComponent(t)] then
			goal = t
			break
		end
	end
	if not goal then
		return nil
	end
	local path = Naval.route(world, starts, goal, maxNodes)
	if not path then
		return nil
	end
	return Naval.smooth(world, path)
end

-- İki nokta arası su rotası (from su tile'ı; to su ya da kıyı tile'ı), yumuşatılmış. Bulunamazsa nil.
function Naval.waterRoute(world: any, from: number, to: number, maxNodes: number): { number }?
	if not world:isWater(from) then
		return nil
	end
	local goal = nil
	if world:isWater(to) then
		goal = to
	else
		local c = world:waterComponent(from)
		for _, t in waterNeighbors(world, to) do
			if world:waterComponent(t) == c then
				goal = t
				break
			end
		end
	end
	if not goal or world:waterComponent(goal) ~= world:waterComponent(from) then
		return nil
	end
	if goal == from then
		return { from }
	end
	local path = Naval.route(world, { from }, goal, maxNodes)
	if not path then
		return nil
	end
	return Naval.smooth(world, path)
end

-- Botlar için: kıyıdan 5 tile ötede sahipsiz kara olan ilk nokta (her 10. kıyı tile'ı taranır).
function Naval.expansionTarget(world: any, pid: number): number?
	local w, h = world.width, world.height
	local shores: { number } = {}
	for t in world:borderOf(pid) do
		if world:shoreComponent(t) then
			shores[#shores + 1] = t
		end
	end
	table.sort(shores)
	local dirs = { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }
	for i = 1, #shores, 10 do
		local t = shores[i]
		local x, y = t % w, t // w
		for _, d in dirs do
			local x1, y1 = x + d[1], y + d[2]
			local x5, y5 = x + d[1] * 5, y + d[2] * 5
			if x1 >= 0 and x1 < w and y1 >= 0 and y1 < h and x5 >= 0 and x5 < w and y5 >= 0 and y5 < h then
				if world:isWater(y1 * w + x1) then
					local target = y5 * w + x5
					if world:isLand(target) and world:ownerAt(target) == 0 then
						return target
					end
				end
			end
		end
	end
	return nil
end

return Naval
]]></ProtectedString>
