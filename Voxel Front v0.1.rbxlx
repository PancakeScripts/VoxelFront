						<UniqueId name="UniqueId">624560e9eb8305f10afdb9830000382d</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX24809448B4A24ACFB2C3CE5BE434C12F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Analytics (istemci): maçın kilometre taşlarını sunucuya bildirir (ReplicatedStorage.FrontlineAnalytics -> Server.Analytics,
-- Creator Hub > Analytics). Solo maç bu cihazda çalıştığı için bunları yalnız istemci bilir. RoWorld
-- src/client/UI/Telemetry.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.). Oyunu hiçbir şekilde etkilemez; hatası yutulur.
--   * ana menü ilk kez görününce "title" (Analytics.watchTitle);
--   * oyuncu bir maçta oynamaya başlayınca "match_start" (mod), ilk yerleşince "spawned", ilk saldırı / genişleme / gemi
--     emrinde "attack" (onOrder), oynadığı her tam dakikada "alive";
--   * elenince "eliminated" (dakika, kim eledi: son saldıranın türü), tur bitince "over", ana menüye dönünce "left" (left);
--   * STATE_EVERY_S'de bir (ve ana menüye dönerken) anlık durum: ne oluyor, toprakta kaçıncı, kare hızı ("state"). Sunucu
--     sonuncuyu tutar; maç bitmeden çıkılırsa "Quit / Left Situation" ve "Quit / Left FPS" olarak kaydeder.
--   * tur bitince "over" (dakika, kazandı mı, sırası); "match_start" haritayı da söyler;
--   * maçta pencere öndeyken SLOW_S saniye boyunca SLOW_FPS'in altında kalan kare hızı maç başına bir kez "slow" (fps, bellek MB).
--   Analytics.send(kind, ...) başka modüller için: "howto" (title | match), "spectate", "takeover_offered" (online).
--
--   Analytics.watchTitle(menu)
--   Analytics.new(deps) -> a       a:onOrder() / a:left() / a:replay()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Analytics = {}
Analytics.__index = Analytics

Analytics.STATE_EVERY_S = 10
--- Toprak bu pencerede LAND_CHANGE'den fazla değişirse "Losing land" / "Growing".
Analytics.LAND_WINDOW_S = 30
Analytics.LAND_CHANGE = 0.03
--- Bu kadar süre emir yoksa "Idle".
Analytics.IDLE_S = 60
--- Son bu kadar saniyede bana saldırı varsa "Under attack"; elenmede bu kadar yeni saldıran "kim eledi" sayılır.
Analytics.HIT_S = 3
Analytics.KILLER_S = 30
--- Yavaş kare: bu kadar saniye art arda bu kare hızının altında (RoWorld: ilk 10 sn 12 fps altı).
Analytics.SLOW_FPS = 12
Analytics.SLOW_S = 10

-- kare hızı (saniyelik sayım; Heartbeat'te tek bir sayı artışı) ve pencerenin önde olup olmadığı
local frames, fps = 0, 60
local focused = true
do
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	RunService.Heartbeat:Connect(function()
		frames += 1
	end)
	UserInputService.WindowFocused:Connect(function()
		focused = true
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		focused = false
	end)
end

local function send(kind: string, a: any?, b: any?, c: any?)
	local r = ReplicatedStorage:FindFirstChild("FrontlineAnalytics")
	if r and r:IsA("RemoteEvent") then
		r:FireServer(kind, a, b, c)
		return true
	end
	return false
end
Analytics.send = send

--- Ana menü ilk kez ekranda kalınca bir kez "title" (sunucunun remote'u gelene dek yeniden dener).
function Analytics.watchTitle(menu: any)
	task.spawn(function()
		while script.Parent ~= nil do
			if menu.current == menu.main and menu.open == "main" and send("title") then
				return
			end
			task.wait(0.5)
		end
	end)
end

-- deps: phase() round() playing() dead() me() stats() runSecs() mode() hit() -> (saat, pid) kindOf(pid) -> "nation"|"bot"|"human"
function Analytics.new(deps: any)
	local self = setmetatable({}, Analytics)
	self.deps = deps
	self.m = nil
	self.epoch = 0
	task.spawn(function()
		while script.Parent ~= nil do
			task.wait(1)
			fps, frames = frames, 0 -- (son saniyenin kare sayısı)
			local ok, err = pcall(self.tick, self)
			if not ok then
				warn("[Frontline] analytics: " .. tostring(err))
			end
		end
	end)
	return self
end

function Analytics._open(self: any): any
	local m = self.m
	if m ~= nil and not m.ended then
		return m
	end
	return nil
end

function Analytics._minutes(self: any): number
	return math.max(0, (tonumber(self.deps.runSecs()) or 0) / 60)
end

-- O an ne oluyor (RoWorld Telemetry.situation).
function Analytics._situation(self: any, m: any): string
	local d = self.deps
	if d.phase() == "spawn" then
		return "Choosing spawn"
	end
	local mine = d.stats()[d.me()]
	if mine == nil or mine.tiles <= 0 then
		return "Not spawned"
	end
	local at = d.hit()
	if at and os.clock() - at <= Analytics.HIT_S then
		return "Under attack"
	end
	local was = if #m.land > 0 then m.land[1][2] else mine.tiles
	if was > 0 and mine.tiles < was * (1 - Analytics.LAND_CHANGE) then
		return "Losing land"
	end
	if os.clock() - m.lastOrder >= Analytics.IDLE_S then
		return "Idle"
	end
	if mine.tiles > was * (1 + Analytics.LAND_CHANGE) then
		return "Growing"
	end
	return "Holding"
end

-- Toprakta kaçıncı (yaşayanlar arasında).
function Analytics._standing(self: any): string
	local d = self.deps
	local stats, me = d.stats(), d.me()
	local mine = stats[me]
	if mine == nil or mine.tiles <= 0 then
		return "No land"
	end
	local above = 0
	for pid, p in stats do
		if pid ~= me and p.tiles > mine.tiles then
			above += 1
		end
	end
	return if above < 3 then "Top 3" elseif above < 10 then "Top 10" else "Lower"
end

function Analytics._sendState(self: any, m: any)
	local now = os.clock()
	local mine = self.deps.stats()[self.deps.me()]
	table.insert(m.land, { now, if mine then mine.tiles else 0 })
	while #m.land > 1 and now - m.land[1][1] > Analytics.LAND_WINDOW_S do
		table.remove(m.land, 1)
	end
	m.stateAt = now
	send("state", self:_situation(m), self:_standing(), fps)
end

--- Oyuncu bir saldırı / genişleme / gemi emri verdi (Client.floatAttack).
function Analytics.onOrder(self: any)
	local m = self:_open()
	if m == nil then
		return
	end
	m.lastOrder = os.clock()
	if not m.attacked then
		m.attacked = true
		send("attack")
	end
end

--- Ana menüye dönüş (Client menuCb.onMenu; online'da ışınlanmadan önce): açık maç "left" olarak biter.
function Analytics.left(self: any)
	local m = self:_open()
	if m == nil then
		return
	end
	pcall(self._sendState, self, m)
	m.ended = true
	send("left", self:_minutes())
end

--- Solo'da yeni maç (PLAY / Play Again): açık maç biter, sıradaki tur yeni maç sayılır.
function Analytics.replay(self: any)
	self:left()
	self.epoch += 1
end

function Analytics.tick(self: any)
	local d = self.deps
	local phase, round, me = d.phase(), d.round(), d.me()
	local m = self.m
	if (m == nil or m.ended) and d.playing() and me ~= 0 and phase ~= "ended"
		and (m == nil or m.round ~= round or m.epoch ~= self.epoch)
	then
		m = {
			round = round,
			epoch = self.epoch,
			me = me,
			spawned = false,
			attacked = false,
			ended = false,
			sentMin = 0,
			land = {},
			lastOrder = os.clock(),
			stateAt = os.clock(),
		}
		self.m = m
		send("match_start", d.mode(), if d.map then d.map() else nil)
	end
	if m == nil or m.ended then
		return
	end
	if m.round ~= round or m.me ~= me then
		-- (tur değişti ama bitişi görülmedi: menüye dönmüş sayılır)
		self:left()
		return
	end
	local mine = d.stats()[me]
	if not m.spawned and mine ~= nil and mine.tiles > 0 then
		m.spawned = true
		send("spawned")
	end
	local mins = self:_minutes()
	if m.spawned and (d.dead() or (mine == nil and phase ~= "spawn")) then
		-- elendi: kim eledi = son KILLER_S'de bana saldıran
		m.ended = true
		local at, by = d.hit()
		local kind = if at and by and os.clock() - at <= Analytics.KILLER_S then d.kindOf(by) else nil
		send("eliminated", mins, kind)
		return
	end
	if phase == "ended" then
		m.ended = true
		-- (kazandı mı; ayaktaysa toprağa göre kaçıncı)
		local rank: number? = nil
		if mine ~= nil and mine.tiles > 0 then
			rank = 1
			for pid, p in d.stats() do
				if pid ~= me and p.tiles > mine.tiles then
					rank += 1
				end
			end
		end
		send("over", mins, if d.won then d.won() == true else false, rank)
		return
	end
	-- yavaş kare: maç başına bir kez
	if focused and fps < Analytics.SLOW_FPS then
		m.slowFor = (m.slowFor or 0) + 1
		if m.slowFor >= Analytics.SLOW_S and not m.slowSent then
			m.slowSent = true
			local okMem, mem = pcall(function()
				return game:GetService("Stats"):GetTotalMemoryUsageMb()
			end)
			send("slow", fps, if okMem then mem else nil)
		end
	else
		m.slowFor = 0
	end
	if mine ~= nil and math.floor(mins) > m.sentMin then
		m.sentMin = math.floor(mins)
		send("alive", mins)
	end
	if os.clock() - m.stateAt >= Analytics.STATE_EVERY_S then
		self:_sendState(m)
	end
end

return Analytics
]]></ProtectedString>
						<string name="ScriptGuid">{F1714876-7DF2-4028-BAA8-3F90EAEFC3E8}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Analytics</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">624560e9eb8305f10afdb98300006f4f</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX44709DD3A1D6411B9E76FB9DC2264206">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Coach: ilk maçlardaki kısa ipuçları. RoWorld src/client/UI/Coach.luau ve UIAdvisor.check_tips'ten uyarlandı (AGPL-3.0,
-- © 2026 Snick Co.). Bir seferde tek ipucu: üst barın altında kart ("TIP", yazı, Got it / ✕), anlattığı yere (haritada bir
-- yer ya da HUD'da bir düğme) kesikli çizgi, ok ucu ve atan halka. Her ipucu oyuncuya bir kez çıkar (görülenler sunucudaki
-- profilde: FrontlineProfile "tip", oyuncu özniteliği FrontlineTips); "floor" her teklifte (maçta bir kez: Client.Tutorial).
-- Kart LIFETIME_S sonra kendiliğinden kapanır; oyuncu ipucunun dediğini yapınca (complete) hemen kapanır.
-- Tutorial sürerken susar (adımları zaten ipucudur); tutorial bitince öğrettikleri bir daha söylenmez (Coach.TAUGHT).
--
--   Coach.new(deps) -> c     c:offer(id, target?, arg?) / c:complete(id) / c:clear() / c:onOrder(owner, boat) / c.muted

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Fonts = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Fonts"))

local Coach = {}
Coach.__index = Coach

local FLOOR_TIP = "Keep 20% of your army at home, or neighbours walk right in. In your first 5 matches, attacks hold that much back."

--- again: her teklifte gösterilir (oyuncu başına bir kez değil).
Coach.TIPS = {
	floor = { again = true, desktop = FLOOR_TIP, touch = FLOOR_TIP },
	expand = {
		desktop = "Click neutral land next to you to expand.",
		touch = "Tap neutral land next to you, then press Attack to expand.",
	},
	ratio = {
		desktop = "The Attack bar sets how many of your troops each click sends. T / Y change it.",
		touch = "Tap a % on the Attack bar to choose how many troops each attack sends.",
	},
	city = {
		desktop = "You can afford a City (1). Cities raise your troop cap: place one on your land.",
		touch = "You can afford a City. Open BUILD and place one on your land to raise your troop cap.",
	},
	contact = {
		desktop = "You now border %s. Click their land to attack, or right-click it to propose an alliance.",
		touch = "You now border %s. Tap their land to size them up, tap again to attack. Press More for alliances.",
	},
	boat = {
		desktop = "You reached the sea. Click a distant coast to send a boat invasion.",
		touch = "You reached the sea. Tap a distant coast, then press Attack to send a boat invasion.",
	},
	select = {
		desktop = "Target selected. Click it again, or press Attack, to send the order.",
		touch = "Target selected: check their troops, then tap it again or press Attack.",
	},
	attacked = {
		desktop = "You are under attack! Track every front in the Attacks panel. Castles (4) make borders much harder to take.",
		touch = "You are under attack! Track every front in the Attacks panel. Castles make borders much harder to take.",
	},
}
Coach.PRIORITY = { "attacked", "floor", "select", "expand", "contact", "ratio", "city", "boat" }
--- Tutorial'ın öğrettikleri (tutorial bitince görülmüş sayılır).
Coach.TAUGHT = { "expand", "ratio", "city", "contact", "select" }
Coach.LIFETIME_S = 16
Coach.LIFETIME_TOUCH_S = 11
--- Tetikleyiciler (maçın saniyesi; RoWorld UIAdvisor.check_tips)
Coach.EXPAND_AFTER_S = 3.4
Coach.CONTACT_AFTER_S = 8
Coach.RATIO_AFTER_S = 22
Coach.CITY_AFTER_S = 25
Coach.BOAT_AFTER_S = 40

local AMBER = Color3.fromRGB(255, 181, 71)
local CARD_BG = Color3.fromRGB(15, 23, 42)
local WHITE = Color3.fromRGB(241, 245, 249)

local function prio(id: string): number
	return table.find(Coach.PRIORITY, id) or 99
end

local function corner(parent: Instance, r: UDim)
	local c = Instance.new("UICorner")
	c.CornerRadius = r
	c.Parent = parent
end

-- deps: gui, touch, topY(), sound(key), active(), secs(), canAffordCity(), frontier() -> Vector2?, enemy() -> (Vector2?, name?),
--   coast(), slider() -> Vector2?, cityButton() -> Vector2?, attacksPanel() -> Vector2?, hitAt() -> number?, cardOpen()
function Coach.new(deps: any)
	local self = setmetatable({}, Coach)
	self.deps = deps
	self.current = ""
	self.queue = {}
	self.age = 0
	self.t = 0
	self.muted = false
	self.seenLocal = {}
	local gui: ScreenGui = deps.gui

	local card = Instance.new("Frame")
	card.Name = "CoachCard"
	card.AnchorPoint = Vector2.new(0.5, 0)
	card.BackgroundColor3 = CARD_BG
	card.BackgroundTransparency = 0.08
	card.BorderSizePixel = 0
	card.ZIndex = 92
	card.Visible = false
	corner(card, UDim.new(0, 12))
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = AMBER
	stroke.Transparency = 0.55
	stroke.Thickness = 1.5
	stroke.Parent = card
	local cap = Instance.new("TextLabel")
	cap.Name = "Caption"
	cap.BackgroundTransparency = 1
	cap.FontFace = Font.fromId(Fonts.ID, Enum.FontWeight.ExtraBold)
	cap.TextSize = 11
	cap.TextColor3 = AMBER
	cap.TextXAlignment = Enum.TextXAlignment.Left
	cap.Text = "TIP"
	cap.ZIndex = 93
	cap.Parent = card
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.BackgroundTransparency = 1
	text.FontFace = Font.fromId(Fonts.ID, Enum.FontWeight.Bold)
	text.TextSize = 14
	text.TextColor3 = WHITE
	text.TextWrapped = true
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextYAlignment = Enum.TextYAlignment.Top
	text.ZIndex = 93
	text.Parent = card
	local ok = Instance.new("TextButton")
	ok.Name = "GotIt"
	ok.BackgroundColor3 = Color3.fromRGB(51, 65, 85)
	ok.BackgroundTransparency = 0.3
	ok.BorderSizePixel = 0
	ok.FontFace = Font.fromId(Fonts.ID, Enum.FontWeight.Bold)
	ok.TextSize = 12
	ok.TextColor3 = WHITE
	ok.Text = if deps.touch then "✕" else "Got it"
	ok.ZIndex = 94
	corner(ok, UDim.new(0, 8))
	ok.Parent = card
	ok.Activated:Connect(function()
		self:dismiss()
	end)
	card.Parent = gui
	self.card, self.text, self.cap, self.ok = card, text, cap, ok

	-- kesikli çizgi, ok ucu, atan halka ve nokta (tıklamayı tutmaz)
	local arrow = Instance.new("Frame")
	arrow.Name = "CoachArrow"
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.fromScale(1, 1)
	arrow.ZIndex = 91
	arrow.Visible = false
	arrow.Interactable = false
	arrow.Active = false
	arrow.Parent = gui
	self.arrow = arrow
	self.dashes = {}
	local function disc(name: string, filled: boolean): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BackgroundColor3 = AMBER
		f.BackgroundTransparency = if filled then 0 else 1
		f.BorderSizePixel = 0
		f.ZIndex = 91
		f.Interactable = false
		corner(f, UDim.new(0.5, 0))
		if not filled then
			local s = Instance.new("UIStroke")
			s.Color = AMBER
			s.Thickness = 2
			s.Parent = f
		end
		f.Parent = arrow
		return f
	end
	self.ring = disc("Ring", false)
	self.dot = disc("Dot", true)
	self.dot.Size = UDim2.fromOffset(8, 8)
	local head = Instance.new("TextLabel")
	head.Name = "Head"
	head.AnchorPoint = Vector2.new(0.5, 0.5)
	head.BackgroundTransparency = 1
	head.Size = UDim2.fromOffset(16, 16)
	head.Text = "▶"
	head.TextColor3 = AMBER
	head.TextSize = 14
	head.Font = Enum.Font.GothamBold
	head.ZIndex = 91
	head.Interactable = false
	head.Parent = arrow
	self.head = head

	self.conn = RunService.RenderStepped:Connect(function(dt: number)
		local okStep, err = pcall(self._step, self, dt)
		if not okStep then
			warn("[Frontline] coach: " .. tostring(err))
		end
	end)
	task.spawn(function()
		while script.Parent ~= nil do
			task.wait(1)
			local okCheck, err = pcall(self.check, self)
			if not okCheck then
				warn("[Frontline] coach: " .. tostring(err))
			end
		end
		if self.conn then
			self.conn:Disconnect()
		end
	end)
	return self
end

-- Görülenler -------------------------------------------------------------------------------------------------------

function Coach.seen(self: any, id: string): boolean
	if self.seenLocal[id] then
		return true
	end
	local list = Players.LocalPlayer:GetAttribute("FrontlineTips")
	if type(list) == "string" then
		for s in string.gmatch(list, "[^,]+") do
			if s == id then
				return true
			end
		end
	end
	return false
end

function Coach._markSeen(self: any, id: string)
	if self:seen(id) then
		return
	end
	self.seenLocal[id] = true
	local r = ReplicatedStorage:FindFirstChild("FrontlineProfile")
	if r and r:IsA("RemoteEvent") then
		r:FireServer("tip", id)
	end
end

-- Akış -------------------------------------------------------------------------------------------------------------

--- İpucunu sıraya koyar. target: gösterilecek ekran noktası (mutlak; nil: çizgi yok).
function Coach.offer(self: any, id: string, target: (() -> Vector2?)?, arg: string?)
	local tip = Coach.TIPS[id]
	if self.muted or tip == nil or id == self.current or (not tip.again and self:seen(id)) then
		return
	end
	for _, q in self.queue do
		if q.id == id then
			return
		end
	end
	table.insert(self.queue, { id = id, target = target, arg = arg or "" })
	table.sort(self.queue, function(a, b)
		return prio(a.id) < prio(b.id)
	end)
	if self.current == "" then
		self:_next()
	end
end

--- Oyuncu ipucunun dediğini yaptı: kapanır ve bir daha çıkmaz.
function Coach.complete(self: any, id: string)
	if Coach.TIPS[id] and not Coach.TIPS[id].again then
		self:_markSeen(id)
	end
	for i = #self.queue, 1, -1 do
		if self.queue[i].id == id then
			table.remove(self.queue, i)
		end
	end
	if self.current == id then
		self:dismiss()
	end
end

function Coach.dismiss(self: any)
	if self.current == "" then
		return
	end
	self.current = ""
	self.target = nil
	self.card.Visible = false
	self.arrow.Visible = false
	task.delay(0.25, function()
		if self.current == "" then
			self:_next()
		end
	end)
end

function Coach.clear(self: any)
	table.clear(self.queue)
	self.current = ""
	self.target = nil
	self.card.Visible = false
	self.arrow.Visible = false
end

--- Saldırı / genişleme / gemi emri (Client.floatAttack).
function Coach.onOrder(self: any, owner: number, boat: boolean)
	if boat then
		self:complete("boat")
	end
	self:complete("select")
	self:complete("expand")
	if owner ~= 0 then
		self:complete("contact")
	end
end

function Coach._next(self: any)
	if #self.queue == 0 or self.current ~= "" or self.muted then
		return
	end
	local q = table.remove(self.queue, 1)
	local tip = Coach.TIPS[q.id]
	if not tip.again and self:seen(q.id) then
		self:_next()
		return
	end
	self.current = q.id
	self.target = q.target
	local txt = if self.deps.touch then tip.touch else tip.desktop
	if string.find(txt, "%s", 1, true) then
		txt = string.format(txt, q.arg)
	end
	if not tip.again then
		self:_markSeen(q.id)
	end
	self.age = 0
	self.text.Text = txt
	self:_layout(txt)
	self.card.Visible = true
	self.deps.sound("open")
end

-- Kartın boyu yazıya göre (TextService; sarılan yazı kesilmesin).
function Coach._layout(self: any, txt: string)
	local screen = self.deps.gui.AbsoluteSize
	local w = math.floor(math.min(440, screen.X * 0.9))
	local btnW = if self.deps.touch then 36 else 64
	local tw = w - 16 - btnW - 22
	local h = 40
	local okSize, bounds = pcall(function()
		local p = Instance.new("GetTextBoundsParams")
		p.Text = txt
		p.Font = self.text.FontFace
		p.Size = self.text.TextSize
		p.Width = tw
		return TextService:GetTextBoundsAsync(p)
	end)
	if okSize and bounds then
		h = math.ceil(bounds.Y) + 2
	end
	local ch = h + 34
	self.card.Size = UDim2.fromOffset(w, ch)
	self.cap.Position = UDim2.fromOffset(16, 8)
	self.cap.Size = UDim2.fromOffset(tw, 14)
	self.text.Position = UDim2.fromOffset(16, 24)
	self.text.Size = UDim2.fromOffset(tw, h)
	self.ok.Size = UDim2.fromOffset(btnW, 30)
	self.ok.Position = UDim2.fromOffset(w - btnW - 12, math.floor((ch - 30) / 2))
end

function Coach._step(self: any, dt: number)
	if self.current == "" then
		return
	end
	if self.muted or not self.deps.active() then
		self:clear()
		return
	end
	self.age += dt
	self.t += dt
	if self.age > (if self.deps.touch then Coach.LIFETIME_TOUCH_S else Coach.LIFETIME_S) then
		self:dismiss()
		return
	end
	local gui = self.deps.gui
	local origin = gui.AbsolutePosition
	self.card.Position = UDim2.fromOffset(gui.AbsoluteSize.X / 2, self.deps.topY() - origin.Y)
	local p: Vector2? = nil
	if self.target then
		local okT, v = pcall(self.target)
		if okT and typeof(v) == "Vector2" then
			p = v
		end
	end
	self:_drawArrow(p)
end

-- Karttan hedefe kesikli çizgi, ok ucu ve atan halka (RoWorld Coach._draw_arrow).
function Coach._drawArrow(self: any, to: Vector2?)
	local arrow = self.arrow
	local gui = self.deps.gui
	local origin, size = gui.AbsolutePosition, gui.AbsoluteSize
	if to == nil or to.X < origin.X or to.Y < origin.Y or to.X > origin.X + size.X or to.Y > origin.Y + size.Y then
		arrow.Visible = false
		return
	end
	local cp, cs = self.card.AbsolutePosition, self.card.AbsoluteSize
	local from = Vector2.new(
		math.clamp(to.X, cp.X + 18, math.max(cp.X + 18, cp.X + cs.X - 18)),
		if to.Y > cp.Y + cs.Y then cp.Y + cs.Y else cp.Y
	)
	local dirv = to - from
	local dist = dirv.Magnitude
	if dist < 24 then
		arrow.Visible = false
		return
	end
	arrow.Visible = true
	local dir = dirv / dist
	local ang = math.deg(math.atan2(dir.Y, dir.X))
	local dash, d, n = 8, 0, 0
	while d < dist - 16 do
		n += 1
		local s0 = from + dir * d
		local s1 = from + dir * math.min(d + dash, dist - 16)
		local seg = self.dashes[n]
		if seg == nil then
			seg = Instance.new("Frame")
			seg.BorderSizePixel = 0
			seg.AnchorPoint = Vector2.new(0.5, 0.5)
			seg.BackgroundColor3 = AMBER
			seg.ZIndex = 91
			seg.Interactable = false
			corner(seg, UDim.new(0.5, 0))
			seg.Parent = arrow
			self.dashes[n] = seg
		end
		local mid = (s0 + s1) * 0.5 - origin
		seg.Visible = true
		seg.Position = UDim2.fromOffset(mid.X, mid.Y)
		seg.Size = UDim2.fromOffset((s1 - s0).Magnitude, 2)
		seg.Rotation = ang
		seg.BackgroundTransparency = 0.1
		d += dash * 1.8
	end
	for i = n + 1, #self.dashes do
		self.dashes[i].Visible = false
	end
	local headAt = to - dir * 13 - origin
	self.head.Position = UDim2.fromOffset(headAt.X, headAt.Y)
	self.head.Rotation = ang
	local k = (self.t % 1.2) / 1.2
	local r = 16 + 36 * k
	local at = to - origin
	self.ring.Position = UDim2.fromOffset(at.X, at.Y)
	self.ring.Size = UDim2.fromOffset(r, r)
	self.ring:FindFirstChildOfClass("UIStroke").Transparency = 0.1 + 0.85 * k
	self.dot.Position = UDim2.fromOffset(at.X, at.Y)
end

-- Tetikleyiciler (saniyede bir; RoWorld UIAdvisor.check_tips) --------------------------------------------------------

function Coach.check(self: any)
	local d = self.deps
	if self.muted or not d.active() then
		if self.current ~= "" or #self.queue > 0 then
			self:clear()
		end
		return
	end
	local secs = d.secs()
	local hit = d.hitAt()
	if hit and os.clock() - hit < 2 then
		self:offer("attacked", d.attacksPanel)
	end
	if d.cardOpen() then
		self:offer("select")
	end
	if secs > Coach.EXPAND_AFTER_S then
		self:offer("expand", d.frontier)
	end
	if secs > Coach.CONTACT_AFTER_S and not self:seen("contact") then
		local p, name = d.enemy()
		if p and name then
			self:offer("contact", function()
				return (d.enemy())
			end, name)
		end
	end
	if secs > Coach.RATIO_AFTER_S then
		self:offer("ratio", d.slider)
	end
	if secs > Coach.CITY_AFTER_S and d.canAffordCity() then
		self:offer("city", d.cityButton)
	end
	if secs > Coach.BOAT_AFTER_S and not self:seen("boat") and d.coast() then
		self:offer("boat")
	end
end

return Coach
]]></ProtectedString>
						<string name="ScriptGuid">{5A4123B5-2A2E-4FEE-9CF6-5CCF8B537CBD}</string>
