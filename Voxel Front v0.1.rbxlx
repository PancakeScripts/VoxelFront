	-- Harita seçimi: kart ve seçim ekranı görselleri Assets.MapThumbs'tan; görsel kartı boşluksuz kaplar, düğmeye tam sığar.
	local pickerGrid = find(self.picker, "Panel/Body/Grid") :: Frame
	local function paintMap()
		local map = Catalog[Session.map]
		;(find(body, "MapName") :: TextLabel).Text = "Map: " .. map.name
		;(find(body, "MapCard/Preview") :: ImageLabel).Image = (Assets.MapThumbs :: any)[Session.map]
		for _, id in Catalog.order do
			(find(pickerGrid, id .. "/Selected") :: UIStroke).Enabled = id == Session.map
		end
	end
	for _, id in Catalog.order do
		local b = find(pickerGrid, id) :: TextButton
		;(find(b, "Image") :: ImageLabel).Image = (Assets.MapThumbs :: any)[id]
		;(find(b, "NameLabel") :: TextLabel).Text = Catalog[id].name
		press(b)
		b.Activated:Connect(function()
			local changed = Session.map ~= id
			Session.map = id
			paintMap()
			only(self.setup)
			if changed and cb.onMapChange then cb.onMapChange() end
		end)
	end
	paintMap()
	local chooseMap = find(body, "ChooseMap") :: TextButton
	press(chooseMap)
	chooseMap.Activated:Connect(function()
		only(self.picker)
	end)
	local pickerBack = find(self.picker, "Panel/Back") :: TextButton
	press(pickerBack)
	pickerBack.Activated:Connect(function()
		only(self.setup)
	end)
	local diffRow = find(body, "Difficulty") :: Frame
	local function paintDifficulty()
		for _, id in { "easy", "normal", "hard", "insane" } do
			local b = find(diffRow, id) :: TextButton
			local on = self.difficulty == id
			b.BackgroundColor3 = if on then Color3.fromRGB(255, 181, 71) else Color3.fromRGB(51, 65, 85)
			b.TextColor3 = if on then Color3.fromRGB(32, 22, 6) else Color3.fromRGB(241, 245, 249)
		end
	end
	for _, id in { "easy", "normal", "hard", "insane" } do
		(find(diffRow, id) :: TextButton).Activated:Connect(function()
			self.difficulty = id
			Session.difficulty = id
			paintDifficulty()
		end)
	end
	paintDifficulty()
	;(find(self.main, "Spectate") :: TextButton).Activated:Connect(function()
		only(nil)
		self.open = ""
	end)
	-- Nasıl oynanır penceresi: ipuçları ve altında credits (Shared.Credits) tek kaydırılan alanda (Scroll); yazı boyu kartla
	-- ölçeklenir. Kartın sağ üstündeki sekmeler: How to Play başa, Credits en alta hızlıca kaydırır; görünen bölümün sekmesi
	-- mavi. Oyundan açılıp maç durduysa başlıkta "- Game Paused".
	local helpScroll = find(self.helpCard, "Scroll") :: ScrollingFrame
	-- kenarlıklı credits çerçevesi (paragraflar Shared.Credits'ten) ve altında "Source [logo] depo"
	local creditsBox = find(helpScroll, "CreditsBox") :: Frame
	local boxList = creditsBox:FindFirstChildOfClass("UIListLayout") :: UIListLayout
	local boxPad = creditsBox:FindFirstChildOfClass("UIPadding") :: UIPadding
	;(find(creditsBox, "Title") :: TextLabel).Text = Credits.TITLE
	local lineT = find(creditsBox, "LineTemplate") :: TextLabel
	for i, p in Credits.paragraphs() do
		local l = lineT:Clone()
		l.Name = "Line" .. i
		l.LayoutOrder = i
		l.Text = p
		l.Visible = true
		l.Parent = creditsBox
	end
	local function fitBox()
		creditsBox.Size = UDim2.new(1, 0, 0, boxList.AbsoluteContentSize.Y + boxPad.PaddingTop.Offset + boxPad.PaddingBottom.Offset)
	end
	boxList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fitBox)
	fitBox()
	-- How to Play bölümleri (StarterGui HelpCard/Scroll: HelpIntro, Section1..7, Controls; RoWorld HelpOverlay.SECTIONS'tan
	-- uyarlandı, AGPL-3.0, © 2026 Snick Co.). Dokunmatik cihazda yazılar dokunmaya göre (RoWorld gibi): Click -> Tap, sağ tık ->
	-- "Tap ..., then More", klavye kısayolları çıkar. Kontroller kutusu iki listeyi de gösterir.
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		for i = 1, 7 do
			local sec = helpScroll:FindFirstChild("Section" .. i)
			for _, l in (if sec then sec:GetChildren() else {}) do
				if l:IsA("TextLabel") and l.Name ~= "Title" then
					local t = l.Text
					t = string.gsub(t, "Right%-click a nation", "Tap a nation, then More,")
					t = string.gsub(t, " %(T / Y%)", "")
					t = string.gsub(t, " with the buttons at the bottom %(1 – 6%)", " with BUILD")
					t = string.gsub(t, " %(%d%)</b>", "</b>")
					t = string.gsub(t, "Click", "Tap")
					t = string.gsub(t, "click", "tap")
					l.Text = t
				end
			end
		end
	end
	local sourceRow = find(helpScroll, "Source") :: Frame
	;(find(sourceRow, "Repo") :: TextLabel).Text = Credits.SOURCE_REPO
	local sourceLogo = find(sourceRow, "Logo") :: ImageLabel
	sourceLogo.Image = Assets.Icons.creditsLogo
	sourceLogo.Visible = Assets.has(Assets.Icons.creditsLogo)
	local helpTitle = find(self.helpCard, "Title") :: TextLabel
	local tabHow = find(self.helpCard, "Tabs/HowToPlay") :: TextButton
	local tabCredits = find(self.helpCard, "Tabs/Credits") :: TextButton
	local tabOn = (find(self.helpCard, "Back") :: TextButton).BackgroundColor3 -- (Got it! düğmesinin mavisi)
	local tabOff = tabHow.BackgroundColor3
	-- (yazıların boyu TextService ile ölçülür: AutomaticSize uzun yazıyı 256 px'te kesiyordu)
	local TextService = game:GetService("TextService")
	local fitToken = 0
	local function fitHelp()
		local h = self.helpCard.AbsoluteSize.Y
		if h <= 0 then
			return
		end
		fitToken += 1
		local my = fitToken
		local ts = math.clamp(math.floor(h * 0.04 + 0.5), 10, 18)
		sourceRow.Size = UDim2.new(1, 0, 0, math.floor(ts * 1.8 + 0.5))
		for _, c in sourceRow:GetChildren() do
			if c:IsA("TextLabel") then
				c.TextSize = ts
			end
		end
		task.spawn(function()
			for _, c in helpScroll:GetDescendants() do
				if c:IsA("TextLabel") and c.Visible and not c:IsDescendantOf(sourceRow) then
					-- (credits paragrafları ipuçlarından bir kademe küçük; How to Play yazıları HelpScale özniteliğiyle)
					local scale = tonumber(c:GetAttribute("HelpScale"))
					c.TextSize = if c.Parent == creditsBox and c.Name ~= "Title" then math.max(9, ts - 2)
						elseif scale then math.max(9, math.floor(ts * scale + 0.5))
						else ts
					c.AutomaticSize = Enum.AutomaticSize.None
					local params = Instance.new("GetTextBoundsParams")
					params.Text = c.Text
					params.RichText = c.RichText -- (renkli / kalın etiketler ölçüye girmesin)
					params.Font = c.FontFace
					params.Size = c.TextSize
					params.Width = math.max(1, c.AbsoluteSize.X)
					local ok, b = pcall(TextService.GetTextBoundsAsync, TextService, params)
					if my ~= fitToken then
						return -- (bu arada kart yeniden boyutlandı)
					end
					if ok then
						c.Size = UDim2.new(1, 0, 0, math.ceil((b :: Vector2).Y) + 2)
					end
				end
			end
		end)
	end
	self.helpCard:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitHelp)
	fitHelp()
	local scrollTween: Tween? = nil
	local function scrollTo(bottom: boolean, animate: boolean)
		local target = if bottom then math.max(0, helpScroll.AbsoluteCanvasSize.Y - helpScroll.AbsoluteWindowSize.Y) else 0
		if scrollTween then
			scrollTween:Cancel()
		end
		if animate then
			scrollTween = TweenService:Create(helpScroll, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CanvasPosition = Vector2.new(0, target) })
			;(scrollTween :: Tween):Play()
		else
			helpScroll.CanvasPosition = Vector2.new(0, target)
		end
	end
	local function paintTabs()
		-- en üstteyken How to Play; aşağı kaydırıp credits çerçevesi görünen alanın üst yarısına geldiyse (ya da en altta) Credits
		local pos = helpScroll.CanvasPosition.Y
		local maxPos = helpScroll.AbsoluteCanvasSize.Y - helpScroll.AbsoluteWindowSize.Y
		local onCredits = pos > 1
			and (pos >= maxPos - 2 or creditsBox.AbsolutePosition.Y - helpScroll.AbsolutePosition.Y < helpScroll.AbsoluteWindowSize.Y * 0.5)
		tabHow.BackgroundColor3 = if onCredits then tabOff else tabOn
		tabCredits.BackgroundColor3 = if onCredits then tabOn else tabOff
	end
	helpScroll:GetPropertyChangedSignal("CanvasPosition"):Connect(paintTabs)
	helpScroll:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(paintTabs)
	press(tabHow)
	press(tabCredits)
	tabHow.Activated:Connect(function()
		scrollTo(false, true)
	end)
	tabCredits.Activated:Connect(function()
		scrollTo(true, true)
	end)
	local function showHelp(paused: boolean)
		helpTitle.Text = if paused then "How to play? - Game Paused" else "How to play?"
		-- (analitik: How To Play, nereden açıldı: oyundan açılınca önceki ekran yok)
		local where = if self.current == nil then "match" else "title"
		pcall(function()
			require(script.Parent:WaitForChild("Analytics")).send("howto", where)
		end)
		only(self.helpCard)
		fitHelp()
		scrollTo(false, false)
		paintTabs()
	end

	local sBtn = find(self.main, "Settings") :: TextButton
	press(sBtn)
	sBtn.Activated:Connect(function()
		only(self.settingsCard)
	end)
	local hBtn = find(self.main, "Dock/Help") :: TextButton
	press(hBtn)
	hBtn.Activated:Connect(function()
		showHelp(false)
	end)
	-- Ayarlar kapanınca geldiği yere döner; maçtan açıldıysa maç kendiliğinden devam eder.
	local settingsFromGame = false
	local settingsPaused = false
	local function closeSettings()
		if settingsFromGame then
			settingsFromGame = false
			only(nil)
			self.open = ""
			if settingsPaused then
				settingsPaused = false
				if cb.onResume then cb.onResume() end
			end
		else
			only(self.settingsReturn or self.main)
		end
	end
	;(find(self.settingsCard, "Back") :: TextButton).Activated:Connect(closeSettings)
	-- Nasıl oynanır: ana menüden açıldıysa ana menüye, oyundan (alt barın solundaki "?") açıldıysa oyuna döner; oyundan
	-- açık kaldığı sürece maç durur (ayarlar gibi).
	local helpFromGame = false
	local helpPaused = false
	;(find(self.helpCard, "Back") :: TextButton).Activated:Connect(function()
		if helpFromGame then
			helpFromGame = false
			only(nil)
			self.open = ""
			if helpPaused then
				helpPaused = false
				if cb.onResume then cb.onResume() end
			end
		else
			only(self.main)
		end
	end)
	;(self :: any)._openHelp = function()
		if self.current ~= nil then
			return
		end
		helpFromGame = true
		helpPaused = cb.onPause ~= nil and cb.onPause()
		-- (online maç sunucuda sürer: orada "Game Paused" yazılmaz)
		showHelp(helpPaused and (self :: any).pauseTitle == nil)
	end
	-- Feedback penceresi (StarterGui FeedbackCard): sol üstteki Feedback düğmesiyle açılır. Ana menüden açıldıysa ana menüye,
	-- oyundan açıldıysa oyuna döner; oyundan açıkken maç durur (başlıkta "- Game Paused"; online maç durmaz). Send Feedback:
	-- Roblox'un kendi feedback penceresi açılır (SocialService:PromptFeedbackSubmissionAsync; gönderilenler Creator Hub >
	-- Audience > Feedback'te). Solo maçtan açıldıysa bizim pencere açık kalır (maç durmaya devam eder; oyuncu X ile kapatır);
	-- ana menüden ya da online maçtan (sunucuda sürer, durmaz) açıldıysa pencere kapanır.
	do
		local card = (self :: any).feedbackCard :: Frame
		local fbTitle = find(card, "Title") :: TextLabel
		local fbClose = find(card, "Close") :: TextButton
		local fbSend = find(card, "Send") :: TextButton
		local fbFromGame = false
		local fbPaused = false
		local function closeFeedback(resume: boolean)
			if fbFromGame then
				fbFromGame = false
				only(nil)
				self.open = ""
				if fbPaused and resume then
					fbPaused = false
					if cb.onResume then cb.onResume() end
				end
			else
				only(self.main)
			end
		end
		press(fbClose)
		press(fbSend)
		fbClose:SetAttribute("ClickSound", "close")
		fbSend:SetAttribute("ClickSound", "confirm")
		fbClose.Activated:Connect(function()
			closeFeedback(true)
		end)
		fbSend.Activated:Connect(function()
			if not fbFromGame or (self :: any).pauseTitle ~= nil then
				closeFeedback(true) -- (ana menü ya da online maç: durmuş oyun yok, pencere kapanır)
			end
			task.spawn(function()
				local ok, err = pcall(function()
					(game:GetService("SocialService") :: any):PromptFeedbackSubmissionAsync()
				end)
				if not ok then
					warn("[Frontline] feedback prompt: " .. tostring(err))
				end
			end)
		end)
		local fbBtn = (self :: any).feedbackButton :: TextButton
		press(fbBtn)
		fbBtn:SetAttribute("ClickSound", "open")
		fbBtn.Activated:Connect(function()
			if self.current == self.main then
				fbFromGame = false
				fbTitle.Text = "Feedback"
				only(card)
			elseif self.current == nil then
				fbFromGame = true
				fbPaused = cb.onPause ~= nil and cb.onPause()
				fbTitle.Text = if fbPaused and (self :: any).pauseTitle == nil then "Feedback - Game Paused" else "Feedback"
				only(card)
			end
		end)
	end
	-- ayar anahtarları: beyaz daire rayın boyunda; açılıp kapanırken kayarak gider, ray rengi yumuşakça değişir
	local toggleInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for key in self.settings do
		local row = self.settingsCard:FindFirstChild("Opt_" .. key) :: TextButton?
		if row then
			local track = row:FindFirstChild("Track") :: Frame
			local knob = track:FindFirstChild("Knob") :: Frame
			local function paint(animate: boolean)
				local on = (self.settings :: any)[key]
				local color = if on then Color3.fromRGB(34, 197, 94) else Color3.fromRGB(51, 65, 85)
				-- (AnchorPoint ile Position birlikte değişir: daire sol kenardan sağ kenara düz kayar, rayın dışına çıkmaz)
				local anchor = if on then Vector2.new(1, 0.5) else Vector2.new(0, 0.5)
				local pos = if on then UDim2.fromScale(1, 0.5) else UDim2.fromScale(0, 0.5)
				if animate then
					TweenService:Create(track, toggleInfo, { BackgroundColor3 = color }):Play()
					TweenService:Create(knob, toggleInfo, { AnchorPoint = anchor, Position = pos }):Play()
				else
					track.BackgroundColor3 = color
					knob.AnchorPoint = anchor
					knob.Position = pos
				end
			end
			paint(false)
			row.Activated:Connect(function()
				(self.settings :: any)[key] = not (self.settings :: any)[key]
				paint(true)
				cb.onSettings(self.settings)
			end)
		end
	end
	local ePlay = find(self.endCard, "Play") :: TextButton
	press(ePlay)
	ePlay.Activated:Connect(function()
		only(nil)
		self.open = ""
		if self.paused then
			self.paused = false
			if cb.onResume then cb.onResume() end
		else
			cb.onMenu()
			cb.onPlay()
		end
	end)
	local eMenu = find(self.endCard, "MenuButton") :: TextButton
	press(eMenu)
	eMenu.Activated:Connect(function()
		self.paused = false
		self:showMain()
		cb.onMenu()
	end)
	-- Ana menünün sağ üstündeki düğmeler: Crates (Client.Crates penceresi), 2X MEDALS (game pass; kimliği 0 iken bir şey
	-- yapmaz). Shop düğmesinin penceresi sonra.
	do
		local cratesCard = (self :: any).cratesCard
		local cratesButton = self.main:FindFirstChild("Crates") :: TextButton?
		local crates = require(script.Parent:WaitForChild("Crates")).new(cratesCard, cratesButton, function()
			self:showMain()
		end)
		;(self :: any).crates = crates
		if cratesButton then
			press(cratesButton)
			cratesButton.Activated:Connect(function()
				only(cratesCard)
				self.open = "crates"
				crates:opened()
			end)
		end
		local passButton = self.main:FindFirstChild("Medals2x") :: TextButton?
		-- Shop (Client.Shop): 2x Medals, bölge bayrağı, günlük ödül, günün bayrakları
		local shopCard = (self :: any).shopCard
		local shopButton = self.main:FindFirstChild("Shop") :: TextButton?
		local shop = require(script.Parent:WaitForChild("Shop")).new(shopCard, shopButton, passButton, function()
			self:showMain()
		end)
		;(self :: any).shop = shop
		if shopButton then
			press(shopButton)
			shopButton.Activated:Connect(function()
				only(shopCard)
				self.open = "shop"
				shop:opened()
			end)
		end
		if passButton then
			press(passButton)
			passButton.Activated:Connect(function()
				local id = Assets.GamePasses.medals2x
				if type(id) == "number" and id ~= 0 then
					local remote = game:GetService("ReplicatedStorage"):FindFirstChild("FrontlineWallet") :: RemoteEvent?
					if remote then
						remote:FireServer("shop", "open", "menu")
						remote:FireServer("shop", "click", "medals2x")
					end
					game:GetService("MarketplaceService"):PromptGamePassPurchase(Players.LocalPlayer, id)
				end
			end)
		end
	end
	-- Maç sonu ekranı (Client.GameOver): PLAY AGAIN (solo) / KEEP WATCHING (online) / RETURN TO TITLE
	do
		local goFrame = (self :: any).gameOverFrame
		;(self :: any).gameOver = require(script.Parent:WaitForChild("GameOver")).new(goFrame, function(which: string)
			if which == "PlayAgain" then
				only(nil)
				self.open = ""
				cb.onMenu()
				cb.onPlay()
			elseif which == "Spectate" then
				only(nil)
				self.open = ""
			else
				self:showMain()
				cb.onMenu()
			end
		end)
		for _, n in { "PlayAgain", "Spectate", "ToTitle" } do
			local b = goFrame:FindFirstChild("Buttons") and goFrame.Buttons:FindFirstChild(n)
			if b then
				press(b)
			end
		end
	end
	;(self :: any)._toggleSettings = function()
		if self.current == self.settingsCard then
			closeSettings()
			return
		end
		if self.current == nil then
			settingsFromGame = true
			settingsPaused = cb.onPause ~= nil and cb.onPause()
		end
		self.settingsReturn = self.current or self.main
		only(self.settingsCard)
	end
	-- çıkış düğmesi: oyun durur (online maç sunucuda sürer: başlık pauseTitle), ayrılmak isteyip istemediği sorulur
	self.burger.Activated:Connect(function()
		if cb.onPause and cb.onPause() then
			self:showEnd({
				title = (self :: any).pauseTitle or "GAME PAUSED",
				sub = "",
				color = Color3.fromRGB(241, 245, 249),
				stats = "Are you sure you want to leave the game?",
				playLabel = "Resume",
				paused = true,
			})
		else
			self:showMain()
		end
	end)
	return self
end

-- Solo Online: ana menüdeki satıra basınca solo hazırlık ekranı gibi bir pencere (OnlineSetup) açılır: sıradaki online
-- maçın haritası (büyük görsel, arkada dönen harita da o), bekleyen / en çok oyuncu, katılımın kapanmasına kalan süre,
-- JOIN. Harita seçilmez: sırada hangisi varsa o. Sunucu listeyi yalnız pencere açıkken okur ve gönderir ("watch" /
-- "unwatch"). Sunucuda online kapalıysa (FrontlineLobby klasörü yok) ya da bu oyuncuya açık değilse (oyuncunun
-- "FrontlineOnline" özniteliği; sunucu yayınlamadan değiştirebilir) satır "COMING SOON" kalır, pencere açılmaz.
-- Team Online aynı şekilde (TeamSetup penceresi, "FrontlineTeams" özniteliği); pencerede takım sayısı da yazar ("3 TEAMS").
local ONLINE_FAIL_TEXT: { [string]: string } = {
	["Online is closed right now."] = "CLOSED",
	["Online matches can't start in Studio yet."] = "NOT IN STUDIO",
	["Every online match is full right now. Try again in a moment, or play solo."] = "ALL FULL · TRY AGAIN",
	["Couldn't reach the match list. Try again in a moment."] = "TRY AGAIN",
	["Couldn't reach that match. Try again."] = "TELEPORT FAILED",
	["The teleport failed. Try again."] = "TELEPORT FAILED",
	["That match is gone."] = "TRY AGAIN",
	["Only the party leader can join a match."] = "ONLY LEADER CAN JOIN",
}

-- Yazının hemen solunda küçük yeşil daire (menüdeki JOIN etiketindekiyle aynı renk); yazı genişliği değişince yeri güncellenir.
local function textDot(label: TextLabel): Frame
	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.BackgroundColor3 = Color3.fromRGB(94, 227, 153)
	dot.BorderSizePixel = 0
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.ZIndex = label.ZIndex
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = dot
	dot.Parent = label
	local function place()
		local w, tw, th = label.AbsoluteSize.X, label.TextBounds.X, label.TextBounds.Y
		local size = math.max(4, math.floor(th * 0.45 + 0.5))
		local gap = math.max(3, size * 0.7)
		local align = label.TextXAlignment
		local left = if align == Enum.TextXAlignment.Left then 0 elseif align == Enum.TextXAlignment.Right then w - tw else (w - tw) / 2
		dot.Size = UDim2.fromOffset(size, size)
		dot.Position = UDim2.new(0, left - gap - size / 2, 0.5, 0)
	end
	for _, prop in { "TextBounds", "AbsoluteSize" } do
		label:GetPropertyChangedSignal(prop):Connect(place)
	end
	place()
	return dot
end

function Menu.bindOnline(self: Menu)
	-- İki tür: Solo Online ("ffa") ve Team Online ("team"). Her birinin satırı, penceresi ve sunucudan gelen sıradaki maçı ayrı;
	-- katılma durumu (LobbyState) oyuncu başına tektir: en son katılma istenen türün satırında / penceresinde görünür.
	type Kind = {
		kind: string,
		access: string, -- oyuncu özniteliği (sunucu verir)
		joinText: string,
		row: TextButton,
		label: TextLabel,
		dot: Frame?,
		idle: { text: string, color: Color3, rowColor: Color3 },
		panel: Frame,
		mapName: TextLabel,
		preview: ImageLabel,
		playersL: TextLabel,
		startsL: TextLabel,
		noteL: TextLabel,
		formatL: TextLabel?,
		modeL: TextLabel, -- (harita kartının köşesindeki maç türü: FREE FOR ALL / 3 TEAMS)
		playersDot: Frame,
		statusL: TextLabel,
		joinB: TextButton,
		body: Frame,
		searching: Frame, -- (maç bilgisi gelene dek pencerede yalnız "Looking for a match…" ve dönen halka)
		open: any, -- en yakın katılınabilir maç
		openAt: number, -- alındığı an (geri sayım aradaki saniyelerde yerelde ilerler)
	}
	local kinds: { Kind } = {}
	local byKind: { [string]: Kind } = {}
	for _, spec in {
		{ kind = "ffa", row = "Dock/SoloOnline", panel = self.onlineSetup, access = "FrontlineOnline", joinText = "JOIN" },
		{ kind = "team", row = "Dock/TeamOnline", panel = self.teamSetup, access = "FrontlineTeams", joinText = "JOIN TEAMS" },
	} do
		local row = find(self.main, spec.row) :: TextButton
		local label = find(row, "Badge/Soon") :: TextLabel
		local dot = (find(row, "Badge") :: Frame):FindFirstChild("Dot") :: Frame? -- (Solo: "JOIN"in sağında, aynı etiketin içinde)
		if dot then
			dot.Visible = false
		end
		local body = find(spec.panel, "Panel/Body") :: Frame
		local playersL = find(body, "Stats/Players") :: TextLabel
		local k: Kind = {
			kind = spec.kind,
			access = spec.access,
			joinText = spec.joinText,
			row = row,
			label = label,
			dot = dot,
			idle = { text = label.Text, color = label.TextColor3, rowColor = row.TextColor3 },
			panel = spec.panel,
			mapName = find(body, "MapName"),
			preview = find(body, "MapCard/Preview"),
			playersL = playersL,
			startsL = find(body, "Stats/StartsIn"),
			noteL = find(body, "Note"), -- "Next Map:" + aynı geri sayım
			formatL = body:FindFirstChild("Format") :: TextLabel?, -- (takım penceresi: "3 TEAMS")
			modeL = find(body, "MapCard/Mode/Text"),
			playersDot = textDot(playersL),
			statusL = find(body, "Status"),
			joinB = find(body, "Play"),
			body = body,
			searching = find(body, "Searching"),
			open = nil,
			openAt = 0,
		}
		k.playersDot.Visible = false
		local back = find(spec.panel, "Panel/Back") :: TextButton
		press(k.joinB)
		press(back)
		back.Activated:Connect(function()
			(self :: any)._only(self.main)
		end)
		table.insert(kinds, k)
		byKind[k.kind] = k
	end
	task.spawn(function()
		local folder = game:GetService("ReplicatedStorage"):WaitForChild("FrontlineLobby", 15)
		if folder == nil or kinds[1].row.Parent == nil then
			return -- online bu sunucuda kapalı: iki satır da "COMING SOON" kalır
		end
		local infoRemote = folder:WaitForChild("LobbyInfo") :: RemoteEvent
		local joinRemote = folder:WaitForChild("LobbyJoin") :: RemoteEvent
		local stateRemote = folder:WaitForChild("LobbyState") :: RemoteEvent
		local state = "idle" -- "idle" | "joining" | "line" | "sent" | "failed"
		local active = "ffa" -- son katılma istenen tür (durum onun satırında görünür)
		local failText = ""
		local failUntil = 0
		local me = Players.LocalPlayer
		local function open_to(k: Kind): boolean
			return me:GetAttribute(k.access) == true
		end
		local watching: Kind? = nil
		-- partide lider olmayan üye (bindParty): JOIN'e yalnız lider basar, üye onunla gider
		local function member(): boolean
			local ps = (self :: any)._party
			return ps ~= nil and #ps.members > 1 and not ps.leader
		end
		local red = Color3.fromRGB(248, 113, 113)
		local white = Color3.fromRGB(241, 245, 249)
		local function paint(k: Kind)
			if k.row.Parent == nil then
				return
			end
			local st = if active == k.kind then state else "idle"
			local failing = st == "failed" and os.clock() < failUntil
			if not open_to(k) and not failing then
				-- kapalı / izin listesinde değil: baştaki görünüş, pencere açıksa kapanır
				k.row.TextColor3 = k.idle.rowColor
				k.label.Text = k.idle.text
				k.label.TextColor3 = k.idle.color
				if k.dot then
					k.dot.Visible = false
				end
				if self.current == k.panel then
					(self :: any)._only(self.main)
				end
				return
			end
			-- ana menüdeki satır: durum ya da JOIN
			k.row.TextColor3 = white
			k.label.TextColor3 = if failing then red else k.idle.color -- (etiketin mavisi)
			k.label.Text = if failing then failText
				elseif st == "joining" then "JOINING…"
				elseif st == "line" then "IN LINE"
				elseif st == "sent" then "TELEPORTING…"
				else k.joinText
			if k.dot then
				k.dot.Visible = k.label.Text == k.joinText
			end
			-- pencere
			local open = k.open
			if k.searching.Visible ~= (open == nil) then
				-- maç aranıyor: penceredeki her şey gizli, ortada yazı ve dönen halka
				for _, c in k.body:GetChildren() do
					if c:IsA("GuiObject") and c ~= k.searching then
						c.Visible = open ~= nil
					end
				end
				k.searching.Visible = open == nil
			end
			if open ~= nil then
				local left = math.max(0, math.floor(open.starts_in - (os.clock() - k.openAt) + 0.5))
				k.mapName.Text = "Map: " .. open.map_name
				k.preview.Image = (Assets.MapThumbs :: any)[open.map] or ""
				k.playersL.Text = string.format("%d / %d", open.players, open.max)
				k.startsL.Text = string.format("%d:%02d", left // 60, left % 60)
				k.noteL.Text = "Next Map: " .. k.startsL.Text
				k.playersDot.Visible = true
				if k.formatL then
					k.formatL.Text = string.format("%d TEAMS", tonumber(open.teams) or 2)
				end
				k.modeL.Text = if k.kind == "team" then string.format("%d TEAMS", tonumber(open.teams) or 2) else "FREE FOR ALL"
				k.modeL.TextSize = math.max(10, math.floor(k.preview.AbsoluteSize.Y * 0.075 + 0.5)) -- (karta oranlı)
				if self.current == k.panel and self.cb.onMapChange then
					self.cb.onMapChange(open.map) -- (arkadaki harita da sıradaki maçınki)
				end
			else
				k.mapName.Text = "Finding match…"
				k.preview.Image = ""
				k.playersL.Text = "– / –"
				k.startsL.Text = "–:––"
				k.noteL.Text = "Next Map: " .. k.startsL.Text
				k.playersDot.Visible = false
				if k.formatL then
					k.formatL.Text = "– TEAMS"
				end
			end
			k.statusL.TextColor3 = if failing then red else white
			k.statusL.Text = if failing then failText
				elseif st == "joining" then "Joining…"
				elseif st == "line" then "All matches are full: you are in line"
				elseif st == "sent" then "Teleporting…"
				else ""
			k.joinB.Text = if st == "line" then (if member() then "IN LINE" else "LEAVE LINE")
				elseif st == "joining" then "JOINING…"
				elseif st == "sent" then "TELEPORTING…"
				elseif member() then "ONLY LEADER CAN JOIN"
				else "JOIN"
		end
		local function paintAll()
			for _, k in kinds do
				paint(k)
			end
		end
		-- dönen yükleme halkası (yalnız görünürken)
		game:GetService("RunService").RenderStepped:Connect(function()
			for _, k in kinds do
				if k.searching.Visible and k.panel.Visible then
					local spin: any = k.searching:FindFirstChild("Spinner")
					local arc: any = spin and spin:FindFirstChild("Stroke")
					local g = arc and arc:FindFirstChildOfClass("UIGradient")
					if g then
						g.Rotation = (os.clock() * 360) % 360
					end
				end
			end
		end)
		-- pencere açılınca sunucu o türün listesini okumaya ve göndermeye başlar, kapanınca bırakır; arkadaki harita solo seçime döner
		table.insert((self :: any)._screenHooks, function(f: Frame?)
			local now: Kind? = nil
			for _, k in kinds do
				if f == k.panel then
					now = k
				end
			end
			if now ~= watching then
				local was = watching
				watching = now
				if now ~= nil then
					joinRemote:FireServer("watch", now.kind)
					paint(now)
				else
					if was ~= nil then
						joinRemote:FireServer("unwatch")
					end
					if self.cb.onMapChange then
						self.cb.onMapChange(nil)
					end
				end
			end
		end)
		infoRemote.OnClientEvent:Connect(function(list: any, kind: any)
			local k = byKind[if kind == "team" then "team" else "ffa"]
			k.open = if type(list) == "table" and type(list[1]) == "table" then list[1] else nil
			k.openAt = os.clock()
			paint(k)
		end)
		stateRemote.OnClientEvent:Connect(function(s: any, msg: any, kind: any)
			state = if type(s) == "string" then s else "idle"
			if byKind[kind] then
				active = kind -- (lider katılınca üyenin durumu da o türün satırında)
			end
			if state == "failed" then
				if type(msg) == "string" then
					failText = ONLINE_FAIL_TEXT[msg] or "TRY AGAIN"
					failUntil = os.clock() + 3
				else
					state = "idle" -- sıradan kendi isteğiyle çıktı
				end
			end
			paintAll()
		end)
		for _, k in kinds do
			me:GetAttributeChangedSignal(k.access):Connect(paintAll)
			k.row.Activated:Connect(function()
				if open_to(k) then
					(self :: any)._only(k.panel)
				end
			end)
			k.joinB.Activated:Connect(function()
				if not open_to(k) or member() then
					return
				end
				local busy = state == "joining" or state == "line" or state == "sent"
				if busy and active ~= k.kind then
					return -- (öbür türde sırada / yolda)
				end
				if state == "line" then
					joinRemote:FireServer("cancel")
				elseif not busy and k.open ~= nil then
					active = k.kind
					state = "joining"
					paintAll()
					joinRemote:FireServer("join", k.kind)
				end
			end)
		end
		paintAll()
		-- geri sayım ve geçici hata yazısı için saniyede bir
		while kinds[1].row.Parent ~= nil do
			task.wait(1)
			if state == "failed" and os.clock() >= failUntil then
				state = "idle"
			end
			paintAll()
		end
	end)
end

-- Parti (sunucu: Server.Party, en çok 8): ana menüde ekranın solundaki Party kutusunun INVITE tuşu Party penceresini açar
-- (kutunun başlığı: PARTY / PARTY 2/8 / davet gelince PARTY ✉). Pencerede gelen davetler (kabul /
-- ret), üyeler (lider çıkarabilir), bu sunucudaki diğer oyuncular (önce arkadaşlar; davet et), başka sunucudaki arkadaşa
-- Roblox daveti ve partiden ayrılma. Partideyken maça yalnız lider katılır (bindOnline: üyenin JOIN'i "LEADER JOINS").
-- Sunucuya başlık ekranlarında mı olduğu söylenir ("menu"): solo maçta olan üye lider katılınca maçtan koparılmaz.
function Menu.bindParty(self: Menu)
	local card = self.partyCard
	local button = find(self.main, "PartyPanel/Invite") :: TextButton -- (soldaki Party kutusundaki INVITE)
	local titleL = find(self.main, "PartyPanel/Title") :: TextLabel
	local titleScreens = { self.main, self.setup, self.onlineSetup, self.teamSetup, self.picker, self.helpCard, card }
	local list = find(card, "List") :: ScrollingFrame
	local header = find(list, "HeaderTemplate") :: TextLabel
	local rowT = find(list, "RowTemplate") :: Frame
	local countL = find(card, "Count") :: TextLabel
	local noticeL = find(card, "Notice") :: TextLabel
	local inviteFriends = find(card, "InviteFriends") :: TextButton
	local leaveB = find(card, "LeaveParty") :: TextButton
	local back = find(card, "Close") :: TextButton -- (sağ üstteki kırmızı X)
	local me = Players.LocalPlayer
	local st: any = { members = {}, leader = true, invites = {}, max = 8 }
	;(self :: any)._party = st
	local remote: RemoteEvent? = nil
	local noticeUntil = 0
	local sentAt: { [number]: number } = {} -- (davet edildi: düğme kısa süre "Sent")
	local friends: { [number]: boolean } = {}
	for _, b in { button, inviteFriends, leaveB, back } do
		press(b)
	end
	local function fire(what: string, arg: any?)
		if remote then
			remote:FireServer(what, arg)
		end
	end
	local function inParty(): boolean
		return #st.members > 1
	end

	local function render()
		titleL.Text = if #st.invites > 0 then "PARTY ✉" elseif inParty() then string.format("PARTY %d/%d", #st.members, st.max) else "PARTY"
		if card.Visible == false then
			return
		end
		local leaderName = ""
		for _, m in st.members do
			if m.leader then
				leaderName = m.name
			end
		end
		countL.Text = if inParty()
			then string.format("%d / %d · %s", #st.members, st.max, if st.leader then "You lead" else "Led by " .. leaderName)
			else string.format("Just you · up to %d", st.max)
		if remote == nil then
			noticeL.Text = "Online is closed right now."
		elseif os.clock() >= noticeUntil then
			noticeL.Text = ""
		end
		leaveB.Visible = inParty()
		-- tek tuş kalınca ortada
		inviteFriends.Position = UDim2.new(if inParty() then 0.05 else 0.285, 0, inviteFriends.Position.Y.Scale, 0)
		for _, c in list:GetChildren() do
			if c:IsA("GuiObject") and c ~= header and c ~= rowT then
				c:Destroy()
			end
		end
		local order = 0
		local function head(text: string)
			order += 1
			local h = header:Clone()
			h.Name = "Header"
			h.Text = text
			h.LayoutOrder = order
			h.Visible = true
			h.Parent = list
		end
		-- a: { text, color, fn }? sağdaki düğme, b: soldaki (yoksa gizli)
		local function row(name: string, tag: string, a: any?, b: any?)
			order += 1
			local r = rowT:Clone()
			r.Name = "Row"
			r.LayoutOrder = order
			r.Visible = true
			-- etiket (LEADER / YOU / FRIEND) sağda, düğmelerin solunda hap içinde; ad onun soluna kadar (uzunsa küçülür)
			local right = if b then 0.55 elseif a then 0.76 else 0.97
			local nameL = r:FindFirstChild("Name") :: TextLabel -- (r.Name çerçevenin adıdır: çocuk FindFirstChild ile)
			nameL.Text = name
			nameL.Size = UDim2.new((if tag ~= "" then right - 0.3 else right - 0.02) - nameL.Position.X.Scale, 0, nameL.Size.Y.Scale, 0)
			local pill = r:FindFirstChild("TagPill") :: Frame
			pill.Visible = tag ~= ""
			pill.Position = UDim2.new(right, 0, 0.5, 0)
			;(pill:FindFirstChild("Text") :: TextLabel).Text = tag
			for i, slot in { "Action", "Action2" } do
				local spec = if i == 1 then a else b -- (nil değerli tablo döngüye girmez: sırayla)
				local btn = r:FindFirstChild(slot) :: TextButton
				btn.Visible = spec ~= nil
				if spec then
					btn.Text = spec[1]
					btn.BackgroundColor3 = spec[2]
					if spec[3] then
						btn.Activated:Connect(spec[3])
					else
						btn.AutoButtonColor = false
					end
				end
			end
			r.Parent = list
		end
		local GREEN, RED, BLUE, GREY = Color3.fromRGB(34, 197, 94), Color3.fromRGB(220, 38, 38), Color3.fromRGB(59, 130, 246), Color3.fromRGB(71, 85, 105)
		if #st.invites > 0 then
			head("INVITES ✉")
			for _, inv in st.invites do
				local uid = inv.uid
				row(inv.name, "", { "Join", GREEN, function()
					fire("accept", uid)
				end }, { "No", RED, function()
					fire("decline", uid)
				end })
			end
		end
		local inIt: { [number]: boolean } = {}
		if inParty() then
			head("MEMBERS")
			for _, m in st.members do
				inIt[m.uid] = true
				local uid = m.uid
				local tag = if m.leader then "👑 LEADER" elseif uid == me.UserId then "YOU" else ""
				local kick = if st.leader and uid ~= me.UserId then { "Kick", RED, function()
					fire("kick", uid)
				end } else nil
				row(m.name, tag, kick, nil)
			end
		end
		head("PLAYERS HERE")
		local others = {}
		for _, p in Players:GetPlayers() do
			if p ~= me and not inIt[p.UserId] then
				table.insert(others, p)
			end
		end
		table.sort(others, function(a: Player, b: Player): boolean
			local fa, fb = friends[a.UserId] == true, friends[b.UserId] == true
			if fa ~= fb then
				return fa
			end
			return a.DisplayName < b.DisplayName
		end)
		for _, p in others do
			local uid = p.UserId
			local sent = sentAt[uid] ~= nil and os.clock() - sentAt[uid] < 3
			local full = inParty() and #st.members >= st.max
			row(p.DisplayName, if friends[uid] then "FRIEND" else "", if sent then { "Sent", GREY, nil }
				elseif full or (inParty() and not st.leader) then nil
				else { "Invite", BLUE, function()
					sentAt[uid] = os.clock()
					fire("invite", uid)
					render()
					task.delay(3.1, render)
				end }, nil)
		end
		if #others == 0 then
			row("Nobody else is on this server", "", nil, nil)
		end
	end
	;(self :: any)._renderParty = render

	button.Activated:Connect(function()
		(self :: any)._only(card)
		fire("sync")
		render()
	end)
	back.Activated:Connect(function()
		(self :: any)._only(self.main)
	end)
	leaveB.Activated:Connect(function()
		fire("leave")
	end)
	inviteFriends.Activated:Connect(function()
		-- başka sunucudaki arkadaşa Roblox oyun daveti (kabul eden bu sunucuya gelir)
		task.spawn(function()
			local SocialService = game:GetService("SocialService")
			local ok, can = pcall(SocialService.CanSendGameInviteAsync, SocialService, me)
			if ok and can then
				pcall(SocialService.PromptGameInvite, SocialService, me)
			else
				noticeL.Text = "Invites can't be sent from here."
				noticeUntil = os.clock() + 3
			end
		end)
	end)
	-- arkadaşlar (listede önce): oyuncu gelince bir kez sorulur
	local function checkFriend(p: Player)
		if p == me then
			return
		end
		task.spawn(function()
			local ok, yes = pcall(me.IsFriendsWith, me, p.UserId)
			friends[p.UserId] = ok and yes == true
			render()
		end)
	end
	for _, p in Players:GetPlayers() do
		checkFriend(p)
	end
	Players.PlayerAdded:Connect(checkFriend)
	Players.PlayerRemoving:Connect(function()
		task.defer(render)
	end)

	task.spawn(function()
		local folder = game:GetService("ReplicatedStorage"):WaitForChild("FrontlineLobby", 15)
		local r = if folder then folder:WaitForChild("Party", 5) :: RemoteEvent? else nil
		local s = if folder then folder:WaitForChild("PartyState", 5) :: RemoteEvent? else nil
		if r == nil or s == nil or card.Parent == nil then
			render()
			return -- (online kapalı: pencere "closed" der)
		end
		remote = r
		s.OnClientEvent:Connect(function(state: any, msg: any)
			if type(state) == "table" then
				st.members = if type(state.members) == "table" then state.members else {}
				st.leader = state.leader ~= false
				st.invites = if type(state.invites) == "table" then state.invites else {}
				st.max = tonumber(state.max) or 8
			end
			if type(msg) == "string" then
				noticeL.Text = msg
				noticeUntil = os.clock() + 3
				task.delay(3.1, render)
			end
			render()
		end)
		-- başlık ekranlarında mı (solo maçtaki üye lider katılınca gitmez)
		local last: boolean? = nil
		table.insert((self :: any)._screenHooks, function(f: Frame?)
			local on = f ~= nil and table.find(titleScreens, f) ~= nil
			if on ~= last then
				last = on
				fire("menu", on)
			end
		end)
		last = self.current ~= nil and table.find(titleScreens, self.current) ~= nil
		fire("menu", last)
		fire("sync")
	end)
	render()
end

--- Oyundaki ayarlar ve "?" düğmeleri (Hud alt barın soluna kurar): ayarlar penceresi / nasıl oynanır; açıkken maç durur.
function Menu.bindHud(self: Menu, settingsButton: TextButton, helpButton: TextButton)
	self.settingsButton = settingsButton
	for _, b in { settingsButton, helpButton } do
		press(b)
	end
	settingsButton.Activated:Connect(function()
		(self :: any)._toggleSettings()
	end)
	helpButton.Activated:Connect(function()
		(self :: any)._openHelp()
	end)
end

--- Yeni oyuncunun ilk maçı (Client.Tutorial.watchNewPlayer): varsayılan haritada solo maç tutorial olarak başlar.
function Menu.startTutorial(self: Menu)
	(Session :: any).tutorial = "run"
	Session.map = "world"
	;(self :: any)._startSolo()
end

function Menu.showMain(self: Menu)
	(self :: any)._only(self.main)
	self.open = "main"
end

function Menu.hide(self: Menu)
	(self :: any)._only(nil)
	self.open = ""
end

function Menu.isOpen(self: Menu): boolean
	return self.shade.Visible
end

-- Menü açıkken ya da nokta ☰ düğmesinin üstündeyse true (tık haritaya geçmesin).
function Menu.blocks(self: Menu, x: number, y: number): boolean
	if self.shade.Visible or os.clock() - self.closedAt < 0.35 then
		return true
	end
	for _, b in { self.burger, self.settingsButton } do
		local p, sz = b.AbsolutePosition, b.AbsoluteSize
		if x >= p.X and x <= p.X + sz.X and y >= p.Y and y <= p.Y + sz.Y then
			return true
		end
	end
	return false
end

-- Ana menüdeki tur bilgisi ("Tur 3 · başlangıç 12 sn").
function Menu.setInfo(self: Menu, text: string)
	local l = find(self.main, "Info") :: TextLabel
	if l.Text ~= text then
		l.Text = text
	end
end

function Menu.showEnd(self: Menu, m: EndModel)
	self.paused = m.paused == true
	local t = find(self.endCard, "Title") :: TextLabel
	t.Text = m.title
	t.TextColor3 = m.color
	;(find(self.endCard, "Sub") :: TextLabel).Text = m.sub
	;(find(self.endCard, "Stats") :: TextLabel).Text = m.stats
	local playButton = find(self.endCard, "Play") :: TextButton
	local menuButton = find(self.endCard, "MenuButton") :: TextButton
	playButton.Text = m.playLabel or "Keep watching"
	-- durdurma menüsü: oyuna dön yeşil, maçı bitir kırmızı; tur sonunda özgün renkler
	local base = (self :: any)._endColors
	if not base then
		base = { playButton.BackgroundColor3, playButton.TextColor3, menuButton.BackgroundColor3, menuButton.TextColor3 }
		;(self :: any)._endColors = base
	end
	playButton.BackgroundColor3 = if self.paused then Color3.fromRGB(34, 197, 94) else base[1]
	playButton.TextColor3 = if self.paused then Color3.new(1, 1, 1) else base[2]
	menuButton.BackgroundColor3 = if self.paused then Color3.fromRGB(220, 38, 38) else base[3]
	menuButton.TextColor3 = if self.paused then Color3.new(1, 1, 1) else base[4]
	;(self :: any)._only(self.endCard)
	self.open = "end"
end

--- Maç sonu ekranını açar (Client.GameOver.endModel'in modeli).
function Menu.showGameOver(self: Menu, m: any)
	self.paused = false
	;(self :: any).gameOver:show(m)
	local already = self.current == (self :: any).gameOverFrame
	;(self :: any)._only((self :: any).gameOverFrame)
	self.open = "end"
	-- kenar gölgeleri (ana menüdeki vinyet ve üst / alt geçişler) bir anda değil, yavaşça belirir
	if not already then
		local tweens = {}
		for _, name in { "Vignette", "TopShade", "BottomShade" } do
			local fx = self.shade:FindFirstChild(name) :: GuiObject?
			if fx then
				local prop = if fx:IsA("ImageLabel") then "ImageTransparency" else "BackgroundTransparency"
				;(fx :: any)[prop] = 1
				local tw = TweenService:Create(fx, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { [prop] = 0 })
				tw:Play()
				table.insert(tweens, tw)
			end
		end
		;(self :: any)._edgeTweens = tweens
	end
end

-- Açık tur sonu kartının alt yazısını (geri sayım) günceller.
function Menu.setEndSub(self: Menu, text: string)
	if self.open == "end" then
		local l = find(self.endCard, "Sub") :: TextLabel
		if l.Text ~= text then
			l.Text = text
		end
	end
end

return Menu
]]></ProtectedString>
