						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Heap: tile'lar için ikili min-yığın (öncelik küçük olan önce çıkar). Saldırı sınırını sıralar.
-- Paralel dizilerle çalışır; tile başına tablo üretmez.

local Heap = {}

export type Heap = { pri: { number }, tile: { number }, n: number }

function Heap.new(): Heap
	return { pri = {}, tile = {}, n = 0 }
end

function Heap.size(h: Heap): number
	return h.n
end

function Heap.clear(h: Heap)
	table.clear(h.pri)
	table.clear(h.tile)
	h.n = 0
end

function Heap.push(h: Heap, tile: number, priority: number)
	local pri, tiles = h.pri, h.tile
	local i = h.n + 1
	h.n = i
	while i > 1 do
		local parent = i // 2
		if pri[parent] <= priority then
			break
		end
		pri[i] = pri[parent]
		tiles[i] = tiles[parent]
		i = parent
	end
	pri[i] = priority
	tiles[i] = tile
end

-- En küçük öncelikli tile'ı çıkarır; boşsa nil.
function Heap.pop(h: Heap): number?
	local n = h.n
	if n == 0 then
		return nil
	end
	local pri, tiles = h.pri, h.tile
	local top = tiles[1]
	local lastPri, lastTile = pri[n], tiles[n]
	pri[n] = nil :: any
	tiles[n] = nil :: any
	n -= 1
	h.n = n
	if n > 0 then
		local i = 1
		while true do
			local child = i * 2
			if child > n then
				break
			end
			if child < n and pri[child + 1] < pri[child] then
				child += 1
			end
			if pri[child] >= lastPri then
				break
			end
			pri[i] = pri[child]
			tiles[i] = tiles[child]
			i = child
		end
		pri[i] = lastPri
		tiles[i] = lastTile
	end
	return top
end

return Heap
]]></ProtectedString>
