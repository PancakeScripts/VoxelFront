				</Item>
				<Item class="ModuleScript" referent="RBXBE6E8930B15C4FF09D1099CF7A6A8C48">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Rails: fabrika demiryolları (repo RailroadPass). Haritanın üstünde, WorldLayer'ın alt katmanında çizgiler.
--   * Renk: rayın geçtiği tile'ın sahibine göre (repo): benim raylarım açık gri (#e6e6e6; toprağım çok açıksa siyah),
--     başkalarınınki o ülkenin sınır rengi, sahipsiz topraktakiler gri. Toprak el değiştirince renk de değişir (refresh).
--   * Kalınlık TILE biriminde (Look.Rail.widthTiles, repo 1): ekranda widthTiles x zoom piksel, yani yakınlaşınca
--     kalınlaşır, uzaklaşınca incelir.
--   * zoom <= hideZoom görünmez; hideZoom..fullZoom arasında yavaşça belirir (repo railMinZoom / railFadeRange).
--   * zoom >= detailZoom: repo "detay" görünümü (tile başına 3x3 alt ızgara: iki kenar rayı + ortada travers).
-- Tile listesi sahibine göre parçalara bölünür ve Douglas-Peucker ile birkaç düz çizgiye indirgenir; kaydırma/zoom'da
-- yeniden çizilmez (yalnız saydamlık ve görünürlük değişir).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Look = require(Shared:WaitForChild("Look"))
local WorldLayer = require(script.Parent.WorldLayer)
local Icons = require(script.Parent.Icons)
local RailGeom = require(script.Parent.RailGeom)

local Rails = {}
Rails.__index = Rails

local LR = Look.Rail
local TOL = 0.75 -- sadeleştirme sapması (tile)

export type Rail = { tiles: { number }, sig: string, lines: { Frame }, details: { GuiObject } }

export type Rails = typeof(setmetatable(
	{} :: {
		layer: WorldLayer.WorldLayer,
		box: Frame,
		detail: Frame,
		list: { [number]: Rail },
		w: number,
		ownerAt: (tile: number) -> number,
		colorOf: (owner: number) -> Color3,
		transparency: number,
		pattern: Content?,
	},
	Rails
))

local function container(parent: Instance, name: string, z: number): Frame
	local box = Instance.new("Frame")
	box.Name = name
	box.BackgroundTransparency = 1
	box.Size = UDim2.fromScale(1, 1)
	box.ZIndex = z
	box.Visible = false
	box.Parent = parent
	return box
end

-- Detay deseni (repo railDetailCoverage, 3x3): üst ve alt satır ray, orta satırın ortası travers. Beyaz; renk ImageColor3.
local function patternPixels(): buffer
	local px = buffer.create(3 * 3 * 4)
	local function put(x: number, y: number, a: number)
		buffer.writeu32(px, (y * 3 + x) * 4, 0x00FFFFFF + a * 0x1000000)
	end
	for x = 0, 2 do
		put(x, 0, 255)
		put(x, 2, 255)
		put(x, 1, if x == 1 then 255 else 0)
	end
	return px
end

function Rails.new(layer: WorldLayer.WorldLayer, mapW: number, ownerAt: (tile: number) -> number, colorOf: (owner: number) -> Color3): Rails
	return setmetatable({
		layer = layer,
		box = container(layer.under, "Rails", 3),
		detail = container(layer.under, "RailsDetail", 3),
		list = {},
		w = mapW,
		ownerAt = ownerAt,
		colorOf = colorOf,
		transparency = 1,
		pattern = Icons.raw("rail3x3", 3, 3, patternPixels),
	}, Rails)
end

-- (x0,y0)-(x1,y1) arası düz parça: çizgi görünümü (1 Frame) + detay görünümü (desenli 1 ImageLabel ya da 2 Frame).
local function segment(self: Rails, r: Rail, x0: number, y0: number, x1: number, y1: number, color: Color3)
	local L = self.layer
	local thick = LR.widthTiles
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.BackgroundTransparency = self.transparency
	f.ZIndex = 3
	L:line(f, x0, y0, x1, y1, thick, 0)
	f.Parent = self.box
	table.insert(r.lines, f)
	local dx, dy = x1 - x0, y1 - y0
	local len = math.sqrt(dx * dx + dy * dy) + thick
	if self.pattern then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.BorderSizePixel = 0
		img.ImageContent = self.pattern :: Content
		img.ImageColor3 = color
		img.ImageTransparency = self.transparency
		img.ScaleType = Enum.ScaleType.Tile
		img.TileSize = UDim2.new(1 / math.max(len, 1), 0, 1, 0) -- desen her tile'da bir tekrar
		img.ResampleMode = Enum.ResamplerMode.Pixelated
		img.ZIndex = 3
		L:line(img :: any, x0, y0, x1, y1, thick, 0)
		img.Parent = self.detail
		table.insert(r.details, img)
	else
		-- EditableImage yoksa: iki kenar rayı (travers yok)
		local nx, ny = 0, 0
		local d = math.sqrt(dx * dx + dy * dy)
		if d > 1e-6 then
			nx, ny = -dy / d * thick / 3, dx / d * thick / 3
		end
		for s = -1, 1, 2 do
			local e = Instance.new("Frame")
			e.BorderSizePixel = 0
			e.BackgroundColor3 = color
			e.BackgroundTransparency = self.transparency
			e.ZIndex = 3
			L:line(e, x0 + nx * s, y0 + ny * s, x1 + nx * s, y1 + ny * s, thick / 3, 0)
			e.Parent = self.detail
			table.insert(r.details, e)
		end
	end
end

local function draw(self: Rails, r: Rail, ownerAt: (tile: number) -> number)
	local tiles = r.tiles
	local n = #tiles
	local w = self.w
	local xs: { number }, ys: { number } = table.create(n, 0), table.create(n, 0)
	for i, t in tiles do
		xs[i] = (t % w) + 0.5
		ys[i] = (t // w) + 0.5
	end
	local runs = RailGeom.runs(tiles, ownerAt)
	r.sig = RailGeom.signature(runs)
	for _, run in runs do
		local color = self.colorOf(run.owner)
		if run.i0 == run.i1 then
			segment(self, r, xs[run.i0], ys[run.i0], xs[run.i0], ys[run.i0], color)
		else
			local keep: { boolean } = {}
			RailGeom.simplify(xs, ys, run.i0, run.i1, TOL, keep)
			local p = run.i0
			for i = run.i0 + 1, run.i1 do
				if keep[i] then
					segment(self, r, xs[p], ys[p], xs[i], ys[i], color)
					p = i
				end
			end
		end
	end
end

local function wipe(r: Rail)
	for _, f in r.lines do
		f:Destroy()
	end
	for _, f in r.details do
		f:Destroy()
	end
	table.clear(r.lines)
	table.clear(r.details)
end

-- ownerAt verilirse (tam durum yüklenirken) renkler o sahiplik tablosundan okunur.
function Rails.add(self: Rails, id: number, tiles: { number }, ownerAt: ((tile: number) -> number)?)
	self:remove(id)
	if #tiles == 0 then
		return
	end
	local r: Rail = { tiles = tiles, sig = "", lines = {}, details = {} }
	draw(self, r, ownerAt or self.ownerAt)
	self.list[id] = r
end

function Rails.remove(self: Rails, id: number)
	local r = self.list[id]
	if r then
		wipe(r)
		self.list[id] = nil
	end
end

function Rails.clear(self: Rails)
	for id in self.list do
		self:remove(id)
	end
end

-- Toprak el değiştirdiyse rayları yeni sahiplerinin rengine boyar (saniyede bir çağrılır; yalnız değişen raylar).
function Rails.refresh(self: Rails)
	for _, r in self.list do
		local sig = RailGeom.signature(RailGeom.runs(r.tiles, self.ownerAt))
		if sig ~= r.sig then
			wipe(r)
			draw(self, r, self.ownerAt)
		end
	end
end

-- Zoom değişince: belirme/kaybolma saydamlığı ve çizgi <-> detay görünümü.
function Rails.setZoom(self: Rails, zoom: number)
	local fade = RailGeom.fade(LR :: any, zoom)
	local tr = 1 - (1 - LR.transparency) * fade
	tr = math.floor(tr * 50 + 0.5) / 50 -- 0.02 adım: gereksiz güncelleme olmasın
	local visible = fade > 0
	local detail = zoom >= LR.detailZoom
	if tr ~= self.transparency then
		self.transparency = tr
		for _, r in self.list do
			for _, f in r.lines do
				f.BackgroundTransparency = tr
			end
			for _, g in r.details do
				if g:IsA("ImageLabel") then
					g.ImageTransparency = tr
				else
					g.BackgroundTransparency = tr
				end
			end
		end
	end
	local showLine, showDetail = visible and not detail, visible and detail
	if self.box.Visible ~= showLine then
		self.box.Visible = showLine
	end
	if self.detail.Visible ~= showDetail then
		self.detail.Visible = showDetail
	end
end

return Rails
]]></ProtectedString>
						<string name="ScriptGuid">{7DABEF56-E10F-4215-B28E-FF90B8CF2FDB}</string>
