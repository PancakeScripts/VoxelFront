						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Radial: sağ tık (mobilde dokunma) menüsü — repo MainRadialMenu / RadialMenuElements düzeni.
--   Ortada büyük düğme (saldır / müttefike asker gönder / başlangıçta yerleş), çevresinde saat yönünde
--   üst = bilgi, sağ = gemi (ya da ittifakı boz), alt = ittifak, sol = saldırı alt menüsü (bomba, savaş gemisi).
--   Kendi toprağında: üst = bilgi, sağ = yapı sil, alt = ittifak (kapalı), sol = yapı alt menüsü.
-- Alt menü açılınca öğeler halka şeklinde dizilir, orta düğme "geri" olur. Dışarı tıklamak / Esc menüyü kapatır.
-- Yalnızca gösterir; ne yapılacağını çağıran verir (Item.action / Item.sub).

local Fonts = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Fonts"))
local TweenService = game:GetService("TweenService")
local UiScale = require(script.Parent.UiScale)
local Assets = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Assets"))

local Radial = {}
Radial.__index = Radial

export type Item = {
	id: string,
	label: string,
	icon: string?, -- Assets kimliği (boş olabilir)
	fallback: string?, -- görsel yoksa yazı / emoji
	color: Color3,
	enabled: boolean,
	detail: string?, -- ipucu alt satırı (fiyat vb.)
	action: (() -> ())?,
	sub: (() -> { Item })?,
}

export type Model = { center: Item?, slots: { Item }, title: string? }

export type Radial = typeof(setmetatable(
	{} :: {
		gui: Instance,
		backdrop: TextButton,
		root: Frame,
		scale: UIScale,
		tip: TextLabel,
		tipSub: TextLabel,
		tipFrame: Frame,
		buttons: { GuiObject },
		model: Model?,
		stack: { Model },
		openFlag: boolean,
		closedAt: number,
	},
	Radial
))

local ITEM = 60
local CENTER = 58
local RING = 80
local DISABLED = Color3.fromRGB(148, 163, 184)

local function corner(p: Instance, r: UDim)
	local c = Instance.new("UICorner")
	c.CornerRadius = r
	c.Parent = p
end

function Radial.new(gui: Instance): Radial
	local backdrop = Instance.new("TextButton")
	backdrop.Name = "RadialBackdrop"
	backdrop.Text = ""
	backdrop.AutoButtonColor = false
	backdrop.BackgroundTransparency = 1
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.ZIndex = 60
	backdrop.Visible = false
	backdrop.Parent = gui

	local root = Instance.new("Frame")
	root.Name = "Radial"
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromOffset(RING * 2 + ITEM + 20, RING * 2 + ITEM + 20)
	root.ZIndex = 61
	root.Visible = false
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Parent = root
	-- halka arka planı (ince koyu daire)
	local disk = Instance.new("Frame")
	disk.Name = "Disk"
	disk.AnchorPoint = Vector2.new(0.5, 0.5)
	disk.Position = UDim2.fromScale(0.5, 0.5)
	disk.Size = UDim2.fromOffset(RING * 2 + ITEM + 8, RING * 2 + ITEM + 8)
	disk.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
	disk.BackgroundTransparency = 0.35
	disk.ZIndex = 61
	disk.Parent = root
	corner(disk, UDim.new(0.5, 0))

	local tipFrame = Instance.new("Frame")
	tipFrame.Name = "Tip"
	tipFrame.AnchorPoint = Vector2.new(0.5, 0)
	tipFrame.Position = UDim2.new(0.5, 0, 1, 4)
	tipFrame.Size = UDim2.fromOffset(200, 42)
	tipFrame.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
	tipFrame.BackgroundTransparency = 0.1
	tipFrame.ZIndex = 66
	tipFrame.Visible = false
	tipFrame.Parent = root
	corner(tipFrame, UDim.new(0, 8))
	local tip = Instance.new("TextLabel")
	tip.BackgroundTransparency = 1
	tip.FontFace = Fonts.main
	tip.TextSize = 14
	tip.TextScaled = true
	tip.TextColor3 = Color3.new(1, 1, 1)
	tip.Size = UDim2.new(1, 0, 0, 22)
	tip.Position = UDim2.fromOffset(0, 2)
	tip.ZIndex = 67
	tip.Parent = tipFrame
	local tipSub = Instance.new("TextLabel")
	tipSub.BackgroundTransparency = 1
	tipSub.FontFace = Fonts.main
	tipSub.TextSize = 12
	tipSub.TextScaled = true
	tipSub.TextColor3 = Color3.fromRGB(251, 191, 36)
	tipSub.Size = UDim2.new(1, 0, 0, 16)
	tipSub.Position = UDim2.fromOffset(0, 22)
	tipSub.ZIndex = 67
	tipSub.Parent = tipFrame

	local self = setmetatable({
		gui = gui,
		backdrop = backdrop,
		root = root,
		scale = scale,
		tip = tip,
		tipSub = tipSub,
		tipFrame = tipFrame,
		buttons = {},
		model = nil :: Model?,
		stack = {},
		openFlag = false,
		closedAt = -1,
	}, Radial)
	backdrop.Activated:Connect(function()
		self:close()
	end)
	backdrop.MouseButton2Click:Connect(function()
		self:close()
	end)
	return self
end

local function makeButton(self: Radial, it: Item, size: number, x: number, y: number, isCenter: boolean)
	local b = Instance.new("TextButton")
	b.Text = ""
	b.AutoButtonColor = it.enabled
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Position = UDim2.new(0.5, x, 0.5, y)
	b.Size = UDim2.fromOffset(size, size)
	b.BackgroundColor3 = if it.enabled then it.color else DISABLED
	b.BackgroundTransparency = if it.enabled then 0 else 0.45
	b.BorderSizePixel = 0
	b.ZIndex = 63
	b.Parent = self.root
	corner(b, UDim.new(0.5, 0))
	local st = Instance.new("UIStroke")
	st.Color = if isCenter then Color3.fromRGB(203, 213, 225) else Color3.fromRGB(15, 23, 42)
	st.Thickness = if isCenter then 3 else 2
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = b
	if it.icon and Assets.has(it.icon) then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.AnchorPoint = Vector2.new(0.5, 0.5)
		img.Position = UDim2.fromScale(0.5, 0.5)
		img.Size = UDim2.fromScale(0.58, 0.58)
		img.Image = it.icon :: string
		img.ImageTransparency = if it.enabled then 0 else 0.4
		img.ZIndex = 64
		img.Parent = b
	else
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, 1)
		l.FontFace = Fonts.main
		l.TextScaled = true
		l.Text = it.fallback or it.label
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextTransparency = if it.enabled then 0 else 0.4
		l.ZIndex = 64
		l.Parent = b
		local pad = Instance.new("UIPadding")
		local p = UDim.new(0.2, 0)
		pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = p, p, p, p
		pad.Parent = l
	end
	b.MouseEnter:Connect(function()
		self.tip.Text = it.label
		self.tipSub.Text = it.detail or ""
		self.tipFrame.Size = UDim2.fromOffset(math.max(140, #it.label * 8 + 30), if it.detail then 42 else 26)
		self.tipFrame.Visible = true
		if it.enabled then
			TweenService:Create(b, TweenInfo.new(0.08), { Size = UDim2.fromOffset(size + 6, size + 6) }):Play()
		end
	end)
	b.MouseLeave:Connect(function()
		self.tipFrame.Visible = false
		TweenService:Create(b, TweenInfo.new(0.08), { Size = UDim2.fromOffset(size, size) }):Play()
	end)
	b.Activated:Connect(function()
		if not it.enabled then
			return
		end
		if it.sub then
			local items = it.sub()
			if #items > 0 then
				table.insert(self.stack, self.model :: Model)
				self:render({ slots = items, center = nil, title = it.label })
				return
			end
		end
		if it.action then
			self:close()
			it.action()
		end
	end)
	table.insert(self.buttons, b)
end

function Radial.render(self: Radial, m: Model)
	for _, b in self.buttons do
		b:Destroy()
	end
	table.clear(self.buttons)
	self.tipFrame.Visible = false
	self.model = m
	local n = #m.slots
	for i, it in m.slots do
		if it then
			-- saat yönünde, üstten başlayarak
			local a = -math.pi / 2 + (i - 1) * 2 * math.pi / n
			makeButton(self, it, if n > 4 then ITEM - 6 else ITEM, math.cos(a) * RING, math.sin(a) * RING, false)
		end
	end
	if #self.stack > 0 then
		makeButton(self, {
			id = "back",
			label = "Back",
			icon = Assets.Radial.back,
			fallback = Assets.Fallback.Radial.back,
			color = Color3.fromRGB(51, 65, 85),
			enabled = true,
			action = nil,
			sub = nil,
		}, CENTER, 0, 0, true)
		local back = self.buttons[#self.buttons] :: TextButton
		back.Activated:Connect(function()
			local prev = table.remove(self.stack)
			if prev then
				self:render(prev)
			end
		end)
	else
		-- ortada her zaman kapatma (✕) düğmesi
		makeButton(self, {
			id = "close",
			label = "Close",
			icon = Assets.Radial.close,
			fallback = Assets.Fallback.Radial.close,
			color = Color3.fromRGB(30, 41, 59),
			enabled = true,
			action = function() end,
			sub = nil,
		}, CENTER, 0, 0, true)
	end
end

-- (x, y): mutlak ekran konumu.
function Radial.open(self: Radial, x: number, y: number, m: Model)
	table.clear(self.stack)
	-- ekrandan taşmasın
	local cam = workspace.CurrentCamera
	local vw = if cam then cam.ViewportSize.X else 1280
	local vh = if cam then cam.ViewportSize.Y else 720
	-- whole menu is drawn at 1080p size and scaled by UiScale.k() (UIScale on root)
	local k = UiScale.k()
	local half = (RING + ITEM / 2 + 10) * k
	x = math.clamp(x, half, math.max(half, vw - half))
	y = math.clamp(y, half, math.max(half, vh - half - 50 * k))
	self.root.Position = UDim2.fromOffset(x, y)
	self:render(m)
	self.backdrop.Visible = true
	self.root.Visible = true
	self.openFlag = true
	self.scale.Scale = 0.6 * k
	TweenService:Create(self.scale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = k }):Play()
end

function Radial.close(self: Radial)
	if not self.openFlag then
		return
	end
	self.openFlag = false
	self.closedAt = os.clock()
	self.backdrop.Visible = false
	self.root.Visible = false
	self.tipFrame.Visible = false
	for _, b in self.buttons do
		b:Destroy()
	end
	table.clear(self.buttons)
	table.clear(self.stack)
	self.model = nil
end

-- Açıksa (ya da az önce kapandıysa) haritaya tık geçmesin.
function Radial.blocks(self: Radial): boolean
	return self.openFlag or os.clock() - self.closedAt < 0.3
end

function Radial.isOpen(self: Radial): boolean
	return self.openFlag
end

return Radial
]]></ProtectedString>
