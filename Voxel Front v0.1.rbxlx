					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Rail: demiryolu ağı (OpenFront RailNetworkImpl, TrainStationExecution, FactoryExecution kuralları).
--   * Fabrika (tamamlanınca) kendi istasyonunu kurar (tren üretir) ve 110 tile (öklid) içindeki, sahibi kim olursa olsun,
--     şehir / liman / fabrikaları da istasyon yapar. Şehir ya da liman, ancak yakınında (110) bir fabrika varsa istasyon olur.
--   * Yeni istasyon: önce 3 tile içindeki mevcut rayı bulur, ikiye bölüp ona bağlanır. Rayı yoksa 110 tile içindeki istasyonlara
--     (yakından uzağa) ray çeker; 15 tile'dan yakın olanlara ve zaten 4 durak içinde bağlı olanlara çekmez; ray 155 tile'dan uzun olamaz.
--     Ray = 4 yönlü A* (su/kıyı tile'ı +5, yön değişimi +3, sezgisel x2); su yalnızca kıyıdan geçilir.
--   * Küme = birbirine ray ile bağlı istasyonlar. İstasyon yıkılınca ağdan çıkar, küme bölünebilir.
--   * Tren: her fabrika istasyonu cooldown 10 tick, her fabrika seviyesi için 1/oran ihtimalle (aşağıda) tren üretir;
--     hedef kümedeki ticarete açık rastgele bir şehir/liman istasyonu.

local Rail = {}

export type Cluster = { stations: { [any]: boolean }, trade: { [any]: boolean }, size: number }

local LN2 = 0.6931471805599453

local function sigmoid(v: number, rate: number, mid: number): number
	return 1 / (1 + math.exp(-rate * (v - mid)))
end

function Rail.saturation(trainUnits: number): number
	local damping = 1 - sigmoid(trainUnits, LN2 / 100, 560)
	local plateau = 0.25 * (1 - sigmoid(trainUnits, LN2 / 150, 900))
	return math.max(damping, plateau)
end

function Rail.boost(levels: number): number
	if levels <= 0 then
		return 1
	end
	return 1 + 0.5 * math.clamp((6 - levels) / 5, 0, 1) / levels
end

-- 1/oran: her tick, her fabrika seviyesi için tren üretme ihtimali.
function Rail.spawnRate(factoryLevels: number, trainUnits: number): number
	local rate = (factoryLevels + 10) * 15
	return math.max(1, math.floor(rate / (Rail.saturation(trainUnits) * Rail.boost(factoryLevels))))
end

function Rail.trainGold(cfg: any, rel: string, stops: number): number
	local visited = math.max(0, stops - cfg.TRAIN_FREE_STOPS)
	local base = if rel == "ally" then cfg.TRAIN_GOLD_ALLY elseif rel == "self" then cfg.TRAIN_GOLD_SELF else cfg.TRAIN_GOLD_OTHER
	return math.floor(math.max(cfg.TRAIN_GOLD_MIN, base - visited * cfg.TRAIN_GOLD_PENALTY))
end

local function newState(): any
	return {
		stations = {} :: { any },
		nextRail = 1,
		rails = {} :: { [number]: any },
		tileRails = {} :: { [number]: { [any]: boolean } },
		dirty = {} :: { [any]: boolean },
		dirtyCount = 0,
	}
end

function Rail.init(sim: any)
	sim.rail = newState()
end

function Rail.reset(sim: any)
	sim.rail = newState()
	sim.trainCount = 0
end

local function pushFx(sim: any, e: any)
	local l = sim.fx
	if not l then
		l = {}
		sim.fx = l
	end
	table.insert(l, e)
end

-- Yol bulma (A*) -------------------------------------------------------------------------


-- from -> to tile yolu (ikisi de dahil) ya da nil. Dönen uzunluk sınırı: RAILROAD_MAX.
-- Ray bileşenleri: ray kurallarıyla (kara; kıyıdan suya / suyun kıyısına geçiş) birbirine ulaşılabilen tile grupları.
-- Sunucu açılışında bir kez hesaplanır; farklı bileşendeki iki istasyon için hiç arama yapılmaz (eskiden her biri
-- düğüm sınırına kadar arıyordu: istasyon başına ~60 ms). Ayrıca arama buffer'ları burada ayrılır.
function Rail.prepare(world: any)
	if world.railComp then
		return
	end
	local w, h, n = world.width, world.height, world.size
	local terrain = world.terrain
	local shore = buffer.create(n) -- 1: kıyı çizgisi (komşusu farklı türde)
	for t = 0, n - 1 do
		local wt = buffer.readu8(terrain, t) == 0
		local x, y = t % w, t // w
		if (x > 0 and (buffer.readu8(terrain, t - 1) == 0) ~= wt)
			or (x < w - 1 and (buffer.readu8(terrain, t + 1) == 0) ~= wt)
			or (y > 0 and (buffer.readu8(terrain, t - w) == 0) ~= wt)
			or (y < h - 1 and (buffer.readu8(terrain, t + w) == 0) ~= wt)
		then
			buffer.writeu8(shore, t, 1)
		end
	end
	local comp = buffer.create(n * 4)
	local queue = buffer.create(n * 4)
	local count = 0
	for s = 0, n - 1 do
		-- açık deniz (kıyı olmayan su) ray için kendi başına geçilemez; bileşen kara ya da kıyıdan başlar
		if buffer.readu32(comp, s * 4) == 0 and (buffer.readu8(terrain, s) ~= 0 or buffer.readu8(shore, s) == 1) then
			count += 1
			buffer.writeu32(comp, s * 4, count)
			local head, tail = 0, 1
			buffer.writeu32(queue, 0, s)
			while head < tail do
				local t = buffer.readu32(queue, head * 4)
				head += 1
				local x, y = t % w, t // w
				local tShore = buffer.readu8(shore, t) == 1
				for k = 1, 4 do
					local u = -1
					if k == 1 and x > 0 then
						u = t - 1
					elseif k == 2 and x < w - 1 then
						u = t + 1
					elseif k == 3 and y > 0 then
						u = t - w
					elseif k == 4 and y < h - 1 then
						u = t + w
					end
					if u >= 0 and buffer.readu32(comp, u * 4) == 0 then
						-- ray kuralı: kara, ya da biri kıyı
						if buffer.readu8(terrain, u) ~= 0 or tShore or buffer.readu8(shore, u) == 1 then
							buffer.writeu32(comp, u * 4, count)
							buffer.writeu32(queue, tail * 4, u)
							tail += 1
						end
					end
				end
			end
		end
	end
	world.railComp = comp
	world.railScratch = { gen = buffer.create(n * 4), g = buffer.create(n * 4), par = buffer.create(n * 4), closed = buffer.create(n * 4), steps = buffer.create(n * 2), stamp = 0 }
end

function Rail.findTilePath(sim: any, from: number, to: number): { number }?
	-- A* (repo AStar.Rail): kara üzerinde, kıyıdan suya geçiş cezalı, dönüş cezalı. Düğüm durumu dünya başına bir kez
	-- ayrılan buffer'larda (eskiden tablo/hash: 40K düğümde ~500 ms takılma). Kuş uçuşu çok uzaksa hiç aranmaz.
	local world, cfg = sim.world, sim.cfg
	local w, h = world.width, world.height
	local tx, ty = to % w, to // w
	local maxLen = cfg.RAILROAD_MAX
	if math.abs(from % w - tx) + math.abs(from // w - ty) >= maxLen * 1.5 then
		return nil
	end
	-- bulunamayan çiftler tur boyunca hatırlanır (aynı iki istasyon için tekrar tekrar aranmaz)
	local failKey = if from < to then from * world.size + to else to * world.size + from
	local fails = sim.railFail
	if not fails then
		fails = {}
		sim.railFail = fails
	end
	if fails[failKey] then
		return nil
	end
	local rc = world.railComp
	if rc and buffer.readu32(rc, from * 4) ~= buffer.readu32(rc, to * 4) then
		return nil -- aralarında ray yolu yok (deniz)
	end
	local result = Rail.searchTilePath(sim, from, to)
	if not result then
		fails[failKey] = true
	end
	return result
end

function Rail.searchTilePath(sim: any, from: number, to: number): { number }?
	local world, cfg = sim.world, sim.cfg
	local w, h = world.width, world.height
	local tx, ty = to % w, to // w
	local maxLen = cfg.RAILROAD_MAX
	local S = world.railScratch
	if not S then
		S = { gen = buffer.create(world.size * 4), g = buffer.create(world.size * 4), par = buffer.create(world.size * 4), closed = buffer.create(world.size * 4), steps = buffer.create(world.size * 2), stamp = 0 }
		world.railScratch = S
	end
	S.stamp += 1
	local stamp = S.stamp
	local gen, gb, par, closed = S.gen, S.g, S.par, S.closed
	local steps = S.steps -- başlangıçtan tile sayısı: adım + kalan manhattan uzunluk sınırını aşan dal budanır
	local terrain = world.terrain
	local function isWater(t: number): boolean
		return buffer.readu8(terrain, t) == 0
	end
	local function shore(t: number): boolean
		local wt = isWater(t)
		local x, y = t % w, t // w
		return (x > 0 and isWater(t - 1) ~= wt) or (x < w - 1 and isWater(t + 1) ~= wt) or (y > 0 and isWater(t - w) ~= wt) or (y < h - 1 and isWater(t + w) ~= wt)
	end
	local hf: { number } = {}
	local hn: { number } = {}
	local hsize = 0
	local function push(f: number, node: number)
		hsize += 1
		local i = hsize
		while i > 1 do
			local p = i // 2
			if hf[p] <= f then
				break
			end
			hf[i], hn[i] = hf[p], hn[p]
			i = p
		end
		hf[i], hn[i] = f, node
	end
	local function pop(): number
		local top = hn[1]
		local lf, ln = hf[hsize], hn[hsize]
		hf[hsize], hn[hsize] = nil :: any, nil :: any
		hsize -= 1
		if hsize > 0 then
			local i = 1
			while true do
				local l = i * 2
				if l > hsize then
					break
				end
				local r = l + 1
				local c = if r <= hsize and hf[r] < hf[l] then r else l
				if hf[c] >= lf then
					break
				end
				hf[i], hn[i] = hf[c], hn[c]
				i = c
			end
			hf[i], hn[i] = lf, ln
		end
		return top
	end
	buffer.writeu32(gen, from * 4, stamp)
	buffer.writeu32(gb, from * 4, 0)
	buffer.writei32(par, from * 4, -1)
	buffer.writeu16(steps, from * 2, 0)
	push(0, from)
	local expanded = 0
	local limit = cfg.RAIL_MAX_NODES
	local heurW = cfg.RAIL_HEURISTIC
	local waterPen = cfg.RAIL_WATER_PENALTY
	local turnPen = cfg.RAIL_TURN_PENALTY
	while hsize > 0 do
		local cur = pop()
		if cur == to then
			local rev = { cur }
			local p = buffer.readi32(par, cur * 4)
			while p ~= -1 do
				rev[#rev + 1] = p
				p = buffer.readi32(par, p * 4)
			end
			Rail.lastExpanded = expanded
			if #rev >= maxLen then
				return nil
			end
			local path = table.create(#rev)
			for i = #rev, 1, -1 do
				path[#path + 1] = rev[i]
			end
			return path
		end
		if buffer.readu32(closed, cur * 4) ~= stamp then
			buffer.writeu32(closed, cur * 4, stamp)
			expanded += 1
			if expanded > limit then
				Rail.lastExpanded = expanded
				return nil
			end
			local cx, cy = cur % w, cur // w
			local fromShore = shore(cur)
			local prev = buffer.readi32(par, cur * 4)
			local g0 = buffer.readu32(gb, cur * 4)
			local s1 = buffer.readu16(steps, cur * 2) + 1
			for dir = 1, 4 do
				local nx, ny = cx, cy
				if dir == 1 then
					ny -= 1
				elseif dir == 2 then
					ny += 1
				elseif dir == 3 then
					nx -= 1
				else
					nx += 1
				end
				if nx >= 0 and nx < w and ny >= 0 and ny < h then
					local n = ny * w + nx
					if buffer.readu32(closed, n * 4) ~= stamp then
						local nWater = isWater(n)
						local nShore = shore(n)
						if not nWater or fromShore or nShore then
							local step = 1
							if nWater or nShore then
								step += waterPen
							end
							if prev ~= -1 then
								local px, py = prev % w, prev // w
								if (cx - px) ~= (nx - cx) or (cy - py) ~= (ny - cy) then
									step += turnPen
								end
							end
							local ng = g0 + step
							if s1 + math.abs(nx - tx) + math.abs(ny - ty) + 1 < maxLen and (buffer.readu32(gen, n * 4) ~= stamp or ng < buffer.readu32(gb, n * 4)) then
								buffer.writeu32(gen, n * 4, stamp)
								buffer.writeu32(gb, n * 4, ng)
								buffer.writei32(par, n * 4, cur)
								buffer.writeu16(steps, n * 2, s1)
								push(ng + heurW * (math.abs(nx - tx) + math.abs(ny - ty)), n)
							end
						end
					end
				end
			end
		end
	end
	return nil
end

-- Küme / ray bookkeeping -----------------------------------------------------------------

local function newCluster(): Cluster
	return { stations = {}, trade = {}, size = 0 }
end

local function setCluster(station: any, c: Cluster?)
	local old = station.cluster
	if old and old ~= c then
		if old.stations[station] then
			old.stations[station] = nil
			old.trade[station] = nil
			old.size -= 1
		end
	end
	station.cluster = c
end

local function clusterAdd(c: Cluster, station: any)
	if not c.stations[station] then
		c.stations[station] = true
		c.size += 1
	end
	if station.st.type == "city" or station.st.type == "port" then
		c.trade[station] = true
	end
	setCluster(station, c)
end

local function mergeClusters(list: { Cluster }): Cluster
	local merged = newCluster()
	for _, c in list do
		for s in table.clone(c.stations) do
			clusterAdd(merged, s)
		end
	end
	return merged
end

local function markDirty(sim: any, c: Cluster)
	local r = sim.rail
	if not r.dirty[c] then
		r.dirty[c] = true
		r.dirtyCount += 1
	end
end

local function registerRail(sim: any, rail: any)
	local r = sim.rail
	r.rails[rail.id] = rail
	for _, t in rail.tiles do
		local set = r.tileRails[t]
		if not set then
			set = {}
			r.tileRails[t] = set
		end
		set[rail] = true
	end
end

local function unregisterRail(sim: any, rail: any)
	local r = sim.rail
	r.rails[rail.id] = nil
	for _, t in rail.tiles do
		local set = r.tileRails[t]
		if set then
			set[rail] = nil
			if next(set) == nil then
				r.tileRails[t] = nil
			end
		end
	end
end

local function attachRail(rail: any)
	rail.from.rails[rail] = true
	rail.to.rails[rail] = true
	rail.from.nbr[rail.to] = rail
	rail.to.nbr[rail.from] = rail
end

local function detachRail(rail: any)
	rail.from.rails[rail] = nil
	rail.to.rails[rail] = nil
	if rail.from.nbr[rail.to] == rail then
		rail.from.nbr[rail.to] = nil
	end
	if rail.to.nbr[rail.from] == rail then
		rail.to.nbr[rail.from] = nil
	end
end

local function newRail(sim: any, from: any, to: any, tiles: { number }): any
	local r = sim.rail
	local rail = { id = r.nextRail, from = from, to = to, tiles = tiles }
	r.nextRail += 1
	return rail
end

local function announceAdd(sim: any, rail: any)
	pushFx(sim, { k = "railAdd", id = rail.id, tiles = rail.tiles })
end

local function announceDel(sim: any, rail: any)
	pushFx(sim, { k = "railDel", id = rail.id })
end

-- Bağlanma ---------------------------------------------------------------------------------

local function distSq(w: number, a: number, b: number): number
	local dx, dy = a % w - b % w, a // w - b // w
	return dx * dx + dy * dy
end

-- Başka istasyonlara kısa mesafeden zaten bağlı mı? (en çok `maxHops` durak)
local function hopsWithin(a: any, b: any, maxHops: number): boolean
	if a == b then
		return true
	end
	local visited: { [any]: boolean } = { [a] = true }
	local frontier = { a }
	for _ = 1, maxHops do
		local nextF = {}
		for _, s in frontier do
			for n in s.nbr do
				if n == b then
					return true
				end
				if not visited[n] then
					visited[n] = true
					table.insert(nextF, n)
				end
			end
		end
		frontier = nextF
		if #frontier == 0 then
			break
		end
	end
	return false
end

local function connectToExistingRails(sim: any, station: any): boolean
	local r, cfg = sim.rail, sim.cfg
	local world = sim.world
	local w = world.width
	local tile = station.st.tile
	local sx, sy = tile % w, tile // w
	local radius = cfg.STATION_SNAP_RADIUS
	local found: { any } = {}
	local seen: { [any]: boolean } = {}
	for dy = -radius, radius do
		for dx = -radius, radius do
			local x, y = sx + dx, sy + dy
			if x >= 0 and x < w and y >= 0 and y < world.height then
				local set = r.tileRails[y * w + x]
				if set then
					for rail in set do
						if not seen[rail] then
							seen[rail] = true
							table.insert(found, rail)
						end
					end
				end
			end
		end
	end
	table.sort(found, function(a: any, b: any): boolean
		return a.id < b.id
	end)
	local edited: { Cluster } = {}
	local editedSet: { [Cluster]: boolean } = {}
	for _, rail in found do
		if r.rails[rail.id] == rail then
			-- istasyona en yakın ray tile'ı
			local best, bestD = 1, math.huge
			for i, t in rail.tiles do
				local d = distSq(w, t, tile)
				if d < bestD then
					best, bestD = i, d
				end
			end
			if best ~= 1 then
				local from, to = rail.from, rail.to
				detachRail(rail)
				unregisterRail(sim, rail)
				announceDel(sim, rail)
				local firstTiles = table.move(rail.tiles :: { number }, 1, best - 1, 1, {} :: { number })
				local secondTiles = table.move(rail.tiles :: { number }, best, #rail.tiles, 1, {} :: { number })
				local r1 = newRail(sim, from, station, firstTiles)
				local r2 = newRail(sim, station, to, secondTiles)
				attachRail(r1)
				attachRail(r2)
				registerRail(sim, r1)
				registerRail(sim, r2)
				announceAdd(sim, r1)
				announceAdd(sim, r2)
				local c = from.cluster
				if c then
					clusterAdd(c, station)
					if not editedSet[c] then
						editedSet[c] = true
						table.insert(edited, c)
					end
				end
			end
		end
	end
	if #edited > 1 then
		mergeClusters(edited)
	end
	return #edited ~= 0
end

local function connectRail(sim: any, a: any, b: any): boolean
	local path = Rail.findTilePath(sim, a.st.tile, b.st.tile)
	if path and #path > 0 then
		local rail = newRail(sim, a, b, path)
		attachRail(rail)
		registerRail(sim, rail)
		announceAdd(sim, rail)
		return true
	end
	return false
end

local function nearbyStructures(sim: any, tile: number, range: number): { any }
	local w = sim.world.width
	local out = {}
	for _, st in sim.structList do
		if st.type == "city" or st.type == "port" or st.type == "factory" then
			local d = distSq(w, st.tile, tile)
			if d <= range * range then
				table.insert(out, { st = st, d = d })
			end
		end
	end
	table.sort(out, function(a: any, b: any): boolean
		if a.d ~= b.d then
			return a.d < b.d
		end
		return a.st.tile < b.st.tile
	end)
	return out
end

local function connectToNearbyStations(sim: any, station: any)
	local cfg = sim.cfg
	local edited: { Cluster } = {}
	local editedSet: { [Cluster]: boolean } = {}
	for _, n in nearbyStructures(sim, station.st.tile, cfg.STATION_MAX_RANGE) do
		local other = n.st.station
		if n.st ~= station.st and other and other.cluster then
			local reachable = hopsWithin(other, station, cfg.STATION_MAX_HOPS)
			if not reachable and n.d > cfg.STATION_MIN_RANGE ^ 2 then
				if connectRail(sim, station, other) then
					local c = other.cluster :: Cluster
					clusterAdd(c, station)
					if not editedSet[c] then
						editedSet[c] = true
						table.insert(edited, c)
					end
				end
			end
		end
	end
	if #edited > 1 then
		mergeClusters(edited)
	elseif #edited == 0 then
		clusterAdd(newCluster(), station)
	end
end

local function createStation(sim: any, st: any, spawns: boolean)
	if st.station then
		return
	end
	local r = sim.rail
	local station = { st = st, rails = {}, nbr = {}, cluster = nil, spawns = spawns, lastSpawn = -1000 }
	st.station = station
	table.insert(r.stations, station)
	if not connectToExistingRails(sim, station) then
		connectToNearbyStations(sim, station)
	end
end

-- Bir yapı tamamlandı: istasyon kurulup kurulmayacağına karar verir.
function Rail.onReady(sim: any, st: any)
	if st.type == "factory" then
		createStation(sim, st, true)
		for _, n in nearbyStructures(sim, st.tile, sim.cfg.STATION_MAX_RANGE) do
			if n.st ~= st and not n.st.station then
				createStation(sim, n.st, false)
			end
		end
	else
		local w = sim.world.width
		local r2 = sim.cfg.STATION_MAX_RANGE ^ 2
		for _, f in sim.structList do
			if f.type == "factory" and distSq(w, f.tile, st.tile) <= r2 then
				createStation(sim, st, false)
				return
			end
		end
	end
end

-- Yapı yıkıldı/yok oldu: istasyon ağdan çıkar.
function Rail.removeStation(sim: any, st: any)
	local station = st.station
	if not station then
		return
	end
	local r = sim.rail
	for rail in table.clone(station.rails) do
		detachRail(rail)
		unregisterRail(sim, rail)
		announceDel(sim, rail)
	end
	local i = table.find(r.stations, station)
	if i then
		r.stations[i] = r.stations[#r.stations]
		r.stations[#r.stations] = nil
	end
	st.station = nil
	station.dead = true
	local c = station.cluster :: Cluster?
	if c then
		c.stations[station] = nil
		c.trade[station] = nil
		c.size -= 1
		station.cluster = nil
		if c.size <= 0 then
			r.dirty[c] = nil
		else
			markDirty(sim, c)
		end
	end
end

-- Kopan ağın yeniden kümelenmesi (repo: her tick).
local function recompute(sim: any)
	local r = sim.rail
	if r.dirtyCount == 0 then
		return
	end
	for c in table.clone(r.dirty) do
		local remaining: { [any]: boolean } = {}
		for s in c.stations do
			remaining[s] = true
		end
		while next(remaining) ~= nil do
			local start = next(remaining)
			local comp: { [any]: boolean } = {}
			local queue = { start }
			while #queue > 0 do
				local cur = table.remove(queue)
				if not comp[cur] then
					comp[cur] = true
					for n in cur.nbr do
						if not comp[n] then
							table.insert(queue, n)
						end
					end
				end
			end
			for s in comp do
				remaining[s] = nil
			end
			if next(remaining) ~= nil then
				local nc = newCluster()
				for s in comp do
					clusterAdd(nc, s)
				end
			end
		end
	end
	table.clear(r.dirty)
	r.dirtyCount = 0
end

-- Ticaret ----------------------------------------------------------------------------------

function Rail.tradeAvailable(sim: any, station: any, pid: number): boolean
	local owner = station.st.pid
	return owner == pid or sim.parts.Diplomacy.canTrade(sim, owner, pid)
end

local function randomDestination(sim: any, cluster: Cluster, pid: number): any?
	local eligible = {}
	for s in cluster.trade do
		if Rail.tradeAvailable(sim, s, pid) then
			table.insert(eligible, s)
		end
	end
	if #eligible == 0 then
		return nil
	end
	table.sort(eligible, function(a: any, b: any): boolean
		return a.st.tile < b.st.tile
	end)
	return eligible[sim.rng:int(1, #eligible)]
end

-- İstasyon yolu (BFS, birim maliyet): from'dan to'ya istasyon listesi ya da nil.
function Rail.findStationsPath(from: any, to: any): { any }?
	if from.cluster ~= to.cluster then
		return nil
	end
	local prev: { [any]: any } = {}
	local visited: { [any]: boolean } = { [from] = true }
	local queue = { from }
	local head = 1
	while head <= #queue do
		local cur = queue[head]
		head += 1
		if cur == to then
			local path = { cur }
			while prev[cur] do
				cur = prev[cur]
				table.insert(path, 1, cur)
			end
			return path
		end
		local nbs = {}
		for n in cur.nbr do
			table.insert(nbs, n)
		end
		table.sort(nbs, function(a: any, b: any): boolean
			return a.st.tile < b.st.tile
		end)
		for _, n in nbs do
			if not visited[n] then
				visited[n] = true
				prev[n] = cur
				table.insert(queue, n)
			end
		end
	end
	return nil
end

-- Her tick: kümeleri yeniler, fabrikalar tren üretir.
function Rail.step(sim: any)
	local r = sim.rail
	recompute(sim)
	if #r.stations == 0 then
		return
	end
	local cfg = sim.cfg
	local trainUnits = sim.trainCount * cfg.TRAIN_UNITS
	local rates: { [number]: number } = {}
	for _, station in r.stations do
		local st = station.st
		if station.spawns and st.ready and sim.tickNo >= station.lastSpawn + cfg.TRAIN_COOLDOWN and sim.alive[st.pid] then
			local cluster = station.cluster :: Cluster?
			if cluster and next(cluster.trade) ~= nil then
				local rate = rates[st.pid]
				if not rate then
					rate = Rail.spawnRate(sim:levelsOwned(st.pid, "factory"), trainUnits)
					rates[st.pid] = rate
				end
				local spawn = false
				for _ = 1, st.level do
					if sim.rng:int(1, rate) == 1 then
						spawn = true
						break
					end
				end
				if spawn then
					local dest = randomDestination(sim, cluster, st.pid)
					if dest and dest ~= station then
						station.lastSpawn = sim.tickNo
						sim:addExecution(sim.parts.Train.new(st.pid, station, dest))
					end
				end
			end
		end
	end
end

-- İstemciye: tüm ray listesi (geç katılan / yeni tur).
function Rail.snapshot(sim: any): { { id: number, tiles: { number } } }
	local out = {}
	for id, rail in sim.rail.rails do
		table.insert(out, { id = id, tiles = rail.tiles })
	end
	table.sort(out, function(a: any, b: any): boolean
		return a.id < b.id
	end)
	return out
end

return Rail
]]></ProtectedString>
