				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Analytics: oyuncunun maç kilometre taşları, Creator Hub > Analytics için (Roblox AnalyticsService; Shared.Telemetry yollar).
-- RoWorld src/server/Analytics.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.). Solo maç istemcide çalıştığından istemci
-- kendi kilometre taşlarını bildirir (Client.Analytics -> ReplicatedStorage.FrontlineAnalytics); bu modül yalnız bilinen
-- türleri, makul değerlerle ve her taşı maç başına bir kez kaydeder. Oyunu hiçbir şekilde etkilemez. Hem normal (hub) hem
-- online maç sunucusunda çalışır. Yayında gönderilir; Studio'da yalnız yazılır.
--
-- Creator Hub > Analytics:
--   Funnels > Onboarding (oyuncunun ilk oturumu, her adım bir kez; Roblox yeni oyuncuya göre tutar):
--     1 Joined Game · 2 Title Screen · 3 Match Started · 4 Spawned · 5 First Attack · 6 Survived 3 Min ·
--     7 Survived 10 Min · 8 Second Match
--   Funnels > "Match" (oynanan her maç; alanlar: mod, deneyim):
--     1 Started · 2 Spawned · 3 First Attack · 4 Survived 3 Min · 5 Survived 10 Min · 6 Reached The End
--   Custom events (CustomField01 = mod):
--     Eliminated (değer: hayatta kalınan dakika; alan 2: deneyim, alan 3: kim eledi: Nation / Bot / Real Player / Unknown)
--     Quit Situation / Left Situation (değer: dakika; alan 2: o an ne oluyordu, alan 3: toprak sıralaması): maç bitmeden
--       oyundan çıktı (Quit) / ana menüye döndü (Left). Durum: Choosing spawn · Not spawned · Under attack · Losing land ·
--       Idle · Growing · Holding · No report (ilk anlık görüntüden önce çıktı). Sıralama: Top 3 · Top 10 · Lower · No land.
--     (2026-11-09, RoWorld'de olup bizde olmayanlar)
--     Match Start (alan 3: harita) · Match End (değer: dakika; alan 3: Won / Lost / Eliminated / Left / Quit Game) ·
--     Final Rank (değer: sıra, tur sonunda ayaktaysa) · How To Play (alan 1: Title / In Match) · Spectate ·
--     Takeover Offered · Quit FPS / Left FPS (değer: kare hızı; alan 2: aralık, alan 3: deneyim) ·
--     Slow Frames Client (değer: kare hızı; alan 2: bellek aralığı, alan 3: deneyim; maç başına bir kez)
--     (sunucunun kendi olayları: Server.Wallet ve Server.MatchServer: Crate Opened, Item Equipped, Medals Earned, Medals Spent,
--     Daily Reward, Solo Boost Used, Takeover Used, Public Match Humans)
--   Mod: Tutorial · Solo Easy / Normal / Hard / Insane · Online Solo · Online Teams. Deneyim: bu maçtan önceki maç sayısı
--   ("1st match", "2nd-5th match", "6th+ match"; Server.Profile sayar).
--
--   Analytics.start(profile)          remote'u kurar, oyuncuları dinler
--   Analytics.report(player, kind, a, b, c)   istemcinin bildirimi (testler doğrudan çağırabilir)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Telemetry = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Telemetry"))

local Analytics = {}

Analytics.REMOTE = "FrontlineAnalytics"
Analytics.ONBOARDING = {
	"Joined Game",
	"Title Screen",
	"Match Started",
	"Spawned",
	"First Attack",
	"Survived 3 Min",
	"Survived 10 Min",
	"Second Match",
}
Analytics.FUNNEL = "Match"
Analytics.FUNNEL_STEPS = { "Started", "Spawned", "First Attack", "Survived 3 Min", "Survived 10 Min", "Reached The End" }
Analytics.MODES = {
	tutorial = "Tutorial",
	easy = "Solo Easy",
	normal = "Solo Normal",
	hard = "Solo Hard",
	insane = "Solo Insane",
	online = "Online Solo",
	teams = "Online Teams",
}
Analytics.KILLERS = { nation = "Nation", bot = "Bot", human = "Real Player" }
Analytics.SITUATIONS = {
	["Choosing spawn"] = true,
	["Not spawned"] = true,
	["Under attack"] = true,
	["Losing land"] = true,
	["Idle"] = true,
	["Growing"] = true,
	["Holding"] = true,
}
Analytics.STANDINGS = { ["Top 3"] = true, ["Top 10"] = true, ["Lower"] = true, ["No land"] = true }
Analytics.MAX_MINUTES = 240
--- Aynı oyuncunun iki maç başlangıcı arasında en az bu kadar saniye (istemci boş yere olay üretemesin).
Analytics.START_GAP_S = 5

type Match = {
	mode: string,
	exp: string,
	key: string,
	steps: { [number]: boolean },
	minutes: number,
	ended: boolean,
	snap: { situation: string, standing: string, fps: number? }?,
	slow: boolean?,
}

local function fpsBand(f: number): string
	return if f < 15 then "Under 15" elseif f < 30 then "15-29" elseif f < 50 then "30-49" else "50+"
end

local function memBand(mb: number?): string
	if mb == nil then
		return "Unknown"
	end
	return if mb < 1024 then "Under 1 GB" elseif mb < 2048 then "1-2 GB" elseif mb < 3072 then "2-3 GB" elseif mb < 4096 then "3-4 GB" else "4+ GB"
end

--- Harita adı: yalnız harf / rakam / boşluk, kısa (alan değeri sınırlı kalsın).
local function cleanName(v: any): string
	if type(v) ~= "string" then
		return "Unknown"
	end
	local s = string.sub(string.gsub(v, "[^%w ]", ""), 1, 24)
	return if s == "" then "Unknown" else s
end
type Entry = { onboarding: { [number]: boolean }, match: Match?, startedAt: number }

local entries: { [any]: Entry } = {}
--- Server.Profile (maç sayacı); testlerde yok olabilir.
local profile: any = nil

local function entry(player: any): Entry
	local e = entries[player]
	if e == nil then
		e = { onboarding = {}, match = nil, startedAt = -1e9 }
		entries[player] = e
	end
	return e
end

function Analytics.experience(before: number): string
	if before <= 0 then
		return "1st match"
	elseif before < 5 then
		return "2nd-5th match"
	end
	return "6th+ match"
end

local function minutes(v: any): number?
	local n = tonumber(v)
	if n == nil or n ~= n then
		return nil
	end
	return math.floor(math.clamp(n, 0, Analytics.MAX_MINUTES) * 10 + 0.5) / 10
end

local function onboard(player: any, e: Entry, step: number)
	if e.onboarding[step] then
		return
	end
	e.onboarding[step] = true
	Telemetry.onboarding(player, step, Analytics.ONBOARDING[step])
end

local function funnel(player: any, m: Match, step: number)
	if m.steps[step] then
		return
	end
	m.steps[step] = true
	Telemetry.funnel(player, Analytics.FUNNEL, m.key, step, Analytics.FUNNEL_STEPS[step], { m.mode, m.exp })
end

-- Maç biter; oyundan çıkma / menüye dönme ise o anki durum kaydedilir (istemcinin son anlık görüntüsü).
local function endMatch(player: any, e: Entry, result: string, mins: number?, won: boolean?)
	local m = e.match
	if m == nil or m.ended then
		return
	end
	m.ended = true
	if mins ~= nil and mins > m.minutes then
		m.minutes = mins
	end
	if result == "Quit" or result == "Left" then
		local snap = m.snap or { situation = "No report", standing = "No land" }
		Telemetry.event(player, result .. " Situation", m.minutes, { m.mode, snap.situation, snap.standing })
		if snap.fps then
			Telemetry.event(player, result .. " FPS", snap.fps, { m.mode, fpsBand(snap.fps), m.exp })
		end
	end
	local name = if result == "Over" then (if won then "Won" else "Lost") elseif result == "Quit" then "Quit Game" else result
	Telemetry.event(player, "Match End", m.minutes, { m.mode, m.exp, name })
end

--- İstemcinin bildirimi. Türler: "title" · "match_start" (mod) · "spawned" · "attack" · "alive" (dakika) ·
--- "eliminated" (dakika, kim: nation | bot | human) · "over" (dakika) · "state" (durum, sıralama) · "left" (dakika).
function Analytics.report(player: any, kind: any, a: any, b: any, c: any)
	if type(kind) ~= "string" then
		return
	end
	local e = entry(player)
	local m = e.match
	local open = m ~= nil and not m.ended
	if kind == "title" then
		onboard(player, e, 2)
	elseif kind == "match_start" then
		local mode = if type(a) == "string" then Analytics.MODES[a] else nil
		local now = os.clock()
		if mode == nil or now - e.startedAt < Analytics.START_GAP_S then
			return
		end
		e.startedAt = now
		if open then
			endMatch(player, e, "Left")
		end
		local before = 0
		if profile then
			local ok, n = pcall(profile.countMatch, player)
			before = if ok and type(n) == "number" then n else 0
		end
		local nm: Match = {
			mode = mode,
			exp = Analytics.experience(before),
			key = HttpService:GenerateGUID(false),
			steps = {},
			minutes = 0,
			ended = false,
		}
		e.match = nm
		onboard(player, e, 3)
		if before >= 1 then
			onboard(player, e, 8)
		end
		funnel(player, nm, 1)
		Telemetry.event(player, "Match Start", 1, { nm.mode, nm.exp, cleanName(b) })
	elseif kind == "howto" then
		Telemetry.event(player, "How To Play", 1, { if a == "match" then "In Match" else "Title" })
	elseif kind == "spectate" or kind == "takeover_offered" then
		-- (elendikten sonra: maç kapanmış olabilir, son maçın alanlarıyla; oyuncu başına maçta bir kez)
		if m == nil then
			return
		end
		local key = "sent_" .. kind
		if (m :: any)[key] then
			return
		end
		;(m :: any)[key] = true
		Telemetry.event(player, if kind == "spectate" then "Spectate" else "Takeover Offered", 1, { m.mode, m.exp })
	elseif not open then
		return
	elseif kind == "spawned" then
		onboard(player, e, 4)
		funnel(player, m :: Match, 2)
	elseif kind == "attack" then
		onboard(player, e, 5)
		funnel(player, m :: Match, 3)
	elseif kind == "alive" then
		local mins = minutes(a)
		local mm = m :: Match
		if mins == nil then
			return
		end
		if mins > mm.minutes then
			mm.minutes = mins
		end
		if mm.minutes >= 3 then
			onboard(player, e, 6)
			funnel(player, mm, 4)
		end
		if mm.minutes >= 10 then
			onboard(player, e, 7)
			funnel(player, mm, 5)
		end
	elseif kind == "eliminated" then
		local mm = m :: Match
		local mins = minutes(a) or mm.minutes
		local killer = if type(b) == "string" and Analytics.KILLERS[b] then Analytics.KILLERS[b] else "Unknown"
		Telemetry.event(player, "Eliminated", mins, { mm.mode, mm.exp, killer })
		endMatch(player, e, "Eliminated", mins)
	elseif kind == "over" then
		local mm = m :: Match
		funnel(player, mm, 6)
		local rank = tonumber(c)
		if rank and rank == rank and rank >= 1 then
			Telemetry.event(player, "Final Rank", math.min(math.floor(rank), 1000), { mm.mode, mm.exp })
		end
		endMatch(player, e, "Over", minutes(a), b == true)
	elseif kind == "slow" then
		local mm = m :: Match
		local f = tonumber(a)
		if mm.slow or f == nil or f ~= f then
			return
		end
		mm.slow = true
		Telemetry.event(player, "Slow Frames Client", math.clamp(math.floor(f), 0, 240), { mm.mode, memBand(tonumber(b)), mm.exp })
	elseif kind == "state" then
		if Analytics.SITUATIONS[a] and Analytics.STANDINGS[b] then
			local f = tonumber(c)
			;(m :: Match).snap = { situation = a, standing = b, fps = if f and f == f then math.clamp(math.floor(f), 0, 240) else nil }
		end
	elseif kind == "left" then
		endMatch(player, e, "Left", minutes(a))
	end
end

--- Oyuncu sunucudan çıktı: açık maç "Quit" olarak biter.
function Analytics.left(player: any)
	local e = entries[player]
	if e == nil then
		return
	end
	endMatch(player, e, "Quit")
	entries[player] = nil
end

--- Testler: herkesi unutur.
function Analytics.reset()
	table.clear(entries)
end

function Analytics.start(profileModule: any?)
	profile = profileModule
	if ReplicatedStorage:FindFirstChild(Analytics.REMOTE) then
		return
	end
	local remote = Instance.new("RemoteEvent")
	remote.Name = Analytics.REMOTE
	remote.Parent = ReplicatedStorage
	-- (oyuncu başına saniyede en çok 10 bildirim)
	local rate: { [Player]: { at: number, n: number } } = {}
	remote.OnServerEvent:Connect(function(p: Player, kind: any, a: any, b: any, c: any)
		local now = os.clock()
		local r = rate[p]
		if r == nil or now - r.at >= 1 then
			r = { at = now, n = 0 }
			rate[p] = r
		end
		r.n += 1
		if r.n > 10 then
			return
		end
		local ok, err = pcall(Analytics.report, p, kind, a, b, c)
		if not ok then
			warn("[Analytics] " .. tostring(err))
		end
	end)
	local function joined(p: Player)
		onboard(p, entry(p), 1)
	end
	Players.PlayerAdded:Connect(joined)
	for _, p in Players:GetPlayers() do
		joined(p)
	end
	Players.PlayerRemoving:Connect(function(p: Player)
		rate[p] = nil
		Analytics.left(p)
	end)
end

return Analytics
]]></ProtectedString>
