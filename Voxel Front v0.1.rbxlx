			<Item class="LocalScript" referent="RBX189313568B444292A6AD5F6B30BC5E94">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
-- İstemci: haritayı çizer, sunucudan gelen değişimleri uygular, girdiyi niyete çevirir.
-- İstemci oyun mantığı çalıştırmaz; sahiplik ve asker değerleri her zaman sunucudan gelir.

local Fonts = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Fonts"))
local AssetService = game:GetService("AssetService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
