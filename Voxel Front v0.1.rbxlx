				<Item class="ModuleScript" referent="RBXEAAADB7C2DB84FFCA9C916E49834DC51">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Aligner: fare koordinatı (ham ekran) ile GUI koordinatı arasındaki kaymayı ÖLÇER.
-- Saf mantık; Roblox API'si yok. Motorla konuşan ince katman Alignment.luau'dadır.
--
-- Fikir: imlecin altında 5x5'lik görünmez "sonda" hücreleri ızgarası tutarız. Oyun motoru fare
-- hareket edince hangi hücrenin içinde olduğunu kendi çizim sınırlarına göre bildirir. O hücrenin
-- merkezi, imlecin GUI koordinatındaki yeridir; kayma = ham konum - hücre merkezi. Her vuruşta ızgara
-- küçülür (80px -> 32 -> 13 -> 6 -> 2px), yani kayma bilinen bir aday listesine ihtiyaç duymadan,
-- cihaz ne olursa olsun yaklaşık 1px doğrulukla bulunur.
-- Ölçek farkı varsa (kayma konuma göre değişiyorsa) imleç yeterince uzaklaşınca ölçüm yenilenir.

local Aligner = {}
Aligner.__index = Aligner

local GRID = 5 -- ızgara kenar hücre sayısı
local INITIAL_RADIUS = 200 -- ilk aramada kaymanın en fazla bu kadar olabileceği varsayılır (piksel)
local MIN_RADIUS = 4
local RECHECK_RADIUS = 40
local RECHECK_DIST_START = 60 -- ölçümden bu kadar uzaklaşınca yeniden ölç (piksel)
local RECHECK_DIST_MAX = 1e6
local CONVERGE_TOL = 2 -- ardışık iki ince ölçüm bu kadar yakınsa ölçüm tamam sayılır
local FINE_CELL = 2

Aligner.CELLS = GRID * GRID

export type Rect = { x: number, y: number, w: number, h: number }

export type Aligner = typeof(setmetatable(
	{} :: {
		offX: number, -- yürürlükteki kayma: GUI = ham - off (yalnızca ince ölçüm bitince güncellenir)
		offY: number,
		candX: number, -- çalışan tahmin (ızgarayı yönlendirir, kaba ölçümlerde oynar)
		candY: number,
		radius: number,
		cell: number,
		converged: boolean,
		everConverged: boolean,
		agree: number,
		anchorX: number,
		anchorY: number,
		recheckDist: number,
		recheckFromX: number,
		recheckFromY: number,
		rechecking: boolean,
		rects: { Rect },
	},
	Aligner
))

function Aligner.new(): Aligner
	local rects: { Rect } = {}
	for k = 1, GRID * GRID do
		rects[k] = { x = 0, y = 0, w = 0, h = 0 }
	end
	return setmetatable({
		offX = 0,
		offY = 0,
		candX = 0,
		candY = 0,
		radius = INITIAL_RADIUS,
		cell = 0,
		converged = false,
		everConverged = false,
		agree = 0,
		anchorX = 0,
		anchorY = 0,
		recheckDist = RECHECK_DIST_START,
		recheckFromX = 0,
		recheckFromY = 0,
		rechecking = false,
		rects = rects,
	}, Aligner)
end

-- Ham koordinatı GUI koordinatına çevirir.
function Aligner.toGui(self: Aligner, rawX: number, rawY: number): (number, number)
	if self.everConverged then
		return rawX - self.offX, rawY - self.offY
	end
	return rawX - self.candX, rawY - self.candY
end

-- Sondalar şu an gerekli mi? (Her çizim karesinde çağır.)
-- Ölçüm bittiyse ve imleç ölçüm noktasından yeterince uzaklaşmadıysa false döner.
function Aligner.active(self: Aligner, rawX: number, rawY: number): boolean
	if not self.converged then
		return true
	end
	local dx = rawX - self.anchorX
	local dy = rawY - self.anchorY
	if dx * dx + dy * dy >= self.recheckDist * self.recheckDist then
		self.converged = false
		self.rechecking = true
		self.recheckFromX = self.offX
		self.recheckFromY = self.offY
		self.candX = self.offX
		self.candY = self.offY
		self.radius = RECHECK_RADIUS
		self.agree = 0
		return true
	end
	return false
end

-- Sonda hücrelerini imlecin (tahmini) altına dizer. Dönen dizi yeniden kullanılır; sakla ama değiştirme.
function Aligner.layout(self: Aligner, rawX: number, rawY: number): { Rect }
	local cell = math.max(FINE_CELL, math.ceil(2 * self.radius / GRID))
	local total = cell * GRID
	local gx = rawX - self.candX
	local gy = rawY - self.candY
	local x0 = math.floor(gx - total / 2 + 0.5)
	local y0 = math.floor(gy - total / 2 + 0.5)
	self.cell = cell
	for j = 0, GRID - 1 do
		for i = 0, GRID - 1 do
			local r = self.rects[j * GRID + i + 1]
			r.x = x0 + i * cell
			r.y = y0 + j * cell
			r.w = cell
			r.h = cell
		end
	end
	return self.rects
end

-- Motor "imleç `index` numaralı sonda hücresinin içinde" dedi; rawX/rawY o anki ham fare konumu.
function Aligner.hit(self: Aligner, index: number, rawX: number, rawY: number)
	if self.converged then
		return
	end
	local r = self.rects[index]
	if not r or r.w <= 0 then
		return
	end
	local cx = r.x + r.w / 2
	local cy = r.y + r.h / 2
	local newX = rawX - cx
	local newY = rawY - cy
	local dx = newX - self.candX
	local dy = newY - self.candY
	self.candX = newX
	self.candY = newY

	if r.w <= FINE_CELL then
		if math.abs(dx) <= CONVERGE_TOL and math.abs(dy) <= CONVERGE_TOL then
			self.agree += 1
		else
			self.agree = 0
		end
		if self.agree >= 2 then
			self.converged = true
			self.everConverged = true
			self.offX = self.candX
			self.offY = self.candY
			self.anchorX = rawX
			self.anchorY = rawY
			if self.rechecking then
				-- Yenileme öncekiyle aynı çıktıysa kayma sabittir: bir sonraki yenilemeyi uzağa at.
				local same = math.abs(newX - self.recheckFromX) <= CONVERGE_TOL
					and math.abs(newY - self.recheckFromY) <= CONVERGE_TOL
				if same then
					self.recheckDist = math.min(self.recheckDist * 2, RECHECK_DIST_MAX)
				else
					self.recheckDist = RECHECK_DIST_START
				end
				self.rechecking = false
			end
		end
	end
	-- Belirsizlik ±hücre/2; bir sonraki ızgara en az bir hücre yarıçaplı olsun.
	self.radius = math.max(MIN_RADIUS, r.w)
end

return Aligner
]]></ProtectedString>
						<string name="ScriptGuid">{E9C3B069-28D8-4EAF-8B36-4B3EA679A7B2}</string>
