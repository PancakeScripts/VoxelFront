						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- MapRenderer: arazi + sahiplik renklerini tek bir EditableImage'a yazar.
-- Değişen tile'lar 64x64'lük parçalara (chunk) işaretlenir; flush yalnızca kirli parçaları günceller.
-- Böylece küçük bir değişim için 512x512'lik tüm görüntü yeniden yazılmaz.

local CHUNK = 64
local BLOCK_W = 960 -- EditableImage en çok 1024x1024 olur; büyük harita 960'lık bloklara bölünür (64'ün katı)
local BLOCK_H = 960
local TRAIL_BLEND = 0.85 -- iz rengi / altındaki renk
local TERRITORY_ALPHA = 0.588 -- bölge rengi / arazi karışımı (OpenFront territoryAlpha)
local HIGHLIGHT = 0.25 -- üstüne gelinen ülkenin parlaklığı (OpenFront highlightBrighten)

local MapRenderer = {}
MapRenderer.__index = MapRenderer

export type MapRenderer = typeof(setmetatable(
	{} :: {
		editables: { any }, -- blok görüntüleri, satır satır soldan sağa
		w: number,
		h: number,
		base: buffer, -- yalnızca arazi pikselleri
		pixels: buffer, -- arazi + sahiplik
		owner: buffer, -- u16 sahip kimliği (istemcideki kopya)
		rail: buffer, -- u8: bu tile'dan kaç ray geçiyor
		trail: buffer, -- u32: gemi / bomba izi rengi (0 = iz yok)
		colors: { [number]: { number } },
		colorOf: (number) -> (number, number, number),
		borderOf: (number, number, number, number) -> (number, number, number),
		relation: (number, number) -> number, -- 0 nötr, 1 ittifak, 2 ambargo
		-- sınır ilişki tonu (repo embargo/friendlyTintRatio); varsayılan beyaza açma yok (Look.Border)
		tint: { ratio: number, otherLighten: number, otherRatio: number, warRatio: number?, war: { number }, ally: { number } },
		localPid: number, -- yerel oyuncu (onun sınırı açılmaz: zaten açık gri)
		highlight: number, -- üstüne gelinen ülke (0 = yok)
		dirty: { [number]: boolean },
		dirtyCount: number,
		-- oyuncu başına sınır kutusu (yalnız büyür; tam yüklemede kesin hesaplanır): ilişki değişince yeniden boyanacak alan
		bx0: { [number]: number },
		by0: { [number]: number },
		bx1: { [number]: number },
		by1: { [number]: number },
		queue: { { number } }, -- bekleyen yeniden boyama dikdörtgenleri (kareye bütçeyle yayılır)
		chunksX: number,
		chunkBuf: buffer,
	},
	MapRenderer
))

function MapRenderer.blockCount(w: number, h: number): number
	return math.ceil(w / BLOCK_W) * math.ceil(h / BLOCK_H)
end

-- i. bloğun haritadaki yeri: x0, y0, genişlik, yükseklik.
function MapRenderer.blockRect(i: number, w: number, h: number): (number, number, number, number)
	local cols = math.ceil(w / BLOCK_W)
	local x0 = ((i - 1) % cols) * BLOCK_W
	local y0 = ((i - 1) // cols) * BLOCK_H
	return x0, y0, math.min(BLOCK_W, w - x0), math.min(BLOCK_H, h - y0)
end

function MapRenderer.new(
	editables: { any },
	w: number,
	h: number,
	basePixels: buffer,
	colorOf: (number) -> (number, number, number),
	borderOf: (number, number, number, number) -> (number, number, number)
): MapRenderer
	local pixels = buffer.create(buffer.len(basePixels))
	buffer.copy(pixels, 0, basePixels)
	return setmetatable({
		editables = editables,
		w = w,
		h = h,
		base = basePixels,
		pixels = pixels,
		owner = buffer.create(w * h * 2),
		rail = buffer.create(w * h),
		trail = buffer.create(w * h * 4),
		colors = {},
		colorOf = colorOf,
		borderOf = borderOf,
		relation = function()
			return 0
		end,
		tint = { ratio = 0.35, otherLighten = 0, otherRatio = 0.35, war = { 255, 0, 0 }, ally = { 0, 255, 0 } },
		localPid = 0,
		highlight = 0,
		dirty = {},
		dirtyCount = 0,
		bx0 = {},
		by0 = {},
		bx1 = {},
		by1 = {},
		queue = {},
		chunksX = math.ceil(w / CHUNK),
		chunkBuf = buffer.create(CHUNK * CHUNK * 4),
	}, MapRenderer)
end

-- Tüm haritayı bloklara yazar (ilk çizim). Kirli işaretleri temizler. pace (isteğe bağlı): bloklar arasında çağrılır.
function MapRenderer.writeAll(self: MapRenderer, pace: (() -> ())?)
	for bi, img in self.editables do
		local x0, y0, bw, bh = MapRenderer.blockRect(bi, self.w, self.h)
		local buf = buffer.create(bw * bh * 4)
		for row = 0, bh - 1 do
			buffer.copy(buf, row * bw * 4, self.pixels, ((y0 + row) * self.w + x0) * 4, bw * 4)
		end
		if pace then
			pace()
		end
		img:WritePixelsBuffer(Vector2.zero, Vector2.new(bw, bh), buf)
		if pace then
			pace()
		end
	end
	table.clear(self.dirty)
	self.dirtyCount = 0
end

function MapRenderer.markChunk(self: MapRenderer, tile: number)
	local x = tile % self.w
	local y = tile // self.w
	local c = (y // CHUNK) * self.chunksX + (x // CHUNK)
	if not self.dirty[c] then
		self.dirty[c] = true
		self.dirtyCount += 1
	end
end

local function playerRgb(self: MapRenderer, pid: number): { number }
	local c = self.colors[pid]
	if not c then
		local r, g, b = self.colorOf(pid)
		local br, bg, bb = self.borderOf(pid, r, g, b)
		-- dolgu doygunluğu %85 (OpenFront territorySaturation)
		local luma = 0.299 * r + 0.587 * g + 0.114 * b
		local sat = 0.85
		c = { luma + (r - luma) * sat, luma + (g - luma) * sat, luma + (b - luma) * sat, br, bg, bb }
		self.colors[pid] = c
	end
	return c
end

-- Sınır ilişki tonu ayarı (Look.Border): tintRatio = benim sınırımda karışım oranı (repo 0.35); diğer ülkelerin
-- sınırı önce otherLighten oranında beyaza açılır, sonra otherTintRatio ile tonlanır (repoda 0 / 0.35: koyu kalır).
function MapRenderer.setBorderTint(self: MapRenderer, cfg: any)
	local function rgb(c: Color3): { number }
		return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
	end
	self.tint = {
		ratio = cfg.tintRatio,
		otherLighten = cfg.otherLighten,
		otherRatio = cfg.otherTintRatio,
		warRatio = cfg.warTintRatio,
		war = rgb(cfg.warTint),
		ally = rgb(cfg.allyTint),
	}
end

-- Toprak skini (Shared.Cosmetics; RoWorld MapSurface'in skin çizimi): pid'in toprağının içinde maskenin '#' kareleri ikinci
-- renkte (Cosmetics.second) ve Cosmetics.SECONDARY_ALPHA opaklığıyla çizilir. skin nil = düz renk. Toprağı yeniden boyanır.
function MapRenderer.setSkin(self: MapRenderer, pid: number, skin: any)
	local skins = (self :: any).skins
	if skins == nil then
		skins = {}
		;(self :: any).skins = skins
	end
	if skin == nil then
		skins[pid] = nil
	else
		local bits = {}
		for i, row in skin.mask do
			local r = {}
			for x = 1, #row do
				r[x] = string.sub(row, x, x) == "#"
			end
			bits[i] = r
		end
		skins[pid] = { skin = skin, bits = bits, h = #skin.mask, w = #skin.mask[1], step = 2 ^ (skin.scale or 0), rgb = nil }
	end
	self:recolor(pid)
end

-- Renk önbelleğini siler (oyuncu türü değişince).
function MapRenderer.resetColors(self: MapRenderer)
	table.clear(self.colors)
end

-- Tek oyuncunun rengi değişti (takımı belli oldu): önbelleği silinir, toprağının kutusu kuyruğa eklenir (kareye yayılarak boyanır).
function MapRenderer.recolor(self: MapRenderer, pid: number)
	self.colors[pid] = nil
	if self.bx0[pid] ~= nil then
		table.insert(self.queue, { self.bx0[pid], self.by0[pid], self.bx1[pid], self.by1[pid] })
	end
end

local FALLOUT_BIT = 0x8000

local function paintBase(self: MapRenderer, tile: number, value: number)
	local o = tile * 4
	local pid = bit32.band(value, 0x7FFF)
	if value >= FALLOUT_BIT then
		-- serpinti: arazi rengi koyulaşıp yeşilimsi bir renge kayar
		local k = 0.6
		buffer.writeu8(self.pixels, o, math.floor(buffer.readu8(self.base, o) * (1 - k) + 95 * k + 0.5))
		buffer.writeu8(self.pixels, o + 1, math.floor(buffer.readu8(self.base, o + 1) * (1 - k) + 120 * k + 0.5))
		buffer.writeu8(self.pixels, o + 2, math.floor(buffer.readu8(self.base, o + 2) * (1 - k) + 40 * k + 0.5))
		buffer.writeu8(self.pixels, o + 3, 255)
		return
	end
	if pid == 0 then
		buffer.writeu32(self.pixels, o, buffer.readu32(self.base, o))
		return
	end
	local c = playerRgb(self, pid)
	local x = tile % self.w
	local own = self.owner
	local w = self.w
	-- Sınır: dört komşudan biri başka sahipliyse (su ve sahipsiz toprak dahil) sınır renginde çizilir.
	-- Komşu başka bir oyuncuysa ilişkiye göre renk kayar: ittifak yeşile, ambargo (saldırı dahil) kırmızıya (%35).
	local border = x == 0 or x == w - 1 or tile < w or tile >= w * (self.h - 1)
	local rel = 0
	local size = w * self.h
	local function look(t: number)
		local n = bit32.band(buffer.readu16(own, t * 2), 0x7FFF)
		if n ~= pid then
			border = true
			if n ~= 0 then
				local r = self.relation(pid, n)
				if r > rel then
					rel = r
				end
			end
		end
	end
	if x > 0 then
		look(tile - 1)
	end
	if x < w - 1 then
		look(tile + 1)
	end
	if tile >= w then
		look(tile - w)
	end
	if tile < size - w then
		look(tile + w)
	end
	if border then
		local r, g, b = c[4], c[5], c[6]
		if pid == self.highlight then
			r, g, b = r + (255 - r) * HIGHLIGHT, g + (255 - g) * HIGHLIGHT, b + (255 - b) * HIGHLIGHT
		end
		if rel ~= 0 then
			-- Repo: ülkenin sınır rengine %35 ilişki tonu; varsayılan beyaza açma yok.
			local T = self.tint
			local k = T.ratio
			if pid ~= self.localPid then
				local L = T.otherLighten
				r, g, b = r + (255 - r) * L, g + (255 - g) * L, b + (255 - b) * L
				k = T.otherRatio
			end
			if rel == 2 and T.warRatio then
				k = T.warRatio -- (savaş kırmızısı ayrı, daha güçlü)
			end
			local tc = if rel == 2 then T.war else T.ally
			r, g, b = r * (1 - k) + tc[1] * k, g * (1 - k) + tc[2] * k, b * (1 - k) + tc[3] * k
		end
		buffer.writeu8(self.pixels, o, math.floor(r + 0.5))
		buffer.writeu8(self.pixels, o + 1, math.floor(g + 0.5))
		buffer.writeu8(self.pixels, o + 2, math.floor(b + 0.5))
		buffer.writeu8(self.pixels, o + 3, 255)
		return
	end
	local k = TERRITORY_ALPHA
	local cr, cg, cb = c[1], c[2], c[3]
	local skins = (self :: any).skins
	local sk = if skins then skins[pid] else nil
	if sk then
		local row = sk.bits[((tile // w) // sk.step) % sk.h + 1]
		if row[(x // sk.step) % sk.w + 1] then
			local s = sk.rgb
			if s == nil or s[4] ~= c then
				-- (ikinci renk sahibin dolgu renginden; renk değişince yeniden)
				local col = sk.skin.second(sk.skin, Color3.new(c[1] / 255, c[2] / 255, c[3] / 255))
				s = { col.R * 255, col.G * 255, col.B * 255, c }
				sk.rgb = s
			end
			cr, cg, cb = s[1], s[2], s[3]
			k = sk.skin.alpha
		end
	end
	if pid == self.highlight then
		local m = 1 + HIGHLIGHT -- repo: renkler orta griden uzaklaşır
		cr, cg, cb = math.clamp((cr - 127.5) * m + 127.5, 0, 255), math.clamp((cg - 127.5) * m + 127.5, 0, 255), math.clamp((cb - 127.5) * m + 127.5, 0, 255)
	end
	buffer.writeu8(self.pixels, o, math.floor(buffer.readu8(self.base, o) * (1 - k) + cr * k + 0.5))
	buffer.writeu8(self.pixels, o + 1, math.floor(buffer.readu8(self.base, o + 1) * (1 - k) + cg * k + 0.5))
	buffer.writeu8(self.pixels, o + 2, math.floor(buffer.readu8(self.base, o + 2) * (1 - k) + cb * k + 0.5))
	buffer.writeu8(self.pixels, o + 3, 255)
end

local RAIL_COLOR = { 70, 50, 32 }
local RAIL_BLEND = 0.8

function MapRenderer.paint(self: MapRenderer, tile: number, value: number)
	paintBase(self, tile, value)
	if buffer.readu8(self.rail, tile) > 0 then
		local o = tile * 4
		local k = RAIL_BLEND
		for c = 0, 2 do
			buffer.writeu8(self.pixels, o + c, math.floor(buffer.readu8(self.pixels, o + c) * (1 - k) + RAIL_COLOR[c + 1] * k + 0.5))
		end
	end
	local tr = buffer.readu32(self.trail, tile * 4)
	if tr ~= 0 then
		local o = tile * 4
		local k = TRAIL_BLEND
		buffer.writeu8(self.pixels, o, math.floor(buffer.readu8(self.pixels, o) * (1 - k) + (tr % 256) * k + 0.5))
		buffer.writeu8(self.pixels, o + 1, math.floor(buffer.readu8(self.pixels, o + 1) * (1 - k) + ((tr // 256) % 256) * k + 0.5))
		buffer.writeu8(self.pixels, o + 2, math.floor(buffer.readu8(self.pixels, o + 2) * (1 - k) + ((tr // 65536) % 256) * k + 0.5))
	end
end

-- Demiryolu katmanı: ray tile'ları sayılır (iki ray aynı tile'ı paylaşabilir), değişen tile yeniden boyanır.
-- İz katmanı: iki nokta arasını kesintisiz (8 bağlantılı) çizgiyle boyar. Yazılan tile'lar `out` listesine eklenir;
-- başka bir izin tile'ı ezilmez. Çizgi tile çözünürlüğünde olduğundan her zoom'da kesintisiz görünür.
function MapRenderer.trailLine(self: MapRenderer, x0: number, y0: number, x1: number, y1: number, packed: number, out: { number })
	local dx, dy = math.abs(x1 - x0), math.abs(y1 - y0)
	local sx = if x0 < x1 then 1 else -1
	local sy = if y0 < y1 then 1 else -1
	local err = dx - dy
	local w = self.w
	while true do
		if x0 >= 0 and x0 < w and y0 >= 0 and y0 < self.h then
			local t = y0 * w + x0
			if buffer.readu32(self.trail, t * 4) == 0 then
				buffer.writeu32(self.trail, t * 4, packed)
				out[#out + 1] = t
				self:paint(t, buffer.readu16(self.owner, t * 2))
				self:markChunk(t)
			end
		end
		if x0 == x1 and y0 == y1 then
			break
		end
		local e2 = 2 * err
		if e2 > -dy then
			err -= dy
			x0 += sx
		end
		if e2 < dx then
			err += dx
			y0 += sy
		end
	end
end

function MapRenderer.clearTrail(self: MapRenderer, tiles: { number })
	for _, t in tiles do
		buffer.writeu32(self.trail, t * 4, 0)
		self:paint(t, buffer.readu16(self.owner, t * 2))
		self:markChunk(t)
	end
	table.clear(tiles)
end

function MapRenderer.addRail(self: MapRenderer, tiles: { number })
	for _, t in tiles do
		if t >= 0 and t < self.w * self.h then
			local c = buffer.readu8(self.rail, t)
			if c < 255 then
				buffer.writeu8(self.rail, t, c + 1)
			end
			if c == 0 then
				self:paint(t, buffer.readu16(self.owner, t * 2))
				self:markChunk(t)
			end
		end
	end
end

function MapRenderer.removeRail(self: MapRenderer, tiles: { number })
	for _, t in tiles do
		if t >= 0 and t < self.w * self.h then
			local c = buffer.readu8(self.rail, t)
			if c > 0 then
				buffer.writeu8(self.rail, t, c - 1)
				if c == 1 then
					self:paint(t, buffer.readu16(self.owner, t * 2))
					self:markChunk(t)
				end
			end
		end
	end
end

function MapRenderer.clearRails(self: MapRenderer)
	buffer.fill(self.rail, 0, 0, buffer.len(self.rail))
end

function MapRenderer.setOwner(self: MapRenderer, tile: number, pid: number)
	if tile < 0 or tile >= self.w * self.h then
		return
	end
	if buffer.readu16(self.owner, tile * 2) == pid then
		return
	end
	buffer.writeu16(self.owner, tile * 2, pid)
	local p = bit32.band(pid, 0x7FFF)
	if p ~= 0 then
		local x, y = tile % self.w, tile // self.w
		local bx0 = self.bx0[p]
		if bx0 == nil then
			self.bx0[p], self.by0[p], self.bx1[p], self.by1[p] = x, y, x, y
		else
			if x < bx0 then
				self.bx0[p] = x
			elseif x > self.bx1[p] then
				self.bx1[p] = x
			end
			if y < self.by0[p] then
				self.by0[p] = y
			elseif y > self.by1[p] then
				self.by1[p] = y
			end
		end
	end
	self:paint(tile, pid)
	self:markChunk(tile)
	-- komşuların sınır durumu değişebilir
	local w = self.w
	local x = tile % w
	local size = w * self.h
	local function touch(t: number)
		self:paint(t, buffer.readu16(self.owner, t * 2))
		self:markChunk(t)
	end
	if x > 0 then
		touch(tile - 1)
	end
	if x < w - 1 then
		touch(tile + 1)
	end
	if tile >= w then
		touch(tile - w)
	end
	if tile < size - w then
		touch(tile + w)
	end
end

-- Sahiplik bufferı aynı kalır, tüm pikselleri yeniden boyar (renk önbelleği değişince).
function MapRenderer.repaintAll(self: MapRenderer)
	buffer.copy(self.pixels, 0, self.base)
	for i = 0, self.w * self.h - 1 do
		local v = buffer.readu16(self.owner, i * 2)
		if v ~= 0 then
			self:paint(i, v)
		end
	end
	local total = self.chunksX * math.ceil(self.h / CHUNK)
	for c = 0, total - 1 do
		if not self.dirty[c] then
			self.dirty[c] = true
			self.dirtyCount += 1
		end
	end
end

-- Dikdörtgen içindeki (x0..x1, y0..y1 dahil) sahipli tile'ları yeniden boyar; yalnız ilişki değişince, tüm haritayı taramadan.
function MapRenderer.repaintRect(self: MapRenderer, rx0: number, ry0: number, rx1: number, ry1: number)
	local x0 = math.max(0, rx0)
	local y0 = math.max(0, ry0)
	local x1 = math.min(self.w - 1, rx1)
	local y1 = math.min(self.h - 1, ry1)
	for y = y0, y1 do
		local row = y * self.w
		for x = x0, x1 do
			local v = buffer.readu16(self.owner, (row + x) * 2)
			if v ~= 0 then
				self:paint(row + x, v)
			end
		end
	end
	for cy = y0 // CHUNK, y1 // CHUNK do
		for cx = x0 // CHUNK, x1 // CHUNK do
			local c = cy * self.chunksX + cx
			if not self.dirty[c] then
				self.dirty[c] = true
				self.dirtyCount += 1
			end
		end
	end
end

-- Dikdörtgende yalnız `a` ya da `b`'ye ait sınır tile'larını yeniden boyar (iç tile'lar ilişkiden etkilenmez).
function MapRenderer.repaintPair(self: MapRenderer, x0: number, y0: number, x1: number, y1: number, a: number, b: number)
	local own = self.owner
	local w = self.w
	local size = w * self.h
	for y = y0, y1 do
		local row = y * w
		for x = x0, x1 do
			local t = row + x
			local v = buffer.readu16(own, t * 2)
			if v == a or v == b then
				-- komşulardan biri diğer oyuncuysa sınırdır
				local other = if v == a then b else a
				if (x > 0 and buffer.readu16(own, (t - 1) * 2) == other)
					or (x < w - 1 and buffer.readu16(own, (t + 1) * 2) == other)
					or (t >= w and buffer.readu16(own, (t - w) * 2) == other)
					or (t < size - w and buffer.readu16(own, (t + w) * 2) == other)
				then
					self:paint(t, v)
					self:markChunk(t)
				end
			end
		end
	end
end

-- İki oyuncu arasındaki ilişki değişti: aralarındaki sınır ancak iki kutunun (1 tile genişletilmiş) kesişiminde olabilir.
-- Bu dikdörtgen kuyruğa eklenir; processQueue her karede bütçe kadarını boyar (büyük alanlar takılma yapmaz).
function MapRenderer.queuePair(self: MapRenderer, a: number, b: number)
	local ax0, bx0 = self.bx0[a], self.bx0[b]
	if ax0 == nil or bx0 == nil then
		return -- ikisinden birinin toprağı yok: boyanacak sınır yok
	end
	local x0 = math.max(ax0, bx0) - 1
	local y0 = math.max(self.by0[a], self.by0[b]) - 1
	local x1 = math.min(self.bx1[a], self.bx1[b]) + 1
	local y1 = math.min(self.by1[a], self.by1[b]) + 1
	if x0 > x1 or y0 > y1 then
		return
	end
	table.insert(self.queue, { math.max(0, x0), math.max(0, y0), math.min(self.w - 1, x1), math.min(self.h - 1, y1), a, b })
end

-- Üstüne gelinen ülke değişti: eski ve yeni ülkenin kutusu kuyruğa eklenir (a / b olmayan dikdörtgen tümüyle boyanır).
function MapRenderer.setHighlight(self: MapRenderer, pid: number)
	local old = self.highlight
	if old == pid then
		return
	end
	self.highlight = pid
	for _, p in { old, pid } do
		if p ~= 0 and self.bx0[p] ~= nil then
			table.insert(self.queue, { self.bx0[p], self.by0[p], self.bx1[p], self.by1[p] })
		end
	end
end

-- Kuyruktaki dikdörtgenleri en çok `budget` tile boyayarak işler (yarım kalan dikdörtgen satırdan devam eder).
function MapRenderer.processQueue(self: MapRenderer, budget: number)
	local q = self.queue
	while budget > 0 and #q > 0 do
		local r = q[#q]
		local x0, y0, x1, y1 = r[1], r[2], r[3], r[4]
		local rowsFit = math.max(1, budget // (x1 - x0 + 1))
		local yEnd = math.min(y1, y0 + rowsFit - 1)
		if r[5] then
			self:repaintPair(x0, y0, x1, yEnd, r[5], r[6])
		else
			self:repaintRect(x0, y0, x1, yEnd)
		end
		budget -= (yEnd - y0 + 1) * (x1 - x0 + 1)
		if yEnd >= y1 then
			q[#q] = nil
		else
			r[2] = yEnd + 1
		end
	end
end

-- Oyuncunun toprağının kesin sınır kutusu ve ağırlık merkezi (tile birimi). Toprağı yoksa nil.
-- Yalnız oyuncunun büyüyen kutusu (bx0..bx1, by0..by1) taranır; tüm harita değil.
function MapRenderer.extentOf(self: MapRenderer, pid: number): (number?, number, number, number, number, number, number)
	local x0, y0, x1, y1 = self.bx0[pid], self.by0[pid], self.bx1[pid], self.by1[pid]
	if x0 == nil or y0 == nil or x1 == nil or y1 == nil then
		return nil, 0, 0, 0, 0, 0, 0
	end
	local w = self.w
	local own = self.owner
	local minX, minY, maxX, maxY = math.huge, math.huge, -1, -1
	local sx, sy, n = 0, 0, 0
	for y = y0, y1 do
		local row = y * w
		for x = x0, x1 do
			if bit32.band(buffer.readu16(own, (row + x) * 2), 0x7FFF) == pid then
				n += 1
				sx += x
				sy += y
				if x < minX then
					minX = x
				end
				if x > maxX then
					maxX = x
				end
				if y < minY then
					minY = y
				end
				if y > maxY then
					maxY = y
				end
			end
		end
	end
	if n == 0 then
		return nil, 0, 0, 0, 0, 0, 0
	end
	return n, minX, minY, maxX, maxY, sx / n, sy / n
end

function MapRenderer.ownerAt(self: MapRenderer, tile: number): number
	return bit32.band(buffer.readu16(self.owner, tile * 2), 0x7FFF)
end

-- Tam durumdan sıfırdan kurulum (ilk giriş veya yeniden senkron). `ownerBuf` u16 dizisidir.
function MapRenderer.loadOwners(self: MapRenderer, ownerBuf: buffer)
	buffer.copy(self.pixels, 0, self.base)
	buffer.copy(self.owner, 0, ownerBuf)
	table.clear(self.bx0)
	table.clear(self.by0)
	table.clear(self.bx1)
	table.clear(self.by1)
	table.clear(self.queue)
	local w = self.w
	local bx0, by0, bx1, by1 = self.bx0, self.by0, self.bx1, self.by1
	for i = 0, w * self.h - 1 do
		local pid = buffer.readu16(ownerBuf, i * 2)
		if pid ~= 0 then
			self:paint(i, pid) -- 0x8000 = serpintili sahipsiz tile
			local p = bit32.band(pid, 0x7FFF)
			if p ~= 0 then
				local x, y = i % w, i // w
				if bx0[p] == nil then
					bx0[p], by0[p], bx1[p], by1[p] = x, y, x, y
				else
					if x < bx0[p] then
						bx0[p] = x
					end
					if x > bx1[p] then
						bx1[p] = x
					end
					by1[p] = y -- satır satır gidildiğinden y yalnız büyür
				end
			end
		end
	end
	local total = self.chunksX * math.ceil(self.h / CHUNK)
	for c = 0, total - 1 do
		if not self.dirty[c] then
			self.dirty[c] = true
			self.dirtyCount += 1
		end
	end
end

-- Kirli parçaları görüntüye yazar. Döner: yazılan parça sayısı.
function MapRenderer.flush(self: MapRenderer): number
	if self.dirtyCount == 0 then
		return 0
	end
	local written = 0
	for c in self.dirty do
		local cx0 = (c % self.chunksX) * CHUNK
		local cy0 = (c // self.chunksX) * CHUNK
		local cw = math.min(CHUNK, self.w - cx0)
		local ch = math.min(CHUNK, self.h - cy0)
		-- Kenardaki parçalar 64x64'ten küçük olabilir: WritePixelsBuffer tam boyut ister.
		local buf = if cw == CHUNK and ch == CHUNK then self.chunkBuf else buffer.create(cw * ch * 4)
		for row = 0, ch - 1 do
			buffer.copy(buf, row * cw * 4, self.pixels, ((cy0 + row) * self.w + cx0) * 4, cw * 4)
		end
		local col, blockRow = cx0 // BLOCK_W, cy0 // BLOCK_H
		self.editables[blockRow * math.ceil(self.w / BLOCK_W) + col + 1]:WritePixelsBuffer(Vector2.new(cx0 - col * BLOCK_W, cy0 - blockRow * BLOCK_H), Vector2.new(cw, ch), buf)
		written += 1
	end
	table.clear(self.dirty)
	self.dirtyCount = 0
	return written
end

return MapRenderer
]]></ProtectedString>
