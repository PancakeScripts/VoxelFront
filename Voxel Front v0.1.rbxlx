						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">662b0abb37a5a9fc0b00fc9100004099</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX08FE8B72D5844788A145321C9BFD475D">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- CosmeticView: kasadan çıkan eşyaların maçta görünmesi (RoWorld: skin toprağın üstünde, bayrak adın solunda).
--   apply(p)          oyuncu istatistiğindeki giyilen skin (p.sk) haritaya (MapRenderer.setSkin)
--   placeFlag(...)    isim plakasının solu: gerçek oyuncunun Roblox headshot'ı (p.uid), bayrak takılıysa (p.fl) onun da solunda
--                     (bayrak | headshot | isim; RoWorld Cosmetics.face_image)
-- Solo maçta oyuncunun kendi giydikleri Server.Wallet'ın envanterinden maça verilir (localMatch.setCosmetics); online'da
-- sunucu verir.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))

local CosmeticView = {}
CosmeticView.__index = CosmeticView

function CosmeticView.new(renderer: any, localMatch: any)
	local self = setmetatable({}, CosmeticView) :: any
	self.renderer = renderer
	self.skinOf = {} :: { [number]: string }
	self.views = {} :: { [any]: any }
	if localMatch and localMatch.setCosmetics then
		local function give(inv: any)
			if type(inv) == "table" and inv.loaded ~= false then
				localMatch.setCosmetics(Players.LocalPlayer, inv.equipped)
			end
		end
		task.spawn(function()
			local remote = ReplicatedStorage:WaitForChild("FrontlineWallet", 60) :: RemoteEvent?
			if remote then
				remote.OnClientEvent:Connect(function(what: any, data: any)
					if what == "inv" then
						give(data)
					end
				end)
			end
			local fn = ReplicatedStorage:FindFirstChild("FrontlineWalletCall") :: RemoteFunction?
			if fn then
				local ok, data = pcall(function()
					return fn:InvokeServer("inv")
				end)
				if ok then
					give(data)
				end
			end
		end)
	end
	return self
end

--- Bir oyuncunun istatistiği geldi: skini değiştiyse harita yeniden boyanır.
function CosmeticView.apply(self: any, p: any)
	local id = if type(p.sk) == "string" then p.sk else ""
	if (self.skinOf[p.pid] or "") == id then
		return
	end
	self.skinOf[p.pid] = id
	local it = Cosmetics.item(id)
	if it and it.kind == "skin" then
		self.renderer:setSkin(p.pid, {
			mask = it.mask,
			scale = it.scale,
			alpha = Cosmetics.SECONDARY_ALPHA,
			second = function(_s: any, col: Color3): Color3
				return Cosmetics.second(it, col)
			end,
		})
	else
		self.renderer:setSkin(p.pid, nil)
	end
end

--- Plakanın headshot'ı ve bayrağı (v: isim plakası, fl: bayrak kimliği ya da nil, uid: gerçek oyuncunun Roblox kimliği
--- ya da nil). Adın hemen solunda headshot, onun solunda bayrak; adın boyunda.
function CosmeticView.placeFlag(self: any, v: any, fl: any, nameLabel: TextLabel, sx: number, sy: number, size: number, uid: any)
	-- (bayrağı ve headshot'ı olmayan plaka — uluslar, botlar — hiçbir şey ölçmez: her karede yüzlerce plaka)
	local hasFace = type(uid) == "number" and uid > 0
	if not hasFace and (fl == nil or v.flagId == nil and Cosmetics.item(fl) == nil) then
		if v.flag or v.face then
			CosmeticView.hideFlag(self, v, false)
		end
		return
	end
	local half = math.min(nameLabel.TextBounds.X, nameLabel.AbsoluteSize.X) / 2
	local left = sx - half - size * 0.2 -- (sonraki görselin sağ kenarı)
	local face = v.face :: ImageLabel?
	if type(uid) == "number" and uid > 0 then
		if face == nil then
			local l = Instance.new("ImageLabel")
			l.Name = "Headshot"
			l.BackgroundColor3 = Color3.fromRGB(30, 41, 59)
			l.BackgroundTransparency = 0.2
			l.AnchorPoint = Vector2.new(1, 0.5)
			l.ZIndex = nameLabel.ZIndex
			l.Active = false
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = l
			l.Parent = nameLabel.Parent
			v.face = l
			face = l
		end
		local f = face :: ImageLabel
		if v.faceId ~= uid then
			v.faceId = uid
			f.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", uid)
		end
		local d = size * 0.95
		f.Size = UDim2.fromOffset(d, d)
		f.Position = UDim2.fromOffset(left, sy)
		f.Visible = true
		left -= d + size * 0.15
	elseif face then
		face.Visible = false
	end
	local it = Cosmetics.item(fl)
	local img = v.flag :: ImageLabel?
	if it == nil or it.kind ~= "flag" then
		if img then
			img.Visible = false
		end
		return
	end
	if img == nil then
		local l = Instance.new("ImageLabel")
		l.Name = "CountryFlag"
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(1, 0.5)
		l.ZIndex = nameLabel.ZIndex
		l.Active = false
		l.Parent = nameLabel.Parent
		v.flag = l
		img = l
	end
	local flag = img :: ImageLabel
	if v.flagId ~= fl then
		v.flagId = fl
		Cosmetics.paint(flag, it)
	end
	local h = size * 0.75
	local w = h * it.w / math.max(it.h, 1)
	flag.Size = UDim2.fromOffset(w, h)
	flag.Position = UDim2.fromOffset(left, sy)
	flag.Visible = true
end

--- Plaka kalktı ya da gizlendi.
local KEYS = { "flag", "face" }
function CosmeticView.hideFlag(_self: any, v: any, destroy: boolean)
	if v.flag == nil and v.face == nil then
		return -- (her karede gizli plakalar için çağrılır: boşken hiçbir şey yapmaz)
	end
	for _, key in KEYS do
		local img = v[key] :: ImageLabel?
		if img then
			if destroy then
				img:Destroy()
				v[key] = nil
			else
				img.Visible = false
			end
		end
	end
end

return CosmeticView
]]></ProtectedString>
						<string name="ScriptGuid">{23A3C81D-271F-4DE1-9DBE-4687AEA4D930}</string>
