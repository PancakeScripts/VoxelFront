						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- ButtonDepth: düğmenin altında koyu bir "taban" (RoWorld'ün Leave düğmesi gibi kabarık görünüm).
-- Taban düğmenin kardeşidir (çocuk olsa düğmenin üstünde çizilirdi): aynı boyut ve köşe, aşağıda; kalınlık
-- yüksekliğin kareköküyle büyür (REF_H yüksekliğindeki düğmede DEPTH payı; büyük düğmede oransal olarak daha ince),
-- düğme renginin koyusu. Düğmenin yerini, boyutunu, rengini ve görünürlüğünü izler.
-- Düzen (UIListLayout / UIGridLayout) içindeki düğmelere eklenmez: kardeş taban düzende yer kaplardı.

local DEPTH = 0.09 -- REF_H yüksekliğindeki düğmede yüksekliğin payı
local REF_H = 40 -- (piksel) bundan büyük düğmelerde taban oransal olarak incelir
local DARKEN = 0.7 -- taban parlaklığı = düğmeninki x bu

local ButtonDepth = {}

function ButtonDepth.add(button: GuiObject)
	local parent = button.Parent
	if not parent or parent:FindFirstChildWhichIsA("UIGridStyleLayout") then
		return
	end
	local base = Instance.new("Frame")
	base.Name = button.Name .. "Depth"
	base.BorderSizePixel = 0
	base.Active = false
	local corner = button:FindFirstChildOfClass("UICorner")
	if corner then
		corner:Clone().Parent = base
	end
	local function place()
		local p = parent :: any
		local pos = button.AbsolutePosition - p.AbsolutePosition
		local size = button.AbsoluteSize
		local depth = math.max(1, math.floor(DEPTH * math.sqrt(REF_H * size.Y) + 0.5))
		base.Position = UDim2.fromOffset(pos.X, pos.Y + depth)
		base.Size = UDim2.fromOffset(size.X, size.Y)
		base.Visible = button.Visible
		base.ZIndex = button.ZIndex - 1
		local h, s, v = button.BackgroundColor3:ToHSV()
		base.BackgroundColor3 = Color3.fromHSV(h, s, v * DARKEN)
		base.BackgroundTransparency = button.BackgroundTransparency
	end
	for _, prop in { "AbsolutePosition", "AbsoluteSize", "Visible", "ZIndex", "BackgroundColor3", "BackgroundTransparency" } do
		button:GetPropertyChangedSignal(prop):Connect(place)
	end
	;(parent :: any):GetPropertyChangedSignal("AbsolutePosition"):Connect(place)
	button.Destroying:Connect(function()
		base:Destroy()
	end)
	place()
	base.Parent = parent
end

-- root altındaki yollar ("A/B"); bulunamayan atlanır.
function ButtonDepth.addAll(root: Instance, paths: { string })
	for _, path in paths do
		local cur: Instance? = root
		for part in string.gmatch(path, "[^/]+") do
			cur = cur and cur:FindFirstChild(part)
		end
		if cur and cur:IsA("GuiObject") then
			ButtonDepth.add(cur)
		end
	end
end

return ButtonDepth
]]></ProtectedString>
						<string name="ScriptGuid">{F319BE39-B3D2-4136-843F-7222A5870CFE}</string>
