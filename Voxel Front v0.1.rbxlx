						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Economy: asker tavanı ve büyüme formülleri. Saf fonksiyonlar; sabitler `cfg` (Config) üzerinden gelir.
--
--   tavan(tile)      = FACTOR * (tile^EXP * MULT + BASE) + şehirBonusu
--   artış(asker)     = (BASE + asker^EXP / DIV) * (1 - asker / tavan)         (tick başına)
--
-- Artış, askerin tavanın yaklaşık %42'sinde olduğu noktada en büyüktür (topluluk wikisindeki analiz).

local Economy = {}

export type Cfg = {
	read MAX_TROOPS_FACTOR: number,
	read MAX_TROOPS_TILE_EXP: number,
	read MAX_TROOPS_TILE_MULT: number,
	read MAX_TROOPS_BASE: number,
	read TROOP_GROWTH_BASE: number,
	read TROOP_GROWTH_EXP: number,
	read TROOP_GROWTH_DIV: number,
	read TROOP_DISPLAY_DIV: number,
}

function Economy.maxTroops(cfg: Cfg, tiles: number, cityBonus: number?): number
	local base = tiles ^ cfg.MAX_TROOPS_TILE_EXP * cfg.MAX_TROOPS_TILE_MULT + cfg.MAX_TROOPS_BASE
	return cfg.MAX_TROOPS_FACTOR * base + (cityBonus or 0)
end

function Economy.growth(cfg: Cfg, troops: number, maxTroops: number): number
	if maxTroops <= 0 or troops >= maxTroops then
		return 0
	end
	local ratio = troops / maxTroops
	return (cfg.TROOP_GROWTH_BASE + troops ^ cfg.TROOP_GROWTH_EXP / cfg.TROOP_GROWTH_DIV) * (1 - ratio)
end

-- Ekranda gösterilen değer (iç değerin bölenle küçültülmüş tamsayısı).
function Economy.display(cfg: Cfg, troops: number): number
	return math.floor(troops / cfg.TROOP_DISPLAY_DIV)
end

return Economy
]]></ProtectedString>
