				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Delta: değişen tile'ların ağ paketi (birkaç tick birlikte gönderilir).
-- Düzen: [u32 seq][u32 tick][u32 count][u16 nseg][nseg x u32 segment sonu] sonra count adet [u32 tile][u16 owner].
-- Segmentler tick sınırlarıdır: segment k = (önceki son + 1) .. son[k] girişleri, aynı tick'te değişen tile'lar.
-- İstemci segmentleri 100 ms arayla oynatır (repo istemcisi değişimleri tick tick alır; paket içinde tick sırası korunur).
-- seq her gönderimde 1 artar; istemci atlanan paketi (seq boşluğu) fark edip tam durum ister.
-- Sıkı biçim (online maç, pack'in `compact`ı): nseg'in üst biti 1; girişler her segmentte sahibe göre gruplanır:
-- segment başına varint(grup sayısı), grup başına varint(sahip) varint(giriş sayısı) ve sıralı tile'ların farkları (varint).
-- Aynı tick'te bir tile bir kez değişir (World dirty işareti), bu yüzden segment içi sıranın önemi yoktur.

local HEADER = 14
local ENTRY = 6
local COMPACT = 0x8000
local TILE_SPAN = 4194304 -- 2^22: sıralama anahtarı = sahip * TILE_SPAN + tile (en büyük harita 2000x1061)

local Delta = {}

local function writeVar(b: buffer, o: number, v: number): number
	while v >= 128 do
		buffer.writeu8(b, o, v % 128 + 128)
		o += 1
		v = v // 128
	end
	buffer.writeu8(b, o, v)
	return o + 1
end

local function readVar(b: buffer, o: number, len: number): (number?, number)
	local v, mul = 0, 1
	for _ = 1, 5 do
		if o >= len then
			return nil, o
		end
		local x = buffer.readu8(b, o)
		o += 1
		v += (x % 128) * mul
		if x < 128 then
			return v, o
		end
		mul *= 128
	end
	return nil, o
end

-- Sıkı biçimin gövdesi (başlık ve segment sonları normal biçimdeki gibi).
local function packCompact(seq: number, tick: number, tiles: { number }, owners: { number }, count: number, s: { number }, nseg: number): buffer
	local base = HEADER + nseg * 4
	local tmp = buffer.create(base + count * 8 + nseg * 5 + 16)
	local o = base
	local keys: { number } = {}
	local first = 1
	for k = 1, nseg do
		local last = if k == nseg then count else s[k]
		table.clear(keys)
		for i = first, last do
			keys[#keys + 1] = owners[i] * TILE_SPAN + tiles[i]
		end
		table.sort(keys)
		-- gruplar
		local groups = 0
		local prevOwner = -1
		for _, key in keys do
			local owner = key // TILE_SPAN
			if owner ~= prevOwner then
				groups += 1
				prevOwner = owner
			end
		end
		o = writeVar(tmp, o, groups)
		local i = 1
		while i <= #keys do
			local owner = keys[i] // TILE_SPAN
			local j = i
			while j < #keys and keys[j + 1] // TILE_SPAN == owner do
				j += 1
			end
			o = writeVar(tmp, o, owner)
			o = writeVar(tmp, o, j - i + 1)
			local prev = 0
			for q = i, j do
				local tile = keys[q] % TILE_SPAN
				o = writeVar(tmp, o, tile - prev)
				prev = tile
			end
			i = j + 1
		end
		first = last + 1
	end
	local out = buffer.create(o)
	buffer.copy(out, 0, tmp, 0, o)
	buffer.writeu32(out, 0, seq)
	buffer.writeu32(out, 4, tick)
	buffer.writeu32(out, 8, count)
	buffer.writeu16(out, 12, nseg + COMPACT)
	for k = 1, nseg do
		buffer.writeu32(out, HEADER + (k - 1) * 4, if k == nseg then count else s[k])
	end
	return out
end

-- segs: artan segment sonları (son değer = count). nil ya da boşsa tek segment. compact: sıkı biçim (ağ üzerinden).
function Delta.pack(seq: number, tick: number, tiles: { number }, owners: { number }, count: number, segs: { number }?, compact: boolean?): buffer
	local s: { number } = {}
	if segs then
		local last = 0
		for _, e in segs do
			if e > last and e <= count then
				s[#s + 1] = e
				last = e
			end
		end
	end
	if count > 0 and (s[#s] or 0) < count then
		s[#s + 1] = count
	end
	local nseg = math.min(#s, 32767)
	if compact then
		return packCompact(seq, tick, tiles, owners, count, s, nseg)
	end
	local base = HEADER + nseg * 4
	local out = buffer.create(base + count * ENTRY)
	buffer.writeu32(out, 0, seq)
	buffer.writeu32(out, 4, tick)
	buffer.writeu32(out, 8, count)
	buffer.writeu16(out, 12, nseg)
	for k = 1, nseg do
		buffer.writeu32(out, HEADER + (k - 1) * 4, if k == nseg then count else s[k])
	end
	for k = 1, count do
		local o = base + (k - 1) * ENTRY
		buffer.writeu32(out, o, tiles[k])
		buffer.writeu16(out, o + 4, owners[k])
	end
	return out
end

-- seq, tick, tiles, owners, count, segs döner. Bozuk paket için nil.
function Delta.unpack(packet: buffer): (number?, number?, { number }?, { number }?, number?, { number }?)
	local len = buffer.len(packet)
	if len < HEADER then
		return nil, nil, nil, nil, nil, nil
	end
	local seq = buffer.readu32(packet, 0)
	local tick = buffer.readu32(packet, 4)
	local count = buffer.readu32(packet, 8)
	local nseg = buffer.readu16(packet, 12)
	local compact = nseg >= COMPACT
	if compact then
		nseg -= COMPACT
	end
	local base = HEADER + nseg * 4
	if len < base or (not compact and len ~= base + count * ENTRY) then
		return nil, nil, nil, nil, nil, nil
	end
	local segs: { number } = table.create(nseg, 0)
	local last = 0
	for k = 1, nseg do
		local e = buffer.readu32(packet, HEADER + (k - 1) * 4)
		if e <= last or e > count then
			return nil, nil, nil, nil, nil, nil
		end
		segs[k] = e
		last = e
	end
	if count > 0 and last ~= count then
		return nil, nil, nil, nil, nil, nil
	end
	local tiles: { number } = table.create(count, 0)
	local owners: { number } = table.create(count, 0)
	if compact then
		local o = base
		local n = 0
		for k = 1, nseg do
			local groups
			groups, o = readVar(packet, o, len)
			if groups == nil then
				return nil, nil, nil, nil, nil, nil
			end
			for _ = 1, groups do
				local owner, m
				owner, o = readVar(packet, o, len)
				m, o = readVar(packet, o, len)
				if owner == nil or m == nil or n + m > segs[k] then
					return nil, nil, nil, nil, nil, nil
				end
				local tile = 0
				for _ = 1, m do
					local gap
					gap, o = readVar(packet, o, len)
					if gap == nil then
						return nil, nil, nil, nil, nil, nil
					end
					tile += gap
					n += 1
					tiles[n] = tile
					owners[n] = owner
				end
			end
			if n ~= segs[k] then
				return nil, nil, nil, nil, nil, nil
			end
		end
		if n ~= count or o ~= len then
			return nil, nil, nil, nil, nil, nil
		end
		return seq, tick, tiles, owners, count, segs
	end
	for k = 1, count do
		local o = base + (k - 1) * ENTRY
		tiles[k] = buffer.readu32(packet, o)
		owners[k] = buffer.readu16(packet, o + 4)
	end
	return seq, tick, tiles, owners, count, segs
end

Delta.HEADER_BYTES = HEADER
Delta.ENTRY_BYTES = ENTRY

return Delta
]]></ProtectedString>
