						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">WaterComp</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">15474ccd123c712a0af50f5100000be8</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX16B7A5D84F8548918C409C9AF73B6283">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- MenuMap: ana menü arkasındaki ayrı harita. Normal maçla hiçbir verisi ortak değildir (seçili haritanın küçültülmüş kopyası,
-- kendi dünyası ve simülasyonu). Haritanın %70'i boyutunda (Dünya'da Antarktika kırpılmış); yalnız kara savaşı var, yapı ve gemi yok.
-- Maç sıfırdan başlar: ilk 500 tick 10 kat hızlı (görünen hızlı çekim), sonra normal oyun hızında akar (kare bütçesiyle;
-- cihaz yetişemezse kasmaz, maç yavaşlar — RoWorld başlık ekranı gibi).
-- Kurulum da kare bütçesiyle parça parça yapılır (BUILD_BUDGET; donma yok, harita biraz geç belirir; o sırada deniz zemini).

local Fonts = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Fonts"))
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BaseConfig = require(Shared:WaitForChild("Config"))
local MapData = require(Shared:WaitForChild("MapData"))
local Sites = require(Shared:WaitForChild("Sites"))
local PlayerColors = require(Shared:WaitForChild("PlayerColors"))
local Core = Shared:WaitForChild("Core")
local Maps = Shared:WaitForChild("Maps")
local World = require(Core.World)
local Rng = require(Core.Rng)
local Economy = require(Core.Economy)
local Heap = require(Core.Heap)
local TickClock = require(Core.TickClock)
local Territory = require(Core.Territory)
local Simulation = require(Core.Simulation)
local NameBox = require(Core.NameBox)
local Executions = Core.Executions
local Parts = {
	Territory = Territory, Rng = Rng, Economy = Economy, Heap = Heap, Sites = Sites,
	Spawn = require(Executions.Spawn), Attack = require(Executions.Attack), Cancel = require(Executions.Cancel), Tribe = require(Executions.Tribe),
	Build = require(Executions.Build), Boat = require(Executions.Boat), Nation = require(Executions.Nation), Trade = require(Executions.Trade),
	Warship = require(Executions.Warship), Diplo = require(Executions.Diplo), Nuke = require(Executions.Nuke), Train = require(Executions.Train),
	Naval = require(Core.Naval), NationNaval = require(Core.NationNaval), Diplomacy = require(Core.Diplomacy), Rail = require(Core.Rail),
}
local Catalog = require(Maps.Catalog)
local TribeNames = require(Maps.TribeNames)
local MapPalette = require(script.Parent.MapPalette)
local MapRenderer = require(script.Parent.MapRenderer)
local TextFit = require(script.Parent.TextFit)

local SCALE = 0.7
local BOT_RATIO = 0.7
local BORDER_SOFTEN = 0.45
local WORLD_LAND = Catalog.world.land
local CAMERA_ZOOM = 2.2 -- RoWorld başlık ekranı
local CAMERA_SPEED = 6 / 2.2 * SCALE -- tile/sn
local WARM_TICKS = 500
local WARM_SPEED = 10
local MAX_STEPS = 12 -- bir karede borçlu kalınabilecek en çok tick (RoWorld MAX_STEPS_PER_TASK); fazlası atılır, maç yavaşlar
local NAME_MIN_PX = 6
local Z = 49 -- menü gölgesinin (50) altında
local CANCELLED = "menu map cancelled"

local MenuMap = {}
MenuMap.__index = MenuMap

local function plateHeight(fs: number): number
	local b = math.max(1, math.floor(fs))
	return math.max(4, math.floor(b * 0.4)) * math.min(b * 0.25, 3)
end

-- Kaynak harita baytlarından küçük kopya. Bir kerede donmasın diye satır gruplarıyla ilerler.
local function scaleBytes(self: any, src: buffer, srcW: number, w: number, h: number): buffer?
	local out = buffer.create(w * h)
	for y = 0, h - 1 do
		local sy = math.floor(y / SCALE) * srcW
		for x = 0, w - 1 do
			buffer.writeu8(out, y * w + x, buffer.readu8(src, sy + math.floor(x / SCALE)))
		end
		if y % 8 == 7 then
			self.pace()
		end
	end
	return out
end

local function layout(self: any, dt: number)
	local vw, vh = self.root.AbsoluteSize.X, self.root.AbsoluteSize.Y
	if vw <= 0 or vh <= 0 then
		return
	end
	local w, h = self.w, self.h
	local zoom = math.max(math.min(vw / w, vh / (self.fullH)) * CAMERA_ZOOM, vw / w, vh / h)
	local half = vw / zoom / 2
	local halfH = vh / zoom / 2
	-- Kamera haritanın taştığı uzun ekseninde kayar (dar haritada yukarı aşağı), kenarda geri döner.
	local alongX = w - half * 2 >= h - halfH * 2
	local lo = if alongX then half else halfH
	local hi = math.max(lo, (if alongX then w else h) - lo)
	if not self.camA or self.camAlongX ~= alongX then
		self.camA = if alongX then w / 2 else (lo + hi) / 2
		self.camAlongX = alongX
	end
	if self.camA >= hi then
		self.camDir = -1
	elseif self.camA <= lo then
		self.camDir = 1
	end
	self.camVel += (self.camDir * CAMERA_SPEED - self.camVel) * (1 - math.exp(-dt))
	self.camA = math.clamp(self.camA + self.camVel * dt, lo, hi)
	local cx = if alongX then self.camA else w / 2
	local cy = if alongX then math.clamp(self.fullH * self.cameraY, halfH, math.max(halfH, h - halfH)) else self.camA
	self.content.Position = UDim2.fromScale((vw / 2 - cx * zoom) / vw, (vh / 2 - cy * zoom) / vh)
	if zoom ~= self.zoom then
		self.zoom = zoom
		self.content.Size = UDim2.fromOffset(w * zoom, h * zoom)
		self.namesDirty = true
	end
end

local function placeName(self: any, pid: number)
	local view = self.names[pid]
	if not view then
		return
	end
	local label = view.label
	local sim = self.sim
	if not sim.alive[pid] or not view.tile then
		label.Visible = false
		return
	end
	local px = plateHeight(view.size) * self.zoom
	if px < NAME_MIN_PX then
		label.Visible = false
		return
	end
	local size = math.min(px, 100)
	label.TextSize = size
	label.Size = UDim2.fromOffset(px * #sim.name[pid] * 0.8, size * 1.25)
	label.Position = UDim2.fromOffset((view.tile % self.w + 0.5) * self.zoom, (view.tile // self.w + 0.5) * self.zoom)
	label.Visible = true
end

local function refreshName(self: any, pid: number)
	local view = self.names[pid]
	if not view then
		return
	end
	local world = self.world
	if world:tilesOwnedBy(pid) <= 0 then
		view.tile = nil
	else
		local tile, size = NameBox.compute(world, pid, #self.sim.name[pid], self.bytes)
		view.tile = tile or world:centerOf(pid)
		view.size = if tile then size else 1
	end
	placeName(self, pid)
end

local function clearNames(self: any)
	for _, view in self.names do
		view.label:Destroy()
	end
	table.clear(self.names)
end

local function makeNames(self: any)
	local sim = self.sim
	for pid = 1, sim.playerCount do
		if sim.alive[pid] and sim.isNation[pid] then
			local label = Instance.new("TextLabel")
			TextFit.fit(label)
			label.BackgroundTransparency = 1
			label.AnchorPoint = Vector2.new(0.5, 0.5)
			label.FontFace = Fonts.main
			label.Text = sim.name[pid]
			label.TextColor3 = Color3.fromRGB(77, 77, 77)
			label.TextStrokeColor3 = Color3.fromRGB(PlayerColors.nation(pid, sim.name[pid]))
			label.TextStrokeTransparency = 0
			label.ZIndex = Z + 1
			label.Visible = false
			label.Parent = self.content
			self.names[pid] = { label = label, tile = nil, size = 1 }
		end
	end
end

-- Yeni tur: boş haritaya döner.
local function startRound(self: any)
	self.pending = 0
	self.acc = 0
	self.ticks = 0
	self.applyCount = 0
	self.applyCursor = 0
	self.nameCursor = 0
	clearNames(self)
	makeNames(self)
end

local function restart(self: any)
	self.sim:newRound()
	self.renderer:resetColors()
	self.renderer:loadOwners(buffer.create(self.w * self.h * 2))
	self.renderer:flush()
	startRound(self)
end

local function runTick(self: any)
	local sim = self.sim
	local ok, err = pcall(sim.tick, sim)
	if not ok then
		warn("[Frontline] menu map tick error: " .. tostring(err))
	end
end

local function stepTicks(self: any, budget: number)
	self.deadline = os.clock() + budget
	while self.pending > 0 and os.clock() < self.deadline do
		local thread = self.thread or coroutine.create(runTick)
		self.thread = thread
		local ok, err = coroutine.resume(thread, self)
		if not ok then
			warn("[Frontline] menu map tick error: " .. tostring(err))
		end
		if coroutine.status(thread) ~= "dead" then
			return
		end
		self.thread = nil
		self.pending -= 1
		self.ticks += 1
		self.namesDue += 1
	end
end

local function drawOwners(self: any)
	local list, owners = self.applyTiles, self.applyOwners
	if self.applyCursor >= self.applyCount then
		self.applyCursor = 0
		local n = 0
		self.world:consumeDirty(function(tile: number, owner: number)
			n += 1
			list[n] = tile
			owners[n] = owner
		end)
		self.applyCount = n
	end
	local renderer = self.renderer
	local last = math.min(self.applyCount, self.applyCursor + self.drawPerFrame)
	for i = self.applyCursor + 1, last do
		renderer:setOwner(list[i], owners[i])
	end
	self.applyCursor = last
	renderer:processQueue(self.drawPerFrame)
	renderer:flush()
end

local function onFrame(self: any, dt: number)
	if self.thread == nil and self.sim.phase == "ended" then
		restart(self)
	end
	local steps
	local speed = if self.ticks < WARM_TICKS then WARM_SPEED else 1
	steps, self.acc = TickClock.advance(self.acc, dt * speed, self.cfg.TICK_SECONDS, MAX_STEPS)
	self.pending = math.min(self.pending + steps, MAX_STEPS)
	stepTicks(self, self.budget)
	drawOwners(self)
	-- ad yerleri: yalnız sırası gelen ulus (tick başına eşit yayılır)
	if self.namesDue > 0 then
		local sim = self.sim
		local count = math.min(self.namesDue, 4)
		self.namesDue -= count
		for _ = 1, count do
			self.nameCursor = self.nameCursor % sim.playerCount + 1
			refreshName(self, self.nameCursor)
		end
	end
end

local function build(self: any)
	-- kare bütçesi: dolunca bir sonraki kareye geçilir; harita değiştiyse (dead) kurulum bırakılır
	local deadline = os.clock() + self.buildBudget
	self.pace = function()
		if os.clock() >= deadline then
			task.wait()
			if self.dead then
				error(CANCELLED, 0)
			end
			deadline = os.clock() + self.buildBudget
		end
	end
	local pace = self.pace
	local map = self.map
	local mapInfo = require(Maps[map.module])
	local srcW, srcH = mapInfo.width, mapInfo.height
	local cutRow = map.cutRow or srcH
	local w = math.floor(srcW * SCALE)
	local h = math.floor(cutRow * SCALE)
	self.w, self.h, self.fullH = w, h, srcH * SCALE
	task.wait()
	if self.dead then
		return
	end
	local tileBytes = MapData.decodeWorld(Shared:WaitForChild(map.folder), srcW * srcH, pace)
	task.wait()
	if self.dead then
		return
	end
	local bytes = scaleBytes(self, tileBytes, srcW, w, h)
	if not bytes then
		return
	end
	self.bytes = bytes

	local pixels = MapPalette.buildPixels(bytes, pace)
	task.wait()
	if self.dead then
		return
	end
	local images: { any } = {}
	for i = 1, MapRenderer.blockCount(w, h) do
		local _, _, bw, bh = MapRenderer.blockRect(i, w, h)
		local okImage, image = pcall(function()
			return AssetService:CreateEditableImage({ Size = Vector2.new(bw, bh) })
		end)
		if not okImage or not image then
			warn("[Frontline] menu map skipped: no EditableImage memory")
			for _, made in images do
				made:Destroy()
			end
			return
		end
		images[i] = image
		self.images = images -- (kurulum yarıda kalırsa destroy bunları da siler)
		pace()
	end
	self.images = images
	local sim: any
	self.renderer = MapRenderer.new(images, w, h, pixels, function(pid: number)
		if sim and sim.isNation[pid] then
			return PlayerColors.nation(pid, sim.name[pid])
		end
		return 209, 205, 199
	end, function(_pid: number, r: number, g: number, b: number)
		-- küçük haritada sınırlar kalın görünür: normal sınır rengi ülke rengine biraz yaklaştırılır
		local br, bg, bb = PlayerColors.border(r, g, b)
		return math.floor(br + (r - br) * BORDER_SOFTEN + 0.5), math.floor(bg + (g - bg) * BORDER_SOFTEN + 0.5), math.floor(bb + (b - bb) * BORDER_SOFTEN + 0.5)
	end)
	self.renderer:writeAll(pace)
	for i, image in images do
		local x0, y0, bw, bh = MapRenderer.blockRect(i, w, h)
		local label = Instance.new("ImageLabel")
		label.BackgroundTransparency = 1
		label.BorderSizePixel = 0
		label.ResampleMode = Enum.ResamplerMode.Pixelated
		label.ImageContent = Content.fromObject(image)
		label.Position = UDim2.fromScale(x0 / w, y0 / h)
		label.Size = UDim2.new(bw / w, 1, bh / h, 1) -- 1 piksel örtüşür: bloklar arasında dikiş kalmasın
		label.ZIndex = Z
		label.Parent = self.content
	end
	layout(self, 0)
	self.root.Visible = true
	task.wait()
	if self.dead then
		return
	end

	local terrain = MapData.gameplay(bytes, pace)
	task.wait()
	if self.dead then
		return
	end
	local world = World.new(w, h, terrain, pace)
	self.world = world
	task.wait()
	if self.dead then
		return
	end
	sim = Simulation.new(world, self.cfg, os.time() % 2147483647, Parts)
	self.sim = sim
	sim.attract = true
	sim.tribeNames = TribeNames
	sim.pace = function()
		if os.clock() >= self.deadline then
			coroutine.yield()
		end
	end
	local spots = {}
	for _, nation in mapInfo.nations do
		if nation.y < cutRow then
			spots[#spots + 1] = { name = nation.name, x = math.floor(nation.x * SCALE), y = math.floor(nation.y * SCALE) }
		end
	end
	sim.nationSpots = spots
	self.cfg.NATION_COUNT = #spots
	sim:spawnBots(pace)
	startRound(self)
	task.wait()
	if self.dead then
		return
	end
	self.conn = RunService.Heartbeat:Connect(function(dt: number)
		layout(self, dt)
		onFrame(self, dt)
	end)
end

-- Haritayı parsel parsel kurmaya başlar, hemen döner.
function MenuMap.start(parent: Instance, mapId: string): any
	local map = Catalog[mapId] or Catalog.world
	local mobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local cfg = table.clone(BaseConfig)
	cfg.BOT_COUNT = math.floor(BaseConfig.BOT_COUNT * BOT_RATIO * map.land / WORLD_LAND + 0.5)
	cfg.SPAWN_PHASE_SECONDS = 1

	local root = Instance.new("Frame")
	root.Name = "MenuMap"
	root.BackgroundColor3 = Color3.fromRGB(62, 122, 171)
	root.BorderSizePixel = 0
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = Z
	root.ClipsDescendants = true
	root.Visible = true -- (harita kurulurken deniz zemini görünür)
	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.Rotation = 0.001 -- dönük öğe tam piksele oturmaz; yavaş kayma zıplamadan görünür
	content.ZIndex = Z
	content.Parent = root
	root.Parent = parent

	local self = setmetatable({
		dead = false,
		map = map,
		cameraY = map.cameraY or 0.5,
		root = root,
		content = content,
		cfg = cfg,
		names = {},
		zoom = 0,
		camDir = 1,
		camVel = 0,
		w = 1,
		h = 1,
		fullH = 1,
		pending = 0,
		acc = 0,
		deadline = math.huge,
		thread = nil :: thread?,
		namesDue = 0,
		nameCursor = 0,
		applyTiles = {},
		applyOwners = {},
		applyCount = 0,
		applyCursor = 0,
		drawPerFrame = if mobile then 20000 else 40000,
		budget = if mobile then 0.004 else 0.006, -- RoWorld başlık ekranı
		buildBudget = if mobile then 0.006 else 0.008, -- kurulum: kare başına en çok bu kadar iş
		pace = nil :: any,
	}, MenuMap)
	task.spawn(function()
		local ok, err = pcall(build, self)
		if not ok and err ~= CANCELLED then
			warn("[Frontline] menu map failed: " .. tostring(err))
		end
		if self.dead then
			self:destroy()
		end
	end)
	return self
end

function MenuMap.destroy(self: any)
	self.dead = true
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	if self.images then
		for _, image in self.images do
			image:Destroy()
		end
		self.images = nil
	end
	if self.root then
		self.root:Destroy()
		self.root = nil
	end
	self.sim = nil
	self.world = nil
	self.renderer = nil
	self.bytes = nil
end

return MenuMap
]]></ProtectedString>
						<string name="ScriptGuid">{6F9A59B2-E174-45EC-96AB-AAD4CD5D3459}</string>
