				<Item class="ModuleScript" referent="RBXE46CD05E8A454A78BF220517286BBC43">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- SyncTests: harita eşleşme denetimi (Shared.MapHash, Client.MapCheck). Sunucu tarafı Match'teki gibi gönderilen değişimlerden
-- parmak izi tutar; istemci tarafı paketleri gerçek Delta + Drip ile uygular. Oyunda çalışmaz; Studio'da elle:
-- require(game.ServerScriptService.Server.Dev.SyncTests).run()  -> { passed, failed, lines }

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Delta = require(Shared:WaitForChild("Delta"))
local MapHash = require(Shared:WaitForChild("MapHash"))
local ClientDir = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"):WaitForChild("Client")
local Drip = require(ClientDir:WaitForChild("Drip"))
local MapCheck = require(ClientDir:WaitForChild("MapCheck"))

local SyncTests = {}

function SyncTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end

	expect(MapHash.full(buffer.create(200), 100) == 0, "boş haritanın parmak izi 0")
	do
		-- iki tile'ın sahipleri yer değiştirirse parmak izi değişir
		local a = MapHash.step(MapHash.step(0, 10, 0, 5), 20, 0, 7)
		local b = MapHash.step(MapHash.step(0, 10, 0, 7), 20, 0, 5)
		expect(a ~= b, "yer değiştiren sahipler fark edilir")
		local buf = buffer.create(100)
		buffer.writeu16(buf, 20, 5)
		buffer.writeu16(buf, 40, 7)
		expect(MapHash.full(buf, 50) == a, "adım adım parmak izi tam taramayla aynı")
	end

	-- simülasyon: sunucu dünyası, Match gibi 3 tick'te bir paket, 10 tick'te bir parmak izi
	local function simulate(opts: { [string]: any })
		local rng = Random.new(opts.seed or 1)
		local size = 400 * 300
		local world = buffer.create(size * 2)
		local netOwner = buffer.create(size * 2)
		local netHash = 0
		local seq = 0
		local tickDirty: { [number]: boolean } = {}
		local tickMarks: { { number } } = {} -- tick başına (tile, sahip) listeleri
		local pendingTicks: { { number } } = {}
		-- istemci
		local own = buffer.create(size * 2)
		local check = MapCheck.new()
		local drip = Drip.new(function(tile: number, owner: number)
			check:apply(tile, buffer.readu16(own, tile * 2), owner)
			buffer.writeu16(own, tile * 2, owner)
		 end)
		local lastSeq = 0
		local ready = false
		local inbox: { any } = {}
		local results = { ok = 0, desync = 0 }
		local now = 0
		local function snapshot()
			local copy = buffer.create(size * 2)
			buffer.copy(copy, 0, world)
			buffer.copy(own, 0, copy)
			drip:clear()
			check:load(copy, size, seq)
			lastSeq = seq
			ready = true
			-- (bekleyen paketler: tam durumdan sonrakiler uygulanır)
		end
		snapshot()
		for tick = 1, opts.ticks or 1500 do
			-- bu tick'in değişimleri: cephe kümeleri + serpinti
			local changes = {}
			for _ = 1, rng:NextInteger(0, opts.rate or 60) do
				local t = (rng:NextInteger(0, 50) + 100) * 400 + rng:NextInteger(0, 120) + (tick % 200)
				local v = if rng:NextNumber() < 0.03 then 0x8000 elseif rng:NextNumber() < 0.1 then 0 else rng:NextInteger(1, 80)
				buffer.writeu16(world, t * 2, v)
				changes[t] = v
			end
			local list = {}
			for t, v in changes do
				table.insert(list, t)
				table.insert(list, v)
			end
			table.insert(pendingTicks, list)
			local sum = nil
			if tick % 3 == 0 then
				-- Match.flushDelta: segment = tick
				local tiles, owners, segs = {}, {}, {}
				for _, l in pendingTicks do
					for i = 1, #l, 2 do
						table.insert(tiles, l[i])
						table.insert(owners, l[i + 1])
						netHash = MapHash.step(netHash, l[i], buffer.readu16(netOwner, l[i] * 2), l[i + 1])
						buffer.writeu16(netOwner, l[i] * 2, l[i + 1])
					end
					table.insert(segs, #tiles)
				end
				table.clear(pendingTicks)
				if #tiles > 0 then
					seq += 1
					table.insert(inbox, { kind = "delta", p = Delta.pack(seq, tick, tiles, owners, #tiles, segs, true) })
				end
			end
			if tick % 10 == 0 then
				table.insert(inbox, { kind = "sum", sum = { s = seq, h = netHash } })
			end
			if opts.snapAt == tick then
				-- tam durum (gönderilmemiş değişimleri de içerir); önceki paketler atılır
				table.clear(inbox)
				snapshot()
			end
			if opts.corruptAt == tick then
				buffer.writeu16(own, 5 * 2, 99) -- istemci haritası bozulur (kaçırılmış değişim)
				check:apply(5, 0, 99)
			end
			-- istemci: 100 ms'de 6 kare
			for _ = 1, 6 do
				now += 1 / 60
				for _, m in inbox do
					if m.kind == "delta" then
						local s, _, tiles, owners, count, segs = Delta.unpack(m.p)
						if s and s == lastSeq + 1 then
							lastSeq = s
							drip:push(tiles, owners, count, segs, now)
						end
					else
						check:receive(m.sum)
					end
				end
				table.clear(inbox)
				if opts.instant then
					drip:flush()
				else
					drip:step(now, 1 / 60)
				end
				if ready then
					local r = check:step(lastSeq, drip:busy(), function()
						drip:flush()
					end)
					if r then
						results[r] += 1
						if r == "desync" and opts.resync then
							snapshot()
							results.resynced = (results.resynced or 0) + 1
						end
					end
				end
			end
		end
		return results
	end

	local quiet = simulate({ seed = 1, rate = 20 })
	expect(quiet.ok > 20 and quiet.desync == 0, string.format("normal akış: %d denetim tuttu, %d tutmadı", quiet.ok, quiet.desync))
	local busy = simulate({ seed = 2, rate = 300 })
	expect(busy.ok > 10 and busy.desync == 0, string.format("yoğun akış (Drip hep meşgul): %d denetim tuttu, %d tutmadı", busy.ok, busy.desync))
	local snap = simulate({ seed = 3, rate = 60, snapAt = 401 })
	expect(snap.ok > 20 and snap.desync == 0, string.format("ara durumda tam harita yüklenince yanlış alarm yok (%d denetim)", snap.ok))
	local bad = simulate({ seed = 4, rate = 20, corruptAt = 600, resync = true })
	expect(bad.desync == 1 and bad.resynced == 1 and bad.ok > 20, string.format("bozulan harita yakalanır, yeniden yüklenince denetimler yine tutar (%d tutmadı, %d tuttu)", bad.desync, bad.ok))

	return { passed = passed, failed = failed, lines = lines }
end

return SyncTests
]]></ProtectedString>
