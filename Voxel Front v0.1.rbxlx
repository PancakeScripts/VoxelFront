				<Item class="ModuleScript" referent="RBX71AEAA611DC04C838371396F491A9638">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- MedalTests: Medals formülü, solo sınırları, sonuç izleyici (Shared.Medals) ve kasa çekilişi (Shared.Cosmetics).
-- Oyunda çalışmaz; Studio'da elle: require(game.ServerScriptService.Server.Dev.MedalTests).run() -> { passed, failed, lines }

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Medals = require(Shared.Medals)
local Cosmetics = require(Shared.Cosmetics)

local MedalTests = {}

-- Simulation'ın izleyicinin okuduğu kısmı (sahte)
local function fakeSim(n: number)
	local tiles = {}
	local world = { landCount = 1000, takenBy = {} }
	function world:tilesOwnedBy(pid)
		return tiles[pid] or 0
	end
	local sim = { world = world, cfg = { TICK_RATE = 10 }, phase = "spawn", round = 1, tickNo = 0, playerCount = n,
		isBot = {}, isNation = {}, alive = {}, spawned = {}, troops = {}, team = {}, winner = 0, winnerTeam = 0 }
	for pid = 1, n do
		sim.alive[pid], sim.spawned[pid], sim.troops[pid] = true, true, 1000
		tiles[pid] = 10
	end
	return sim, tiles
end

function MedalTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end
	local function has(p, key)
		for _, l in p.lines do
			if l[1] == key then
				return l[2]
			end
		end
		return nil
	end

	-- formül
	local win = { spawned = true, left = false, won = true, minutes = 20, shares = 4, kills = 3, place = 1, field = 30 }
	local p = Medals.payout(win, "online")
	expect(has(p, "played") == 10 and has(p, "survived") == 30 and has(p, "territory") == 12 and has(p, "conquests") == 15, "online satırları formüldeki gibi")
	expect(has(p, "placed") == 28 and has(p, "victory") == 36 and p.total == 131, "sıra ve zafer satırları, toplam 131")
	local gone = table.clone(win)
	gone.left, gone.won = true, false
	local g = Medals.payout(gone, "online")
	expect(has(g, "played") == nil and has(g, "placed") == nil and has(g, "victory") == nil, "erken ayrılana played / placed / victory yok")
	expect(Medals.payout({ spawned = false, left = false, won = false, minutes = 5, shares = 1, kills = 0, place = 1, field = 1 }, "online").total == 0, "yerleşmeyen hiçbir şey almaz")
	local easy, normal, insane = Medals.payout(win, "easy").total, Medals.payout(win, "normal").total, Medals.payout(win, "insane").total
	expect(easy < normal and normal < insane and insane < p.total, "solo zorluğa göre artar ama online'dan azdır")
	expect(Medals.isSolo("hard") and Medals.isSolo("tutorial") and not Medals.isSolo("online") and not Medals.isSolo("teams") and not Medals.isSolo("x"), "solo modları tanınır")
	expect(Medals.text(1) == "1 Medal" and Medals.text(120) == "120 Medals", "Medal / Medals yazımı")

	-- solo sınırları
	local s = Medals.sanitize({ spawned = true, minutes = 999, shares = 1e9, kills = 500, place = -3, field = 40, won = true, left = true }, 2)
	expect(s.minutes == 2 and s.shares == 40 and s.kills == 40 and s.place == 1 and s.won == false, "solo raporu sınırlanır (süre gerçek süreyle, ayrılan kazanamaz)")
	local junk = Medals.sanitize("x", 5)
	expect(junk.spawned == false and junk.field == 1, "bozuk rapor boş sayılır")
	expect(Medals.soloCap(0) == Medals.FLOOR and Medals.soloCap(10) == Medals.FLOOR + 150, "solo tavanı gerçek dakikayla büyür")

	-- izleyici
	local sim, tiles = fakeSim(4)
	sim.isBot[3], sim.isNation[3] = true, true -- ulus
	sim.isBot[4] = true -- kabile (sayılmaz)
	local tr = Medals.Tracker.new(sim)
	tr:step()
	expect(tr.counted == false, "başlangıç fazında sayılmaz")
	sim.phase = "run"
	sim.tickNo = 100
	tr:step()
	expect(tr.field == 3 and tr.seats[1] ~= nil and tr.seats[2] ~= nil and tr.seats[3] == nil, "alan: insanlar + uluslar (kabile yok), koltuk yalnız insanlara")
	tiles[1] = 300
	sim.troops[1] = 5000
	sim.tickNo = 700
	tr:step()
	-- 1, ulusu (3) fethetti
	tiles[3] = 0
	sim.alive[3] = false
	sim.world.takenBy[3] = 1
	sim.tickNo = 710
	tr:step()
	expect(tr.seats[1].kills == 1 and tr.seats[1].peak == 300 and tr.seats[1].maxTroops == 5000, "fetih, en çok toprak ve asker sayılır")
	-- 2 ayrılıp toprağı sahipsiz kaldı (takenBy silinir): kimseye fetih yazılmaz
	tiles[2] = 0
	sim.alive[2] = false
	sim.world.takenBy[2] = nil
	sim.tickNo = 720
	tr:step()
	expect(tr.seats[1].kills == 1 and tr.seats[2].place == 2, "sahipsiz kalan toprak fetih sayılmaz; düşenün sırası kalanlara göre")
	sim.phase = "ended"
	sim.winner = 1
	sim.tickNo = 1300
	tr:step()
	local r = tr:result(1)
	expect(r.won and r.place == 1 and math.abs(r.minutes - 2) < 1e-6 and math.abs(r.shares - 0.9) < 1e-6 and r.kills == 1, "kazananın sonucu (2 dk, 0.9 pay, 1 fetih)")
	expect(tr:final(1) and tr:final(2), "tur bitince ve düşünce sonuç kesin")
	local c = tr:card(1)
	expect(c and math.abs(c.peakPct - 30) < 1e-6 and c.kills == 1 and c.seconds == 120, "maç sonu kartı")
	sim.round = 2
	sim.phase = "spawn"
	tr:step()
	expect(tr.seats[1] == nil and next(sim.world.takenBy) == nil, "yeni turda sıfırlanır")

	-- kasa
	local all = Cosmetics.all()
	local skins, flags = 0, 0
	for _, it in all do
		if it.kind == "skin" then
			skins += 1
		else
			flags += 1
		end
	end
	expect(skins == 21 and flags == 258, "21 skin ve 258 bayrak (RoWorld'deki set)")
	expect(Cosmetics.flagOf("TR") and Cosmetics.flagOf("tr").name == "Türkiye" and Cosmetics.flagOf("ne") == nil, "ülke koduyla bayrak (Niger yok)")
	local sum = 0
	for _, e in Cosmetics.odds({}) do
		sum += e.odds
	end
	expect(math.abs(sum - 1) < 1e-9, "oranların toplamı 1")
	local owned = {}
	for _, it in all do
		if it.rarity == "legendary" then
			owned[it.id] = true
		end
	end
	local o2 = Cosmetics.odds(owned)
	expect(o2[4].odds == 0 and math.abs(o2[1].odds - 0.62 / 0.97) < 1e-9, "tükenen nadirlik düşer, kalanlar orantılı büyür")
	local rng = Random.new(7)
	local dup = false
	local mine = {}
	for _ = 1, #all do
		local id = Cosmetics.roll(mine, rng:NextNumber(), rng:NextNumber())
		if id == nil or mine[id] then
			dup = true
			break
		end
		mine[id] = true
	end
	expect(not dup, "her kasa yeni bir eşya verir (279 kasada hepsi, tekrar yok)")
	expect(Cosmetics.roll(mine, 0.5, 0.5) == nil, "her şeye sahipken kasa boş döner")
	local leg = Cosmetics.roll({}, 0.995, 0)
	expect(leg and Cosmetics.item(leg).rarity == "legendary", "oranın sonu efsanevi")
	return { passed = passed, failed = failed, lines = lines }
end

return MedalTests
]]></ProtectedString>
						<string name="ScriptGuid">{E15954D8-8659-41B0-91E3-5744EF9A1A76}</string>
