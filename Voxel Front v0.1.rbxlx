			<Item class="ModuleScript" referent="RBXFF5269AF6E76420AAD2416E6ECF84E7A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Telemetry: online sayaçları, Roblox AnalyticsService özel olayları olarak (Creator Hub > Analytics > Custom Events).
-- Yalnız sunucuda ve yayındaki oyunda gönderilir; Studio'da yalnız sayılır: Telemetry.counts ve bu modülün öznitelikleri
-- (Properties > Attributes; başka bir Lua ortamından da okunur).
-- Gönderim hatası oyunu etkilemez. Olaylar:
--   OnlineJoinSolo / OnlineJoinTeams   oyuncu bir online maça oturtuldu (ışınlanma başladı)
--   OnlineQueued                       bütün maçlar doluydu, sıraya girdi
--   OnlineJoinFailed                   katılma başarısız (kapalı, liste okunamadı, sıra süresi doldu...)
--   TeleportFailed                     ışınlanma başladıktan sonra başarısız oldu
--   MatchStarted / MatchStartedTeams   maç sunucusunda tur başladı (değer: oyuncu sayısı)
--   Resync                             istemci haritayı baştan istedi (online)
--   SlowFrames                         son 30 sn'de maçın 50 ms'yi aşan kare sayısı (online sunucu)
--   TutorialSkipped                    yeni oyuncu tutorial'ı Skip ile bıraktı (değer: kaldığı adım, Server.Profile.FUNNEL)
-- Huniler (Creator Hub > Analytics > Funnels): Telemetry.funnel / Telemetry.onboarding; "Tutorial" hunisi Server.Profile'da,
-- "Onboarding" ve "Match" hunileri ile alanlı olaylar (Telemetry.event) Server.Analytics'te.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Telemetry = {}

--- Studio'da ve yayında: olay başına toplam (yalnız bu sunucu).
Telemetry.counts = {} :: { [string]: number }

local live = RunService:IsServer() and not RunService:IsStudio()

--- `player`: olayın oyuncusu; sunucu olayıysa nil (o an sunucudaki bir oyuncuyla kaydedilir, kimse yoksa gönderilmez).
function Telemetry.count(player: any, name: string, value: number?)
	if not RunService:IsServer() then
		return
	end
	Telemetry.counts[name] = (Telemetry.counts[name] or 0) + (value or 1)
	if not live then
		script:SetAttribute(name, Telemetry.counts[name])
		return
	end
	local p = player
	if typeof(p) ~= "Instance" or not p:IsA("Player") or p.Parent == nil then
		p = Players:GetPlayers()[1]
	end
	if p == nil then
		return
	end
	task.spawn(function()
		pcall(function()
			(game:GetService("AnalyticsService") :: any):LogCustomEvent(p, name, value or 1)
		end)
	end)
end

--- Özel alanlar (CustomField01..03; Creator Hub'da kırılım). AnalyticsService , " ' içeren alanı boş bırakır: çıkarılır.
local function fieldsOf(f: { any }?): any
	if f == nil then
		return nil
	end
	local out = {}
	for i, v in f do
		if i <= 3 then
			out["CustomField0" .. i] = (string.gsub(tostring(v), "[,\"']", ""))
		end
	end
	return out
end

--- Huni adımı (AnalyticsService:LogFunnelStepEvent): funnelName hunisinde `step`. adım; sessionId: bir oynayışın kimliği;
--- fields: en çok 3 özel alan. Studio'da gönderilmez: yazılır ve bu modülün özniteliğine sayılır (ör. "Tutorial_3").
function Telemetry.funnel(player: Player, funnelName: string, sessionId: string, step: number, stepName: string, fields: { any }?)
	if not RunService:IsServer() then
		return
	end
	local key = (string.gsub(funnelName, "[^%w_]", "_")) .. "_" .. step
	Telemetry.counts[key] = (Telemetry.counts[key] or 0) + 1
	if not live then
		script:SetAttribute(key, Telemetry.counts[key])
		print(string.format("[Telemetry] funnel %s %d %s (%s) [%s]", funnelName, step, stepName, player.Name, table.concat(fields or {}, ", ")))
		return
	end
	task.spawn(function()
		pcall(function()
			(game:GetService("AnalyticsService") :: any):LogFunnelStepEvent(player, funnelName, sessionId, step, stepName, fieldsOf(fields))
		end)
	end)
end

--- "Onboarding" hunisi (AnalyticsService:LogOnboardingFunnelStepEvent): Roblox bunu oyuncunun ilk oturumu için tutar,
--- her adım bir kez. Studio'da yazılır (öznitelik "Onboarding_<adım>").
function Telemetry.onboarding(player: Player, step: number, stepName: string)
	if not RunService:IsServer() then
		return
	end
	local key = "Onboarding_" .. step
	Telemetry.counts[key] = (Telemetry.counts[key] or 0) + 1
	if not live then
		script:SetAttribute(key, Telemetry.counts[key])
		print(string.format("[Telemetry] onboarding %d %s (%s)", step, stepName, player.Name))
		return
	end
	task.spawn(function()
		pcall(function()
			(game:GetService("AnalyticsService") :: any):LogOnboardingFunnelStepEvent(player, step, stepName)
		end)
	end)
end

--- Alanlı özel olay (AnalyticsService:LogCustomEvent): değer ve en çok 3 alan (ör. mod, durum, sıralama).
function Telemetry.event(player: Player, name: string, value: number, fields: { any }?)
	if not RunService:IsServer() then
		return
	end
	Telemetry.counts[name] = (Telemetry.counts[name] or 0) + 1
	if not live then
		script:SetAttribute((string.gsub(name, "[^%w_]", "_")), Telemetry.counts[name]) -- (öznitelik adında boşluk olamaz)
		print(string.format("[Telemetry] event %s = %s (%s) [%s]", name, tostring(value), player.Name, table.concat(fields or {}, ", ")))
		return
	end
	task.spawn(function()
		pcall(function()
			(game:GetService("AnalyticsService") :: any):LogCustomEvent(player, name, value, fieldsOf(fields))
		end)
	end)
end

return Telemetry
]]></ProtectedString>
