					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- World: harita ve sahiplik verisi.
-- KURAL: Bu modül Roblox API'sine (workspace, Players, Instance...) dokunmaz ve başka modülü require etmez.
-- Tile indeksi 0 tabanlıdır: i = y * width + x. Sahip kimliği (pid) 0 = sahipsiz.

local Terrain = table.freeze({
	Water = 0,
	Plains = 1,
	Highland = 2,
	Mountain = 3,
})

local MAX_OWNER_ID = 65535

local World = {}
World.__index = World
World.Terrain = Terrain

export type World = typeof(setmetatable(
	{} :: {
		width: number,
		height: number,
		size: number,
		landCount: number,
		terrain: buffer, -- u8, tile başına 1 bayt
		owner: buffer, -- u16, tile başına 2 bayt
		dirtyMark: buffer, -- u8, tile'ın dirty listesinde olup olmadığı
		dirtyList: { number },
		dirtyCount: number,
		dirtyOwners: { number },
		sealedCount: number,
		territoryVersion: { [number]: number },
		claimOrder: buffer,
		claimSerial: number,
		-- tick sınırları: her tick sonunda o ana kadarki dirty sayısı (ağ paketi tick tick oynatılsın diye; repo istemcisi
		-- değişimleri tick başına alır)
		tickMarks: { number },
		tileCount: { [number]: number }, -- pid -> sahip olunan tile sayısı (0 = sahipsiz kara)
		sumX: { [number]: number }, -- oyuncu başına sahip olunan tile x toplamı (isim yeri için merkez)
		sumY: { [number]: number },
		borderMark: buffer, -- u16, tile hangi oyuncunun sınır kümesinde (0 = hiçbiri)
		borders: { [number]: { [number]: boolean } }, -- pid -> sınır tile kümesi
		nbTmp: { number },
		borderLists: { [number]: { number } }, -- eklenme sırası, silinen yuva = -1
		borderSlots: { [number]: number }, -- tile -> borderLists içindeki yuva
		borderCounts: { [number]: number },
		onChange: ((tile: number, old: number, new: number) -> ())?,
		waterComp: buffer, -- u32, su tile'ının bağlı su kütlesi kimliği (kara: 0)
		compCount: number,
		fallout: buffer, -- u8, tile'da serpinti var mı
		falloutCount: number,
	},
	World
))

-- pace (isteğe bağlı): uzun döngülerde ara ara çağrılır (çağıran kare bütçesi dolunca bekleyebilir: menü arka planı).
function World.new(width: number, height: number, terrain: buffer, pace: (() -> ())?): World
	assert(width > 0 and height > 0, "invalid map size")
	local size = width * height
	assert(buffer.len(terrain) == size, "terrain length does not match width*height")

	local landCount = 0
	for i = 0, size - 1 do
		if pace and i % 131072 == 0 then
			pace()
		end
		if buffer.readu8(terrain, i) ~= Terrain.Water then
			landCount += 1
		end
	end

	local self = setmetatable({
		width = width,
		height = height,
		size = size,
		landCount = landCount,
		terrain = terrain,
		owner = buffer.create(size * 2),
		dirtyMark = buffer.create(size),
		dirtyList = {},
		dirtyCount = 0,
		dirtyOwners = {},
		sealedCount = 0,
		territoryVersion = {},
		claimOrder = buffer.create(size * 4),
		claimSerial = 0,
		tickMarks = {},
		tileCount = { [0] = landCount },
		sumX = {},
		sumY = {},
		borderMark = buffer.create(size * 2),
		borders = {},
		borderLists = {},
		borderSlots = {},
		borderCounts = {},
		nbTmp = {},
		onChange = nil :: ((number, number, number) -> ())?,
		waterComp = buffer.create(size * 4),
		compCount = 0,
		fallout = buffer.create(size),
		falloutCount = 0,
	}, World)
	World.labelWater(self, pace)
	return self
end

-- (x, y) -> indeks. Sınır dışıysa nil.
function World.index(self: World, x: number, y: number): number?
	if x < 0 or y < 0 or x >= self.width or y >= self.height then
		return nil
	end
	return y * self.width + x
end

function World.coords(self: World, i: number): (number, number)
	return i % self.width, i // self.width
end

function World.terrainAt(self: World, i: number): number
	return buffer.readu8(self.terrain, i)
end

function World.isLand(self: World, i: number): boolean
	return buffer.readu8(self.terrain, i) ~= Terrain.Water
end

function World.ownerAt(self: World, i: number): number
	return buffer.readu16(self.owner, i * 2)
end

function World.tilesOwnedBy(self: World, pid: number): number
	return self.tileCount[pid] or 0
end

-- 4 komşuyu repo GameMap.neighbors4 sırasıyla yazar (kuzey, güney, batı, doğu).
-- `out` yeniden kullanılır; her çağrıda yeni tablo üretilmez.
function World.neighbors(self: World, i: number, out: { number }): number
	local w = self.width
	local n = 0
	if i >= w then
		n += 1
		out[n] = i - w
	end
	if i < self.size - w then
		n += 1
		out[n] = i + w
	end
	local x = i % w
	if x > 0 then
		n += 1
		out[n] = i - 1
	end
	if x < w - 1 then
		n += 1
		out[n] = i + 1
	end
	return n
end

-- Su kütlelerini etiketler (4 komşuluk, taşma önleyici yığınla). Gemi rotası ve iniş yeri için kullanılır.
function World.labelWater(self: World, pace: (() -> ())?)
	local comp = self.waterComp
	local terrain = self.terrain
	local w, size = self.width, self.size
	local count = 0
	local stack: { number } = {}
	local work = 0
	for start = 0, size - 1 do
		if pace and start % 65536 == 0 then
			pace()
		end
		if buffer.readu8(terrain, start) == Terrain.Water and buffer.readu32(comp, start * 4) == 0 then
			count += 1
			buffer.writeu32(comp, start * 4, count)
			stack[1] = start
			local n = 1
			while n > 0 do
				local t = stack[n]
				n -= 1
				if pace then
					work += 1
					if work % 32768 == 0 then
						pace() -- (büyük okyanus tek dolguda: içeride de kare verilir)
					end
				end
				local x = t % w
				if t >= w then
					local u = t - w
					if buffer.readu8(terrain, u) == Terrain.Water and buffer.readu32(comp, u * 4) == 0 then
						buffer.writeu32(comp, u * 4, count)
						n += 1
						stack[n] = u
					end
				end
				if x > 0 then
					local u = t - 1
					if buffer.readu8(terrain, u) == Terrain.Water and buffer.readu32(comp, u * 4) == 0 then
						buffer.writeu32(comp, u * 4, count)
						n += 1
						stack[n] = u
					end
				end
				if x < w - 1 then
					local u = t + 1
					if buffer.readu8(terrain, u) == Terrain.Water and buffer.readu32(comp, u * 4) == 0 then
						buffer.writeu32(comp, u * 4, count)
						n += 1
						stack[n] = u
					end
				end
				if t < size - w then
					local u = t + w
					if buffer.readu8(terrain, u) == Terrain.Water and buffer.readu32(comp, u * 4) == 0 then
						buffer.writeu32(comp, u * 4, count)
						n += 1
						stack[n] = u
					end
				end
			end
		end
	end
	self.compCount = count
end

function World.isWater(self: World, i: number): boolean
	return buffer.readu8(self.terrain, i) == Terrain.Water
end

-- Su tile'ının su kütlesi kimliği (kara için 0).
function World.waterComponent(self: World, i: number): number
	return buffer.readu32(self.waterComp, i * 4)
end

-- Kıyı: komşularından biri su olan kara tile'ı. Komşu su kütlesi kimliğini de döner (yoksa nil).
function World.shoreComponent(self: World, i: number): number?
	if buffer.readu8(self.terrain, i) == Terrain.Water then
		return nil
	end
	local nb = self.nbTmp
	local n = World.neighbors(self, i, nb)
	for k = 1, n do
		local c = buffer.readu32(self.waterComp, nb[k] * 4)
		if c ~= 0 then
			return c
		end
	end
	return nil
end

-- Sınır kuralı: sahipli bir tile, komşularından biri farklı sahipliyse (su dahil) sınırdır.
local function computeBorderOwner(self: World, t: number): number
	local o = buffer.readu16(self.owner, t * 2)
	if o == 0 then
		return 0
	end
	local nb = self.nbTmp
	local n = World.neighbors(self, t, nb)
	for k = 1, n do
		if buffer.readu16(self.owner, nb[k] * 2) ~= o then
			return o
		end
	end
	return 0
end

local function updateBorder(self: World, t: number)
	local now = computeBorderOwner(self, t)
	local prev = buffer.readu16(self.borderMark, t * 2)
	if now == prev then
		return
	end
	if prev ~= 0 then
		self.borders[prev][t] = nil
		local list = self.borderLists[prev]
		list[self.borderSlots[t]] = -1
		self.borderSlots[t] = nil
		local count = self.borderCounts[prev] - 1
		self.borderCounts[prev] = count
		-- Silme/yeniden ekleme sırası korunur; ölü yuvalar birikmez.
		if #list > math.max(64, count * 3) then
			local n = 0
			for i = 1, #list do
				local tile = list[i]
				if tile ~= -1 then
					n += 1
					list[n] = tile
					self.borderSlots[tile] = n
				end
			end
			for i = #list, n + 1, -1 do
				list[i] = nil :: any
			end
		end
	end
	if now ~= 0 then
		local set = self.borders[now]
		if not set then
			set = {}
			self.borders[now] = set
			self.borderLists[now] = {}
			self.borderCounts[now] = 0
		end
		set[t] = true
		local list = self.borderLists[now]
		list[#list + 1] = t
		self.borderSlots[t] = #list
		self.borderCounts[now] += 1
	end
	buffer.writeu16(self.borderMark, t * 2, now)
end

-- t ve komşularının sınır durumunu yeniler (sahiplik değişince çağrılır).
function World.refreshBorders(self: World, t: number)
	updateBorder(self, t)
	local nb: { number } = {}
	local n = World.neighbors(self, t, nb)
	for k = 1, n do
		updateBorder(self, nb[k])
	end
end

-- Oyuncunun sınır tile kümesi (salt okunur kullan). Yoksa boş tablo.
local EMPTY = table.freeze({}) :: { [number]: boolean }
function World.borderOf(self: World, pid: number): { [number]: boolean }
	return self.borders[pid] or EMPTY
end

-- Repo TileSet gibi eklenme sırası. Salt okunur; -1 yuvaları atlanır.
-- Bu liste taranırken sahiplik değiştirilmez (saldırı cephesini kurmak içindir).
function World.orderedBorderOf(self: World, pid: number): { number }
	return self.borderLists[pid] or EMPTY :: any
end

-- Oyuncunun toprağının ağırlık merkezine en yakın kendi tile'ı (isim yazısı için). Toprağı yoksa nil.
function World.centerOf(self: World, pid: number): number?
	local n = self.tileCount[pid] or 0
	if n <= 0 then
		return nil
	end
	local cx = math.floor(self.sumX[pid] / n + 0.5)
	local cy = math.floor(self.sumY[pid] / n + 0.5)
	local w, h = self.width, self.height
	local maxR = math.ceil(math.sqrt(n)) * 3 + 3
	for r = 0, maxR do
		for dy = -r, r do
			local y = cy + dy
			if y >= 0 and y < h then
				local step = if math.abs(dy) == r then 1 else math.max(1, 2 * r)
				local dx = -r
				while dx <= r do
					local x = cx + dx
					if x >= 0 and x < w and buffer.readu16(self.owner, (y * w + x) * 2) % 32768 == pid then
						return y * w + x
					end
					dx += step
				end
			end
		end
	end
	return nil
end

-- Yeni tur için tüm sahipliği sıfırlar.
function World.reset(self: World)
	buffer.fill(self.owner, 0, 0, buffer.len(self.owner))
	buffer.fill(self.borderMark, 0, 0, buffer.len(self.borderMark))
	buffer.fill(self.dirtyMark, 0, 0, buffer.len(self.dirtyMark))
	buffer.fill(self.fallout, 0, 0, buffer.len(self.fallout))
	self.falloutCount = 0
	table.clear(self.dirtyList)
	table.clear(self.dirtyOwners)
	table.clear(self.territoryVersion)
	buffer.fill(self.claimOrder, 0, 0)
	self.claimSerial = 0
	self.sealedCount = 0
	self.dirtyCount = 0
	table.clear(self.tickMarks)
	table.clear(self.borders)
	table.clear(self.borderLists)
	table.clear(self.borderSlots)
	table.clear(self.borderCounts)
	table.clear(self.tileCount)
	self.tileCount[0] = self.landCount
	table.clear(self.sumX)
	table.clear(self.sumY)
end

-- Sahipliği değiştirmenin TEK yolu. Su tile'ına yazmayı reddeder.
-- Değişiklik olduysa true döner; tile dirty listesine eklenir (ağ deltası için).
function World.setOwner(self: World, i: number, pid: number): boolean
	assert(pid >= 0 and pid <= MAX_OWNER_ID, "pid out of range")
	if buffer.readu8(self.terrain, i) == Terrain.Water then
		return false
	end
	local old = buffer.readu16(self.owner, i * 2)
	if old == pid then
		return false
	end
	buffer.writeu16(self.owner, i * 2, pid)
	self.claimSerial += 1
	buffer.writeu32(self.claimOrder, i * 4, self.claimSerial)
	if pid ~= 0 and buffer.readu8(self.fallout, i) == 1 then
		buffer.writeu8(self.fallout, i, 0) -- fethedilen tile'ın serpintisi temizlenir (repo)
		self.falloutCount -= 1
	end
	World.refreshBorders(self, i)
	self.territoryVersion[old] = (self.territoryVersion[old] or 0) + 1
	self.territoryVersion[pid] = (self.territoryVersion[pid] or 0) + 1
	local hook = self.onChange
	if hook then
		hook(i, old, pid)
	end
	-- (Medals.Tracker varsa: bir sahibin toprağını en son kim aldı; sahipsiz kalan toprağın kaydı silinir)
	local taken = (self :: any).takenBy
	if taken and old ~= 0 then
		taken[old] = if pid ~= 0 then pid else nil
	end

	local counts = self.tileCount
	counts[old] = (counts[old] or 0) - 1
	counts[pid] = (counts[pid] or 0) + 1
	local x, y = i % self.width, i // self.width
	if old ~= 0 then
		self.sumX[old] -= x
		self.sumY[old] -= y
	end
	if pid ~= 0 then
		self.sumX[pid] = (self.sumX[pid] or 0) + x
		self.sumY[pid] = (self.sumY[pid] or 0) + y
	end

	if buffer.readu8(self.dirtyMark, i) == 0 then
		buffer.writeu8(self.dirtyMark, i, 1)
		local n = self.dirtyCount + 1
		self.dirtyCount = n
		self.dirtyList[n] = i
	end
	return true
end

local FALLOUT_BIT = 0x8000

local function markDirty(self: World, i: number)
	if buffer.readu8(self.dirtyMark, i) == 0 then
		buffer.writeu8(self.dirtyMark, i, 1)
		local n = self.dirtyCount + 1
		self.dirtyCount = n
		self.dirtyList[n] = i
	end
end

-- Sahipsiz kara tile'ına serpinti koyar (sahipli tile'a konmaz, su tile'ına konmaz).
function World.setFallout(self: World, i: number): boolean
	if buffer.readu8(self.terrain, i) == Terrain.Water or buffer.readu16(self.owner, i * 2) ~= 0 then
		return false
	end
	if buffer.readu8(self.fallout, i) == 1 then
		return false
	end
	buffer.writeu8(self.fallout, i, 1)
	self.falloutCount += 1
	-- Sahip değişmese de yeni serpinti komşu ülkenin çıkış koşulunu değiştirir.
	local n = self:neighbors(i, self.nbTmp)
	for k = 1, n do
		local p = self:ownerAt(self.nbTmp[k])
		if p ~= 0 then self.territoryVersion[p] = (self.territoryVersion[p] or 0) + 1 end
	end
	markDirty(self, i)
	return true
end

function World.hasFallout(self: World, i: number): boolean
	return buffer.readu8(self.fallout, i) == 1
end

-- Her tick'in SON durumunu o tick'e sabitler. Aynı tile sonraki tick'te
-- tekrar değişirse ayrı kayıt alır; gelecekteki sahip eski segmente yazılmaz.
function World.markTick(self: World)
 local count = self.dirtyCount
 if count == self.sealedCount then return end
 for k = self.sealedCount + 1, count do
  local t = self.dirtyList[k]
  local owner = buffer.readu16(self.owner, t * 2)
  self.dirtyOwners[k] = if owner == 0 and self:hasFallout(t) then FALLOUT_BIT else owner
  buffer.writeu8(self.dirtyMark, t, 0)
 end
 self.sealedCount = count
 self.tickMarks[#self.tickMarks + 1] = count
end

function World.takeTickMarks(self: World): { number }
 self:markTick()
 local out = table.clone(self.tickMarks)
 table.clear(self.tickMarks)
 return out
end

function World.consumeDirty(self: World, fn: (tile: number, owner: number) -> ()): number
 self:markTick()
 local count = self.dirtyCount
 for k = 1, count do fn(self.dirtyList[k], self.dirtyOwners[k]) end
 table.clear(self.dirtyList)
 table.clear(self.dirtyOwners)
 table.clear(self.tickMarks)
 self.dirtyCount, self.sealedCount = 0, 0
 return count
end

-- Geç katılan oyuncuya tam görüntü göndermek için owner buffer'ının kopyası.
function World.cloneOwner(self: World): buffer
	local copy = buffer.create(buffer.len(self.owner))
	buffer.copy(copy, 0, self.owner)
	if self.falloutCount > 0 then
		for i = 0, self.size - 1 do
			if buffer.readu8(self.fallout, i) == 1 then
				buffer.writeu16(copy, i * 2, FALLOUT_BIT)
			end
		end
	end
	return copy
end

return World
]]></ProtectedString>
