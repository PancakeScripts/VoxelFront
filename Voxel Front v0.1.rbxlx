						<ProtectedString name="Source"><![CDATA[--!strict
-- TickClock: gerçek zamanı sabit adımlı tick'lere çevirir (birikimli sabit adım).
-- task.wait() döngüsü kaymaya yol açar; bunun yerine her Heartbeat'te geçen süre biriktirilir
-- ve kaç tick yetiştirileceği buradan hesaplanır.

local TickClock = {}

-- acc: önceki birikim (saniye). dt: geçen süre. Döner: (bu karede çalıştırılacak tick sayısı, yeni birikim).
-- Sunucu yetişemezse (tick sayısı maxCatchup'ı aşarsa) fazla birikim atılır: oyun yavaşlar ama kilitlenmez.
function TickClock.advance(acc: number, dt: number, tickSeconds: number, maxCatchup: number): (number, number)
	if dt < 0 then
		dt = 0
	end
	acc += dt
	local steps = 0
	while acc >= tickSeconds and steps < maxCatchup do
		acc -= tickSeconds
		steps += 1
	end
	if acc >= tickSeconds then
		acc = acc % tickSeconds
	end
	return steps, acc
end

return TickClock
]]></ProtectedString>
