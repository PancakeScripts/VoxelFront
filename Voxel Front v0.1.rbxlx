						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Spawn: başlangıç noktası seçimi. Tek tick'lik (init'te biter) bir Execution.
--
-- Kurallar (OpenFront'a göre):
--   * Başlangıç bölgesi, seçilen tile'ın etrafında yarıçap SPAWN_RADIUS'luk dairenin sahipsiz kara tile'larıdır.
--   * İnsan oyuncu başlangıç fazında istediği kadar yer değiştirebilir; eski bölge boşaltılır.
--   * Oyun başladıktan sonra daha önce hiç seçmemiş oyuncu bir kez seçebilir, sonra kilitlenir.
-- Bize özgü: seçilen tile kara ve sahipsiz olmalı (repo, sahipli/su tile'ında yalnızca kalan tile'ları verir).
-- Botlar için rastgele yerleşim Spawn.placeBot'ta (repodaki kurallarla: dairenin tamamı sahipsiz kara, mesafe şartı).

local Spawn = {}
Spawn.__index = Spawn

export type Spawn = typeof(setmetatable({} :: { pid: number, tile: number, done: boolean, kind: string }, Spawn))

function Spawn.new(pid: number, tile: number): Spawn
	return setmetatable({ pid = pid, tile = tile, done = false, kind = "spawn" }, Spawn)
end

local function validTile(size: number, tile: any): boolean
	return type(tile) == "number" and tile == tile and tile >= 0 and tile < size and tile % 1 == 0
end

-- Dairedeki tile'ları döner. requireAll true ise biri bile sahipli/su ise nil.
local function circle(sim: any, cx: number, cy: number, requireAll: boolean): { number }?
	local world, r = sim.world, sim.cfg.SPAWN_RADIUS
	local w, h = world.width, world.height
	local out: { number } = {}
	for dy = -r, r do
		local y = cy + dy
		for dx = -r, r do
			if dx * dx + dy * dy <= r * r then
				local x = cx + dx
				local ok = x >= 0 and x < w and y >= 0 and y < h
				if ok then
					local i = y * w + x
					if world:isLand(i) and world:ownerAt(i) == 0 then
						out[#out + 1] = i
					elseif requireAll then
						return nil
					end
				elseif requireAll then
					return nil
				end
			end
		end
	end
	return out
end

local function claim(sim: any, pid: number, center: number, tiles: { number })
	local world = sim.world
	local previous = sim.spawnTiles[pid]
	if previous then
		for _, t in previous do
			world:setOwner(t, 0)
		end
	end
	for _, t in tiles do
		world:setOwner(t, pid)
	end
	sim.spawnTiles[pid] = tiles
	sim.spawnCenter[pid] = center
	sim.spawned[pid] = true
end

function Spawn.init(self: Spawn, sim: any)
	self.done = true
	local world = sim.world
	local pid = self.pid

	if not validTile(world.size, self.tile) then
		sim:emit(pid, "badTile")
		return
	end
	if not world:isLand(self.tile) then
		sim:emit(pid, "notLand")
		return
	end
	if sim.locked[pid] or sim.phase == "ended" then
		sim:emit(pid, "locked")
		return
	end
	if world:ownerAt(self.tile) ~= 0 then
		sim:emit(pid, "tooClose")
		return
	end

	-- Eski bölgeyi önce boşalt: yeni daire eski bölgeyle kesişebilir.
	local previous = sim.spawnTiles[pid]
	if previous then
		for _, t in previous do
			world:setOwner(t, 0)
		end
		sim.spawnTiles[pid] = nil
	end

	local cx, cy = world:coords(self.tile)
	local tiles = circle(sim, cx, cy, false) :: { number }
	if #tiles == 0 then
		sim:emit(pid, "tooClose")
		return
	end
	claim(sim, pid, self.tile, tiles)
	if sim.phase == "run" then
		sim.locked[pid] = true
	end
end

function Spawn.tick(_self: Spawn, _sim: any) end

-- Nation için verilen noktaya en yakın uygun kara yerleşimi (en fazla 25 tile uzağa kadar halka halka).
function Spawn.placeNear(sim: any, pid: number, x: number, y: number): boolean
	local world = sim.world
	for r = 0, 25 do
		for dy = -r, r do
			for dx = -r, r do
				if math.max(math.abs(dx), math.abs(dy)) == r then
					local tx, ty = x + dx, y + dy
					local tile = world:index(tx, ty)
					if tile and world:isLand(tile) and world:ownerAt(tile) == 0 then
						local tiles = circle(sim, tx, ty, true)
						if tiles then
							claim(sim, pid, tile, tiles)
							sim.locked[pid] = true
							return true
						end
					end
				end
			end
		end
	end
	return false
end

-- Bot için rastgele yerleşim. Başarılıysa true.
function Spawn.placeBot(sim: any, pid: number): boolean
	local cfg, world = sim.cfg, sim.world
	for tries = 1, cfg.BOT_SPAWN_TRIES do
		local tile = sim.rng:int(0, world.size - 1)
		if world:isLand(tile) and world:ownerAt(tile) == 0 then
			local cx, cy = world:coords(tile)
			local near = false
			if tries <= cfg.BOT_SPAWN_RELAX_AT then
				for other = 1, sim.playerCount do
					local c = sim.spawnCenter[other]
					if other ~= pid and c and sim.alive[other] then
						local ox, oy = world:coords(c)
						if math.abs(ox - cx) + math.abs(oy - cy) < cfg.BOT_SPAWN_MIN_DIST then
							near = true
							break
						end
					end
				end
			end
			if not near then
				local tiles = circle(sim, cx, cy, true)
				if tiles then
					claim(sim, pid, tile, tiles)
					sim.locked[pid] = true
					return true
				end
			end
		end
	end
	return false
end

return Spawn
]]></ProtectedString>
							<string name="ScriptGuid">{B637F7E2-E925-41CD-9C61-835D55E86E4C}</string>
