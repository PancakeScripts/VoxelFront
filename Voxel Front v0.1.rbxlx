				</Item>
				<Item class="ModuleScript" referent="RBX907F09CA9A3E40B48B2A6E9126D7FD7A">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- MatchHost: online maçın kendi (ayrılmış) sunucusundaki lobi tarafı. Kaydını sunucunun PrivateServerId'siyle bulur, lobi
-- açıkken kayıttaki oyuncu sayısını güncel tutar (gelmeyen ya da bekleme odasından ayrılanın koltuğunu geri verir), maçın ne
-- zaman başlayacağını söyler (lobinin başlama zamanı; ilk oyuncu gelince istemcisi açılsın diye kısa bir bekleme), başlayınca
-- lobiyi "started" yapar (katılım listelerinden çıkar; maç sürerken kayıt tazelenir) ve maç bitince herkesi normal bir
-- sunucuya gönderir (kayıt silinir).
-- RoWorld src/server/Lobbies/MatchHost.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.); değişiklikler: boş koltuğa bot
-- oyuncu eklenmez (harita solo ile aynı bot ve uluslarla oynanır), erken başlama oylaması yok.
--
--   deps = {
--     store = LobbyStore,
--     psid = string,                         -- game.PrivateServerId
--     now = function() -> number,            -- ortak saat (SharedClock.now)
--     to_hub = function(players, data?) -> (ok, err?),   -- data: hub'a ışınlanma verisi (parti)
--     log = function(text)?,
--   }
local LobbyRules = require(script.Parent.LobbyRules)

local MatchHost = {}
MatchHost.__index = MatchHost

MatchHost.SYNC_S = 3.0
--- Kayıt henüz bulunamadıysa (depo gecikmesi) bu aralıkla yeniden aranır.
MatchHost.LOOKUP_RETRY_S = 2.0
--- İlk insan geldikten sonra maç en az bu kadar bekler (istemcisi açılsın).
MatchHost.MIN_WAIT_AFTER_FIRST_S = 8

function MatchHost.new(deps: { [string]: any })
	local self = setmetatable({}, MatchHost)
	self.deps = deps
	self.lobby = nil :: LobbyRules.Lobby?
	self.started = false
	self.finished = false
	self._beat_in = 0.0
	self._first_arrival = nil :: number?
	--- bu sunucunun kaydı bulduğu an (starts_in hiçbir zaman _found_at + MAX_AHEAD_S'den fazla beklemez)
	self._found_at = nil :: number?
	self._sync_in = 0.0
	self._lookup_in = 0.0
	self._present = 0
	--- şu an burada olan ve şimdiye dek gelmiş insanların kullanıcı kimlikleri (koltuk defteri için)
	self._present_uids = {} :: { [string]: boolean }
	self._arrived = {} :: { [string]: boolean }
	--- lobi açıkken geri verilen koltuklar (log)
	self.released = 0
	self._busy = false
	return self
end

function MatchHost._log(self: any, text: string)
	if self.deps.log then
		self.deps.log("[MatchHost] " .. text)
	end
end

--- Lobi kaydını bulur (bekler). Bulunduysa true.
function MatchHost.lookup(self: any): boolean
	if self.lobby ~= nil then
		return true
	end
	local ok, v = pcall(self.deps.store.lobby_for_psid, self.deps.psid)
	if ok then
		self.lobby = LobbyRules.decode(v)
	end
	if self.lobby ~= nil then
		self._found_at = self.deps.now()
		self:_log(
			string.format(
				"lobby %s on %s, %d players, starts in %ds",
				self.lobby.id,
				self.lobby.map,
				self.lobby.max,
				self.lobby.starts - self.deps.now()
			)
		)
	end
	return self.lobby ~= nil
end

--- Şu an sunucudaki insan sayısı (gelişlerde / ayrılışlarda çağrılır).
function MatchHost.set_present(self: any, n: number)
	if n > 0 and self._first_arrival == nil then
		self._first_arrival = self.deps.now()
	end
	self._present = n
end

--- Burada kimler var (oynamaya gelen insanların kullanıcı kimlikleri): gelip ayrılanın ya da hiç gelmeyenin
--- (LobbyRules.ARRIVE_S) koltuğu lobi açıkken geri verilir.
function MatchHost.set_roster(self: any, uids: { string })
	local now: { [string]: boolean } = {}
	for _, u in uids do
		now[u] = true
		self._arrived[u] = true
	end
	self._present_uids = now
end

--- Maçın başlamasına kalan saniye (lobi bilinmiyorsa nil).
function MatchHost.starts_in(self: any): number?
	local l = self.lobby
	if l == nil then
		return nil
	end
	local now = self.deps.now()
	local at = l.starts
	-- bir lobinin en çok ne kadar ileriye planlanabileceğinden fazla beklenmez (bu sunucunun kaydı bulduğu andan)
	if self._found_at ~= nil then
		at = math.min(at, self._found_at + LobbyRules.MAX_AHEAD_S)
	end
	if self._first_arrival ~= nil then
		at = math.max(at, self._first_arrival + MatchHost.MIN_WAIT_AFTER_FIRST_S)
	end
	return math.max(0, at - now)
end

--- Her kare: kaydı arar / eşitler (kendi iş parçacığında; depo çağrıları bekler).
function MatchHost.tick(self: any, dt: number, spawn: ((() -> ()) -> ())?)
	if self._busy then
		return
	end
	local run: (() -> ())? = nil
	if self.lobby == nil then
		self._lookup_in -= dt
		if self._lookup_in <= 0 then
			self._lookup_in = MatchHost.LOOKUP_RETRY_S
			run = function()
				self:lookup()
			end
		end
	elseif not self.started then
		self._sync_in -= dt
		if self._sync_in <= 0 then
			self._sync_in = MatchHost.SYNC_S
			run = function()
				self:_sync()
			end
		end
	elseif not self.finished then
		self._beat_in -= dt
		if self._beat_in <= 0 then
			self._beat_in = LobbyRules.LIVE_BEAT_S
			run = function()
				self:_beat()
			end
		end
	end
	if run then
		self._busy = true
		local body = run
		local wrapped = function()
			local ok, err = pcall(body)
			if not ok then
				self:_log("sync failed: " .. tostring(err))
			end
			self._busy = false
		end
		if spawn then
			spawn(wrapped)
		else
			wrapped()
		end
	end
end

--- Lobi açıkken: kayıttaki oyuncu sayısı en az buradaki insanlar kadardır (yolda olanların koltuğunu normal sunucular
--- ekler; gelince burada sayılırlar). Bekleme odasından ayrılanın ya da hiç gelmeyenin (başarısız ışınlanma, yolda çıkan
--- oyuncu) koltuğu geri verilir, normal sunucular oraya başkasını oturtur.
function MatchHost._sync(self: any)
	local l = self.lobby
	if l == nil then
		return
	end
	local present = self._present
	local now = self.deps.now()
	local lapsed: { string } = {}
	local new = self.deps.store.update(l.id, function(v: any): any?
		local cur = LobbyRules.decode(v)
		if cur == nil then
			return nil
		end
		lapsed = LobbyRules.lapsed_seats(cur, self._present_uids, self._arrived, now)
		if cur.players >= present then
			return nil
		end
		cur.players = present
		return cur
	end)
	local d = LobbyRules.decode(new)
	if d then
		self.lobby = d
	end
	if #lapsed > 0 and self.deps.store.release ~= nil then
		local after, n = self.deps.store.release(l.id, lapsed)
		n = tonumber(n) or 0
		if n > 0 then
			self.released += n
			self:_log(string.format("gave back %d seat(s) of players who left or never came", n))
			local da = LobbyRules.decode(after)
			if da then
				self.lobby = da
			end
		end
	end
end

--- Maç sürerken: kayıt taze kalır ve buradaki insanları gösterir.
function MatchHost._beat(self: any)
	local l = self.lobby
	if l == nil then
		return
	end
	local now = self.deps.now()
	local present = self._present
	self.deps.store.update(l.id, function(v: any): any?
		local cur = LobbyRules.decode(v)
		if cur == nil then
			return nil
		end
		cur.beat = now
		cur.players = present
		return cur
	end)
end

--- Maç bitti: kaydı silinir. Bekler.
function MatchHost.finish(self: any)
	if self.finished then
		return
	end
	self.finished = true
	local l = self.lobby
	if l ~= nil then
		pcall(self.deps.store.remove, l.id)
	end
end

--- Maç başlıyor: lobi listelerden çıkar (bekler).
function MatchHost.start(self: any, humans: number)
	self.started = true
	local l = self.lobby
	if l == nil then
		return
	end
	pcall(self.deps.store.update, l.id, function(v: any): any?
		local cur = LobbyRules.decode(v)
		if cur == nil then
			return nil
		end
		cur.status = "started"
		cur.players = humans
		cur.beat = self.deps.now()
		return cur
	end)
	self:_log(string.format("starting %s with %d humans", l.id, humans))
end

--- Maçtan sonra: herkes normal bir sunucuya (`data`: ışınlanma verisi, ör. partiler).
function MatchHost.return_to_hub(self: any, players: { any }, data: any?): (boolean, string?)
	if #players == 0 then
		return true, nil
	end
	return self.deps.to_hub(players, data)
end

return MatchHost
]]></ProtectedString>
						<string name="ScriptGuid">{B99BD470-3C1D-4EF5-A031-180866AD5C03}</string>
