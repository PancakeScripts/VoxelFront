				<Item class="ModuleScript" referent="RBXF828E6A6C055477A801360059215864F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- StoreTests: LobbyStore (yerel depo ve sahte MemoryStore haritalarıyla bellek deposu) ve SharedClock testleri.
-- Oyunda çalışmaz; Studio'da elle: require(game.ServerScriptService.Server.Dev.StoreTests).run()
-- Döner: { passed, failed, lines }.

local Lobbies = script.Parent.Parent.Lobbies
local LobbyRules = require(Lobbies.LobbyRules)
local LobbyStore = require(Lobbies.LobbyStore)
local SharedClock = require(Lobbies.SharedClock)

local StoreTests = {}

-- MemoryStore'un sıralı / hash haritaları gibi davranan sahte harita. `rerun`: UpdateAsync dönüşümü önce eski bir değerle,
-- sonra güncel değerle çağırır (gerçek MemoryStore çakışmada böyle yapar).
local function fakeMap(clock: () -> number)
	local rows = {}
	local m = { rerun = false, calls = 0 }
	local function live(k)
		local r = rows[k]
		if r and r.exp <= clock() then
			rows[k] = nil
			return nil
		end
		return r
	end
	function m:GetAsync(k)
		m.calls += 1
		local r = live(k)
		return if r then r.value else nil
	end
	function m:SetAsync(k, v, exp, sort)
		m.calls += 1
		rows[k] = { value = v, exp = clock() + exp, sort = sort or 0 }
		return true
	end
	function m:RemoveAsync(k)
		m.calls += 1
		rows[k] = nil
	end
	function m:UpdateAsync(k, fn, exp)
		m.calls += 1
		local r = live(k)
		local cur = if r then r.value else nil
		if m.rerun and cur ~= nil then
			-- bir başka sunucu araya girdi: dönüşüm önce eski kopya üzerinde çalışır, sonra güncel kayıtla tekrar
			fn(table.clone(cur), r and r.sort)
		end
		local new, sort = fn(cur, r and r.sort)
		if new == nil then
			return nil
		end
		rows[k] = { value = new, exp = clock() + exp, sort = sort or (r and r.sort) or 0 }
		return new
	end
	function m:GetRangeAsync(dir, limit)
		m.calls += 1
		local list = {}
		for k in rows do
			local r = live(k)
			if r then
				table.insert(list, { key = k, value = r.value, sortKey = r.sort })
			end
		end
		table.sort(list, function(a, b)
			if dir == Enum.SortDirection.Ascending then
				return a.sortKey < b.sortKey
			end
			return a.sortKey > b.sortKey
		end)
		local out = {}
		for i = 1, math.min(limit, #list) do
			out[i] = list[i]
		end
		return out
	end
	return m
end

function StoreTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end
	local t = 1000
	local function clock()
		return t
	end
	local function lobby(id: string, starts: number, max: number?): any
		return { id = id, map = "europe", map_name = "Europe", max = max or 50, starts = starts, created = t, players = 0, status = "open" }
	end

	-- iki depo türü aynı testlerden geçer
	local kinds = {
		{ "yerel depo", function()
			return LobbyStore.localstore(clock), nil
		end },
		{ "bellek deposu", function()
			local lobbies, psids, locks = fakeMap(clock), fakeMap(clock), fakeMap(clock)
			return LobbyStore.memory_with(lobbies, psids, locks, "job-a", clock), { lobbies = lobbies, psids = psids, locks = locks }
		end },
	}
	for _, kind in kinds do
		local name = kind[1]
		t = 1000
		local store, maps = kind[2]()
		store.put(lobby("b", t + 80), 300)
		store.put(lobby("a", t + 40), 300)
		local list = store.list()
		expect(#list == 2, name .. ": iki kayıt listelenir")
		local ids = {}
		for _, v in list do
			ids[v.id] = true
		end
		expect(ids.a and ids.b, name .. ": ikisi de listede")
		expect(store.get("a").starts == t + 40, name .. ": kayıt okunur")

		-- koltuklar: 60 kişi 50 kişilik lobiye girmeye çalışır -> tam 50'si oturur
		local seated = 0
		for i = 1, 60 do
			local spec = LobbyRules.take_spec(1, { tostring(i) }, t, "a")
			if store.take(spec) ~= nil then
				seated += 1
			end
		end
		local a = LobbyRules.decode(store.get("a"))
		expect(seated == 50 and a.players == 50, name .. ": 60 katılımdan tam 50'si oturur (" .. seated .. ")")
		local ledger = 0
		for _ in a.seats do
			ledger += 1
		end
		expect(ledger == 50, name .. ": defterde 50 koltuk var")
		local after, n = store.release("a", { "3", "4", "404" })
		expect(n == 2 and after.players == 48 and LobbyRules.decode(store.get("a")).players == 48, name .. ": iki koltuk geri verilir")
		expect(store.take(LobbyRules.take_spec(1, { "x" }, t, "a")) ~= nil, name .. ": boşalan koltuğa yeni oyuncu oturur")
		-- aday listesiyle: dolu lobi atlanır, sıradakine oturulur
		store.put(lobby("full", t + 30, 1), 300)
		store.take(LobbyRules.take_spec(1, { "f1" }, t, "full"))
		local spec = LobbyRules.take_spec(1, { "y" }, t)
		spec.candidates = { "full", "b" }
		local got = store.take(spec)
		expect(got ~= nil and got.id == "b", name .. ": dolu lobi atlanır, sıradakine oturulur")
		-- kapanmış lobiye oturulmaz
		store.put(lobby("late", t + 3), 300)
		expect(store.take(LobbyRules.take_spec(1, { "z" }, t, "late")) == nil, name .. ": katılımı kapanmış lobiye oturulmaz")

		-- PrivateServerId -> lobi
		store.bind_psid("psid-1", "b", 300)
		local byp = store.lobby_for_psid("psid-1")
		expect(byp ~= nil and byp.id == "b", name .. ": maç sunucusu lobisini PrivateServerId ile bulur")
		expect(store.lobby_for_psid("yok") == nil, name .. ": bilinmeyen sunucu için lobi yok")

		-- süre aşımı ve silme
		store.remove("b")
		expect(store.get("b") == nil, name .. ": silinen kayıt gider")
		-- (güncellenen kayıt UPDATE_TTL_S daha yaşar: gerçek MemoryStore'da da UpdateAsync süreyi yeniler)
		t += LobbyStore.UPDATE_TTL_S + 1
		expect(store.get("a") == nil and #store.list() == 0, name .. ": süresi dolan kayıtlar kendiliğinden gider")

		-- çakışma: UpdateAsync dönüşümü yeniden çalıştırınca yalnız son çalışma sayılır
		if maps then
			store.put(lobby("c", t + 40, 2), 300)
			maps.lobbies.rerun = true
			local ok1 = store.take(LobbyRules.take_spec(1, { "p1" }, t, "c"))
			local ok2 = store.take(LobbyRules.take_spec(1, { "p2" }, t, "c"))
			local ok3 = store.take(LobbyRules.take_spec(1, { "p3" }, t, "c"))
			maps.lobbies.rerun = false
			local c = LobbyRules.decode(store.get("c"))
			expect(ok1 and ok2 and ok3 == nil and c.players == 2, name .. ": çakışmada koltuk iki kez sayılmaz, dolu lobi fazla almaz")
		end
	end

	-- kilit: iki sunucu aynı kilidi isterse yalnız biri alır; süre bitince diğeri alır; yanlış saatli kilit geçersizdir
	do
		t = 5000
		local locks = fakeMap(clock)
		local s1 = LobbyStore.memory_with(fakeMap(clock), fakeMap(clock), locks, "job-1", clock)
		local s2 = LobbyStore.memory_with(fakeMap(clock), fakeMap(clock), locks, "job-2", clock)
		expect(s1.lock("scheduler", 10) and not s2.lock("scheduler", 10), "kilidi yalnız bir sunucu alır")
		expect(s1.lock("scheduler", 10), "tutan sunucu kilidi yeniler")
		t += 11
		expect(s2.lock("scheduler", 10) and not s1.lock("scheduler", 10), "süre bitince kilidi diğer sunucu alır")
		locks:SetAsync("scheduler", { owner = "job-x", exp = t + 5000 }, 100)
		expect(s1.lock("scheduler", 10), "yanlış saatle çok uzun yazılmış kilit geçersiz sayılır")
		local l1 = LobbyStore.localstore(clock)
		expect(l1.lock("k", 10, "a") and not l1.lock("k", 10, "b"), "yerel depoda da kilidi yalnız biri alır")
	end

	-- ortak saat
	do
		SharedClock.offset = 0
		SharedClock.synced = false
		local fakeNow = 1700000000000
		local ms = fakeNow
		local ds = {}
		function ds:UpdateAsync(_key, fn)
			fn(nil)
			ms += 200 -- 200 ms gidiş-dönüş
			return 1, { UpdatedTime = fakeNow + 100 + 90000 } -- arka uç saati yerelden 90 sn ileri
		end
		local ok = SharedClock.measure({ datastore = ds, millis = function()
			return ms
		end })
		expect(ok and math.abs(SharedClock.offset - 90) < 0.01 and SharedClock.synced, string.format("saat farkı ölçülür (%+.2f sn)", SharedClock.offset))
		expect(math.abs(SharedClock.now() - (os.time() + 90)) < 1.01, "now() farkla düzeltilmiş saati verir")
		local slow = {}
		function slow:UpdateAsync(_key, fn)
			fn(nil)
			ms += 6000
			return 1, { UpdatedTime = ms }
		end
		SharedClock.offset = 0
		expect(not SharedClock.measure({ datastore = slow, millis = function()
			return ms
		end }) and SharedClock.offset == 0, "çok yavaş ölçüm kullanılmaz")
		local broken = {}
		function broken:UpdateAsync()
			error("DataStore kapalı")
		end
		expect(not SharedClock.measure({ datastore = broken }), "DataStore hatasında fark değişmez, oyun durmaz")
		SharedClock.offset = 0
		SharedClock.synced = false
	end

	return { passed = passed, failed = failed, lines = lines }
end

return StoreTests
]]></ProtectedString>
