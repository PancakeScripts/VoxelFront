						<string name="Name">NorthAmericaNations</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5bef1cbdb2770e300af89ec40001697c</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX1F62F316FCAC41B6BF024F3654EB9F91">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- South America ulus konumları (dünya haritasının ulusları, bu haritadaki yerlerine taşınmış: tools/make_region_nations.py)
return {
	width = 1020,
	height = 1471,
	nations = {
		{ name = "Colombia", x = 228, y = 284 },
		{ name = "Venezuela", x = 401, y = 205 },
		{ name = "Argentina", x = 362, y = 1230 },
		{ name = "Brazil", x = 782, y = 613 },
		{ name = "Peru", x = 189, y = 587 },
		{ name = "Uruguay", x = 549, y = 1075 },
		{ name = "Bolivia", x = 419, y = 787 },
	},
}
]]></ProtectedString>
						<string name="ScriptGuid">{05933BB0-6A3E-4599-A64C-816D964FB34C}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">SouthAmericaNations</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5bef1cbdb2770e300af89ec40001698e</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXBBB7838611D84EB3841B98A4555C7C1C">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Oyundaki haritalar, seçim ekranındaki sırayla. folder: Shared altındaki veri, module: Shared.Maps altındaki boyut ve ulus listesi,
-- land: kara tile sayısı, onlineMax: online maçta en çok oyuncu (RoWorld'ün karaya göre formülü, 5'e yuvarlı). Yalnız menü arkası için: cutRow (bu satırdan aşağısı kırpılır), cameraY (kamera merkezi, harita yüksekliğine oran).
return {
	order = { "world", "europe", "asia", "africa", "namerica", "samerica" },
	world = { name = "World", folder = "MapWorld", module = "WorldNations", land = 688991, onlineMax = 50, cutRow = 840, cameraY = 0.42 },
	europe = { name = "Europe", folder = "MapEurope", module = "EuropeNations", land = 740200, onlineMax = 50 },
	asia = { name = "Asia", folder = "MapAsia", module = "AsiaNations", land = 862267, onlineMax = 50 },
	africa = { name = "Africa", folder = "MapAfrica", module = "AfricaNations", land = 792142, onlineMax = 50 },
	namerica = { name = "North America", folder = "MapNorthAmerica", module = "NorthAmericaNations", land = 550738, onlineMax = 40 },
	samerica = { name = "South America", folder = "MapSouthAmerica", module = "SouthAmericaNations", land = 641994, onlineMax = 45 },
}
]]></ProtectedString>
						<string name="ScriptGuid">{818F252B-EB7E-41EB-AD73-06EBC086DCFB}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Catalog</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5bef1cbdb2770e300af89ec400016990</UniqueId>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX54477DCD1EE841ACB2C4F7D6C8923CF7">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Match: bir maçı kurar ve çalıştırır (harita, Simulation, tick döngüsü, istemcilere iletim). Oyun kuralları Core/'dadır.
-- createRemotes: Net.Remotes ile aynı arayüzü veren nesneleri döner; oyuncuyu çağıran taraf join / leave ile bildirir.
-- budgeted: tick işi kare başına süre bütçesiyle karelere bölünür (cihazda çalışırken takılma olmasın).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = table.clone(require(Shared:WaitForChild("Config"))) -- Config salt okunur; zorluk bu kopyayı değiştirir
local MapData = require(Shared:WaitForChild("MapData"))
local Delta = require(Shared:WaitForChild("Delta"))
local NetDiff = require(Shared:WaitForChild("NetDiff"))
local MapHash = require(Shared:WaitForChild("MapHash"))
local OwnerRuns = require(Shared:WaitForChild("OwnerRuns"))
local Sites = require(Shared:WaitForChild("Sites"))
local Telemetry = require(Shared:WaitForChild("Telemetry")) -- (yalnız sunucuda sayar; solo maç istemcide)
local Core = Shared:WaitForChild("Core")
local Maps = Shared:WaitForChild("Maps")

local World = require(Core.World)
local Rng = require(Core.Rng)
local Economy = require(Core.Economy)
local Heap = require(Core.Heap)
local TickClock = require(Core.TickClock)
local Territory = require(Core.Territory)
local Simulation = require(Core.Simulation)
local Spawn = require(Core.Executions.Spawn)
local Attack = require(Core.Executions.Attack)
local Cancel = require(Core.Executions.Cancel)
local Tribe = require(Core.Executions.Tribe)
local Build = require(Core.Executions.Build)
local Boat = require(Core.Executions.Boat)
local Naval = require(Core.Naval)
local NationNaval = require(Core.NationNaval)
local Nation = require(Core.Executions.Nation)
local Trade = require(Core.Executions.Trade)
local Warship = require(Core.Executions.Warship)
local Diplomacy = require(Core.Diplomacy)
local Diplo = require(Core.Executions.Diplo)
local Nuke = require(Core.Executions.Nuke)
local Rail = require(Core.Rail)
local NameBox = require(Core.NameBox)
local Train = require(Core.Executions.Train)
local Teams = require(Core.Teams)
local Catalog = require(Maps.Catalog)

local WORLD_LAND = 688991 -- dünya haritasının karası: bot sayısı buna oranlanır

local Match = {}

-- spawnSeconds (online): başlangıç fazı tam bu kadar sürer (herkes seçse de kısalmaz).
-- teams: 2..4 = takım maçı (Core/Teams), nil = herkes kendi için.
function Match.start(createRemotes: () -> any, budgeted: boolean?, mapId: string?, spawnSeconds: number?, teams: number?)
	local map = Catalog[mapId or "world"] or Catalog.world
	if spawnSeconds then
		local cfg: any = Config
		cfg.SPAWN_PHASE_SECONDS = spawnSeconds
		cfg.SPAWN_GRACE_SECONDS = spawnSeconds
	end
	-- süre sınırı RoWorld gibi: online maç (sunucuda) ONLINE_ROUND_MAX_SECONDS, solo maç (cihazda) sınırsız
	;(Config :: any).ROUND_MAX_SECONDS = if RunService:IsServer() then Config.ONLINE_ROUND_MAX_SECONDS else math.huge
	-- solo maç oyuncu düşünce bitmez (Take Over teklifi, izleme); online maçta herkes düşünce biter
	;(Config :: any).SOLO_KEEP_ON_DEATH = not RunService:IsServer()
	local mapInfo = require(Maps[map.module])
	-- Harita ve simülasyon -------------------------------------------------------------

	local t0 = os.clock() -- yalnızca ölçüm; oyun mantığında gerçek zaman okunmaz
	local tileBytes = MapData.decodeWorld(Shared:WaitForChild(map.folder), mapInfo.width * mapInfo.height)
	task.wait() -- açılış aşamaları arasında kare ver (zayıf cihazda tek uzun donma olmasın)
	local terrain = MapData.gameplay(tileBytes)
	task.wait()
	local world = World.new(mapInfo.width, mapInfo.height, terrain)
	-- (asıl değerden: aynı oturumda ikinci maç ölçeklenmiş değeri yeniden ölçeklemesin)
	;(Config :: any).BOT_COUNT = math.floor(require(Shared.Config).BOT_COUNT * world.landCount / WORLD_LAND + 0.5)
	;(Config :: any).NATION_COUNT = #mapInfo.nations
	-- (tutorial maçı: setTutorial)
	local normalBots = Config.BOT_COUNT
	local normalGrace = Config.SPAWN_GRACE_SECONDS
	task.wait()
	Naval.prepare(world) -- su rotaları için bölge grafiği (bir kez; gemi/ticaret rotası aramaları hızlı olsun)
	task.wait()
	Rail.prepare(world) -- ray bileşenleri ve arama buffer'ları (bir kez)
	print(
		string.format(
			"[Frontline] server %s: map loaded %dx%d, land %d tiles, %.1f ms",
			Config.VERSION,
			world.width,
			world.height,
			world.landCount,
			(os.clock() - t0) * 1000
		)
	)

	local seed = os.time() % 2147483647
	local sim = Simulation.new(world, Config, seed, { Territory = Territory, Rng = Rng, Economy = Economy, Heap = Heap, Spawn = Spawn, Attack = Attack, Cancel = Cancel, Tribe = Tribe, Build = Build, Boat = Boat, Naval = Naval, NationNaval = NationNaval, Nation = Nation, Trade = Trade, Warship = Warship, Diplomacy = Diplomacy, Diplo = Diplo, Nuke = Nuke, Rail = Rail, Train = Train, Sites = Sites, Teams = Teams })

	do
		local spots = {}
		for i, n in mapInfo.nations do
			spots[i] = { name = n.name, x = n.x, y = n.y }
		end
		sim.nationSpots = spots
	end
	sim.tribeNames = require(Maps.TribeNames)
	local paceDeadline = math.huge
	local function pace()
		if os.clock() >= paceDeadline then
			coroutine.yield()
		end
	end
	sim.pace = pace
	Naval.pace = pace
	sim:setTeams(teams) -- (uluslar doğarken takımlara dağıtılır)
	task.wait()
	sim:spawnBots()
	-- Medals için insanların sonucu (en çok toprak, fetihler, sıra; Shared.Medals.Tracker)
	local medals = require(Shared:WaitForChild("Medals")).Tracker.new(sim)

	local remotes = createRemotes()
	local packedMap = {
		width = mapInfo.width,
		height = mapInfo.height,
	}
	remotes.getMap.OnServerInvoke = function(_player: Player)
		return packedMap
	end

	-- Oyuncular ------------------------------------------------------------------------

	local pidOf: { [Player]: number } = {}
	local playerOf: { [number]: Player } = {}
	-- kasadan çıkan, giyilen skin ve bayrak (Server.Wallet / solo: istemcinin envanteri): pid -> { skin?, flag? }
	local cosmetics: { [number]: any } = {}
	local rate: { [Player]: { windowStart: number, count: number } } = {}

	-- group (online): birlikte gelenlerin (parti) anahtarı; takım maçında aynı takıma konurlar.
	local function onJoin(player: Player, group: string?)
		if pidOf[player] then
			return
		end
		local ok, pid = pcall(function()
			return sim:addPlayer(player.DisplayName, true, group) -- menüde başlar; "Oyna" ile katılır
		end)
		if not ok then
			warn("[Frontline] could not add player: " .. tostring(pid))
			return
		end
		pidOf[player] = pid
		playerOf[pid] = player
		rate[player] = { windowStart = os.clock(), count = 0 }
	end

	local function onLeave(player: Player)
		local pid = pidOf[player]
		if pid then
			sim:detachPlayer(pid) -- (toprağı AFK oyuncu gibi kalır; yerleşmemişse çıkar)
			playerOf[pid] = nil
		end
		pidOf[player] = nil
		rate[player] = nil
	end

	-- Oyuncuya bildirim (yük testinin sahte oyuncuları Player değildir: onlara gönderilmez).
	local function notify(player: any, ...: any)
		if typeof(player) == "Instance" then
			remotes.notice:FireClient(player, ...)
		end
	end

	-- Niyet (istemci -> sunucu). Gelen her şey güvenilmez kabul edilir ----------------------------

	local DIPLO_TYPES = { ally = true, allyAccept = true, allyReject = true, breakAlly = true, extendAlly = true, embargo = true }

	local function handleIntent(player: Player, payload: any)
		local pid = pidOf[player]
		local r = rate[player]
		if not pid or not r or type(payload) ~= "table" then
			return
		end
		local now = os.clock()
		if now - r.windowStart >= 1 then
			r.windowStart = now
			r.count = 0
		end
		r.count += 1
		if r.count > Config.MAX_INTENTS_PER_SECOND then
			return
		end
		if payload.type == "join" then
			local res = sim:join(pid)
			notify(player, if res == "joined" then "joined" elseif res == "waiting" then "waiting" else "joinedAlready")
			return
		elseif payload.type == "menu" then
			if (remotes :: any).compact == true then
				sim:detachPlayer(pid) -- online: maçtan çıkıyor, toprağı AFK oyuncu gibi kalır
			else
				sim:leaveToMenu(pid)
			end
			return
		end
		if payload.type == "spawn" and type(payload.tile) == "number" then
			sim:submit(pid, { type = "spawn", tile = payload.tile })
		elseif payload.type == "attack" and type(payload.target) == "number" and type(payload.ratio) == "number" then
			sim:submit(pid, { type = "attack", target = payload.target, ratio = payload.ratio, tile = if type(payload.tile) == "number" then payload.tile else nil })
		elseif payload.type == "build" and type(payload.what) == "string" and type(payload.tile) == "number" then
			sim:submit(pid, { type = "build", what = payload.what, tile = payload.tile })
		elseif payload.type == "upgrade" and type(payload.tile) == "number" then
			sim:submit(pid, { type = "upgrade", tile = payload.tile, what = if type(payload.what) == "string" then payload.what else nil })
		elseif DIPLO_TYPES[payload.type] and type(payload.target) == "number" then
			sim:submit(pid, { type = payload.type, target = payload.target, on = if type(payload.on) == "boolean" then payload.on else nil })
		elseif payload.type == "nuke" and type(payload.tile) == "number" and (payload.what == "atom" or payload.what == "hydro" or payload.what == "mirv") then
			sim:submit(pid, { type = "nuke", what = payload.what, tile = payload.tile })
		elseif payload.type == "warship" and type(payload.tile) == "number" then
			sim:submit(pid, { type = "warship", tile = payload.tile })
		elseif payload.type == "boat" and type(payload.tile) == "number" and type(payload.ratio) == "number" then
			sim:submit(pid, { type = "boat", tile = payload.tile, ratio = payload.ratio })
		elseif payload.type == "donate" and type(payload.target) == "number" and type(payload.ratio) == "number" then
			sim:submit(pid, { type = "donate", target = payload.target, what = if payload.what == "gold" then "gold" else "troops", ratio = payload.ratio })
		elseif payload.type == "warshipMove" and type(payload.tile) == "number" and type(payload.ids) == "table" then
			sim:submit(pid, { type = "warshipMove", tile = payload.tile, ids = payload.ids })
		elseif payload.type == "delete" and type(payload.tile) == "number" then
			sim:submit(pid, { type = "delete", tile = payload.tile })
		elseif payload.type == "cancel" and type(payload.target) == "number" then
			sim:submit(pid, { type = "cancel", target = payload.target })
		end
	end

	-- Tick karelere bölünmüşken gelen niyetler tick bitince işlenir.
	local tickThread: thread? = nil
	local heldIntents: { { any } } = {}
	local function onIntent(player: any, payload: any)
		if tickThread then
			table.insert(heldIntents, { player, payload })
		else
			handleIntent(player, payload)
		end
	end
	remotes.intent.OnServerEvent:Connect(onIntent)

	-- Ağ çıkışı ---------------------------------------------------------------------------

	-- Gerçek ağda (online maç) listeler yalnız değişenle gider; durumu isteyen istemci bir sonraki gönderimde tam
	-- listeyi ayrıca alır. Solo'da (LocalNet) her şey eskisi gibi düz gider.
	local compact = (remotes :: any).compact == true
	local encPlayers = NetDiff.encoder("pid")
	local encStructs = NetDiff.encoder("tile")
	local encBoats = NetDiff.encoder("id", "tile") -- (yalnız konumu değişen gemiler sıkı tamponda)
	local needStats: { [Player]: boolean } = {}
	local needBoats: { [Player]: boolean } = {}
	-- Harita eşleşme denetimi: gönderilen değişimlerin kopyası ve parmak izi (MapHash); her CHECK_EVERY istatistikte bir
	-- istemcilere gider, tutmayan istemci haritayı baştan ister.
	local CHECK_EVERY = 10
	local netOwner: buffer? = if compact then buffer.create(world.size * 2) else nil
	local netHash = 0
	local statsSent = 0

	local deltaSeq = 0
	local dTiles: { number } = {}
	local dOwners: { number } = {}

	local function flushDelta()
		local n = 0
		local segs = world:takeTickMarks()
		world:consumeDirty(function(tile: number, owner: number)
			n += 1
			dTiles[n] = tile
			dOwners[n] = owner
			if netOwner then
				netHash = MapHash.step(netHash, tile, buffer.readu16(netOwner, tile * 2), owner)
				buffer.writeu16(netOwner, tile * 2, owner)
			end
		end)
		if n == 0 then
			return
		end
		deltaSeq += 1
		remotes.delta:FireAllClients(Delta.pack(deltaSeq, sim.tickNo, dTiles, dOwners, n, segs, compact))
	end

	local function secondsLeft(): number
		if sim.phase == "ended" then
			return math.ceil(sim.endTicksLeft / Config.TICK_RATE)
		end
		return math.ceil(sim.spawnTicksLeft / Config.TICK_RATE)
	end

	-- İsim yazısı konumu ve boyutu (repodaki en büyük içteki dikdörtgen yöntemi, NameBoxCalculator.placeName) ve sınır kutusu.
	-- Repo her 30 tick'te tüm oyuncuları yeniden hesaplar; burada aynı tazelik (her oyuncu 30 tick'te bir) korunur ama yük
	-- her tick'e eşit yayılır (tick başına ~oyuncu/30 hesap), böylece tek tick'te toplu yük (takılma) oluşmaz.
	-- Başlangıç fazında bölgeler minicik olduğundan her gönderimde hepsi hesaplanır (repo placeSpawnName gibi anında izler).
	local NAME_REFRESH_TICKS = 30
	local boxes: { [number]: { tile: number?, size: number, bb: { number }? } } = {}
	local nameCursor = 0
	local function computeBox(pid: number)
		local tile, size, bb = NameBox.compute(world, pid, #sim.name[pid], tileBytes)
		if not tile then
			tile = world:centerOf(pid)
			size = 1
		end
		boxes[pid] = { tile = tile, size = size, bb = bb }
	end
	local function refreshNames()
		local n = sim.playerCount
		if n == 0 or sim.phase == "spawn" then
			return
		end
		for _ = 1, math.ceil(n / NAME_REFRESH_TICKS) do
			nameCursor = nameCursor % n + 1
			local pid = nameCursor
			if sim.alive[pid] and sim.spawned[pid] and world:tilesOwnedBy(pid) > 0 then
				computeBox(pid)
				pace()
			end
		end
	end
	local function boxOf(pid: number): (number?, number, { number }?)
		if not boxes[pid] or sim.phase == "spawn" then
			computeBox(pid)
		end
		local c = boxes[pid]
		return c.tile, c.size, c.bb
	end

	local function sendStats()
		local out: { [number]: number } = {}
		for k = 1, sim.executionCount do
			local e = sim.executions[k]
			if e and (e.kind == "attack" or e.kind == "boat") then
				out[e.pid] = (out[e.pid] or 0) + e.troops
			end
		end
		local list = {}
		for pid = 1, sim.playerCount do
			if sim.alive[pid] and sim.spawned[pid] then
				local nameTile, nameSize, nameBox = boxOf(pid)
				pace() -- başlangıç fazında her oyuncunun ad kutusu burada hesaplanır
				list[#list + 1] = {
					pid = pid,
					name = sim.name[pid],
					troops = Economy.display(Config, sim.troops[pid]),
					max = Economy.display(Config, sim:maxTroopsOf(pid)),
					out = Economy.display(Config, out[pid] or 0),
					tiles = world:tilesOwnedBy(pid),
					bot = sim.isBot[pid] == true and not sim.isNation[pid],
					nation = sim.isNation[pid] == true,
					sk = if cosmetics[pid] then cosmetics[pid].skin else nil, -- (giyilen skin: Shared.Cosmetics kimliği)
					fl = if cosmetics[pid] then cosmetics[pid].flag else nil, -- (giyilen bayrak)
					uid = if typeof(playerOf[pid]) == "Instance" then playerOf[pid].UserId else nil, -- (gerçek oyuncu: haritada headshot)
					team = if sim.teamCount > 0 then sim.team[pid] else nil, -- (takım maçı: 1..n, bot 0)
					c = nameTile,
					fs = nameSize,
					bb = nameBox,
					gold = math.floor(sim.gold[pid]),
					-- saniyelik asker artışı (ekranda gösterilen birimle; repo troopIncreaseRate x 10)
					rate = Economy.display(Config, Economy.growth(Config, sim.troops[pid], sim:maxTroopsOf(pid)) * (if sim.isNation[pid] then Config.NATION_GROWTH_MULT elseif sim.isBot[pid] then Config.BOT_GROWTH_MULT else 1) * Config.TICK_RATE),
					-- insan oyuncular için sonraki yapı fiyatları (sunucunun kesin formülü: repo unitInfo.cost; seviyeler dahil)
					costs = if sim.isBot[pid] then nil else {
						city = sim:structureCost(pid, "city"),
						factory = sim:structureCost(pid, "factory"),
						port = sim:structureCost(pid, "port"),
						post = sim:structureCost(pid, "post"),
						silo = sim:structureCost(pid, "silo"),
						sam = sim:structureCost(pid, "sam"),
						warship = math.min(Config.WARSHIP_COST_MAX, ((sim.warshipCount[pid] or 0) + 1) * Config.WARSHIP_COST_STEP),
					},
				}
			end
		end
		local structs = {}
		for _, st in sim.structList do
			-- ilerleme çubuğu (repo BarPass): inşaat, silo/SAM yeniden dolum ya da silinme geri sayımı. p = 0..1, d = toplam tick
			local p, d, bar = nil, nil, nil
			if not st.ready and (st.buildTicks or 0) > 0 then
				p, d, bar = 1 - (st.readyTick - sim.tickNo) / st.buildTicks, st.buildTicks, "build"
			elseif st.deleteAt then
				p, d, bar = (sim.tickNo - st.deleteFrom) / Config.DELETE_MARK_TICKS, Config.DELETE_MARK_TICKS, "delete"
			elseif st.type == "sam" and st.upTick and sim.tickNo - st.upTick < Config.SAM_UPGRADE_TICKS then
				-- SAM yükseltmesi: menzil SAM_UPGRADE_TICKS boyunca büyür (repo), çubuk bunu gösterir
				p, d, bar = (sim.tickNo - st.upTick) / Config.SAM_UPGRADE_TICKS, Config.SAM_UPGRADE_TICKS, "upgrade"
			elseif (st.type == "silo" or st.type == "sam") and #st.queue > 0 then
				local cd = if st.type == "silo" then Config.SILO_COOLDOWN else Config.SAM_COOLDOWN
				p, d, bar = (sim.tickNo - st.queue[1]) / cd, cd, "reload"
			end
			-- SAM'in şu anki menzili (üstüne gelince daire)
			local rg = if st.type == "sam" then math.floor(sim.parts.Nuke.samRange(Config, st, sim.tickNo) * 10 + 0.5) / 10 else nil
			structs[#structs + 1] = { tile = st.tile, type = st.type, pid = st.pid, level = st.level, ready = st.ready, q = #st.queue, p = p, d = d, bar = bar, rg = rg }
		end
		local D = sim.parts.Diplomacy
		local dip = { allies = {}, reqs = {}, traitors = {}, embargo = {} }
		for _, al in sim.dip.alliances do
			dip.allies[#dip.allies + 1] = { a = al.a, b = al.b, left = al.expires - sim.tickNo, ea = al.extA, eb = al.extB }
		end
		for _, r in sim.dip.requests do
			dip.reqs[#dip.reqs + 1] = { from = r.from, to = r.to, left = Config.ALLIANCE_REQUEST_TICKS - (sim.tickNo - r.created) }
		end
		for pid = 1, sim.playerCount do
			if sim.alive[pid] and D.isTraitor(sim, pid) then
				dip.traitors[#dip.traitors + 1] = { pid = pid, left = Config.TRAITOR_TICKS - (sim.tickNo - sim.dip.traitorAt[pid]) }
			end
			local m = sim.dip.embargo[pid]
			if m then
				for other in m do
					dip.embargo[#dip.embargo + 1] = { from = pid, to = other }
				end
			end
		end
		local payload = {
			dip = dip,
			structs = structs,
			tick = sim.tickNo,
			phase = sim.phase,
			left = secondsLeft(),
			round = sim.round,
			winner = sim.winner,
			winnerName = sim.name[sim.winner],
			teams = if sim.teamCount > 0 then sim.teamCount else nil,
			winnerTeam = if sim.winnerTeam ~= 0 then sim.winnerTeam else nil,
			-- başlangıç fazında herkesin takımı (henüz yerleşmeyenler dahil: oyuncu kendi takımını yer seçmeden görür)
			teamOf = if sim.teamCount > 0 and sim.phase == "spawn" then table.move(sim.team, 1, sim.playerCount, 1, {}) else nil,
			mirvCost = sim.parts.Nuke.mirvCost(sim),
			runTicks = sim.runTicks, -- maç süresi (başlangıç fazından sonra)
			players = list,
		}
		if not compact then
			remotes.stats:FireAllClients(payload)
			return
		end
		local d = table.clone(payload)
		d.z = 1
		d.players = encPlayers.diff(list)
		d.structs = encStructs.diff(structs)
		statsSent += 1
		if statsSent % CHECK_EVERY == 0 then
			d.sum = { s = deltaSeq, h = netHash } -- (son gönderilen harita paketinden sonraki durum)
		end
		remotes.stats:FireAllClients(d)
		if next(needStats) then
			local f = table.clone(payload)
			f.z = 1
			f.players = encPlayers.full()
			f.structs = encStructs.full()
			for p in needStats do
				if p.Parent ~= nil then
					remotes.stats:FireClient(p, f)
				end
			end
			table.clear(needStats)
		end
	end

	-- Tam durum pahalıdır (tüm harita kopyalanıp paketlenir). Online'da oyuncu başına STATE_COOLDOWN_S'de bir verilir
	-- (fazlası nil: istemci 2 sn sonra yeniden dener; sürekli isteyen sunucuyu yavaşlatamaz) ve aynı tick'te hazırlanan
	-- görüntü isteyen herkese aynen verilir (RoWorld MatchServer: RESYNC_COOLDOWN_MSEC, tick başına tek snapshot).
	local STATE_COOLDOWN_S = 10
	local lastState: { [any]: number } = {}
	local snapCache: any = nil
	remotes.getState.OnServerInvoke = function(player: Player)
		if compact then
			local t = os.clock()
			local last = lastState[player]
			if last ~= nil and t - last < STATE_COOLDOWN_S then
				return nil
			end
			lastState[player] = t
			needStats[player] = true
			needBoats[player] = true
			if last ~= nil then
				Telemetry.count(player, "Resync") -- (ilk istek giriştir, sonrakiler yeniden eşitleme)
			end
		end
		local snap = snapCache
		if snap == nil or snap.tick ~= sim.tickNo or snap.seq ~= deltaSeq or snap.round ~= sim.round then
			local kinds: { [number]: number } = {} -- 0 insan, 1 ulus, 2 bot (renk paleti için)
			local nations: { string } = {} -- ulus adları (renk adına göre; ulus olmayan "")
			local teamOf: { number }? = if sim.teamCount > 0 then {} else nil -- (takım maçı: renkler takımdan)
			for pid = 1, sim.playerCount do
				-- (Take Over'la alınan ulus rengini korur: eski adıyla ulus sayılır)
				local from = (sim :: any).takenFrom and (sim :: any).takenFrom[pid]
				kinds[pid] = if sim.isNation[pid] or from then 1 elseif sim.isBot[pid] then 2 else 0
				nations[pid] = if from then from elseif sim.isNation[pid] then sim.name[pid] or "" else ""
				if teamOf then
					teamOf[pid] = sim.team[pid] or 0
				end
			end
			snap = {
				tick = sim.tickNo,
				seq = deltaSeq,
				round = sim.round,
				owners = OwnerRuns.encode(world:cloneOwner(), world.size),
				rails = Rail.snapshot(sim),
				kinds = kinds,
				nations = nations,
				teamOf = teamOf,
				teams = if sim.teamCount > 0 then sim.teamCount else nil,
			}
			snapCache = snap
		end
		return {
			pid = pidOf[player] or 0,
			phase = sim.phase,
			left = secondsLeft(),
			round = sim.round,
			alive = sim.alive[pidOf[player] or 0] == true,
			-- "menu": oynamıyor; "waiting": sonraki turu bekliyor; "playing": bu turda (elenmiş olabilir: alive=false)
			mode = (function()
				local p = pidOf[player] or 0
				if sim.inRound[p] then
					return "playing"
				elseif sim.wantsPlay[p] then
					return "waiting"
				end
				return "menu"
			end)(),
			seq = snap.seq,
			owners = snap.owners,
			rails = snap.rails,
			kinds = snap.kinds,
			nations = snap.nations,
			teamOf = snap.teamOf,
			teams = snap.teams,
		}
	end

	local NOTICE_OK = {
		boatInbound=true, warshipLost=true, transportLost=true, tradeCaptured=true,
		boatLanded = true, boatLandedOnYou = true, boatReturned = true, structCaptured = true, structDestroyed = true,
		warshipKill = true, allyRenewAsk = true, allyNoAnswer = true, bigNeighbor = true,
		badTile = true, notLand = true, tooClose = true, locked = true,
		badTarget = true, notStarted = true, notSpawned = true, noTroops = true, noBorder = true, tooMany = true, eliminated = true,
		noGold = true, notOwned = true, noSpace = true, noCity = true,
		noBoats = true, noShore = true, noLanding = true, noRoute = true, noPort = true, noPortHere = true,
		allied = true, teammate = true, allyNo = true, allyBot = true, allyWait = true, allyNew = true, allyRejected = true, allyBroken = true,
		allyNoExt = true, allyRenewed = true, allyNone = true, allyExpired = true,
		noSilo = true, noSiloHere = true, noSamHere = true, nukeInbound = true, hydroInbound = true, nukeHit = true, hydroHit = true,
		samHit = true, nukeDown = true, noFactoryHere = true, nukeOwn = true, nukeAlly = true, mirvInbound = true,
		donateNotAlly = true, donateWait = true, donatedGold = true, donatedTroops = true, gotGold = true, gotTroops = true,
		deleteWait = true, deleteNone = true, deleteMarked = true, tookOver = true,
	}
	local function sendBoats()
		local list = {}
		for k = 1, sim.executionCount do
			local e = sim.executions[k]
			if e and e.kind == "nuke" and not e.done and not e.warhead then -- (savaş başlıklarını istemci kendisi çizer)
				list[#list + 1] = { id = e.id, pid = e.pid, tile = e:position(), k = if e.what == "hydro" then 5 elseif e.what == "mirv" then 6 else 4, dst = e.tile, src = e.src }
			elseif e and (e.kind == "boat" or e.kind == "trade" or e.kind == "warship") and not e.done then
				list[#list + 1] = {
					id = e.id,
					pid = e.pid,
					tile = e:position(),
					k = if e.kind == "trade" then 2 elseif e.kind == "warship" then 3 else 1,
					hp = if e.kind == "warship" then math.floor(e.health / e:maxHealth(Config) * 100) else nil,
					st = if e.kind == "warship" then e.state else nil,
					-- nakliye gemisinin iniş tile'ı (repo AttackRings: kendi gemilerinin hedefinde işaret)
					dst = if e.kind == "boat" then e.dst else nil,
				}
			end
		end
		if not compact then
			remotes.boats:FireAllClients(list)
			return
		end
		remotes.boats:FireAllClients({ z = 1, b = encBoats.diff(list) })
		if next(needBoats) then
			local f = { z = 1, b = encBoats.full() }
			for p in needBoats do
				if p.Parent ~= nil then
					remotes.boats:FireClient(p, f)
				end
			end
			table.clear(needBoats)
		end
	end

	-- Saldırı asker sayıları (cephe hattı kümeleri). Yalnız insanı ilgilendiren saldırılar gönderilir:
	-- giden saldırı (hedef sahipsiz değil) ve botlardan gelmeyen gelen saldırı. İstemci kendi oyuncusuna göre süzer.
	local attackUid = 0
	local function sendAttacks()
		local list = {}
		for k = 1, sim.executionCount do
			local e = sim.executions[k]
			if e and e.kind == "attack" and not e.done then
				local humanOut = not sim.isBot[e.pid]
				local humanIn = e.target ~= 0 and not sim.isBot[e.target] -- botlardan gelenler de (sınır kırmızısı için); istemci onları etiketlemez
				if humanOut or humanIn then
					if not e.uid then
						attackUid += 1
						e.uid = attackUid
					end
					list[#list + 1] = {
						id = e.uid,
						pid = e.pid,
						tg = e.target,
						tr = Economy.display(Config, e.troops),
						p = if e.target ~= 0 then Attack.clusters(e, world, 30, 2) else {}, -- boş toprağa saldırıda sayı etiketi yok (repo)
					}
				end
			end
		end
		remotes.attacks:FireAllClients(list)
	end

	local function sendNotices()
		for _, e in sim:takeEvents() do
			local player = playerOf[e.pid]
			if player and NOTICE_OK[e.code] then
				notify(player, e.code, e.detail)
			end
		end
	end

	-- Tick döngüsü ------------------------------------------------------------------------

	local acc = 0
	local slowest = 0
	local slowFrames = 0 -- (online sunucu: 50 ms'yi aşan kareler, 30 sn'de bir Telemetry'ye)
	local lastReport = os.clock()
	local running = not budgeted -- cihazda maç PLAY ile başlar

	local mobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

	local function runTick()
		local ok, err = pcall(sim.tick, sim)
		if not ok then
			warn("[Frontline] tick error: " .. tostring(err))
		end
		if sim.tickNo % 10 == 0 then
			medals:step()
		end
		world:markTick() -- paket içinde tick sınırı (istemci tick tick oynatır)
		pace()
		refreshNames()
		pace()
		if sim.tickNo % Config.NET_DELTA_INTERVAL_TICKS == 0 then
			flushDelta()
			pace()
			sendBoats()
			pace()
		end
		if sim.tickNo % 2 == 0 then
			sendAttacks()
			pace()
		end
		if sim.tickNo % Config.NET_STATS_INTERVAL_TICKS == 0 then
			sendStats()
			pace()
		end
		sendNotices()
		if sim.fx then
			remotes.fx:FireAllClients(sim.fx)
			sim.fx = nil
		end
		-- cihazdaki maç tur bitince durur (yeni tur oyuncu isteyince)
		if budgeted and sim.phase == "ended" then
			sendStats()
			running = false
		end
	end

	-- Kare bütçesi (saniye): telefonda daha az; tick birikmişse biraz daha fazla (RoWorld Session değerleri).
	-- Online maç sunucusunda daha geniş (ekranı yok; 50 insanlı geç oyunda tick'ler yetişsin).
	local server = RunService:IsServer()
	local BUDGET = if budgeted then (if server then 0.012 elseif mobile then 0.004 else 0.006) else math.huge
	local BUDGET_BEHIND = if budgeted then (if server then 0.020 elseif mobile then 0.008 else 0.010) else math.huge
	local pendingTicks = 0
	local difficulty = "normal"

	local heartbeat = RunService.Heartbeat:Connect(function(dt: number)
		if not running then
			return
		end
		local steps
		steps, acc = TickClock.advance(acc, dt, Config.TICK_SECONDS, Config.MAX_CATCHUP_TICKS)
		pendingTicks = math.min(pendingTicks + steps, Config.MAX_CATCHUP_TICKS)
		local s = os.clock()
		paceDeadline = s + (if pendingTicks > 1 then BUDGET_BEHIND else BUDGET)
		while pendingTicks > 0 and os.clock() < paceDeadline do
			local thread = tickThread or coroutine.create(runTick)
			tickThread = thread
			local ok, err = coroutine.resume(thread)
			if not ok then
				warn("[Frontline] tick error: " .. tostring(err))
			end
			if coroutine.status(thread) ~= "dead" then
				break
			end
			tickThread = nil
			pendingTicks -= 1
			local held = heldIntents
			heldIntents = {}
			for _, item in held do
				handleIntent(item[1], item[2])
			end
		end
		slowest = math.max(slowest, os.clock() - s) -- bir karede maça harcanan en uzun süre
		if dt > 0.05 then
			slowFrames += 1
		end
		local now = os.clock()
		if now - lastReport >= 30 then
			lastReport = now
			if compact and slowFrames > 0 then
				Telemetry.count(nil, "SlowFrames", slowFrames)
			end
			slowFrames = 0
			local humans = 0
			for _ in pidOf do
				humans += 1
			end
			print(
				string.format(
					"[Frontline] tick %d, phase %s, players %d, slowest frame %.2f ms",
					sim.tickNo,
					sim.phase,
					humans,
					slowest * 1000
				)
			)
			slowest = 0
		end
	end)

	-- Yarım kalan tick'i bitirir, yeni turu duraklatılmış olarak hazırlar.
	local function reset()
		running = false
		paceDeadline = math.huge
		local thread = tickThread
		if thread then
			while coroutine.status(thread) ~= "dead" do
				coroutine.resume(thread)
			end
			tickThread = nil
		end
		running = false
		pendingTicks = 0
		acc = 0
		table.clear(heldIntents)
		sim:newRound()
		if netOwner then
			buffer.fill(netOwner, 0, 0)
			netHash = 0
		end
		flushDelta()
		sendBoats()
		sendAttacks()
		sendStats()
	end

	return {
		join = onJoin,
		leave = function(player: Player)
			onLeave(player)
			lastState[player] = nil
		end,
		-- Online: oyuncuyu bu tura sokar (başlangıç fazındaysa oynar, değilse izler).
		play = function(player: Player)
			local pid = pidOf[player]
			if pid then
				local res = sim:join(pid)
				notify(player, if res == "joined" then "joined" elseif res == "waiting" then "waiting" else "joinedAlready")
			end
		end,
		phase = function(): string
			return sim.phase
		end,
		-- Yük testi (Server.Dev.SoakTest): sahte oyuncunun niyeti, istemciden gelenle aynı yoldan; sim yalnız okunur.
		intent = onIntent,
		sim = sim,
		medals = medals, -- (Shared.Medals.Tracker: result(pid, left) / final(pid) / card(pid))
		pidOf = function(player: any): number?
			return pidOf[player]
		end,
		-- Solo maçın tek seferlik Robux ürünleri (Client.SoloShop): oyuncunun ülkesine uygulanır; yalnız o tur. true = uygulandı.
		boost = function(player: any, kind: string): boolean
			local pid = pidOf[player]
			if pid == nil or not sim.alive[pid] or not sim.spawned[pid] or sim.phase == "ended" then
				return false
			end
			local s = sim :: any
			local TROOPS = { solo_troops10k = 10000, solo_troops30k = 30000, solo_troops70k = 70000, solo_troops200k = 200000 }
			local GOLD = { solo_gold100k = 100000, solo_gold500k = 500000, solo_gold2m = 2000000, solo_gold10m = 10000000 }
			if kind == "solo_troops2x" then
				s.troopMult = s.troopMult or {}
				s.troopMult[pid] = 2
			elseif kind == "solo_gold2x" then
				s.goldMult = s.goldMult or {}
				s.goldMult[pid] = 2
			elseif TROOPS[kind] then
				sim.troops[pid] += TROOPS[kind] * Config.TROOP_DISPLAY_DIV -- (ekrandaki birim -> iç birim)
			elseif GOLD[kind] then
				sim.gold[pid] += GOLD[kind]
			else
				return false
			end
			return true
		end,
		-- Solo ürünü şu an uygulanabilir mi (oyuncu yerleşmiş, hayatta, tur sürüyor).
		canBoost = function(player: any): boolean
			local pid = pidOf[player]
			return pid ~= nil and sim.alive[pid] == true and sim.spawned[pid] == true and sim.phase ~= "ended"
		end,
		-- Oyuncunun maçta etkin x2'leri ({ troops = bool, gold = bool }).
		boosts = function(player: any): any
			local pid = pidOf[player]
			local s = sim :: any
			return {
				troops = pid ~= nil and s.troopMult ~= nil and s.troopMult[pid] ~= nil,
				gold = pid ~= nil and s.goldMult ~= nil and s.goldMult[pid] ~= nil,
			}
		end,
		-- Take Over: oyuncuyu düşüren ulus (World.takenBy) devralınır. Hedef: (pid, ad) ya da nil.
		takeoverTarget = function(player: any): (number?, string?)
			local old = pidOf[player]
			local target = if old then (world :: any).takenBy and (world :: any).takenBy[old] else nil
			if old and target and sim:canTakeOver(old, target) then
				return target, sim.name[target]
			end
			return nil, nil
		end,
		takeover = function(player: any): boolean
			-- (yarım kalan tick önce biter: devralma bir tick'in ortasında olmaz)
			local thread = tickThread
			if thread then
				while coroutine.status(thread) ~= "dead" do
					coroutine.resume(thread)
				end
				tickThread = nil
				pendingTicks = math.max(pendingTicks - 1, 0)
			end
			local old = pidOf[player]
			local target = if old then (world :: any).takenBy and (world :: any).takenBy[old] else nil
			if old == nil or target == nil or not sim:takeOver(old, target) then
				return false
			end
			pidOf[player] = target
			playerOf[old] = nil
			playerOf[target] = player
			if cosmetics[old] then
				cosmetics[target] = cosmetics[old]
				cosmetics[old] = nil
			end
			medals:adopt(old, target)
			snapCache = nil -- (yeni durum: istemci kendini yeniden kurar)
			return true
		end,
		-- Oyuncunun giydiği skin ve bayrak ({ skin?, flag? } ya da nil); istatistiklerle herkese gider.
		setCosmetics = function(player: any, equipped: any)
			local pid = pidOf[player]
			if pid then
				cosmetics[pid] = if type(equipped) == "table" then { skin = equipped.skin, flag = equipped.flag } else nil
			end
		end,
		tileBytes = tileBytes,
		terrain = terrain,
		setRunning = function(on: boolean)
			running = on
		end,
		reset = reset,
		stop = function()
			running = false
			heartbeat:Disconnect()
		end,
		-- Tutorial maçı (yeni oyuncunun ilk solo maçı; RoWorld Data/Tutorial): botların %40'ı (büyümeye yer kalsın;
		-- dünyada 150 yerine 60, RoWorld'deki gibi), herkes yerini seçince 1 sn'de başlar. Bir sonraki reset'te geçerli olur.
		setTutorial = function(on: boolean)
			local cfg: any = Config
			cfg.BOT_COUNT = if on then math.floor(normalBots * 0.4 + 0.5) else normalBots
			cfg.SPAWN_GRACE_SECONDS = if on then 1 else normalGrace
		end,
		-- Zorluk ayarını uygular; bir sonraki reset'te geçerli olur.
		setDifficulty = function(id: string)
			local level = Config.DIFFICULTY[id]
			if not level or id == difficulty then
				return
			end
			difficulty = id
			for key, value in level do
				(Config :: any)[key] = value
			end
		end,
	}
end

return Match
]]></ProtectedString>
					<string name="ScriptGuid">{0F4A8A29-8214-4B1E-8C09-00CF0454A8E3}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Match</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5bef1cbdb2770e300af89ec4000034d7</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6D9330195EAD420D99538E5745926E98">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- LocalNet: maç aynı cihazda çalışırken Net.Remotes ile aynı arayüzü veren nesneler (ağ yok, doğrudan çağrı).
-- Remote'lar gibi: dinleyici bağlanmadan gelen olaylar bekletilir, her dinleyici kendi iş parçacığında çalışır.

local LocalNet = {}

local function newEvent(player: Player): any
	local server: ((...any) -> ())? = nil
	local client: { (...any) -> () } = {}
	local pending: { { n: number, [number]: any } } = {}
	local function deliver(...: any)
		if #client == 0 then
			table.insert(pending, table.pack(...))
			return
		end
		for _, f in client do
			task.spawn(f, ...)
		end
	end
	return {
		FireServer = function(_self: any, ...: any)
			if server then
				task.spawn(server, player, ...)
			end
		end,
		FireAllClients = function(_self: any, ...: any)
			deliver(...)
		end,
		FireClient = function(_self: any, _target: Player, ...: any)
			deliver(...)
		end,
		OnServerEvent = {
			Connect = function(_self: any, f: (...any) -> ())
				server = f
			end,
		},
		OnClientEvent = {
			Connect = function(_self: any, f: (...any) -> ())
				table.insert(client, f)
				for _, args in pending do
					task.spawn(f, table.unpack(args, 1, args.n))
				end
				table.clear(pending)
			end,
		},
	}
end

local function newFunction(player: Player): any
	local fn: any = { OnServerInvoke = nil }
	function fn.InvokeServer(self: any, ...: any): any
		return self.OnServerInvoke(player, ...)
	end
	return fn
end

function LocalNet.new(player: Player): any
	return {
		getMap = newFunction(player),
		getState = newFunction(player),
		intent = newEvent(player),
		delta = newEvent(player),
		stats = newEvent(player),
		notice = newEvent(player),
		boats = newEvent(player),
		fx = newEvent(player),
		attacks = newEvent(player),
	}
end

return LocalNet
