				<Item class="ModuleScript" referent="RBX32967C3B4F0E4BEC834A2040A92B49BD">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- RailGeom: demiryolu çiziminin hesap kısmı (Roblox API'si yok, testlenir).
--   * runs: ray tile listesini sahibine göre ardışık parçalara böler (repo rayı her tile'da o tile'ın sahibinin
--     renginde çizer). Komşu parçalar bir tile paylaşır ki çizgide boşluk kalmasın.
--   * simplify: Douglas-Peucker ile parçayı birkaç düz çizgiye indirger.
--   * fade: zoom'a göre görünürlük (repo RailroadPass: railMinZoom - railFadeRange'de 0, railMinZoom'da 1).
--   * brightness: colord brightness() (repo: benim rayım beyaz; toprağım çok açıksa siyah).

local RailGeom = {}

export type Run = { owner: number, i0: number, i1: number }

function RailGeom.runs(tiles: { number }, ownerAt: (tile: number) -> number): { Run }
	local out: { Run } = {}
	local n = #tiles
	if n == 0 then
		return out
	end
	local cur = ownerAt(tiles[1])
	local start = 1
	for i = 2, n do
		local o = ownerAt(tiles[i])
		if o ~= cur then
			out[#out + 1] = { owner = cur, i0 = start, i1 = i }
			cur = o
			start = i
		end
	end
	out[#out + 1] = { owner = cur, i0 = start, i1 = n }
	return out
end

function RailGeom.signature(runs: { Run }): string
	local parts = table.create(#runs * 2)
	for _, r in runs do
		parts[#parts + 1] = r.owner
		parts[#parts + 1] = r.i1
	end
	return table.concat(parts, ",")
end

-- keep[i] = true olan noktalar çizginin köşeleri (uçlar her zaman tutulur).
function RailGeom.simplify(xs: { number }, ys: { number }, i0: number, i1: number, tol: number, keep: { boolean })
	keep[i0] = true
	keep[i1] = true
	local function rec(a: number, b: number)
		local ax, ay, bx, by = xs[a], ys[a], xs[b], ys[b]
		local dx, dy = bx - ax, by - ay
		local len = math.sqrt(dx * dx + dy * dy)
		local far, farD = -1, tol
		for i = a + 1, b - 1 do
			local d
			if len < 1e-6 then
				d = math.sqrt((xs[i] - ax) ^ 2 + (ys[i] - ay) ^ 2)
			else
				d = math.abs((xs[i] - ax) * dy - (ys[i] - ay) * dx) / len
			end
			if d > farD then
				far, farD = i, d
			end
		end
		if far > 0 then
			keep[far] = true
			rec(a, far)
			rec(far, b)
		end
	end
	if i1 - i0 >= 2 then
		rec(i0, i1)
	end
end

export type FadeCfg = { hideZoom: number, fullZoom: number }

-- 0 (görünmez) .. 1 (tam). hideZoom >= fullZoom ise eşik gibi davranır (repo fadeRange <= 0).
function RailGeom.fade(cfg: FadeCfg, zoom: number): number
	local range = cfg.fullZoom - cfg.hideZoom
	if range <= 0 then
		return if zoom >= cfg.fullZoom then 1 else 0
	end
	return math.clamp((zoom - cfg.hideZoom) / range, 0, 1)
end

-- colord brightness: (r*299 + g*587 + b*114) / 1000 / 255
function RailGeom.brightness(r: number, g: number, b: number): number
	return (r * 299 + g * 587 + b * 114) / 1000 / 255
end

return RailGeom
]]></ProtectedString>
						<string name="ScriptGuid">{04C3A537-7E7B-41DF-B6B1-C8D3D182814D}</string>
