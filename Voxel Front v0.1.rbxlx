					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Sunucu <-> istemci iletişim adları. İki tarafın da aynı ismi kullanması için tek yerde.
-- Tüm remote'lar ReplicatedStorage içindeki tek bir klasörde durur; istemci klasörü görünce hepsi hazırdır.

return table.freeze({
	Folder = "FrontlineNet",

	-- RemoteFunction: istemci haritayı ister; { width, height, data (MapData.pack buffer'ı) } döner.
	GetMap = "GetMap",
	-- RemoteFunction: tam durum görüntüsü (sahiplik RLE, faz, oyuncu kimliği, istatistikler).
	GetState = "GetState",
	-- RemoteEvent (istemci -> sunucu): niyet. { type = "spawn", tile = number }
	Intent = "Intent",
	-- RemoteEvent (sunucu -> istemci): değişen tile'ların paketi (Delta.pack buffer'ı).
	Delta = "Delta",
	-- RemoteEvent (sunucu -> istemci): oyuncu istatistikleri (saniyede bir).
	Stats = "Stats",
	-- RemoteEvent (sunucu -> istemci): oyuncuya kısa bildirim metni.
	Notice = "Notice",
	-- RemoteEvent (sunucu -> istemci): gemi konumları { {pid, tile} } (3 tick'te bir).
	Boats = "Boats",
	-- RemoteEvent (sunucu -> istemci): patlama / önleme efektleri { {k="atom"|"hydro"|"sam", tile, r} }.
	Fx = "Fx",
	Attacks = "Attacks",

	-- Online eşleştirme (normal sunucularda; ayrı klasör: maç remote'larından bağımsız)
	LobbyFolder = "FrontlineLobby",
	-- RemoteEvent (sunucu -> istemci): açık online maçlar { { id, map, map_name, max, players, starts_in, joinable } }, birkaç saniyede bir.
	LobbyInfo = "LobbyInfo",
	-- RemoteEvent (istemci -> sunucu): "join" (Solo Online'a katıl), "cancel" (sıradan çık), "watch" / "unwatch" (Solo Online
	-- penceresi açıldı / kapandı: sunucu listeyi yalnız pencere açıkken okur ve gönderir).
	LobbyJoin = "LobbyJoin",
	-- RemoteEvent (sunucu -> istemci): katılma durumu ("joining" | "line" | "sent" | "failed", mesaj?).
	LobbyState = "LobbyState",
	-- RemoteEvent (istemci -> sunucu): parti ("invite" | "accept" | "decline" | "kick", kullanıcı kimliği) / ("leave") /
	-- ("menu", menüde mi: menüde olmayan üye lider katılınca gitmez).
	Party = "Party",
	-- RemoteEvent (sunucu -> istemci): parti durumu ({ members = { {uid, name, leader} }, leader, invites = { {uid, name} }, max }).
	PartyState = "PartyState",

	-- Online maç sunucusu (ayrılmış sunucu; Studio'da aynı sunucuda yerel maç). Klasörün öznitelikleri bekleme odasını anlatır:
	-- Map, MapName, Max, Players (bekleyen insan), StartsIn (saniye; -1 bilinmiyor), Phase ("lobby" | "spawn" | "run" | "ended").
	MatchFolder = "FrontlineMatch",
	-- RemoteEvent (istemci -> sunucu): maçtan ayrıl, normal sunucuya dön.
	MatchLeave = "Leave",
	-- RemoteEvent (sunucu -> istemci): Studio'da yerel maça girildi ("enter") ya da maçtan çıkıldı ("hub").
	MatchMove = "Move",
})
]]></ProtectedString>
