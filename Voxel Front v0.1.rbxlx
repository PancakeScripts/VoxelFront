					<ProtectedString name="Source"><![CDATA[--!strict
-- Look (Görünüm ayarları): haritadaki yapı simgelerinin, gemilerin, yolların, dairelerin ve kamera geçişinin boyları,
-- renkleri ve saydamlıkları TEK yerde. Bu dosyadaki sayıları Studio'da değiştirip Play'e basman yeter; başka bir
-- yere dokunmana gerek yok. Değerlerin çoğu OpenFront'un render-settings.json / default-theme.json dosyasından
-- (repo varsayılanları) alındı; yanlarında "repo" yazar. "zoom" = bir tile'ın ekrandaki piksel boyu (uzak ~1, yakın ~10+).
--
-- Görsel (image) kimlikleri burada değil: ReplicatedStorage > Shared > Assets.

local Look = {}

-- Yalnız geçen lokomotif/vagon görselleri; ray, hız ve araç aralığı değişmez.
Look.Train = { scale = 1.15 }

-- Haritadaki yapılar (şehir, liman, fabrika, savunma kulesi, SAM, silo) — repo StructurePass
Look.Structure = {
	iconSize = 51, -- (repo 60) zoom 3..7 arasında simgenin piksel boyu. Hepsini büyütmek/küçültmek için bunu değiştir.
	dotsZoom = 1.2, -- (repo 1.2) zoom bundan küçükse simge yerine yalnız renkli şekil ("nokta") çizilir
	dotScale = 0.25, -- (repo 0.3) noktanın boyu = iconSize x bu (60 x 0.3 = 18 px). Uzaktan çok büyük gelirse küçült.
	shrinkZoom = 3.5, -- (repo 3) zoom bunun altındayken simge zoomla orantılı küçülür
	growZoom = 7, -- (repo 7) zoom bunun üstündeyken simge haritayla birlikte büyür (haritaya "yapışır")
	maxPx = 160, -- (bize özgü) çok yakınlaşınca simgenin en büyük piksel boyu
	-- tür başına boy çarpanı ve şekil (repo shapes)
	scale = { city = 1, port = 1.08, factory = 1.08, post = 1, sam = 1.4, silo = 1.55 },
	-- simgenin şeklin içindeki doluluğu (repo iconFill)
	iconFill = { city = 0.85, port = 0.85, factory = 0.85, post = 0.8, sam = 1, silo = 0.85 },
	-- Assets.Structures görsellerinin şekle sığdırılmış boyu: { görselin kenarı / yapı boyu, merkezin dikey kayması / yapı boyu }.
	-- Görselin dolu pikselleri tek tek ölçülerek bulundu (2026-11-06): resmin hiçbir dolu pikseli şeklin kenar çizgisine
	-- değmeden en büyük boy. Assets.Structures'ta bir görseli değiştirirsen bu sayı da yeniden ölçülmeli; listede olmayan
	-- tür için kod şeklin içine sığan kareyi kullanır.
	glyphFit = {
		city = { 0.639, -0.05 },
		port = { 0.663, -0.03 },
		factory = { 0.529, -0.05 },
		post = { 0.572, -0.06 },
		sam = { 0.551, -0.05 },
		silo = { 0.373, 0.02 },
	},
	fillDarken = 0.65, -- (repo 0.65) şekil dolgusu = bölge rengi, parlaklık x bu
	borderDarken = 0.1, -- (repo 0.1) şekil kenarı = sınır rengi, parlaklık x bu (koyu çerçeve)
	borderWidth = 0.06, -- (repo 0.06) kenar kalınlığı (simge boyuna oran)
	buildingFill = Color3.fromRGB(198, 198, 198), -- (repo) inşaat sürerken dolgu
	buildingBorder = Color3.fromRGB(127, 127, 127), -- (repo) inşaat sürerken kenar
	levelText = 0.36, -- seviye rakamının boyu (simge boyuna oran; seviye 2+ gösterilir)
	-- yapı düğmesinin üstüne gelince (repo build-button highlight): o türler beyaz çizgiyle, diğerleri soluk
	highlightOutline = 0.04, -- (repo highlightOutlineWidth) beyaz bant kalınlığı (simge boyuna oran)
	highlightDim = 0.3, -- (repo highlightDimAlpha) diğer yapıların görünürlüğü
}

-- Kurma önizlemesi (bina / bomba seçiliyken imleçteki görüntü) — repo BuildPreviewController + StructurePass
Look.Ghost = {
	alpha = 0.5, -- (repo uGhostAlpha 0.5) imleçteki yapının görünürlüğü
	upgradeAlpha = 0.6, -- (repo) yükseltilecek yapının yeşil vurgusu
	snap = false, -- (repo "snapBuildPreview" ayarı, varsayılan kapalı) diğer yapılarda true: kurulacağı tile; liman her zaman kıyıya oturur
	costPx = 18, -- (repo ghostCost.screenScale 18) fiyat yazısı boyu (piksel)
	costOffset = 25, -- (repo ghostCost.screenYOffset 25) fiyatın imlecin kaç piksel altında olduğu
	costOk = Color3.fromRGB(255, 255, 255), -- (repo) kurulabilir
	costPoor = Color3.fromRGB(255, 77, 77), -- (repo 1, 0.3, 0.3) altın yetmiyor
	costBad = Color3.fromRGB(153, 153, 153), -- (repo 0.6) burada kurulamaz
	crosshairPx = 20, -- (repo CROSSHAIR_PX) savaş gemisi / MIRV artı imlecinin yarı boyu (piksel)
	crosshairOk = Color3.fromRGB(230, 38, 38), -- (repo 0.9, 0.15, 0.15)
	crosshairBad = Color3.fromRGB(102, 26, 26), -- (repo 0.4, 0.1, 0.1) konamaz
}

-- Gemiler: yuvarlak, sahibinin renginde, kenarlı. Boylar TILE biriminde (haritayla büyür/küçülür, repo UnitPass gibi);
-- min/max piksel sınırı uzakta görünür kalsın, yakında dev olmasın diye. Görsel: Assets.Units (boşsa düz daire).
Look.Ship = {
	trade = { tiles = 4.5, minPx = 6, maxPx = 40 }, -- ticaret gemisi (en küçük)
	transport = { tiles = 6, minPx = 8, maxPx = 52 }, -- asker taşıyan gemi
	warship = { tiles = 8, minPx = 10, maxPx = 68 }, -- savaş gemisi (en büyük)
	stroke = 1.5, -- strokeZoom'daki kenar kalınlığı (piksel)
	strokeZoom = 3,
	strokeMaxRatio = 0.12, -- simge küçüklüğünde de kenar içini kapatmasın
	strokeMine = Color3.fromRGB(255, 255, 255), -- benim gemilerimin kenarı
	strokeOther = Color3.fromRGB(20, 20, 20), -- diğerlerinin kenarı
	imageFill = 0.78, -- iç görselin daireye oranı
	shellTiles = 0.7, -- savaş gemisi mermisi (repo: 1 tile)
	shellMinPx = 2,
	shellMaxPx = 5,
}

-- Gönderdiğim nakliye gemisinin hedefindeki işaret (repo AttackRings: kırmızı, iç içe iki kesikli halka)
Look.BoatTarget = {
	sizeTiles = 10, -- harita birimi: zoom 3'te iç halka 30 px; zoomla birlikte büyür/küçülür
	color = Color3.fromRGB(255, 0, 0),
	innerSpeed = 1.2, -- (repo) iç halka dönüş hızı (radyan/sn, saat yönü)
	outerSpeed = 0.6, -- (repo) dış halka (ters yön)
}

-- Fabrika yolları (tren rayları) — repo RailroadPass
Look.Rail = {
	widthTiles = 1, -- (repo railThickness 1) yol genişliği TILE biriminde: ekranda widthTiles x zoom piksel, yani
	--               yakınlaşınca kalınlaşır, uzaklaşınca incelir. Hepsini inceltmek için 0.7 gibi bir değer ver.
	hideZoom = 1, -- (repo railMinZoom 3 - railFadeRange 2) zoom bu değer ve altındaysa yollar görünmez
	fullZoom = 3, -- (repo railMinZoom 3) bu zoomdan sonra tam görünür; arada yavaşça belirir
	detailZoom = 6, -- (repo railDetailZoom 6) bu zoomdan sonra "iki ray + ortada travers" deseni
	transparency = 0.2, -- (repo 0 = opak) saydamlık: 0 opak, 1 görünmez. İsteğin üzerine biraz saydam.
	mine = Color3.fromRGB(230, 230, 230), -- (repo focusedBorderColor #e6e6e6) benim yollarım; toprağım çok açıksa siyah
	unowned = Color3.fromRGB(191, 191, 191), -- (repo) sahipsiz toprak üstündeki yol. Başka ülkeler: o ülkenin sınır rengi.
}

-- Menzil daireleri (bina koyarken / yükseltirken / üstüne gelince) — repo RangeCirclePass
Look.Range = {
	fillTransparency = 0.8, -- (repo dolgu %20 beyaz)
	-- (repo: kenardaki 1 tile'lık halkada dolgu %20 + halka %50 = %70 görünür) halka burada dolgunun dışına çizildiği
	-- için tek başına %70: saydamlık 0.3
	strokeTransparency = 0.3,
	strokeTiles = 1, -- (repo) halka kalınlığı 1 tile
	strokeMinPx = 1.5,
	color = Color3.fromRGB(255, 255, 255),
	warnColor = Color3.fromRGB(255, 51, 51), -- (repo 1, 0.2, 0.2) bomba bir müttefikle ittifakı bozacaksa
	-- Kurma modunda tüm SAM menzilleri (repo SAMRadiusPass): silo, SAM, şehir, atom, hidrojen seçiliyken
	samDash = 12, -- (repo) kesik uzunluğu (tile)
	samGap = 6, -- (repo) kesik arası (tile)
	samWidth = 3, -- (repo strokeWidth 1.5 x 2) halka kalınlığı (tile)
	samTransparency = 0.2, -- (repo alpha 0.8)
	samSpeed = 14, -- (repo rotationSpeed) kesiklerin dönüş hızı (tile/sn)
	samSelf = Color3.fromRGB(0, 255, 0),
	samAlly = Color3.fromRGB(255, 255, 0),
	samEnemy = Color3.fromRGB(255, 0, 0),
}

-- Sınır ilişki tonu: repo varsayılanı (ittifak yeşil, ambargo/savaş kırmızı, %35).
-- Ülke sınırları önceden beyaza açılmaz. Yerel oyuncunun nötr sınırı #e6e6e6 kalır.
Look.Border = {
	tintRatio = 0.35, -- (repo embargoTintRatio / friendlyTintRatio) BENİM sınırımda kırmızı / yeşil karışımı
	warTint = Color3.fromRGB(255, 0, 0), -- (repo embargoTint 1,0,0)
	allyTint = Color3.fromRGB(0, 255, 0), -- (repo friendlyTint 0,1,0)
	otherLighten = 0,
	otherTintRatio = 0.35,
	-- (bize özgü) savaş / ambargo kırmızısının karpımı (benim ve diğerlerinin sınırında): %35'te pembe / kırmızı ülkelerde seçilmiyordu
	warTintRatio = 0.7,
}

-- Kamera: alttaki isim alanına tıklayınca / C tuşu ile kendi toprağına yumuşak geçiş
Look.Camera = {
	duration = 0.9, -- geçiş süresi (sn)
	fill = 0.55, -- toprağın ekranda kaplayacağı oran (büyük topraklarda uzaklaşır)
	minZoom = 1.5, -- geçişte en uzak
	maxZoom = 10, -- (repo spawn sonrası 8-10) geçişte en yakın
}

return table.freeze(Look)
]]></ProtectedString>
