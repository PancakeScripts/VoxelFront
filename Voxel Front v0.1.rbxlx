					<ProtectedString name="Source"><![CDATA[--!strict
-- Hub: normal (herkese açık) sunucuda online eşleştirme (Studio'da katılan, aynı sunucudaki yerel maça girer). Açık online maçları oyunculara gönderir, "join" isteyeni yeri olan
-- en yakın maça oturtup oraya ışınlar; yer yoksa sıraya alır. Her adımın sonu oyuncuya LobbyState ile bildirilir; başarısız
-- olan her durumda oyuncu menüde kalır (hiçbir yerde takılıp kalmaz). Kimin göreceğini OnlineConfig belirler (kapalı / izin
-- listesi / herkes; yayınlamadan değişir): oyuncunun "FrontlineOnline" özniteliği menüdeki satırı açar.
-- Ortak liste yalnız bu sunucuda Solo / Team Online penceresi açık ("watch") bir oyuncu varken okunur ve yalnız onlara
-- gönderilir: kimsenin bakmadığı sunucu listeyi okumaz, lobi oluşturmaz (çok sunuculu oyunda ortak listeye yük binmez).
-- İki tür maç var: "ffa" (Solo Online) ve "team" (Team Online, ayrı anahtarla açılır: "FrontlineTeams" özniteliği).
-- İstemci: LobbyJoin("watch" | "join", tür) / ("unwatch" | "cancel"); tür verilmezse "ffa".
-- Parti (Server.Party, en çok 8): yalnız lider katılır; partinin menüdeki üyeleri onunla aynı maça tek ışınlanmayla gider
-- (maçta oynayan / menüde olmayan üye gitmez). Maçtan dönen parti ışınlanma verisinden yeniden kurulur.
-- RoWorld src/server/ServerMain.luau'daki public_join akışından uyarlandı (AGPL-3.0, © 2026 Snick Co.).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Protocol = require(Shared:WaitForChild("Protocol"))
local Catalog = require(Shared:WaitForChild("Maps"):WaitForChild("Catalog"))
local Telemetry = require(Shared:WaitForChild("Telemetry"))
local Lobbies = script.Parent.Lobbies
local LobbyStore = require(Lobbies.LobbyStore)
local LobbyRules = require(Lobbies.LobbyRules)
local LobbyDirectory = require(Lobbies.LobbyDirectory)
local SharedClock = require(Lobbies.SharedClock)
local Teleports = require(Lobbies.Teleports)
local MatchServer = require(script.Parent.MatchServer)
local OnlineConfig = require(script.Parent.OnlineConfig)
local Party = require(script.Parent.Party)

local Hub = {}

--- Oyuncu özniteliği: Solo Online'ı görebilir mi (istemcideki satır bunu izler).
Hub.ACCESS = "FrontlineOnline"
--- Oyuncu özniteliği: Team Online'ı görebilir mi.
Hub.TEAMS_ACCESS = "FrontlineTeams"
Hub.CLOSED = "Online is closed right now."
Hub.LEADER_ONLY = "Only the party leader can join a match."
--- Aynı oyuncunun iki parti isteği arasında en az bu kadar olur.
Hub.PARTY_GAP_S = 0.25

--- Açık maç listesi oyunculara bu aralıkla gönderilir.
Hub.PUSH_S = 2
--- Aynı oyuncunun iki katılma isteği arasında en az bu kadar olur.
Hub.JOIN_COOLDOWN_S = 2
--- Koltuğu alınıp ışınlanması başlayan oyuncu bu süre içinde ikinci koltuk alamaz.
Hub.SENT_HOLD_S = 20
--- Aynı oyuncunun iki pencere aç/kapat bildirimi arasında en az bu kadar olur.
Hub.WATCH_GAP_S = 0.2

function Hub.start()
	local now = SharedClock.now
	SharedClock.start({ log = print })
	-- Studio: yerel depo (yayındaki oyunun MemoryStore'una yazmasın); yayında MemoryStore
	local store = if RunService:IsStudio() then LobbyStore.localstore(now) else LobbyStore.memory(game.JobId, now)
	-- Studio: ışınlanma yok; katılan bu sunucudaki yerel maça girer (MatchServer, aynı depo). Aynı anda tek yerel maç.
	local localServer: any = nil
	local moveRemote: RemoteEvent? = nil
	local backHome: ((Player) -> ())? = nil -- (menüye dönen hemen yeniden katılabilsin)
	local function studioSend(players: { Player }, _code: string, data: any, psid: string): (boolean, string?)
		if localServer ~= nil and localServer.done then
			localServer = nil
		end
		if localServer ~= nil and localServer.psid ~= psid then
			return false, "Another online match is running in Studio. Try again after it."
		end
		if localServer == nil then
			local srv: any = nil
			srv = MatchServer.start({
				store = store,
				psid = psid,
				now = now,
				ready = SharedClock.ready,
				cleanup = true,
				log = print,
				-- "normal sunucuya dön" = maçtan çıkıp bu sunucunun menüsüne
				to_hub = function(list: { Player }): (boolean, string?)
					for _, p in list do
						srv.leave(p)
						if backHome then
							backHome(p)
						end
						if moveRemote and p.Parent ~= nil then
							moveRemote:FireClient(p, "hub")
						end
					end
					return true, nil
				end,
			})
			localServer = srv
		end
		for _, p in players do
			localServer.arrive(p, data) -- (ışınlanma verisi: parti)
			if moveRemote then
				moveRemote:FireClient(p, "enter")
			end
		end
		return true, nil
	end
	local teleports = Teleports.for_place(game.PlaceId, studioSend)
	local directory = LobbyDirectory.new({
		store = store,
		teleport = teleports,
		maps = function(): { any }
			local out = {}
			for _, id in Catalog.order do
				table.insert(out, { id = id, name = Catalog[id].name, max = Catalog[id].onlineMax })
			end
			return out
		end,
		now = now,
		rand = math.random,
		new_id = function(): string
			return HttpService:GenerateGUID(false)
		end,
		log = print,
		-- (koltuk sayısı bir sunucunun alabildiğinden fazla olmaz: fazlası "GameFull" ışınlanma hatası verir; Studio'nunki gerçek değil)
		server_size = function(): number?
			return if RunService:IsStudio() then nil else Players.MaxPlayers
		end,
		-- takım lobileri yalnız Team Online kapalı değilken planlanır
		kinds = function(): { string }
			if OnlineConfig.mode ~= "off" and OnlineConfig.teamsMode ~= "off" then
				return { LobbyRules.MODE_FFA, LobbyRules.MODE_TEAM }
			end
			return { LobbyRules.MODE_FFA }
		end,
	})
	Hub.directory = directory

	-- remote'lar: klasör en son bağlanır (istemci klasörü görünce içindekiler hazırdır)
	local folder = Instance.new("Folder")
	folder.Name = Protocol.LobbyFolder
	local function remote(name: string): RemoteEvent
		local r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
		return r
	end
	local infoRemote = remote(Protocol.LobbyInfo)
	local joinRemote = remote(Protocol.LobbyJoin)
	local stateRemote = remote(Protocol.LobbyState)
	moveRemote = remote(Protocol.MatchMove)
	local partyRemote = remote(Protocol.Party)
	local partyStateRemote = remote(Protocol.PartyState)
	folder.Parent = ReplicatedStorage

	local lastAsk: { [Player]: number } = {}
	local joining: { [Player]: boolean } = {}
	--- ışınlanması başlayan oyuncular: koltukları hangi lobide (ışınlanma sonradan başarısız olursa geri verilir)
	local sent: { [Player]: { id: string, uid: string, at: number } } = {}
	backHome = function(p: Player)
		sent[p] = nil
	end
	local function key(p: Player): string
		return tostring(p.UserId)
	end
	-- kind: hangi türün maçı (istemci durumu o türün satırında gösterir; lider katılınca üyeler de bilsin)
	local function state(p: Player, s: string, msg: string?, kind: string?)
		if p.Parent ~= nil then
			stateRemote:FireClient(p, s, msg, kind)
		end
	end
	local function failed(p: Player, why: string?)
		local msg = why
		if why == "timeout" then
			msg = "Every online match is full right now. Try again in a moment, or play solo."
		elseif why == nil or why == "gone" then
			msg = nil
		end
		if msg ~= nil then
			Telemetry.count(p, "OnlineJoinFailed")
		end
		state(p, "failed", msg)
	end
	local function seated(p: Player, l: any)
		sent[p] = { id = l.id, uid = key(p), at = os.clock() }
		Telemetry.count(p, if LobbyRules.mode_of(l) == LobbyRules.MODE_TEAM then "OnlineJoinTeams" else "OnlineJoinSolo")
		state(p, "sent", l.map_name, LobbyRules.mode_of(l))
	end

	local function allowed(p: Player, kind: string?): boolean
		if kind == LobbyRules.MODE_TEAM then
			return OnlineConfig.allowedTeams(p.UserId)
		end
		return OnlineConfig.allowed(p.UserId)
	end
	local function kindOf(v: any): string
		return if v == LobbyRules.MODE_TEAM then LobbyRules.MODE_TEAM else LobbyRules.MODE_FFA
	end

	-- Partiler (RoWorld ServerMain public_group): lider katılınca partinin menüdeki üyeleri onunla gider.
	local party = Party.new({
		send = function(p: Player, st: any)
			if p.Parent ~= nil then
				partyStateRemote:FireClient(p, st)
			end
		end,
		now = os.clock,
		log = print,
		prefix = string.sub(game.JobId, 1, 8) .. ":", -- (anahtarlar sunucular arasında taşınır)
	})
	Hub.party = party
	local inMenu: { [Player]: boolean } = {} -- false: menüde değil (solo maçta); lider katılınca gitmez
	--- `p` ile gidecekler (lider: partinin menüdeki, meşgul olmayan üyeleri) ve ışınlanma verisindeki parti.
	local function group(p: Player): ({ Player }, any)
		local k = party:key_of(p)
		if k == nil then
			return { p }, nil
		end
		local list = {}
		for _, m in party:members(p) do
			local free = m == p
				or (m.Parent ~= nil and inMenu[m] ~= false and not joining[m] and sent[m] == nil and directory:queued(key(m)) == nil)
			if free then
				table.insert(list, m)
			end
		end
		if #list <= 1 then
			return { p }, nil
		end
		return list, { key = k, leader = p.UserId }
	end
	--- Sıradaki kayıt: partinin lideri adına (üyeler de sırada sayılır)
	local function queueKey(p: Player): string
		local leader = party:leader_of(p) or p
		return key(leader)
	end

	local function join(p: Player, kind: string)
		if joining[p] or directory:queued(queueKey(p)) ~= nil then
			return
		end
		if not allowed(p, kind) then
			failed(p, Hub.CLOSED)
			return
		end
		if not party:is_leader(p) then
			failed(p, Hub.LEADER_ONLY)
			return
		end
		local going = sent[p]
		if going ~= nil and os.clock() - going.at < Hub.SENT_HOLD_S then
			return -- koltuğu var, yolda
		end
		local players, partyData = group(p)
		for _, m in players do
			joining[m] = true
			state(m, "joining", nil, kind)
		end
		task.spawn(function()
			local ok, reason, l = directory:join(players, { mode = kind, party = partyData })
			for _, m in players do
				joining[m] = nil
			end
			if ok then
				for _, m in players do
					seated(m, l)
				end
			elseif reason == LobbyDirectory.NO_ROOM then
				-- bu türdeki tüm maçlar şu an dolu: ilk boş yer için sıraya (parti birlikte; sırası gelince kim gidebiliyorsa)
				local lastGroup = players
				directory:enqueue({
					key = key(p),
					since = now(),
					mode = kind,
					party = function(): any
						local _, d = group(p)
						return d
					end,
					members = function(): { any }?
						if p.Parent == nil or not party:is_leader(p) then
							return nil
						end
						lastGroup = group(p)
						return lastGroup
					end,
					done = function(ok2: boolean, why: string?, lb: any, went: { any }?)
						for _, m in went or lastGroup do
							if ok2 then
								seated(m, lb)
							else
								failed(m, why)
							end
						end
					end,
				})
				for _, m in players do
					Telemetry.count(m, "OnlineQueued")
					state(m, "line", nil, kind)
				end
			else
				for _, m in players do
					failed(m, reason)
				end
			end
		end)
	end
	local function cancel(p: Player)
		if not party:is_leader(p) then
			return
		end
		local q = directory:queued(key(p))
		if q ~= nil and directory:dequeue(key(p)) then
			local list = q.members() or { p }
			for _, m in list do
				state(m, "failed", nil)
			end
		end
	end

	-- parti istekleri
	local partyAt: { [Player]: number } = {}
	partyRemote.OnServerEvent:Connect(function(p: Player, what: any, arg: any)
		if what == "menu" then
			inMenu[p] = arg == true -- (yalnız bir bayrak: sınırsız)
			return
		end
		local t = os.clock()
		if t - (partyAt[p] or -math.huge) < Hub.PARTY_GAP_S then
			return
		end
		partyAt[p] = t
		local target = if type(arg) == "number" then Players:GetPlayerByUserId(arg) else nil
		if what == "invite" and target ~= nil then
			local ok, why = party:invite(p, target)
			if not ok and why then
				partyStateRemote:FireClient(p, party:state(p), why)
			end
		elseif what == "accept" and type(arg) == "number" then
			local ok, why = party:accept(p, arg)
			if not ok and why then
				partyStateRemote:FireClient(p, party:state(p), why)
			end
		elseif what == "decline" and type(arg) == "number" then
			party:decline(p, arg)
		elseif what == "leave" then
			party:leave(p)
		elseif what == "kick" and type(arg) == "number" then
			party:kick(p, arg)
		elseif what == "sync" then
			partyStateRemote:FireClient(p, party:state(p))
		end
	end)
	--- Gelen oyuncu: maçtan partisiyle döndüyse parti yeniden kurulur; Roblox partisiyle geldiyse onlarla parti olur.
	local function partyOnArrive(p: Player)
		local ok, jd = pcall(function()
			return p:GetJoinData()
		end)
		local td = if ok and type(jd) == "table" and jd.SourcePlaceId == game.PlaceId then jd.TeleportData else nil
		local back = if type(td) == "table" and type(td.party) == "table" then td.party[tostring(p.UserId)] else nil
		if type(back) == "table" and type(back.key) == "string" then
			party:arrived(p, back.key, tonumber(back.leader))
			return
		end
		local okId, pid = pcall(function()
			return (p :: any).PartyId
		end)
		if okId and type(pid) == "string" and pid ~= "" then
			local others = {}
			for _, o in Players:GetPlayers() do
				local okO, oid = pcall(function()
					return (o :: any).PartyId
				end)
				if o ~= p and okO and oid == pid then
					table.insert(others, o)
				end
			end
			if #others > 0 then
				party:join_roblox_party(p, others)
			end
		end
	end

	-- Solo / Team Online penceresi açık olanlar ve hangi türe baktıkları (liste yalnız onlar varken okunur ve onlara gönderilir)
	local watching: { [Player]: string } = {}
	local watchAt: { [Player]: number } = {}
	local serving = false -- bu sunucuda pencereyi açık izinli oyuncu var
	local push = 0

	joinRemote.OnServerEvent:Connect(function(p: Player, what: any, which: any)
		local t = os.clock()
		local kind = kindOf(which)
		if what == "watch" or what == "unwatch" then
			if t - (watchAt[p] or -math.huge) < Hub.WATCH_GAP_S then
				return
			end
			watchAt[p] = t
			if what == "watch" and allowed(p, kind) then
				if not serving then
					directory._refresh_in = 0 -- (ilk bakan: liste hemen okunur)
				end
				watching[p] = kind
				serving = true
				push = Hub.PUSH_S -- (bir sonraki karede gönderilir)
			else
				watching[p] = nil
			end
			return
		end
		if t - (lastAsk[p] or -math.huge) < Hub.JOIN_COOLDOWN_S then
			return
		end
		lastAsk[p] = t
		if what == "join" then
			join(p, kind)
		elseif what == "cancel" then
			-- (lider sıradan çıkarır; üye kendi isteğiyle partiden ayrılır)
			cancel(p)
		end
	end)
	-- erişim: oyuncu özniteliği; kapatılınca sıradakiler çıkarılır (süren maçlar biter, yenisi açılmaz)
	local function refreshAccess()
		for _, p in Players:GetPlayers() do
			p:SetAttribute(Hub.ACCESS, allowed(p))
			p:SetAttribute(Hub.TEAMS_ACCESS, allowed(p, LobbyRules.MODE_TEAM))
			local w = watching[p]
			if w ~= nil and not allowed(p, w) then
				watching[p] = nil
			end
			local q = directory:queued(key(p))
			if q ~= nil and not allowed(p, q.mode) and directory:dequeue(key(p)) then
				failed(p, Hub.CLOSED)
			end
		end
	end
	Players.PlayerAdded:Connect(function(p: Player)
		p:SetAttribute(Hub.ACCESS, allowed(p))
		p:SetAttribute(Hub.TEAMS_ACCESS, allowed(p, LobbyRules.MODE_TEAM))
		partyOnArrive(p)
	end)
	for _, p in Players:GetPlayers() do
		partyOnArrive(p)
	end
	refreshAccess()
	OnlineConfig.start(refreshAccess)

	Players.PlayerRemoving:Connect(function(p: Player)
		directory:dequeue(key(p))
		party:removed(p)
		inMenu[p] = nil
		partyAt[p] = nil
		if localServer ~= nil then
			localServer.leave(p)
		end
		watching[p] = nil
		watchAt[p] = nil
		lastAsk[p] = nil
		joining[p] = nil
		sent[p] = nil
	end)
	-- başladıktan sonra başarısız olan ışınlanma: koltuk geri verilir, oyuncu menüde kalır
	if not RunService:IsStudio() then
		TeleportService.TeleportInitFailed:Connect(function(p: Player, result: any, msg: any)
			if result == Enum.TeleportResult.IsTeleporting then
				return -- (zaten yolda: ikinci istek reddedildi, ilki sürüyor)
			end
			local s = sent[p]
			sent[p] = nil
			if s == nil or os.clock() - s.at > 60 then
				return
			end
			task.spawn(function()
				directory:release(s.id, { s.uid })
			end)
			warn(string.format("[Lobbies] teleport to %s failed for %s: %s %s", s.id, p.Name, tostring(result), tostring(msg)))
			Telemetry.count(p, "TeleportFailed")
			state(p, "failed", "Couldn't reach that match. Try again.") -- (OnlineJoinFailed sayılmaz: TeleportFailed sayıldı)
		end)
	end

	RunService.Heartbeat:Connect(function(dt: number)
		-- (lobi planlaması ortak saatin ilk ölçümünü bekler, bir saniye kadar)
		if not SharedClock.ready() then
			return
		end
		if serving or directory:queue_size() > 0 then
			directory:tick(dt, task.spawn)
			directory:tick_queue(dt, task.spawn)
		end
		push += dt
		if push >= Hub.PUSH_S then
			push = 0
			local views: { [string]: any } = {}
			serving = false
			for p, kind in watching do
				if p.Parent ~= nil and allowed(p, kind) then
					serving = true
					views[kind] = views[kind] or directory:view(kind)
					infoRemote:FireClient(p, views[kind], kind)
				end
			end
		end
	end)
	print("[Lobbies] hub started (" .. (if RunService:IsStudio() then "Studio, local store" else "MemoryStore") .. ")")
end

return Hub
]]></ProtectedString>
					<string name="ScriptGuid">{E38C7A53-5A0B-4F40-8CC0-F80F7F8A2E5E}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Hub</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c14f2467dd4fbf50afa546d0000f410</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX173B3194FC2E433394DD04E3F30BBAE7">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- MatchServer: online maçın sunucusu. Ayrılmış sunucuda (Studio'da aynı sunucuda yerel maç olarak) tek bir maç oynatır: lobi
-- kaydını bulur (MatchHost), haritayı kurar (Shared.Match, gerçek remote'larla), gelenleri bekleme odasında toplar, başlama
-- zamanına Config.ONLINE_SPAWN_SECONDS kala (lobi dolarsa hemen) herkesi tura sokar: toprak seçimi tam o kadar sürer, bu sırada
-- gelenler de seçebilir; lobi oyun gerçekten başlayınca listelerden düşer. Tur bitince herkesi normal bir sunucuya gönderir. Bir şey takılırsa
-- (kayıt bulunamaz, maç kurulamaz, maç çok uzar, herkes ayrılır, sunucu kapanır) oyuncular yine normal sunucuya döner.
-- Boş koltuklara ayrıca bot eklenmez: harita solo ile aynı bot ve uluslarla oynanır.
--
--   MatchServer.reserved()      ayrılmış sunucunun girişi (Server script çağırır)
--   MatchServer.start(deps)     -> server { arrive(p, data?), leave(p), players(), shutdown(), psid, done }
--   (data: ışınlanma verisi; yoksa oyuncunun GetJoinData'sından okunur. data.party = { key, leader }: aynı partidekiler
--   takım maçında aynı takıma konur, maç sonunda parti bilgisiyle birlikte hub'a döner.)
--   deps = { store, psid, now, to_hub(players) -> (ok, err?), ready() -> boolean?, cleanup: boolean?, log(text)? }
--   (cleanup: maç bitince klasörleri siler; Studio'da aynı sunucuda sonraki yerel maç için)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Protocol = require(Shared:WaitForChild("Protocol"))
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Maps"):WaitForChild("Catalog"))
local Telemetry = require(Shared:WaitForChild("Telemetry"))
local Lobbies = script.Parent.Lobbies
local MatchHost = require(Lobbies.MatchHost)
local LobbyRules = require(Lobbies.LobbyRules)
local LobbyStore = require(Lobbies.LobbyStore)
local SharedClock = require(Lobbies.SharedClock)
local Teleports = require(Lobbies.Teleports)
local Net = require(script.Parent.Net)
local Wallet = require(script.Parent.Wallet)

local MatchServer = {}

--- Lobi kaydı bu kadar sürede bulunamazsa herkes geri döner.
MatchServer.LOOKUP_GIVE_UP_S = 60
--- Tur bitince sonuç ekranı bu kadar görünür, sonra herkes normal sunucuya.
MatchServer.END_HOLD_S = 20
--- Başlama zamanından bu kadar sonra hâlâ kimse gelmediyse maç kapanır.
MatchServer.EMPTY_GIVE_UP_S = 60
--- Maç başladıktan bu kadar sonra bitmediyse (takıldı) herkes geri döner.
MatchServer.MAX_MATCH_S = Config.SPAWN_PHASE_SECONDS + Config.ONLINE_ROUND_MAX_SECONDS + Config.ROUND_END_SECONDS + 300
--- Kapanışta geri dönüşün bitmesi en çok bu kadar beklenir.
MatchServer.SHUTDOWN_WAIT_S = 10
--- Işınlamadan önce oyuncunun Medals kaydının yazılması en çok bu kadar beklenir (Server.Wallet.settle).
MatchServer.SETTLE_S = 10

function MatchServer.start(deps: { [string]: any })
	local server: { [string]: any } = { psid = deps.psid, done = false }
	local log = deps.log or function(_text: string) end
	local host = MatchHost.new({ store = deps.store, psid = deps.psid, now = deps.now, to_hub = deps.to_hub, log = deps.log })
	server.host = host
	local here: { Player } = {}
	local partyOf: { [Player]: { key: string, leader: number? } } = {}
	local match: any = nil
	-- "lookup" -> "loading" -> "lobby" -> "playing" -> "ended" -> "closing"
	local phase = "lookup"
	local born = os.clock()
	local startedAt, endedAt, emptySince = 0, 0, nil :: number?
	-- Medals (Server.Wallet): oyuncunun sonucu kesinleşince (elendi ya da tur bitti) ya da maç sürerken ayrılınca bir kez
	local medalMode = "online"
	local medalsPaid: { [Player]: boolean } = {}
	local function payMedals(p: Player, left: boolean)
		if medalsPaid[p] or match == nil or match.medals == nil then
			return
		end
		local pid = match.pidOf(p)
		if pid == nil or (not left and not match.medals:final(pid)) then
			return
		end
		local r = match.medals:result(pid, left)
		if not r.spawned then
			return
		end
		medalsPaid[p] = true
		task.spawn(Wallet.pay, p, r, medalMode, nil, match.medals:card(pid))
	end

	-- bekleme odası bilgisi (öznitelikler istemcilere kendiliğinden gider)
	local folder = Instance.new("Folder")
	folder.Name = Protocol.MatchFolder
	folder:SetAttribute("StartsIn", -1)
	folder:SetAttribute("Phase", "lobby")
	folder:SetAttribute("Players", 0)
	folder:SetAttribute("Teams", 0) -- (takım maçı: takım sayısı)
	local leaveRemote = Instance.new("RemoteEvent")
	leaveRemote.Name = Protocol.MatchLeave
	leaveRemote.Parent = folder
	folder.Parent = ReplicatedStorage

	local function counted()
		local uids, names = {}, {}
		for _, p in here do
			table.insert(uids, tostring(p.UserId))
			table.insert(names, p.DisplayName)
		end
		host:set_present(#here)
		host:set_roster(uids)
		folder:SetAttribute("Players", #here)
		folder:SetAttribute("Names", table.concat(names, ", ")) -- (bekleme odasında gelenlerin adları, geliş sırasıyla)
	end

	--- Hub'a dönüş verisi: kim hangi partideydi (hub partiyi yeniden kurar; aynı ışınlanmadakiler aynı sunucuya gider).
	local function backData(list: { Player }): any
		local map: { [string]: any } = {}
		local any = false
		for _, p in list do
			local g = partyOf[p]
			if g then
				map[tostring(p.UserId)] = { key = g.key, leader = g.leader }
				any = true
			end
		end
		return if any then { party = map } else nil
	end

	local function sendBack(list: { Player })
		if #list == 0 then
			return
		end
		task.spawn(function()
			local ok, err = host:return_to_hub(list, backData(list))
			if not ok then
				log("[MatchServer] return failed: " .. tostring(err))
			end
		end)
	end

	local heartbeat: RBXScriptConnection? = nil
	local function close(why: string)
		if phase == "closing" then
			return
		end
		phase = "closing"
		log("[MatchServer] closing: " .. why)
		folder:SetAttribute("Phase", "ended")
		folder:SetAttribute("StartsIn", -1)
		task.spawn(function()
			-- (Medals'ı henüz ödenmemiş olanın sonucu ödenir: tur bittiyse tam, maç yarıda kapanıyorsa o ana kadarki;
			-- herkesin kaydı yazıldıktan sonra ışınlanır)
			for _, p in here do
				payMedals(p, true)
			end
			local deadline = os.clock() + MatchServer.SETTLE_S
			for _, p in table.clone(here) do
				Wallet.settle(p.UserId, math.max(0, deadline - os.clock()))
			end
			host:finish()
			local ok, err = host:return_to_hub(table.clone(here), backData(here))
			if not ok then
				log("[MatchServer] return failed: " .. tostring(err))
			end
			if heartbeat then
				heartbeat:Disconnect()
			end
			if match then
				match.stop()
			end
			if deps.cleanup then
				folder:Destroy()
				local net = ReplicatedStorage:FindFirstChild(Protocol.Folder)
				if net then
					net:Destroy()
				end
			end
			server.done = true
		end)
	end

	function server.arrive(p: Player, data: any?)
		if table.find(here, p) then
			return
		end
		-- parti: ışınlanma verisinden (Studio'da doğrudan verilir)
		local td = data
		if td == nil then
			local ok, jd = pcall(function()
				return p:GetJoinData()
			end)
			td = if ok and type(jd) == "table" then jd.TeleportData else nil
		end
		local pt = if type(td) == "table" then td.party else nil
		if type(pt) == "table" and type(pt.key) == "string" and #pt.key <= 64 then
			partyOf[p] = { key = pt.key, leader = tonumber(pt.leader) }
		end
		if phase == "ended" or phase == "closing" then
			sendBack({ p })
			return
		end
		table.insert(here, p)
		counted()
		if match then
			match.join(p, if partyOf[p] then partyOf[p].key else nil)
			if phase == "playing" then
				match.play(p) -- (başlangıç fazındaysa oynar, değilse izler)
			end
		end
	end

	function server.leave(p: Player)
		local i = table.find(here, p)
		if not i then
			return
		end
		table.remove(here, i)
		counted()
		if match then
			if phase == "playing" or phase == "ended" then
				payMedals(p, true) -- (maç sürerken ayrıldı: o ana kadarki sonucu; kesinleşmişse zaten ödendi)
			end
			match.leave(p)
		end
		if p.Parent == nil then
			partyOf[p] = nil
		end
	end

	function server.players(): { Player }
		return table.clone(here)
	end

	function server.phase(): string
		return phase
	end

	--- Kurulmuş maç (yük testi için; yoksa nil).
	function server.match(): any
		return match
	end

	--- Sunucu kapanıyor: herkes normal sunucuya (bekler).
	function server.shutdown()
		close("server closing")
		local t = os.clock()
		while not server.done and os.clock() - t < MatchServer.SHUTDOWN_WAIT_S do
			task.wait(0.25)
		end
	end

	-- Take Over (public maç): elenen oyuncu onu düşüren ulusu devralır. Hakı (Robux: takeover_online) sunucu harcar; hedef o
	-- arada düşerse hak geri verilir. Devralan için yeni bir hayat başlar (Medals yeniden ödenir).
	local takeRemote = Instance.new("RemoteFunction")
	takeRemote.Name = "TakeOver"
	takeRemote.Parent = folder
	local taking: { [Player]: boolean } = {}
	takeRemote.OnServerInvoke = function(p: Player): (boolean, string?)
		if taking[p] or match == nil or phase ~= "playing" or not table.find(here, p) then
			return false, "not now"
		end
		if match.takeoverTarget(p) == nil then
			return false, "no target"
		end
		taking[p] = true
		local ok = Wallet.useCredit(p, "takeover_online")
		local done = false
		if ok then
			done = match.takeover(p)
			if not done then
				task.spawn(Wallet.refundCredit, p, "takeover_online")
			end
		end
		taking[p] = nil
		if done then
			medalsPaid[p] = nil
		end
		return done, if done then nil elseif ok then "gone" else "no credit"
	end
	local leaving: { [Player]: boolean } = {}
	leaveRemote.OnServerEvent:Connect(function(p: Player)
		if table.find(here, p) and not leaving[p] then
			leaving[p] = true
			task.spawn(function()
				-- erken çıkış: önce o ana kadarki Medals yazılır (kesinleşmişse zaten ödenmiştir), sonra ışınlanır
				if phase == "playing" or phase == "ended" then
					payMedals(p, true)
				end
				Wallet.settle(p.UserId, MatchServer.SETTLE_S)
				leaving[p] = nil
				if p.Parent ~= nil then
					sendBack({ p })
				end
			end)
		end
	end)

	local function build()
		local l = host.lobby
		local mapId = if Catalog[l.map] then l.map else "world"
		local teams = if LobbyRules.mode_of(l) == LobbyRules.MODE_TEAM then (l.teams or 2) else nil
		medalMode = if teams then "teams" else "online"
		local ok, m = pcall(function()
			return require(Shared:WaitForChild("Match")).start(function()
				return Net.create(Protocol)
			end, true, mapId, Config.ONLINE_SPAWN_SECONDS, teams)
		end)
		if phase == "closing" then
			if ok then
				m.stop()
			end
			return
		end
		if not ok then
			close("match failed: " .. tostring(m))
			return
		end
		match = m
		for _, p in here do
			match.join(p, if partyOf[p] then partyOf[p].key else nil)
		end
		folder:SetAttribute("Map", mapId)
		folder:SetAttribute("MapName", Catalog[mapId].name)
		folder:SetAttribute("Max", l.max)
		folder:SetAttribute("Teams", teams or 0)
		phase = "lobby"
	end

	local marked = false -- lobi "started" yapıldı mı (toprak seçimi bitince; o zamana dek katılım sürer)
	local function begin()
		phase = "playing"
		startedAt = os.clock()
		Telemetry.count(nil, if LobbyRules.mode_of(host.lobby) == LobbyRules.MODE_TEAM then "MatchStartedTeams" else "MatchStarted", #here)
		-- Public Match Humans (RoWorld): maç başına bir kez; değer: başlayan insan sayısı; alanlar: aralık, koltuk, mod
		if here[1] then
			local n = #here
			local band = if n <= 1 then "1" elseif n <= 4 then "2-4" elseif n <= 9 then "5-9" elseif n <= 19 then "10-19" elseif n <= 29 then "20-29" elseif n <= 39 then "30-39" elseif n <= 49 then "40-49" else "50+"
			Telemetry.event(here[1], "Public Match Humans", n, { band, tostring(host.lobby.max) .. " slots", if medalMode == "teams" then "Teams" else "Solo" })
		end
		for _, p in here do
			match.play(p)
		end
		match.setRunning(true)
	end

	local info = 0
	heartbeat = RunService.Heartbeat:Connect(function(dt: number)
		if deps.ready and not deps.ready() then
			return -- (ortak saat ölçülene kadar)
		end
		host:tick(dt, task.spawn)
		local t = os.clock()
		if #here == 0 then
			emptySince = emptySince or t
		else
			emptySince = nil
		end
		if phase == "lookup" then
			if host.lobby ~= nil then
				phase = "loading"
				task.spawn(build)
			elseif t - born > MatchServer.LOOKUP_GIVE_UP_S then
				close("lobby record not found")
			end
		elseif phase == "lobby" then
			local left = host:starts_in() or 0
			local full = #here >= host.lobby.max
			if #here > 0 and (left <= Config.ONLINE_SPAWN_SECONDS or full) then
				begin()
			elseif #here == 0 and deps.now() > host.lobby.starts + MatchServer.EMPTY_GIVE_UP_S then
				close("nobody came")
			end
		elseif phase == "playing" then
			if not marked and match.phase() ~= "spawn" then
				marked = true
				local humans = #here
				task.spawn(function()
					host:start(humans)
				end)
			end
			if match.phase() == "ended" then
				phase = "ended"
				endedAt = t
			elseif t - startedAt > MatchServer.MAX_MATCH_S then
				close("match ran too long")
			elseif emptySince ~= nil and t - emptySince > 30 then
				close("everyone left")
			end
		elseif phase == "ended" then
			if t - endedAt >= MatchServer.END_HOLD_S or #here == 0 then
				close("match over")
			end
		end
		info += dt
		if info >= 0.5 and phase ~= "closing" then
			info = 0
			if phase == "playing" or phase == "ended" then
				for _, p in here do
					payMedals(p, false)
				end
			end
			if match and match.setCosmetics then
				for _, p in here do
					match.setCosmetics(p, Wallet.equipped(p)) -- (kayıt geç okunursa da gelir)
				end
			end
			if phase == "lobby" or phase == "loading" or phase == "lookup" then
				-- (bekleme odası: toprak seçiminin başlamasına kalan süre)
				local left = host:starts_in()
				folder:SetAttribute("StartsIn", if left then math.max(0, math.ceil(left - Config.ONLINE_SPAWN_SECONDS)) else -1)
				folder:SetAttribute("Phase", "lobby")
			else
				folder:SetAttribute("StartsIn", 0)
				folder:SetAttribute("Phase", match.phase())
			end
		end
	end)
	return server
end

--- Ayrılmış (maç) sunucusunun girişi.
function MatchServer.reserved()
	SharedClock.start({ log = print })
	local now = SharedClock.now
	local teleports = Teleports.for_place(game.PlaceId)
	local server = MatchServer.start({
		store = LobbyStore.memory(game.JobId, now),
		psid = game.PrivateServerId,
		now = now,
		to_hub = teleports.to_hub,
		ready = SharedClock.ready,
		log = print,
	})
	for _, p in Players:GetPlayers() do
		server.arrive(p)
	end
	Players.PlayerAdded:Connect(server.arrive)
	Players.PlayerRemoving:Connect(server.leave)
	game:BindToClose(function()
		server.shutdown()
	end)
	print("[MatchServer] match server started")
end

return MatchServer
]]></ProtectedString>
					<string name="ScriptGuid">{A9E156D1-F3AE-420F-956B-6E039FE4C09A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MatchServer</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c14f2467dd4fbf50afa546d000102b6</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0A478B942C004403B229CBA6BFD21ACE">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Party: normal (hub) sunucudaki partiler: public maçlara birlikte giren oyuncular. Lider maça katılınca partinin menüdeki
-- herkesi tek ışınlanmayla onunla gider; takım maçında parti aynı takıma konur (Core/Teams).
-- RoWorld src/server/Party.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.).
--
-- Parti tek sunucuda yaşar, üyeleri aynı hub'dadır:
--   * davet bu sunucudaki herkese gider (listede arkadaşlar önce); başka sunucudaki arkadaşa Roblox oyun daveti gider
--     (SocialService:PromptGameInvite, istemcide) ve buraya gelir;
--   * aynı Roblox partisiyle (Player.PartyId) gelenler burada tek parti yapılır;
--   * maçtan sonra maç sunucusu herkesi kimin hangi partide olduğuyla birlikte tek ışınlanmada bir hub'a gönderir
--     (`arrived`), parti orada yeniden kurulur.
--
--   Party.new(deps)   deps = { send(player, state), now() -> saniye, log(text)?, prefix: string? (bu sunucunun; parti
--                     anahtarları sunucular arasında taşınır) }
--   party:invite(from, target) / accept(target, from_uid) / decline(target, from_uid) / leave(p)
--   party:kick(leader, uid) / removed(p) / members(p) / is_leader(p) / leader_of(p) / key_of(p)
--   party:join_roblox_party(p, others_in_it) / arrived(p, key, leader_uid)
--   party:state(p) -> istemcinin gördüğü (PartyState)

local Party = {}
Party.__index = Party

--- Bir partide en çok bu kadar oyuncu.
Party.MAX_SIZE = 8
--- Davet bu kadar cevap bekler.
Party.INVITE_TTL_S = 60
--- Aynı kişiye ikinci davet en erken bu kadar sonra.
Party.INVITE_GAP_S = 3

type Group = { key: string, leader: any, members: { any } }

function Party.new(deps: { [string]: any })
	local self = setmetatable({}, Party)
	self.deps = deps
	self.groups = {} :: { [string]: Group }
	self.of = {} :: { [any]: string }
	--- hedef -> { [davet eden] = gönderildiği an }
	self.invites = {} :: { [any]: { [any]: number } }
	self._seq = 0
	return self
end

local function uid(p: any): number
	return tonumber(p.UserId) or 0
end

local function name_of(p: any): string
	local d = p.DisplayName
	return if type(d) == "string" and d ~= "" then d else tostring(p.Name)
end

function Party._log(self: any, text: string)
	if self.deps.log then
		self.deps.log("[Party] " .. text)
	end
end

function Party._new_key(self: any, leader: any): string
	self._seq += 1
	return ("%s%d:%d"):format(self.deps.prefix or "", uid(leader), self._seq)
end

--- `p`'nin parti anahtarı ya da nil.
function Party.key_of(self: any, p: any): string?
	return self.of[p]
end

--- `p`'nin partisindeki herkes (önce lider) ya da yalnız { p }.
function Party.members(self: any, p: any): { any }
	local g = self.groups[self.of[p] or ""]
	if g == nil then
		return { p }
	end
	return table.clone(g.members)
end

function Party.is_leader(self: any, p: any): boolean
	local g = self.groups[self.of[p] or ""]
	return g == nil or g.leader == p
end

--- Partinin lideri (partide değilse nil).
function Party.leader_of(self: any, p: any): any?
	local g = self.groups[self.of[p] or ""]
	return if g ~= nil then g.leader else nil
end

--- Her üyeye (ve onlardan daveti olana) partinin şimdiki halini söyler.
function Party._push(self: any, players: { any })
	local seen = {}
	for _, p in players do
		if not seen[p] then
			seen[p] = true
			self.deps.send(p, self:state(p))
		end
	end
end

function Party._push_group(self: any, key: string?)
	local g = self.groups[key or ""]
	if g ~= nil then
		self:_push(g.members)
	end
end

--- `p`'nin gördüğü: { members = { {uid, name, leader} }, leader (ben miyim), invites = { {uid, name} }, max }.
function Party.state(self: any, p: any): { [string]: any }
	local members = {}
	local g = self.groups[self.of[p] or ""]
	if g ~= nil and #g.members > 1 then
		for _, m in g.members do
			table.insert(members, { uid = uid(m), name = name_of(m), leader = m == g.leader })
		end
	end
	local invites = {}
	local now = self.deps.now()
	for from, at in self.invites[p] or {} do
		if now - at <= Party.INVITE_TTL_S and from.Parent ~= nil then
			table.insert(invites, { uid = uid(from), name = name_of(from) })
		end
	end
	table.sort(invites, function(a, b)
		return a.uid < b.uid
	end)
	return {
		members = members,
		leader = g == nil or g.leader == p,
		invites = invites,
		max = Party.MAX_SIZE,
	}
end

--- `from`, `target`'ı (bu sunucuda) davet eder. Döner: ok, neden.
function Party.invite(self: any, from: any, target: any): (boolean, string?)
	if target == nil or target == from then
		return false, "Pick someone to invite."
	end
	local key = self.of[from]
	if key ~= nil and self.of[target] == key then
		return false, name_of(target) .. " is already in your party."
	end
	local g = self.groups[key or ""]
	if g ~= nil and #g.members >= Party.MAX_SIZE then
		return false, ("A party holds %d players."):format(Party.MAX_SIZE)
	end
	local now = self.deps.now()
	local box = self.invites[target]
	if box == nil then
		box = {}
		self.invites[target] = box
	end
	if box[from] ~= nil and now - box[from] < Party.INVITE_GAP_S then
		return false, nil
	end
	box[from] = now
	self:_push({ target })
	self:_log(("%s invited %s"):format(name_of(from), name_of(target)))
	return true, nil
end

--- `target`, `from_uid`'in davetini kabul eder: artık `from`'un partisindedir (`from`'un partisi yoksa kurulur);
--- `target` önceki partisinden çıkar.
function Party.accept(self: any, target: any, from_uid: number): (boolean, string?)
	local box = self.invites[target]
	local from = nil
	for p, at in box or {} do
		if uid(p) == from_uid and self.deps.now() - at <= Party.INVITE_TTL_S then
			from = p
		end
	end
	if from == nil or from.Parent == nil then
		return false, "That invite has expired."
	end
	box[from] = nil
	local key = self.of[from]
	local g = self.groups[key or ""]
	if g ~= nil and #g.members >= Party.MAX_SIZE then
		self:_push({ target })
		return false, "That party is full."
	end
	if self.of[target] ~= nil then
		self:leave(target)
	end
	if g == nil then
		key = self:_new_key(from)
		g = { key = key :: string, leader = from, members = { from } }
		self.groups[key :: string] = g
		self.of[from] = key
	end
	table.insert(g.members, target)
	self.of[target] = key
	-- artık aynı partidekiler arasındaki davetler (ör. ikisi aynı anda birbirini davet etti) düşer
	for _, m in g.members do
		if self.invites[m] then
			for _, o in g.members do
				self.invites[m][o] = nil
			end
		end
	end
	self:_push_group(key)
	self:_log(("%s joined %s's party (%d)"):format(name_of(target), name_of(g.leader), #g.members))
	return true, nil
end

function Party.decline(self: any, target: any, from_uid: number)
	local box = self.invites[target]
	for p in box or {} do
		if uid(p) == from_uid then
			box[p] = nil
		end
	end
	self:_push({ target })
end

--- `p` partisinden çıkar (lider çıkınca sıradaki üye lider olur; tek kalan parti sayılmaz).
function Party.leave(self: any, p: any)
	local key = self.of[p]
	local g = self.groups[key or ""]
	self.of[p] = nil
	if g == nil then
		self:_push({ p })
		return
	end
	local i = table.find(g.members, p)
	if i ~= nil then
		table.remove(g.members, i)
	end
	if g.leader == p then
		g.leader = g.members[1]
	end
	if #g.members <= 1 then
		for _, m in g.members do
			self.of[m] = nil
		end
		self.groups[g.key] = nil
		self:_push(g.members)
	else
		self:_push_group(key)
	end
	if p.Parent ~= nil then
		self:_push({ p })
	end
end

--- Lider bir üyeyi çıkarır.
function Party.kick(self: any, leader: any, member_uid: number)
	local g = self.groups[self.of[leader] or ""]
	if g == nil or g.leader ~= leader then
		return
	end
	for _, m in g.members do
		if m ~= leader and uid(m) == member_uid then
			self:leave(m)
			return
		end
	end
end

--- `p` sunucudan çıktı.
function Party.removed(self: any, p: any)
	self:leave(p)
	self.invites[p] = nil
	for target, box in self.invites do
		if box[p] ~= nil then
			box[p] = nil
			if target.Parent ~= nil then
				self:_push({ target })
			end
		end
	end
end

--- Bu sunucudaki aynı Roblox partisinin oyuncuları (Player.PartyId): tek parti, ilk gelen lider.
function Party.join_roblox_party(self: any, p: any, others: { any })
	if self.of[p] ~= nil then
		return
	end
	for _, o in others do
		if o ~= p and self.of[o] ~= nil then
			local g = self.groups[self.of[o]]
			if g ~= nil and #g.members < Party.MAX_SIZE then
				table.insert(g.members, p)
				self.of[p] = g.key
				self:_push_group(g.key)
			end
			return
		end
	end
	for _, o in others do
		if o ~= p and o.Parent ~= nil and self.of[o] == nil then
			local key = self:_new_key(o)
			self.groups[key] = { key = key, leader = o, members = { o, p } }
			self.of[o] = key
			self.of[p] = key
			self:_push_group(key)
			return
		end
	end
end

--- `p` maçtan `key` partisiyle döndü (maç sunucusunun geri dönüş ışınlanması): parti buradakilerle yeniden kurulur;
--- `leader_uid` buradaysa lider odur.
function Party.arrived(self: any, p: any, key: string, leader_uid: number?)
	if self.of[p] ~= nil or type(key) ~= "string" or key == "" then
		return
	end
	local g = self.groups[key]
	if g == nil then
		g = { key = key, leader = p, members = {} }
		self.groups[key] = g
	end
	if #g.members >= Party.MAX_SIZE then
		return
	end
	table.insert(g.members, p)
	self.of[p] = key
	if leader_uid ~= nil and uid(p) == leader_uid then
		g.leader = p
	end
	self:_push_group(key)
end

return Party
]]></ProtectedString>
