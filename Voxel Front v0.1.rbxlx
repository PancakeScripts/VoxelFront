			<Item class="ModuleScript" referent="RBX51234B80847D4A66A00D1FA765462DF2">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- DsGate: bu sunucunun DataStore'larının önünde bir kapı. RoWorld src/server/DsGate.luau'dan alındı (AGPL-3.0, © 2026 Snick Co.).
-- Roblox bir sunucuya dakikada 60 + 40 x oyuncu okuma ve bir o kadar yazma verir (UpdateAsync ikisinden birer); ötesinde 30
-- isteği sıraya alır, kalanı düşürür ("...Throttled ... the request queue was full"). Bir maçın sonunda herkesin Medals'ı
-- birden ödenir; bir oyuncunun sık isteği de bütçeyi yiyebilir.
-- Kapıdan geçen istek bütçede yer olana dek bekler (en çok MAX_WAIT_S, sonra yine gider), bir türden aynı anda en çok
-- MAX_IN_FLIGHT istek çalışır, Roblox'un sınır yüzünden düşürdüğü istek RETRY_S sonra yeniden gönderilir (düşürülen
-- istek hiçbir şey yapmamıştır: her istek için güvenli).
--
--   DsGate.wrap(store) -> store   aynı GetAsync / SetAsync / UpdateAsync / RemoveAsync, kapıdan geçerek
--   DsGate.throttled(err) -> bool Roblox isteği sınırları yüzünden reddetti (hiçbir şey yapmadı)

local DataStoreService = game:GetService("DataStoreService")

local DsGate = {}

DsGate.MAX_WAIT_S = 15
DsGate.MAX_IN_FLIGHT = 8
--- Sınıra takılan isteğin her yeni denemesinden önceki bekleme.
DsGate.RETRY_S = { 2, 5, 10 }
DsGate.POLL_S = 0.25

local TYPES = {
	read = Enum.DataStoreRequestType.StandardRead,
	write = Enum.DataStoreRequestType.StandardWrite,
}

local function budget(kind: string): number?
	local ok, n = pcall(DataStoreService.GetRequestBudgetForRequestType, DataStoreService, (TYPES :: any)[kind])
	return if ok and type(n) == "number" then n else nil
end

function DsGate.throttled(err: any): boolean
	local s = tostring(err)
	return string.find(s, "Throttled", 1, true) ~= nil
		or string.find(s, "TooManyRequests", 1, true) ~= nil
		or string.find(s, "queue was full", 1, true) ~= nil
		or string.find(s, "request dropped", 1, true) ~= nil
end

local KINDS: { [string]: { string } } = {
	GetAsync = { "read" },
	SetAsync = { "write" },
	UpdateAsync = { "read", "write" },
	RemoveAsync = { "write" },
}

-- (bir sunucudaki bütün kapılar aynı bütçeyi paylaşır: aynı sayacı da paylaşırlar)
local inFlight: { [string]: number } = { read = 0, write = 0 }
DsGate.stats = { waited = 0, retried = 0 }

local function room(kinds: { string }): boolean
	for _, k in kinds do
		if inFlight[k] >= DsGate.MAX_IN_FLIGHT then
			return false
		end
		local n = budget(k)
		if n ~= nil and n < 1 then
			return false
		end
	end
	return true
end

local function enter(kinds: { string })
	local t0 = os.clock()
	local waited = false
	while not room(kinds) and os.clock() - t0 < DsGate.MAX_WAIT_S do
		waited = true
		task.wait(DsGate.POLL_S)
	end
	if waited then
		DsGate.stats.waited += 1
	end
	for _, k in kinds do
		inFlight[k] += 1
	end
end

local function leave(kinds: { string })
	for _, k in kinds do
		inFlight[k] -= 1
	end
end

function DsGate.wrap(store: any): any
	local function through(method: string, ...: any): ...any
		local kinds = KINDS[method]
		local attempt = 1
		while true do
			enter(kinds)
			local res = table.pack(pcall(store[method], store, ...))
			leave(kinds)
			if res[1] then
				return table.unpack(res, 2, res.n)
			end
			local err = res[2]
			local pause = DsGate.RETRY_S[attempt]
			if pause == nil or not DsGate.throttled(err) then
				error(err, 0)
			end
			DsGate.stats.retried += 1
			attempt += 1
			task.wait(pause)
		end
	end
	return setmetatable({}, {
		__index = function(_, method: string): any
			if KINDS[method] ~= nil then
				return function(_self: any, ...: any): ...any
					return through(method, ...)
				end
			end
			local v = store[method]
			if type(v) == "function" then
				return function(_self: any, ...: any): ...any
					return v(store, ...)
				end
			end
			return v
		end,
	})
end

return DsGate
]]></ProtectedString>
