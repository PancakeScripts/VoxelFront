						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Warship: savaş gemisi (OpenFront WarshipExecution + ShellExecution kuralları, bu sürümdeki kısmı).
--   * Tıklanan su noktasına devriye; gemi, o denizdeki en yakın hazır limanında doğar. Maliyet min(1M, (n+1) x 250K). Can 1000.
--   * Devriye: devriye noktasının 100 tile çevresinde rastgele su noktalarına, tick başına 1 tile.
--   * Hedef (130 tile içinde, öncelik: nakliye > savaş gemisi > ticaret gemisi, sonra yakınlık):
--       - nakliye / savaş gemisi: mermi atar (savaş gemisine 20 tickte bir, nakliyeye bekleme yok); mermi 3 tile/tick uçar.
--         hasar = 250 x (200 + 25 (zar-1)) / 250, zar 1..6, veteranlıkla +%20/seviye. Nakliye gemisi tek mermiyle batar (askeri gider).
--       - ticaret gemisi: tick başına 2 tile kovalar, 5 tile yaklaşınca ele geçirir (kıyıya yakın 20 tick korunur).
--   * Can %75'in altına düşerse en yakın limana çekilir; limanda bekleyen gemiler seviye x 5 canı paylaşır; liman seviyesi kadar gemi.
--     Limana 150 tile içindeyken tick başına +1 can. Dolunca devriyeye döner.
--   * Veteranlık: savaş gemisi batırmak anında +1 seviye; nakliye imhası 25, ticaret ele geçirme 10 puan (seviye = 250 puan).
--     Seviye başına can +%20, hasar +%20 (en çok 3).

local Warship = {}
Warship.__index = Warship

export type Warship = typeof(setmetatable(
	{} :: {
		kind: string,
		id: number,
		pid: number,
		tile: number,
		patrol: number,
		health: number,
		vet: number,
		vetProgress: number,
		state: string,
		port: any,
		target: any,
		path: { number },
		pathDst: number,
		pathIdx: number,
		pathTick: number,
		lastShot: number,
		lastManual: number,
		shells: { any },
		shelled: { [any]: boolean },
		done: boolean,
	},
	Warship
))

local nextId = 100000

function Warship.new(pid: number, tile: any): Warship
	nextId += 1
	return setmetatable({
		kind = "warship",
		id = nextId,
		pid = pid,
		tile = tile,
		patrol = tile,
		health = 0,
		vet = 0,
		vetProgress = 0,
		state = "patrolling",
		port = nil,
		target = nil,
		path = {},
		pathDst = -1,
		pathIdx = 1,
		pathTick = 0,
		lastShot = -1000,
		lastManual = -1000,
		shells = {},
		shelled = {},
		done = false,
	}, Warship)
end

local function validTile(size: number, tile: any): boolean
	return type(tile) == "number" and tile == tile and tile >= 0 and tile < size and tile % 1 == 0
end

local function dist2(w: number, a: number, b: number): number
	local dx, dy = a % w - b % w, a // w - b // w
	return dx * dx + dy * dy
end

local function manhattan(w: number, a: number, b: number): number
	return math.abs(a % w - b % w) + math.abs(a // w - b // w)
end

function Warship.position(self: Warship): number
	return self.tile
end

function Warship.maxHealth(self: Warship, cfg: any): number
	return cfg.WARSHIP_HEALTH + math.floor(cfg.WARSHIP_HEALTH * self.vet * cfg.WARSHIP_VET_HEALTH_PCT / 100)
end

function Warship.finish(self: Warship, sim: any)
	if self.done then
		return
	end
	self.done = true
	sim.warshipCount[self.pid] = math.max(0, (sim.warshipCount[self.pid] or 1) - 1)
end

-- Hasar al; can biterse batar. Öldüren gemiye (varsa) deneyim verir.
function Warship.damage(self: Warship, sim: any, dmg: number, killer: any?)
	self.health -= dmg
	if self.health <= 0 and not self.done then
		-- repo FxSpritePass: batan savaş gemisinde patlama + batma efekti
		sim:pushFx({ k = "sunk", tile = self.tile, pid = self.pid, u = 3 })
		self:finish(sim)
		if killer then
			sim:emit(self.pid, "warshipLost", killer.pid)
			sim:emit(killer.pid, "warshipKill", self.pid) -- ("You sank a warship from X")
		end
		if killer and not killer.done then
			killer.vetProgress = 0
			killer:levelUp(sim.cfg)
		end
	end
end

function Warship.levelUp(self: Warship, cfg: any)
	if self.vet < cfg.WARSHIP_VET_MAX then
		self.vet += 1
	end
end

local function addProgress(self: Warship, cfg: any, points: number)
	if self.vet >= cfg.WARSHIP_VET_MAX then
		return
	end
	self.vetProgress += points
	local perLevel = cfg.WARSHIP_VET_TRANSPORT_KILLS * cfg.WARSHIP_VET_TRADE_CAPTURES
	while self.vetProgress >= perLevel and self.vet < cfg.WARSHIP_VET_MAX do
		self.vetProgress -= perLevel
		self.vet += 1
	end
end

-- Başlatma ----------------------------------------------------------------------

function Warship.init(self: Warship, sim: any)
	self.done = true
	local world, cfg, pid = sim.world, sim.cfg, self.pid
	if not validTile(world.size, self.tile) or not world:isWater(self.tile) then
		sim:emit(pid, "badTile")
		return
	end
	if sim.phase ~= "run" then
		sim:emit(pid, "notStarted")
		return
	end
	if not sim.spawned[pid] then
		sim:emit(pid, "notSpawned")
		return
	end
	local comp = world:waterComponent(self.tile)
	local w = world.width
	local nb: { number } = {}
	local bestPort, bestD = nil, math.huge
	local bestSpawn: number? = nil
	for _, st in sim.structList do
		if st.pid == pid and st.type == "port" and st.ready then
			local d = manhattan(w, st.tile, self.tile)
			if d < bestD then
				local n = world:neighbors(st.tile, nb)
				for k = 1, n do
					if world:waterComponent(nb[k]) == comp then
						bestPort, bestD, bestSpawn = st, d, nb[k]
						break
					end
				end
			end
		end
	end
	if not bestPort then
		sim:emit(pid, "noPort")
		return
	end
	local cost = math.min(cfg.WARSHIP_COST_MAX, ((sim.warshipCount[pid] or 0) + 1) * cfg.WARSHIP_COST_STEP)
	if sim.gold[pid] < cost then
		sim:emit(pid, "noGold")
		return
	end
	sim.gold[pid] -= cost
	sim.warshipCount[pid] = (sim.warshipCount[pid] or 0) + 1
	self.tile = bestSpawn :: number
	self.health = cfg.WARSHIP_HEALTH
	self.done = false
end

-- Hareket -----------------------------------------------------------------------

-- dst'ye (su ya da kıyı tile'ı) bir adım. Yol önbelleklenir; hedef değişince ya da tıkanınca yeniden aranır.
local function stepToward(self: Warship, sim: any, dst: number, repath: boolean?): boolean
	local world = sim.world
	if self.pathDst ~= dst or self.pathIdx > #self.path or repath then
		local route = sim.parts.Naval.waterRoute(world, self.tile, dst, sim.cfg.WARSHIP_ROUTE_MAX_NODES)
		self.pathTick = sim.tickNo
		if not route then
			self.path = {}
			self.pathDst = -1
			return false
		end
		self.path = route
		self.pathDst = dst
		self.pathIdx = 2 -- 1. eleman bulunduğumuz yer
	end
	local nextTile = self.path[self.pathIdx]
	if nextTile == nil then
		return false
	end
	self.pathIdx += 1
	self.tile = nextTile
	return true
end

local function randomPatrolTarget(self: Warship, sim: any): number?
	local world, cfg = sim.world, sim.cfg
	local w, h = world.width, world.height
	local px, py = self.patrol % w, self.patrol // w
	local R = cfg.WARSHIP_PATROL_RANGE
	local comp = world:waterComponent(self.tile)
	for _ = 1, 40 do
		local x = px + sim.rng:int(-R, R)
		local y = py + sim.rng:int(-R, R)
		if x >= 0 and x < w and y >= 0 and y < h and (x - px) ^ 2 + (y - py) ^ 2 <= R * R then
			local t = y * w + x
			if world:isWater(t) and world:waterComponent(t) == comp and t ~= self.tile then
				return t
			end
		end
	end
	return nil
end

local function patrolStep(self: Warship, sim: any)
	if self.pathDst < 0 or self.pathIdx > #self.path then
		local t = randomPatrolTarget(self, sim)
		if not t then
			return
		end
		if not stepToward(self, sim, t) then
			self.pathDst = -1
		end
		return
	end
	stepToward(self, sim, self.pathDst)
end

-- Hedef seçimi -------------------------------------------------------------------

local function isWaterShore(world: any, t: number, nb: { number }): boolean
	local n = world:neighbors(t, nb)
	for k = 1, n do
		if world:isLand(nb[k]) then
			return true
		end
	end
	return false
end
Warship.isWaterShore = isWaterShore

local function hasReachablePort(self: Warship, sim: any): boolean
	local world = sim.world
	local comp = world:waterComponent(self.tile)
	local nb: { number } = {}
	for _, st in sim.structList do
		if st.pid == self.pid and st.type == "port" and st.ready then
			local n = world:neighbors(st.tile, nb)
			for k = 1, n do
				if world:waterComponent(nb[k]) == comp then
					return true
				end
			end
		end
	end
	return false
end

-- types: nakliye ve savaş gemileri her zaman; ticaret gemisi includeTrade ise.
local function findTarget(self: Warship, sim: any, includeTrade: boolean): any?
	local cfg, w = sim.cfg, sim.world.width
	local range2 = cfg.WARSHIP_TARGET_RANGE ^ 2
	local patrolR2 = cfg.WARSHIP_PATROL_RANGE ^ 2
	local reachable: boolean? = nil
	local best, bestPri, bestD = nil, 99, math.huge
	for k = 1, sim.executionCount do
		local e = sim.executions[k]
		if e and e ~= self and not e.done and e.pid ~= self.pid and not sim.parts.Diplomacy.isAllied(sim, self.pid, e.pid) then
			local kind = e.kind
			if kind == "boat" or kind == "warship" or (includeTrade and kind == "trade") then
				local pos = e:position()
				local d = dist2(w, self.tile, pos)
				if d <= range2 and not self.shelled[e] and not (kind == "warship" and e.state == "docked") then
					local ok = true
					if kind == "trade" then
						if reachable == nil then
							reachable = hasReachablePort(self, sim)
						end
						if
							not reachable
							or sim.tickNo - e.lastSafe < cfg.SAFE_FROM_PIRATES_TICKS
							or e.dst.pid == self.pid
							or sim.parts.Diplomacy.isAllied(sim, self.pid, e.dst.pid)
							or dist2(w, self.patrol, pos) > patrolR2
						then
							ok = false
						end
					end
					if ok then
						local pri = if kind == "boat" then 0 elseif kind == "warship" then 1 else 2
						if pri < bestPri or (pri == bestPri and d < bestD) then
							best, bestPri, bestD = e, pri, d
						end
					end
				end
			end
		end
	end
	return best
end

-- Ateş ---------------------------------------------------------------------------

local function shoot(self: Warship, sim: any)
	local cfg = sim.cfg
	local target = self.target
	if not target then
		return
	end
	if sim.tickNo - self.lastShot <= cfg.WARSHIP_SHELL_RATE then
		return
	end
	if target.kind ~= "boat" then
		self.lastShot = sim.tickNo
	end
	local d = math.sqrt(dist2(sim.world.width, self.tile, target:position()))
	local flight = math.max(1, math.ceil(d / cfg.SHELL_SPEED))
	table.insert(self.shells, { target = target, due = sim.tickNo + flight })
	-- mermi görünür (repo Shell birimi): istemci bu sürede çıkıştan hedefe küçük bir piksel uçurur
	sim:pushFx({ k = "shell", from = self.tile, to = target:position(), n = flight, pid = self.pid })
	if target.kind == "boat" then
		-- Tek mermiyle batan hedefe ikinci mermi gönderme.
		self.shelled[target] = true
		self.target = nil
	end
end

local function shellDamage(self: Warship, sim: any): number
	local cfg = sim.cfg
	local roll = sim.rng:int(1, 6)
	local mult = (roll - 1) * 25 + 200
	if self.vet > 0 then
		mult = math.floor(mult * (100 + self.vet * cfg.WARSHIP_VET_DAMAGE_PCT) / 100)
	end
	return math.floor(cfg.SHELL_DAMAGE / 250 * mult + 0.5)
end

local function resolveShells(self: Warship, sim: any)
	local i = 1
	while i <= #self.shells do
		local s = self.shells[i]
		local t = s.target
		if t.done or t.pid == self.pid then
			table.remove(self.shells, i)
		elseif sim.tickNo >= s.due then
			table.remove(self.shells, i)
			if t.kind == "boat" then
				local lostAt = t:position()
				t:finish(sim) -- asker gemiyle batar
				sim:emit(t.pid, "transportLost", self.pid)
				sim.parts.Nation.shipLost(sim, t.pid, lostAt, self.pid, "transport")
				addProgress(self, sim.cfg, sim.cfg.WARSHIP_VET_TRADE_CAPTURES)
			elseif t.kind == "warship" then
				t:damage(sim, shellDamage(self, sim), self)
			end
		else
			i += 1
		end
	end
end

-- Limanda iyileşme ---------------------------------------------------------------

local function dockedAt(sim: any, port: any, except: any?): number
	local n = 0
	for k = 1, sim.executionCount do
		local e = sim.executions[k]
		if e and e.kind == "warship" and e ~= except and not e.done and e.state == "docked" and e.port == port then
			n += 1
		end
	end
	return n
end

local function nearestPort(self: Warship, sim: any): any?
	local world = sim.world
	local comp = world:waterComponent(self.tile)
	local nb: { number } = {}
	local best, bestD = nil, math.huge
	for _, st in sim.structList do
		if st.pid == self.pid and st.type == "port" and st.ready and dockedAt(sim, st, self) < st.level then
			local d = dist2(world.width, self.tile, st.tile)
			if d < bestD then
				local n = world:neighbors(st.tile, nb)
				for k = 1, n do
					if world:waterComponent(nb[k]) == comp then
						best, bestD = st, d
						break
					end
				end
			end
		end
	end
	return best
end

local function passiveHeal(self: Warship, sim: any)
	local cfg, w = sim.cfg, sim.world.width
	local r2 = cfg.WARSHIP_HEAL_RANGE ^ 2
	for _, st in sim.structList do
		if st.pid == self.pid and st.type == "port" and dist2(w, self.tile, st.tile) <= r2 then
			self.health = math.min(self:maxHealth(cfg), self.health + cfg.WARSHIP_HEAL_PASSIVE)
			break
		end
	end
	if self.state == "docked" and self.port then
		local pool = self.port.level * cfg.WARSHIP_HEAL_PER_PORT_LEVEL
		local n = dockedAt(sim, self.port) + 1
		self.health = math.min(self:maxHealth(cfg), self.health + pool / n)
	end
end

local function cancelRetreat(self: Warship)
	self.state = "patrolling"
	self.port = nil
	self.pathDst = -1
end

-- Tick ---------------------------------------------------------------------------

function Warship.tick(self: Warship, sim: any)
	if self.done then
		return
	end
	local cfg = sim.cfg
	if not sim.alive[self.pid] then
		self:finish(sim)
		return
	end
	if self.health <= 0 then
		self:finish(sim)
		return
	end
	resolveShells(self, sim)
	local before = self.health
	passiveHeal(self, sim)
	local maxH = self:maxHealth(cfg)

	if self.state == "docked" then
		if not self.port or sim.structByTile[self.port.tile] ~= self.port or self.health >= maxH then
			cancelRetreat(self)
		else
			return
		end
	end

	if self.state == "retreating" then
		-- Geri çekilirken de ateş et (nakliye / savaş gemisi)
		local aggro = findTarget(self, sim, false)
		if aggro then
			self.target = aggro
			shoot(self, sim)
		end
		local port = self.port
		if not port or sim.structByTile[port.tile] ~= port then
			port = nearestPort(self, sim)
			self.port = port
			if not port then
				cancelRetreat(self)
				return
			end
		end
		local d2 = dist2(sim.world.width, self.tile, port.tile)
		if d2 <= cfg.WARSHIP_DOCK_RANGE ^ 2 then
			if dockedAt(sim, port, self) < port.level then
				self.state = "docked"
				self.path = {}
				self.pathDst = -1
				return
			elseif self.health >= maxH then
				cancelRetreat(self)
				return
			end
			return
		end
		if not stepToward(self, sim, port.tile) then
			cancelRetreat(self)
		end
		return
	end

	-- Devriye: can eşiğin altındaysa çekil
	if sim.tickNo - self.lastManual >= cfg.WARSHIP_MANUAL_RETREAT_OFF then
		local threshold = math.floor(maxH * cfg.WARSHIP_RETREAT_PERCENT / 100)
		if before < threshold then
			local port = nearestPort(self, sim)
			if port then
				self.state = "retreating"
				self.port = port
				self.target = nil
				self.pathDst = -1
				return
			end
		end
	end

	local target = findTarget(self, sim, true)
	self.target = target
	if target and (target.kind == "boat" or target.kind == "warship") then
		shoot(self, sim)
		patrolStep(self, sim)
		return
	end
	if target and target.kind == "trade" then
		-- kovala: tick başına 2 adım; 5 tile yakınında ele geçir
		for _ = 1, 2 do
			local tpos = target:position()
			local d = manhattan(sim.world.width, self.tile, tpos)
			if d <= cfg.WARSHIP_CAPTURE_DIST then
				if target:capture(sim, self) then
					addProgress(self, cfg, cfg.WARSHIP_VET_TRANSPORT_KILLS)
				end
				self.target = nil
				return
			end
			local moved = false
			if d <= 20 then
				local world = sim.world
				local nb: { number } = {}
				local n = world:neighbors(self.tile, nb)
				local bestT, bestD = nil, d
				for k = 1, n do
					local u = nb[k]
					if world:isWater(u) then
						local dd = manhattan(world.width, u, tpos)
						if dd < bestD then
							bestT, bestD = u, dd
						end
					end
				end
				if bestT then
					self.tile = bestT
					moved = true
				end
			end
			if not moved then
				local repath = self.pathDst ~= tpos and sim.tickNo - self.pathTick >= 10
				if not stepToward(self, sim, tpos, repath) then
					break
				end
			end
		end
		return
	end
	patrolStep(self, sim)
end

return Warship
]]></ProtectedString>
