hoverStroke.Thickness = 2
hoverStroke.Parent = hover

local view = Viewport.new(mapW, mapH, frame.AbsoluteSize.X, frame.AbsoluteSize.Y, {
	zoomOutSlack = Config.VIEW_ZOOM_OUT_SLACK,
	panOvershoot = Config.VIEW_PAN_OVERSHOOT,
})
local alignment = Alignment.new(frame)

-- Oyun durumu (sunucudan) ------------------------------------------------------

local phase = "spawn"
local secondsLeft = 0
local stats: { [number]: { pid: number, name: string, troops: number, max: number, out: number, tiles: number, gold: number, c: number?, fs: number?, bb: { number }?, bot: boolean?, nation: boolean?, rate: number? } } = {}
local structs: { { tile: number, type: string, pid: number, level: number, ready: boolean, q: number?, p: number?, d: number?, bar: string?, rg: number? } } = {}
local structsAt = 0 -- yapı listesi ne zaman geldi (çubuklar aradaki zamanı tahmin edip akıcı dolar)
local buildMode: string? = nil
local resetInteraction: () -> () = function() buildMode = nil end
local ratio = Config.ATTACK_DEFAULT_RATIO
local names: { [number]: string } = {}
local lastSeq = 0
local dead = false
local round = 0
local myMode = "menu" -- "menu" (oynamıyor) | "waiting" (sonraki turu bekliyor) | "playing" (bu turda)
local settings = { names = true, attackNumbers = true, alerts = true, icons = true }
local endShownRound = -1 -- tur sonu kartı bu tur için gösterildi mi
local winnerName: string? = nil
local teamCount = 0 -- takım maçı: takım sayısı (0 = herkes kendi için); oyuncuların takımı PlayerColors.teamOf
local winnerTeam = 0
local stateReady = false
local resyncing = false
local pending: { buffer } = {}

local lastOwner = 0
local diploTarget = 0 -- diplomasi panelinde gösterilen oyuncu (düğmeler buna uygulanır)
local infoTarget = 0 -- bilgi paneli açık olan oyuncu (0 = kapalı)
local lastRate = 0 -- önceki saniyelik asker artışı (renk: artıyor yeşil / azalıyor turuncu)
local rateRising = true
local mouseX: number? = nil -- GUI koordinatı
local mouseY: number? = nil
local needsMouseAlign = UserInputService.MouseEnabled

-- Sayılar repo renderNumber kuralıyla (Format.number): 1.23K, 12.3K, 123K, 1.23M ...
local function fmtTroops(n: number): string
	return Format.number(n)
end

local function fmtGold(n: number): string
	return Format.number(n)
end

local BUILD_META: { [string]: { label: string, short: string, color: Color3 } } = {
	city = { label = "City", short = "Ci", color = Color3.fromRGB(96, 165, 250) },
	factory = { label = "Factory", short = "Fa", color = Color3.fromRGB(251, 146, 60) },
	port = { label = "Port", short = "Po", color = Color3.fromRGB(45, 212, 191) },
	post = { label = "Castle", short = "Ca", color = Color3.fromRGB(74, 222, 128) },
	silo = { label = "Silo", short = "Si", color = Color3.fromRGB(167, 139, 250) },
	sam = { label = "SAM", short = "SA", color = Color3.fromRGB(248, 113, 113) },
	warship = { label = "Warship", short = "Ws", color = Color3.fromRGB(56, 189, 248) },
	atom = { label = "Atom bomb", short = "At", color = Color3.fromRGB(250, 204, 21) },
	hydro = { label = "Hydrogen bomb", short = "Hy", color = Color3.fromRGB(244, 114, 182) },
	mirv = { label = "MIRV", short = "MV", color = Color3.fromRGB(239, 68, 68) },
}
local mapLand = 0
for i = 0, buffer.len(terrain) - 1 do
	if buffer.readu8(terrain, i) ~= 0 then
		mapLand += 1
	end
end
local warshipsMine = 0
local mirvCost = Config.MIRV_COST_BASE -- sunucudan güncellenir (her fırlatmada artar)
local dip: { allies: { any }, reqs: { any }, traitors: { any }, embargo: { any } } = { allies = {}, reqs = {}, traitors = {}, embargo = {} }
local seenReq: { [number]: boolean } = {}

-- Sonraki fiyat: sunucunun saniyede bir yolladığı kesin değer (repo unitInfo.cost: sahip olunan seviyeler ve kurulanlar);
-- gelmediyse yaklaşık yerel hesap.
local myCosts: { [string]: number }? = nil
local function nextCost(what: string): number
	local known = if myCosts then myCosts[what] else nil
	if known then
		return known
	end
	local n = 0
	for _, st in structs do
		if st.pid == myPid and st.type == what then
			n += 1
		end
	end
	if what == "city" then
		return math.min(Config.CITY_COST_MAX, 2 ^ n * Config.CITY_COST_BASE)
	end
	if what == "port" then
		local shared = 0
		for _, st in structs do
			if st.pid == myPid and (st.type == "port" or st.type == "factory") then
				shared += 1
			end
		end
		return math.min(Config.PORT_COST_MAX, 2 ^ shared * Config.PORT_COST_BASE)
	end
	if what == "factory" then
		local shared = 0
		for _, st in structs do
			if st.pid == myPid and (st.type == "port" or st.type == "factory") then
				shared += 1
			end
		end
		return math.min(Config.FACTORY_COST_MAX, 2 ^ shared * Config.FACTORY_COST_BASE)
	end
	if what == "warship" then
		return math.min(Config.WARSHIP_COST_MAX, (warshipsMine + 1) * Config.WARSHIP_COST_STEP)
	end
	if what == "silo" then
		return Config.SILO_COST
	end
	if what == "sam" then
		return math.min(Config.SAM_COST_MAX, (n + 1) * Config.SAM_COST_STEP)
	end
	return math.min(Config.POST_COST_MAX, (n + 1) * Config.POST_COST_STEP)
end

-- Kendi silolarında boş (hazır) füze yuvası sayısı.
local function readySlots(): number
	local n = 0
	for _, st in structs do
		if st.pid == myPid and st.type == "silo" and st.ready then
			n += st.level - (st.q or 0)
		end
	end
	return n
end

-- Benimle bir oyuncu arasındaki ilişki (ittifak, istek, ambargo, hain, ittifakın kalan süresi).
-- Takım arkadaşı (teammate) da allied sayılır (saldırılamaz) ama ittifak değildir: bozulmaz, yenilenmez, ambargo konmaz.
type Rel = { allied: boolean, teammate: boolean, reqFrom: boolean, reqTo: boolean, embargoed: boolean, theyEmbargo: boolean, traitor: boolean, allyLeft: number? }
local function relationWith(target: number): Rel
	local rel: Rel = { allied = false, teammate = false, reqFrom = false, reqTo = false, embargoed = false, theyEmbargo = false, traitor = false, allyLeft = nil }
	local myTeam = PlayerColors.teamOf(myPid)
	if teamCount > 0 and target ~= myPid and myTeam ~= 0 and PlayerColors.teamOf(target) == myTeam then
		rel.teammate = true
		rel.allied = true
	end
	for _, al in dip.allies do
		if (al.a == target and al.b == myPid) or (al.b == target and al.a == myPid) then
			rel.allied = true
			rel.allyLeft = al.left
		end
	end
	for _, r in dip.reqs do
		if r.from == target and r.to == myPid then
			rel.reqFrom = true
		elseif r.from == myPid and r.to == target then
			rel.reqTo = true
		end
	end
	for _, e in dip.embargo do
		if e.from == myPid and e.to == target then
			rel.embargoed = true
		elseif e.from == target and e.to == myPid then
			rel.theyEmbargo = true
		end
	end
	for _, t in dip.traitors do
		if t.pid == target then
			rel.traitor = true
		end
	end
	return rel
end

local TERRAIN_EN = { [0] = "Water", [1] = "Plains", [2] = "Highlands", [3] = "Mountains" }
local atWar: { [number]: boolean } = {} -- benimle aramızda sürmekte olan saldırı var
local function kindEn(pid: number): string
	local k = PlayerColors.kindOf(pid)
	return if k == 2 then "Bot" elseif k == 1 then "Nation" else "Player"
end

local function kindName(pid: number): string
	local k = PlayerColors.kindOf(pid)
	return if k == 2 then "Bot" elseif k == 1 then "Nation" else "Player"
end

local cardTile: number? = nil -- mobil hedef kartı: dokunulan kara tile'ı (kart açıkken)
-- mobil kurma: dokunulan yerin dünya konumu (sabit imleç gibi; harita kaydırılınca önizleme oraya bağlı kalır)
local touchPick: { what: string, sx: number, sy: number }? = nil
local hoverBuild: string? = nil -- fare şu an hangi yapı düğmesinin üstünde (repo build-button highlight)

-- Fare arayüz üstünde mi (koordinat uzayından bağımsız): bu karede fare hareket ettiği halde harita çerçevesi
-- MouseMoved almadıysa fare onu örten bir arayüzün (alt bar, panel, menü, Roblox üst çubuğu) üstündedir.
local overUiByMove = false
local uisMovedThisFrame = false
local frameMovedThisFrame = false
-- aşağıda (kurma kuralları) atanır; o zamana kadar (açılışta) hiçbir düğme seçilemez
local canSelect: (id: string) -> boolean = function(_id: string): boolean
	return false
end

local function updateInfo()
	hover.Visible = false
	-- fare bir arayüzün (alt bar, panel, menü) üstündeyse haritadaki imleç karesi ve oyuncu kartı gösterilmez
	local overHud = overUiByMove
		or radial:isOpen()
		or (mouseX ~= nil and mouseY ~= nil and hud:overPanel(frame.AbsolutePosition.X + (mouseX :: number), frame.AbsolutePosition.Y + (mouseY :: number)))
	if mouseX and mouseY and not overHud then
		local tx, ty = view:screenToTile(mouseX, mouseY)
		if tx and ty then
			local size = math.max(view.zoom, 3)
			hover.Position = UDim2.fromOffset(view.x + tx * view.zoom, view.y + ty * view.zoom)
			hover.Size = UDim2.fromOffset(size, size)
			hover.Visible = true
		end
	end
	local mine = stats[myPid]
	-- alt panel: asker çubuğu, altın, saldırı gücü, yapı düğmeleri
	if mine and not dead then
		hud:setMine({
			troops = fmtTroops(mine.troops),
			max = fmtTroops(mine.max),
			fill = mine.troops / math.max(mine.max, 1),
			out = fmtTroops(mine.out),
			outCount = mine.out,
			gold = fmtGold(mine.gold),
			ratio = ratio,
			ratioTroops = fmtTroops(math.floor(mine.troops * ratio)),
			rate = "+" .. fmtTroops(mine.rate or 0) .. "/s",
			rising = rateRising,
			goldRate = "+" .. fmtGold(Config.GOLD_PER_TICK * Config.TICK_RATE) .. "/s",
		})
		local r0, g0, b0 = PlayerColors.rgb(myPid)
		hud:setPlayer(Players.LocalPlayer.DisplayName, Color3.fromRGB(r0, g0, b0), string.format("%.1f%%", mine.tiles / math.max(mapLand, 1) * 100))
	else
		hud:setMine(nil)
	end
	local counts: { [string]: number } = {}
	for _, st in structs do
		if st.pid == myPid then
			counts[st.type] = (counts[st.type] or 0) + st.level
		end
	end
	local gold = if mine then mine.gold else 0
	local items = {}
	for i, id in Hud.buildOrder do
		local meta = BUILD_META[id]
		local cost = if id == "atom" then Config.NUKE_COST_ATOM elseif id == "hydro" then Config.NUKE_COST_HYDRO elseif id == "mirv" then mirvCost else nextCost(id)
		-- adet: yapılarda seviye toplamı (repo totalUnitLevels), savaş gemisinde gemi sayısı; bombalarda gösterilmez
		local count = if id == "warship" then warshipsMine elseif id == "atom" or id == "hydro" or id == "mirv" then 0 else (counts[id] or 0)
		table.insert(items, {
			id = id,
			key = i,
			label = meta.label,
			short = meta.short,
			color = meta.color,
			cost = cost,
			costText = fmtGold(cost),
			count = count,
			noSilo = (id == "atom" or id == "hydro" or id == "mirv") and (counts.silo or 0) == 0,
			afford = gold >= cost and canSelect(id), -- repo: bombada silo, savaş gemisinde liman da gerekir
			selected = buildMode == id,
		})
	end
	hud:setBuild(items)
	-- Fare üstündeki oyuncu (repo PlayerInfoOverlay): yalnız bilgi. Düğmeler sağ tık menüsünde ve bilgi panelinde.
	-- Bina / bomba yerleştirirken ve fare arayüz üstündeyken kart çıkmaz.
	local hoverPid = 0
	if mouseX and mouseY and not overHud and buildMode == nil and not menu:isOpen() then
		local tx2, ty2 = view:screenToTile(mouseX, mouseY)
		if tx2 and ty2 then
			hoverPid = renderer:ownerAt(ty2 * mapW + tx2)
			if hoverPid ~= 0 and hoverPid ~= myPid then
				lastOwner = hoverPid
			end
		end
	end
	local hs = stats[hoverPid]
	if hoverPid ~= 0 and hs and phase ~= "spawn" and mouseX and mouseY then
		local rel = relationWith(hoverPid)
		local tag, tagColor = nil, nil
		if hoverPid == myPid then
			tag, tagColor = "YOU", Color3.fromRGB(251, 191, 36)
		elseif rel.teammate then
			tag, tagColor = "TEAMMATE", Color3.fromRGB(PlayerColors.team(PlayerColors.teamOf(hoverPid)))
		elseif rel.allied then
			tag, tagColor = "ALLY", Color3.fromRGB(74, 222, 128)
		elseif rel.traitor then
			tag, tagColor = "TRAITOR", Color3.fromRGB(248, 113, 113)
		elseif atWar[hoverPid] or rel.embargoed or rel.theyEmbargo then
			tag, tagColor = "AT WAR", Color3.fromRGB(251, 146, 60)
		end
		local tx3, ty3 = view:screenToTile(mouseX, mouseY)
		local terrainName = if tx3 and ty3 then (TERRAIN_EN[buffer.readu8(terrain, ty3 * mapW + tx3)] or "") else ""
		local kindText = (if hoverPid == myPid then "Commander" else kindEn(hoverPid)) .. (if terrainName ~= "" then " • " .. terrainName else "")
		local mine2 = stats[myPid]
		local hint1 = nil
		if hoverPid ~= myPid and phase == "run" and not dead and mine2 then
			hint1 = if rel.teammate then "🤝 Teammate" elseif rel.allied then "🤝 Allied" else string.format("⚔ Click: attack with %s", fmtTroops(math.floor(mine2.troops * ratio)))
		end
		local r, g, b = PlayerColors.rgb(hoverPid)
		hud:setHover({
			name = hs.name,
			color = Color3.fromRGB(r, g, b),
			tag = tag,
			tagColor = tagColor,
			kind = kindText,
			troops = fmtTroops(hs.troops),
			land = string.format("%.1f%%", hs.tiles / math.max(mapLand, 1) * 100),
			gold = if hoverPid == myPid then fmtGold(hs.gold) else nil,
			hint1 = hint1,
			hint2 = "Right-click for more actions",
		}, frame.AbsolutePosition.X + mouseX, frame.AbsolutePosition.Y + mouseY)
	else
		hud:setHover(nil)
	end
	-- Bilgi paneli (repo PlayerPanel): sağ tık menüsündeki "bilgi" ile açılır, ✕ ile kapanır.
	local target = infoTarget
	local ts = stats[target]
	diploTarget = target
	if target ~= 0 and ts then
		local rel = relationWith(target)
		local relation = if target == myPid then "You" elseif rel.teammate then "Teammate" elseif rel.allied then "Ally" elseif rel.embargoed or rel.theyEmbargo then "Embargoed" elseif rel.traitor then "Traitor" else "Neutral"
		local lines = {}
		local landTotal = math.max(mapLand, 1)
		table.insert(lines, string.format("<font color=\"#fbbf24\">💰 %s</font>   🗺 %.1f%% land", fmtGold(ts.gold), ts.tiles / landTotal * 100))
		local tc: { [string]: number } = {}
		for _, st in structs do
			if st.pid == target then
				tc[st.type] = (tc[st.type] or 0) + st.level
			end
		end
		table.insert(lines, string.format("🏙 %d  🏭 %d  ⚓ %d  🛡 %d  🚀 %d  📡 %d", tc.city or 0, tc.factory or 0, tc.port or 0, tc.post or 0, tc.silo or 0, tc.sam or 0))
		if rel.allied and rel.allyLeft then
			table.insert(lines, string.format("🤝 Alliance: %d s left", math.ceil(rel.allyLeft / 10)))
		end
		if rel.traitor then
			table.insert(lines, "☠ Traitor (broke an alliance)")
		end
		local buttons = {}
		if target ~= myPid and phase == "run" and not dead then
			if ts.bot then
				relation = "Bot (can't ally)"
			elseif rel.teammate then
				-- takım arkadaşı: yalnız destek (ittifak / ambargo düğmesi yok)
				table.insert(buttons, { text = "🪖 Send troops (" .. math.floor(ratio * 100) .. "%)", kind = "donateTroops", color = Color3.fromRGB(134, 239, 172) })
				table.insert(buttons, { text = "💰 Send gold (" .. math.floor(ratio * 100) .. "%)", kind = "donateGold", color = Color3.fromRGB(253, 224, 71) })
			else
				if rel.allied then
					table.insert(buttons, { text = "🪖 Send troops (" .. math.floor(ratio * 100) .. "%)", kind = "donateTroops", color = Color3.fromRGB(134, 239, 172) })
					table.insert(buttons, { text = "💰 Send gold (" .. math.floor(ratio * 100) .. "%)", kind = "donateGold", color = Color3.fromRGB(253, 224, 71) })
					table.insert(buttons, { text = "Renew Alliance", kind = "extendAlly", color = Color3.fromRGB(134, 239, 172) })
					table.insert(buttons, { text = "Break Alliance", kind = "breakAlly", color = Color3.fromRGB(252, 165, 165) })
				elseif rel.reqFrom then
					table.insert(buttons, { text = "Accept Alliance", kind = "allyAccept", color = Color3.fromRGB(134, 239, 172) })
					table.insert(buttons, { text = "Reject", kind = "allyReject", color = Color3.fromRGB(252, 165, 165) })
				else
					table.insert(buttons, { text = "🤝 Request Alliance", kind = "ally", color = Color3.fromRGB(147, 197, 253) })
				end
				table.insert(buttons, { text = if rel.embargoed then "Lift Embargo" else "⛔ Embargo", kind = "embargo", color = Color3.fromRGB(196, 181, 253) })
			end
		end
		local r, g, b = PlayerColors.rgb(target)
		hud:setDiplo({
			name = ts.name .. "  ·  " .. kindName(target),
			color = Color3.fromRGB(math.min(r + 40, 255), math.min(g + 40, 255), math.min(b + 40, 255)),
			troops = fmtTroops(ts.troops) .. " / " .. fmtTroops(ts.max),
			relation = relation,
			lines = lines,
			buttons = buttons,
		})
	else
		if target ~= 0 and not ts then
			infoTarget = 0 -- oyuncu elendi
		end
		hud:setDiplo(nil)
	end
	-- Mobil hedef kartı: dokunulan yerin sahibi (her güncellemede tazelenir; kendi toprağım olunca kapanır)
	if cardTile ~= nil then
		local ctile = cardTile :: number
		local owner = renderer:ownerAt(ctile)
		local os2 = stats[owner]
		if phase ~= "run" or dead or myMode ~= "playing" or owner == myPid or (owner ~= 0 and not os2) then
			cardTile = nil
			hud:setTarget(nil)
		else
			local tag, tagColor, allied = "NEUTRAL", Color3.fromRGB(148, 163, 184), false
			if owner ~= 0 then
				local rel = relationWith(owner)
				allied = rel.allied
				if rel.teammate then
					tag, tagColor = "TEAMMATE", Color3.fromRGB(PlayerColors.team(PlayerColors.teamOf(owner)))
				elseif rel.allied then
					tag, tagColor = "ALLY", Color3.fromRGB(74, 222, 128)
				elseif rel.traitor then
					tag, tagColor = "TRAITOR", Color3.fromRGB(248, 113, 113)
				elseif atWar[owner] or rel.embargoed or rel.theyEmbargo then
					tag, tagColor = "AT WAR", Color3.fromRGB(251, 146, 60)
				end
			end
			local myTroops = if mine then mine.troops else 0
			local cr, cg, cb = 148, 163, 184
			if owner ~= 0 then
				cr, cg, cb = PlayerColors.rgb(owner)
			end
			hud:setTarget({
				name = if os2 then os2.name else "Unclaimed land",
				color = Color3.fromRGB(cr, cg, cb),
				tag = tag,
				tagColor = tagColor,
				sub = if os2
					then string.format("%s · %s troops · %.1f%% land", kindEn(owner), fmtTroops(os2.troops), os2.tiles / math.max(mapLand, 1) * 100)
					else "Wilderness · no owner",
				attack = "⚔️ Attack · " .. fmtTroops(math.floor(myTroops * ratio)),
				canAttack = not allied,
			})
		end
	end
	-- ipucu ve küçük bilgi
	local hintText = if UserInputService.TouchEnabled and not UserInputService.MouseEnabled
		then "Tap: menu (attack, boat, alliance, build) · Drag: pan · Two fingers: zoom"
		else "Left-click: attack / settle · Right-click: menu · Wheel, Q/E: zoom · Drag, WASD: pan · T/Y: attack strength · C: go to your land · 1-6: buildings"
	if buildMode then
		hintText = "Click on the map to build (cancel: press the same button again)"
	end
	if needsMouseAlign and not alignment:ready() then
		hintText = "Measuring alignment: move the mouse around a bit..."
	end
	hud:setHint(hintText)
end

local function updateTop()
	-- üst ve alt bar yalnız oyun başladıktan sonra (run fazı) görünür
	hud.top.Visible = phase == "run"
	hud.bottom.Visible = phase == "run"
	local spawnBar: number? = nil
	if phase == "ended" then
		local who = if winnerTeam ~= 0 then "Team " .. Teams.name(winnerTeam) else winnerName or "-"
		hud:setTop(if online then string.format("Winner: %s — match over", who) else string.format("Winner: %s — new round in %ds", who, secondsLeft))
	elseif myMode == "menu" then
		hud:setTop("👀 Spectating — ☰ Menu to play")
	elseif myMode == "waiting" then
		hud:setTop(if online then "👀 Match in progress — spectating" else "⏳ Waiting for next round — spectate for now")
	elseif dead then
		hud:setTop("ELIMINATED — you are spectating")
	elseif phase == "spawn" then
		local myTeam = if teamCount > 0 then PlayerColors.teamOf(myPid) else 0
		hud:setTop(if myTeam ~= 0
			then string.format("📍 You are on Team %s · Pick your starting point — %ds", Teams.name(myTeam), secondsLeft)
			else string.format("📍 Pick your starting point — %ds", secondsLeft))
		spawnBar = secondsLeft / math.max(if online then Config.ONLINE_SPAWN_SECONDS else Config.SPAWN_PHASE_SECONDS, 1)
		-- son 5 saniyede her saniye geri sayım sesi (RoWorld countdown_tick)
		if secondsLeft >= 1 and secondsLeft <= 5 and (hud :: any).tickAt ~= secondsLeft then
			(hud :: any).tickAt = secondsLeft
			Sound.play("countdownTick")
		end
	else
		hud:setTop("") -- oyun sürerken şerit gizli (üst barda maç süresi var)
	end
	hud:setBar(spawnBar)
	if phase == "spawn" then
		menu:setInfo(string.format("Round %d · start phase: %ds left", round, secondsLeft))
	elseif phase == "run" then
		menu:setInfo(string.format("Round %d in progress · press Play to join next round", round))
	else
		menu:setInfo(string.format("New round in %ds", secondsLeft))
	end
end

local function updateBoard()
	local list: { any } = {}
	local landTotal = math.max(mapLand, 1)
	for _, st in stats do
		table.insert(list, st)
	end
	table.sort(list, function(a, b)
		if a.tiles ~= b.tiles then
			return a.tiles > b.tiles
		end
		return a.pid < b.pid
	end)
	local function row(rank: number, s: any)
		local tag = ""
		for _, al in dip.allies do
			if (al.a == s.pid and al.b == myPid) or (al.b == s.pid and al.a == myPid) then
				tag = " 🤝"
			end
		end
		for _, t in dip.traitors do
			if t.pid == s.pid then
				tag = " (traitor)"
			end
		end
		local r, g, b = PlayerColors.rgb(s.pid)
		return {
			rank = rank,
			name = s.name,
			pct = string.format("%.1f%%", s.tiles / landTotal * 100),
			troops = fmtTroops(s.troops),
			color = Color3.fromRGB(r, g, b),
			mine = s.pid == myPid,
			tag = tag,
		}
	end
	local rows = {}
	-- Takım maçı: üstte takımlar (toplam toprak), altında oyuncular; takım payı kazanma hedefine sayılır.
	local myTeam = if teamCount > 0 then PlayerColors.teamOf(myPid) else 0
	local teamTiles: { [number]: number } = {}
	local teamOrder: { number } = {}
	if teamCount > 0 then
		local teamTroops: { [number]: number } = {}
		for _, s in list do
			local t = PlayerColors.teamOf(s.pid)
			if t ~= 0 then
				teamTiles[t] = (teamTiles[t] or 0) + s.tiles
				teamTroops[t] = (teamTroops[t] or 0) + s.troops
			end
		end
		for t = 1, teamCount do
			table.insert(teamOrder, t)
		end
		table.sort(teamOrder, function(a: number, b: number): boolean
			local ta, tb = teamTiles[a] or 0, teamTiles[b] or 0
			if ta ~= tb then
				return ta > tb
			end
			return a < b
		end)
		for i, t in teamOrder do
			local r, g, b = PlayerColors.team(t)
			table.insert(rows, {
				rank = i,
				name = "Team " .. Teams.name(t),
				pct = string.format("%.1f%%", (teamTiles[t] or 0) / landTotal * 100),
				troops = fmtTroops(teamTroops[t] or 0),
				color = Color3.fromRGB(r, g, b),
				mine = t == myTeam,
				tag = "",
			})
		end
	end
	local TOP = 12 - #rows
	for i = 1, math.min(#list, TOP) do
		table.insert(rows, row(i, list[i]))
	end
	-- ben ilk 12'de değilsem altta kendi sıram da görünür
	local myRank = nil
	for i, s in list do
		if s.pid == myPid then
			myRank = i
		end
	end
	if myRank and myRank > TOP then
		table.insert(rows, row(myRank, list[myRank]))
	end
	hud:setBoard(rows)
	-- daraltılmış sıralama: #sıram ve %hakimiyetim
	local mine = stats[myPid]
	if myTeam ~= 0 then
		-- takım maçı: daraltılmış sıralamada ve üst barda takımım
		local teamRank = table.find(teamOrder, myTeam) or 0
		hud:setRank("#" .. teamRank, string.format("%.1f%%", (teamTiles[myTeam] or 0) / landTotal * 100))
		local top = teamOrder[1] or myTeam
		local r, g, b = PlayerColors.team(myTeam)
		local lr, lg, lb = PlayerColors.team(top)
		hud:setControl({
			myPct = (teamTiles[myTeam] or 0) / landTotal,
			myName = "Team " .. Teams.name(myTeam),
			myColor = Color3.fromRGB(r, g, b),
			leaderPct = (teamTiles[top] or 0) / landTotal,
			leaderName = "Team " .. Teams.name(top),
			leaderColor = Color3.fromRGB(lr, lg, lb),
			meLeader = top == myTeam,
		})
		return
	end
	hud:setRank(if myRank then "#" .. myRank else "#-", if mine then string.format("%.1f%%", mine.tiles / landTotal * 100) else "0%")
	-- üst bar: dünya kontrolü (benim payım, birinci oyuncu çizgisi, %80 hedef)
	local first = list[1]
	local r, g, b = PlayerColors.rgb(myPid)
	local lr, lg, lb = 200, 200, 200
	if first then
		lr, lg, lb = PlayerColors.rgb(first.pid)
	end
	hud:setControl({
		myPct = if mine then mine.tiles / landTotal else 0,
		myName = Players.LocalPlayer.DisplayName,
		myColor = Color3.fromRGB(r, g, b),
		leaderPct = if first then first.tiles / landTotal else 0,
		leaderName = if first then first.name else "",
		leaderColor = Color3.fromRGB(lr, lg, lb),
		meLeader = first ~= nil and first.pid == myPid,
	})
end

-- Gemiler: sunucu 3 tick'te bir konum yollar; istemci her karede yumuşakça (10 tile/sn) o konuma kayar ve iz bırakır.
type BoatView = { id: number, path: { pts: { number }, born: number, rate: number, xs: { number }?, ys: { number }? }?, pathIdx: number, pid: number, x: number, y: number, tx: number, ty: number, frame: Frame, kind: number, hp: number, docked: boolean, lastX: number, lastY: number, trail: { number }, lastTile: number, seen: boolean }

local boatViews: { [number]: BoatView } = {}
local selectedWarship: number? = nil -- seçili kendi savaş gemim (taşımak için)

-- Harita boyutunda katmanlar (izler / daireler alta, efektler üste); kaydırma-zoom'da yalnız katman taşınır.
local world = WorldLayer.new(frame, mapW, mapH, 2, 9, 5)
local trails = Trails.new(world)
local fx = Fx.new(world, fmtGold)
local structures = Structures.new(world.mid, mapW, mapH)

-- Başlangıç yeri halkası (repo SpawnOverlay): seçilen yerde büyüyüp küçülen (nefes alan) daire, oyun başlayınca kaybolur.
local spawnRing = Instance.new("Frame")
spawnRing.Name = "SpawnRing"
spawnRing.AnchorPoint = Vector2.new(0.5, 0.5)
spawnRing.BackgroundColor3 = Color3.new(1, 1, 1)
spawnRing.BackgroundTransparency = 0.8
spawnRing.BorderSizePixel = 0
spawnRing.ZIndex = 16
spawnRing.Visible = false
spawnRing.Parent = world.over
do
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = spawnRing
	local st = Instance.new("UIStroke")
	st.Color = Color3.new(1, 1, 1)
	st.Thickness = 2.5
	st.Parent = spawnRing
end
local spawnRingTile = -1
local spawnRingBorn = 0
local function spawnPulseAt(tile: number)
	spawnRingTile = tile
	spawnRingBorn = os.clock()
end
local function stepSpawnRing()
	if spawnRingTile < 0 or phase ~= "spawn" or dead then
		spawnRing.Visible = false
		if phase ~= "spawn" then
			spawnRingTile = -1
		end
		return
	end
	local t = os.clock() - spawnRingBorn
	-- ilk anda büyükten içe kapanır; ardından 9.6 rad/sn nabız animasyonu.
	-- En küçük hali başlangıç toprağı (SPAWN_RADIUS) kadar, en büyük hali (SPAWN_RADIUS + 5) * 1.4.
	local intro = math.max(0, 1 - t / 0.35)
	local base = Config.SPAWN_RADIUS + 5
	local lo, hi = Config.SPAWN_RADIUS * 2, base * 1.4
	local s = (math.sin(t * 9.6) + 1) / 2 -- nabız: 0 = en küçük, 1 = en büyük
	local r = lo + (hi - lo) * s + base * intro * 1.5
	-- 26 px ek nabızla azalır: en küçükken 0, böylece her zoomda tam toprak kadar küçülür
	local px = 26 * math.max(s, intro)
	spawnRing.Position = world:at((spawnRingTile % mapW) + 0.5, (spawnRingTile // mapW) + 0.5)
	spawnRing.Size = world:size(r * 2, r * 2, px, px)
	local col = Color3.fromRGB(255, 255, 255)
	if myPid ~= 0 then
		local rr, gg, bb = PlayerColors.rgb(myPid)
		col = Color3.fromRGB(rr, gg, bb):Lerp(Color3.new(1, 1, 1), 0.4)
	end
	local st = spawnRing:FindFirstChildOfClass("UIStroke") :: UIStroke
	st.Color = col
	spawnRing.BackgroundColor3 = col
	spawnRing.Visible = true
end

-- Birim türü (sunucu k) -> Assets görseli
local UNIT_IMAGES: { [number]: string } = {
	[1] = Assets.Units.transport,
	[2] = Assets.Units.trade,
	[3] = Assets.Units.warship,
	[4] = Assets.Units.atom,
	[5] = Assets.Units.hydro,
	[6] = Assets.Units.mirv,
}

-- İlerleme / can çubuğu rengi (repo BarPass eşikleri: %25 kırmızı, %50 turuncu, %75 sarı, üstü yeşil)
local function barColor(p: number): Color3
	if p < 0.25 then
		return Color3.fromRGB(232, 25, 25)
	elseif p < 0.5 then
		return Color3.fromRGB(240, 122, 25)
	elseif p < 0.75 then
		return Color3.fromRGB(202, 231, 15)
	end
	return Color3.fromRGB(44, 239, 18)
end
local BOAT_SPEED = 10 -- tile/sn (tick başına 1 tile)

local function newFrame(z: number): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.ZIndex = z
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Parent = frame
	return f
end

-- Gönderdiğim nakliye gemisinin hedefinde işaret (repo AttackRings / FxAttackRingPass): kırmızı, iç halka 8 kesik
-- (saat yönünde döner), dış halka 2 uzun kesik (ters yönde). Boyu/kalınlığı haritayla ölçeklenir; varınca/batınca silinir.
type Marker = { root: Frame, inner: { Frame }, outer: { Frame }, born: number, tile: number }
local boatTargets: { [number]: Marker } = {}
local function ringSegments(root: Frame, dashes: number, perDash: number, thick: number): { Frame }
	local list = {}
	for _ = 1, dashes * perDash do
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Look.BoatTarget.color
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Size = UDim2.fromScale(0, thick / (Look.BoatTarget.sizeTiles * 2))
		f.ZIndex = 17
		f.Parent = root
		table.insert(list, f)
	end
	return list
end
local function makeMarker(tile: number): Marker
	local S = Look.BoatTarget.sizeTiles
	local root = Instance.new("Frame")
	root.Name = "BoatTarget"
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Size = world:size(S * 2, S * 2)
	root.Position = world:at((tile % mapW) + 0.5, (tile // mapW) + 0.5)
	root.ZIndex = 17
	root.Parent = world.over
	return { root = root, inner = ringSegments(root, 8, 2, S * 0.08), outer = ringSegments(root, 2, 6, S * 0.12), born = os.clock(), tile = tile }
end
-- Kesikleri çember üstüne dizer: `dashes` kesik, her biri `duty` oranında, başlangıç açısı `phase`.
local function placeRing(list: { Frame }, dashes: number, radius: number, duty: number, phase: number, alpha: number)
	local perDash = #list // dashes
	local span = 2 * math.pi / dashes * duty
	local S = Look.BoatTarget.sizeTiles
	for d = 0, dashes - 1 do
		local a0 = phase + d * 2 * math.pi / dashes - span / 2
		for k = 0, perDash - 1 do
			local f = list[d * perDash + k + 1]
			local a = a0 + span * (k + 0.5) / perDash
			f.Position = UDim2.fromScale(0.5 + radius * math.cos(a) / (S * 2), 0.5 + radius * math.sin(a) / (S * 2))
			f.Size = UDim2.fromScale((radius * span / perDash + S / 30) / (S * 2), f.Size.Y.Scale)
			f.Rotation = math.deg(a) + 90
			f.BackgroundTransparency = 1 - alpha
		end
	end
end
local function stepMarkers()
	local now = os.clock()
	local S = Look.BoatTarget.sizeTiles
	for _, m in boatTargets do
		local alpha = math.min(1, (now - m.born) / 0.2) -- repo: halka belirerek gelir
		local t = now - m.born
		placeRing(m.inner, 8, S * 0.5, 0.55, t * Look.BoatTarget.innerSpeed, alpha)
		placeRing(m.outer, 2, S * 0.8, 0.65, -t * Look.BoatTarget.outerSpeed, alpha)
	end
end
local function setBoatTarget(id: number, tile: number?)
	local m = boatTargets[id]
	if tile == nil then
		if m then
			m.root:Destroy()
			boatTargets[id] = nil
		end
		return
	end
	if m and m.tile == tile then
		return
	end
	if m then
		m.root:Destroy()
	end
	boatTargets[id] = makeMarker(tile)
end

-- Gemi boyu (Look.Ship): tile biriminde, en az / en çok piksel sınırıyla. 1 nakliye, 2 ticaret, 3 savaş gemisi.
local function shipPx(kind: number): number
	local spec = if kind == 2 then Look.Ship.trade elseif kind == 3 then Look.Ship.warship else Look.Ship.transport
	return math.clamp(view.zoom * spec.tiles, spec.minPx, spec.maxPx)
end

-- İz kalıcıdır: gemi varış noktasına ulaşıp yok olunca iz de silinir.
local function drawBoats()
	for id, v in boatViews do
		if not v.seen then
			if v.kind == 3 and v.pid == myPid and v.hp < 60 then
				Sound.play("warshipLost")
			end
			v.frame:Destroy()
			renderer:clearTrail(v.trail)
			trails:remove(id)
			setBoatTarget(id, nil)
			boatViews[id] = nil
		end
	end
	for _, v in boatViews do
		if v.kind >= 4 then
			-- boy zoomla (tile birimi), uzaktan da seçilebilsin diye en az 4 piksel
			local s = math.clamp(view.zoom * (if v.kind == 6 then 4.5 elseif v.kind == 5 then 3.5 else 2.5), 4, if v.kind == 6 then 26 else 20)
			v.frame.Size = UDim2.fromOffset(s, s)
			local stroke = v.frame:FindFirstChild("Stroke") :: UIStroke?
			if stroke then stroke.Thickness = math.min(view.zoom / Look.Ship.strokeZoom, s * Look.Ship.strokeMaxRatio) end
			v.frame.Rotation = 45
			-- uçan bomba kendi rengiyle beyaz arasında 0.3 sn'de bir yanıp söner
			local blinkWhite = math.floor(os.clock() / 0.3) % 2 == 1
			v.frame.BackgroundColor3 = if blinkWhite then Color3.new(1, 1, 1) elseif v.kind == 6 then Color3.fromRGB(239, 68, 68) elseif v.kind == 5 then Color3.fromRGB(255, 60, 200) else Color3.fromRGB(255, 140, 20)
			v.frame.Position = UDim2.fromOffset(view.x + v.x * view.zoom, view.y + v.y * view.zoom)
			v.frame.Visible = true
			continue
		end
		-- yuvarlak gemi (Look.Ship): ticaret < nakliye < savaş gemisi
		local size = shipPx(v.kind)
		v.frame.Size = UDim2.fromOffset(size, size)
		local stroke = v.frame:FindFirstChild("Stroke") :: UIStroke?
		if stroke then
			local extra = if v.kind == 3 and selectedWarship == v.id then 1.5 else 0
			stroke.Thickness = math.min((Look.Ship.stroke + extra) * view.zoom / Look.Ship.strokeZoom, size * Look.Ship.strokeMaxRatio * (if extra > 0 then 1.5 else 1))
		end
		if v.kind == 3 then
			local sel = selectedWarship == v.id
			if stroke then
				-- seçili gemi sarı çerçeveyle
				stroke.Color = if sel then Color3.fromRGB(253, 224, 71) elseif v.pid == myPid then Look.Ship.strokeMine else Look.Ship.strokeOther
			end
			local hpBar = v.frame:FindFirstChild("Hp") :: Frame?
			if hpBar then
				hpBar.Visible = size >= 10
				local fill = hpBar:FindFirstChild("Fill") :: Frame
				-- can çubuğu yeni değere kayarak iner/çıkar
				local h = math.clamp(v.hp / 100, 0, 1)
				local shown = (v :: any).hpShown or h
				shown += (h - shown) * 0.15
				;(v :: any).hpShown = shown
				fill.Size = UDim2.fromScale(shown, 1)
				fill.BackgroundColor3 = barColor(shown)
			end
		end
		v.frame.Position = UDim2.fromOffset(view.x + v.x * view.zoom, view.y + v.y * view.zoom)
		v.frame.Visible = true
	end
end

-- Demiryolu: ray tile'ları (id -> liste) ve çalışan trenler (yol boyunca saate göre ilerler).
local railTiles: { [number]: { number } } = {}
-- Ray rengi, rayın geçtiği tile'ın sahibine göre (repo railroad.frag.glsl): benimki açık gri (#e6e6e6; toprağım çok
-- açık renkliyse siyah), başkalarınınki o ülkenin sınır rengi, sahipsiz toprakta gri.
local function railColorOf(o: number): Color3
	if o == 0 then
		return Look.Rail.unowned
	end
	local r, g, b = PlayerColors.rgb(o)
	if o == myPid then
		return if RailGeom.brightness(r, g, b) > 0.8 then Color3.new(0, 0, 0) else Look.Rail.mine
	end
	local br, bg, bb = PlayerColors.border(r, g, b)
	return Color3.fromRGB(br, bg, bb)
end
local rails = Rails.new(world, mapW, function(t: number): number
	return renderer:ownerAt(t)
end, railColorOf)
local trains: { [number]: { pts: { number }, born: number, cars: { Frame } } } = {}

-- Bomba yolları (aşağıda stepBoats kullanır)
local nukeTargets = require(script.NukeTargets).new(world, Config)
local nukePaths: { [number]: { pts: { number }, born: number, rate: number, xs: { number }?, ys: { number }? } } = {}

-- MIRV savaş başlıkları: sunucu ayrılmada tek olay yollar; istemci her başlığı kendi Bézier yayında uçurur.
type Warhead = { frame: Frame, x0: number, y0: number, x1: number, y1: number, x2: number, y2: number, x3: number, y3: number, start: number, dur: number }
local warheads: { [number]: Warhead } = {}
local function arcCtrl(sx: number, sy: number, tx: number, ty: number): (number, number, number, number)
	local dx, dy = tx - sx, ty - sy
	local d = math.sqrt(dx * dx + dy * dy)
	local H = math.max(d / 3, 50)
	return sx + dx / 4, math.clamp(sy + dy / 4 - H, 0, mapH - 1), sx + dx * 3 / 4, math.clamp(sy + dy * 3 / 4 - H, 0, mapH - 1)
end
-- Bomba yayının ondalıklı noktaları: sunucunun yolladığı 2 tile aralıklı TAM SAYI tile'lar ekranda basamak gibi
-- titrer; aynı Bézier istemcide yeniden kurulup aynı aralıkla örneklenir (indisler sunucuyla eşleşir).
local function arcFloats(pts: { number }): ({ number }, { number })
	local src, dst = pts[1], pts[#pts]
	local x0, y0, x3, y3 = src % mapW, src // mapW, dst % mapW, dst // mapW
	local x1, y1, x2, y2 = arcCtrl(x0, y0, x3, y3)
	local dx, dy = x3 - x0, y3 - y0
	local d = math.sqrt(dx * dx + dy * dy)
	local n = math.max(64, math.ceil(d * 6))
	local bx, by, cum = { x0 }, { y0 }, { 0 }
	for i = 1, n do
		local t = i / n
		local u = 1 - t
		local a, b, c, e = u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t
		local x, y = a * x0 + b * x1 + c * x2 + e * x3, a * y0 + b * y1 + c * y2 + e * y3
		bx[i + 1], by[i + 1] = x, y
		cum[i + 1] = cum[i] + math.sqrt((x - bx[i]) ^ 2 + (y - by[i]) ^ 2)
	end
	local xs, ys = {}, {}
	local j = 1
	for k = 0, math.floor(cum[n + 1] / 2) do
		local s = k * 2
		while j < n and cum[j + 1] < s do
			j += 1
		end
		local sg = cum[j + 1] - cum[j]
		local f = if sg > 0 then (s - cum[j]) / sg else 0
		xs[#xs + 1] = bx[j] + (bx[j + 1] - bx[j]) * f + 0.5
		ys[#ys + 1] = by[j] + (by[j + 1] - by[j]) * f + 0.5
	end
	xs[#xs + 1], ys[#ys + 1] = x3 + 0.5, y3 + 0.5
	return xs, ys
end
local function stepWarheads()
	local now = os.clock()
	for id, h in warheads do
		local t = (now - h.start) / h.dur
		if t < 0 then
			h.frame.Visible = false
		else
			t = math.min(t, 1)
			local u = 1 - t
			local a, b, c, e = u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t
			h.frame.Position = world:at(a * h.x0 + b * h.x1 + c * h.x2 + e * h.x3, a * h.y0 + b * h.y1 + c * h.y2 + e * h.y3)
			h.frame.Visible = true
			if t >= 1 and now - h.start > h.dur + 1.5 then
				-- sunucudan "end" gelmediyse yine de temizle
				h.frame:Destroy()
				warheads[id] = nil
			end
		end
	end
end


fxRemote.OnClientEvent:Connect(function(list: { any })
	for _, e in list do
		if e.k == "railAdd" then
			railTiles[e.id] = e.tiles
			rails:add(e.id, e.tiles)
			local mid = e.tiles[math.max(1, #e.tiles // 2)]
			if mid and renderer:ownerAt(mid) == myPid then
				Sound.play("trainStation")
			end
			continue
		elseif e.k == "railDel" then
			local t = railTiles[e.id]
			if t then
				railTiles[e.id] = nil
				rails:remove(e.id)
			end
			continue
		elseif e.k == "trainStart" then
			local cars = {}
			local r, g, b = PlayerColors.rgb(e.pid)
			for c = 0, Config.TRAIN_CARS do
				local f = newFrame(7)
				f.Name = if c == 0 then "TrainEngine" else "TrainCar"
				f.BackgroundColor3 = if c == 0 then Color3.fromRGB(30, 30, 30) else Color3.fromRGB(r, g, b)
				local imgId = if c == 0 then Assets.Units.trainEngine else Assets.Units.trainCar
				if Assets.has(imgId) then
					f.BackgroundTransparency = 1
					local il = Instance.new("ImageLabel")
					il.BackgroundTransparency = 1
					il.Size = UDim2.fromScale(1, 1)
					il.Image = imgId
					il.ImageColor3 = if c == 0 then Color3.new(1, 1, 1) else Color3.fromRGB(r, g, b)
					il.ScaleType = Enum.ScaleType.Fit
					il.ZIndex = 7
					il.Parent = f
				end
				cars[c + 1] = f
			end
			trains[e.id] = { pts = e.pts, born = os.clock(), cars = cars }
			continue
		elseif e.k == "trainEnd" then
			local t = trains[e.id]
			if t then
				for _, f in t.cars do
					f:Destroy()
				end
				trains[e.id] = nil
			end
			continue
		elseif e.k == "launch" then
			nukeTargets:set(e.id, e.tile, e.w)
			nukePaths[e.id] = { pts = e.pts :: { number }, born = os.clock(), rate = (e.rate or 50) :: number, xs = nil, ys = nil }
			Sound.play(if e.w == "hydro" then "hydroLaunch" elseif e.w == "mirv" then "mirvLaunch" else "atomLaunch")
			continue
		elseif e.k == "mirvSplit" then
			local sx, sy = (e.src % mapW) + 0.5, (e.src // mapW) + 0.5
			local now = os.clock()
			local col = if e.pid == myPid then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(255, 120, 60)
			for _, h in e.list do
				local tx, ty = (h.t % mapW) + 0.5, (h.t // mapW) + 0.5
				local x1, y1, x2, y2 = arcCtrl(sx, sy, tx, ty)
				local f = Instance.new("Frame")
				f.AnchorPoint = Vector2.new(0.5, 0.5)
				f.BorderSizePixel = 0
				f.BackgroundColor3 = col
				f.Size = world:size(2, 2, 2, 2)
				f.ZIndex = 14
				f.Visible = false
				if Assets.has(Assets.Units.warhead) then
					f.BackgroundTransparency = 1
					local il = Instance.new("ImageLabel")
					il.BackgroundTransparency = 1
					il.Size = UDim2.fromScale(1, 1)
					il.Image = Assets.Units.warhead
					il.ZIndex = 14
					il.Parent = f
				end
				f.Parent = world.over
				warheads[h.id] = { frame = f, x0 = sx, y0 = sy, x1 = x1, y1 = y1, x2 = x2, y2 = y2, x3 = tx, y3 = ty, start = now + (h.w or 0) * 0.1, dur = math.max(0.1, (h.n or 10) * 0.1) }
			end
			if e.pid ~= myPid then
				hud:toast("☄ MIRV separated! Hundreds of warheads incoming.")
			end
			continue
		elseif e.k == "end" then
			nukeTargets:remove(e.id)
			nukePaths[e.id] = nil
			local wh = warheads[e.id]
			if wh then
				wh.frame:Destroy()
				warheads[e.id] = nil
			end
			local v = boatViews[e.id]
			if v then
				v.seen = false -- bombanın işi bitti: bomba ve izi hemen silinir
				drawBoats()
			end
			continue
		end
		local function tx(t: number): (number, number)
			return (t % mapW) + 0.5, (t // mapW) + 0.5
		end
		if e.k == "conquest" then
			-- repo: fetih efekti yalnız fethedenin ekranında
			if e.pid == myPid and myPid ~= 0 then
				local x, y = tx(e.tile)
				fx:conquest(x, y, e.g or 0)
				if (e.g or 0) > 0 then
					hud:goldGain(fmtGold(e.g))
				end
				hud:toast(string.format("%s conquered! +%s gold", e.name or "?", fmtGold(e.g or 0)))
				-- repo: gerçek oyuncu fethi kılıç sesi, bot / ulus ganimeti "ka-ching"
				Sound.play(if e.human then "conquered" else "kaching")
			end
		elseif e.k == "gold" then
			if e.pid == myPid and myPid ~= 0 then
				local x, y = tx(e.tile)
				fx:gold(x, y, e.g)
				hud:goldGain(fmtGold(e.g))
				-- (ses yalnız altın ekranda görünen yerde geldiyse; bekleme süresi Assets.SoundCooldown.gold)
				local sx, sy = view.x + x * view.zoom, view.y + y * view.zoom
				if sx >= 0 and sy >= 0 and sx <= frame.AbsoluteSize.X and sy <= frame.AbsoluteSize.Y then
					Sound.play("gold")
				end
			end
		elseif e.k == "shell" then
			local x0, y0 = tx(e.from)
			local x1, y1 = tx(e.to)
			fx:projectile("shell", x0, y0, x1, y1, (e.n or 1) * 0.1, 0, Color3.fromRGB(255, 236, 160))
			if e.pid == myPid then
				Sound.play("warshipShot")
				task.delay((e.n or 1) * 0.1, function()
					Sound.play("shellHit") -- (mermi hedefe vardı)
				end)
			end
		elseif e.k == "samShot" then
			local x0, y0 = tx(e.from)
			local x1, y1 = tx(e.to)
			fx:projectile("samShot", x0, y0, x1, y1, (e.n or 1) * 0.1, (e.wait or 0) * 0.1, Color3.fromRGB(125, 211, 252))
			task.delay((e.wait or 0) * 0.1, function()
				Sound.play("samShoot")
			end)
		elseif e.k == "atom" or e.k == "hydro" then
			local x, y = tx(e.tile)
			fx:explosion(x, y, e.r or 30, true)
			Sound.play(if e.k == "hydro" then "hydroHit" else "atomHit")
		elseif e.k == "warhead" then
			local x, y = tx(e.tile)
			fx:explosion(x, y, e.r or 18, true)
			Sound.play("atomHit") -- (Assets.SoundCooldown.atomHit aralığıyla; yüzlerce başlıkta ses yığılmaz)
		elseif e.k == "sam" then
			local x, y = tx(e.tile)
			fx:explosion(x, y, 6, false)
			Sound.play("samHit")
		elseif e.k == "sunk" then
			-- batan savaş gemisi (repo: patlama + batma efekti)
			local x, y = tx(e.tile)
			local r, g, b = PlayerColors.rgb(e.pid or 0)
			fx:sunk(x, y, Color3.fromRGB(r, g, b))
			if e.pid ~= myPid then
				Sound.play("shipSink") -- (kendi gemimiz için warshipLost çalar)
			end
		end
	end
end)

local function drawTrains()
	local now = os.clock()
	local speed = Config.TRAIN_SPEED * 10
	for _, t in trains do
		local head = math.floor((now - t.born) * speed) + 1
		local size = math.floor(math.max(view.zoom * 1.2, 4) * Look.Train.scale + 0.5)
		for c, f in t.cars do
			local idx = head - (c - 1) * 1
			local p = t.pts[math.clamp(idx, 1, #t.pts)]
			f.Visible = idx >= 1
			f.Size = UDim2.fromOffset(size, size)
			f.Position = UDim2.fromOffset(view.x + ((p % mapW) + 0.5) * view.zoom, view.y + ((p // mapW) + 0.5) * view.zoom)
		end
	end
end


-- Bomba yolları: sunucu kalkışta yayı (2 tile aralıklı noktalar) bir kez yollar; bomba ve iz o yay üzerinde 100 tile/sn ilerler.
-- İz bomba bitene (patlama ya da SAM) kadar kalır, sonra silinir.

local updateRelations: () -> () = function() end -- aşağıda atanır
local updateGhost: () -> () = function() end -- aşağıda (kurma önizlemesi) atanır
local drawAttackLabels: () -> () = function() end -- aşağıda (fmtTroops tanımlandıktan sonra) atanır

local function stepBoats(dt: number)
	for _, v in boatViews do
		if v.kind >= 4 then
			local path = v.path or nukePaths[v.id]
			if path then
				v.path = path
				if not path.xs then
					path.xs, path.ys = arcFloats(path.pts)
				end
				local xs, ys = path.xs :: { number }, path.ys :: { number }
				-- ondalıklı indis: bomba noktalar arasında da akıcı kayar
				local fi = math.clamp((os.clock() - path.born) * (path.rate or 50), 0, #xs - 1)
				local i0 = math.floor(fi) + 1
				local i1 = math.min(#xs, i0 + 1)
				local f = fi - (i0 - 1)
				v.x = xs[i0] + (xs[i1] - xs[i0]) * f
				v.y = ys[i0] + (ys[i1] - ys[i0]) * f
				if not trails:has(v.id) then
					local r, g, b = PlayerColors.rgb(v.pid)
					trails:startPoly(v.id, Color3.fromRGB(r, g, b), xs[1], ys[1], 0.63)
				end
				trails:pointPoly(v.id, v.x, v.y)
				continue
			end
		end
		local dx, dy = v.tx - v.x, v.ty - v.y
		local d = math.sqrt(dx * dx + dy * dy)
		if d > 0 then
			local speed = if v.kind >= 4 then BOAT_SPEED * 10 else BOAT_SPEED -- bomba 10 tile/tick = 100 tile/sn
			local step = math.min(d, speed * dt * (1 + d / 6)) -- geride kalırsa hızlan
			v.x += dx / d * step
			v.y += dy / d * step
		end
		if v.kind == 1 then
			trails:point(v.id, v.x, v.y) -- düz, köşeleri yumuşatılmış iz
		end
	end
	drawBoats()
	stepMarkers()
	fx:step()
	stepWarheads()
	drawTrains()
	drawAttackLabels()
end

-- Yapılar: harita katmanındaki simgeler (Structures modülü, repo StructurePass). Liste değişince eşitlenir.
local function drawStructures()
	drawBoats()
	structures:sync(structs, myPid)
end

-- Yapı çubukları her karede: sunucu saniyede bir ilerleme yollar, arası tick hızıyla tahmin edilir (pat diye değil akarak dolar).
local function updateBars()
	structures:step(os.clock() - structsAt, Config.TICK_RATE, function(p: number, bar: string): Color3
		return if bar == "delete" then Color3.fromRGB(239, 68, 68) elseif bar == "upgrade" then Color3.fromRGB(56, 189, 248) else barColor(p)
	end)
end

-- Bölge isim ve asker yazıları: bölge ekranda yeterince büyükse görünür, boyu bölgenin boyuna göre ölçeklenir.
-- Saldırı asker sayıları: giden saldırı mavi, gelen saldırı kırmızı; cephe hattı kümelerinde (en çok 2) 250 ms'de kayarak ilerler.
type AtkSlot = { label: TextLabel, curX: number, curY: number, srcX: number, srcY: number, dstX: number, dstY: number, t0: number, seen: boolean }
local atkSlots: { [string]: AtkSlot } = {}
local OUT_COLOR = Color3.fromRGB(63, 169, 245) -- #3fa9f5
local IN_COLOR = Color3.fromRGB(248, 113, 113) -- #f87171

-- Sınır ilişki tonu (repo RelationMatrix): TÜM oyuncu çiftleri için ittifak = 1 (yeşil), ambargo = 2 (kırmızı; saldırıdan
-- doğan geçici ambargo dahil, ambargo üstün). Repodaki gibi bota saldırı ambargo doğurmaz, o yüzden botla sınır kırmızı olmaz;
-- ulus ve gerçek oyuncuya saldırınca (geçici ambargo) kırmızı olur.
-- İlişki değişince yalnız o iki oyuncunun ortak sınırı yeniden boyanır (kuyruk, kare başına bütçe).
local lastOutAt: { [number]: number } = {} -- en son ne zaman bu oyuncuya saldırdım (misilleme uyarı vermez)
local seenAttacks: { [number]: boolean } = {}
local lastAlertAt = -100
local relPairs: { [number]: number } = {}
local function pairKey(a: number, b: number): number
	return if a < b then a * 65536 + b else b * 65536 + a
end
renderer.relation = function(a: number, b: number): number
	return relPairs[pairKey(a, b)] or 0
end
updateRelations = function()
	local new: { [number]: number } = {}
	for _, al in dip.allies do
		new[pairKey(al.a, al.b)] = 1
	end
	for _, e in dip.embargo do
		new[pairKey(e.from, e.to)] = 2
	end
	local changed: { number } = {}
	for k, v in new do
		if relPairs[k] ~= v then
			changed[#changed + 1] = k
		end
	end
	for k in relPairs do
		if new[k] == nil then
			changed[#changed + 1] = k
		end
	end
	relPairs = new
	for _, k in changed do
		renderer:queuePair(k // 65536, k % 65536)
	end
end

attacksRemote.OnClientEvent:Connect(function(list: any)
	if type(list) ~= "table" then
		return
	end
	for _, s in atkSlots do
		s.seen = false
	end
	local now = os.clock()
	for _, a in list do
		local outgoing = a.pid == myPid
		if a.tg == myPid and a.pid ~= myPid and myPid ~= 0 then
			(menuCb :: any).hitAt, (menuCb :: any).hitBy = now, a.pid -- (Client.Analytics: saldırı altında / kim eledi)
		end
		local incoming = a.tg == myPid and PlayerColors.kindOf(a.pid) ~= 2 -- botlardan gelen saldırı etiketlenmez
		if (outgoing or incoming) and myPid ~= 0 then
			for i, tile in a.p do
				local key = a.id .. "_" .. i
				local tx, ty = (tile % mapW) + 0.5, (tile // mapW) + 0.5
				local s = atkSlots[key]
				if not s then
					local l = Instance.new("TextLabel")
					require(script.TextFit).fit(l)
					l.BackgroundTransparency = 1
					l.AnchorPoint = Vector2.new(0.5, 0.5)
					l.Size = UDim2.fromOffset(80, 20)
					l.FontFace = Fonts.main
					l.TextSize = 17
					l.TextStrokeColor3 = Color3.new(0, 0, 0)
					l.TextStrokeTransparency = 0.35
					l.ZIndex = 8
					l.Active = false
					l.Visible = settings.attackNumbers
					l.Parent = frame
					s = { label = l, curX = tx, curY = ty, srcX = tx, srcY = ty, dstX = tx, dstY = ty, t0 = now, seen = true }
					atkSlots[key] = s
				else
					local t = math.min(1, (now - s.t0) / 0.25)
					local cx = s.srcX + (s.dstX - s.srcX) * t
					local cy = s.srcY + (s.dstY - s.srcY) * t
					if math.abs(tx - cx) + math.abs(ty - cy) > 200 then
						cx, cy = tx, ty -- büyük sıçrama: animasyonsuz
					end
					s.srcX, s.srcY, s.dstX, s.dstY, s.t0 = cx, cy, tx, ty, now
				end
				s.seen = true
				s.label.Text = fmtTroops(a.tr)
				s.label.TextColor3 = if outgoing then OUT_COLOR else IN_COLOR
			end
		end
	end
	for key, s in atkSlots do
		if not s.seen then
			s.label:Destroy()
			atkSlots[key] = nil
		end
	end
	table.clear(atWar)
	for _, a in list do
		if a.pid == myPid and a.tg ~= 0 then
			atWar[a.tg] = true
		elseif a.tg == myPid then
			atWar[a.pid] = true
		end
	end
	-- Saldırı listesi paneli ve büyük saldırı uyarısı (repo AttacksDisplay + AlertFrame)
	local rows: { Hud.AttackRow } = {}
	local active: { [number]: boolean } = {}
	local mine = stats[myPid]
	for _, a in list do
		if myPid ~= 0 and a.pid == myPid then
			lastOutAt[a.tg] = now
			table.insert(rows, {
				text = "⚔ " .. (if a.tg == 0 then "Unclaimed land" else (names[a.tg] or "?")) .. "  " .. fmtTroops(a.tr),
				incoming = false,
				target = a.tg,
				key = "o" .. a.id,
			})
		elseif myPid ~= 0 and a.tg == myPid then
			active[a.id] = true
			table.insert(rows, { text = "🛡 " .. (names[a.pid] or "?") .. "  " .. fmtTroops(a.tr), incoming = true, key = "i" .. a.id })
			if not seenAttacks[a.id] then
				seenAttacks[a.id] = true
				local bot = PlayerColors.kindOf(a.pid) == 2
				local retaliation = lastOutAt[a.pid] ~= nil and now - lastOutAt[a.pid] < 15
				local small = mine ~= nil and a.tr < mine.troops / 5
				local alerted = false
				if settings.alerts and not bot and not retaliation and not small and now - lastAlertAt >= 15 then
					lastAlertAt = now
					alerted = true
					hud:alert("attack")
					Sound.play("underAttack")
				end
				-- bildirim aktışı (RoWorld): kim saldırırsa "X (asker) is attacking you!", karşılıksa "counter-attacking";
				-- aynı saldıran için 20 sn'de bir. Kenar uyarısı çalmadıysa bildirim sesi.
				local feedAt = (hud.feed :: any).attackAt or {}
				;(hud.feed :: any).attackAt = feedAt
				if now - (feedAt[a.pid] or -100) >= 20 then
					feedAt[a.pid] = now
					local att = stats[a.pid]
					hud.feed:push(string.format(if retaliation then "%s (%s) is counter-attacking you!" else "%s (%s) is attacking you!", names[a.pid] or "?", fmtTroops(if att then att.troops else a.tr)), 9, hud.feed.ALERT)
					if not alerted then
						Sound.play("notify")
					end
				end
			end
		end
	end
	for id in seenAttacks do
		if not active[id] then
			seenAttacks[id] = nil
		end
	end
	hud:setAttacks(rows)
end)

drawAttackLabels = function()
	local now = os.clock()
	for _, s in atkSlots do
		local t = math.min(1, (now - s.t0) / 0.25)
		local x = s.srcX + (s.dstX - s.srcX) * t
		local y = s.srcY + (s.dstY - s.srcY) * t
		s.label.Position = UDim2.fromOffset(view.x + x * view.zoom, view.y + y * view.zoom)
	end
end

-- İsim plakaları (repo NamePass): sunucu her oyuncu için yazı yeri ve "boy" (fs) verir; ekrandaki boy repo formülüyle:
--   b = max(1, floor(fs)), nameSize = max(4, floor(b*0.4)), nameScale = min(b*0.25, 3), satır yüksekliği = nameSize*nameScale tile.
-- Yer ve boy yeni değere 1 - e^(-10t) ile kayar (lerpSpeed 10). Ekranda çok küçükse (ekran genişliğinin ~%0.53'ü) gizlenir.
-- Dolgu: insan siyah, ulus %30 gri, bot %40 gri; dış hat oyuncunun rengi. Üstte durum simgeleri (taç, ittifak, ambargo, hain, istek).
type NameView = { name: TextLabel, troops: TextLabel, icons: TextLabel, sx: number, sy: number, ss: number, tx: number, ty: number, ts: number, t0: number, init: boolean, fade: boolean? }
local nameViews: { [number]: NameView } = {}
local NAME_LERP = 10

local function newNameLabel(bold: boolean): TextLabel
	local l = Instance.new("TextLabel")
	require(script.TextFit).fit(l)
	l.BackgroundTransparency = 1
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.FontFace = Fonts.main
	l.TextStrokeTransparency = 0
	l.Name = "CountryLabel"
	l.ZIndex = 6 -- above WorldStructures (5), below world effects (9)
	l.Active = false
	l.Size = UDim2.fromOffset(10, 10)
	l.Parent = frame
	return l
end

local function plateHeight(fs: number): number
	local b = math.max(1, math.floor(fs))
	return math.max(4, math.floor(b * 0.4)) * math.min(b * 0.25, 3)
end

-- Durum simgeleri (repo PlayerStatus): taç = en çok toprak, ittifak/istek/ambargo yalnız benimle ilişkiye göre.
local statusIcons: { [number]: string } = {}
local function updateStatusIcons()
	table.clear(statusIcons)
	local crown, most = 0, 0
	for pid, p in stats do
		if p.tiles > most then
			most, crown = p.tiles, pid
		end
	end
	local function add(pid: number, icon: string)
		statusIcons[pid] = (statusIcons[pid] or "") .. icon
	end
	if crown ~= 0 then
		add(crown, "👑")
	end
	for _, t in dip.traitors do
		add(t.pid, "☠️")
	end
	if myPid ~= 0 then
		for _, al in dip.allies do
			if al.a == myPid then
				add(al.b, "🤝")
			elseif al.b == myPid then
				add(al.a, "🤝")
			end
		end
		for _, r in dip.reqs do
			if r.to == myPid then
				add(r.from, "✉️")
			end
		end
		local emb: { [number]: boolean } = {}
		for _, e in dip.embargo do
			if e.from == myPid then
				emb[e.to] = true
			elseif e.to == myPid then
				emb[e.from] = true
			end
		end
		for pid in emb do
			add(pid, "⛔")
		end
	end
end

local function drawNames()
	local z = view.zoom
	local vw, vh = frame.AbsoluteSize.X, frame.AbsoluteSize.Y
	local cull = math.max(6, vw * 0.0053)
	local now = os.clock()
	local cv = (menuCb :: any).cosView
	for pid, v in nameViews do
		if not stats[pid] then
			v.name:Destroy()
			v.troops:Destroy()
			v.icons:Destroy()
			cv:hideFlag(v, true)
			nameViews[pid] = nil
		end
	end
	for pid, p in stats do
		local v = nameViews[pid]
		local show = false
		if p.c and p.tiles > 0 and settings.names then
			local tx, ty, ts = (p.c % mapW) + 0.5, (p.c // mapW) + 0.5, plateHeight(p.fs or 1)
			if not v then
				v = {
					name = newNameLabel(true),
					troops = newNameLabel(false),
					icons = newNameLabel(false),
					sx = tx, sy = ty, ss = ts, tx = tx, ty = ty, ts = ts, t0 = now, init = true,
				}
				v.icons.TextStrokeTransparency = 1
				nameViews[pid] = v
			end
			if v.tx ~= tx or v.ty ~= ty or v.ts ~= ts then
				-- yeni hedef: o anki ara konumdan kaymaya başla
				local k = 1 - math.exp(-NAME_LERP * (now - v.t0))
				v.sx, v.sy, v.ss = v.sx + (v.tx - v.sx) * k, v.sy + (v.ty - v.sy) * k, v.ss + (v.ts - v.ss) * k
				v.tx, v.ty, v.ts, v.t0 = tx, ty, ts, now
			end
			local k = math.min(1, 1 - math.exp(-NAME_LERP * (now - v.t0)))
			local wx, wy, ws = v.sx + (v.tx - v.sx) * k, v.sy + (v.ty - v.sy) * k, v.ss + (v.ts - v.ss) * k
			local px = ws * z
			local width = px * #p.name * 0.62
			local sx, sy = view.x + wx * z, view.y + wy * z
			if px >= cull and sx > -width and sx < vw + width and sy > -px * 3 and sy < vh + px * 3 then
				show = true
				local size = math.min(px, 100)
				local kind = PlayerColors.kindOf(pid)
				local shade = if kind == 2 or p.bot then 102 elseif kind == 1 or p.nation then 77 else 0
				local fill = Color3.fromRGB(shade, shade, shade)
				local r, g, b = PlayerColors.rgb(pid)
				local outline = Color3.fromRGB(r, g, b)
				if v.init or v.name.Text ~= p.name then
					v.name.Text = p.name
					v.init = false
				end
				v.name.TextSize = size
				v.name.TextColor3 = fill
				v.name.TextStrokeColor3 = outline
				v.name.Size = UDim2.fromOffset(width * 1.3, size * 1.25)
				v.name.Position = UDim2.fromOffset(sx, sy)
				local tt = fmtTroops(p.troops)
				if v.troops.Text ~= tt then
					v.troops.Text = tt
				end
				local tsz = math.max(size * 0.6, 6) -- repo troopSizeMultiplier 0.6
				v.troops.TextSize = tsz
				v.troops.TextColor3 = fill
				v.troops.TextStrokeColor3 = outline
				v.troops.Size = UDim2.fromOffset(width * 1.3, tsz * 1.25)
				v.troops.Position = UDim2.fromOffset(sx, sy + size * 0.825) -- repo: 1.1 x taban çizgisi (0.75)
				local ic = if settings.icons then statusIcons[pid] else nil
				if ic then
					local isz = math.max(size * 0.8, 10)
					v.icons.Text = ic
					v.icons.TextSize = isz
					v.icons.Size = UDim2.fromOffset(isz * 4, isz * 1.2)
					v.icons.Position = UDim2.fromOffset(sx, sy - size * 1.05)
					v.icons.Visible = true
				else
					v.icons.Visible = false
				end
				v.name.Visible = true
				v.troops.Visible = true
				cv:placeFlag(v, p.fl, v.name, sx, sy, size, p.uid) -- (adın solunda headshot, onun solunda takılı bayrak)
			end
		end
		if not show and v then
			v.name.Visible = false
			v.troops.Visible = false
			v.icons.Visible = false
			cv:hideFlag(v, false)
		end
	end
end

local function applyView()
	local x, y = view:rect()
	local zoom = view.zoom
	for i, img in mapImages do
		-- Bloklar arasında dikiş kalmasın: kenarlar tam piksele yuvarlanır.
		local x0, y0, bw, bh = MapRenderer.blockRect(i, mapW, mapH)
		local left = math.floor(x + x0 * zoom + 0.5)
		local right = math.floor(x + (x0 + bw) * zoom + 0.5)
		local top = math.floor(y + y0 * zoom + 0.5)
		local bottom = math.floor(y + (y0 + bh) * zoom + 0.5)
		img.Position = UDim2.fromOffset(left, top)
		img.Size = UDim2.fromOffset(right - left, bottom - top)
	end
	world:place(x, y, zoom)
	rails:setZoom(zoom)
	structures:setZoom(zoom)
	fx.zoom = zoom
	drawBoats()
	drawNames()
	updateInfo()
end
applyView()

frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	view:resize(frame.AbsoluteSize.X, frame.AbsoluteSize.Y)
	applyView()
end)

-- Sunucu durumu ve değişimler ---------------------------------------------------

local onDelta: (packet: buffer) -> ()

-- Değişen tile'lar repo istemcisi gibi zamana yayılarak uygulanır (Drip: paket içindeki her tick 100 ms arayla gelir,
-- tile'ları 9 kovaya dağılıp 60 Hz'de kova kova belirir). Başlangıç fazında hepsi anında.
local myGained = 0
-- online: harita sunucununkiyle aynı mı (parmak izi; tutmazsa harita baştan istenir)
local mapCheck = if online then require(script.MapCheck).new() else nil
local tileDrip = Drip.new(function(tile: number, owner: number)
	if owner == myPid and myPid ~= 0 then
		myGained += 1
	end
	if mapCheck then
		mapCheck:apply(tile, buffer.readu16(renderer.owner, tile * 2), owner)
	end
	renderer:setOwner(tile, owner)
end)

local function drip(dt: number)
	myGained = 0
	if phase == "spawn" then
		tileDrip:flush() -- repo: başlangıç fazında kovalar anında boşaltılır — sınır bir anda belirir
	else
		tileDrip:step(os.clock(), dt)
	end
	-- toprak büyüme sesi: kazanılan toprak ~10 kez / sn toplu verilir (RoWorld: her değişim paketi), ritmi Sound.pop belirler
	if phase == "run" then
		local acc = ((hud :: any).popAcc or 0) + myGained
		local t = os.clock()
		if t - ((hud :: any).popAt or 0) >= 0.1 then
			(hud :: any).popAt = t
			acc = 0
			local mine = stats[myPid]
			local progress = if mine and mapLand > 0 then mine.tiles / (mapLand * Config.WIN_PERCENT / 100) else 0
			Sound.pop(((hud :: any).popAcc or 0) + myGained, progress)
		end
		;(hud :: any).popAcc = acc
	end
end

local function applyState(state: any)
	if state.round ~= round or state.pid ~= myPid then hud.feed:clear() end
	if state.round ~= round or state.pid ~= myPid or state.phase ~= "run" or state.alive == false then resetInteraction() end
	myPid = state.pid
	renderer.localPid = myPid
	dead = state.alive == false
	myMode = state.mode or (if state.alive then "playing" else "menu")
	round = state.round
	phase = state.phase
	secondsLeft = state.left
	PlayerColors.resetKinds()
	renderer:resetColors()
	local nationNames = state.nations or {} -- (ulus rengi adına göre)
	for pid, kind in state.kinds or {} do
		PlayerColors.setKind(pid, kind, nationNames[pid])
	end
	teamCount = state.teams or 0
	for pid, t in state.teamOf or {} do
		PlayerColors.setTeam(pid, t)
	end
	local tmp = buffer.create(mapW * mapH * 2)
	if not OwnerRuns.decode(state.owners, tmp, mapW * mapH) then
		warn("[Frontline] could not decode full state")
		return
	end
	renderer:clearRails()
	rails:clear()
	railTiles = {}
	for _, t in trains do
		for _, f in t.cars do
			f:Destroy()
		end
	end
	trains = {}
	nukeTargets:clear()
	for _, r in state.rails or {} do
		railTiles[r.id] = r.tiles
		rails:add(r.id, r.tiles, function(t: number): number
			return bit32.band(buffer.readu16(tmp, t * 2), 0x7FFF)
		end)
	end
	tileDrip:clear()
	trails:clear()
	fx:clear()
	infoTarget = 0
	radial:close()
	renderer:loadOwners(tmp)
	if mapCheck then
		mapCheck:load(tmp, mapW * mapH, state.seq)
	end
	lastSeq = state.seq
	stateReady = true
	updateTop()
	local queued = pending
	pending = {}
	for _, p in queued do
		onDelta(p)
	end
	updateInfo()
end

local function resync()
	if resyncing then
		return
	end
	resyncing = true
	stateReady = false
	task.spawn(function()
		local ok, state = pcall(function()
			return getState:InvokeServer()
		end)
		resyncing = false
		if ok and type(state) == "table" then
			applyState(state)
		else
			warn("[Frontline] could not get state: " .. tostring(state))
			task.delay(2, resync)
		end
	end)
end

onDelta = function(packet: buffer)
	if not stateReady then
		table.insert(pending, packet)
		return
	end
	local seq, _, tiles, owners, count, segs = Delta.unpack(packet)
	if not seq or not tiles or not owners or not count then
		return
	end
	if seq <= lastSeq then
		return
	end
	if seq ~= lastSeq + 1 then
		table.insert(pending, packet)
		resync()
		return
	end
	lastSeq = seq
	tileDrip:push(tiles, owners, count, segs, os.clock())
end

-- Bağlantılar önce kurulur, sonra durum istenir: aradaki paketler kuyruğa girer, kaybolmaz.
deltaRemote.OnClientEvent:Connect(onDelta)

-- online maçta listeler yalnız değişenle gelir: burada tam listeye çevrilir (solo'da olduğu gibi geçer)
local netIn = require(Shared:WaitForChild("NetDiff")).inbound()
statsRemote.OnClientEvent:Connect(function(payload: any)
	payload = netIn.stats(payload)
	if type(payload) ~= "table" then
		return
	end
	if mapCheck and payload.sum then
		mapCheck:receive(payload.sum)
	end
	if phase == "spawn" and payload.phase == "run" and myMode == "playing" then
		Sound.play("gameStart")
	end
	if payload.round ~= round then hud.feed:clear() end
	if payload.round ~= round or (payload.phase ~= phase and payload.phase ~= "run") then resetInteraction() end
	phase = payload.phase
	secondsLeft = payload.left
	winnerName = payload.winnerName
	teamCount = payload.teams or 0
	winnerTeam = payload.winnerTeam or 0
	for pid, t in payload.teamOf or {} do
		if PlayerColors.setTeam(pid, t) then
			renderer:recolor(pid)
		end
	end
	if payload.round ~= round then
		round = payload.round
		dead = false
		-- pid yeni turda başka ülkeye geçebilir: isim eski yerinden kayarak gelmesin
		for pid, v in nameViews do
			v.name:Destroy()
			v.troops:Destroy()
			v.icons:Destroy()
			nameViews[pid] = nil
		end
		resync() -- yeni tur: harita sıfırlandı
	end
	-- (yapı kurma / yükseltme sesi burada değil: yalnız oyuncu bir yapıyı koyduğu an, kurma emriyle bir kez çalar)
	structs = payload.structs or {}
	structsAt = os.clock()
	do
		local secs = math.floor((payload.runTicks or 0) / Config.TICK_RATE)
		hud:setMatch(string.format("%02d:%02d", secs // 60, secs % 60))
		;(menuCb :: any).runSecs = (payload.runTicks or 0) / Config.TICK_RATE -- (Client.Analytics: oynanan dakika)
	end
	mirvCost = payload.mirvCost or mirvCost
	-- (bildirim: başkaları arasındaki ihanet, RoWorld "X betrayed Y")
	local oldPairs: { [number]: any } = {}
	for _, al in dip.allies do
		oldPairs[al.a * 65536 + al.b] = al
	end
	local oldAllies: { [number]: boolean } = {}
	for _, al in dip.allies do
		if al.a == myPid then
			oldAllies[al.b] = true
		elseif al.b == myPid then
			oldAllies[al.a] = true
		end
	end
	dip = payload.dip or dip
	if payload.dip and next(oldPairs) then
		local still: { [number]: boolean } = {}
		for _, al in dip.allies do
			still[al.a * 65536 + al.b] = true
		end
		local traitor: { [number]: boolean } = {}
		for _, t in dip.traitors do
			traitor[t.pid] = true
		end
		for k, al in oldPairs do
			if not still[k] and al.a ~= myPid and al.b ~= myPid and (traitor[al.a] or traitor[al.b]) then
				local bad, victim = if traitor[al.a] then al.a else al.b, if traitor[al.a] then al.b else al.a
				hud.feed:push(string.format("%s betrayed %s", names[bad] or "?", names[victim] or "?"), 4, hud.feed.INFO)
			end
		end
	end
	if myPid ~= 0 then
		-- ihanet: müttefikim ittifakı bozdu (artık hain) → kırmızı uyarı (repo AlertFrame "betrayal")
		local nowAllies: { [number]: boolean } = {}
		for _, al in dip.allies do
			if al.a == myPid then
				nowAllies[al.b] = true
			elseif al.b == myPid then
				nowAllies[al.a] = true
			end
		end
		for pid in oldAllies do
			if not nowAllies[pid] then
				for _, t in dip.traitors do
					if t.pid == pid then
						if settings.alerts then
							hud:alert("betrayal")
							Sound.play("allianceBroken")
						end
						hud:toast((names[pid] or "?") .. " broke the alliance and betrayed you!")
					end
				end
			end
		end
	end
	updateRelations()
	-- yeni gelen ittifak isteklerini bir kez haber ver
	local nowReq: { [number]: boolean } = {}
	for _, r in dip.reqs do
		if r.to == myPid then
			nowReq[r.from] = true
			if not seenReq[r.from] then
				-- (yazı yok: sağ üstteki istek kartı Accept / Reject ile zaten görünür; yalnız ses)
				Sound.play("allianceSuggested")
			end
		end
	end
	seenReq = nowReq
	rails:refresh() -- el değiştiren topraktaki raylar yeni sahibinin rengine
	drawStructures()
	table.clear(stats)
	for _, p in payload.players do
		stats[p.pid] = p
		names[p.pid] = p.name
		;(menuCb :: any).cosView:apply(p)
		if PlayerColors.setTeam(p.pid, p.team or 0) then
			renderer:recolor(p.pid) -- (takımı yeni belli oldu: toprağı takım renginde)
		end
	end
	myCosts = if stats[myPid] then (stats[myPid] :: any).costs else nil
	updateStatusIcons()
	drawNames()
	do
		local m = stats[myPid]
		if m then
			-- repo: artış hızı bir öncekinden az değilse yeşil, azalıyorsa (tavana yaklaşınca) turuncu
			rateRising = (m.rate or 0) >= lastRate
			lastRate = m.rate or 0
		end
		-- gelen ittifak istekleri (Kabul / Reddet kartları)
		local rows = {}
		for _, r in dip.reqs do
			if r.to == myPid and myPid ~= 0 then
				table.insert(rows, { from = r.from, name = names[r.from] or "?", left = r.left or 0 })
			end
		end
		hud:setRequests(rows)
	end
	-- Tur sonu kartı (repo WinModal): bu turda oynadıysam bir kez gösterilir; yeni tur başlayınca kendiliğinden kapanır.
	if phase == "ended" and endShownRound ~= round and myMode == "playing" then
		endShownRound = round
		local winner = payload.winner or 0
		local landTotal = math.max(mapLand, 1)
		local mine = stats[myPid]
		local rank, total = 0, 0
		local list: { any } = {}
		for _, p in stats do
			table.insert(list, p)
		end
		table.sort(list, function(a, b)
			return a.tiles > b.tiles
		end)
		for i, p in list do
			total += 1
			if p.pid == myPid then
				rank = i
			end
		end
		-- takım maçında kazanan takımım ise kazandım
		local wTeam = winnerTeam
		local won = if wTeam ~= 0 then wTeam == PlayerColors.teamOf(myPid) else winner ~= 0 and winner == myPid
		local wName = if wTeam ~= 0 then "Team " .. Teams.name(wTeam) else winnerName or "-"
		Sound.play(if won then "victory" else "defeat")
		;(menuCb :: any).roundWon = won -- (Client.Analytics: Match End sonucu)
		-- Maç sonu ekranı (Client.GameOver; RoWorld GameOver): kazananın / kazanan takımın toprağı, süre doldu mu
		do
			local wTiles = 0
			for _, p in stats do
				if (wTeam ~= 0 and p.team == wTeam) or (wTeam == 0 and p.pid == winner) then
					wTiles += p.tiles
				end
			end
			local GO = require(script.GameOver) :: any
			local go = (menu :: any).gameOver
			local wr, wg, wb = PlayerColors.rgb(winner)
			;(menu :: any):showGameOver(GO.endModel({
				won = won,
				dead = dead or mine == nil,
				team = wTeam ~= 0,
				online = online,
				timeUp = online and wTiles * 100 <= landTotal * Config.WIN_PERCENT,
				winnerName = wName,
				winnerColor = Color3.fromRGB(wr, wg, wb),
				pct = wTiles / landTotal * 100,
				killerName = names[(menuCb :: any).hitBy or 0],
				outSecs = (menuCb :: any).deadSecs or (menuCb :: any).runSecs or 0,
				card = if online then nil else go:soloCard((localMatch :: any).medals, myPid),
			}))
			if not online then
				go:soloReport((localMatch :: any).medals, myPid, false)
			end
		end
	elseif phase == "spawn" and menu.open == "end" then
		menu:hide()
	end
	updateTop()
	updateBoard()
	updateInfo()
end)

boatsRemote.OnClientEvent:Connect(function(list)
	list = netIn.boats(list)
	if list == nil then
		return
	end
	nukeTargets:sync(list)
	for _, v in boatViews do
		v.seen = false
	end
	warshipsMine = 0
	for _, b in list do
		if b.k == 3 and b.pid == myPid then
			warshipsMine += 1
		end
		local tx, ty = (b.tile % mapW) + 0.5, (b.tile // mapW) + 0.5
		local v = boatViews[b.id]
		if v then
			v.tx, v.ty, v.seen = tx, ty, true
			v.hp = b.hp or 100
			if v.pid ~= b.pid then
				v.pid = b.pid -- ele geçirilen ticaret gemisi yeni sahibinin rengine döner
				local r, g, bl = PlayerColors.rgb(b.pid)
				v.frame.BackgroundColor3 = Color3.fromRGB(r, g, bl)
				local st = v.frame:FindFirstChild("Stroke") :: UIStroke?
				if st then
					st.Color = if b.pid == myPid then Look.Ship.strokeMine else Look.Ship.strokeOther
				end
			end
		else
			local f = newFrame(7)
			local r, g, bl = PlayerColors.rgb(b.pid)
			f.BackgroundColor3 = Color3.fromRGB(r, g, bl)
			local kind = b.k or 1
			local img = UNIT_IMAGES[kind]
			if kind <= 3 then
				-- gemi: sahibinin renginde yuvarlak, kenarlı; Assets.Units'te görsel varsa ortasında (boşsa düz daire)
				local c = Instance.new("UICorner")
				c.CornerRadius = UDim.new(0.5, 0)
				c.Parent = f
				local st = Instance.new("UIStroke")
				st.Name = "Stroke"
				st.Thickness = Look.Ship.stroke * view.zoom / Look.Ship.strokeZoom
				st.Color = if b.pid == myPid then Look.Ship.strokeMine else Look.Ship.strokeOther
				st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				st.Parent = f
				if img and Assets.has(img) then
					local il = Instance.new("ImageLabel")
					il.Name = "Img"
					il.BackgroundTransparency = 1
					il.AnchorPoint = Vector2.new(0.5, 0.5)
					il.Position = UDim2.fromScale(0.5, 0.5)
					il.Size = UDim2.fromScale(Look.Ship.imageFill, Look.Ship.imageFill)
					il.Image = img
					il.ScaleType = Enum.ScaleType.Fit
					il.ZIndex = 7
					il.Parent = f
				end
			elseif img and Assets.has(img) then
				-- bomba görseli (sahip rengine boyanmaz)
				f.BackgroundTransparency = 1
				local il = Instance.new("ImageLabel")
				il.Name = "Img"
				il.BackgroundTransparency = 1
				il.Size = UDim2.fromScale(1, 1)
				il.Image = img
				il.ScaleType = Enum.ScaleType.Fit
				il.ZIndex = 7
				il.Parent = f
			else
				f.BorderSizePixel = 0
				local st = Instance.new("UIStroke")
				st.Name = "Stroke"
				st.Color = Color3.new(0, 0, 0)
				st.Thickness = view.zoom / Look.Ship.strokeZoom
				st.Parent = f
			end
			if kind == 3 then
				-- can çubuğu (repo BarPass): geminin üstünde
				local bar = Instance.new("Frame")
				bar.Name = "Hp"
				bar.AnchorPoint = Vector2.new(0.5, 1)
				bar.Position = UDim2.new(0.5, 0, 0, -3)
				bar.Size = UDim2.new(1.1, 0, 0, 4)
				bar.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
				bar.BorderSizePixel = 0
				bar.ZIndex = 8
				bar.Parent = f
				local fill = Instance.new("Frame")
				fill.Name = "Fill"
				fill.BorderSizePixel = 0
				fill.Size = UDim2.fromScale(1, 1)
				fill.ZIndex = 8
				fill.Parent = bar
			end
			boatViews[b.id] = { id = b.id, path = nil, pathIdx = 0, pid = b.pid, x = tx, y = ty, tx = tx, ty = ty, frame = f, kind = kind, hp = b.hp or 100, docked = b.st == "docked", lastX = tx, lastY = ty, trail = {}, lastTile = -1, seen = true }
			if b.pid == myPid and myPid ~= 0 then
				if kind == 1 then
					Sound.playOr("transportShip", "orderAck")
				elseif kind == 3 then
					Sound.playOr("buildWarship", "orderAck")
				end
			end
			if kind == 1 then
				local oc = { 71, 133, 181 } -- repo okyanus rengi
				trails:start(b.id, Color3.fromRGB(oc[1] * 0.15 + r * 0.85, oc[2] * 0.15 + g * 0.85, oc[3] * 0.15 + bl * 0.85), tx, ty)
			end
		end
		-- repo AttackRings: yalnız KENDİ nakliye gemilerimin hedefinde işaret
		if b.k == 1 and b.pid == myPid and myPid ~= 0 and type(b.dst) == "number" then
			setBoatTarget(b.id, b.dst)
		elseif boatTargets[b.id] then
			setBoatTarget(b.id, nil)
		end
	end
end)

local SOUND_OF_NOTICE: { [string]: string } = {
	nukeInbound = "nukeWarning",
	hydroInbound = "nukeWarning",
	mirvInbound = "nukeWarning",
	allyNew = "allianceAccepted",
	allyRejected = "allianceDeclined",
	allyBroken = "allianceBroken",
	deleteMarked = "delete",
	eliminated = "defeat",
	noGold = "error",
	notOwned = "error",
	noSpace = "error",
	noTroops = "error",
	noBorder = "error",
	badTarget = "error",
	badTile = "error",
	notLand = "error",
	tooClose = "error",
	noSilo = "error",
	noShore = "error",
	noLanding = "error",
	noRoute = "error",
	noBoats = "error",
	noPortHere = "error",
	nukeOwn = "error",
	nukeAlly = "error",
	donateWait = "error",
	deleteWait = "error",
}

noticeRemote.OnClientEvent:Connect(function(code: string, detail: any)
	local combat = {
		boatInbound = "%s is sending a troop ship to your land.",
		nukeInbound = "%s launched an atom bomb at your land!",
		hydroInbound = "%s launched a hydrogen bomb at your land!",
		mirvInbound = "%s launched a MIRV at your land!",
		warshipLost = "Your warship was destroyed by %s's warship.",
		transportLost = "Your troop ship was destroyed by %s's warship.",
		tradeCaptured = "Your trade ship was captured by %s's warship.",
	}
	if combat[code] then
		local actor = if type(detail) == "table" and type(detail.actorName) == "string" then detail.actorName else "Unknown player"
		hud.feed:push(string.format(combat[code], actor), if code == "boatInbound" then 9 else 12)
		local sound = SOUND_OF_NOTICE[code]
		if sound then Sound.play(sound) end
		return
	end
	-- RoWorld'ün sol alttaki aktışında olup bizde olmayan olaylar (sol üst bildirim aktışı; renk RoWorld kategorisi)
	local F = hud.feed
	local who = if type(detail) == "table" and type(detail.actorName) == "string" then detail.actorName else nil
	local what = if type(detail) == "table" and type(detail.what) == "string" then (BUILD_META[detail.what] and BUILD_META[detail.what].label or detail.what) else "structure"
	if code == "boatLandedOnYou" then
		F:push(string.format("%s landed troops on your coast!", who or "Someone"), 9, F.ALERT)
		Sound.play("notify")
		return
	elseif code == "boatLanded" then
		F:push(if who then string.format("Your transport landed in %s", who) else "Your transport landed", 6.5, F.GOOD)
		return
	elseif code == "boatReturned" then
		F:push("Your transport returned its troops home", 4, F.INFO)
		return
	elseif code == "structCaptured" then
		F:push(string.format("%s captured your %s", who or "Someone", what), 6.5, F.BAD)
		return
	elseif code == "structDestroyed" then
		F:push(string.format("%s destroyed your %s", who or "Someone", what), 6.5, F.BAD)
		return
	elseif code == "warshipKill" then
		F:push(string.format("You sank a warship from %s", who or "?"), 6.5, F.GOOD)
		return
	elseif code == "allyRenewAsk" then
		F:push(string.format("%s wants to renew your alliance", who or "Your ally"), 6.5, F.ALLIANCE)
		return
	elseif code == "allyNoAnswer" then
		F:push(string.format("%s did not answer your alliance request", who or "The player"), 4, F.INFO)
		return
	elseif code == "bigNeighbor" then
		local a = if type(detail) == "table" and type(detail.actor) == "number" then stats[detail.actor] else nil
		local mine = stats[myPid]
		if a and mine and mine.troops > 0 then
			F:push(string.format("%s (%s troops) borders you with %d× your army. Fortify or find allies.", who or a.name, fmtTroops(a.troops), math.floor(a.troops / mine.troops)), 6.5, F.BAD)
		end
		return
	end
	local snd = SOUND_OF_NOTICE[code]
	if snd then
		Sound.play(snd)
	end
	if code == "eliminated" then
		dead = true
		resetInteraction()
		updateTop()
		-- elenme kartı (repo: elenince "izlemeye devam" / ana menü)
		-- elenme ekranı (Client.GameOver): kim eledi, ne zaman; solo maçta tur hemen biter, sonuç tur sonunda bildirilir
		;(menuCb :: any).deadSecs = (menuCb :: any).runSecs or 0
		do
			local go = (menu :: any).gameOver
			;(menu :: any):showGameOver((require(script.GameOver) :: any).endModel({
				eliminated = true,
				online = online,
				killerName = names[(menuCb :: any).hitBy or 0],
				outSecs = (menuCb :: any).deadSecs,
				card = if online then nil else go:soloCard((localMatch :: any).medals, myPid),
			}))
			if not online then
				-- (solo maç oyuncu düşünce bitmez: duraklar (Take Over teklifi / izleme), bu hayatın Medals'ı şimdi)
				localMatch.setRunning(false)
				go:soloReport((localMatch :: any).medals, myPid, false)
			end
		end
	elseif code == "tookOver" then
		-- (Take Over: artık devralınan ulusu yönetiyor; yeni kimlik ve durum sunucudan / maçtan yeniden)
		myMode = "playing"
		dead = false
		resync()
		updateTop()
	elseif code == "joined" then
		myMode = "playing"
		dead = false
		updateTop()
	elseif code == "waiting" then
		myMode = "waiting"
		resetInteraction()
		updateTop()
	end
	if code ~= "joinedAlready" then
		hud:toast(NOTICES[code] or code)
	end
end)

-- Menü olayları
menuCb.onPlay = function()
	-- tutorial maçı (yeni oyuncunun ilk solo maçı): en kolay yapay zekâ, daha az bot, kısa bekleme (Match.setTutorial)
	local S = require(Shared:WaitForChild("Session")) :: any
	if S.tutorial == "pending" and not online then
		S.tutorial = "run" -- (profil maç sırasında geldi; oyuncu sonraki solo maçı kendisi başlattı)
	end
	local tutorialRun = S.tutorial == "run" and not online
	if (localMatch :: any).setTutorial then
		(localMatch :: any).setTutorial(tutorialRun)
	end
	localMatch.setDifficulty(if tutorialRun then "easy" else menu.difficulty)
	;(menuCb :: any).deadSecs = nil
	if not online then
		-- (solo maçın Medals'ı: sunucu gerçek süreyi buradan sayar; Server.Wallet)
		(menu :: any).gameOver:soloStart(if tutorialRun then "tutorial" else menu.difficulty)
		;(menuCb :: any).soloShop:setActive(true)
	end
	-- maç sayısı (ilk maçlarda asker tabanı: Tutorial.floor) ve sunucudaki kayıt
	if (menuCb :: any).tutorial then
		(menuCb :: any).tutorial.matchesBefore = tonumber(Players.LocalPlayer:GetAttribute("FrontlineMatches")) or 0
		;(menuCb :: any).tutorial.floorTold = false
	end
	-- (yeni maç: açık maç biter; sunucu maçı Client.Analytics'in "match_start"ında sayar: Server.Analytics / Profile.countMatch)
	if (menuCb :: any).analytics then
		(menuCb :: any).analytics:replay()
	end
	localMatch.reset() -- menü arkasındaki maç biter, oyuncunun maçı sıfırdan başlar
	intentRemote:FireServer({ type = "join" })
	localMatch.setRunning(true)
	-- (açılıştan sonraki maçlar: tutorial burada başlar; açılıştaki ilk maçta harita hazır olunca aşağıda)
	if tutorialRun and (menuCb :: any).tutorial then
		(menuCb :: any).tutorial:begin()
	end
end
menuCb.onMenu = function()
	if (menuCb :: any).analytics then
		(menuCb :: any).analytics:left() -- ("Left Situation": maç bitmeden ana menüye döndü)
	end
	if not online then
		(menu :: any).gameOver:soloReport((localMatch :: any).medals, myPid, true) -- (bitmeden çıktı; bildirildiyse bir şey yapmaz)
		;(menuCb :: any).soloShop:setActive(false)
	end
	if myMode ~= "menu" then
		intentRemote:FireServer({ type = "menu" })
	end
	myMode = "menu"
	dead = true
	resetInteraction()
	updateTop()
end
-- Ana menüye dönüş: harita bellekten tamamen silinir, istemci baştan kurulur (bir sonraki harita farklı boyutta olabilir).
Online.cleanup = function()
	localMatch.stop()
	for _, image in editables do
		image:Destroy()
	end
end
;(menuCb :: any).reload = function()
	Online.reboot(script)
end
-- Üst bardaki çıkış düğmesi ve oyundan açılan ayarlar: maç durur (oynarken de izlerken / elenmişken de), pencere açılır;
-- Resume / ayarların kapanması devam ettirir.
menuCb.onPause = function(): boolean
	localMatch.setRunning(false)
	return true
end
menuCb.onResume = function()
	localMatch.setRunning(true)
end
menuCb.onSettings = function(st: any)
	for k, v in st do
		(settings :: any)[k] = v
	end
	Sound.enabled = st.sounds ~= false
	require(script.Music).setEnabled(st.menuMusic ~= false, st.gameMusic ~= false)
	for _, s2 in atkSlots do
		s2.label.Visible = settings.attackNumbers
	end
	drawNames()
end

resync()

-- Kurma kuralları (istemci önizlemesi; repo PlayerImpl.buildableUnits / canBuild) ---------------------------------
-- Sunucu aynı kuralları uygular (Sites: yer, Simulation.upgradeTarget: yükseltme, Nuke.readySilo, Warship liman seçimi).
-- Ana betikte 200 yerel değişken sınırı var: kurallar kendi fonksiyonunda, dışarıya Rules tablosuyla açılır.
local Rules = (function()
	local STRUCT_KIND = { city = true, port = true, factory = true, post = true, silo = true, sam = true }
	local UPGRADABLE = { city = true, port = true, factory = true, silo = true, sam = true } -- repo: savunma karakolu yükseltilmez
	local NUKE_KIND = { atom = true, hydro = true, mirv = true }

	-- SAM menzili (sunucudaki formül, repo samRange: 150 - 480 / (seviye + 5)): 70, 81.4, 90, 96.7, 102 ...
	local function samRangeOf(level: number): number
		return Config.SAM_MAX_RANGE - 480 / (level + 5)
	end

	local function buildCost(what: string): number
		if what == "atom" then
			return Config.NUKE_COST_ATOM
		elseif what == "hydro" then
			return Config.NUKE_COST_HYDRO
		elseif what == "mirv" then
			return mirvCost
		end
		return nextCost(what)
	end

	-- (cx, cy) çevresinde `reach` yarıçapındaki TÜM yapıların tile'ları (her oyuncu, inşaattakiler dahil).
	local function nearStructs(cx: number, cy: number, reach: number): { number }
		local out = {}
		local r2 = reach * reach
		for _, st in structs do
			local dx, dy = st.tile % mapW - cx, st.tile // mapW - cy
			if dx * dx + dy * dy <= r2 then
				out[#out + 1] = st.tile
			end
		end
		return out
	end
	-- Kıyı: kara tile'ı ve dört komşusundan biri su (repo isShore)
	local function isShore(t: number): boolean
		if buffer.readu8(terrain, t) == 0 then
			return false
		end
		local x, y = t % mapW, t // mapW
		return (x > 0 and buffer.readu8(terrain, t - 1) == 0)
			or (x < mapW - 1 and buffer.readu8(terrain, t + 1) == 0)
			or (y > 0 and buffer.readu8(terrain, t - mapW) == 0)
			or (y < mapH - 1 and buffer.readu8(terrain, t + mapW) == 0)
	end
	local clientSites: Sites.Map = {
		w = mapW,
		h = mapH,
		owner = function(t: number): number
			return renderer:ownerAt(t)
		end,
		isShore = isShore,
		structures = nearStructs,
	}

	-- Su bileşenleri (savaş gemisi: bu denizde limanım var mı) harita yüklendikten sonra kare kare hesaplanır.
	local waterComp = WaterComp.new(terrain, mapW, mapH)

	-- Repo findExistingUnitToUpgrade: tıklanana 15 tile içindeki aynı türden en yakın yapı (kimin olursa olsun).
	local function closestOfType(what: string, tile: number): any?
		local tx, ty = tile % mapW, tile // mapW
		local best, bestD = nil, Config.STRUCTURE_MIN_DIST ^ 2 + 1
		for _, st in structs do
			if st.type == what then
				local dx, dy = st.tile % mapW - tx, st.tile // mapW - ty
				local d = dx * dx + dy * dy
				if d < bestD then
					best, bestD = st, d
				end
			end
		end
		return best
	end

	-- Repo nukeSpawn: en yakın (manhattan) hazır silo — inşaatı bitmiş ve boş füze yuvası olan.
	local function nukeSilo(tile: number): any?
		local tx, ty = tile % mapW, tile // mapW
		local best, bestD = nil, math.huge
		for _, st in structs do
			if st.pid == myPid and st.type == "silo" and st.ready and (st.q or 0) < st.level then
				local d = math.abs(st.tile % mapW - tx) + math.abs(st.tile // mapW - ty)
				if d < bestD then
					best, bestD = st, d
				end
			end
		end
		return best
	end

	-- Repo warshipSpawn: tıklanan su; o denize açılan en yakın hazır kendi limanım (su bileşeni henüz hesaplanmadıysa
	-- herhangi bir hazır liman).
	local function warshipPort(tile: number): number?
		if buffer.readu8(terrain, tile) ~= 0 then
			return nil
		end
		local comp = waterComp:of(tile)
		local tx, ty = tile % mapW, tile // mapW
		local best, bestD = nil, math.huge
		for _, st in structs do
			if st.pid == myPid and st.type == "port" and st.ready and (comp == nil or waterComp:touches(st.tile, comp)) then
				local d = math.abs(st.tile % mapW - tx) + math.abs(st.tile // mapW - ty)
				if d < bestD then
					best, bestD = st.tile, d
				end
			end
		end
		return best
	end

	-- Repo wouldNukeBreakAlliance: patlama alanında müttefikin bir yapısı varsa ya da müttefikin ağırlıklı tile sayısı
	-- (iç yarıçap 1, dış 0.5) eşiği aşıyorsa ittifak bozulur -> önizleme dairesi kırmızı.
	local function nukeBreaksAlliance(tile: number, what: string): boolean
		local allies: { [number]: boolean } = {}
		local any = false
		for _, al in dip.allies do
			if al.a == myPid then
				allies[al.b] = true
				any = true
			elseif al.b == myPid then
				allies[al.a] = true
				any = true
			end
		end
		if not any then
			return false
		end
		local mag = if what == "hydro" then Config.NUKE_HYDRO else Config.NUKE_ATOM
		local inner, outer = mag[1], mag[2]
		local cx, cy = tile % mapW, tile // mapW
		local o2, i2 = outer * outer, inner * inner
		for _, st in structs do
			if allies[st.pid] then
				local dx, dy = st.tile % mapW - cx, st.tile // mapW - cy
				if dx * dx + dy * dy <= o2 then
					return true
				end
			end
		end
		local counts: { [number]: number } = {}
		for y = math.max(0, cy - outer), math.min(mapH - 1, cy + outer) do
			local dy2 = (y - cy) * (y - cy)
			for x = math.max(0, cx - outer), math.min(mapW - 1, cx + outer) do
				local d2 = (x - cx) * (x - cx) + dy2
				if d2 <= o2 then
					local o = renderer:ownerAt(y * mapW + x)
					if o ~= 0 and allies[o] then
						local c = (counts[o] or 0) + (if d2 <= i2 then 1 else 0.5)
						counts[o] = c
						if c > Config.NUKE_ALLIANCE_THRESHOLD then
							return true
						end
					end
				end
			end
		end
		return false
	end

	-- Önizleme / tık için sonuç (repo BuildableUnit): canBuild = kurulacak tile (bomba: silo, gemi: liman), up = yükseltilecek
	-- yapı (öncelikli), warn = bomba ittifak bozar, reason = neden kurulamıyor (toast için).
	type GhostCalc = { canBuild: number?, up: any?, cost: number, afford: boolean, warn: boolean, reason: string? }
	local ghostMemo: { key: string, at: number, val: GhostCalc? } = { key = "", at = -1, val = nil }
	local function ghostCalc(what: string, tile: number, fresh: boolean?): GhostCalc
		local now = os.clock()
		local key = what .. ":" .. tile
		local memo = ghostMemo.val
		-- repo: en çok 50 ms'de bir yeniden sorgu; burada aynı tile için 0.1 sn önbellek
		if not fresh and memo and ghostMemo.key == key and now - ghostMemo.at < 0.1 then
			return memo
		end
		local mine = stats[myPid]
		local gold = if mine then mine.gold else 0
		local cost = buildCost(what)
		local res: GhostCalc = { canBuild = nil, up = nil, cost = cost, afford = gold >= cost, warn = false, reason = nil }
		if not mine or dead or phase ~= "run" then
			res.reason = "notStarted"
		elseif not res.afford then
			res.reason = "noGold" -- repo canBuildUnitType: altın yetmezse ne kurulur ne yükseltilir
		elseif STRUCT_KIND[what] then
			if UPGRADABLE[what] then
				local ex = closestOfType(what, tile)
				if ex and ex.pid == myPid and ex.ready and ex.bar ~= "delete" then
					res.up = ex
				end
			end
			local site = if what == "port"
				then Sites.port(clientSites, myPid, tile, Config.STRUCTURE_MIN_DIST)
				else Sites.structure(clientSites, myPid, tile, Config.STRUCTURE_MIN_DIST)
			res.canBuild = site
			if not site and not res.up then
				res.reason = if renderer:ownerAt(tile) ~= myPid then "notOwned" elseif what == "port" then "portShore" else "noSpace"
			end
		elseif what == "warship" then
			res.canBuild = warshipPort(tile)
			if not res.canBuild then
				res.reason = if buffer.readu8(terrain, tile) ~= 0 then "warshipWater" else "noPort"
			end
		elseif NUKE_KIND[what] then
			if what == "mirv" and renderer:ownerAt(tile) == 0 then
				res.reason = "mirvTarget"
			else
				local silo = nukeSilo(tile)
				res.canBuild = if silo then silo.tile else nil
				if not silo then
					res.reason = "noSilo"
				elseif what ~= "mirv" then
					res.warn = nukeBreaksAlliance(tile, what)
				end
			end
		end
		ghostMemo.key, ghostMemo.at, ghostMemo.val = key, now, res
		return res
	end

	-- Kurma nedeni yazıları (önizleme kırmızıyken tıklanırsa ya da sağ tık menüsünden)
	local REASON: { [string]: string } = {
		notStarted = "The game hasn't started yet.",
		noGold = "Not enough gold.",
		notOwned = "You can only build on your own land.",
		noSpace = "No room here: must be at least 15 tiles from nearby structures.",
		portShore = "No suitable shore nearby: ports are built on your own shore.",
		warshipWater = "Warships are placed on water.",
		noPort = "You have no ready port in this sea.",
		mirvTarget = "A MIRV can only target a player's land.",
		noSilo = "No ready silo (build a silo or wait for a missile slot to refill).",
	}

	-- Repo: yapı düğmesi yalnız kurulabilecekse seçilir (altın yetiyor; bombada silo, savaş gemisinde liman var).
	local function hasOwn(kind: string): boolean
		for _, st in structs do
			if st.pid == myPid and st.type == kind then
				return true
			end
		end
		return false
	end
	canSelect = function(id: string): boolean
		local mine = stats[myPid]
		if not mine or (mine.gold or 0) < buildCost(id) then
			return false
		end
		if NUKE_KIND[id] then
			return nukeSilo(0) ~= nil -- hazır ve boş füze yuvası olan kendi silom
		elseif id == "warship" then
			return hasOwn("port")
		end
		return true
	end

	return {
		STRUCT_KIND = STRUCT_KIND,
		NUKE_KIND = NUKE_KIND,
		samRangeOf = samRangeOf,
		buildCost = buildCost,
		waterComp = waterComp,
		nukeSilo = nukeSilo,
		ghostCalc = ghostCalc,
		REASON = REASON,
	}
end)()

-- Girdi, önizleme ve kare döngüsü kendi fonksiyonunda: Luau bir fonksiyonda en çok 200 yerel değişkene izin verir;
-- ana betik bu sınıra yaklaşmıştı (Roblox "Out of local registers" derleme hatası verir).
;(function()
	-- Girdi ---------------------------------------------------------------------------

	local buildAt: (what: string, gx: number, gy: number) -> ()
	local nukeConfirm: { what: string, tile: number, round: number, pid: number }? = nil

	-- true: gönderildi; nil: ilk bomba tıklaması, onay bekleniyor; false: geçersiz.
	local function confirmBuild(what: string, tile: number, explain: boolean): boolean?
		-- Validate and fire at the armed center, even if the confirming click is on water.
		local armed = nukeConfirm
		if armed and armed.what == what and armed.round == round and armed.pid == myPid then
			local r = if what == "atom" then Config.NUKE_ATOM[2] elseif what == "hydro" then Config.NUKE_HYDRO[2] else Config.MIRV_RANGE
			local dx, dy = tile % mapW - armed.tile % mapW, tile // mapW - armed.tile // mapW
			if dx * dx + dy * dy <= r * r then tile = armed.tile end
		end
		local g = Rules.ghostCalc(what, tile, true)
		if g.up then
			intentRemote:FireServer({ type = "upgrade", tile = g.up.tile, what = what })
			Sound.play("upgrade") -- (yükseltme sesi: yalnız emrin verildiği an)
			return true
		elseif g.canBuild then
			if Rules.NUKE_KIND[what] then
				local armed = nukeConfirm
				if not armed or armed.what ~= what or armed.tile ~= tile or armed.round ~= round or armed.pid ~= myPid then
					nukeConfirm = { what = what, tile = tile, round = round, pid = myPid }
					buildMode = what -- sağ tık menüsünden seçilince de hedef onayı açık kalır
					return nil
				end
				nukeConfirm = nil
				intentRemote:FireServer({ type = "nuke", what = what, tile = tile })
				buildMode = nil
			elseif what == "warship" then
				intentRemote:FireServer({ type = "warship", tile = tile })
			else
				intentRemote:FireServer({ type = "build", what = what, tile = tile })
				-- (kurma sesi: yalnız oyuncu yapıyı koyduğu ilk an; inşaat bitince ya da fethedilen yapıda çalmaz)
				Sound.play(({ city = "buildCity", port = "buildPort", factory = "buildFactory", post = "buildPost", sam = "buildSam", silo = "buildSilo" } :: any)[what] or "buildCity")
				if what == "city" and (menuCb :: any).coach then
					(menuCb :: any).coach:complete("city")
				end
			end
			return true
		end
		if Rules.NUKE_KIND[what] then nukeConfirm = nil end
		if explain then
			hud:toast(Rules.REASON[g.reason or ""] or "Can't build here.")
			Sound.play("error")
		end
		return false
	end

	-- Taşıma hedefinde kısa süre beliren halka (repo MoveIndicatorPass)
	local function moveMarker(x: number, y: number)
		local f = Instance.new("Frame")
		f.Name = "MoveTarget"
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BackgroundTransparency = 1
		f.Position = world:at(x, y)
		f.Size = world:size(8, 8)
		f.ZIndex = 15
		f.Parent = world.over
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = f
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(253, 224, 71)
		st.Thickness = 2
		st.Parent = f
		local TweenService = game:GetService("TweenService")
		local tw = TweenService:Create(st, TweenInfo.new(0.8), { Transparency = 1 })
		TweenService:Create(f, TweenInfo.new(0.8), { Size = world:size(2, 2) }):Play()
		tw:Play()
		tw.Completed:Connect(function()
			f:Destroy()
		end)
	end

	-- Saldırı / genişleme / gemi onayı: tıklanan yerin biraz üstünde kısa yazı (RoWorld FloatText; üst barın altında, alt barın
	-- üstünde kalır). fx, fy harita çerçevesine göre (gx / mouseX gibi).
	local FloatText = require(script.FloatText)
	FloatText.bounds = function()
		local g = hudGui.AbsolutePosition
		local top = if hud.top.Visible then hud.top.AbsolutePosition.Y + hud.top.AbsoluteSize.Y else g.Y
		local bottom = if hud.bottom.Visible then hud.bottom.AbsolutePosition.Y else g.Y + hudGui.AbsoluteSize.Y
		return g.X, top, g.X + hudGui.AbsoluteSize.X, bottom
	end
	-- Yeni oyuncunun tutorial'ı (Client.Tutorial; maç hazır olunca aşağıda kurulur) ve gönderilecek oran: tutorial / ilk
	-- maçlarda ordunun bir payı evde kalır (RoWorld troop floor). orderRatio nil = emir gönderilmez (asker çok az).
	local tutorial: any = nil
	local function orderRatio(): number?
		local mine = stats[myPid]
		local keep = if tutorial and mine then tutorial:floor(mine) else 0
		if keep <= 0 or not mine or mine.troops <= 0 then
			return ratio
		end
		local allowed = (mine.troops - keep * mine.max) / mine.troops
		if allowed >= ratio then
			return ratio
		end
		if allowed < 0.01 then
			Sound.play("error")
			hud:toast(tutorial.FLOOR_REASON)
			return nil
		end
		tutorial:floorUsed()
		return math.floor(allowed * 100) / 100
	end
	local function floatAttack(boat: boolean, owner: number, fx: number, fy: number, r: number?)
		if owner ~= 0 and (relationWith(owner).allied or relationWith(owner).teammate) then
			return -- (sunucu reddeder, kendi uyarısı çıkar)
		end
		if tutorial then
			tutorial:onOrder(owner, boat)
		end
		if (menuCb :: any).analytics then
			(menuCb :: any).analytics:onOrder() -- (ilk saldırı / boşta mı)
		end
		if (menuCb :: any).coach then
			(menuCb :: any).coach:onOrder(owner, boat) -- (Coach: expand / contact / select / boat ipucu yapıldı)
		end
		local mine = stats[myPid]
		local troops = fmtTroops(math.floor((if mine then mine.troops else 0) * (r or ratio)))
		local who = if owner ~= 0 and stats[owner] then stats[owner].name else nil
		local x, y = frame.AbsolutePosition.X + fx, frame.AbsolutePosition.Y + fy
		if boat then
			FloatText.spawn(hudGui, x, y, if who then string.format("Invading %s by sea with %s", who, troops) else "Boat launched with " .. troops, "⛵", FloatText.CYAN)
		elseif owner == 0 then
			FloatText.spawn(hudGui, x, y, "Expanding with " .. troops, "⚔", FloatText.GREEN)
		else
			FloatText.spawn(hudGui, x, y, string.format("Attacking %s with %s", who or "?", troops), "⚔", FloatText.AMBER)
		end
	end

	-- Başlangıç fazında tık = spawn seç. Oyun başlayınca tık = o tile'ın sahibine (sahipsizse 0) saldır.
	local function sendSpawn(gx: number, gy: number)
		if dead then
			return
		end
		if overUiByMove or hud:overPanel(frame.AbsolutePosition.X + gx, frame.AbsolutePosition.Y + gy) or menu:blocks(frame.AbsolutePosition.X + gx, frame.AbsolutePosition.Y + gy) or radial:blocks() then
			return -- panel düğmesine tıklandı: haritaya saldırı/yerleşme gitmesin
		end
		local tx, ty = view:screenToTile(gx, gy)
		if not (tx and ty) then
			return
		end
		local tile = ty * mapW + tx
		if phase == "spawn" then
			intentRemote:FireServer({ type = "spawn", tile = tile })
			-- halka yalnız yerleşilebilecek yerde (sahipsiz kara; sunucudaki Spawn kuralı): denize / sahipli yere tıklayınca
			-- yalnız uyarı çıkar, halka önceki yerinde kalır
			if buffer.readu8(terrain, tile) ~= 0 and renderer:ownerAt(tile) == 0 then
				Sound.play("spawn")
				spawnPulseAt(tile)
			end
			return
		end
		if phase ~= "run" or myMode ~= "playing" then return end
		if buildMode then
			-- Bomba: ilk tıklama hedef, daire içindeki ikinci tıklama sabit hedefe atış. Gönderince tüm kurma modları kapanır.
			local what = buildMode
			local result = confirmBuild(what, tile, false)
			if result then
				buildMode = nil
			elseif result == false then
				Sound.play("error")
			end
			updateInfo()
			return
		end
		-- Savaş gemisi seçme / taşıma (repo WarshipSelectionController): kendi gemine tıkla -> seçilir, sonra suya tıkla -> oraya gider.
		do
			local pick, pickD = nil, math.huge
			local reach = math.max(12, view.zoom * 3)
			for _, v in boatViews do
				if v.kind == 3 and v.pid == myPid then
					local sx, sy = view.x + v.x * view.zoom, view.y + v.y * view.zoom
					local d = math.sqrt((sx - gx) ^ 2 + (sy - gy) ^ 2)
					if d < reach and d < pickD then
						pick, pickD = v.id, d
					end
				end
			end
			if pick then
				selectedWarship = if selectedWarship == pick then nil else pick
				hud:toast(if selectedWarship then "Warship selected: click the water you want it to go to (right-click: cancel)" else "Selection cleared")
				return
			end
			if selectedWarship then
				local id = selectedWarship
				selectedWarship = nil
				if buffer.readu8(terrain, tile) == 0 then
					intentRemote:FireServer({ type = "warshipMove", ids = { id }, tile = tile })
					moveMarker(tx + 0.5, ty + 0.5)
					return
				end
			end
		end
		if buffer.readu8(terrain, tile) == 0 then
			return
		end
		local owner = renderer:ownerAt(tile)
		if owner == myPid then
			return
		end
		local r = orderRatio()
		if not r then
			return
		end
		lastOwner = owner
		floatAttack(false, owner, gx, gy, r)
		intentRemote:FireServer({ type = "attack", target = owner, ratio = r, tile = tile })
		Sound.playOr("attack", "orderAck")
	end

	buildAt = function(what: string, gx: number, gy: number)
		if dead or phase ~= "run" then
			return
		end
		local tx, ty = view:screenToTile(gx, gy)
		if not (tx and ty) then
			return
		end
		confirmBuild(what, ty * mapW + tx, true)
		updateInfo()
	end

	-- Diplomasi: hedef, fare altındaki oyuncu (dokunmatikte son dokunulan). Y/N için hedef yoksa bekleyen isteğin sahibi.
	local function targetOwner(): number
		if mouseX and mouseY then
			local tx, ty = view:screenToTile(mouseX, mouseY)
			if tx and ty then
				local o = renderer:ownerAt(ty * mapW + tx)
				if o ~= 0 then
					return o
				end
			end
		end
		return lastOwner
	end

	local function diploAction(kind: string, explicit: number?)
		if dead or phase ~= "run" then
			return
		end
		local target = if explicit and explicit ~= 0 then explicit else targetOwner()
		if kind == "allyAccept" or kind == "allyReject" then
			-- hedef bir isteğin sahibi değilse, bekleyen ilk isteği al
			local ok = false
			for _, r in dip.reqs do
				if r.to == myPid and r.from == target then
					ok = true
				end
			end
			if not ok then
				for _, r in dip.reqs do
					if r.to == myPid then
						target = r.from
						break
					end
				end
			end
		end
		if target == 0 or target == myPid then
			hud:toast("Point at a player's land on the map first.")
			return
		end
		if kind == "embargo" then
			local on = true
			for _, e in dip.embargo do
				if e.from == myPid and e.to == target then
					on = false
				end
			end
			intentRemote:FireServer({ type = "embargo", target = target, on = on })
			return
		end
		if kind == "extendAlly" then
			-- hedef müttefik değilse, yenileme penceresindeki herhangi bir müttefik
			intentRemote:FireServer({ type = kind, target = target })
			return
		end
		intentRemote:FireServer({ type = kind, target = target })
	end

	-- Repo ControlPanel AttackRatioEvent: %1..%100; %1'den +10 basınca %11 değil %10 olur.
	local function changeRatio(delta: number)
		local old = ratio
		local new = math.clamp(math.floor((ratio + delta) * 100 + 0.5) / 100, 0.01, 1)
		if math.abs(new - 0.11) < 1e-6 and math.abs(old - 0.01) < 1e-6 then
			new = 0.1
		end
		if tutorial and tutorial.active then
			new = math.min(new, tutorial.RATIO_CAP) -- (tutorial sürerken saldırı çubuğu %50'de durur)
		end
		if new ~= old then
			Sound.play("slider")
			if (menuCb :: any).coach then
				(menuCb :: any).coach:complete("ratio")
			end
		end
		ratio = new
		updateInfo()
	end

	-- HUD düğmeleri: yapı düğmesi = kurma modu (haritaya tıkla); aynı düğmeye tekrar = iptal.
	hudCb.onBuild = function(id: string)
		if phase ~= "run" or dead then
			return
		end
		nukeConfirm = nil
		if buildMode == id then
			buildMode = nil
		elseif canSelect(id) then
			buildMode = id
		else
			Sound.play("error")
			local mine = stats[myPid]
			hud:toast(if mine == nil or mine.gold < Rules.buildCost(id) then Rules.REASON.noGold elseif id == "warship" then "Build a port first." else Rules.REASON.noSilo)
		end
		updateInfo()
	end
	hudCb.onHoverBuild = function(id: string?)
		hoverBuild = id
	end
	hudCb.onRatio = function(r: number)
		if math.abs(r - ratio) >= 0.01 then
			Sound.play("slider")
			if (menuCb :: any).coach then
				(menuCb :: any).coach:complete("ratio")
			end
		end
		ratio = math.clamp(math.floor(r * 100 + 0.5) / 100, 0.01, if tutorial and tutorial.active then tutorial.RATIO_CAP else 1)
		updateInfo()
	end
	hudCb.onDiplo = function(kind: string)
		if kind == "close" then
			infoTarget = 0
			updateInfo()
			return
		end
		if kind == "donateTroops" or kind == "donateGold" then
			if diploTarget ~= 0 then
				intentRemote:FireServer({ type = "donate", target = diploTarget, what = if kind == "donateGold" then "gold" else "troops", ratio = ratio })
			end
			return
		end
		diploAction(kind, diploTarget)
	end
	hudCb.onRequest = function(from: number, accept: boolean)
		intentRemote:FireServer({ type = if accept then "allyAccept" else "allyReject", target = from })
	end

	-- Sağ tık / dokunma menüsü (repo RadialMenuElements.rootMenuElement) ------------------------------------
	local RCOL = {
		info = Color3.fromRGB(71, 85, 105),
		attack = Color3.fromRGB(239, 68, 68),
		boat = Color3.fromRGB(42, 130, 201),
		ally = Color3.fromRGB(74, 222, 128),
		breakAlly = Color3.new(1, 1, 1), -- kırık kalp (kırmızı) ayırt edilsin diye beyaz
		build = Color3.fromRGB(230, 199, 74),
		building = Color3.fromRGB(30, 58, 95),
		delete = Color3.fromRGB(239, 68, 68),
		gold = Color3.fromRGB(245, 158, 11),
		center = Color3.fromRGB(30, 41, 59),
	}

	local function ritem(id: string, label: string, color: Color3, enabled: boolean, action: (() -> ())?, sub: (() -> { Radial.Item })?, detail: string?): Radial.Item
		return {
			id = id,
			label = label,
			-- (ilk dolu olan: sağ tık menüsü görseli, alt bar görseli (bombalar), yapı / birim görseli; hiçbiri yoksa emoji)
			icon = (function(): string?
				for _, t in { Assets.Radial, Assets.BuildBar, Assets.Structures, Assets.Units } do
					local v = (t :: any)[id]
					if Assets.has(v) then
						return v
					end
				end
				return nil
			end)(),
			fallback = (Assets.Fallback.Radial :: any)[id] or (Assets.Fallback.Structures :: any)[id],
			color = color,
			enabled = enabled,
			detail = detail,
			action = action,
			sub = sub,
		}
	end

	local function openRadialAt(gx: number, gy: number)
		if menu:isOpen() then
			return
		end
		local tx, ty = view:screenToTile(gx, gy)
		if not (tx and ty) then
			return
		end
		local tile = ty * mapW + tx
		local land = buffer.readu8(terrain, tile) ~= 0
		local owner = renderer:ownerAt(tile)
		local mine = stats[myPid]
		local gold = if mine then mine.gold else 0
		local playing = not dead and myMode == "playing"
		local running = phase == "run" and playing
		local ax, ay = frame.AbsolutePosition.X + gx, frame.AbsolutePosition.Y + gy

		-- başlangıç fazı: yalnız "buraya yerleş"
		if phase == "spawn" then
			if not playing then
				return
			end
			radial:open(ax, ay, {
				slots = {
					ritem("info", "Info", RCOL.info, false),
					ritem("boat", "Boat", RCOL.boat, false),
					ritem("ally", "Alliance", RCOL.ally, false),
					ritem("attack", "Settle here", RCOL.attack, land and owner == 0, function()
						intentRemote:FireServer({ type = "spawn", tile = tile })
			Sound.play("spawn")
			spawnPulseAt(tile)
					end),
				},
			})
			return
		end

		local info = ritem("info", "Info", RCOL.info, owner ~= 0, function()
			infoTarget = owner
			updateInfo()
		end)

		local function structureItems(): { Radial.Item }
			local list = {}
			for _, id in { "city", "factory", "port", "post", "silo", "sam" } do
				local cost = nextCost(id)
				local n = 0
				for _, st in structs do
					if st.pid == myPid and st.type == id then
						n += 1
					end
				end
				local meta = BUILD_META[id]
				table.insert(list, ritem(id, meta.label, RCOL.building, running and gold >= cost, function()
					buildAt(id, gx, gy)
				end, nil, fmtGold(cost) .. " gold" .. (if n > 0 then "  ·  " .. n .. " owned" else "")))
			end
			return list
		end

		local function attackItems(): { Radial.Item }
			local slots = readySlots()
			local list = {}
			table.insert(list, ritem("attack", "Attack", RCOL.attack, running and land and owner ~= myPid, function()
				local r = orderRatio()
				if not r then
					return
				end
				lastOwner = owner
				floatAttack(false, owner, gx, gy, r)
				intentRemote:FireServer({ type = "attack", target = owner, ratio = r, tile = tile })
				Sound.playOr("attack", "orderAck")
			end, nil, math.floor(ratio * 100) .. "% troops"))
			for _, id in { "atom", "hydro" } do
				local cost = if id == "atom" then Config.NUKE_COST_ATOM else Config.NUKE_COST_HYDRO
				table.insert(list, ritem(id, BUILD_META[id].label, RCOL.attack, running and gold >= cost and slots > 0, function()
					buildAt(id, gx, gy)
				end, nil, fmtGold(cost) .. " gold · ready missiles " .. slots))
			end
			table.insert(list, ritem("mirv", "MIRV (350 warheads)", RCOL.attack, running and gold >= mirvCost and slots > 0 and owner ~= 0, function()
				buildAt("mirv", gx, gy)
			end, nil, fmtGold(mirvCost) .. " gold · player land only"))
			local wcost = nextCost("warship")
			table.insert(list, ritem("warship", "Warship", RCOL.boat, running and gold >= wcost, function()
				buildAt("warship", gx, gy)
			end, nil, fmtGold(wcost) .. " gold"))
			return list
		end

		if owner == myPid then
			-- kendi toprağım: bilgi · yapı sil · (ittifak kapalı) · yapı menüsü
			local nearMine = false
			for _, st in structs do
				if st.pid == myPid and st.ready then
					local d = math.abs(st.tile % mapW - tx) + math.abs(st.tile // mapW - ty)
					if d <= 5 then
						nearMine = true
					end
				end
			end
			radial:open(ax, ay, {
				slots = {
					info,
					ritem("delete", "Delete structure", RCOL.delete, running and nearMine, function()
						intentRemote:FireServer({ type = "delete", tile = tile })
					end, nil, "Demolished in 30s"),
					ritem("ally", "Alliance", RCOL.ally, false),
					ritem("build", "Build", RCOL.build, running, nil, structureItems),
				},
			})
			return
		end

		local rel = if owner ~= 0 then relationWith(owner) else nil
		local isBot = owner ~= 0 and PlayerColors.kindOf(owner) == 2
		local allied = rel ~= nil and rel.allied
		local inExtend = allied and rel ~= nil and rel.allyLeft ~= nil and (rel.allyLeft :: number) <= 300
		local teammate = rel ~= nil and rel.teammate
		local right: Radial.Item
		if teammate then
			right = ritem("boat", "Attack by boat", RCOL.boat, false, nil, nil, "Teammate")
		elseif allied then
			right = ritem("breakAlly", "Break alliance", RCOL.breakAlly, running, function()
				diploAction("breakAlly", owner)
			end)
		else
			right = ritem("boat", "Attack by boat", RCOL.boat, running and land, function()
				local r = orderRatio()
				if not r then
					return
				end
				floatAttack(true, owner, gx, gy, r)
				intentRemote:FireServer({ type = "boat", tile = tile, ratio = r })
			end, nil, math.floor(ratio * 100) .. "% troops")
		end
		local bottom: Radial.Item
		if inExtend then
			bottom = ritem("ally", "Renew alliance", RCOL.ally, running, function()
				diploAction("extendAlly", owner)
			end)
		elseif rel and rel.reqFrom then
			bottom = ritem("ally", "Accept alliance", RCOL.ally, running, function()
				diploAction("allyAccept", owner)
			end)
		else
			bottom = ritem("ally", "Request alliance", RCOL.ally, running and owner ~= 0 and not isBot and not allied and not (rel and rel.reqTo), function()
				diploAction("ally", owner)
			end, nil, if isBot then "Can't ally with bots" elseif teammate then "Teammate" else nil)
		end
		local left: Radial.Item
		if allied then
			left = ritem("donateTroops", "Send support", RCOL.ally, running, nil, function(): { Radial.Item }
				return {
					ritem("donateTroops", "Send troops", RCOL.ally, running, function()
						intentRemote:FireServer({ type = "donate", target = owner, what = "troops", ratio = ratio })
					end, nil, math.floor(ratio * 100) .. "% of your troops"),
					ritem("donateGold", "Send gold", RCOL.gold, running, function()
						intentRemote:FireServer({ type = "donate", target = owner, what = "gold", ratio = ratio })
					end, nil, math.floor(ratio * 100) .. "% of your gold"),
				}
			end)
		else
			left = ritem("attack", "Attack", RCOL.attack, running, nil, attackItems)
		end
		radial:open(ax, ay, { slots = { info, right, bottom, left } })
	end
	hudCb.onCancel = function(target: number)
		intentRemote:FireServer({ type = "cancel", target = target })
	end
	-- Mobil hedef kartı: Attack = seçili oranla saldır (PC'deki sol tıkla aynı), More = o yerde sağ tık menüsü
	hudCb.onCard = function(kind: string)
		local tile = cardTile
		if kind == "close" or tile == nil then
			cardTile = nil
			hud:setTarget(nil)
			return
		end
		local t = tile :: number
		local owner = renderer:ownerAt(t)
		if kind == "attack" then
			if phase == "run" and not dead and owner ~= myPid and not (owner ~= 0 and relationWith(owner).allied) then
				local r = orderRatio()
				if not r then
					return
				end
				lastOwner = owner
				floatAttack(false, owner, view.x + (t % mapW + 0.5) * view.zoom, view.y + (t // mapW + 0.5) * view.zoom, r)
				intentRemote:FireServer({ type = "attack", target = owner, ratio = r, tile = t })
				Sound.playOr("attack", "orderAck")
				-- her saldırı için hedefe yeniden dokunulur
				cardTile = nil
				hud:setTarget(nil)
			end
		elseif kind == "more" then
			cardTile = nil
			hud:setTarget(nil)
			openRadialAt(view.x + (t % mapW + 0.5) * view.zoom, view.y + (t // mapW + 0.5) * view.zoom)
		end
	end
	-- Mobil kurma onayı: OK = dokunulan yere kur / bombayı at, X = kurma modunu iptal et
	hudCb.onBuildConfirm = function(ok: boolean)
		local pick = touchPick
		touchPick = nil
		hud:setBuildConfirm(nil)
		if not ok or not pick then
			nukeConfirm = nil
			buildMode = nil
			updateInfo()
			return
		end
		local tx, ty = view:screenToTile(pick.sx, pick.sy) -- ekrandaki sabit noktanın o anki altındaki tile
		if not tx or not ty then
			return
		end
		local tile = ty * mapW + tx
		local res = confirmBuild(pick.what, tile, true)
		if res == nil then
			res = confirmBuild(pick.what, tile, true) -- bomba: bu pencere PC'deki ikinci (hedef onayı) tıklamasının yerini tutar
		end
		if res then
			buildMode = nil
		else
			touchPick = pick -- kurulamadı (neden toast'ta): seçim kalır, başka yere dokunulabilir
		end
		updateInfo()
	end

	-- Kamera odak (alttaki isim alanı / C): kendi toprağına yumuşak geçiş (CameraFocus, Look.Camera).
	local camAnim: CameraFocus.Anim? = nil
	-- Turun ilk otomatik odağı: başladığı an süren kaydırma / yakınlaştırma 0,75 sn kamerayı oynatmaz (odak kesilmesin);
	-- sonrasında oyuncu isterse odak yarıda kesilebilir.
	local camLockUntil = 0
	local function camLocked(): boolean
		return os.clock() < camLockUntil
	end
	local autoFocusRound: number? = nil
	local function focusMe(silent: boolean?): boolean
		if myPid == 0 or dead then
			return false
		end
		local n, minX, minY, maxX, maxY, cx, cy = renderer:extentOf(myPid)
		if not n then
			if not silent then hud:toast("You have no land yet.") end
			return false
		end
		local wx, wy, z = CameraFocus.target(Look.Camera, minX, minY, maxX, maxY, cx, cy, view.viewW, view.viewH)
		z = math.clamp(z, view.minZoom, view.maxZoom)
		local x0, y0 = view:center()
		camAnim = CameraFocus.start(os.clock(), Look.Camera, x0, y0, view.zoom, wx, wy, z)
		return true
	end
	hudCb.onFocus = function()
		focusMe()
	end

	-- Yumuşak zoom: tekerlek hedef zoom'u değiştirir, her karede imleç altındaki nokta sabit kalacak şekilde yaklaşılır.
	local targetZoom = 0
	local zoomAnchorX = 0
	local zoomAnchorY = 0

	local function zoomAtCenter(newZoom: number)
		if camLocked() then
			return
		end
		targetZoom = 0
		camAnim = nil
		view:zoomAt(view.viewW / 2, view.viewH / 2, newZoom)
		applyView()
	end

	local dragTravel = 0
	local panAllowed = false -- sol tuş haritada (arayüz dışında) basıldıysa true
	local rightDown: Vector2? = nil
	local lastInputPos: Vector3? = nil
	local diagPrinted = false

	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			lastInputPos = input.Position
			uisMovedThisFrame = true
		end
	end)

	frame.MouseMoved:Connect(function(rawX: number, rawY: number)
		frameMovedThisFrame = true
		overUiByMove = false
		alignment:onMouse(rawX, rawY)
		local px, py = alignment:toGui(rawX, rawY)
		-- ölçüm bitene kadar tahmini konum (Input.Position), böylece imleç ve tıklama hemen çalışır
		if not alignment:ready() and lastInputPos then
			px, py = lastInputPos.X - frame.AbsolutePosition.X, lastInputPos.Y - frame.AbsolutePosition.Y
		end

		local down = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
			or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton3)
		-- yalnız haritada başlayan sürükleme kaydırır (kaydırıcı / panel / menü üstünde başlayan sürükleme haritayı oynatmaz)
		if down and panAllowed and mouseX and mouseY then
			local dx, dy = px - mouseX, py - mouseY
			dragTravel += math.abs(dx) + math.abs(dy) -- (kilitliyken de sayılır: sürükleme tıklama sayılmasın)
			if not camLocked() then
				view:panBy(dx, dy)
				camAnim = nil
			end
		end
		mouseX, mouseY = px, py

		if not diagPrinted and alignment:ready() and lastInputPos then
			diagPrinted = true
			local ox, oy = alignment:offset()
			print(
				string.format(
					"[Frontline] alignment: measured offset (%.1f, %.1f); formula (raw - (Input.Position - AbsolutePosition)) = (%.1f, %.1f)",
					ox,
					oy,
					rawX - (lastInputPos.X - frame.AbsolutePosition.X),
					rawY - (lastInputPos.Y - frame.AbsolutePosition.Y)
				)
			)
		end
		applyView()
	end)

	frame.MouseLeave:Connect(function()
		mouseX, mouseY = nil, nil
		updateInfo()
	end)

	-- Tuşlar (repo UserSettings varsayılanları): 1-6 binalar (şehir, fabrika, liman, savunma karakolu, füze silosu, SAM;
	-- savaş gemisi ve bombalar yalnız düğmeyle), C kendi toprağına git, Q/E uzaklaş/yakınlaş, W/A/S/D ve oklar kaydır,
	-- T/Y saldırı gücü -/+ %10, B imleçteki yere gemiyle saldır, G imleçteki yere karadan saldır, K ittifak iste,
	-- L ittifakı boz, Esc iptal.
	local DIGIT_KEYS: { [Enum.KeyCode]: number } = {
		[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3, [Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5,
		[Enum.KeyCode.Six] = 6,
	}
	local heldKeys: { [Enum.KeyCode]: boolean } = {}
	resetInteraction = function()
		buildMode = nil
		nukeConfirm = nil
		hoverBuild = nil
		selectedWarship = nil
		infoTarget = 0
		cardTile = nil
		hud:setTarget(nil)
		touchPick = nil
		hud:setBuildConfirm(nil)
		radial:close()
		table.clear(heldKeys)
		panAllowed = false
		rightDown = nil
		dragTravel = 0
		camAnim = nil
		targetZoom = 0
		UserInputService.MouseIcon = ""
	end
	local PAN_KEYS: { [Enum.KeyCode]: Vector2 } = {
		[Enum.KeyCode.W] = Vector2.new(0, 1), [Enum.KeyCode.Up] = Vector2.new(0, 1),
		[Enum.KeyCode.S] = Vector2.new(0, -1), [Enum.KeyCode.Down] = Vector2.new(0, -1),
		[Enum.KeyCode.A] = Vector2.new(1, 0), [Enum.KeyCode.Left] = Vector2.new(1, 0),
		[Enum.KeyCode.D] = Vector2.new(-1, 0), [Enum.KeyCode.Right] = Vector2.new(-1, 0),
	}
	local KEY_PAN_PX = 1250 -- repo PAN_SPEED 5 px / 4 ms
	local KEY_ZOOM_STEP = 1 + 10 / 600 -- repo ZOOM_SPEED 10 / ZOOM_DELTA_DIVISOR 600, 4 ms'de bir

	-- (x, y) mutlak ekran noktası arayüzün (panel, menü, radial) üstünde mi?
	local function onUi(x: number, y: number): boolean
		return hud:overPanel(x, y) or menu:blocks(x, y) or radial:isOpen()
	end
	-- Fare imleci arayüz üstünde mi (harita koordinatları hizalanmış fare konumundan + kayan fare bayrağından).
	local function pointerOnUi(): boolean
		if overUiByMove or radial:isOpen() then
			return true
		end
		if mouseX and mouseY then
			local ax, ay = frame.AbsolutePosition.X + (mouseX :: number), frame.AbsolutePosition.Y + (mouseY :: number)
			return hud:overPanel(ax, ay) or menu:blocks(ax, ay)
		end
		return false
	end

	-- İmleçteki tile (yoksa nil)
	local function tileAtMouse(): number?
		if not (mouseX and mouseY) then
			return nil
		end
		local tx, ty = view:screenToTile(mouseX :: number, mouseY :: number)
		if not (tx and ty) then
			return nil
		end
		return ty * mapW + tx
	end

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton3 then
			dragTravel = 0
			panAllowed = not pointerOnUi() and not menu:isOpen()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			rightDown = Vector2.new(input.Position.X, input.Position.Y)
		elseif input.UserInputType == Enum.UserInputType.Keyboard and not processed then
			local key = input.KeyCode
			heldKeys[key] = true
			local digit = DIGIT_KEYS[key]
			if digit then
				hudCb.onBuild(Hud.buildOrder[digit])
			elseif key == Enum.KeyCode.Escape and radial:isOpen() then
				radial:close()
			elseif key == Enum.KeyCode.Escape and selectedWarship then
				selectedWarship = nil
			elseif key == Enum.KeyCode.Escape and buildMode then
				nukeConfirm = nil
				buildMode = nil
				updateInfo()
			elseif key == Enum.KeyCode.Escape and infoTarget ~= 0 then
				infoTarget = 0
				updateInfo()
			elseif key == Enum.KeyCode.C then
				focusMe()
			elseif key == Enum.KeyCode.T then
				changeRatio(-0.1)
			elseif key == Enum.KeyCode.Y then
				changeRatio(0.1)
			elseif key == Enum.KeyCode.B or key == Enum.KeyCode.G then
				-- repo boatAttack / groundAttack: imleçteki yere
				local tile = tileAtMouse()
				if tile and phase == "run" and not dead and buffer.readu8(terrain, tile) ~= 0 then
					local owner = renderer:ownerAt(tile)
					if owner ~= myPid then
						local r = orderRatio()
						if not r then
							return
						end
						lastOwner = owner
						floatAttack(key == Enum.KeyCode.B, owner, mouseX or 0, mouseY or 0, r)
						if key == Enum.KeyCode.B then
							intentRemote:FireServer({ type = "boat", tile = tile, ratio = r })
						else
							intentRemote:FireServer({ type = "attack", target = owner, ratio = r, tile = tile })
							Sound.playOr("attack", "orderAck")
						end
					end
				end
			elseif key == Enum.KeyCode.K then
				diploAction("ally") -- repo requestAlliance
			elseif key == Enum.KeyCode.L then
				diploAction("breakAlly") -- repo breakAlliance
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Keyboard then
			heldKeys[input.KeyCode] = nil
		end
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		table.clear(heldKeys) -- pencere odağı gidince basılı tuş takılı kalmasın
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			-- fare henüz hiç oynamadıysa veya ölçüm bitmediyse tıklanan yer tahmini konumdan alınır
			if not alignment:ready() then
				mouseX, mouseY = input.Position.X - frame.AbsolutePosition.X, input.Position.Y - frame.AbsolutePosition.Y
			end
			if dragTravel < CLICK_MAX_TRAVEL and panAllowed and mouseX and mouseY then
				sendSpawn(mouseX, mouseY)
			end
			panAllowed = false
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			-- sağ tık (sürüklemeden): menü (repo ContextMenuEvent). Kurma modundaysa iptal eder.
			local start = rightDown
			rightDown = nil
			if start and (Vector2.new(input.Position.X, input.Position.Y) - start).Magnitude < CLICK_MAX_TRAVEL and mouseX and mouseY then
				if buildMode then
					nukeConfirm = nil
					buildMode = nil
					updateInfo()
				elseif selectedWarship then
					selectedWarship = nil
				elseif radial:isOpen() then
					radial:close()
				elseif not onUi(input.Position.X, input.Position.Y) then
					openRadialAt(mouseX, mouseY)
				end
			end
		end
	end)

	-- Fare kaydırılabilen bir pencerenin (ScrollingFrame: alt bardaki yapı satırı, How to Play, parti listesi...) üstündeyse
	-- tekerlek o pencereyi kaydırır, harita yakınlaşmaz. (Harita da bir arayüz olduğu için Roblox'un "processed" bilgisi
	-- bunu ayırt edemiyor; imleçteki arayüz öğelerine bakılır.)
	local function overScroller(x: number, y: number): boolean
		for _, g in playerGui:GetGuiObjectsAtPosition(x, y) do
			if g:IsA("ScrollingFrame") and g.ScrollingEnabled then
				local c, w = g.AbsoluteCanvasSize, g.AbsoluteWindowSize
				if c.X > w.X + 1 or c.Y > w.Y + 1 then
					return true
				end
			end
		end
		return false
	end
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseWheel and not camLocked()
			and not overScroller(input.Position.X, input.Position.Y)
		then
			-- yumuşak yakınlaştırma (RenderStepped'te): ardışık tekerlek adımları hedefe eklenir
			local base = if targetZoom > 0 then targetZoom else view.zoom
			camAnim = nil
			targetZoom = math.clamp(base * WHEEL_STEP ^ input.Position.Z, view.minZoom, view.maxZoom)
			zoomAnchorX = mouseX or view.viewW / 2
			zoomAnchorY = mouseY or view.viewH / 2
		end
	end)

	-- Dokunmatik: kaydırma, çimdikle yakınlaştırma, kısa dokunuş = başlangıç seç.
	-- Dokunma konumu InputObject.Position'dır; GUI'ye çevirmek için çerçevenin AbsolutePosition'ı çıkarılır.
	local pinching = false
	local pinchStartZoom = 1
	local touches: { [InputObject]: number } = {}

	UserInputService.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			-- arayüz üstünde başlayan dokunuş haritayı kaydırmaz / dokunma sayılmaz
			if not onUi(input.Position.X, input.Position.Y) then
				touches[input] = 0
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			local moved = touches[input]
			if moved then
				touches[input] = moved + math.abs(input.Delta.X) + math.abs(input.Delta.Y)
				if not pinching and not camLocked() then
					view:panBy(input.Delta.X, input.Delta.Y)
					camAnim = nil
					applyView()
				end
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			local moved = touches[input]
			touches[input] = nil
			if moved and moved < TAP_MAX_TRAVEL and not pinching then
				local gx = input.Position.X - frame.AbsolutePosition.X
				local gy = input.Position.Y - frame.AbsolutePosition.Y
				-- repo (mobil): başlangıçta dokunma = yerleş; oyunda kurma modu yoksa karaya dokunma = menü
				-- mobil kurma / bomba: dokunulan yer sabit imleç olur, onay penceresi açılır (OK kurar, X iptal eder)
				if phase == "run" and buildMode and not dead and myMode == "playing" then
					touchPick = { what = buildMode :: string, sx = gx, sy = gy } -- ekranda sabit (fare imleci gibi), harita altında kayar
					return
				end
				if phase == "run" and not buildMode and not dead then
					local tx, ty = view:screenToTile(gx, gy)
					if tx and ty and buffer.readu8(terrain, ty * mapW + tx) ~= 0 then
						local t = ty * mapW + tx
						local owner = renderer:ownerAt(t)
						-- dokunmatik: sahipsiz toprağa dokunma = doğrudan saldırı; oyuncu / ulus / bot = sol alttaki hedef kartı
						-- (Attack / More); kendi toprağım = menü
						if owner == 0 then
							cardTile = nil
							hud:setTarget(nil)
							sendSpawn(gx, gy)
						elseif owner ~= myPid then
							radial:close()
							-- kart açıkken aynı hedefe ikinci dokunuş = Attack (ikinci dokunulan yerden), kart kapanır
							local again = cardTile ~= nil and renderer:ownerAt(cardTile :: number) == owner
							cardTile = t
							if again then
								hudCb.onCard("attack")
							else
								updateInfo()
							end
						else
							cardTile = nil
							hud:setTarget(nil)
							openRadialAt(gx, gy)
						end
						return
					end
				end
				if cardTile ~= nil then
					cardTile = nil
					hud:setTarget(nil)
				end
				sendSpawn(gx, gy)
			end
		end
	end)

	UserInputService.TouchPinch:Connect(function(_positions: { Vector2 }, scale: number, _velocity: number, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			pinching = true
			pinchStartZoom = view.zoom
		elseif state == Enum.UserInputState.Change then
			zoomAtCenter(pinchStartZoom * scale)
		else
			pinching = false
		end
	end)

	-- Dokunmatik cihazlarda oran düğmeleri (Q/E karşılığı).

	-- Kurma önizlemesi (repo BuildPreviewController + StructurePass önizlemesi + RangeCirclePass + SAMRadiusPass +
	-- CrosshairPass + WorldTextPass fiyatı). Kuralların kendisi ghostCalc'ta (sunucuyla aynı).
	--   * Yapı: imlecin tam altında yarı saydam simge (Look.Ghost.alpha). Kurulabiliyorsa renksiz; yakındaki aynı türden
	--     yapın yükseltilecekse yeşil (o yapı da yeşil parlar); kurulamıyorsa kırmızı ton.
	--   * Menzil dairesi (dolgu %20, kenarda 1 tile'lık halka): fabrika = ray menzili, savunma karakolu, SAM = kurulacak
	--     seviyenin menzili (yükseltmede bir sonraki seviye), atom / hidrojen = dış patlama yarıçapı (ittifak bozacaksa kırmızı).
	--   * Savaş gemisi ve MIRV: kırmızı artı imleç (konamazsa koyu kırmızı).
	--   * Fiyat imlecin 25 px altında: altın yetmiyorsa kırmızı, yer uygun değilse gri, yoksa beyaz.
	--   * Silo, SAM, şehir, atom, hidrojen seçiliyken (ve SAM / bomba düğmesinin üstündeyken) tüm SAM menzilleri dönen
	--     kesikli halkalar (kendi yeşil, müttefik sarı, diğerleri kırmızı).
	-- Assets.Cursors'ta görsel varsa fare imleci o olur (o zaman imleçteki yapı simgesi çizilmez).
	-- (200 yerel değişken sınırı: bu bölüm kendi fonksiyonunda)
	;(function()
		local STRUCT_KIND, samRangeOf, nukeSilo, ghostCalc = Rules.STRUCT_KIND, Rules.samRangeOf, Rules.nukeSilo, Rules.ghostCalc
		local LG = Look.Ghost
		local LRg = Look.Range
		local SAM_GHOST = { silo = true, sam = true, city = true, atom = true, hydro = true } -- repo SAM_RADIUS_GHOST_TYPES
		local SAM_HOVER = { sam = true, atom = true, hydro = true } -- repo SAM_RADIUS_HIGHLIGHT_TYPES
		local RANGE_OF: { [string]: number } = {
			factory = Config.STATION_MAX_RANGE,
			post = Config.DEFENSE_POST_RANGE,
			atom = Config.NUKE_ATOM[2],
			hydro = Config.NUKE_HYDRO[2],
		}

		local function makeRing(name: string): Frame
			local f = Instance.new("Frame")
			f.Name = name
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.BackgroundColor3 = LRg.color
			f.BackgroundTransparency = LRg.fillTransparency
			f.BorderSizePixel = 0
			f.ZIndex = 4
			f.Visible = false
			f.Parent = world.under
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = f
			local st = Instance.new("UIStroke")
			st.Name = "Stroke"
			st.Color = LRg.color
			st.Transparency = LRg.strokeTransparency
			st.Parent = f
			return f
		end
		local rangeRing = makeRing("GhostRange")
		local hoverRing = makeRing("HoverRange")
		local confirmMarker = Instance.new("Frame")
		confirmMarker.Name = "NukeConfirm"
		confirmMarker.AnchorPoint = Vector2.new(0.5, 0.5)
		confirmMarker.BackgroundTransparency = 1
		confirmMarker.Size = world:size(0, 0)
		confirmMarker.BorderSizePixel = 0
		confirmMarker.ZIndex = 18
		confirmMarker.Visible = false
		confirmMarker.Parent = world.over
		do
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.5, 0)
			corner.Parent = confirmMarker
			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.fromRGB(251, 191, 36)
			stroke.Parent = confirmMarker
			local label = Instance.new("TextLabel")
			require(script.TextFit).fit(label)
			label.Name = "ConfirmLabel"
			label.AnchorPoint = Vector2.new(0.5, 1)
			label.Position = UDim2.new(0.5, 0, 0, -6)
			label.Size = UDim2.fromOffset(240, 22)
			label.BackgroundTransparency = 1
			label.FontFace = Fonts.main
			label.TextSize = 14
			label.TextColor3 = stroke.Color
			label.TextStrokeColor3 = Color3.new(0, 0, 0)
			label.TextStrokeTransparency = 0
			label.Text = "Click inside the circle to confirm"
			label.ZIndex = 19
			label.Parent = confirmMarker
		end
		-- Repo dairesi: yarıçap r'ye kadar %20 dolgu, [r - 1, r] arası halka. Çerçeve (r - 1) yarıçaplı, halka onun dışına
		-- (UIStroke) 1 tile kalınlığında çizilir; piksel kalınlığı zoomla değişir.
		local function placeRangeRing(f: Frame, cx: number, cy: number, r: number, color: Color3)
			local ringT = LRg.strokeTiles
			local inner = math.max(0.25, r - ringT)
			f.Position = world:at(cx, cy)
			f.Size = world:size(inner * 2, inner * 2)
			f.BackgroundColor3 = color
			local st = f:FindFirstChild("Stroke") :: UIStroke
			st.Color = color
			st.Thickness = math.max(LRg.strokeMinPx, ringT * view.zoom)
			f.Visible = true
		end

		-- Savaş gemisi / MIRV artı imleci (repo CrosshairPass: 40 px, ortası boş dört kol)
		local cross = Instance.new("Frame")
		cross.Name = "GhostCross"
		cross.AnchorPoint = Vector2.new(0.5, 0.5)
		cross.BackgroundTransparency = 1
		cross.Size = UDim2.fromOffset(LG.crosshairPx * 2, LG.crosshairPx * 2)
		cross.ZIndex = 9
		cross.Visible = false
		cross.Parent = frame
		local crossArms: { Frame } = {}
		do
			local P = LG.crosshairPx
			local gap = 0.15 * P -- repo GAP
			local lw = math.max(2, 2 * 0.08 * P) -- repo LINE_HALF_W x 2
			local len = P - gap
			for i = 1, 4 do
				local a = Instance.new("Frame")
				a.BorderSizePixel = 0
				a.BackgroundTransparency = 0.1 -- repo mask x 0.9
				a.AnchorPoint = Vector2.new(0.5, 0.5)
				if i <= 2 then
					a.Size = UDim2.fromOffset(len, lw)
					a.Position = UDim2.new(0.5, (if i == 1 then -1 else 1) * (gap + len / 2), 0.5, 0)
				else
					a.Size = UDim2.fromOffset(lw, len)
					a.Position = UDim2.new(0.5, 0, 0.5, (if i == 3 then -1 else 1) * (gap + len / 2))
				end
				a.ZIndex = 9
				a.Parent = cross
				crossArms[i] = a
			end
		end

		-- Fiyat (repo WorldTextPass ghostCost: sabit ekran boyu, imlecin altında, dış hatlı)
		local costLabel = Instance.new("TextLabel")
		require(script.TextFit).fit(costLabel)
		costLabel.Name = "GhostCost"
		costLabel.BackgroundTransparency = 1
		costLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		costLabel.Size = UDim2.fromOffset(200, LG.costPx + 6)
		costLabel.FontFace = Fonts.main
		costLabel.TextSize = LG.costPx
		costLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
		costLabel.TextStrokeTransparency = 0
		costLabel.ZIndex = 9
		costLabel.Visible = false
		costLabel.Active = false
		costLabel.Parent = frame
		local ghostCursor = ""

		-- Tüm SAM menzilleri (repo SAMRadiusPass)
		local samRings = SamRings.new(world)
		local samRingsAt = -1
		local function refreshSamRings()
			local rings: { SamRings.Ring } = {}
			for _, st in structs do
				if st.type == "sam" then
					local mine = st.pid == myPid
					local friendly = mine or relationWith(st.pid).allied
					rings[#rings + 1] = {
						x = (st.tile % mapW) + 0.5,
						y = (st.tile // mapW) + 0.5,
						r = st.rg or samRangeOf(st.level),
						color = if mine then LRg.samSelf elseif friendly then LRg.samAlly else LRg.samEnemy,
						alpha = 1,
						spin = 1,
						group = if friendly then 0 else 1, -- aynı taraftakiler birleşik şekil
					}
				end
			end
			samRings:set(rings)
			samRingsAt = structsAt
		end

		-- Yapının (varsa) etki alanı yarıçapı, tile (üstüne gelince gösterilir).
		local function structRange(st: any): number?
			if st.type == "post" then
				return Config.DEFENSE_POST_RANGE
			elseif st.type == "factory" then
				return Config.STATION_MAX_RANGE
			elseif st.type == "sam" then
				return st.rg or samRangeOf(st.level)
			end
			return nil
		end

		-- Fare altındaki yapı: simgenin ekrandaki boyu (Structures, repo formülü) kadar alan, en az 12 piksel.
		local function structUnderMouse(): any?
			if mouseX == nil or mouseY == nil then
				return nil
			end
			local best, bestD = nil, math.huge
			for _, st in structs do
				local half = math.max(12, structures:sizeOf(st.type)) / 2 + 2
				local sx = view.x + ((st.tile % mapW) + 0.5) * view.zoom
				local sy = view.y + ((st.tile // mapW) + 0.5) * view.zoom
				local d = (sx - (mouseX :: number)) ^ 2 + (sy - (mouseY :: number)) ^ 2
				if d < half * half and d < bestD then
					best, bestD = st, d
				end
			end
			return best
		end

		-- Bomba yörünge önizlemesi (repo NukeTrajectoryPass): en yakın hazır silodan imlece, sunucudaki eğriyle aynı Bezier.
		local ARC_DOTS = 28
		local arcDots: { Frame } = {}
		for i = 1, ARC_DOTS do
			local d = Instance.new("Frame")
			d.AnchorPoint = Vector2.new(0.5, 0.5)
			d.BorderSizePixel = 0
			d.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			d.BackgroundTransparency = 0.25
			d.ZIndex = 4
			d.Visible = false
			d.Parent = world.under
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = d
			arcDots[i] = d
		end
		local function hideArc()
			for _, d in arcDots do
				d.Visible = false
			end
		end
		local function showArc(tx: number, ty: number, hydro: boolean)
			local best = nukeSilo(ty * mapW + tx)
			if not best then
				hideArc()
				return
			end
			local x0, y0 = best.tile % mapW, best.tile // mapW
			local dx, dy = tx - x0, ty - y0
			local dd = math.sqrt(dx * dx + dy * dy)
			local H = math.max(dd / 3, 50)
			local x1, y1 = x0 + dx / 4, math.clamp(y0 + dy / 4 - H, 0, mapH - 1)
			local x2, y2 = x0 + dx * 3 / 4, math.clamp(y0 + dy * 3 / 4 - H, 0, mapH - 1)
			local col = if hydro then Color3.fromRGB(244, 114, 182) else Color3.fromRGB(251, 191, 36)
			for i, d in arcDots do
				local t = (i - 1) / (ARC_DOTS - 1)
				local u = 1 - t
				local a, b, c, e = u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t
				d.Position = world:at(a * x0 + b * x1 + c * x2 + e * tx + 0.5, a * y0 + b * y1 + c * y2 + e * ty + 0.5)
				d.Size = world:size(1.2, 1.2, 3, 3)
				d.BackgroundColor3 = col
				d.Visible = true
			end
		end

		-- Yapı düğmesi üstündeyken (repo ToggleStructureEvent): ilgili yapılar vurgulanır, SAM / bombada SAM menzilleri.
		local function highlightFor(id: string?): { [string]: boolean }?
			if id == nil then
				return nil
			elseif id == "atom" or id == "hydro" then
				return { silo = true, sam = true }
			elseif id == "warship" then
				return { port = true }
			elseif STRUCT_KIND[id] then
				return { [id] = true }
			end
			return nil -- MIRV: repo'da eşleşen yapı yok, vurgu kapalı
		end

		updateGhost = function()
			samRings:step(os.clock()) -- dönen SAM halkaları (görünürken)
			local what = buildMode
			-- dokunmatik: imleç yerine dokunulan sabit nokta (yoksa önizleme yok); PC'de fare
			if touchPick and (touchPick.what ~= what or dead or phase ~= "run") then
				touchPick = nil
			end
			local touchMode = touchPick ~= nil or (what ~= nil and UserInputService:GetLastInputType() == Enum.UserInputType.Touch)
			local pmx, pmy = mouseX, mouseY
			if touchMode then
				pmx, pmy = nil, nil
				if touchPick then
					pmx, pmy = touchPick.sx, touchPick.sy
				end
			end
			local blocked = radial:isOpen() or menu:isOpen() or (not touchMode and pointerOnUi())
			-- fare (mobilde yalnız kurma sabit noktası) üstündeki ülke parlar, üstündeki isim saydamlaşır
			-- (repo HoverHighlightController, hitTestNamePlate, hoverFadeAlpha 0.5)
			local hx, hy = pmx, pmy
			if blocked or (hud.mobile and not touchPick) then
				hx, hy = nil, nil
			end
			local hoverOwner = 0
			if hx and hy then
				local ox, oy = view:screenToTile(hx, hy)
				if ox and oy then
					hoverOwner = renderer:ownerAt(oy * mapW + ox)
				end
			end
			-- mobil: saldırı (hedef) kartı açıkken dokunulan ülke, PC'de üstüne gelinmiş gibi parlar (kart kapanınca söner)
			if hud.mobile and cardTile ~= nil then
				hoverOwner = renderer:ownerAt(cardTile :: number)
			end
			renderer:setHighlight(hoverOwner)
			for _, v in nameViews do
				local over = false
				if hx and hy then
					for _, l in { v.name, v.troops, v.icons } do
						local p, b = l.Position, l.TextBounds
						if l.Visible and math.abs(hx - p.X.Offset) <= b.X / 2 and math.abs(hy - p.Y.Offset) <= b.Y / 2 then
							over = true
						end
					end
				end
				if over ~= (v.fade == true) then
					v.fade = over
					local a = if over then 0.5 else 0
					v.name.TextTransparency, v.name.TextStrokeTransparency = a, a
					v.troops.TextTransparency, v.troops.TextStrokeTransparency = a, a
					v.icons.TextTransparency = a
				end
			end
			if touchPick and what and pmx and pmy and not blocked then
				hud:setBuildConfirm(BUILD_META[what].label .. " · " .. fmtGold(Rules.buildCost(what)), frame.AbsolutePosition.X + pmx, frame.AbsolutePosition.Y + pmy)
			else
				hud:setBuildConfirm(nil)
			end
			if nukeConfirm and (nukeConfirm.what ~= what or nukeConfirm.round ~= round or nukeConfirm.pid ~= myPid
				or dead or phase ~= "run" or not canSelect(nukeConfirm.what)) then
				nukeConfirm = nil
			end
			confirmMarker.Visible = nukeConfirm ~= nil and not menu:isOpen() and not radial:isOpen()
			if nukeConfirm then
				local tile = nukeConfirm.tile
				-- Atom/hidrojen dış patlama yarıçapı; MIRV tek patlama değildir,
				-- sunucunun başlık dağılım yarıçapını ayrı adla gösterir.
				local radius = RANGE_OF[nukeConfirm.what] or Config.MIRV_RANGE
				confirmMarker.Size = world:size(radius * 2, radius * 2)
				local label = confirmMarker:FindFirstChild("ConfirmLabel") :: TextLabel
				label.Text = if nukeConfirm.what == "mirv" then "Warhead area · Click inside" else "Click inside the circle to confirm"
				-- Büyük daire ekran dışına taşsa da onay yazısı hedefin yanında kalır.
				label.Position = UDim2.new(0.5, 0, 0.5, -18)
				confirmMarker.Position = world:at(tile % mapW + 0.5, tile // mapW + 0.5)
				local stroke = confirmMarker:FindFirstChildOfClass("UIStroke") :: UIStroke
				stroke.Thickness = math.max(1, view.zoom * 0.5)
			end
			if hoverBuild and not blocked then
				hoverBuild = nil -- fare haritaya döndü (düğmenin MouseLeave'i kaçsa da vurgu kalmasın)
			end
			local tx, ty
			if what and pmx and pmy and not blocked then
				tx, ty = view:screenToTile(pmx :: number, pmy :: number)
			end
			local show = what ~= nil and tx ~= nil and ty ~= nil
			-- SAM menzilleri ve yapı vurgusu
			local ringsOn = (show and SAM_GHOST[what :: string] == true) or (hoverBuild ~= nil and SAM_HOVER[hoverBuild :: string] == true)
			if ringsOn and samRingsAt ~= structsAt then
				refreshSamRings()
			end
			samRings:setVisible(ringsOn)
			structures:setHighlight(highlightFor(hoverBuild))
			-- fare imleci (Assets.Cursors)
			-- Liman tek bir önizleme simgesi kullanır; özel fare görseli ikinci liman göstermesin.
			local cursor = if show and what and what ~= "port" then ((Assets.Cursors :: any)[what] or "") else ""
			if cursor ~= ghostCursor then
				ghostCursor = cursor
				UserInputService.MouseIcon = cursor
			end
			if not show or not what or not tx or not ty then
				structures:setGhost(nil, nil, nil, myPid, "ok", nil)
				rangeRing.Visible = false
				cross.Visible = false
				costLabel.Visible = false
				hideArc()
				-- kurma modu dışında: fareyle üstüne gelinen yapının etki alanı (savunma karakolu, fabrika, SAM)
				local hs = if what == nil and not blocked then structUnderMouse() else nil
				local hr = if hs then structRange(hs) else nil
				if hs and hr then
					placeRangeRing(hoverRing, (hs.tile % mapW) + 0.5, (hs.tile // mapW) + 0.5, hr, LRg.color)
				else
					hoverRing.Visible = false
				end
				return
			end
			hoverRing.Visible = false
			local tile = ty * mapW + tx
			local g = ghostCalc(what, tile)
			-- imlecin dünya konumu (ondalıklı): repo önizlemesi imleci tam takip eder (tile'a atlamaz)
			local wx = ((pmx :: number) - view.x) / view.zoom
			local wy = ((pmy :: number) - view.y) / view.zoom
			local placeX, placeY = wx, wy
			if what == "port" and (g.up or g.canBuild) then
				local site = if g.up then g.up.tile else g.canBuild :: number
				placeX, placeY = (site % mapW) + 0.5, (site // mapW) + 0.5
			-- diğer yapıya fazla yakınsa (kurulacağı tile imleç tile'ı değil) önizleme gerçek kurulacağı yerde görünür
			elseif (LG.snap or g.canBuild ~= tile) and g.canBuild and not g.up and STRUCT_KIND[what] then
				placeX, placeY = (g.canBuild % mapW) + 0.5, (g.canBuild // mapW) + 0.5
			end
			local valid = g.up ~= nil or g.canBuild ~= nil
			-- yapı simgesi
			if STRUCT_KIND[what] and cursor == "" then
				local state = if g.up then "upgrade" elseif g.canBuild then "ok" else "bad"
				structures:setGhost(what, placeX, placeY, myPid, state, if g.up and what ~= "port" then g.up.tile else nil)
			else
				structures:setGhost(nil, nil, nil, myPid, "ok", nil)
			end
			-- artı imleç (savaş gemisi, MIRV)
			if what == "warship" or what == "mirv" then
				cross.Position = UDim2.fromOffset(view.x + placeX * view.zoom, view.y + placeY * view.zoom)
				local col = if valid then LG.crosshairOk else LG.crosshairBad
				for _, a in crossArms do
					a.BackgroundColor3 = col
				end
				cross.Visible = true
			else
				cross.Visible = false
			end
			-- fiyat
			costLabel.Text = fmtGold(g.cost)
			costLabel.TextColor3 = if not g.afford then LG.costPoor elseif not valid then LG.costBad else LG.costOk
			costLabel.Position = UDim2.fromOffset(view.x + placeX * view.zoom, view.y + placeY * view.zoom + LG.costOffset)
			costLabel.Visible = g.cost > 0
			-- menzil dairesi
			local r: number? = nil
			local cx, cy = wx, wy
			if what == "sam" then
				r = samRangeOf(if g.up then g.up.level + 1 else 1)
			else
				r = RANGE_OF[what]
			end
			if g.up and r then
				cx, cy = (g.up.tile % mapW) + 0.5, (g.up.tile // mapW) + 0.5 -- yükseltmede daire yapının üstünde sabit
			elseif (LG.snap or g.canBuild ~= tile) and g.canBuild and STRUCT_KIND[what] then
				cx, cy = placeX, placeY
			end
			if r then
				placeRangeRing(rangeRing, cx, cy, r, if g.warn then LRg.warnColor else LRg.color)
			else
				rangeRing.Visible = false
			end
			-- bomba yayı
			if what == "atom" or what == "hydro" then
				showArc(tx, ty, what == "hydro")
			else
				hideArc()
			end
		end
	end)()

	-- Çizim: kirli parçalar kare başına bir kez yazılır.
	RunService.RenderStepped:Connect(function(dt: number)
		if menu.current == menu.main then
			(menuCb :: any).reload()
			return
		end
		-- fare hareket etti ama harita çerçevesi duymadı: imleç bir arayüzün üstünde (hover kartı gizlenir)
		if uisMovedThisFrame and not frameMovedThisFrame and not overUiByMove then
			overUiByMove = true
			updateInfo()
		end
		uisMovedThisFrame, frameMovedThisFrame = false, false
		if not Rules.waterComp.done then
			Rules.waterComp:step(60000) -- savaş gemisi önizlemesi için su bileşenleri (birkaç saniyede biter)
		end
		-- Tur başladığında, kendi toprak verisi ve görünür oyun hazır olunca yalnız bir kez.
		-- Aynı isim düğmesi akışı; sonraki paketler/kamera hareketleri tekrar odaklamaz.
		if autoFocusRound ~= round and phase == "run" and myMode == "playing"
			and myPid ~= 0 and not dead and not menu:isOpen() and view.viewW > 0 and view.viewH > 0
			and focusMe(true) then
			autoFocusRound = round
			targetZoom = 0
			camLockUntil = os.clock() + 0.75 -- (o an süren dokunma / kaydırma odaklı kamerayı hemen kesmesin)
		end
		-- klavye: kaydırma ve yakınlaştırma (repo moveInterval)
		do
			local px, py = 0, 0
			for key, v in PAN_KEYS do
				if heldKeys[key] then
					px += v.X
					py += v.Y
				end
			end
			local zin = heldKeys[Enum.KeyCode.E] == true
			local zout = heldKeys[Enum.KeyCode.Q] == true
			if (px ~= 0 or py ~= 0 or zin ~= zout) and not UserInputService:GetFocusedTextBox() and not camLocked() then
				camAnim = nil
				targetZoom = 0
				if px ~= 0 or py ~= 0 then
					view:panBy(math.sign(px) * KEY_PAN_PX * dt, math.sign(py) * KEY_PAN_PX * dt)
				end
				if zin ~= zout then
					local f = KEY_ZOOM_STEP ^ (dt / 0.004)
					view:zoomAt(view.viewW / 2, view.viewH / 2, if zin then view.zoom * f else view.zoom / f)
				end
				applyView()
			end
		end
		if camAnim then
			local x, y, z, done = CameraFocus.sample(camAnim :: CameraFocus.Anim, os.clock())
			view:centerOn(x, y, z)
			applyView()
			if done then
				camAnim = nil
			end
		end
		drip(dt)
		if mapCheck and stateReady then
			local r = mapCheck:step(lastSeq, tileDrip:busy(), function()
				tileDrip:flush()
			end)
			if r then
				Players.LocalPlayer:SetAttribute("MapChecks", mapCheck.checks)
			end
			if r == "desync" then
				Players.LocalPlayer:SetAttribute("MapDesyncs", mapCheck.desyncs)
				warn("[Frontline] map out of sync with the server, reloading it")
				resync()
			end
		end
		renderer:processQueue(60000)
		drawNames() -- isim plakaları hedefe kayar
		stepSpawnRing()
		updateBars()
		updateGhost()
		if targetZoom > 0 and math.abs(targetZoom - view.zoom) > 1e-4 then
			local k = 1 - math.exp(-dt * 14)
			view:zoomAt(zoomAnchorX, zoomAnchorY, view.zoom + (targetZoom - view.zoom) * k)
			applyView()
			if math.abs(targetZoom - view.zoom) < view.zoom * 0.002 then
				targetZoom = 0
			end
		end
		renderer:flush()
		stepBoats(dt)
	end)

	-- Tutorial (Client.Tutorial): haritaya ve HUD'a bakan yardımcılar
	local TutorialMod = require(script.Tutorial)
	local function tileScreen(t: number): Vector2
		return Vector2.new(frame.AbsolutePosition.X + view.x + (t % mapW + 0.5) * view.zoom, frame.AbsolutePosition.Y + view.y + (t // mapW + 0.5) * view.zoom)
	end
	-- haritanın arayüzle örtülmeyen kısmı (mutlak): tutorial kartının (yoksa üst barın) altı, alt panelin üstü
	local function freeRect(): (number, number, number, number)
		local fp, fs = frame.AbsolutePosition, frame.AbsoluteSize
		local top = fp.Y + 24
		local card = tutorial and tutorial.card
		if card and card.Visible then
			top = math.max(top, card.AbsolutePosition.Y + card.AbsoluteSize.Y + 24)
		elseif hud.top.Visible then
			top = math.max(top, hud.top.AbsolutePosition.Y + hud.top.AbsoluteSize.Y + 24)
		end
		local bottom = fp.Y + fs.Y - 48
		if hud.bottom.Visible then
			bottom = math.min(bottom, hud.bottom.AbsolutePosition.Y - 48)
		end
		return fp.X + 32, top, fp.X + fs.X - 32, math.max(bottom, top + 1)
	end
	-- toprağımın yanındaki boş kara (enemy: düşmanın karası): ekranda açıkça görünen (freeRect) ve ekranın ortasına en
	-- yakın olanı; görünen yoksa ekranın ortasına en yakını. Kutu büyükse seyrek taranır.
	-- keep: önceki hedef; hâlâ uygunsa ve ekranda açıkça görünüyorsa aynısı döner (işaret yer değiştirip durmasın)
	local function scanNeighbor(enemy: boolean, keep: number?): (number?, number?)
		local x0, y0, x1, y1 = renderer.bx0[myPid], renderer.by0[myPid], renderer.bx1[myPid], renderer.by1[myPid]
		if myPid == 0 or x0 == nil then
			return nil, nil
		end
		local step = math.max(1, math.floor(math.sqrt((x1 - x0 + 1) * (y1 - y0 + 1) / 40000)))
		local rx0, ry0, rx1, ry1 = freeRect()
		if keep and buffer.readu8(terrain, keep) ~= 0 then
			local o = renderer:ownerAt(keep)
			local p = tileScreen(keep)
			if (if enemy then (o ~= 0 and o ~= myPid and not relationWith(o).allied and not relationWith(o).teammate) else o == 0)
				and p.X >= rx0 and p.X <= rx1 and p.Y >= ry0 and p.Y <= ry1
			then
				return keep, o
			end
		end
		local fx, fy, z = frame.AbsolutePosition.X + view.x, frame.AbsolutePosition.Y + view.y, math.max(view.zoom, 1e-3)
		local cx, cy = ((rx0 + rx1) / 2 - fx) / z - 0.5, ((ry0 + ry1) / 2 - fy) / z - 0.5
		local best, bestOwner, bestD = nil, nil, math.huge
		local bdx, bdy = 0, 0
		for y = y0, y1, step do
			for x = x0, x1, step do
				if renderer:ownerAt(y * mapW + x) == myPid then
					for k = 1, 4 do
						local nx = x + (if k == 1 then 1 elseif k == 2 then -1 else 0)
						local ny = y + (if k == 3 then 1 elseif k == 4 then -1 else 0)
						if nx >= 0 and nx < mapW and ny >= 0 and ny < mapH then
							local n = ny * mapW + nx
							if buffer.readu8(terrain, n) ~= 0 then
								local o = renderer:ownerAt(n)
								local fits = if enemy then (o ~= 0 and o ~= myPid and not relationWith(o).allied and not relationWith(o).teammate) else o == 0
								if fits then
									local d = (nx - cx) ^ 2 + (ny - cy) ^ 2
									local sx, sy = fx + (nx + 0.5) * z, fy + (ny + 0.5) * z
									if sx < rx0 or sx > rx1 or sy < ry0 or sy > ry1 then
										d += 1e12 -- (ekran dışında ya da arayüzün altında)
									end
									if d < bestD then
										best, bestOwner, bestD = n, o, d
										bdx, bdy = nx - x, ny - y
									end
								end
							end
						end
					end
				end
			end
		end
		-- sınırdan dışa doğru 3 tile içeri (aynı sahip): işarete dokunan oyuncu kendi toprağına değil hedefe basar
		if best then
			for _ = 1, 3 do
				local nx, ny = (best :: number) % mapW + bdx, (best :: number) // mapW + bdy
				if nx < 0 or nx >= mapW or ny < 0 or ny >= mapH then
					break
				end
				local n = ny * mapW + nx
				if buffer.readu8(terrain, n) == 0 or renderer:ownerAt(n) ~= bestOwner then
					break
				end
				best = n
			end
		end
		return best, bestOwner
	end
	tutorial = TutorialMod.new({
		gui = hudGui,
		touch = hud.mobile,
		phase = function(): string
			return phase
		end,
		playing = function(): boolean
			return myMode == "playing" and not dead
		end,
		mine = function(): any
			return stats[myPid]
		end,
		ratio = function(): number
			return ratio
		end,
		spawned = function(): boolean
			return myPid ~= 0 and stats[myPid] ~= nil
		end,
		isFree = function(t: number): boolean
			return buffer.readu8(terrain, t) ~= 0 and renderer:ownerAt(t) == 0
		end,
		-- başlangıç için geniş boş yer: ekranda görünen alandan 240 deneme, ülkelerin ad noktalarından en uzağı (RoWorld);
		-- çevresi (25x25 tile) çoğunlukla boş kara olan yerler (küçük adaya düşen yeni oyuncu büyüyemez, komşu bulamaz)
		spawnSpot = function(): number?
			local fw, fh = frame.AbsoluteSize.X, frame.AbsoluteSize.Y
			local best, bestD = nil, -1
			local fallback: number? = nil
			for _ = 1, 240 do
				local tx, ty = view:screenToTile(fw * (0.15 + math.random() * 0.7), fh * (0.25 + math.random() * 0.5))
				if tx and ty then
					local t = ty * mapW + tx
					local roomy = false
					if buffer.readu8(terrain, t) ~= 0 and renderer:ownerAt(t) == 0 then
						fallback = fallback or t
						local free = 0
						for sy = ty - 12, ty + 12, 3 do
							for sx = tx - 12, tx + 12, 3 do
								if sx >= 0 and sx < mapW and sy >= 0 and sy < mapH then
									local s = sy * mapW + sx
									if buffer.readu8(terrain, s) ~= 0 and renderer:ownerAt(s) == 0 then
										free += 1
									end
								end
							end
						end
						roomy = free >= 65 -- (81 örnekten %80)
					end
					if roomy then
						local d = math.huge
						for _, p in stats do
							if p.c then
								local dx, dy = p.c % mapW - tx, p.c // mapW - ty
								d = math.min(d, dx * dx + dy * dy)
							end
						end
						if d > bestD then
							best, bestD = t, d
						end
					end
				end
			end
			return best or fallback
		end,
		spawnAt = function(t: number)
			intentRemote:FireServer({ type = "spawn", tile = t })
			Sound.play("spawn")
			spawnPulseAt(t)
		end,
		emptyNeighbor = function(keep: number?): number?
			return (scanNeighbor(false, keep))
		end,
		enemyNeighbor = function(keep: number?): (number?, string?)
			local t, o = scanNeighbor(true, keep)
			return t, if o then names[o] else nil
		end,
		tileScreen = tileScreen,
		freeRect = freeRect,
		troopsScreen = function(): Vector2?
			return TutorialMod.center(hud.bottom:FindFirstChild("Troops") :: GuiObject?)
		end,
		sliderScreen = function(v: number): Vector2?
			local attack = hud.bottom:FindFirstChild("Attack")
			local track = attack and attack:FindFirstChild("Track") :: GuiObject?
			if not track or not hud.bottom.Visible then
				return nil
			end
			return Vector2.new(track.AbsolutePosition.X + track.AbsoluteSize.X * v, track.AbsolutePosition.Y + track.AbsoluteSize.Y / 2)
		end,
		-- mobilde dokunulan yerin kartı açıksa işaret kartın Attack düğmesinde
		cardAttack = function(): Vector2?
			if not hud.card.Visible then
				return nil
			end
			return TutorialMod.center(hud.card:FindFirstChild("Attack") :: GuiObject?)
		end,
		-- şehir adımı: onay penceresi > (City seçiliyse) toprağım > City düğmesi > (yapılar kapalıysa) BUILD
		cityScreen = function(): Vector2?
			if hud.confirm.Visible then
				return TutorialMod.center(hud.confirm:FindFirstChild("Confirm") :: GuiObject?)
			end
			if buildMode == "city" then
				local m = stats[myPid]
				return if m and m.c then tileScreen(m.c) else nil
			end
			if hud.buildsOpen then
				return TutorialMod.center(hud.buttons.city)
			end
			return TutorialMod.center(hud.buildToggle)
		end,
		hasCity = function(): boolean
			for _, st in structs do
				if st.pid == myPid and st.type == "city" then
					return true
				end
			end
			return false
		end,
		-- şehir adımı başlarken altın bir şehir fiyatına tamamlanır (solo maç bu cihazda: RoWorld "Here is gold for your first City")
		giveCityGold = function()
			local sim = (localMatch :: any).sim
			if sim and myPid ~= 0 and sim.gold[myPid] then
				local cost = sim:structureCost(myPid, "city")
				if sim.gold[myPid] < cost then
					sim.gold[myPid] = cost
				end
			end
		end,
		report = function(step: number)
			local r = game:GetService("ReplicatedStorage"):FindFirstChild("FrontlineProfile")
			if r then
				(r :: RemoteEvent):FireServer("tutorial", step)
			end
		end,
		finish = function(how: string, step: number)
			(require(Shared:WaitForChild("Session")) :: any).tutorial = "done"
			if how == "done" and (menuCb :: any).coach then
				for _, id in require(script.Coach).TAUGHT do
					(menuCb :: any).coach:complete(id) -- (tutorial'ın öğrettikleri ipucu olarak bir daha söylenmez)
				end
			end
			if how == "done" or how == "skipped" then
				local r = game:GetService("ReplicatedStorage"):FindFirstChild("FrontlineProfile")
				if r then
					(r :: RemoteEvent):FireServer("tutorialEnd", how, step)
				end
			end
		end,
		sound = function(key: string)
			Sound.play(key)
		end,
		toast = function(text: string)
			local coach = (menuCb :: any).coach
			if coach and text == TutorialMod.FLOOR_TIP then
				-- (asker tabanı bir emri kırptı: Coach ipucu, Attack çubuğunu gösterir)
				coach:offer("floor", function()
					return tutorial.deps.sliderScreen(0.5)
				end)
			else
				hud:toast(text)
			end
		end,
		-- kartın üst kenarı: üst bar, başlangıç şridi ve kısa yazının (toast) altında
		topY = function(): number
			local y = hudGui.AbsolutePosition.Y + 8
			for _, g in { hud.top, hud.banner, hud.toastFrame } do
				if g.Visible then
					y = math.max(y, g.AbsolutePosition.Y + g.AbsoluteSize.Y + 8)
				end
			end
			-- (üst barın altındaki lider yazısı barın dışına taşar)
			local bar = hud.top:FindFirstChild("ControlBar")
			local leader = bar and bar:FindFirstChild("Leader")
			local name = leader and leader:FindFirstChild("LeaderName") :: GuiObject?
			if hud.top.Visible and leader and (leader :: GuiObject).Visible and name then
				y = math.max(y, name.AbsolutePosition.Y + name.AbsoluteSize.Y + 6)
			end
			return y
		end,
	})
	;(menuCb :: any).tutorial = tutorial
	-- Analitik (Client.Analytics -> Server.Analytics): Onboarding / Match hunileri, elenme, çıkış durumu
	;(menuCb :: any).analytics = require(script.Analytics).new({
		phase = function(): string
			return phase
		end,
		round = function(): number
			return round
		end,
		playing = function(): boolean
			return myMode == "playing" and not dead
		end,
		dead = function(): boolean
			return dead
		end,
		me = function(): number
			return myPid
		end,
		stats = function(): any
			return stats
		end,
		runSecs = function(): number
			return (menuCb :: any).runSecs or 0
		end,
		mode = function(): string
			if online then
				return if teamCount > 0 then "teams" else "online"
			end
			if (require(Shared:WaitForChild("Session")) :: any).tutorial == "run" then
				return "tutorial"
			end
			return menu.difficulty
		end,
		hit = function(): (number?, number?)
			return (menuCb :: any).hitAt, (menuCb :: any).hitBy
		end,
		kindOf = function(pid: number): string
			local k = PlayerColors.kindOf(pid)
			return if k == 1 then "nation" elseif k == 2 then "bot" else "human"
		end,
		-- (Match Start: harita; Match End: tur sonunda kazandı mı — tur sonu ekranı yazar)
		map = function(): string?
			if online then
				local f = ReplicatedStorage:FindFirstChild((require(Shared:WaitForChild("Protocol")) :: any).MatchFolder)
				return if f then f:GetAttribute("Map") else nil
			end
			return (require(Shared:WaitForChild("Session")) :: any).map
		end,
		won = function(): boolean
			return (menuCb :: any).roundWon == true
		end,
	})
	-- Coach ipuçları (Client.Coach): ilk maçlarda tek tek kısa ipucu; tutorial sürerken susar
	do
		local cache: { [string]: any } = {}
		-- (harita taramaları yarım saniyede bir; hedef her karede sorulur)
		local function cached(key: string, fn: () -> (any, any)): (any, any)
			local c = cache[key]
			if c == nil or os.clock() - c.at >= 0.5 then
				local v, w = fn()
				c = { at = os.clock(), v = v, w = w }
				cache[key] = c
			end
			return c.v, c.w
		end
		;(menuCb :: any).coach = require(script.Coach).new({
			gui = hudGui,
			touch = hud.mobile,
			topY = tutorial.deps.topY,
			sound = function(key: string)
				Sound.play(key)
			end,
			active = function(): boolean
				return myMode == "playing" and not dead and myPid ~= 0 and phase == "run" and not menu:isOpen()
					and not (tutorial and tutorial.active)
			end,
			secs = function(): number
				return (menuCb :: any).runSecs or 0
			end,
			canAffordCity = function(): boolean
				local m = stats[myPid]
				local cost = Rules.buildCost("city")
				return m ~= nil and cost > 0 and m.gold >= cost
			end,
			frontier = function(): Vector2?
				local t = cached("frontier", function()
					return scanNeighbor(false)
				end)
				return if t then tileScreen(t) else nil
			end,
			enemy = function(): (Vector2?, string?)
				local t, o = cached("enemy", function()
					return scanNeighbor(true)
				end)
				if t and o then
					return tileScreen(t), names[o]
				end
				return nil, nil
			end,
			-- toprağım denize (suya) değiyor mu (kutu büyükse seyrek taranır)
			coast = function(): boolean
				return (cached("coast", function()
					local x0, y0, x1, y1 = renderer.bx0[myPid], renderer.by0[myPid], renderer.bx1[myPid], renderer.by1[myPid]
					if myPid == 0 or x0 == nil then
						return false
					end
					local step = math.max(1, math.floor(math.sqrt((x1 - x0 + 1) * (y1 - y0 + 1) / 40000)))
					for y = y0, y1, step do
						for x = x0, x1, step do
							if renderer:ownerAt(y * mapW + x) == myPid then
								for k = 1, 4 do
									local nx = x + (if k == 1 then 1 elseif k == 2 then -1 else 0)
									local ny = y + (if k == 3 then 1 elseif k == 4 then -1 else 0)
									if nx >= 0 and nx < mapW and ny >= 0 and ny < mapH and buffer.readu8(terrain, ny * mapW + nx) == 0 then
										return true
									end
								end
							end
						end
					end
					return false
				end)) == true
			end,
			slider = function(): Vector2?
				return tutorial.deps.sliderScreen(0.5)
			end,
			cityButton = function(): Vector2?
				if hud.buildsOpen then
					return TutorialMod.center(hud.buttons.city)
				end
				return TutorialMod.center(hud.buildToggle)
			end,
			attacksPanel = function(): Vector2?
				return TutorialMod.center(hud.attacks)
			end,
			hitAt = function(): number?
				return (menuCb :: any).hitAt
			end,
			cardOpen = function(): boolean
				return hud.card.Visible
			end,
		})
	end

	print(string.format("[Frontline] client %s: map drawn %dx%d, %.1f ms", Config.VERSION, mapW, mapH, drawMs))
end)()

-- Harita hazır: maç başlar.
menuCb.onSettings(menu.settings)
menuCb.onPlay()
;(menuCb :: any).loaded()
if online then
	online.bindGame(menu, menuCb)
elseif (require(Shared:WaitForChild("Session")) :: any).tutorial == "run" and (menuCb :: any).tutorial then
	(menuCb :: any).tutorial:begin() -- yeni oyuncunun ilk maçı: tutorial (harita yüklendi, maç başladı)
end
]]></ProtectedString>
