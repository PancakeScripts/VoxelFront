				<Item class="ModuleScript" referent="RBXB673429DB887450FBA71C94A3AC2D08E">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- PartyTests: Server.Party (davet, kabul / ret, ayrılma, sınır, Roblox partisi, maçtan dönüş). RoWorld tests/party.luau'dan
-- uyarlandı (AGPL-3.0, © 2026 Snick Co.). Oyunda çalışmaz; Studio'da elle:
-- require(game.ServerScriptService.Server.Dev.PartyTests).run()  -> { passed, failed, lines }

local Party = require(script.Parent.Parent.Party)

local PartyTests = {}

function PartyTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end
	local clock = 0
	local sent = {}
	local function player(id: number, name: string)
		return { UserId = id, DisplayName = name, Name = name, Parent = true }
	end
	local party = Party.new({
		send = function(p, state)
			sent[p] = state
		end,
		now = function()
			return clock
		end,
		prefix = "S1:",
	})
	local a, b, c, d, e = player(1, "Ann"), player(2, "Bob"), player(3, "Cat"), player(4, "Dan"), player(5, "Eve")

	expect(party:invite(a, b), "Ann, Bob'u davet eder")
	expect(#sent[b].invites == 1 and sent[b].invites[1].uid == 1, "Bob daveti görür")
	expect(not party:invite(a, b), "aynı davet hemen tekrar gönderilmez")
	expect(party:accept(b, 1), "Bob kabul eder")
	expect(party:key_of(a) ~= nil and party:key_of(a) == party:key_of(b), "Ann ve Bob aynı partide")
	expect(party:is_leader(a) and not party:is_leader(b) and party:leader_of(b) == a, "lider Ann")
	expect(#sent[a].members == 2 and #sent[b].members == 2 and sent[b].invites[1] == nil, "ikisi de partiyi görür; davet gider")
	expect(string.sub(party:key_of(a), 1, 3) == "S1:", "anahtar sunucunun önekini taşır")
	party:invite(a, c)
	party:decline(c, 1)
	expect(#sent[c].invites == 0 and party:key_of(c) == nil, "Cat reddeder")
	clock += 10
	party:invite(a, c)
	party:accept(c, 1)
	party:invite(a, d)
	party:accept(d, 1)
	expect(#party:members(a) == 4, "4 kişilik parti")
	local f = player(6, "Fay")
	party:invite(e, f)
	clock += Party.INVITE_TTL_S + 1
	expect(not party:accept(f, 5), "davetin süresi dolar")
	party:leave(a)
	expect(party:key_of(a) == nil and party:is_leader(b) and #party:members(b) == 3, "lider ayrılır: Bob 3 kişiye liderlik eder")
	party:kick(b, 3)
	expect(party:key_of(c) == nil and #party:members(b) == 2, "Bob, Cat'i çıkarır")
	party:kick(d, 2)
	expect(party:key_of(b) ~= nil, "lider olmayan kimseyi çıkaramaz")
	party:removed(d)
	expect(party:key_of(b) == nil and #sent[b].members == 0, "Dan sunucudan çıkar: Bob tek, parti yok")
	party:invite(a, b)
	party:accept(b, 1)
	party:invite(c, b)
	party:accept(b, 3)
	expect(party:key_of(b) == party:key_of(c) and party:key_of(a) == nil, "Bob, Ann'in partisinden Cat'inkine geçer")
	local g, h = player(7, "Gus"), player(8, "Hal")
	party:join_roblox_party(h, { g, h })
	expect(party:key_of(g) ~= nil and party:key_of(g) == party:key_of(h) and party:is_leader(g), "Roblox partisi: tek parti, ilk gelen lider")
	local i, j = player(9, "Ivy"), player(10, "Jon")
	party:arrived(i, "S0:10:1", 10)
	party:arrived(j, "S0:10:1", 10)
	expect(party:key_of(i) == "S0:10:1" and party:key_of(j) == "S0:10:1" and party:is_leader(j), "maçtan dönüş: aynı parti, lider Jon")
	do
		local big = Party.new({ send = function() end, now = function()
			return clock
		end, prefix = "S2:" })
		local lead = player(100, "Lead")
		for k = 1, Party.MAX_SIZE - 1 do
			local p = player(100 + k, "P" .. k)
			big:invite(lead, p)
			big:accept(p, 100)
		end
		expect(#big:members(lead) == 8, "8 kişilik parti")
		local ok, why = big:invite(lead, player(200, "Ninth"))
		expect(not ok and why ~= nil and string.find(why, "8", 1, true) ~= nil, "dokuzuncu davet edilemez: " .. tostring(why))
	end
	do
		-- ikisi aynı anda birbirini davet eder, biri kabul eder: öbüründeki davet de kaybolur
		local sent2 = {}
		local pp = Party.new({ send = function(p, s)
			sent2[p] = s
		end, now = function()
			return clock
		end, prefix = "S3:" })
		local x, y = player(300, "X"), player(301, "Y")
		pp:invite(x, y)
		pp:invite(y, x)
		pp:accept(y, 300)
		expect(pp:key_of(x) == pp:key_of(y) and #sent2[x].invites == 0 and #sent2[y].invites == 0, "karşılıklı davet: kabul edilince ikisinde de davet kalmaz")
	end
	return { passed = passed, failed = failed, lines = lines }
end

return PartyTests
]]></ProtectedString>
