					<ProtectedString name="Source"><![CDATA[--!strict
-- MapData: RLE ile sıkıştırılmış harita verisi <-> terrain buffer'ı <-> ağ paketi.
-- Sunucu ve istemci ortak kullanır. Roblox API'si yok, başka modül yok.

export type RunMap = {
	width: number,
	height: number,
	-- Düz dizi: { değer1, uzunluk1, değer2, uzunluk2, ... } (satır satır, soldan sağa)
	runs: { number },
}

local RUN_BYTES = 5 -- u8 değer + u32 uzunluk

local MapData = {}

function MapData.decode(data: RunMap): buffer
	local size = data.width * data.height
	local out = buffer.create(size)
	local runs = data.runs
	assert(#runs % 2 == 0, "runs must have an even number of elements")

	local pos = 0
	for k = 1, #runs, 2 do
		local value = runs[k]
		local length = runs[k + 1]
		assert(value >= 0 and value <= 255, "terrain value must be 0-255")
		assert(length > 0, "run length must be positive")
		assert(pos + length <= size, "runs exceed map size")
		buffer.fill(out, pos, value, length)
		pos += length
	end
	assert(pos == size, "runs shorter than map")
	return out
end

-- Test ve araçlar için: terrain buffer'ını { değer, uzunluk, ... } dizisine çevirir.
function MapData.encode(terrain: buffer): { number }
	local size = buffer.len(terrain)
	local runs: { number } = {}
	if size == 0 then
		return runs
	end
	local current = buffer.readu8(terrain, 0)
	local length = 1
	for i = 1, size - 1 do
		local v = buffer.readu8(terrain, i)
		if v == current then
			length += 1
		else
			table.insert(runs, current)
			table.insert(runs, length)
			current = v
			length = 1
		end
	end
	table.insert(runs, current)
	table.insert(runs, length)
	return runs
end

-- Ağ için: runs dizisini kompakt buffer'a yazar (run başına 5 bayt).
function MapData.pack(runs: { number }): buffer
	assert(#runs % 2 == 0, "runs must have an even number of elements")
	local count = #runs // 2
	local out = buffer.create(count * RUN_BYTES)
	for r = 0, count - 1 do
		buffer.writeu8(out, r * RUN_BYTES, runs[r * 2 + 1])
		buffer.writeu32(out, r * RUN_BYTES + 1, runs[r * 2 + 2])
	end
	return out
end

function MapData.unpack(packed: buffer): { number }
	local len = buffer.len(packed)
	assert(len % RUN_BYTES == 0, "invalid packet length")
	local runs: { number } = table.create(len // RUN_BYTES * 2, 0)
	for r = 0, len // RUN_BYTES - 1 do
		runs[r * 2 + 1] = buffer.readu8(packed, r * RUN_BYTES)
		runs[r * 2 + 2] = buffer.readu32(packed, r * RUN_BYTES + 1)
	end
	return runs
end

-- Gerçek harita (tools/make_world_map.py, tools/make_region_maps.py): base64 + RLE(değer, varint uzunluk-1) -> tile baytı buffer'ı.
-- Tile baytı: bit7 kara, bit6 kıyı, bit5 okyanus, bit0-4 yükseklik/derinlik.
local B64 = {} :: { [number]: number }
do
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, #alphabet do
		B64[string.byte(alphabet, i)] = i - 1
	end
end

-- pace (isteğe bağlı): uzun döngülerde ara ara çağrılır (çağıran kare bütçesi dolunca bekleyebilir: menü arka planı donmasın).
function MapData.decodeWorld(folder: Instance, size: number, pace: (() -> ())?): buffer
	local values = folder:GetChildren()
	table.sort(values, function(a: Instance, b: Instance)
		return a.Name < b.Name
	end)
	local chunks: { string } = {}
	for _, v in values do
		chunks[#chunks + 1] = (v :: StringValue).Value
	end
	return MapData.decodeChunks(chunks, size, pace)
end

function MapData.decodeChunks(chunks: { string }, size: number, pace: (() -> ())?): buffer
	local text = table.concat(chunks)
	local bytes = buffer.create(math.floor(#text / 4) * 3 + 3)
	local n = 0
	local acc, bits = 0, 0
	for i = 1, #text do
		local c = string.byte(text, i)
		if c == 61 then -- '='
			break
		end
		if pace and i % 32768 == 0 then
			pace()
		end
		acc = acc * 64 + (B64[c] or 0)
		bits += 6
		if bits >= 8 then
			bits -= 8
			local div = 2 ^ bits
			local b = math.floor(acc / div)
			acc -= b * div
			buffer.writeu8(bytes, n, b)
			n += 1
		end
	end
	local out = buffer.create(size)
	local pos, k = 0, 0
	local runs = 0
	while k < n do
		local value = buffer.readu8(bytes, k)
		k += 1
		local length, shift = 0, 0
		while true do
			local b = buffer.readu8(bytes, k)
			k += 1
			length += bit32.band(b, 0x7F) * 2 ^ shift
			if b < 0x80 then
				break
			end
			shift += 7
		end
		length += 1
		assert(pos + length <= size, "map data exceeds size")
		buffer.fill(out, pos, value, length)
		pos += length
		runs += 1
		if pace and runs % 8192 == 0 then
			pace()
		end
	end
	assert(pos == size, "map data incomplete")
	return out
end

-- Tile baytından oyun arazi kodu: 0 su, 1 ova (yükseklik<10), 2 yayla (<20), 3 dağ.
function MapData.gameplay(tileBytes: buffer, pace: (() -> ())?): buffer
	local size = buffer.len(tileBytes)
	local out = buffer.create(size)
	for i = 0, size - 1 do
		if pace and i % 65536 == 0 then
			pace()
		end
		local b = buffer.readu8(tileBytes, i)
		if bit32.band(b, 0x80) ~= 0 then
			local m = bit32.band(b, 0x1F)
			buffer.writeu8(out, i, if m < 10 then 1 elseif m < 20 then 2 else 3)
		end
	end
	return out
end

return MapData
]]></ProtectedString>
