				<Item class="ModuleScript" referent="RBXB3F9F0C2694740D09C5BA3509FB07397">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Drip: sunucudan gelen tile değişimlerini repo istemcisi gibi zamana yayarak uygular (repo TerritoryPass
-- applyLiveDelta + drainDripBucket, render-settings tileDrip.bucketCount = 9).
--
--   * Paket birkaç tick'lik değişim taşır (Delta segmentleri). Her segment 100 ms arayla "gelir" (repo istemcisi
--     değişimleri tick tick alır), böylece cephe tick tick, katman katman ilerler; paket içi karışmaz.
--   * Gelen segmentin her tile'ı karma (tile * 2654435761 mod 2^32 mod 9) ile 9 kovadan birine girer. Kovalar
--     sırayla, saniyede 60 kova boşaltılır (repo: her 60 Hz karede bir kova). Böylece bir tick'in tile'ları ~150 ms'de
--     dağınık noktalar halinde belirir; aynı tile hep aynı kovaya düştüğü için sıra bozulmaz, son sahip kazanır.
--   * Başlangıç fazında her şey anında uygulanır (repo flushAllDripBuckets).
-- Roblox API'si kullanmaz (testlenebilir).

local Drip = {}
Drip.__index = Drip

type Segment = { at: number, tiles: { number }, owners: { number }, from: number, to: number }

export type Drip = typeof(setmetatable(
	{} :: {
		apply: (tile: number, owner: number) -> (),
		n: number, -- kova sayısı
		frame: number, -- kova başına süre (sn)
		tick: number, -- segmentler arası süre (sn)
		maxLag: number, -- bu kadar geride kalınırsa bekleyenler hemen kovaya alınır
		buckets: { { number } }, -- tile, sahip, tile, sahip ...
		cur: number, -- sıradaki boşaltılacak kova (1..n)
		acc: number,
		pending: { Segment },
		pendHead: number,
		pendTail: number, -- nil ile tüketilen kuyruğun sonu; #pending seyrek tabloda güvenilir değildir
		lastAt: number,
		queued: number, -- kovalardaki tile sayısı
	},
	Drip
))

function Drip.new(apply: (tile: number, owner: number) -> (), bucketCount: number?, frame: number?, tick: number?): Drip
	local n = math.max(1, bucketCount or 9)
	local buckets: { { number } } = {}
	for i = 1, n do
		buckets[i] = {}
	end
	return setmetatable({
		apply = apply,
		n = n,
		frame = frame or 1 / 60,
		tick = tick or 0.1,
		maxLag = 0.6,
		buckets = buckets,
		cur = 1,
		acc = 0,
		pending = {},
		pendHead = 1,
		pendTail = 0,
		lastAt = -math.huge,
		queued = 0,
	}, Drip)
end

-- Kova numarası (1..n): repo ((ref * 2654435761) >>> 0) % N
function Drip.bucketOf(self: Drip, tile: number): number
	return (tile * 2654435761) % 4294967296 % self.n + 1
end

local function enqueue(self: Drip, s: Segment)
	local buckets, n = self.buckets, self.n
	local tiles, owners = s.tiles, s.owners
	for k = s.from, s.to do
		local t = tiles[k]
		local b = buckets[(t * 2654435761) % 4294967296 % n + 1]
		b[#b + 1] = t
		b[#b + 1] = owners[k]
	end
	self.queued += s.to - s.from + 1
end

-- Bekleyen tüm segmentleri sırasıyla kovalara alır.
local function takeAll(self: Drip)
	local p = self.pending
	for i = self.pendHead, self.pendTail do
		enqueue(self, p[i])
	end
	table.clear(p)
	self.pendHead = 1
	self.pendTail = 0
end

-- Yeni paket: segs = artan segment sonları (Delta.unpack). `now` saniye.
function Drip.push(self: Drip, tiles: { number }, owners: { number }, count: number, segs: { number }?, now: number)
	if count <= 0 then
		return
	end
	local ends = segs or { count }
	-- çok geride kaldıysak (paket yığılması) bekleyenleri hemen kovaya al: sıra korunur, gecikme büyümez
	local first = math.max(now, self.lastAt + self.tick)
	if first - now > self.maxLag then
		takeAll(self)
		self.lastAt = now - self.tick
	end
	local prev = 0
	for k, e in ends do
		if e > prev then
			local at = math.max(now + (k - 1) * self.tick, self.lastAt + self.tick)
			self.pendTail += 1
			self.pending[self.pendTail] = { at = at, tiles = tiles, owners = owners, from = prev + 1, to = math.min(e, count) }
			self.lastAt = at
			prev = e
		end
	end
end

local function drainOne(self: Drip): number
	local b = self.buckets[self.cur]
	local n = #b
	if n > 0 then
		local apply = self.apply
		for i = 1, n, 2 do
			apply(b[i], b[i + 1])
		end
		table.clear(b)
		self.queued -= n // 2
	end
	self.cur = self.cur % self.n + 1
	return n // 2
end

-- Her kare: zamanı gelen segmentleri kovalara alır, geçen süre kadar kova boşaltır. Uygulanan tile sayısını döner.
function Drip.step(self: Drip, now: number, dt: number): number
	local p = self.pending
	while self.pendHead <= self.pendTail and p[self.pendHead].at <= now do
		enqueue(self, p[self.pendHead])
		p[self.pendHead] = nil :: any
		self.pendHead += 1
	end
	if self.pendHead > self.pendTail then
		table.clear(p)
		self.pendHead = 1
		self.pendTail = 0
	elseif self.pendHead > 64 then
		-- Sürekli trafik kuyruğu hiç boşaltmasa da indeksler/bellek büyümesin.
		local count = self.pendTail - self.pendHead + 1
		table.move(p, self.pendHead, self.pendTail, 1)
		for i = count + 1, self.pendTail do
			p[i] = nil :: any
		end
		self.pendHead = 1
		self.pendTail = count
	end
	local applied = 0
	self.acc += math.max(0, dt)
	local drains = 0
	while self.acc >= self.frame and drains < self.n do
		self.acc -= self.frame
		drains += 1
		applied += drainOne(self)
	end
	if drains >= self.n then
		self.acc = 0 -- uzun kare: bir tur boşalttık, birikmeyi sıfırla
	end
	return applied
end

-- Her şeyi hemen uygular (başlangıç fazı, yeniden eşitleme). Uygulanan tile sayısını döner.
function Drip.flush(self: Drip): number
	takeAll(self)
	local applied = 0
	for _ = 1, self.n do
		applied += drainOne(self)
	end
	self.acc = 0
	return applied
end

-- Bekleyenleri uygulamadan atar (tam durum yüklenince).
function Drip.clear(self: Drip)
	table.clear(self.pending)
	self.pendHead = 1
	self.pendTail = 0
	for _, b in self.buckets do
		table.clear(b)
	end
	self.queued = 0
	self.acc = 0
	self.lastAt = -math.huge
end

function Drip.busy(self: Drip): boolean
	return self.queued > 0 or self.pendHead <= self.pendTail
end

return Drip
]]></ProtectedString>
						<string name="ScriptGuid">{4BED1235-A862-4A33-A69A-59391466C7E2}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
