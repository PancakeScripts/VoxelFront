					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- NetTests: online ağ sıkıştırması (Shared.Delta sıkı biçim, Shared.NetDiff). Çözülen veri gönderilenle birebir aynı olmalı.
-- Oyunda çalışmaz; Studio'da elle: require(game.ServerScriptService.Server.Dev.NetTests).run()  -> { passed, failed, lines }

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Delta = require(Shared:WaitForChild("Delta"))
local NetDiff = require(Shared:WaitForChild("NetDiff"))
local Http = game:GetService("HttpService")

local NetTests = {}

local function deepEq(a: any, b: any): boolean
	if type(a) ~= "table" or type(b) ~= "table" then
		return a == b
	end
	for k, v in a do
		if not deepEq(v, b[k]) then
			return false
		end
	end
	for k in b do
		if a[k] == nil then
			return false
		end
	end
	return true
end

local function byKey(list: { any }, key: string): { [any]: any }
	local m = {}
	for _, e in list do
		m[e[key]] = e
	end
	return m
end

function NetTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end
	local rng = Random.new(7)

	-- Delta: sıkı biçim çözülünce her segmentte aynı (tile, sahip) çiftleri; normal biçim aynen çalışır
	do
		local W = 2000 * 1061
		local ok_all, saved, total = true, 0, 0
		for trial = 1, 40 do
			local count = if trial == 1 then 0 else rng:NextInteger(1, 3000)
			local tiles, owners = {}, {}
			local used = {}
			local segs = {}
			local nseg = rng:NextInteger(1, 3)
			for k = 1, count do
				local t
				repeat
					-- kümeler (cephe) + rastgele uzak tile'lar
					t = if rng:NextNumber() < 0.8 then (rng:NextInteger(0, 50) * 2000 + rng:NextInteger(0, 60) + 500000) else rng:NextInteger(0, W - 1)
				until not used[t]
				used[t] = true
				tiles[k] = t
				owners[k] = if rng:NextNumber() < 0.05 then 0x8000 elseif rng:NextNumber() < 0.1 then 0 else rng:NextInteger(1, 300)
			end
			for k = 1, nseg - 1 do
				segs[k] = math.floor(count * k / nseg)
			end
			segs[nseg] = count
			local plain = Delta.pack(trial, 99, tiles, owners, count, segs)
			local tight = Delta.pack(trial, 99, tiles, owners, count, segs, true)
			saved += buffer.len(tight)
			total += buffer.len(plain)
			local s1, k1, t1, o1, c1, g1 = Delta.unpack(plain)
			local s2, k2, t2, o2, c2, g2 = Delta.unpack(tight)
			if not (s1 == trial and s2 == trial and k2 == 99 and c1 == count and c2 == count and deepEq(g1, g2)) then
				ok_all = false
			else
				-- segment segment aynı çiftler
				local from = 1
				for _, last in g2 do
					local a, b = {}, {}
					for i = from, last do
						a[t1[i]] = o1[i]
						b[t2[i]] = o2[i]
					end
					if not deepEq(a, b) then
						ok_all = false
					end
					from = last + 1
				end
			end
		end
		expect(ok_all, "Delta: sıkı biçim normal biçimle aynı değişimleri verir (40 paket, boş paket dahil)")
		expect(saved < total * 0.6, string.format("Delta: sıkı biçim %.0f%% boyutta", saved / total * 100))
		local bad = Delta.pack(1, 1, { 5, 9 }, { 3, 3 }, 2, nil, true)
		local cut = buffer.create(buffer.len(bad) - 1)
		buffer.copy(cut, 0, bad, 0, buffer.len(cut))
		expect(Delta.unpack(cut) == nil, "Delta: eksik sıkı paket reddedilir")
	end

	-- NetDiff: fark paketleri tam listeyi aynen kurar
	do
		local enc = NetDiff.encoder("tile")
		local dec = NetDiff.decoder("tile")
		local cur: { [number]: any } = {}
		local function snapshot()
			local list = {}
			for _, e in cur do
				table.insert(list, table.clone(e))
			end
			return list
		end
		local ok_all, before = true, true
		local diffBytes, fullBytes = 0, 0
		for step = 1, 60 do
			-- değişim: ekle, sil, alan değiştir, alan sil (çubuk biter), tablo alan
			for _ = 1, 30 do
				local tile = rng:NextInteger(1, 400)
				local r = rng:NextNumber()
				if cur[tile] == nil then
					cur[tile] = { tile = tile, type = "city", pid = rng:NextInteger(1, 50), level = 1, ready = false, q = 0, p = 0, d = 20, bar = "build", bb = { 1, 2, 3, 4 } }
				elseif r < 0.1 then
					cur[tile] = nil
				elseif r < 0.4 then
					cur[tile].p = nil
					cur[tile].d = nil
					cur[tile].bar = nil
					cur[tile].ready = true
				elseif r < 0.6 then
					cur[tile].bb = { rng:NextInteger(1, 9), 2, 3, 4 }
				else
					cur[tile].level += 1
				end
			end
			local list = snapshot()
			local d = enc.diff(list)
			diffBytes += #Http:JSONEncode(d)
			fullBytes += #Http:JSONEncode(list)
			if step == 1 then
				before = dec.apply(d) == nil -- taban yokken fark paketi kullanılmaz
				dec.apply(enc.full())
			else
				local prev = dec.byId and dec.byId[next(dec.byId)]
				local prevCopy = prev and table.clone(prev)
				local got = dec.apply(d)
				if got == nil or not deepEq(byKey(got, "tile"), byKey(list, "tile")) or #got ~= #list then
					ok_all = false
				end
				if prev and not deepEq(prev, prevCopy) then
					ok_all = false -- oyun kodunun elindeki eski kayıt değişmemeli
				end
			end
		end
		expect(before, "NetDiff: tabanı olmayan istemci fark paketini kullanmaz")
		expect(ok_all, "NetDiff: 60 fark paketi tam listeyi aynen kurar; eski kayıtlar değişmez")
		expect(diffBytes < fullBytes * 0.5, string.format("NetDiff: fark paketleri tam listenin %.0f%%'i", diffBytes / fullBytes * 100))
		-- sıra atlanırsa (kayıp) uygulanmaz; sonraki tam paket düzeltir
		local skipped = enc.diff(snapshot())
		local after = enc.diff(snapshot())
		expect(dec.apply(after) == nil, "NetDiff: atlanan paketten sonrakini uygulamaz")
		local full = dec.apply(enc.full())
		expect(full ~= nil and deepEq(byKey(full, "tile"), byKey(snapshot(), "tile")), "NetDiff: tam paket tabanı yeniden kurar")
		expect(dec.apply(after) == nil and skipped ~= nil, "NetDiff: eski fark paketi tam paketten sonra yok sayılır")
	end

	-- gemiler: yalnız konumu değişenler tamponda; liste aynen kurulur
	do
		local packed = NetDiff.encoder("id", "tile")
		local plain = NetDiff.encoder("id")
		local dec = NetDiff.decoder("id")
		local ships: { [number]: any } = {}
		local nextId = 1
		local ok_all, pb, qb, inBuffer = true, 0, 0, 0
		for step = 1, 80 do
			for _ = 1, 4 do
				local sid = if nextId % 3 == 0 then nextId else -nextId -- (ticaret gemilerinin kimliği eksi)
				ships[sid] = { id = sid, pid = rng:NextInteger(1, 200), tile = rng:NextInteger(0, 2000000), k = rng:NextInteger(1, 6), hp = if rng:NextNumber() < 0.3 then 100 else nil, dst = rng:NextInteger(0, 2000000) }
				nextId += 1
			end
			for id, s in ships do
				local r = rng:NextNumber()
				if r < 0.05 then
					ships[id] = nil
				elseif r < 0.85 then
					s.tile += rng:NextInteger(-2002, 2002)
					if s.tile < 0 then
						s.tile = 0
					end
					if r < 0.1 and s.hp then
						s.hp -= 5 -- (konum + can: tamponda değil)
					end
				elseif r < 0.87 then
					s.tile += 0.5 -- (kesirli: tampona girmez)
				end
			end
			local list = {}
			for _, s in ships do
				table.insert(list, table.clone(s))
			end
			local d = packed.diff(list)
			local q = plain.diff(list)
			pb += #Http:JSONEncode(d.u) + (if d.m then buffer.len(d.m) else 0)
			qb += #Http:JSONEncode(q.u)
			if d.m then
				inBuffer += 1
			end
			if step == 1 then
				dec.apply(packed.full())
			else
				local got = dec.apply(d)
				if got == nil or #got ~= #list or not deepEq(byKey(got, "id"), byKey(list, "id")) then
					ok_all = false
				end
			end
		end
		expect(ok_all and inBuffer > 70, "gemiler: konum tamponuyla 80 paket listeyi aynen kurar (eksi kimlik, kesirli konum, can değişimi, yeni ve batan gemi dahil)")
		expect(pb < qb * 0.6, string.format("gemiler: konum tamponu fark paketinin %.0f%%'i", pb / qb * 100))
	end

	-- inbound: sıkıştırılmamış (solo) paket olduğu gibi geçer
	do
		local netIn = NetDiff.inbound()
		local raw = { players = { { pid = 1 } }, structs = {} }
		expect(netIn.stats(raw) == raw and netIn.boats({ { id = 1 } })[1].id == 1, "inbound: solo paketleri değişmeden geçer")
		local encP, encS = NetDiff.encoder("pid"), NetDiff.encoder("tile")
		local d1 = { z = 1, phase = "run", players = encP.diff({ { pid = 1, troops = 5 } }), structs = encS.diff({}) }
		expect(netIn.stats(d1) == nil, "inbound: taban yokken istatistik bekletilir")
		local f1 = { z = 1, phase = "run", players = encP.full(), structs = encS.full() }
		local got = netIn.stats(f1)
		expect(got and got.players[1].troops == 5 and got.phase == "run" and got.z == nil, "inbound: tam istatistik paketi kurulur")
		local d2 = { z = 1, phase = "run", players = encP.diff({ { pid = 1, troops = 9 }, { pid = 2, troops = 1 } }), structs = encS.diff({ { tile = 4, type = "city" } }) }
		local got2 = netIn.stats(d2)
		expect(got2 and #got2.players == 2 and got2.players[1].troops == 9 and got2.structs[1].type == "city", "inbound: fark paketi uygulanır")
	end

	return { passed = passed, failed = failed, lines = lines }
end

return NetTests
]]></ProtectedString>
						<string name="ScriptGuid">{07CAD54B-1074-4986-8F73-F33F86C2EA27}</string>
