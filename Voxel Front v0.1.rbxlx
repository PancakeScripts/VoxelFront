				<Item class="ModuleScript" referent="RBXB4A57A6AADF148B8801ABEF917534B1D">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Diplomacy: ittifak, hain, ambargo ve ilişkiler (OpenFront kuralları).
--   * İstek: aynı kişiye 30 sn'de bir; 20 sn içinde cevaplanmazsa reddedilir. Karşı taraf zaten sana istek yolladıysa direkt kabul.
--   * İttifak 5 dk sürer; bitmeden son 30 sn'de iki taraf da "yenile" derse 5 dk daha uzar.
--   * Müttefike saldırılamaz; sürmekte olan saldırı ittifak kurulunca geri çekilir.
--   * İttifakı bozan, karşısındaki hain değilse 30 sn "hain" olur: hainin saldırıdan kaybı x0.5, toprağı x0.8 sürede alınır.
--     Bozulan taraf bozana -100, bozanın komşuları -40 ilişki.
--   * Birine saldıran, saldırdığı kişiden 5 dk geçici ambargo yer; ambargo ticareti durdurur.
--   * İlişki -100..100; tick başına 0.05 sıfıra yaklaşır (okurken hesaplanır). < -50 düşman, < 0 güvensiz, < 50 nötr, aksi dost.
--   * Takım maçı (Core/Teams): aynı takımdakiler kalıcı dosttur (isAllied true) ama bu bir ittifak değildir:
--     istek, bozma, yenileme ve ambargo onlara uygulanmaz (allianceOf nil).

local D = {}

local function key(a: number, b: number): number
	return a * 65536 + b
end

function D.init(sim: any)
	sim.dip = {
		alliances = {},
		allyMap = {},
		requests = {},
		lastReq = {},
		traitorAt = {},
		embargo = {},
		rel = {},
	}
end

local function pairKey(a: number, b: number): number
	return if a < b then key(a, b) else key(b, a)
end

function D.sameTeam(sim: any, a: number, b: number): boolean
	local t = sim.team and sim.team[a]
	return a ~= b and t ~= nil and t ~= 0 and t == sim.team[b]
end

-- Müttefik ya da takım arkadaşı (birbirine saldıramaz).
function D.isAllied(sim: any, a: number, b: number): boolean
	return a ~= b and (sim.dip.allyMap[pairKey(a, b)] ~= nil or D.sameTeam(sim, a, b))
end

function D.allianceOf(sim: any, a: number, b: number): any?
	return sim.dip.allyMap[pairKey(a, b)]
end

function D.alliesOf(sim: any, pid: number): { number }
	local out: { number } = {}
	for _, al in sim.dip.alliances do
		if al.a == pid then
			out[#out + 1] = al.b
		elseif al.b == pid then
			out[#out + 1] = al.a
		end
	end
	table.sort(out)
	return out
end

function D.isTraitor(sim: any, pid: number): boolean
	local t = sim.dip.traitorAt[pid]
	return t ~= nil and sim.tickNo - t < sim.cfg.TRAITOR_TICKS
end

-- İlişki ----------------------------------------------------------------------------

function D.relation(sim: any, a: number, b: number): number
	local r = sim.dip.rel[a]
	local e = r and r[b]
	if not e then
		return 0
	end
	local v = e.v
	local dec = 0.05 * (sim.tickNo - e.t)
	local mag = math.abs(v) - dec
	if mag < 0.1 then
		return 0
	end
	return if v < 0 then -mag else mag
end

-- 0 düşman, 1 güvensiz, 2 nötr, 3 dost
function D.relLevel(v: number): number
	if v < -50 then
		return 0
	elseif v < 0 then
		return 1
	elseif v < 50 then
		return 2
	end
	return 3
end

function D.updateRelation(sim: any, a: number, b: number, delta: number)
	if a == b then
		return
	end
	local v = math.clamp(D.relation(sim, a, b) + delta, -100, 100)
	local r = sim.dip.rel[a]
	if not r then
		r = {}
		sim.dip.rel[a] = r
	end
	r[b] = { v = v, t = sim.tickNo }
end

-- Ambargo ---------------------------------------------------------------------------

function D.hasEmbargo(sim: any, a: number, b: number): boolean
	local e = sim.dip.embargo[a]
	return e ~= nil and e[b] ~= nil
end

function D.canTrade(sim: any, a: number, b: number): boolean
	return a ~= b and not D.hasEmbargo(sim, a, b) and not D.hasEmbargo(sim, b, a)
end

function D.addEmbargo(sim: any, pid: number, other: number, temporary: boolean)
	local m = sim.dip.embargo[pid]
	if not m then
		m = {}
		sim.dip.embargo[pid] = m
	end
	local cur = m[other]
	if cur and not cur.temp then
		return -- elle konmuş ambargo temporary ile ezilmez
	end
	m[other] = { created = sim.tickNo, temp = temporary }
end

function D.stopEmbargo(sim: any, pid: number, other: number)
	local m = sim.dip.embargo[pid]
	if m then
		m[other] = nil
	end
end

local function endTemporary(sim: any, pid: number, other: number)
	local m = sim.dip.embargo[pid]
	if m and m[other] and m[other].temp then
		m[other] = nil
	end
end

-- İstekler --------------------------------------------------------------------------

function D.findRequest(sim: any, from: number, to: number): any?
	for _, r in sim.dip.requests do
		if r.from == from and r.to == to then
			return r
		end
	end
	return nil
end

local function removeRequest(sim: any, req: any)
	local i = table.find(sim.dip.requests, req)
	if i then
		table.remove(sim.dip.requests, i)
	end
end

-- (olur mu, neden)
function D.canSendRequest(sim: any, a: number, b: number): (boolean, string)
	if a == b or not sim.alive[a] or not sim.alive[b] or not sim.spawned[a] or not sim.spawned[b] then
		return false, "allyNo"
	end
	if sim.isBot[b] and not sim.isNation[b] then
		return false, "allyBot"
	end
	if D.isAllied(sim, a, b) then
		return false, "allyNo"
	end
	if D.findRequest(sim, a, b) then
		return false, "allyNo"
	end
	if D.findRequest(sim, b, a) then
		return true, ""
	end
	local last = sim.dip.lastReq[key(a, b)]
	if last and sim.tickNo - last < sim.cfg.ALLIANCE_COOLDOWN_TICKS then
		return false, "allyWait"
	end
	return true, ""
end

local function createAlliance(sim: any, a: number, b: number)
	local al = { a = a, b = b, created = sim.tickNo, expires = sim.tickNo + sim.cfg.ALLIANCE_TICKS, extA = false, extB = false }
	table.insert(sim.dip.alliances, al)
	sim.dip.allyMap[pairKey(a, b)] = al
	D.updateRelation(sim, a, b, 100)
	D.updateRelation(sim, b, a, 100)
	endTemporary(sim, a, b)
	endTemporary(sim, b, a)
	sim:emit(a, "allyNew")
	sim:emit(b, "allyNew")
end

function D.accept(sim: any, req: any)
	removeRequest(sim, req)
	if not D.isAllied(sim, req.from, req.to) then
		createAlliance(sim, req.from, req.to)
	end
end

function D.reject(sim: any, req: any)
	removeRequest(sim, req)
	sim:emit(req.from, "allyRejected")
end

function D.sendRequest(sim: any, a: number, b: number): boolean
	local ok, why = D.canSendRequest(sim, a, b)
	if not ok then
		sim:emit(a, why)
		return false
	end
	local incoming = D.findRequest(sim, b, a)
	if incoming then
		D.accept(sim, incoming)
		return true
	end
	sim.dip.lastReq[key(a, b)] = sim.tickNo
	table.insert(sim.dip.requests, { from = a, to = b, created = sim.tickNo })
	return true
end

-- Bitiş / bozma ----------------------------------------------------------------------

local function detach(sim: any, al: any)
	local i = table.find(sim.dip.alliances, al)
	if i then
		table.remove(sim.dip.alliances, i)
	end
	sim.dip.allyMap[pairKey(al.a, al.b)] = nil
end

-- pid'nin kara sınırı olan oyuncular (sıralı).
function D.bordering(sim: any, pid: number): { number }
	local world = sim.world
	local seen: { [number]: boolean } = {}
	local list: { number } = {}
	local nb: { number } = {}
	for t in world:borderOf(pid) do
		local n = world:neighbors(t, nb)
		for k = 1, n do
			local o = world:ownerAt(nb[k])
			if o ~= 0 and o ~= pid and not seen[o] and sim.alive[o] then
				seen[o] = true
				list[#list + 1] = o
			end
		end
	end
	table.sort(list)
	return list
end

function D.breakAlliance(sim: any, breaker: number, other: number)
	local al = D.allianceOf(sim, breaker, other)
	if not al then
		return
	end
	detach(sim, al)
	if not D.isTraitor(sim, other) then
		sim.dip.traitorAt[breaker] = sim.tickNo
	end
	D.updateRelation(sim, other, breaker, -100)
	for _, n in D.bordering(sim, breaker) do
		if n ~= other then
			D.updateRelation(sim, n, breaker, -40)
		end
	end
	sim:emit(other, "allyBroken")
end

function D.extend(sim: any, pid: number, other: number)
	local al = D.allianceOf(sim, pid, other)
	if not al or not sim.alive[pid] or not sim.alive[other] then
		return
	end
	if al.expires - sim.tickNo > sim.cfg.ALLIANCE_EXT_WINDOW then
		sim:emit(pid, "allyNoExt")
		return
	end
	if al.a == pid then
		al.extA = true
	else
		al.extB = true
	end
	if al.extA and al.extB then
		al.extA, al.extB = false, false
		al.expires = sim.tickNo + sim.cfg.ALLIANCE_TICKS
		sim:emit(pid, "allyRenewed")
		sim:emit(other, "allyRenewed")
	else
		sim:emit(other, "allyRenewAsk", pid) -- ("X wants to renew your alliance")
	end
end

-- Oyuncu elendi / ayrıldı / tur bitti: sessizce temizle.
function D.removePlayer(sim: any, pid: number)
	for i = #sim.dip.alliances, 1, -1 do
		local al = sim.dip.alliances[i]
		if al.a == pid or al.b == pid then
			detach(sim, al)
		end
	end
	for i = #sim.dip.requests, 1, -1 do
		local r = sim.dip.requests[i]
		if r.from == pid or r.to == pid then
			table.remove(sim.dip.requests, i)
		end
	end
end

function D.tick(sim: any)
	local cfg = sim.cfg
	for i = #sim.dip.requests, 1, -1 do
		local r = sim.dip.requests[i]
		if sim.tickNo - r.created > cfg.ALLIANCE_REQUEST_TICKS then
			table.remove(sim.dip.requests, i)
			sim:emit(r.from, "allyNoAnswer", r.to) -- ("X did not answer your alliance request")
		end
	end
	for i = #sim.dip.alliances, 1, -1 do
		local al = sim.dip.alliances[i]
		if al.expires <= sim.tickNo then
			detach(sim, al)
			sim:emit(al.a, "allyExpired")
			sim:emit(al.b, "allyExpired")
		end
	end
	if sim.tickNo % 10 == 0 then
		for pid, m in sim.dip.embargo do
			for other, e in m do
				if e.temp and sim.tickNo - e.created > cfg.EMBARGO_TEMP_TICKS then
					m[other] = nil
				end
			end
		end
	end
end

-- Nation karar mantığı (Medium) -------------------------------------------------------

local function outgoing(sim: any, pid: number): number
	local sum = 0
	for _, a in sim.attackIndex do
		if a.pid == pid then
			sum += a.troops
		end
	end
	return sum
end

-- Koşucu lider: oyuncular (insan + nation) arasında en çok toprağı olan, ikincinin 3 katı ya da fazlası.
local function runawayLeader(sim: any): number?
	local leader, leaderT, runnerT = nil, -1, -1
	for pid = 1, sim.playerCount do
		if sim.alive[pid] and sim.spawned[pid] and (not sim.isBot[pid] or sim.isNation[pid]) then
			local t = sim.world:tilesOwnedBy(pid)
			if t > leaderT then
				runnerT = leaderT
				leader, leaderT = pid, t
			elseif t > runnerT then
				runnerT = t
			end
		end
	end
	if leader and runnerT >= 0 and leaderT >= runnerT * 3 then
		return leader
	end
	return nil
end

local function chance(rng: any, x: number): boolean
	return rng:int(0, x - 1) == 0
end

function D.nationDecision(sim: any, rng: any, me: number, other: number, isResponse: boolean): boolean
	-- Takım maçında gelen isteği zorluğa göre doğrudan reddetme payı (RoWorld SimAI TEAM_REFUSE)
	if isResponse and (sim.teamCount or 0) > 0 and rng:int(0, 99) < sim.cfg.NATION_TEAM_REFUSE then
		return false
	end
	if chance(rng, sim.cfg.NATION_CONFUSED_X) then -- şaşkınlık (zorluğa göre)
		return chance(rng, 2)
	end
	if D.isTraitor(sim, other) and rng:int(0, 99) >= 10 then
		return false
	end
	if runawayLeader(sim) == other then
		return false
	end
	if sim.cfg.NATION_SEES_THREAT and sim.troops[other] > sim.troops[me] * 2.5 then
		return true -- güçlüyü yanına al
	end
	local lvl = D.relLevel(D.relation(sim, me, other))
	if lvl < 2 then
		return false
	end
	if lvl == 3 then
		return true
	end
	if #D.alliesOf(sim, me) >= rng:int(4, 5) then
		return false
	end
	if sim.tickNo < sim.cfg.NATION_EARLY_TICKS + sim.cfg.SPAWN_PHASE_SECONDS * sim.cfg.TICK_RATE and rng:int(0, 99) >= sim.cfg.NATION_EARLY_REFUSE then
		return true
	end
	-- benzer güçte mi?
	local myTotal = sim.troops[me] + outgoing(sim, me)
	local otherTotal = sim.troops[other] + outgoing(sim, other)
	local troopThr = myTotal * (rng:int(70, 79) / 100)
	local tileThr = sim.world:tilesOwnedBy(me) * (rng:int(80, 89) / 100)
	return otherTotal > troopThr or (sim.world:tilesOwnedBy(other) > tileThr and otherTotal > myTotal * 0.5)
end

-- Nation: gelen istekleri cevapla, yenileme isteklerine katıl.
function D.nationRespond(sim: any, rng: any, me: number)
	for i = #sim.dip.requests, 1, -1 do
		local r = sim.dip.requests[i]
		if r.to == me then
			if D.nationDecision(sim, rng, me, r.from, true) then
				D.accept(sim, r)
			else
				D.reject(sim, r)
			end
		end
	end
	for _, al in sim.dip.alliances do
		local other = if al.a == me then al.b elseif al.b == me then al.a else nil
		if other then
			local theyAgreed = if al.a == other then al.extA else al.extB
			local meAgreed = if al.a == me then al.extA else al.extB
			if theyAgreed and not meAgreed and D.nationDecision(sim, rng, me, other, true) then
				D.extend(sim, me, other)
			end
		end
	end
end

-- Nation: komşulara ittifak teklifi (her komşu için 1/30).
function D.nationSend(sim: any, rng: any, me: number, enemies: { number })
	for _, e in enemies do
		if chance(rng, 30) and not (sim.isBot[e] and not sim.isNation[e]) then
			local ok = D.canSendRequest(sim, me, e)
			if ok and D.nationDecision(sim, rng, me, e, false) then
				D.sendRequest(sim, me, e)
			end
		end
	end
end

-- Nation: müttefiki bozup saldırır mı? (Medium kuralları) Bozduysa müttefikin pid'ini döner.
function D.nationBetray(sim: any, me: number, friends: { number }, enemies: { number }): number?
	for _, f in friends do
		if D.allianceOf(sim, me, f) then -- (takım arkadaşı bozulmaz)
			local myT = sim.troops[me]
			if myT >= sim.troops[f] * 10 then
				D.breakAlliance(sim, me, f)
				return f
			end
			if D.isTraitor(sim, f) and sim.troops[f] < myT * 1.2 then
				D.breakAlliance(sim, me, f)
				return f
			end
			if #friends + #enemies == 1 and sim.troops[f] * 3 < myT then
				D.breakAlliance(sim, me, f)
				return f
			end
		end
	end
	return nil
end

return D
]]></ProtectedString>
