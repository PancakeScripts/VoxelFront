					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Hud: oyun arayüzü. Öğeler StarterGui > FrontlineHud'da (src/gui/FrontlineHud.model.json, tools/gen_gui.py ile üretilir);
-- Studio'da boyut / konum / renk / saydamlık serbestçe değiştirilebilir. Kod öğeleri ADLARINA göre bulur, yalnız
-- içeriklerini (yazı, çubuk doluluğu, görünürlük) günceller. Yazılar TextScaled; boyutlar ekran oranına göre.
-- Mobilde (dokunmatik, fare yok) paneller orantılı büyütülür ve klavye tuş numaraları gizlenir.

local Fonts = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Fonts"))
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Assets = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Assets"))
local Icons = require(script.Parent.Icons)
local Shadow = require(script.Parent.Shadow)

local Hud = {}
Hud.__index = Hud

local GOLD = Color3.fromRGB(251, 191, 36)
local NO_GOLD = Color3.fromRGB(248, 113, 113)
local GREEN = Color3.fromRGB(74, 222, 128)
local ORANGE = Color3.fromRGB(251, 146, 60)

-- Yapı çubuğu sırası (repo UnitDisplay): şehir, fabrika, liman, savunma karakolu, füze silosu, SAM, savaş gemisi, atom,
-- hidrojen, MIRV. Klavye kısayolu yalnız ilk Hud.buildKeys (6) binada: 1-6. Savaş gemisi ve bombalar yalnız tıklamayla.
Hud.buildOrder = { "city", "factory", "port", "post", "silo", "sam", "warship", "atom", "hydro", "mirv" }
Hud.buildKeys = 6
Hud.buildNames = {
	city = "City",
	factory = "Factory",
	port = "Port",
	post = "Castle", -- (alt bardaki adı)
	silo = "Missile Silo",
	sam = "SAM Launcher",
	warship = "Warship",
	atom = "Atom Bomb",
	hydro = "Hydrogen Bomb",
	mirv = "MIRV",
}

export type Callbacks = {
	onBuild: (id: string) -> (),
	onFocus: () -> (),
	onHoverBuild: (id: string?) -> (), -- fare yapı düğmesine girince / çıkınca (repo: ilgili yapıları vurgular)
	onRatio: (ratio: number) -> (),
	onDiplo: (kind: string) -> (),
	onCancel: (target: number) -> (),
	onRequest: (from: number, accept: boolean) -> (),
	onCard: (kind: string) -> (), -- mobil hedef kartı: "attack" | "more" | "close"
	onBuildConfirm: (ok: boolean) -> (), -- mobil kurma onayı penceresi
}

export type BuildItem = { id: string, key: number, label: string, short: string, color: Color3, cost: number, costText: string, count: number, afford: boolean, selected: boolean, noSilo: boolean? }
export type BoardRow = { rank: number, name: string, pct: string, troops: string, color: Color3, mine: boolean, tag: string }
export type DiploModel = { name: string, color: Color3, troops: string, relation: string, lines: { string }?, buttons: { { text: string, kind: string, color: Color3 } } }
export type HoverModel = { name: string, color: Color3, tag: string?, tagColor: Color3?, kind: string, troops: string, land: string, gold: string?, hint1: string?, hint2: string? }
export type RequestRow = { from: number, name: string, left: number }
export type AttackRow = { text: string, incoming: boolean, target: number?, key: string }
export type Mine = { troops: string, max: string, fill: number, out: string, outCount: number, gold: string, ratio: number, ratioTroops: string, rate: string?, rising: boolean?, goldRate: string? }
export type TargetModel = { name: string, color: Color3, tag: string, tagColor: Color3, sub: string, attack: string, canAttack: boolean }
export type Control = { myPct: number, myColor: Color3, myName: string?, leaderPct: number, leaderName: string, leaderColor: Color3, meLeader: boolean }

export type Hud = typeof(setmetatable(
	{} :: {
		gui: ScreenGui,
		cb: Callbacks,
		cache: { [string]: any },
		mobile: boolean,
		dragging: boolean,
		toastToken: number,
		goldPopToken: number,
		alertToken: number,
		panels: { GuiObject },
		top: Frame,
		banner: Frame,
		-- NOT: alan adları metot adlarıyla (toast, alert) çakışmamalı; çakışınca hud:toast(...) Frame'i çağırır
		-- ("attempt to call a Instance value").
		toastFrame: Frame,
		board: Frame,
		bottom: Frame,
		hover: Frame,
		diplo: Frame,
		attacks: Frame,
		requests: ScrollingFrame,
		feed: any,
		layoutRight: any,
		info: TextLabel,
		alertFrame: Frame,
		buttons: { [string]: TextButton },
		buildToggle: TextButton,
		buildClose: TextButton,
		buildsOpen: boolean,
		card: Frame,
		confirm: Frame,
		settingsButton: TextButton, -- (alt barın solunda; tıklamayı Menu.bindHud bağlar)
		helpButton: TextButton,
	},
	Hud
))

local function find(parent: Instance, path: string): any
	local cur: Instance = parent
	for part in string.gmatch(path, "[^/]+") do
		local nxt = cur:FindFirstChild(part)
		if not nxt then
			error("[Frontline] UI element not found: " .. parent.Name .. "/" .. path .. " (don't rename StarterGui > FrontlineHud children)")
		end
		cur = nxt
	end
	return cur
end

local function setText(self: Hud, key: string, l: TextLabel, text: string)
	if self.cache[key] ~= text then
		self.cache[key] = text
		l.Text = text
	end
end

-- Dokunmatik ekranda panelleri orantılı büyüt (Studio'daki PC düzeni korunur, yalnızca ölçeklenir).
local function grow(f: GuiObject, kx: number, ky: number)
	local s = f.Size
	f.Size = UDim2.new(math.min(0.99, s.X.Scale * kx), s.X.Offset, math.min(0.6, s.Y.Scale * ky), s.Y.Offset)
end

function Hud.new(gui: ScreenGui, cb: Callbacks): Hud
	local self = setmetatable({
		gui = gui,
		cb = cb,
		cache = {},
		-- Studio'nun cihaz emülatöründe fare de etkin görünür: Studio'da dokunmatik açıksa mobil sayılır
		mobile = UserInputService.TouchEnabled and (not UserInputService.MouseEnabled or RunService:IsStudio()),
		dragging = false,
		toastToken = 0,
		goldPopToken = 0,
		alertToken = 0,
		panels = {},
		top = find(gui, "TopBar"),
		banner = find(gui, "Banner"),
		toastFrame = find(gui, "Toast"),
		board = find(gui, "Leaderboard"),
		bottom = find(gui, "BottomBar"),
		hover = find(gui, "Hover"),
		diplo = find(gui, "Diplo"),
		attacks = find(gui, "Attacks"),
		requests = find(gui, "Requests"),
		info = find(gui, "Info"),
		alertFrame = find(gui, "Alert"),
		buttons = {},
		buildToggle = find(gui, "BottomBar/BuildToggle"),
		buildClose = find(gui, "BottomBar/BuildClose"),
		buildsOpen = true,
		card = find(gui, "TargetCard"),
		confirm = find(gui, "BuildConfirm"),
		feed = require(script.Parent.CombatFeed).new(gui),
		layoutRight = function() end,
	}, Hud)
	self.panels = { self.top, self.board, self.bottom, self.diplo, self.attacks, self.banner, self.buildToggle, self.buildClose, self.card, self.confirm }
	self.info.Visible = false -- sol alttaki yazı yalnız açılış hatasında (Hud.error) görünür

	if self.mobile then
		grow(self.bottom, 1.55, 1.3)
		-- BUILD tuşu barın sağında durur: bar ekranın en çok %80'i olsun ki tuş her ekranda sığsın
		local bs = self.bottom.Size
		self.bottom.Size = UDim2.new(math.min(0.8, bs.X.Scale), bs.X.Offset, bs.Y.Scale, bs.Y.Offset)
		grow(self.top, 1.9, 1.2)
		-- üst bar leaderboard'a binmesin: aralarında en az ekranın %1'i kadar boşluk (leaderboard genişliği = HudLayout'taki 0.19)
		local ts = self.top.Size
		local maxW = 2 * (self.board.Position.X.Scale - 0.19 - 0.01 - self.top.Position.X.Scale)
		self.top.Size = UDim2.new(math.min(maxW, ts.X.Scale), ts.X.Offset, ts.Y.Scale, ts.Y.Offset)
		-- Responsive right column is sized by HudLayout.
		grow(self.diplo, 1.8, 1.1)
	end

	-- yapı düğmeleri: simge = Assets'teki kendi görselin, yoksa OpenFront simgesi (Icons), o da yoksa harf
	for i, id in Hud.buildOrder do
		local b = find(self.bottom, "Builds/B_" .. id) :: TextButton
		self.buttons[id] = b
		local key = b:FindFirstChild("Key") :: TextLabel?
		if key then
			key.Text = if i <= Hud.buildKeys then tostring(i) else ""
			key.Visible = i <= Hud.buildKeys and not self.mobile -- mobilde klavye yok
		end
		local nameLabel = b:FindFirstChild("Name") :: TextLabel?
		if nameLabel then
			nameLabel.Text = Hud.buildNames[id] or id
		end
		local icon = b:FindFirstChild("Icon") :: ImageLabel?
		local iconText = b:FindFirstChild("IconText") :: TextLabel?
		-- alt bar görseli Assets.BuildBar'dan (bombaların haritada uçarkenki görseli Assets.Units'te ayrı); boşsa yapının /
		-- savaş gemisinin harita görseli
		local imgId = (Assets.BuildBar :: any)[id]
		if not Assets.has(imgId) then
			imgId = (Assets.Structures :: any)[id] or (if id == "warship" then Assets.Units.warship else nil)
		end
		if icon and iconText then
			if Icons.apply(icon, id, imgId) then
				icon.Visible = true
				iconText.Visible = false
			else
				icon.Visible = false
				iconText.Visible = true
				iconText.Text = (Assets.Fallback.Structures :: any)[id] or (Assets.Fallback.Radial :: any)[id] or "?"
			end
		end
		b.Activated:Connect(function()
			cb.onBuild(id)
		end)
		b.MouseEnter:Connect(function()
			cb.onHoverBuild(id)
		end)
		b.MouseLeave:Connect(function()
			cb.onHoverBuild(nil)
		end)
	end
	-- altın simgesi (kendi görselin yoksa OpenFront altın simgesi, altın rengine boyanır)
	local goldIcon = find(self.bottom, "Gold/Icon") :: ImageLabel
	local goldValue = find(self.bottom, "Gold/Value") :: TextLabel
	local ownGold = Assets.has(Assets.Icons.gold)
	if Icons.apply(goldIcon, "gold", Assets.Icons.gold) then
		goldIcon.ImageColor3 = if ownGold then Color3.new(1, 1, 1) else GOLD
		goldIcon.Visible = true
		goldValue.Position = UDim2.new(goldValue.Position.X.Scale + 0.14, goldValue.Position.X.Offset, goldValue.Position.Y.Scale, goldValue.Position.Y.Offset)
	else
		goldIcon.Visible = false
	end

	-- oyuncu alanı: tıklayınca kamera kendi toprağına gider (fare üstündeyken hafif vurgulanır)
	local player = find(self.bottom, "Player") :: Frame
	local focus = player:FindFirstChild("Focus") :: TextButton?
	if focus then
		local base = player.BackgroundTransparency
		focus.MouseEnter:Connect(function()
			player.BackgroundTransparency = math.max(0, base - 0.15)
		end)
		focus.MouseLeave:Connect(function()
			player.BackgroundTransparency = base
		end)
		focus.Activated:Connect(function()
			cb.onFocus()
		end)
	end

	-- saldırı gücü kaydırıcısı
	local track = find(self.bottom, "Attack/Track") :: Frame
	local hit = find(track, "Hit") :: TextButton
	local function setFromX(x: number)
		local w = track.AbsoluteSize.X
		if w <= 0 then
			return
		end
		local r = math.clamp((x - track.AbsolutePosition.X) / w, 0.01, 1)
		r = math.max(0.01, math.floor(r * 100 + 0.5) / 100)
		cb.onRatio(r)
	end
	-- Yalnız kaydırıcının üstünde başlayan basış ayarlar: haritada başlayıp (kaydırırken) üstüne gelen basış sayılmaz.
	local pressAt: { [InputObject]: number } = {}
	UserInputService.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			pressAt[input] = os.clock()
		end
	end)
	hit.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local at = pressAt[input]
			if input.UserInputState ~= Enum.UserInputState.Begin or (at and os.clock() - at > 0.05) then
				return
			end
			self.dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if self.dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			pressAt[input] = nil
			self.dragging = false
		end
	end)

	-- sıralama: daraltılmış <-> açık
	local collapsed = find(self.board, "Collapsed") :: TextButton
	local expanded = find(self.board, "Expanded") :: Frame
	collapsed.Activated:Connect(function()
		collapsed.Visible = false
		expanded.Visible = true
	end)
	;(find(expanded, "Close") :: TextButton).Activated:Connect(function()
		expanded.Visible = false
		collapsed.Visible = true
	end)
	-- açıkken "LEADERBOARD" başlığına tekrar basınca da kapanır
	;(find(expanded, "Title") :: TextLabel).InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			expanded.Visible = false
			collapsed.Visible = true
		end
	end)
	;(find(self.diplo, "Close") :: TextButton).Activated:Connect(function()
		cb.onDiplo("close")
	end)
	-- BUILD düğmesi: yapı satırını açar / kapar. Kapalıyken bar yalnız üst satır kadar kalır (üst satır alta kayar).
	-- PC'de varsayılan açık, mobilde kapalı. Barın doğrudan çocuklarının dikey ölçüsü bar yüksekliğiyle birlikte
	-- ölçeklenir, böylece üst satırın ekrandaki boyutu değişmez.
	-- Yapı satırı (Builds) yatay kaydırılan bir ScrollingFrame: açıkken bar OPEN katı uzar (üst satırın boyu aynı kalır, ek
	-- yükseklik yapı satırına gider); düğmeler kare (kenarı satırın yüksekliği), aralarında sabit boşluk; sığmayanlar sağa
	-- taşar ve kaydırılarak görülür. Satır her açılışta en soldan başlar.
	local builds = find(self.bottom, "Builds") :: ScrollingFrame
	local OPEN = 1.3 -- (yapı satırı açıkken barın boyu: Studio'daki boyun bu katı)
	local buildsY, buildsH = builds.Position.Y.Scale, builds.Size.Y.Scale
	local buildsMargin = math.max(0, 1 - (buildsY + buildsH)) -- (satırın altındaki boşluk, barın açık haline oranla)
	local aspect = self.bottom:FindFirstChildOfClass("UIAspectRatioConstraint")
	local baseH = self.bottom.Size.Y.Scale
	local baseRatio = if aspect then aspect.AspectRatio else 0
	local baseY: { [GuiObject]: { number } } = {}
	for _, c in self.bottom:GetChildren() do
		if c:IsA("GuiObject") and c ~= builds then
			baseY[c] = { c.Position.Y.Scale, c.Size.Y.Scale }
		end
	end
	-- kapalıyken kalan pay: üst satırın (Player / Troops / Attack / Gold) alt kenarı + üstteki kadar alt boşluk.
	-- Studio'daki değerlerden hesaplanır: bar ya da satır inceltilince kendiliğinden uyar.
	local rowTop, rowBottom = math.huge, 0
	for c, v in baseY do
		if c ~= self.buildToggle and c ~= self.buildClose then
			local y = v[1] - v[2] * c.AnchorPoint.Y
			rowTop = math.min(rowTop, y)
			rowBottom = math.max(rowBottom, y + v[2])
		end
	end
	local KEEP = if rowBottom > 0 then math.clamp(rowBottom + math.max(0, rowTop), 0.2, 1) else 0.58
	local toggleStroke = self.buildToggle:FindFirstChildOfClass("UIStroke")
	local strokeBase = if toggleStroke then toggleStroke.Color else GOLD
	local buildsLayout = builds:FindFirstChildOfClass("UIListLayout")
	local function sizeBuildButtons()
		-- (satırın UIPadding'i düğmelerin dört yanında 3 px bırakır: seçili düğmenin 2.5 px kenar çizgisi kesilmesin)
		local pad = builds:FindFirstChildOfClass("UIPadding")
		local padY = if pad then pad.PaddingTop.Offset + pad.PaddingBottom.Offset else 0
		local h = math.floor(builds.AbsoluteWindowSize.Y - padY)
		if h <= 0 then
			return
		end
		local gap = math.max(3, math.floor(builds.AbsoluteSize.X * 0.006 + 0.5))
		if buildsLayout then
			buildsLayout.Padding = UDim.new(0, gap)
		end
		for _, c in builds:GetChildren() do
			if c:IsA("GuiButton") then
				c.Size = UDim2.fromOffset(h, h)
			end
		end
	end
	builds:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(sizeBuildButtons)
	builds:GetPropertyChangedSignal("AbsoluteSize"):Connect(sizeBuildButtons)
	local function applyBuilds()
		local f = if self.buildsOpen then OPEN else KEEP
		builds.Visible = self.buildsOpen
		builds.Position = UDim2.new(builds.Position.X.Scale, builds.Position.X.Offset, buildsY / OPEN, 0)
		builds.Size = UDim2.new(builds.Size.X.Scale, builds.Size.X.Offset, (OPEN - buildsY - buildsMargin) / OPEN, 0)
		if self.buildsOpen then
			builds.CanvasPosition = Vector2.zero -- (her açılışta en soldan)
			task.defer(function()
				sizeBuildButtons()
				builds.CanvasPosition = Vector2.zero
			end)
		end
		self.buildClose.Visible = self.buildsOpen -- kare X: yalnız menü açıkken
		local s = self.bottom.Size
		self.bottom.Size = UDim2.new(s.X.Scale, s.X.Offset, baseH * f, s.Y.Offset)
		if aspect then
			aspect.AspectRatio = baseRatio / f
		end
		for c, v in baseY do
			c.Position = UDim2.new(c.Position.X.Scale, c.Position.X.Offset, v[1] / f, c.Position.Y.Offset)
			c.Size = UDim2.new(c.Size.X.Scale, c.Size.X.Offset, v[2] / f, c.Size.Y.Offset)
		end
		self.buildToggle.TextColor3 = if self.buildsOpen then GOLD else Color3.fromRGB(241, 245, 249)
		if toggleStroke then
			toggleStroke.Color = if self.buildsOpen then GOLD else strokeBase
		end
		local cover = self.bottom:FindFirstChild("SiloRequired") :: Frame?
		if cover then
			cover.Visible = self.buildsOpen and self.cache.noSilo == true and not cover:GetAttribute("Clipped")
		end
	end
	self.buildsOpen = not self.mobile
	applyBuilds()
	self.buildToggle.Activated:Connect(function()
		self.buildsOpen = not self.buildsOpen
		applyBuilds()
	end)
	self.buildClose.Activated:Connect(function()
		self.buildsOpen = false
		applyBuilds()
	end)

	-- Alt barın solunda kare düğmeler: ayarlar (altta) ve nasıl oynanır "?" (üstünde). Kenarı barın dar (yapılar kapalı)
	-- halinin yüksekliği; alttaki barın alt kenarıyla hizalı, barla ve birbirleriyle arasında küçük boşluk. Görünüş BUILD
	-- düğmesi gibi; görsel Assets.Icons.settings / help (boşsa ⚙ / ?).
	local function sideButton(name: string, glyph: string, icon: string): TextButton
		local b = Instance.new("TextButton")
		b.Name = name
		b.BackgroundColor3 = self.buildToggle.BackgroundColor3
		b.BackgroundTransparency = self.buildToggle.BackgroundTransparency
		b.BorderSizePixel = 0
		b.FontFace = Fonts.main
		b.TextScaled = true
		b.TextColor3 = Color3.fromRGB(241, 245, 249)
		b.Text = if Assets.has(icon) then "" else glyph
		b.ZIndex = self.buildToggle.ZIndex
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.25, 0)
		corner.Parent = b
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = Color3.fromRGB(71, 85, 105)
		stroke.Thickness = 1.5
		stroke.Parent = b
		local pad = Instance.new("UIPadding")
		for _, side in { "PaddingTop", "PaddingBottom", "PaddingLeft", "PaddingRight" } do
			(pad :: any)[side] = UDim.new(0.2, 0)
		end
		pad.Parent = b
		if Assets.has(icon) then
			local img = Instance.new("ImageLabel")
			img.Name = "Icon"
			img.BackgroundTransparency = 1
			img.Size = UDim2.fromScale(1, 1)
			img.ScaleType = Enum.ScaleType.Fit
			img.Image = icon
			img.ZIndex = b.ZIndex
			img.Parent = b
		end
		b.Parent = self.gui
		return b
	end
	self.settingsButton = sideButton("SideSettings", "⚙", Assets.Icons.settings)
	self.helpButton = sideButton("SideHelp", "?", Assets.Icons.help)
	table.insert(self.panels, self.settingsButton)
	table.insert(self.panels, self.helpButton)
	local function placeSide()
		local origin = self.gui.AbsolutePosition
		local f = if self.buildsOpen then OPEN else KEEP
		local s = math.floor(self.bottom.AbsoluteSize.Y * KEEP / f + 0.5) -- (barın dar halinin yüksekliği)
		local gap = math.max(4, math.floor(s * 0.15 + 0.5))
		local x = self.bottom.AbsolutePosition.X - origin.X - gap - s
		local bottomY = self.bottom.AbsolutePosition.Y - origin.Y + self.bottom.AbsoluteSize.Y
		self.settingsButton.Size = UDim2.fromOffset(s, s)
		self.settingsButton.Position = UDim2.fromOffset(x, bottomY - s)
		self.helpButton.Size = UDim2.fromOffset(s, s)
		self.helpButton.Position = UDim2.fromOffset(x, bottomY - s * 2 - gap)
	end
	self.bottom:GetPropertyChangedSignal("AbsolutePosition"):Connect(placeSide)
	self.bottom:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeSide)
	self.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeSide)
	placeSide()
	-- (alt bar gizliyken, ör. başlangıç fazında, bunlar da gizli)
	local function sideVisible()
		self.settingsButton.Visible = self.bottom.Visible
		self.helpButton.Visible = self.bottom.Visible
	end
	self.bottom:GetPropertyChangedSignal("Visible"):Connect(sideVisible)
	sideVisible()

	-- Mobil hedef kartı: alt barın hemen üstünde, sol tarafta (bar açılıp kapanınca birlikte kayar)
	local function placeCard()
		local origin = self.gui.AbsolutePosition
		local gap = self.gui.AbsoluteSize.Y * 0.015
		self.card.Position = UDim2.fromOffset(self.bottom.AbsolutePosition.X - origin.X, self.bottom.AbsolutePosition.Y - origin.Y - gap)
	end
	self.bottom:GetPropertyChangedSignal("AbsolutePosition"):Connect(placeCard)
	self.bottom:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeCard)
	placeCard()
	for _, kind in { "Attack", "More", "Close" } do
		local btn = find(self.card, kind) :: TextButton
		btn.Activated:Connect(function()
			self.cb.onCard(string.lower(kind))
		end)
	end

	-- Mobil kurma onayı düğmeleri: Assets.Icons'ta görsel varsa o, yoksa yazı (X / OK)
	for name, ok in { Cancel = false, Confirm = true } do
		local b = find(self.confirm, name) :: TextButton
		local img = if ok then Assets.Icons.buildConfirm else Assets.Icons.buildCancel
		if Assets.has(img) then
			local icon = find(b, "Icon") :: ImageLabel
			icon.Image = img
			icon.Visible = true
			b.Text = ""
		end
		b.Activated:Connect(function()
			self.cb.onBuildConfirm(ok)
		end)
	end

	-- Üst sütun: Banner üst barın (TopBar) ve sol üstteki duraklat / ayarlar düğmelerinin (Menu: FrontlineTopbar) altında,
	-- üst bar kapalıyken (maç başlarken) düğmelerin altında; Toast açıksa Banner'ın, değilse aynı yerde. İkisi de üst
	-- bar açıkken ona göre, kapalıyken ekrana göre ortalı; aralarında küçük boşluk (üst üste binmesinler).
	local buttons: GuiObject? = nil
	local function stackTop()
		local origin = self.gui.AbsolutePosition
		local gap = self.gui.AbsoluteSize.Y * 0.012
		local cx = if self.top.Visible
			then self.top.AbsolutePosition.X + self.top.AbsoluteSize.X / 2 - origin.X
			else self.gui.AbsoluteSize.X / 2
		local y = self.top.AbsolutePosition.Y - origin.Y -- (üst barın üst boşluğu)
		if self.top.Visible then
			y += self.top.AbsoluteSize.Y + gap
		end
		if buttons then
			y = math.max(y, buttons.AbsolutePosition.Y + buttons.AbsoluteSize.Y - origin.Y + gap)
		end
		self.banner.Position = UDim2.fromOffset(cx, y)
		if self.banner.Visible then
			y += self.banner.AbsoluteSize.Y + gap
		end
		self.toastFrame.Position = UDim2.fromOffset(cx, y)
	end
	for _, o in { self.top, self.banner } do
		o:GetPropertyChangedSignal("Visible"):Connect(stackTop)
		o:GetPropertyChangedSignal("AbsoluteSize"):Connect(stackTop)
	end
	self.top:GetPropertyChangedSignal("AbsolutePosition"):Connect(stackTop)
	self.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(stackTop)

	-- Üst bar soldaki düğmelere ya da sağdaki sıralamaya (Leaderboard) binerse aralarına (küçük boşlukla) sığacak kadar
	-- küçülür ve kayar; sığıyorsa Studio'daki (mobilde büyütülmüş) boyu ve yeri kalır, hiç büyütülmez.
	local topBase, topBasePos = self.top.Size, self.top.Position
	local topAspect = self.top:FindFirstChildOfClass("UIAspectRatioConstraint")
	local function fitTop()
		local origin, screen = self.gui.AbsolutePosition, self.gui.AbsoluteSize
		local gap = screen.Y * 0.012
		local w = topBase.X.Scale * screen.X + topBase.X.Offset
		local h = topBase.Y.Scale * screen.Y + topBase.Y.Offset
		if topAspect then
			w = math.min(w, h * topAspect.AspectRatio)
		end
		local cx = topBasePos.X.Scale * screen.X + topBasePos.X.Offset -- (AnchorPoint X 0.5: orta)
		local left = gap
		if buttons then
			for _, b in buttons:GetChildren() do
				if b:IsA("GuiObject") and b.Visible then
					left = math.max(left, b.AbsolutePosition.X + b.AbsoluteSize.X - origin.X + gap)
				end
			end
		end
		local right = self.board.AbsolutePosition.X - origin.X - gap
		if (cx - w / 2 >= left and cx + w / 2 <= right) or right - left < 1 then
			self.top.Size, self.top.Position = topBase, topBasePos
			return
		end
		local fw = math.min(w, right - left)
		cx = math.clamp(cx, left + fw / 2, right - fw / 2)
		local fh = if topAspect then fw / topAspect.AspectRatio else h * fw / w
		self.top.Size = UDim2.fromOffset(fw, fh)
		self.top.Position = UDim2.new(0, cx, topBasePos.Y.Scale, topBasePos.Y.Offset)
	end
	self.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitTop)
	self.board:GetPropertyChangedSignal("AbsolutePosition"):Connect(fitTop)
	self.board:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitTop)

	-- düğme çubuğu Menu.new'de (Hud'dan sonra) kurulur
	local function watchButtons(g: Instance)
		local bar = if g.Name == "FrontlineTopbar" then g:FindFirstChild("Bar") else nil
		if bar and bar:IsA("GuiObject") then
			buttons = bar
			for _, f in { stackTop, fitTop } do
				bar:GetPropertyChangedSignal("AbsolutePosition"):Connect(f)
				bar:GetPropertyChangedSignal("AbsoluteSize"):Connect(f)
			end
			-- (menu açıkken duraklat düğmesi gizlenir, ayarlar düğmesi sola kayar)
			for _, b in bar:GetChildren() do
				if b:IsA("GuiObject") then
					b:GetPropertyChangedSignal("Visible"):Connect(fitTop)
					b:GetPropertyChangedSignal("AbsolutePosition"):Connect(fitTop)
				end
			end
			fitTop()
			stackTop()
		end
	end
	local playerGui = self.gui.Parent :: Instance
	playerGui.ChildAdded:Connect(watchButtons)
	for _, g in playerGui:GetChildren() do
		watchButtons(g)
	end

	self.layoutRight = require(script.Parent.HudLayout).attach(self)
	fitTop()
	stackTop()
	return self
end

-- Basit yazılar --------------------------------------------------------------------------

function Hud.setHint(_self: Hud, _text: string) end

-- Üst barın altındaki durum şeridi (başlangıç fazı, izleyici, kazanan ...). Boş yazı gizler.
function Hud.setTop(self: Hud, text: string)
	setText(self, "top", find(self.banner, "Text"), text)
	self.banner.Visible = text ~= ""
end

function Hud.setBar(self: Hud, frac: number?)
	local bar = find(self.banner, "Bar") :: Frame
	if frac == nil then
		bar.Visible = false
		return
	end
	bar.Visible = true
	bar.Size = UDim2.new(0.94 * math.clamp(frac, 0, 1), 0, bar.Size.Y.Scale, bar.Size.Y.Offset)
end

function Hud.error(self: Hud, text: string)
	self.info.TextColor3 = Color3.fromRGB(255, 140, 140)
	self.info.Size = UDim2.new(0.6, 0, 0.08, 0)
	self.info.TextWrapped = true
	self.info.Text = text
	self.info.Visible = true
end

function Hud.toast(self: Hud, message: string)
	self.toastToken += 1
	local token = self.toastToken
	;(find(self.toastFrame, "Text") :: TextLabel).Text = message
	self.toastFrame.Visible = true
	task.delay(2.8, function()
		if self.toastToken == token then
			self.toastFrame.Visible = false
		end
	end)
end

-- Üst bar: maç süresi ve dünya kontrolü -----------------------------------------------------

function Hud.setMatch(self: Hud, text: string)
	setText(self, "match", find(self.top, "MatchTime"), text)
end

function Hud.setControl(self: Hud, c: Control)
	local bar = find(self.top, "ControlBar") :: Frame
	local fill = find(bar, "Fill") :: Frame
	local leader = find(bar, "Leader") :: Frame
	local key = string.format("%.5f|%.5f|%s|%s|%s", c.myPct, c.leaderPct, c.leaderName, tostring(c.meLeader), c.myName or "")
	if self.cache.control == key then
		return
	end
	self.cache.control = key
	local mine = find(self.top, "MyControl") :: TextLabel
	-- 1. bensem YOU'nun başında taç; değilsem 1. oyuncu barda sarı çizgi, adı taçla birlikte barın altında
	mine.Text = string.format("%sYOU · %s · %.1f%%", if c.meLeader then "👑 " else "", c.myName or "", c.myPct * 100)
	fill.BackgroundColor3 = c.myColor
	TweenService:Create(fill, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = UDim2.new(math.clamp(c.myPct, 0, 1), 0, 1, 0) }):Play()
	if c.meLeader or c.leaderPct <= 0 then
		leader.Visible = false
	else
		leader.Visible = true
		;(find(leader, "LeaderName") :: TextLabel).Text = string.format("👑 %s - %.1f%%", c.leaderName, c.leaderPct * 100)
		TweenService:Create(leader, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Position = UDim2.new(math.clamp(c.leaderPct, 0, 1), 0, leader.Position.Y.Scale, leader.Position.Y.Offset) }):Play()

	end
end

-- Alt panel ----------------------------------------------------------------------------------

function Hud.setPlayer(self: Hud, name: string, color: Color3, pct: string)
	local p = find(self.bottom, "Player")
	setText(self, "pname", find(p, "Name"), name)
	setText(self, "pworld", find(p, "World"), pct .. " of the world")
	;(find(p, "Swatch") :: Frame).BackgroundColor3 = color
end

function Hud.setMine(self: Hud, m: Mine?)
	local troops = find(self.bottom, "Troops")
	local attack = find(self.bottom, "Attack")
	local gold = find(self.bottom, "Gold")
	if not m then
		setText(self, "tval", find(troops, "Value"), "-")
		setText(self, "tmax", find(troops, "Max"), "")
		setText(self, "sends", find(attack, "Sends"), "You have no land yet")
		return
	end
	setText(self, "tval", find(troops, "Value"), m.troops)
	setText(self, "tmax", find(troops, "Max"), "/ " .. m.max)
	local fill = find(troops, "Bar/Fill") :: Frame
	local fk = string.format("%.3f", m.fill)
	if self.cache.fill ~= fk then
		self.cache.fill = fk
		TweenService:Create(fill, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(math.clamp(m.fill, 0, 1), 0, 1, 0) }):Play()
	end
	local rate = find(troops, "Rate") :: TextLabel
	setText(self, "trate", rate, m.rate or "")
	rate.TextColor3 = if m.rising == false then ORANGE else GREEN
	-- saldırı
	setText(self, "apct", find(attack, "Percent"), math.floor(m.ratio * 100 + 0.5) .. "%")
	setText(self, "sends", find(attack, "Sends"), "sends " .. m.ratioTroops .. " troops")
	if self.cache.ratio ~= m.ratio then
		self.cache.ratio = m.ratio
		local ti = TweenInfo.new(if self.dragging then 0.04 else 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(find(attack, "Track/Fill"), ti, { Size = UDim2.new(m.ratio, 0, 1, 0) }):Play()
		local h = find(attack, "Track/Handle") :: Frame
		TweenService:Create(h, ti, { Position = UDim2.new(m.ratio, 0, 0.5, 0) }):Play()
	end
	-- altın
	setText(self, "gval", find(gold, "Value"), m.gold)
	setText(self, "grate", find(gold, "Rate"), m.goldRate or "")
end

function Hud.setBuild(self: Hud, items: { BuildItem })
	local missing = false
	for _, it in items do if it.noSilo then missing = true end end
	local cover = self.bottom:FindFirstChild("SiloRequired") :: Frame?
	if not cover then
		cover = Instance.new("Frame")
		cover.Name = "SiloRequired"
		cover.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
		cover.BackgroundTransparency = 0.25
		cover.BorderSizePixel = 0
		cover.ZIndex = 60
		cover.Active = false
		local label = Instance.new("TextLabel")
		label.Name = "Explanation"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Text = "Missile silo required"
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextTransparency = 0
		label.FontFace = Fonts.main
		label.TextSize = 12
		label.TextScaled = true
		local limit = Instance.new("UITextSizeConstraint")
		limit.MaxTextSize = 12
		limit.MinTextSize = 1
		limit.Parent = label
		label.TextWrapped = true
		label.ZIndex = 61
		label.Parent = cover
		cover.Parent = self.bottom
		local function layout()
			local a, b = self.buttons.atom, self.buttons.mirv
			local origin = self.bottom.AbsolutePosition
			-- (yapı satırı kaydırılınca örtü yalnız satırın görünen kısmında kalır)
			local row = a.Parent :: GuiObject
			local left = math.max(a.AbsolutePosition.X, row.AbsolutePosition.X)
			local right = math.min(b.AbsolutePosition.X + b.AbsoluteSize.X, row.AbsolutePosition.X + row.AbsoluteSize.X)
			cover.Position = UDim2.fromOffset(left - origin.X, a.AbsolutePosition.Y - origin.Y)
			cover.Size = UDim2.fromOffset(math.max(0, right - left), a.AbsoluteSize.Y)
			cover:SetAttribute("Clipped", right - left < 8)
			cover.Visible = self.cache.noSilo == true and self.buildsOpen and right - left >= 8
		end
		for _, gui in { self.bottom, self.buttons.atom, self.buttons.mirv } do
			gui:GetPropertyChangedSignal("AbsolutePosition"):Connect(layout)
			gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
		end
		layout()
	end
	self.cache.noSilo = missing
	cover.Visible = missing and self.buildsOpen and not cover:GetAttribute("Clipped")
	for _, it in items do
		local b = self.buttons[it.id]
		if b then
			local sig = table.concat({ it.costText, tostring(it.count), tostring(it.afford), tostring(it.selected), tostring(it.noSilo) }, "|")
			if self.cache["b_" .. it.id] ~= sig then
				self.cache["b_" .. it.id] = sig
				local cost = b:FindFirstChild("Cost") :: TextLabel
				cost.Text = it.costText
				cost.TextColor3 = if it.afford or it.noSilo then GOLD else NO_GOLD
				local count = b:FindFirstChild("Count") :: TextLabel
				count.Text = if it.count > 0 then "×" .. it.count else ""
				local st = b:FindFirstChild("Stroke") :: UIStroke?
				if st then
					st.Thickness = if it.noSilo then 0 elseif it.selected then 2.5 else (if it.afford then 0 else 1)
					st.Color = if it.selected then Color3.new(1, 1, 1) else Color3.fromRGB(127, 29, 29)
				end
				b.BackgroundTransparency = if it.afford then 0.1 else 0.55
				local icon = b:FindFirstChild("Icon") :: ImageLabel?
				if icon then
					icon.ImageTransparency = if it.afford then 0 else 0.6
				end
				local it2 = b:FindFirstChild("IconText") :: TextLabel?
				if it2 then
					it2.TextTransparency = if it.afford then 0 else 0.6
				end
				for _, name in { "Name", "Key", "Count", "Cost" } do
					local label = b:FindFirstChild(name) :: TextLabel?
					if label then label.TextTransparency = if it.afford then 0 else 0.5 end
				end
			end
		end
	end
end

-- Sıralama (sağ üst) ----------------------------------------------------------------------------

function Hud.setRank(self: Hud, rank: string, pct: string)
	local c = find(self.board, "Collapsed")
	setText(self, "rank", find(c, "Rank"), rank)
	setText(self, "rpct", find(c, "Pct"), pct)
end

function Hud.setBoard(self: Hud, rows: { BoardRow })
	local list = find(self.board, "Expanded/List") :: Frame
	local template = list:FindFirstChild("RowTemplate") :: Frame
	local existing: { Frame } = {}
	for _, c in list:GetChildren() do
		if c:IsA("Frame") and c ~= template then
			table.insert(existing, c)
		end
	end
	table.sort(existing, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i, data in rows do
		local row = existing[i]
		if not row then
			row = template:Clone()
			row.Name = "Row" .. i
			row.LayoutOrder = i
			row.Parent = list
		end
		row.Visible = true
		row.BackgroundTransparency = if data.mine then 0.55 else 1
		;(row:FindFirstChild("Rank") :: TextLabel).Text = tostring(data.rank)
		;(row:FindFirstChild("Dot") :: Frame).BackgroundColor3 = data.color
		local nm = row:FindFirstChild("Name") :: TextLabel
		nm.Text = data.name .. data.tag
		nm.FontFace = Fonts.main
		;(row:FindFirstChild("Pct") :: TextLabel).Text = data.pct
		;(row:FindFirstChild("Troops") :: TextLabel).Text = data.troops
	end
	for i = #rows + 1, #existing do
		existing[i].Visible = false
	end
end

-- Fare kartı (sol üst köşesi farede) -------------------------------------------------------------

function Hud.setHover(self: Hud, m: HoverModel?, x: number?, y: number?)
	local h = self.hover
	if not m or self.mobile then
		h.Visible = false
		self.cache.hover = nil
		return
	end
	-- konum: farenin sağ altı; ekrandan taşarsa sola / yukarı
	local vw, vh = self.gui.AbsoluteSize.X, self.gui.AbsoluteSize.Y
	local w, hh = h.AbsoluteSize.X, h.AbsoluteSize.Y
	local px, py = (x or 0) + 14, (y or 0) + 14
	if px + w > vw - 4 then
		px = (x or 0) - w - 10
	end
	if py + hh > vh - 4 then
		py = (y or 0) - hh - 10
	end
	h.Position = UDim2.fromOffset(px, py)
	h.Visible = true
	local sig = m.name .. (m.tag or "") .. m.kind .. m.troops .. m.land .. (m.gold or "") .. (m.hint1 or "") .. (m.hint2 or "")
	if self.cache.hover == sig then
		return
	end
	self.cache.hover = sig
	;(find(h, "Swatch") :: Frame).BackgroundColor3 = m.color
	local nm = find(h, "Name") :: TextLabel
	nm.Text = m.name
	local tag = find(h, "Tag") :: Frame
	if m.tag and m.tag ~= "" then
		tag.Visible = true
		local tt = find(tag, "Text") :: TextLabel
		tt.Text = m.tag
		local col = m.tagColor or ORANGE
		tt.TextColor3 = col
		local st = tag:FindFirstChild("Stroke") :: UIStroke?
		if st then
			st.Color = col
		end
		tag.BackgroundColor3 = col:Lerp(Color3.new(0, 0, 0), 0.75)
	else
		tag.Visible = false
	end
	;(find(h, "Type") :: TextLabel).Text = m.kind
	;(find(h, "TroopsValue") :: TextLabel).Text = m.troops
	;(find(h, "LandValue") :: TextLabel).Text = m.land
	local gl, gv = find(h, "GoldLabel") :: TextLabel, find(h, "GoldValue") :: TextLabel
	gl.Visible = m.gold ~= nil
	gv.Visible = m.gold ~= nil
	gv.Text = m.gold or ""
	;(find(h, "Hint1") :: TextLabel).Text = m.hint1 or ""
	;(find(h, "Hint2") :: TextLabel).Text = m.hint2 or ""
end

-- Mobil hedef kartı (dokunulan ülke: bilgi + Attack + More) ------------------------------------------

function Hud.setTarget(self: Hud, m: TargetModel?)
	local c = self.card
	if not m then
		c.Visible = false
		self.cache.card = nil
		return
	end
	c.Visible = true
	local sig = table.concat({ m.name, m.tag, m.sub, m.attack, tostring(m.canAttack), tostring(m.color) }, "|")
	if self.cache.card == sig then
		return
	end
	self.cache.card = sig
	;(find(c, "Swatch") :: Frame).BackgroundColor3 = m.color
	;(find(c, "Name") :: TextLabel).Text = m.name
	;(find(c, "Sub") :: TextLabel).Text = m.sub
	local tag = find(c, "Tag") :: Frame
	local tt = find(tag, "Text") :: TextLabel
	tt.Text = m.tag
	tt.TextColor3 = m.tagColor
	local st = tag:FindFirstChildOfClass("UIStroke")
	if st then
		st.Color = m.tagColor
	end
	tag.BackgroundColor3 = m.tagColor:Lerp(Color3.new(0, 0, 0), 0.75)
	local atk = find(c, "Attack") :: TextButton
	atk.Text = m.attack
	atk.BackgroundTransparency = if m.canAttack then 0 else 0.6
	atk.TextTransparency = if m.canAttack then 0 else 0.4
end

-- Mobil kurma onayı penceresi: (x, y) mutlak ekran noktasının (dokunulan yer) solunda; sola sığmazsa sağında.
function Hud.setBuildConfirm(self: Hud, title: string?, x: number?, y: number?)
	local f = self.confirm
	if not title or not x or not y then
		f.Visible = false
		return
	end
	setText(self, "confirm", find(f, "Title"), title)
	local origin, screen = self.gui.AbsolutePosition, self.gui.AbsoluteSize
	local w, h = f.AbsoluteSize.X, f.AbsoluteSize.Y
	local gap = screen.Y * 0.08
	local px = x - origin.X - gap - w / 2
	if px - w / 2 < 4 then
		px = x - origin.X + gap + w / 2
	end
	px = math.clamp(px, w / 2 + 4, screen.X - w / 2 - 4)
	-- dikeyde noktaya ortalı (AnchorPoint Y = 1: alt kenar), ekran içinde kalır
	local py = math.clamp(y - origin.Y + h / 2, h + 4, screen.Y - 4)
	f.Position = UDim2.fromOffset(px, py)
	f.Visible = true
end

-- Bilgi paneli (radial "bilgi") ------------------------------------------------------------------

function Hud.setDiplo(self: Hud, m: DiploModel?)
	local d = self.diplo
	if not m then
		if self.cache.diplo ~= false then
			self.cache.diplo = false
			d.Visible = false
		end
		return
	end
	local sig = m.name .. "|" .. m.troops .. "|" .. m.relation .. "|" .. table.concat(m.lines or {}, "/")
	for _, b in m.buttons do
		sig ..= "|" .. b.kind .. b.text
	end
	if self.cache.diplo == sig then
		return
	end
	self.cache.diplo = sig
	d.Visible = true
	local title = find(d, "Title") :: TextLabel
	title.Text = m.name
	title.TextColor3 = m.color
	;(find(d, "Sub") :: TextLabel).Text = m.troops .. " troops · " .. m.relation
	local lines = find(d, "Lines") :: Frame
	local lt = lines:FindFirstChild("LineTemplate") :: TextLabel
	for _, c in lines:GetChildren() do
		if c:IsA("TextLabel") and c ~= lt then
			c:Destroy()
		end
	end
	for i, line in m.lines or {} do
		local l = lt:Clone()
		l.Name = "Line" .. i
		l.LayoutOrder = i
		l.Text = line
		l.Visible = true
		l.Parent = lines
	end
	local btns = find(d, "Buttons") :: Frame
	local bt = btns:FindFirstChild("ButtonTemplate") :: TextButton
	for _, c in btns:GetChildren() do
		if c:IsA("TextButton") and c ~= bt then
			c:Destroy()
		end
	end
	for i, b in m.buttons do
		local btn = bt:Clone()
		btn.Name = "B_" .. b.kind
		btn.LayoutOrder = i
		btn.Text = b.text
		btn.BackgroundColor3 = b.color
		btn.Visible = true
		btn.Parent = btns
		local kind = b.kind
		btn.Activated:Connect(function()
			self.cb.onDiplo(kind)
		end)
	end
end

-- Saldırılar ------------------------------------------------------------------------------------

function Hud.setAttacks(self: Hud, rows: { AttackRow })
	local sig = ""
	for _, r in rows do
		sig ..= r.key .. r.text .. "|"
	end
	if self.cache.attacks == sig then
		return
	end
	self.cache.attacks = sig
	local list = find(self.attacks, "List") :: Frame
	local template = list:FindFirstChild("RowTemplate") :: Frame
	for _, c in list:GetChildren() do
		if c:IsA("Frame") and c ~= template then
			c:Destroy()
		end
	end
	for i, r in rows do
		if i > 8 then
			break
		end
		local row = template:Clone()
		row.Name = "Row" .. i
		row.LayoutOrder = i
		row.Visible = true
		row.BackgroundColor3 = if r.incoming then Color3.fromRGB(127, 29, 29) else Color3.fromRGB(30, 58, 138)
		;(row:FindFirstChild("Text") :: TextLabel).Text = r.text
		local cancel = row:FindFirstChild("Cancel") :: TextButton
		if r.target then
			local target = r.target
			cancel.Activated:Connect(function()
				self.cb.onCancel(target)
			end)
		else
			cancel.Visible = false
		end
		row.Parent = list
	end
	self.attacks.Visible = #rows > 0
	self.layoutRight()
end

-- İttifak istekleri ----------------------------------------------------------------------------

function Hud.setRequests(self: Hud, rows: { RequestRow })
	local sig = ""
	for _, r in rows do
		sig ..= r.from .. ":" .. r.name .. ":" .. math.ceil(r.left / 10) .. "|"
	end
	if self.cache.req == sig then
		return
	end
	self.cache.req = sig
	local template = self.requests:FindFirstChild("CardTemplate") :: Frame
	for _, c in self.requests:GetChildren() do
		if c:IsA("Frame") and c ~= template then
			c:Destroy()
		end
	end
	for i, r in rows do
		if i > 3 then
			break
		end
		local card = template:Clone()
		card.Name = "Card" .. i
		card.LayoutOrder = i
		card.Visible = true
		;(card:FindFirstChild("Text") :: TextLabel).Text = "🤝 " .. r.name .. " wants an alliance (" .. math.ceil(r.left / 10) .. "s)"
		local from = r.from
		;(card:FindFirstChild("Accept") :: TextButton).Activated:Connect(function()
			self.cb.onRequest(from, true)
		end)
		;(card:FindFirstChild("Reject") :: TextButton).Activated:Connect(function()
			self.cb.onRequest(from, false)
		end)
		card.Parent = self.requests
		-- gölge listenin dışında, listenin hemen arkasında (kaydırılan liste kenarları kesmesin); kart silinince o da gider
		Shadow.add(card, self.gui, self.requests.ZIndex - 1)
	end
	self.layoutRight()
end

-- Altın kutusunun üstünde kısa süre "+X".
function Hud.goldGain(self: Hud, textValue: string)
	self.goldPopToken += 1
	local token = self.goldPopToken
	local pop = find(self.bottom, "Gold/Pop") :: TextLabel
	pop.Text = "+" .. textValue
	pop.Visible = true
	pop.TextTransparency = 0
	task.delay(1.6, function()
		if self.goldPopToken == token then
			local tw = TweenService:Create(pop, TweenInfo.new(0.4), { TextTransparency = 1 })
			tw:Play()
			tw.Completed:Wait()
			if self.goldPopToken == token then
				pop.Visible = false
			end
		end
	end)
end

-- Ekran kenarında iki kez yanıp sönen uyarı ("attack" turuncu, "betrayal" kırmızı).
function Hud.alert(self: Hud, kind: string)
	self.alertToken += 1
	local token = self.alertToken
	local st = self.alertFrame:FindFirstChildOfClass("UIStroke") :: UIStroke
	st.Color = if kind == "betrayal" then Color3.fromRGB(238, 0, 0) else Color3.fromRGB(255, 165, 0)
	st.Transparency = 1
	self.alertFrame.Visible = true
	task.spawn(function()
		for _ = 1, 2 do
			for _, target in { 0.15, 1 } do
				if self.alertToken ~= token then
					return
				end
				local tw = TweenService:Create(st, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Transparency = target })
				tw:Play()
				tw.Completed:Wait()
			end
		end
		if self.alertToken == token then
			self.alertFrame.Visible = false
		end
	end)
end

-- Ekran noktası (mutlak) bir panelin üstünde mi? Panel üstündeki tık/fare haritaya geçmesin.
function Hud.overPanel(self: Hud, x: number, y: number): boolean
	if not self.gui.Enabled then return false end
	for _, p in self.panels do
		if p.Visible then
			local pos, size = p.AbsolutePosition, p.AbsoluteSize
			if x >= pos.X and x <= pos.X + size.X and y >= pos.Y and y <= pos.Y + size.Y then
				return true
			end
		end
	end
	-- The scrolling viewport blocks input; clipped cards outside it do not.
	local rp, rs = self.requests.AbsolutePosition, self.requests.AbsoluteSize
	if self.requests.Visible and rs.Y > 0 and x >= rp.X and x <= rp.X + rs.X and y >= rp.Y and y <= rp.Y + rs.Y then return true end
	local ex = self.board:FindFirstChild("Expanded") :: Frame?
	if ex and ex.Visible then
		local pos, size = ex.AbsolutePosition, ex.AbsoluteSize
		if x >= pos.X and x <= pos.X + size.X and y >= pos.Y and y <= pos.Y + size.Y then
			return true
		end
	end
	for _, card in self.feed.active do
		local pos, size = card.AbsolutePosition, card.AbsoluteSize
		if x >= pos.X and x <= pos.X + size.X and y >= pos.Y and y <= pos.Y + size.Y then return true end
	end
	return false
end

return Hud
