				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Sites: yeni yapının kurulacağı tile (repo PlayerImpl.validStructureSpawnTiles / landBasedStructureSpawn / portSpawn).
-- Sunucu (kesin karar) ve istemci (önizleme) AYNI kodu kullanır; haritaya `Map` arayüzüyle erişilir.
--
-- Repo kuralları:
--   * Tıklanan tile senin değilse kurulamaz.
--   * Adaylar: tıklanana 15'ten (öklid, kesin küçük) yakın, tıklanandan kendi toprağın üzerinden (4 komşu) ulaşılan
--     tile'lar. Her yapıdan (tüm oyuncular, inşaattakiler dahil) en az STRUCTURE_MIN_DIST (15) uzak olmalı.
--   * Yapı: adaylardan tıklanana en yakını (eşitlikte arama sırası).
--   * Liman: tıklanana manhattan 20 içindeki kendi KIYI tile'ları (komşusu su) manhattan uzaklığa göre sıralanır;
--     aday kümesinde olan ilki seçilir. Yani liman, imlecin altındaki kıyıya ya da ona en yakın uygun kıyıya kurulur.

local Sites = {}

export type Map = {
	w: number,
	h: number,
	owner: (tile: number) -> number,
	isShore: (tile: number) -> boolean, -- kara ve dört komşusundan biri su
	-- (cx, cy) çevresinde `reach` yarıçapındaki TÜM yapıların tile'ları (tüm oyuncular, inşaattakiler dahil)
	structures: (cx: number, cy: number, reach: number) -> { number },
}

Sites.SEARCH_RADIUS = 15 -- repo validStructureSpawnTiles searchRadius
Sites.PORT_RADIUS = 20 -- repo radiusPortSpawn (manhattan)

local function blocked(w: number, near: { number }, x: number, y: number, minD2: number): boolean
	for _, s in near do
		local dx, dy = s % w - x, s // w - y
		if dx * dx + dy * dy < minD2 then
			return true
		end
	end
	return false
end

-- Uygun tile'lar, tıklanana öklid uzaklığa göre sıralı (eşitlikte arama sırası; repo kararlı sıralama).
-- Arama sırası repo GameMap.bfs ile aynı: yığın (son giren ilk çıkar), komşular kuzey, güney, batı, doğu.
function Sites.valid(map: Map, pid: number, tile: number, minDist: number): { number }
	local out: { number } = {}
	if pid == 0 or map.owner(tile) ~= pid then
		return out
	end
	local w, h = map.w, map.h
	local cx, cy = tile % w, tile // w
	local R2 = Sites.SEARCH_RADIUS * Sites.SEARCH_RADIUS
	local near = map.structures(cx, cy, Sites.SEARCH_RADIUS * 2)
	local minD2 = minDist * minDist
	local seen: { [number]: boolean } = { [tile] = true }
	local found: { number } = { tile }
	local stack: { number } = { tile }
	local function visit(n: number)
		if seen[n] then
			return
		end
		local dx, dy = n % w - cx, n // w - cy
		if dx * dx + dy * dy < R2 and map.owner(n) == pid then
			seen[n] = true
			found[#found + 1] = n
			stack[#stack + 1] = n
		end
	end
	while #stack > 0 do
		local t = stack[#stack]
		stack[#stack] = nil
		local x = t % w
		if t >= w then
			visit(t - w)
		end
		if t < (h - 1) * w then
			visit(t + w)
		end
		if x ~= 0 then
			visit(t - 1)
		end
		if x ~= w - 1 then
			visit(t + 1)
		end
	end
	-- kararlı sıralama: anahtar = uzaklık² * N + bulunma sırası
	local N = #found + 1
	local keys: { [number]: number } = {}
	for i, t in found do
		local x, y = t % w, t // w
		if not blocked(w, near, x, y, minD2) then
			out[#out + 1] = t
			keys[t] = ((x - cx) ^ 2 + (y - cy) ^ 2) * N + i
		end
	end
	table.sort(out, function(a: number, b: number): boolean
		return keys[a] < keys[b]
	end)
	return out
end

-- Kara yapısı (şehir, fabrika, savunma kulesi, SAM, silo) için yer; yoksa nil.
function Sites.structure(map: Map, pid: number, tile: number, minDist: number): number?
	if pid == 0 or map.owner(tile) ~= pid then
		return nil
	end
	local w = map.w
	-- hızlı yol: çevrede (30) hiç yapı yoksa tıklanan tile uygundur (uzaklık 0, ilk sırada)
	if #map.structures(tile % w, tile // w, Sites.SEARCH_RADIUS * 2) == 0 then
		return tile
	end
	return Sites.valid(map, pid, tile, minDist)[1]
end

-- Liman yeri; yoksa nil.
function Sites.port(map: Map, pid: number, tile: number, minDist: number): number?
	local valid = Sites.valid(map, pid, tile, minDist)
	if #valid == 0 then
		return nil
	end
	local okSet: { [number]: boolean } = {}
	for _, t in valid do
		okSet[t] = true
	end
	local w, h = map.w, map.h
	local cx, cy = tile % w, tile // w
	local R = Sites.PORT_RADIUS
	-- repo: bfs(tile, manhattan <= 20) sırasıyla kendi kıyı tile'ları, manhattan uzaklığa göre kararlı sıralı
	local seen: { [number]: boolean } = { [tile] = true }
	local stack: { number } = { tile }
	local order: { number } = { tile }
	local function visit(n: number)
		if not seen[n] and math.abs(n % w - cx) + math.abs(n // w - cy) <= R then
			seen[n] = true
			order[#order + 1] = n
			stack[#stack + 1] = n
		end
	end
	while #stack > 0 do
		local t = stack[#stack]
		stack[#stack] = nil
		local x = t % w
		if t >= w then
			visit(t - w)
		end
		if t < (h - 1) * w then
			visit(t + w)
		end
		if x ~= 0 then
			visit(t - 1)
		end
		if x ~= w - 1 then
			visit(t + 1)
		end
	end
	local best, bestKey = nil, math.huge
	local N = #order + 1
	for i, t in order do
		if okSet[t] and map.owner(t) == pid and map.isShore(t) then
			local k = (math.abs(t % w - cx) + math.abs(t // w - cy)) * N + i
			if k < bestKey then
				best, bestKey = t, k
			end
		end
	end
	return best
end

return Sites
]]></ProtectedString>
