							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Diplo</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">15474ccd123c712a0af50f5100000e01</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX6A84E3D0E35D4FAEA2BC68E4E58B181F">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Nation: yapı kuran yapay zekâ (OpenFront NationStructureBehavior'ın bu sürümdeki kısmı, Medium zorluk).
-- Tribe'ın içinden, kararlar arasında 3 kez çağrılır (repo: saldırı aralığının başı, 1/3'ü ve 2/3'ü).
--
--   * Savunma kulesi: ilk yapıdan sonra, gelen saldırı/asker >= 0.35 ise ve %50 ihtimalle bir kule;
--     cephenin [2/3, 7/6] kule menzili gerisine, kule yoksa. Eşik aşılıp kule kurulamıyorsa başka yapı da kurulmaz.
--   * Şehir: altın yetiyorsa. Yapı/tile yoğunluğu 1/1500'den yüksekse yeni kurmak yerine bir şehir yükseltir.
--   * Yer seçimi: 25 rastgele kendi tile'ı; skor = arazi yüksekliği + sınır uzaklığı (en çok 30) + en yakın şehir uzaklığı (en çok 60).
-- Liman: şehir sayısının 0.75 katı kadar. Fabrika/SAM/silo bu sürümde yok.

local Nation = {}

local TERRAIN_SCORE: { [number]: number } = { [1] = 10, [2] = 20, [3] = 30 }

-- Kendi toprağından rastgele n tile: rastgele sınır tile'ı + yakın rastgele sapma.
local function sampleTerritory(sim: any, pid: number, n: number, rng: any): { number }
	local border: { number } = {}
	for t in sim.world:borderOf(pid) do
		border[#border + 1] = t
	end
	if #border == 0 then
		return {}
	end
	-- (sıralama yok: büyük ulusta on binlerce tile'ı her seferinde sıralamak takılma yapıyordu)
	local w, h = sim.world.width, sim.world.height
	local out: { number } = {}
	for _ = 1, n * 4 do
		local b = border[rng:int(1, #border)]
		local x = b % w + rng:int(-12, 12)
		local y = b // w + rng:int(-12, 12)
		if x >= 0 and x < w and y >= 0 and y < h then
			local t = y * w + x
			if sim.world:ownerAt(t) == pid then
				out[#out + 1] = t
				if #out >= n then
					break
				end
			end
		end
	end
	return out
end

local function dist(w: number, a: number, b: number): number
	local dx, dy = a % w - b % w, a // w - b // w
	return math.sqrt(dx * dx + dy * dy)
end

-- Bana gelen saldırıların toplam askeri ve saldıranların bana değen sınır tile'ları (cephe).
local function incoming(sim: any, pid: number): (number, { number })
	local total = 0
	local attackers: { [number]: boolean } = {}
	for _, a in sim.attackIndex do
		if a.target == pid and sim.alive[a.pid] then
			total += a.troops
			attackers[a.pid] = true
		end
	end
	local front: { number } = {}
	if total == 0 then
		return 0, front
	end
	local world = sim.world
	local nb: { number } = {}
	for t in world:borderOf(pid) do
		local n = world:neighbors(t, nb)
		for k = 1, n do
			if attackers[world:ownerAt(nb[k])] then
				front[#front + 1] = t
				break
			end
		end
	end
	table.sort(front)
	return total, front
end

local function minDistTo(w: number, tile: number, set: { number }): number
	local best = math.huge
	for _, f in set do
		local d = dist(w, tile, f)
		if d < best then
			best = d
		end
	end
	return best
end

-- true: kule kuruldu. blocked: tehdit var ama kule yok/kurulamadı (diğer yapılar beklesin).
local function tryPost(t: any, sim: any): (boolean, boolean)
	local cfg, pid, rng = sim.cfg, t.pid, t.rng
	local total, front = incoming(sim, pid)
	if total == 0 or #front == 0 then
		return false, false
	end
	local troops = sim.troops[pid]
	if troops <= 0 or total / troops < cfg.NATION_THREAT_RATIO then
		return false, false
	end
	if rng:int(0, 1) ~= 0 then -- Medium: her çağrıda %50
		return false, false
	end
	local w = sim.world.width
	local range = cfg.DEFENSE_POST_RANGE
	local minD, maxD = range * cfg.NATION_POST_DIST[1], range * cfg.NATION_POST_DIST[2]
	-- cephe yakınında zaten kule var mı? (Medium: toplam 1)
	for _, p in sim.posts[pid] do
		if minDistTo(w, p.tile, front) <= maxD then
			return false, false
		end
	end
	if sim.gold[pid] < sim:structureCost(pid, "post") then
		return false, true
	end
	if #front > 200 then
		local s: { number } = {}
		for i = 1, 200 do
			s[i] = front[rng:int(1, #front)]
		end
		front = s
	end
	for _, tile in sampleTerritory(sim, pid, sim.cfg.NATION_POST_SAMPLES, rng) do
		local d = minDistTo(w, tile, front)
		if d >= minD and d <= maxD and sim:findStructureSite(pid, tile) == tile then
			sim:addExecution(sim.parts.Build.new(pid, "post", tile, false))
			return true, false
		end
	end
	return false, true
end

-- Liman: şehir sayısının 0.75 katı kadar (repo oranı), kıyıdaki kendi tile'larından rastgele 25 örnek.
local function tryPort(t: any, sim: any): boolean
	local cfg, pid, rng, world = sim.cfg, t.pid, t.rng, sim.world
	local cities = sim.structCount[pid].city
	if math.floor(cities * 0.75) - sim.structCount[pid].port <= 0 then
		return false
	end
	if sim.gold[pid] < sim:structureCost(pid, "port") then
		return false
	end
	local shores: { number } = {}
	for b in world:borderOf(pid) do
		if world:shoreComponent(b) then
			shores[#shores + 1] = b
		end
	end
	if #shores == 0 then
		return false
	end
	local w = world.width
	local ports: { number } = {}
	for _, st in sim.structList do
		if st.pid == pid and st.type == "port" then
			ports[#ports + 1] = st.tile
		end
	end
	local bestTile, bestV = nil, -1
	for _ = 1, cfg.NATION_SAMPLES do
		local tile = shores[rng:int(1, #shores)]
		local v = 0
		local d = minDistTo(w, tile, ports)
		if d ~= math.huge then
			v += math.min(d, cfg.NATION_NUKE_SPACING * 2)
		end
		if v > bestV and sim:findPortSite(pid, tile) == tile then
			bestTile, bestV = tile, v
		end
	end
	if bestTile then
		sim:addExecution(sim.parts.Build.new(pid, "port", bestTile, false))
		return true
	end
	return false
end

local function tryCity(t: any, sim: any): boolean
	local cfg, pid, rng, world = sim.cfg, t.pid, t.rng, sim.world
	if sim.gold[pid] < sim:structureCost(pid, "city") then
		return false
	end
	local tiles = world:tilesOwnedBy(pid)
	-- Yoğunluk yüksekse yükselt (şehir sayısı; kuleler sayılmaz).
	if tiles > 0 and sim.structCount[pid].city / tiles > cfg.NATION_UPGRADE_DENSITY then
		local ready: { any } = {}
		for _, st in sim.structList do
			if st.pid == pid and st.type == "city" and st.ready then
				ready[#ready + 1] = st
			end
		end
		if #ready > 0 then
			table.sort(ready, function(a: any, b: any): boolean
				return a.tile < b.tile
			end)
			local st = ready[rng:int(1, #ready)]
			sim:addExecution(sim.parts.Build.new(pid, "city", st.tile, true))
			return true
		end
		if sim.structCount[pid].city > 0 then
			return false -- inşaat bitsin
		end
	end

	local w = world.width
	local spacing = cfg.NATION_NUKE_SPACING
	-- sınıra uzaklık için sınırın seyreltilmiş bir örneği yeterli (en çok ~400 tile; eskiden tüm sınır x 25 örnek)
	local border: { number } = {}
	local all: { number } = {}
	for b in world:borderOf(pid) do
		all[#all + 1] = b
	end
	local stride = math.max(1, math.ceil(#all / 400))
	for i = 1, #all, stride do
		border[#border + 1] = all[i]
	end
	local cities: { number } = {}
	for _, st in sim.structList do
		if st.pid == pid and st.type == "city" then
			cities[#cities + 1] = st.tile
		end
	end
	local bestTile, bestV = nil, -1
	for _, tile in sampleTerritory(sim, pid, cfg.NATION_SAMPLES, rng) do
		local v = TERRAIN_SCORE[world:terrainAt(tile)] or 10
		v += math.min(minDistTo(w, tile, border), spacing)
		local dc = minDistTo(w, tile, cities)
		if dc ~= math.huge then
			v += math.min(dc, spacing * 2)
		end
		if v > bestV and sim:findStructureSite(pid, tile) == tile then
			bestTile, bestV = tile, v
		end
	end
	if bestTile then
		sim:addExecution(sim.parts.Build.new(pid, "city", bestTile, false))
		return true
	end
	return false
end

-- Fabrika (repo): şehir x 0.75 (kıyısı varsa x 0.45 daha az: Medium), seviye toplamı bu hedefin altındaysa kurar.
-- Yer: 25 rastgele örnek; çevresindeki (110 tile) kendi şehir/limanı çok olan, diğer fabrikalardan uzak olan tercih edilir.
local function tryFactory(t: any, sim: any): boolean
	local cfg, pid, rng, world = sim.cfg, t.pid, t.rng, sim.world
	local cities = sim.structCount[pid].city
	local coastal = false
	for b in world:borderOf(pid) do
		if world:shoreComponent(b) then
			coastal = true
			break
		end
	end
	local ratio = if coastal then 0.75 * 0.45 else 0.75
	if math.floor(cities * ratio) - sim:levelsOwned(pid, "factory") <= 0 then
		return false
	end
	if sim.gold[pid] < sim:structureCost(pid, "factory") then
		return false
	end
	local w = world.width
	local range2 = cfg.STATION_MAX_RANGE ^ 2
	local factories: { number } = {}
	for _, st in sim.structList do
		if st.pid == pid and st.type == "factory" then
			factories[#factories + 1] = st.tile
		end
	end
	local bestTile, bestV = nil, -1
	for _, tile in sampleTerritory(sim, pid, cfg.NATION_SAMPLES, rng) do
		local v = 0
		for _, st in sim.structList do
			if st.pid == pid and (st.type == "city" or st.type == "port") then
				local dx, dy = st.tile % w - tile % w, st.tile // w - tile // w
				if dx * dx + dy * dy <= range2 then
					v += 10
				end
			end
		end
		local df = minDistTo(w, tile, factories)
		if df ~= math.huge then
			v += math.min(df, 60)
		end
		if v > bestV and sim:findStructureSite(pid, tile) == tile then
			bestTile, bestV = tile, v
		end
	end
	if bestTile then
		sim:addExecution(sim.parts.Build.new(pid, "factory", bestTile, false))
		return true
	end
	return false
end

-- Silo / SAM (repo NationStructureBehavior, Medium) ---------------------------------------
-- Silo: şehir x 0.2 (ilk silo için x 0.4), en çok 3. SAM: şehir x 0.2. Yer: şehir gibi rastgele 25 örnek; SAM'da korunan yapı
-- (şehir, liman, silo) sayısı en çok olan örnek. Tüm yapılar zaten SAM menzilindeyse %50 ile en çok yapıyı koruyan SAM yükseltilir.
local PROTECTED = { city = true, port = true, silo = true }

local function protectedNear(sim: any, pid: number, tile: number, range: number): number
	local w = sim.world.width
	local n = 0
	for _, st in sim.structList do
		if st.pid == pid and PROTECTED[st.type] then
			local dx, dy = st.tile % w - tile % w, st.tile // w - tile // w
			if dx * dx + dy * dy <= range * range then
				n += st.level
			end
		end
	end
	return n
end

local function tryMilitary(t: any, sim: any, what: string): boolean
	local cfg, pid, rng, world = sim.cfg, t.pid, t.rng, sim.world
	local cities = sim.structCount[pid].city
	local owned = sim.structCount[pid][what]
	local due
	if what == "silo" then
		if not cfg.NATION_NUKES then
			return false
		end
		local ratio = if owned == 0 then 0.4 else cfg.NATION_MILITARY_RATIO
		due = math.min(math.floor(cities * ratio), 3) - owned
	else
		due = math.floor(cities * cfg.NATION_MILITARY_RATIO) - owned
	end
	if due <= 0 or sim.gold[pid] < sim:structureCost(pid, what) then
		return false
	end
	local w = sim.world.width
	if what == "sam" and owned > 0 then
		local sams: { any } = {}
		local allCovered = true
		for _, st in sim.structList do
			if st.pid == pid and st.type == "sam" and st.ready then
				sams[#sams + 1] = st
			end
		end
		for _, st in sim.structList do
			if st.pid == pid and PROTECTED[st.type] then
				local covered = false
				for _, s in sams do
					local dx, dy = st.tile % w - s.tile % w, st.tile // w - s.tile // w
					if dx * dx + dy * dy <= sim.parts.Nuke.samRange(cfg, s, sim.tickNo) ^ 2 then
						covered = true
						break
					end
				end
				if not covered then
					allCovered = false
					break
				end
			end
		end
		if allCovered and #sams > 0 and rng:int(0, 99) < 50 then
			local best, bestV = nil, -1
			table.sort(sams, function(a: any, b: any): boolean
				return a.tile < b.tile
			end)
			for _, s in sams do
				local v = protectedNear(sim, pid, s.tile, sim.parts.Nuke.samRange(cfg, s, sim.tickNo))
				if v > bestV then
					best, bestV = s, v
				end
			end
			if best then
				sim:addExecution(sim.parts.Build.new(pid, "sam", best.tile, true))
				return true
			end
		end
	end
	local spacing = cfg.NATION_NUKE_SPACING
	local border: { number } = {}
	if what ~= "sam" then
		local all: { number } = {}
		for b in world:borderOf(pid) do
			all[#all + 1] = b
		end
		local stride = math.max(1, math.ceil(#all / 400))
		for i = 1, #all, stride do
			border[#border + 1] = all[i]
		end
	end
	local bestTile, bestV = nil, -1
	for _, tile in sampleTerritory(sim, pid, cfg.NATION_SAMPLES, rng) do
		local v
		if what == "sam" then
			v = protectedNear(sim, pid, tile, 70)
		else
			v = math.min(minDistTo(w, tile, border), spacing) + (TERRAIN_SCORE[world:terrainAt(tile)] or 10)
		end
		if v > bestV and sim:findStructureSite(pid, tile) == tile then
			bestTile, bestV = tile, v
		end
	end
	if bestTile then
		sim:addExecution(sim.parts.Build.new(pid, what, bestTile, false))
		return true
	end
	return false
end

-- Bomba (repo NationNukeBehavior, Medium; sadeleştirilmiş) --------------------------------
-- Hedef: bize en büyük saldırıyı yapan, sonra üstümüze bomba atan, sonra saldırdığımız (askeri bizim yarımızdan fazla) oyuncu,
-- sonra en düşmanca (ilişki < -50) olan (biz onun tavanının 2 katından büyük değilsek). Bot, müttefik ve kendimiz hariç.
-- Nokta: hedefin 10 rastgele tile'ı + yapıları; patlamanın %25'i (atom) / %40'ı (hidrojen) düşman karası olmalı, bizimkine ya da
-- müttefiğe dokunmamalı, yakında aynı türden bomba inmemeli. Skor: vurulan yapı seviyesi + kapsama x 50000. Önce hidrojen.
local function blastInfo(sim: any, me: number, target: number, tile: number, outer: number): (number, boolean)
	local world = sim.world
	local w, h = world.width, world.height
	local cx, cy = tile % w, tile // w
	local step = math.max(2, outer // 12)
	local total, enemy = 0, 0
	local D = sim.parts.Diplomacy
	for y = math.max(0, cy - outer), math.min(h - 1, cy + outer), step do
		for x = math.max(0, cx - outer), math.min(w - 1, cx + outer), step do
			if (x - cx) ^ 2 + (y - cy) ^ 2 <= outer * outer then
				total += 1
				local o = world:ownerAt(y * w + x)
				if o == target then
					enemy += 1
				elseif o ~= 0 and (o == me or D.isAllied(sim, me, o)) then
					return 0, false
				end
			end
		end
	end
	return enemy / math.max(total, 1), true
end

local function chooseNukeTarget(t: any, sim: any): number?
	local pid, D = t.pid, sim.parts.Diplomacy
	local function ok(p: number): boolean
		return p ~= pid and sim.alive[p] and sim.spawned[p] and (not sim.isBot[p] or sim.isNation[p]) and not D.isAllied(sim, pid, p)
	end
	local best, bestT = nil, 0
	for _, a in sim.attackIndex do
		if a.target == pid and a.troops > bestT and ok(a.pid) then
			best, bestT = a.pid, a.troops
		end
	end
	if best then
		return best
	end
	for k = 1, sim.executionCount do
		local e = sim.executions[k]
		if e and e.kind == "nuke" and not e.done and e.pid ~= pid and sim.world:ownerAt(e.tile) == pid and ok(e.pid) then
			return e.pid
		end
	end
	for _, a in sim.attackIndex do
		if a.pid == pid and a.target ~= 0 and ok(a.target) and sim.troops[a.target] >= sim.troops[pid] * 0.5 then
			return a.target
		end
	end
	local myMax = sim:maxTroopsOf(pid)
	local worst, worstV = nil, -50
	for p = 1, sim.playerCount do
		if ok(p) then
			local r = D.relation(sim, pid, p)
			if r < worstV and myMax < sim:maxTroopsOf(p) * 2 then
				worst, worstV = p, r
			end
		end
	end
	return worst
end

function Nation.nuke(t: any, sim: any)
	if not sim.cfg.NATION_NUKES then
		return
	end
	local cfg, pid, rng = sim.cfg, t.pid, t.rng
	if not sim.parts.Nuke.readySilo(sim, pid, 0) then
		return
	end
	local what
	if sim.gold[pid] >= cfg.NUKE_COST_HYDRO then
		what = "hydro"
	elseif sim.gold[pid] >= cfg.NUKE_COST_ATOM then
		what = "atom"
	else
		return
	end
	local target = chooseNukeTarget(t, sim)
	if not target then
		return
	end
	local _, outer = sim.parts.Nuke.magnitude(cfg, what)
	local cands = sampleTerritory(sim, target, 10, rng)
	local weight: { [number]: number } = {}
	for _, st in sim.structList do
		if st.pid == target then
			table.insert(cands, st.tile)
		end
	end
	local w = sim.world.width
	local bestTile, bestV = nil, -1
	for _, tile in cands do
		local cov, valid = blastInfo(sim, pid, target, tile, outer)
		local minCov = if what == "hydro" then 0.4 else 0.25
		if valid and cov >= minCov then
			local landing = false
			for k = 1, sim.executionCount do
				local e = sim.executions[k]
				if e and e.kind == "nuke" and not e.done and e.what == what then
					local dx, dy = e.tile % w - tile % w, e.tile // w - tile // w
					if dx * dx + dy * dy < outer * outer then
						landing = true
						break
					end
				end
			end
			if not landing then
				local v = cov * 50000
				for _, st in sim.structList do
					if st.pid == target then
						local dx, dy = st.tile % w - tile % w, st.tile // w - tile // w
						if dx * dx + dy * dy < outer * outer then
							v += st.level * (if st.type == "city" then 10000 else 5000)
						end
					end
				end
				weight[tile] = v
				if v > bestV then
					bestTile, bestV = tile, v
				end
			end
		end
	end
	if bestTile then
		sim:addExecution(sim.parts.Nuke.new(pid, what, bestTile))
	end
end

-- Savaş gemisi (repo NationWarshipBehavior, Medium) ---------------------------------------
-- Gemisi yoksa, limanı varsa ve altını yetiyorsa her karar anında %50: rastgele limanın 250 tile çevresindeki
-- (aynı denize bakan) bir su noktasına devriyeye gemi kurar.
function Nation.warshipSpawn(t: any, sim: any)
	local cfg, pid, world = sim.cfg, t.pid, sim.world
	if not cfg.NATION_PATROL or (sim.warshipCount[pid] or 0) > 0 or t.rng:int(0, 99) >= 50 then
		return
	end
	local ports = {}
	for _, st in sim.structList do
		if st.pid == pid and st.type == "port" and st.ready then
			table.insert(ports, st)
		end
	end
	if #ports == 0 or sim.gold[pid] <= math.min(cfg.WARSHIP_COST_MAX, cfg.WARSHIP_COST_STEP) then
		return
	end
	local port = ports[t.rng:int(1, #ports)]
	local w, nb = world.width, {}
	local n = world:neighbors(port.tile, nb)
	local comps: { [number]: boolean } = {}
	for k = 1, n do
		if world:isWater(nb[k]) then
			comps[world:waterComponent(nb[k])] = true
		end
	end
	local px, py = port.tile % w, port.tile // w
	for _ = 1, 50 do
		local x, y = t.rng:int(px - 250, px + 250), t.rng:int(py - 250, py + 250)
		local tile = world:index(x, y)
		if tile and world:isWater(tile) and comps[world:waterComponent(tile)] then
			sim:addExecution(sim.parts.Warship.new(pid, tile))
			return
		end
	end
end

-- Nakliye gemisi batırılınca / ticaret gemisi ele geçirilince (Medium: %15) olay yerine savaş gemisi gönderir ve
-- saldırgana karşı ilişkiyi düşürür (ticaret -7.5, nakliye -15). Ağırlık: en fazla 10 gemi; zaten devriye varsa yenisi yok.
function Nation.shipLost(sim: any, victim: number, tile: number, killer: number, reason: string)
	if not sim.isNation[victim] or not sim.alive[victim] or victim == killer then
		return
	end
	local cfg = sim.cfg
	local hasPort = false
	for _, st in sim.structList do
		if st.pid == victim and st.type == "port" then
			hasPort = true
			break
		end
	end
	if not hasPort or (sim.warshipCount[victim] or 0) >= 10 then
		return
	end
	local w = sim.world.width
	for k = 1, sim.executionCount do
		local e = sim.executions[k]
		if e and e.kind == "warship" and e.pid == victim and not e.done then
			if math.abs(e.patrol % w - tile % w) + math.abs(e.patrol // w - tile // w) <= cfg.WARSHIP_PATROL_RANGE then
				return
			end
		end
	end
	if sim.rng:int(0, 99) >= cfg.NATION_REVENGE_PCT then
		return
	end
	sim:addExecution(sim.parts.Warship.new(victim, tile))
	sim.parts.Diplomacy.updateRelation(sim, victim, killer, if reason == "trade" then -7.5 else -15)
end

function Nation.structures(t: any, sim: any)
	t.placements = t.placements or 0
	if t.placements > 0 then
		local built, blocked = tryPost(t, sim)
		if built then
			return
		end
		if blocked then
			return
		end
	end
	if tryPort(t, sim) or tryFactory(t, sim) or tryMilitary(t, sim, "sam") or tryMilitary(t, sim, "silo") or tryCity(t, sim) then
		t.placements += 1
	end
end

return Nation
]]></ProtectedString>
