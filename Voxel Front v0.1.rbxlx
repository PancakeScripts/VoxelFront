				<ProtectedString name="Source"><![CDATA[--!strict
-- Sunucu giriş noktası. Solo maç oyuncunun cihazında çalışır (Client + Shared.Match).
-- Normal (herkese açık) sunucular online eşleştirmeyi yönetir (Hub); online maçın kendisi lobinin ayrılmış (reserved)
-- sunucusunda çalışır (MatchServer). Studio'da ayrılmış sunucu yoktur: Hub maçı aynı sunucuda oynatır.

local OnlineConfig = require(script.OnlineConfig)

-- oyuncu kaydı (yeni oyuncu -> tutorial, maç sayısı) ve Tutorial hunisi: her sunucuda
require(script.Profile).start()
require(script.Analytics).start(require(script.Profile)) -- (Onboarding / Match hunileri, elenme ve çıkış durumu)
require(script.Wallet).start() -- (Medals, kasalar, kozmetikler, Robux satın almaları: her sunucuda)

local isMatchServer = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
if isMatchServer then
	require(script.MatchServer).reserved()
elseif OnlineConfig.enabled() then
	require(script.Hub).start()
end
]]></ProtectedString>
