						<ProtectedString name="Source"><![CDATA[--!strict
-- Teams: takım maçlarının (Team Public) takımları, kim hangi takımda ve renkleri.
-- RoWorld (Snick Co., AGPL-3.0) src/shared/Core/Teams.luau'dan 2-4 takıma indirilmiş kendi uyarlamamız.
--
-- Kurallar:
--   * 2, 3 ya da 4 takım: Red, Blue, Yellow, Green.
--   * İnsan oyuncu: birlikte gelen grubu (parti) hangi takımdaysa o takıma; yoksa en az insanı olan takıma
--     (eşitse en az üyeli, o da eşitse ilk takım). Grup bütün halde aynı takımda kalır.
--   * Uluslar en az üyeli takıma (Simulation.spawnBots karışık sırayla verir: takımlara dengeli dağılır).
--   * Botlar (tribes) hiçbir takımda değildir (0).

local Teams = {}

Teams.MIN = 2
Teams.MAX = 4
Teams.NAMES = { "Red", "Blue", "Yellow", "Green" }
-- Takımların ana rengi (RoWorld Teams.BASE); oyuncular bu rengin tonlarını alır.
Teams.BASE = {
	Red = "#eb3333",
	Blue = "#2962ff",
	Yellow = "#e7b008",
	Green = "#41be52",
}

-- Geçerli takım sayısı: 2..4, aksi 0 (herkes kendi için).
function Teams.count(n: any): number
	if type(n) ~= "number" or n ~= n then
		return 0
	end
	n = math.floor(n)
	return if n >= Teams.MIN then math.min(n, Teams.MAX) else 0
end

-- "3 Teams"
function Teams.label(n: number): string
	return string.format("%d Teams", n)
end

function Teams.name(t: number): string
	return Teams.NAMES[t] or ("Team " .. t)
end

-- Yeni üyenin takımı. humans / members: takım başına şu anki insan / toplam üye sayısı (1..n).
-- human: insan oyuncu (önce en az insanlı takım); değilse (ulus) en az üyeli takım.
function Teams.pick(humans: { number }, members: { number }, human: boolean): number
	local best = 1
	for t = 2, #members do
		local d = if human then humans[t] - humans[best] else 0
		if d < 0 or (d == 0 and members[t] < members[best]) then
			best = t
		end
	end
	return best
end

return Teams
]]></ProtectedString>
