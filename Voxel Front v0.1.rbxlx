				<Item class="ModuleScript" referent="RBX8F1D62E40E8F47C8A746A24CC85FDB77">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- TeamTests: takım maçı kuralları (Shared.Core.Teams, Simulation takımları, Diplomacy.sameTeam, takım zaferi).
-- Oyunda çalışmaz; Studio'da Play sırasında Server'da elle:
-- require(game.ServerScriptService.Server.Dev.TeamTests).run()  -> { passed, failed, lines }

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Core = Shared:WaitForChild("Core")
local Ex = Core:WaitForChild("Executions")

local TeamTests = {}

local function parts()
	return {
		Territory = require(Core.Territory), Rng = require(Core.Rng), Economy = require(Core.Economy), Heap = require(Core.Heap),
		Spawn = require(Ex.Spawn), Attack = require(Ex.Attack), Cancel = require(Ex.Cancel), Tribe = require(Ex.Tribe),
		Build = require(Ex.Build), Boat = require(Ex.Boat), Naval = require(Core.Naval), NationNaval = require(Core.NationNaval),
		Nation = require(Ex.Nation), Trade = require(Ex.Trade), Warship = require(Ex.Warship), Diplomacy = require(Core.Diplomacy),
		Diplo = require(Ex.Diplo), Nuke = require(Ex.Nuke), Rail = require(Core.Rail), Train = require(Ex.Train),
		Sites = require(Shared.Sites), Teams = require(Core.Teams),
	}
end

-- Tamamı ova olan küçük dünya, nations ulus, bots bot; teams takım (0 = FFA).
local function newSim(teams: number, nations: number, bots: number)
	local W, H = 160, 80
	local terrain = buffer.create(W * H)
	buffer.fill(terrain, 0, 1)
	local world = require(Core.World).new(W, H, terrain)
	local p = parts()
	p.Naval.prepare(world)
	p.Rail.prepare(world)
	local cfg = table.clone(require(Shared.Config))
	cfg.NATION_COUNT = nations
	cfg.BOT_COUNT = bots
	cfg.BOT_SPAWN_MIN_DIST = 10
	local sim = require(Core.Simulation).new(world, cfg, 7, p)
	sim:setTeams(teams)
	sim:spawnBots()
	return sim, world
end

local function hasEvent(events: { any }, pid: number, code: string): boolean
	for _, e in events do
		if e.pid == pid and e.code == code then
			return true
		end
	end
	return false
end

function TeamTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end
	local Teams = require(Core.Teams)
	local D = require(Core.Diplomacy)

	-- Teams modülü
	expect(Teams.count(2) == 2 and Teams.count(4) == 4 and Teams.count(5) == 4 and Teams.count(1) == 0 and Teams.count(nil) == 0, "takım sayısı 2..4, aksi FFA")
	expect(Teams.label(3) == "3 Teams" and Teams.name(1) == "Red" and Teams.name(4) == "Green", "adlar")
	expect(Teams.pick({ 1, 0, 1 }, { 5, 9, 2 }, true) == 2, "insan: en az insanlı takım (üye sayısı ikinci)")
	expect(Teams.pick({ 1, 1, 1 }, { 5, 9, 2 }, true) == 3, "insan: eşit insanda en az üyeli")
	expect(Teams.pick({ 0, 3, 0 }, { 4, 1, 4 }, false) == 2, "ulus: en az üyeli takım")

	-- uluslar dengeli dağılır, botlar takımsız
	do
		local sim = newSim(3, 9, 4)
		local per, botsOff = { 0, 0, 0 }, true
		for pid = 1, sim.playerCount do
			if sim.alive[pid] then
				if sim.isNation[pid] then
					per[sim.team[pid]] = (per[sim.team[pid]] or 0) + 1
				elseif sim.isBot[pid] and sim.team[pid] ~= 0 then
					botsOff = false
				end
			end
		end
		expect(per[1] == 3 and per[2] == 3 and per[3] == 3, string.format("9 ulus 3 takıma 3'er (%d/%d/%d)", per[1], per[2], per[3]))
		expect(botsOff, "botlar takımsız")
	end

	-- insanlar: en az insanlı takım, grup aynı takımda
	local sim, world = newSim(2, 4, 0)
	local a = sim:addPlayer("A", false)
	local b = sim:addPlayer("B", false)
	expect(sim.team[a] ~= 0 and sim.team[b] ~= 0 and sim.team[a] ~= sim.team[b], "iki insan iki ayrı takıma")
	local c = sim:addPlayer("C", false, "party1")
	local d = sim:addPlayer("D", false, "party1")
	expect(sim.team[c] == sim.team[d], "aynı partidekiler aynı takımda")
	local spec = sim:addPlayer("S", true)
	expect(sim.team[spec] == 0, "izleyici takımsız")
	expect(sim:join(spec) == "joined" and sim.team[spec] ~= 0, "başlangıç fazında katılan takıma girer")

	-- dostluk: takım arkadaşı müttefik sayılır ama ittifak değildir
	local mate = if sim.team[c] == sim.team[a] then c else d
	if sim.team[mate] ~= sim.team[a] then
		mate = b -- (olmaz; güvenlik)
	end
	local foe = if sim.team[b] ~= sim.team[a] then b else c
	expect(D.sameTeam(sim, a, mate) and D.isAllied(sim, a, mate), "takım arkadaşı dost")
	expect(not D.isAllied(sim, a, foe), "rakip takım dost değil")
	expect(D.allianceOf(sim, a, mate) == nil, "takım arkadaşlığı ittifak kaydı değil")
	local ok = D.canSendRequest(sim, a, mate)
	expect(not ok, "takım arkadaşına ittifak isteği gönderilemez")

	-- maçı başlat: herkes yerleşir
	for pid = 1, sim.playerCount do
		if sim.alive[pid] and not sim.spawned[pid] then
			sim:autoSpawn(pid)
		end
	end
	sim:startRun()
	sim:takeEvents()
	local Attack = require(Ex.Attack)
	Attack.new(a, mate, 0.5):init(sim)
	expect(hasEvent(sim:takeEvents(), a, "teammate"), "takım arkadaşına saldırı: 'teammate'")
	local Nuke = require(Ex.Nuke)
	sim.gold[a] = 1e9
	local mateTile = world:centerOf(mate)
	Nuke.new(a, "atom", mateTile):init(sim)
	expect(hasEvent(sim:takeEvents(), a, "teammate") and sim.gold[a] == 1e9, "takım arkadaşına bomba atılamaz (altın gitmez)")
	require(Ex.Diplo).new(a, "embargo", mate, true):init(sim)
	expect(hasEvent(sim:takeEvents(), a, "teammate") and not D.hasEmbargo(sim, a, mate), "takım arkadaşına ambargo konamaz")
	D.breakAlliance(sim, a, mate)
	expect(D.isAllied(sim, a, mate) and not D.isTraitor(sim, a), "takım arkadaşlığı bozulamaz, hain olunmaz")
	expect(D.nationBetray(sim, a, { mate }, {}) == nil, "ulus yapay zekâsı takım arkadaşını bozmaz")

	-- takım zaferi: takımın toplam toprağı %80'i geçince
	expect(sim.phase == "run", "maç sürüyor")
	local winT = sim.team[a]
	local members: { number } = {}
	for pid = 1, sim.playerCount do
		if sim.alive[pid] and sim.team[pid] == winT then
			table.insert(members, pid)
		end
	end
	local need = math.floor(world.landCount * 0.81)
	local k = 0
	for t = 0, world.size - 1 do
		if k >= need then
			break
		end
		if world:isLand(t) then
			local o = world:ownerAt(t)
			if o == 0 or sim.team[o] ~= winT then
				k += 1
				world:setOwner(t, members[(k % #members) + 1])
			else
				k += 1
			end
		end
	end
	for pid = 1, sim.playerCount do
		if sim.alive[pid] and sim.team[pid] ~= winT and sim.spawned[pid] and world:tilesOwnedBy(pid) == 0 then
			sim:checkEliminated(pid)
		end
	end
	local alone = 0
	for _, pid in members do
		alone = math.max(alone, world:tilesOwnedBy(pid))
	end
	expect(alone * 100 < world.landCount * 80, "takımda tek başına %80'i geçen yok (takım toplamı sayılıyor)")
	sim:checkWin()
	expect(sim.phase == "ended" and sim.winnerTeam == winT and sim.team[sim.winner] == winT, string.format("takım kazandı (winnerTeam %d)", sim.winnerTeam))

	-- yeni tur: takımlar yeniden dağıtılır
	sim:newRound()
	expect(sim.winnerTeam == 0 and sim.team[a] ~= 0, "yeni turda takımlar yeniden verilir")

	-- FFA değişmedi
	local ffa = newSim(0, 4, 2)
	local x = ffa:addPlayer("X", false)
	local y = ffa:addPlayer("Y", false)
	expect(ffa.teamCount == 0 and ffa.team[x] == 0 and not D.isAllied(ffa, x, y), "FFA: takım yok, kimse dost değil")

	-- oyundan çıkan oyuncunun toprağı kalır (AFK gibi); yerleşmemiş olan tamamen çıkar
	ffa:autoSpawn(x)
	local tiles = ffa.world:tilesOwnedBy(x)
	ffa:detachPlayer(x)
	expect(tiles > 0 and ffa.world:tilesOwnedBy(x) == tiles and ffa.alive[x] and ffa.present[x] == false, string.format("çıkan oyuncunun toprağı kalır (%d tile)", tiles))
	ffa:detachPlayer(y)
	expect(not ffa.alive[y], "yerleşmeden çıkan oyuncu maçtan çıkar (onun yerine yerleştirilmez)")

	return { passed = passed, failed = failed, lines = lines }
end

return TeamTests
]]></ProtectedString>
						<string name="ScriptGuid">{47D8661E-84E9-483F-8DF0-24B5E5A80A10}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">TeamTests</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3abc2e7abc08fc260afd0f1600000c16</UniqueId>
