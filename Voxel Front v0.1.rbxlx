					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- NameBox: oyuncu adının yeri ve yazı boyutu (OpenFront NameBoxCalculator.placeName'in Luau karşılığı).
-- Sınır kutusu bulunur, kutu ızgaraya bölünür (boyuta göre 1..32 tile'lık hücre), sahip olunan / kıyı / sığ deniz hücrelerinden
-- oluşan en büyük dikdörtgen bulunur; yazı bu dikdörtgenin içine sığacak boyutta ortalanır.

local NameBox = {}

local function largestInHistogram(heights: { number }, n: number): (number, number, number, number)
	-- (x, genişlik, yükseklik, alan)
	local stack: { number } = {}
	local top = 0
	local bestX, bestW, bestH, bestArea = 0, 0, 0, 0
	for i = 0, n do
		local h = if i == n then 0 else heights[i + 1]
		while top > 0 and h < heights[stack[top] + 1] do
			local height = heights[stack[top] + 1]
			top -= 1
			local width = if top == 0 then i else i - stack[top] - 1
			if height * width > bestArea then
				bestArea = height * width
				bestX = if top == 0 then 0 else stack[top] + 1
				bestW = width
				bestH = height
			end
		end
		top += 1
		stack[top] = i
	end
	return bestX, bestW, bestH, bestArea
end

-- Döner: merkez tile, yazı boyutu (tile birimi). Yazılacak yer bulunamazsa nil.
-- `tileBytes` (varsa) kıyı ve sığ deniz hücrelerini de uygun sayar; yoksa yalnız sahip olunan hücreler.
function NameBox.compute(world: any, pid: number, nameLength: number, tileBytes: buffer?): (number?, number, { number }?)
	local border = world:borderOf(pid)
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	local w = world.width
	for t in border do
		local x, y = t % w, t // w
		if x < minX then
			minX = x
		end
		if x > maxX then
			maxX = x
		end
		if y < minY then
			minY = y
		end
		if y > maxY then
			maxY = y
		end
	end
	if minX == math.huge then
		return nil, 0, nil
	end
	local size = math.min(maxX - minX, maxY - minY)
	local s = if size < 25 then 1 elseif size < 50 then 2 elseif size < 100 then 4 elseif size < 250 then 8 elseif size < 500 then 16 else 32

	local gx0, gy0 = minX // s, minY // s
	local cols = maxX // s - gx0 + 1
	local rows = maxY // s - gy0 + 1
	local heights: { number } = table.create(cols, 0)
	local bestArea, bestX, bestY, bestW, bestH = 0, 0, 0, 0, 0
	local owner = world.owner
	for row = 0, rows - 1 do
		local y = (gy0 + row) * s
		for col = 0, cols - 1 do
			local x = (gx0 + col) * s
			local ok = false
			if x < w and y < world.height then
				local t = y * w + x
				if buffer.readu16(owner, t * 2) % 32768 == pid or world:hasFallout(t) then
					ok = true
				elseif tileBytes then
					local b = buffer.readu8(tileBytes, t)
					local land = bit32.band(b, 0x80) ~= 0
					if land then
						ok = bit32.band(b, 0x40) ~= 0 -- kıyı karası
					else
						ok = bit32.band(b, 0x20) ~= 0 and bit32.band(b, 0x1F) < 10 -- sığ okyanus
					end
				end
			end
			heights[col + 1] = if ok then heights[col + 1] + 1 else 0
		end
		local rx, rw, rh, area = largestInHistogram(heights, cols)
		if area > bestArea then
			bestArea = area
			bestX, bestY, bestW, bestH = rx, row - rh + 1, rw, rh
		end
	end
	if bestArea == 0 then
		return nil, 0, { minX, minY, maxX, maxY }
	end
	local rw, rh = bestW * s, bestH * s
	local cx = bestX * s + rw // 2 + minX
	local cy = bestY * s + rh // 2 + minY
	local fontSize = math.min(rw / math.max(nameLength, 1) * 2, rh / 3)
	cy = math.floor(cy - fontSize / 3)
	cx = math.clamp(cx, 0, w - 1)
	cy = math.clamp(cy, 0, world.height - 1)
	return cy * w + cx, fontSize, { minX, minY, maxX, maxY }
end

return NameBox
]]></ProtectedString>
