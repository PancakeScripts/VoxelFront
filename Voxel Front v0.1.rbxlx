					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- One responsive right column. Geometry is computed from viewport dimensions,
-- never stale AbsoluteSize values from the preceding Roblox layout pass.
local RunService = game:GetService("RunService")
local UiScale = require(script.Parent.UiScale)
local Layout = {}
function Layout.attach(hud: any)
 local gui, expanded = hud.gui, hud.board.Expanded
 local diploPosition=hud.diplo.Position
 -- right edge of the column = Leaderboard's X in StarterGui (what Studio shows)
 local rightScale=hud.board.Position.X.Scale
 local busy=false
 local function countRows(parent: Instance): number
  local n=0
  for _,c in parent:GetChildren() do if c:IsA("Frame") and c.Visible then n+=1 end end
  return n
 end
 local function box(o: any, w: number, h: number)
  w=math.max(1,math.floor(w)); h=math.max(1,math.floor(h))
  local ar=o:FindFirstChildOfClass("UIAspectRatioConstraint")
  if ar then ar.AspectRatio=w/h end
  o.Size=UDim2.fromOffset(w,h)
 end
 local function update()
  if busy then return end
  busy=true
  local screen=gui.AbsoluteSize
  local w,h=screen.X,screen.Y
  if w<1 or h<1 then busy=false;return end
  -- proportional to the screen (no fixed minimum/maximum); small pixel constants are times k
  local k=UiScale.k()
  local gap=h*.012
  local width=math.floor(math.min(w*.47,w*.19))
  local right=math.floor(w*rightScale)
  local top=math.floor(h*.012)
  local header=h*.045
  -- Portrait uses a second header row so world control stays separate.
  if w/h<1.2 then top=math.max(top,hud.top.AbsolutePosition.Y+hud.top.AbsoluteSize.Y+gap) end
  -- BUILD tab sits on top of the bottom bar: keep the column above it
  local bottom=math.min(h*.98,math.min(hud.bottom.AbsolutePosition.Y,hud.buildToggle.AbsolutePosition.Y)-gap)
  local available=math.max(80,bottom-top)
  local rowH=h*.038
  -- attack rows are taller than leaderboard rows (troop counts readable on phones)
  local attackRowH=h*.058
  local attacks=countRows(hud.attacks.List)
  local requests=countRows(hud.requests)
  local reserve=(if attacks>0 then header+attackRowH+gap else 0)+(if requests>0 then 76*k+gap else 0)
  local boardH=math.max(header+40*k, math.min(h*.43, available-reserve))
  box(hud.board,width,header)
  hud.board.Position=UDim2.fromOffset(right,top)
  box(expanded,width,boardH)
  expanded.ClipsDescendants=true
  expanded.List.Position=UDim2.new(.03,0,0,header+18*k)
  expanded.List.Size=UDim2.new(.94,0,1,-header-22*k)
  expanded.List.Layout.Padding=UDim.new(0,2*k)
  expanded.Title.Position=UDim2.new(.04,0,0,3*k)
  expanded.Title.Size=UDim2.new(.7,0,0,header-6*k)
  expanded.Close.Position=UDim2.new(.97,0,0,3*k)
  expanded.Close.Size=UDim2.fromOffset(header-6*k,header-6*k)
  expanded.Header.Position=UDim2.new(.04,0,0,header)
  expanded.Header.Size=UDim2.new(.92,0,0,15*k)
  for _,r in expanded.List:GetChildren() do if r:IsA("Frame") then r.Size=UDim2.new(1,0,0,rowH-2*k) end end
  local y=top+(if expanded.Visible then math.floor(boardH) else math.floor(header))+gap
  local requestH=if requests>0 then math.min(requests*76*k,math.max(0,(bottom-y)*(if attacks>0 then .45 else 1))) else 0
  hud.requests.Position=UDim2.fromOffset(right,y)
  hud.requests.Size=UDim2.fromOffset(width,math.floor(requestH))
  local reqLayout=hud.requests:FindFirstChildOfClass("UIListLayout")
  if reqLayout then reqLayout.Padding=UDim.new(0,6*k) end
  for _,c in hud.requests:GetChildren() do if c:IsA("Frame") then c.Size=UDim2.new(1,0,0,70*k) end end
  if requestH>0 then y+=math.floor(requestH)+gap end
  local attackH=math.max(1,math.min(header+attacks*(attackRowH+4*k)+8*k,bottom-y))
  box(hud.attacks,width,attackH)
  hud.attacks.Position=UDim2.fromOffset(right,y)
  hud.attacks.ClipsDescendants=true
  hud.attacks.Title.Position=UDim2.new(.04,0,0,3*k)
  hud.attacks.Title.Size=UDim2.new(.92,0,0,header-6*k)
  hud.attacks.List.Position=UDim2.new(.04,0,0,header)
  hud.attacks.List.Size=UDim2.new(.92,0,1,-header-4*k)
  hud.attacks.List.Layout.Padding=UDim.new(0,4*k)
  for _,r in hud.attacks.List:GetChildren() do
   if r:IsA("Frame") then
    r.Size=UDim2.new(1,0,0,attackRowH)
    r.Text.Size=UDim2.new(1,-rowH-12*k,.8,0)
    r.Cancel.Size=UDim2.fromOffset(rowH-2*k,rowH-2*k)
   end
  end
  hud.diplo.Position=if #hud.feed.active>0 then UDim2.new(.255,0,diploPosition.Y.Scale,diploPosition.Y.Offset) else diploPosition
  busy=false
 end
 for _,o in {gui,hud.bottom} do
  o:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
  o:GetPropertyChangedSignal("AbsolutePosition"):Connect(update)
 end
 expanded:GetPropertyChangedSignal("Visible"):Connect(update)
 hud.attacks:GetPropertyChangedSignal("Visible"):Connect(update)
 hud.requests.ChildAdded:Connect(update);hud.requests.ChildRemoved:Connect(update)
 hud.feed.changed=update
 -- Resolve viewport/constraint updates after Roblox's layout pass as well.
 local previous=""
 RunService.RenderStepped:Connect(function()
  local s=gui.AbsoluteSize
  local signature=tostring(s)..tostring(hud.bottom.AbsolutePosition)..tostring(hud.buildToggle.AbsolutePosition)..tostring(hud.top.AbsoluteSize)..tostring(UiScale.k())
  if signature~=previous then previous=signature;update() end
 end)
 update()
 return update
end
return Layout
]]></ProtectedString>
