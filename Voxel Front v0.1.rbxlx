			<Item class="ModuleScript" referent="RBXE66EBAF5260A4BB683B0817008B4063B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Medals: bir maçın kazandırdığı para (oyunda "Medals"; tekil "1 Medal"). Formül RoWorld src/shared/Data/Stars.luau'dan
-- uyarlandı (AGPL-3.0, © 2026 Snick Co.), değerler bizim ölçeğimizde (onda biri: ortalama maç ~100 Medal):
--
--   played     10                     erken ayrılana yok
--   survived   1.5 / dakika (hayatta)
--   territory  3 x en çok toprağın "adil pay" sayısı   (pay = haritanın karası / maçtaki ulus + oyuncu sayısı)
--   conquests  5 / fethedilen ulus ya da oyuncu        (kabileler sayılmaz)
--   placed     1.4 / dakika x sıra puanı               puan = (1 - (sıra - 1) / (alan - 1))^2; erken ayrılana yok
--   victory    1.8 / dakika                           kazanan (takım maçında kazanan takımın herkesi)
--
-- Her satır tam sayıya yuvarlanır (ödüyorsa en az 1). Hiç yerleşmeyen hiçbir şey almaz.
-- Mod çarpanı (MODE_MULT): online 1.0; solo (oyuncunun cihazında, yapay zekâya karşı) zorluğa göre daha az.
-- Solo sonucu istemcinin sözüdür: sunucu onu sınırlar (sanitize) ve gerçek süreye göre tavan koyar (soloCap).
-- Günlük sınır yalnız solo maçlarda (UTC günü, 2x Medals'tan önce): SOLO_DAILY_CAP. Online maçlarda günlük sınır yok.
--
--   Medals.payout(result, mode) -> { lines = { { key, amount } }, total }
--   Medals.sanitize(report, realMinutes) -> result     (solo raporu güvenli hâle getirilir)
--   Medals.soloCap(realMinutes, mode)                  (o kadar gerçek sürenin en çok ödeyebileceği)
--   Medals.Tracker.new(sim)                            (çalışan bir maçtaki insanların sonucunu izler)

local Medals = {}

Medals.NAME = "Medals"
Medals.FLOOR = 10
Medals.PER_MINUTE = 1.5
Medals.PER_SHARE = 3
Medals.PER_KILL = 5
Medals.PLACE_RATE = 1.4
Medals.WIN_RATE = 1.8
--- Modun ödediği pay. Solo maç cihazda yapay zekâya karşı oynanır: online'dan az; tutorial en kolay solo gibi.
Medals.MODE_MULT = {
	online = 1.0,
	teams = 1.0,
	tutorial = 0.3,
	easy = 0.3,
	normal = 0.45,
	hard = 0.6,
	insane = 0.75,
}
--- Solo maç: gerçek dakika başına en çok bu kadar (mod çarpanından sonra) + taban. Dürüst hızlı bir galibiyete yeter,
--- uydurma bir rapora tavandır.
Medals.SOLO_CAP_PER_MIN = 15
--- Solo maçların günlük sınırı (UTC günü; 2x Medals ikiye katlamadan önce). Online maçlarda günlük sınır yok.
Medals.SOLO_DAILY_CAP = 400
--- Sonuç sınırları.
Medals.MAX_MINUTES = 240
Medals.MAX_KILLS = 200
Medals.MAX_FIELD = 1024

Medals.LINES = { "played", "survived", "territory", "conquests", "placed", "victory" }
Medals.LABELS = {
	played = "Match played",
	survived = "Time survived",
	territory = "Land held",
	conquests = "Nations conquered",
	placed = "Final place",
	victory = "Victory",
	limit = "Daily solo limit",
	double = "2x Medals",
}

export type Result = {
	spawned: boolean,
	left: boolean,
	won: boolean,
	minutes: number,
	shares: number,
	kills: number,
	place: number,
	field: number,
}

local function whole(x: number): number
	if x <= 0 then
		return 0
	end
	return math.max(1, math.floor(x + 0.5))
end

--- "+120 Medals" / "+1 Medal"
function Medals.text(n: number): string
	return string.format("%s %s", tostring(math.floor(n)), if math.abs(n) == 1 then "Medal" else "Medals")
end

function Medals.placeScore(place: number, field: number): number
	if field <= 1 then
		return 1
	end
	local s = math.clamp(1 - (place - 1) / (field - 1), 0, 1)
	return s * s
end

function Medals.isSolo(mode: string?): boolean
	return mode ~= nil and mode ~= "online" and mode ~= "teams" and Medals.MODE_MULT[mode] ~= nil
end

--- `r`nin `mode`da ödediği Medals (günlük sınırdan ve 2x'ten önce).
function Medals.payout(r: Result, mode: string?): { lines: { { any } }, total: number }
	local lines: { { any } } = {}
	local total = 0
	if not r.spawned then
		return { lines = lines, total = 0 }
	end
	local mult = Medals.MODE_MULT[mode or "online"] or 1.0
	local minutes = math.clamp(r.minutes, 0, Medals.MAX_MINUTES)
	local function add(key: string, amount: number)
		local a = whole(amount * mult)
		if a > 0 then
			table.insert(lines, { key, a })
			total += a
		end
	end
	if not r.left then
		add("played", Medals.FLOOR)
	end
	add("survived", Medals.PER_MINUTE * minutes)
	add("territory", Medals.PER_SHARE * math.max(r.shares, 0))
	add("conquests", Medals.PER_KILL * math.max(r.kills, 0))
	if not r.left then
		add("placed", Medals.PLACE_RATE * Medals.placeScore(r.place, r.field) * minutes)
		if r.won then
			add("victory", Medals.WIN_RATE * minutes)
		end
	end
	return { lines = lines, total = total }
end

--- Gerçekte `realMinutes` süren bir solo maçın en çok ödeyebileceği (2x'ten önce).
function Medals.soloCap(realMinutes: number): number
	return Medals.FLOOR + math.floor(Medals.SOLO_CAP_PER_MIN * math.max(realMinutes, 0))
end

local function num(v: any, lo: number, hi: number): number
	if type(v) ~= "number" or v ~= v then
		return lo
	end
	return math.clamp(v, lo, hi)
end

--- İstemcinin solo raporu güvenli hâle getirilir: her alan türlü ve sınırlı; süre, maçın sunucu saatiyle gerçekten sürdüğünden
--- uzun olamaz.
function Medals.sanitize(report: any, realMinutes: number): Result
	local rep = if type(report) == "table" then report else {}
	local field = math.floor(num(rep.field, 1, Medals.MAX_FIELD))
	return {
		spawned = rep.spawned == true,
		left = rep.left == true,
		won = rep.won == true and rep.left ~= true,
		minutes = num(rep.minutes, 0, math.min(Medals.MAX_MINUTES, math.max(realMinutes, 0))),
		shares = num(rep.shares, 0, field),
		kills = math.floor(num(rep.kills, 0, math.min(field, Medals.MAX_KILLS))),
		place = math.floor(num(rep.place, 1, field)),
		field = field,
	}
end

-- =============================================================================================
-- Tracker: çalışan maçtaki insanların sonucu (RoWorld Stars.Tracker'ın bizim Simulation'a uyarlaması)
-- =============================================================================================
-- Match her 10 tick'te bir step() çağırır. Tur değişince kendini sıfırlar. Kim kimi fethetti: World.takenBy
-- (setOwner, bir sahibin toprağını en son kimin aldığını yazar; yalnız izleyici varken).
-- field = başlangıçta toprağı olan uluslar ve insanlar (kabileler sayılmaz).

local Tracker = {}
Tracker.__index = Tracker
Medals.Tracker = Tracker

function Tracker.new(sim: any)
	local self = setmetatable({}, Tracker) :: any
	self.sim = sim
	self.round = -1
	sim.world.takenBy = {}
	self:_reset()
	return self
end

function Tracker._reset(self: any)
	local sim = self.sim
	self.round = sim.round
	self.counted = false
	self.field = 0
	self.live = 0
	self.seats = {} -- pid -> { start, peak, maxTroops, kills, outTick, place }
	self.was = {} -- pid -> hayattaydı (ulus / insan)
	table.clear(sim.world.takenBy)
end

local function counts(sim: any, pid: number): boolean
	return not sim.isBot[pid] or sim.isNation[pid] == true
end

function Tracker._count(self: any)
	local sim = self.sim
	if self.counted or sim.phase == "spawn" then
		return
	end
	self.counted = true
	local n = 0
	for pid = 1, sim.playerCount do
		if counts(sim, pid) and sim.alive[pid] and sim.spawned[pid] then
			n += 1
			self.was[pid] = true
			if not sim.isBot[pid] then
				self.seats[pid] = { start = sim.tickNo, peak = 0, maxTroops = 0, kills = 0, outTick = nil, place = nil }
			end
		end
	end
	self.field = math.max(n, 1)
	self.live = n
end

--- Take Over: `old` artık `new`'i yönetir — yeni bir hayat, buradan sayılır (aldığı toprak onun eseri değil: en çok
--- toprağı üstünden 0'dan başlar; RoWorld Tracker.adopt).
function Tracker.adopt(self: any, old: number, new: number)
	local sim = self.sim
	self.seats[old] = nil
	self.seats[new] = { start = sim.tickNo, peak = 0, base = sim.world:tilesOwnedBy(new), maxTroops = 0, kills = 0, outTick = nil, place = nil }
	self.was[new] = true
end

--- Her 10 tick'te bir (Match.runTick).
function Tracker.step(self: any)
	local sim = self.sim
	if sim.round ~= self.round then
		self:_reset()
	end
	self:_count()
	if not self.counted then
		return
	end
	local world = sim.world
	for pid, seat in self.seats do
		if seat.outTick == nil then
			local t = world:tilesOwnedBy(pid) - (seat.base or 0)
			if t > seat.peak then
				seat.peak = t
			end
			local tr = sim.troops[pid] or 0
			if tr > seat.maxTroops then
				seat.maxTroops = tr
			end
		end
	end
	if sim.phase == "ended" then
		return -- (tur bitti: kimse artık düşmez)
	end
	local taken = world.takenBy
	for pid in self.was do
		if not sim.alive[pid] then
			self.was[pid] = nil
			local seat = self.seats[pid]
			if seat ~= nil and seat.outTick == nil then
				seat.outTick = sim.tickNo
				seat.place = math.max(self.live, 1)
			end
			self.live = math.max(self.live - 1, 0)
			local killer = taken[pid]
			local ks = if killer ~= nil then self.seats[killer] else nil
			if ks ~= nil and killer ~= pid and world:tilesOwnedBy(pid) == 0 then
				ks.kills += 1
			end
		end
	end
end

--- pid'in sonucu kesinleşti mi (düştü ya da tur bitti).
function Tracker.final(self: any, pid: number): boolean
	local seat = self.seats[pid]
	return seat ~= nil and (seat.outTick ~= nil or self.sim.phase == "ended")
end

--- pid'in şimdiye dek sonucu; `left` = süren bir maçtan ayrılıyor.
function Tracker.result(self: any, pid: number, left: boolean?): Result
	local sim = self.sim
	local seat = self.seats[pid]
	if seat == nil or not self.counted or sim.round ~= self.round then
		return { spawned = false, left = left == true, won = false, minutes = 0, shares = 0, kills = 0, place = 1, field = 1 }
	end
	local field = math.max(self.field, 1)
	local place = seat.place
	if place == nil then
		-- hâlâ ayakta: ayaktaki uluslar ve insanlar arasında toprağa göre sıra
		place = 1
		local mine = sim.world:tilesOwnedBy(pid)
		for o = 1, sim.playerCount do
			if o ~= pid and counts(sim, o) and sim.alive[o] and sim.spawned[o] and sim.world:tilesOwnedBy(o) > mine then
				place += 1
			end
		end
	end
	local land = math.max((sim.world.landCount or 1), 1)
	local share = land / field
	local ended = sim.phase == "ended"
	local gone = left == true and seat.outTick == nil and not ended
	local won = not gone
		and ended
		and (sim.winner == pid or ((sim.winnerTeam or 0) ~= 0 and (sim.team[pid] or 0) == sim.winnerTeam))
	local rate = (sim.cfg and sim.cfg.TICK_RATE) or 10
	return {
		spawned = true,
		left = gone,
		won = won,
		minutes = math.max(0, (seat.outTick or sim.tickNo) - seat.start) / (rate * 60),
		shares = seat.peak / share,
		kills = seat.kills,
		place = math.min(place, field),
		field = field,
	}
end

--- Maç sonu ekranının kartları için: en çok toprak (karanın yüzdesi), en çok asker (ham), fetih, süre (sn).
function Tracker.card(self: any, pid: number): { peakPct: number, maxTroops: number, kills: number, seconds: number }?
	local seat = self.seats[pid]
	if seat == nil then
		return nil
	end
	local sim = self.sim
	local rate = (sim.cfg and sim.cfg.TICK_RATE) or 10
	return {
		peakPct = seat.peak / math.max(sim.world.landCount or 1, 1) * 100,
		maxTroops = seat.maxTroops,
		kills = seat.kills,
		seconds = math.max(0, (seat.outTick or sim.tickNo) - seat.start) / rate,
	}
end

return Medals
]]></ProtectedString>
					<string name="ScriptGuid">{6E250921-07D8-4547-9CDB-7E2406104469}</string>
