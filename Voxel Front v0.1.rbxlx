						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Music</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">60f8826fbbac6a490b00bd7400000c21</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXF47B711F996F432AAC7DB78FBC204A93">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- GameOver: maç sonu ekranı (zafer / yenilgi / elendin / süre doldu). RoWorld src/client/UI/GameOver.luau'dan uyarlandı
-- (AGPL-3.0, © 2026 Snick Co.): üst yazı, büyük başlık, tek satır açıklama, kazanan happı, dört kart (en çok toprak, en çok
-- asker, fethedilen ulus, maç süresi), sayarak artan "+N Medals" happı (basınca / üstüne gelince dökümü), düğmeler ve
-- 2X MEDALS teklifi. Öğeler StarterGui > FrontlineMenu > GameOver'da (Studio'da düzenlenebilir; kod adlarına göre bulur).
-- Medals'ı sunucu öder (Server.Wallet) ve dökümü "medals" olayıyla gönderir. Solo maç cihazda çalıştığı için sonucu buradan
-- bildirilir (soloStart / soloReport); online maçı sunucu kendisi ölçer.
-- Take Over (RoWorld UI/Takeover.luau, AGPL-3.0, © 2026 Snick Co.): elenme ekranında, oyuncuyu düşüren ulus hâlâ
-- ayaktaysa ortada kare teklif (TakeOver: görsel Assets.ShopImages.takeover, başlık, Robux fiyatı, açıklama); görünürken
-- istatistik kartları gizlenir. Solo: ürün takeover (maç duraklamış bekler; hak harcanır, Shared.Match.takeover). Public:
-- ürün takeover_online (hakkı maç sunucusu harcar: MatchServer "TakeOver"). Satın alınmış ama kullanılmamış hak sonraki
-- elenmeye kalır. Tutorial maçında teklif yok.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared:WaitForChild("Assets"))
local Medals = require(Shared:WaitForChild("Medals"))

local GameOver = {}
GameOver.__index = GameOver

local GOLD = { Color3.fromRGB(255, 236, 160), Color3.fromRGB(245, 165, 20) }
local RED = { Color3.fromRGB(255, 170, 170), Color3.fromRGB(220, 38, 38) }
local GREY = { Color3.fromRGB(241, 245, 249), Color3.fromRGB(148, 163, 184) }
GameOver.COLORS = { gold = GOLD, red = RED, grey = GREY }

export type Model = {
	kicker: string,
	title: string,
	sub: string,
	tone: string, -- "gold" | "red" | "grey"
	winnerName: string?,
	winnerColor: Color3?,
	card: any?, -- { peakPct, maxTroops, kills, seconds } (solo: yerel izleyici; online: sunucunun dökümüyle gelir)
	online: boolean,
	canPlay: boolean, -- PLAY AGAIN görünsün mü
	next: string?, -- alt satır (online: lobiye dönüş)
}

local function fmtTroops(n: number): string
	local v = n / 10 -- (Economy.display: ekranda görünen birim)
	if v >= 1e6 then
		return string.format("%.1fM", v / 1e6)
	elseif v >= 1e3 then
		return string.format("%.1fK", v / 1e3)
	end
	return tostring(math.floor(v))
end

local function clock(s: number): string
	s = math.max(0, math.floor(s))
	return string.format("%d:%02d", s // 60, s % 60)
end
GameOver.clock = clock

local function commas(n: number): string
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (if n < 0 then "-" else "") .. out
end

function GameOver.new(frame: Frame, onButton: (string) -> ())
	local self = setmetatable({}, GameOver) :: any
	self.frame = frame
	self.title = frame:WaitForChild("Title") :: TextLabel
	self.kicker = frame:WaitForChild("Kicker") :: TextLabel
	self.sub = frame:WaitForChild("Sub") :: TextLabel
	self.winner = frame:FindFirstChild("Winner") :: Frame? -- (kaldırıldı: varsa doldurulur)
	self.stats = frame:WaitForChild("Stats") :: Frame
	self.pill = frame:WaitForChild("Medals") :: TextButton
	self.amount = self.pill:WaitForChild("Amount") :: TextLabel
	self.breakdown = frame:WaitForChild("Breakdown") :: Frame
	self.daily = frame:WaitForChild("Daily") :: TextLabel
	self.buttons = frame:WaitForChild("Buttons") :: Frame
	self.next = frame:WaitForChild("Next") :: TextLabel
	self.offer = frame:WaitForChild("Offer") :: TextButton
	self.payload = nil :: any
	self.shownAt = -1e9
	self.inv = nil :: any
	self.solo = nil :: any -- { mode, reported }
	-- görseller (boşsa simge gizlenir, yazı ortalanır)
	local function icon(img: ImageLabel?, id: string, textLabel: TextLabel?)
		if img == nil then
			return
		end
		img.Image = id
		img.Visible = Assets.has(id)
		if textLabel and not Assets.has(id) then
			textLabel.AnchorPoint = Vector2.new(0.5, 0.5)
			textLabel.Position = UDim2.fromScale(0.5, 0.5)
		end
	end
	-- (Medals happı: simge yeri yazının en solunda hep durur; kimlik boşken boş görünür)
	local medalIcon = self.pill:FindFirstChild("Icon") :: ImageLabel?
	if medalIcon then
		medalIcon.Image = Assets.Shop.medal
		medalIcon.Visible = true
	end
	icon(self.offer:FindFirstChild("Icon") :: ImageLabel?, Assets.Shop.medals2x, self.offer:FindFirstChild("Label") :: TextLabel?)
	if self.winner then
		icon(self.winner:FindFirstChild("Crown") :: ImageLabel?, Assets.Shop.crown, nil)
	end
	self.deps = {} :: any
	for _, name in { "PlayAgain", "Spectate", "ToTitle" } do
		local b = self.buttons:FindFirstChild(name) :: TextButton?
		if b then
			b.Activated:Connect(function()
				if name == "Spectate" then
					self:_resume() -- (solo: elenince duraklayan maç izlemek için devam eder)
					pcall(function()
						require(script.Parent:WaitForChild("Analytics")).send("spectate")
					end)
				end
				onButton(name)
			end)
		end
	end
	-- (Studio'daki ilk yerler: Take Over yokken ekran aynen böyle; varken öğeler sıralanır: GameOver._layout)
	self.home = {}
	for _, n in { "Kicker", "Title", "Sub", "Stats", "Medals", "Breakdown", "Daily", "Buttons", "Next", "Offer" } do
		local o = frame:FindFirstChild(n) :: GuiObject?
		if o then
			self.home[n] = o.Position
		end
	end
	self.take = frame:FindFirstChild("TakeOver") :: Frame?
	if self.take then
		local tb = self.take:FindFirstChild("Button") :: ImageButton?
		if tb then
			if Assets.has((Assets.ShopImages :: any).takeover) then
				tb.Image = (Assets.ShopImages :: any).takeover
			end
			tb.Activated:Connect(function()
				self:_takeover()
			end)
		end
		local ic = self.take:FindFirstChild("Price") and self.take.Price:FindFirstChild("Icon") :: ImageLabel?
		if ic and Assets.has(Assets.Shop.robux) then
			ic.Image = Assets.Shop.robux
		end
	end
	-- döküm: basınca açılır / kapanır; farede üstüne gelince de
	self.pill.Activated:Connect(function()
		self.breakdown.Visible = not self.breakdown.Visible and self.payload ~= nil
	end)
	self.pill.MouseEnter:Connect(function()
		if UserInputService.MouseEnabled and self.payload ~= nil then
			self.breakdown.Visible = true
		end
	end)
	self.pill.MouseLeave:Connect(function()
		if UserInputService.MouseEnabled then
			self.breakdown.Visible = false
		end
	end)
	self.offer.Activated:Connect(function()
		local id = Assets.GamePasses.medals2x
		if type(id) == "number" and id ~= 0 then
			if self.remote then
				self.remote:FireServer("shop", "open", "gameover")
				self.remote:FireServer("shop", "click", "medals2x")
			end
			MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
		end
	end)
	-- (sunucunun Wallet olayı; beklerken menü kurulumu durmasın)
	task.spawn(function()
		local remote = ReplicatedStorage:WaitForChild("FrontlineWallet", 60) :: RemoteEvent?
		self.remote = remote
		if remote then
			remote.OnClientEvent:Connect(function(what: any, data: any)
				if what == "medals" and type(data) == "table" then
					self:setMedals(data)
				elseif what == "inv" and type(data) == "table" then
					self.inv = data
					self:_offer()
					if self.frame.Visible then
						self:_layout()
					end
					-- (Take Over satın alındı: hak geldi, kullanılır)
					local want = self.waitTake
					if want and (tonumber((data.credits or {})[want]) or 0) > 0 then
						self.waitTake = nil
						task.spawn(function()
							self:_useTakeover(want)
						end)
					end
				end
			end)
			if self.pendingStart then
				remote:FireServer("soloStart", self.pendingStart)
				self.pendingStart = nil
			end
		end
		local fn = ReplicatedStorage:FindFirstChild("FrontlineWalletCall") :: RemoteFunction?
		if fn then
			local ok, data = pcall(function()
				return fn:InvokeServer("inv")
			end)
			if ok and type(data) == "table" then
				self.inv = data
			end
		end
	end)
	return self
end

--- Ekranı doldurur (Menu açar).
function GameOver.show(self: any, m: Model)
	self.kicker.Text = m.kicker
	self.title.Text = m.title
	local c = GameOver.COLORS[m.tone] or GREY
	local g = self.title:FindFirstChildOfClass("UIGradient")
	if g then
		g.Color = ColorSequence.new(c[1], c[2])
	end
	self.sub.Text = m.sub
	if self.winner then
		self.winner.Visible = m.winnerName ~= nil
	end
	if m.winnerName and self.winner then
		local wn = self.winner:FindFirstChild("Name") :: TextLabel
		wn.Text = m.winnerName
		local sw = self.winner:FindFirstChild("Swatch") :: Frame?
		if sw then
			sw.BackgroundColor3 = m.winnerColor or Color3.new(1, 1, 1)
		end
	end
	local play = self.buttons:FindFirstChild("PlayAgain") :: TextButton?
	if play then
		play.Visible = m.canPlay
	end
	local spec = self.buttons:FindFirstChild("Spectate") :: TextButton?
	if spec then
		spec.Visible = m.online or (m :: any).spectate == true
	end
	self:_offerTakeover(m)
	-- görünen düğmeler ortada, aralarında boşlukla (liste düzeni yok: çentikleri düzende yer kaplamasın)
	do
		local shown = {}
		for _, n in { "PlayAgain", "Spectate", "ToTitle" } do
			local b = self.buttons:FindFirstChild(n) :: GuiObject?
			if b and b.Visible then
				table.insert(shown, b)
			end
		end
		local gap = 0.02
		local total = -gap
		for _, b in shown do
			total += b.Size.X.Scale + gap
		end
		local x = (1 - total) / 2
		for _, b in shown do
			b.Position = UDim2.new(x, 0, b.Position.Y.Scale, b.Position.Y.Offset)
			x += b.Size.X.Scale + gap
		end
	end
	self.next.Text = m.next or ""
	-- (aynı maçın dökümü ekrandan önce geldiyse korunur: 30 sn içinde)
	if self.payload ~= nil and os.clock() - self.payloadAt > 30 then
		self.payload = nil
	end
	self.card = m.card or (if self.payload then self.payload.card else nil)
	self:_cards()
	self.breakdown.Visible = false
	if self.payload then
		self:_pill(true)
	else
		self.amount.Text = "+… Medals"
		self.daily.Text = ""
	end
	self:_offer()
	self.shownAt = os.clock()
end

--- Ekranın yazıları (RoWorld UIAdvisor.on_game_over'ın kuralları). a = {
---   eliminated: bool (elendiği anın ekranı), won, dead (elenmiş), team (takım maçı), online, timeUp,
---   winnerName, winnerColor, pct (kazananın / takımın toprağı, %), killerName?, outSecs, card? }
function GameOver.endModel(a: any): Model
	local pct = string.format("%d%%", math.floor((tonumber(a.pct) or 0) + 0.5))
	local function fallen(): string
		return if a.killerName
			then string.format("Conquered by %s at %s", a.killerName, clock(a.outSecs or 0))
			else string.format("Your last territory fell at %s", clock(a.outSecs or 0))
	end
	local m: Model = {
		kicker = if a.timeUp then "TIME LIMIT REACHED" else "MATCH COMPLETE",
		title = "MATCH OVER",
		sub = "",
		tone = "grey",
		winnerName = a.winnerName,
		winnerColor = a.winnerColor,
		card = a.card,
		online = a.online == true,
		canPlay = not a.online,
		next = if a.online and not a.eliminated then "Returning to the lobby in a moment" else nil,
	}
	if a.eliminated or (a.dead and not a.online and not a.team and not a.won) then
		-- (elendiği an: izlenebilir, Take Over teklif edilebilir)
		local mm: any = m
		mm.spectate = a.eliminated == true
		mm.killerName = a.killerName
		mm.takeoverOk = a.eliminated == true
		m.kicker = "YOUR NATION HAS FALLEN"
		m.title = "ELIMINATED"
		m.tone = "red"
		m.sub = fallen()
		m.winnerName = if a.eliminated then nil else a.winnerName
		return m
	end
	if a.won then
		m.title = "VICTORY"
		m.tone = "gold"
		m.sub = if a.team
			then (if a.timeUp then "Time! Your team holds the most land with " .. pct else "Your team won with " .. pct .. " of the land")
			else (if a.timeUp then "Time! You hold the most land with " .. pct else "You conquered the world with " .. pct)
	elseif a.dead then
		m.title = "MATCH OVER"
		m.tone = "grey"
		m.sub = string.format(if a.team then "%s won with %s of the land" else "%s won the war with %s of the land", a.winnerName or "?", pct)
	else
		m.title = if a.timeUp then "TIME'S UP" else "DEFEAT"
		m.tone = "red"
		m.sub = string.format(if a.team then "%s won with %s of the land" else "%s won the war with %s of the land", a.winnerName or "?", pct)
	end
	return m
end

--- Yerleşim. Take Over kartı yokken her şey Studio'daki yerinde. Varken (kart istatistiklerden büyük) öğeler yukarıdan
--- aşağı aralarda boşlukla sıralanır: üsttekiler gerektiği kadar yukarı, alttakiler aşağı kayar; hiçbiri üst üste
--- gelmez, ekranın üstünde ve altında %3 pay kalır (sığmazsa aradaki boşluklar daralır).
function GameOver._layout(self: any)
	local f = self.frame
	local home = self.home
	local take = self.take
	local function at(o: GuiObject?, y: number)
		if o then
			o.Position = UDim2.new(o.Position.X.Scale, o.Position.X.Offset, y, 0)
		end
	end
	if take == nil or not take.Visible then
		for n, p in home do
			local o = f:FindFirstChild(n) :: GuiObject?
			if o then
				o.Position = p
			end
		end
		return
	end
	-- (sıra, her öğenin üstündeki boşluk)
	local order: { { any } } = {
		{ "Kicker", 0 },
		{ "Title", 0 },
		{ "Sub", 0.005 },
		{ "TakeOver", 0.02 },
		{ "Medals", 0.02 },
		{ "Daily", 0.005 },
		{ "Buttons", 0.02 },
		{ "Next", 0.02 },
		{ "Offer", 0.018 },
	}
	local list = {}
	local total, gaps = 0, 0
	for _, e in order do
		local o = f:FindFirstChild(e[1]) :: GuiObject?
		local shown = o ~= nil and o.Visible and not (o:IsA("TextLabel") and (o :: TextLabel).Text == "")
		if shown then
			local gap = if #list == 0 then 0 else e[2]
			table.insert(list, { o, gap })
			total += (o :: GuiObject).Size.Y.Scale + gap
			gaps += gap
		end
	end
	local top, bottom = 0.03, 0.97
	local start = math.min(home.Kicker and home.Kicker.Y.Scale or 0.115, bottom - total)
	local squeeze = 1
	if start < top then
		-- (sığmıyor: boşluklar daralır)
		squeeze = math.max(0, 1 - (top - start) / math.max(gaps, 1e-6))
		start = top
	end
	local y = start
	for _, e in list do
		local o, gap = e[1], e[2]
		y += gap * squeeze
		at(o, y)
		y += o.Size.Y.Scale
	end
	-- döküm, Medals happının hemen üstünde
	local pill = f:FindFirstChild("Medals") :: GuiObject?
	if pill then
		at(f:FindFirstChild("Breakdown") :: GuiObject?, pill.Position.Y.Scale - 0.01)
	end
end

--- Client'tan: { localMatch, online, close = fn() } (Take Over ve izleme için).
function GameOver.setDeps(self: any, deps: any)
	self.deps = deps
end

--- Solo: duraklayan maç devam eder.
function GameOver._resume(self: any)
	local lm = self.deps.localMatch
	if lm and not self.deps.online and lm.setRunning then
		lm.setRunning(true)
	end
end

local function takeoverKey(online: boolean): string
	return if online then "takeover_online" else "takeover"
end

--- Take Over teklifi (yalnız elenme anında; ürün kimliği varsa; hedef ayaktaysa; tutorial'da yok).
function GameOver._offerTakeover(self: any, m: any)
	local take = self.take
	if take == nil then
		return
	end
	local key = takeoverKey(m.online == true)
	local id = (Assets.Products :: any)[key] or 0
	local name: string? = nil
	local tutorial = (require(Shared:WaitForChild("Session")) :: any).tutorial == "run"
	if m.takeoverOk and id ~= 0 and not tutorial then
		if m.online then
			name = m.killerName
		else
			local lm = self.deps.localMatch
			if lm and lm.takeoverTarget then
				local _, n = lm.takeoverTarget(Players.LocalPlayer)
				name = n
			end
		end
	end
	take.Visible = name ~= nil
	self.stats.Visible = name == nil
	self.takeKey = if name then key else nil
	self:_layout()
	if name then
		pcall(function()
			require(script.Parent:WaitForChild("Analytics")).send("takeover_offered")
		end)
		local desc = take:FindFirstChild("Desc") :: TextLabel?
		if desc then
			desc.Text = string.format("Take command of %s, the nation that conquered you: its land, army and gold.", name)
		end
		local t = take:FindFirstChild("Price") and take.Price:FindFirstChild("Text") :: TextLabel?
		if t then
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(id, Enum.InfoType.Product)
				end)
				if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
					t.Text = tostring(info.PriceInRobux)
				end
			end)
		end
	end
end

--- Take Over'a basıldı: hak varsa kullanılır, yoksa Robux penceresi (hak gelince kullanılır).
function GameOver._takeover(self: any)
	local key = self.takeKey
	if key == nil or self.taking then
		return
	end
	local have = tonumber(((self.inv or {}).credits or {})[key]) or 0
	if have > 0 then
		self:_useTakeover(key)
		return
	end
	local id = (Assets.Products :: any)[key] or 0
	if id == 0 then
		return
	end
	self.waitTake = key
	if self.remote then
		self.remote:FireServer("shop", "open", "gameover")
		self.remote:FireServer("shop", "click", key)
	end
	MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
end

--- Hakı kullanır: solo'da burada (maç duraklamış), public'te maç sunucusu. Başarılıysa ekran kapanır, maç devam eder.
function GameOver._useTakeover(self: any, key: string)
	if self.taking then
		return
	end
	self.taking = true
	local Toast = require(script.Parent:WaitForChild("Toast")) :: any
	local done = false
	if key == "takeover_online" then
		-- (maç sunucusunun klasörü: Shared.Protocol.MatchFolder)
		local Protocol = require(Shared:WaitForChild("Protocol")) :: any
		local folder = ReplicatedStorage:FindFirstChild(Protocol.MatchFolder)
		local rf = folder and folder:FindFirstChild("TakeOver") :: RemoteFunction?
		if rf then
			local ok, r = pcall(function()
				return rf:InvokeServer()
			end)
			done = ok and r == true
		end
	else
		local lm = self.deps.localMatch
		local fn = ReplicatedStorage:FindFirstChild("FrontlineWalletCall") :: RemoteFunction?
		if lm and lm.takeoverTarget and lm.takeoverTarget(Players.LocalPlayer) ~= nil and fn then
			local ok, spent = pcall(function()
				return fn:InvokeServer("useCredit", key)
			end)
			if ok and spent == true then
				done = lm.takeover(Players.LocalPlayer)
			end
		end
	end
	self.taking = false
	if done then
		Toast.show("You took over the nation!", true, "crateReveal")
		if self.solo then
			self.solo.reported = false -- (yeni hayat: sonucu ayrıca bildirilir)
		end
		if self.deps.close then
			self.deps.close()
		end
		self:_resume()
	else
		Toast.show("Couldn't take over. Your purchase is saved for next time.", false)
	end
end

--- "Next match in 0:15" gibi alt satır (online).
function GameOver.setNext(self: any, text: string)
	if self.next.Text ~= text then
		self.next.Text = text
	end
end

function GameOver._cards(self: any)
	local c = self.card
	local function set(name: string, text: string)
		local card = self.stats:FindFirstChild(name)
		local v = card and card:FindFirstChild("Value") :: TextLabel?
		if v then
			v.Text = text
		end
	end
	if type(c) ~= "table" then
		for _, n in { "PeakLand", "MaxTroops", "Conquered", "Duration" } do
			set(n, "…")
		end
		return
	end
	set("PeakLand", string.format("%.1f%%", tonumber(c.peakPct) or 0))
	set("MaxTroops", fmtTroops(tonumber(c.maxTroops) or 0))
	set("Conquered", tostring(math.floor(tonumber(c.kills) or 0)))
	set("Duration", clock(tonumber(c.seconds) or 0))
end

--- Sunucunun ödeme dökümü (Server.Wallet "medals").
function GameOver.setMedals(self: any, data: any)
	self.payload = data
	self.payloadAt = os.clock()
	if self.frame.Visible then
		if self.card == nil and type(data.card) == "table" then
			self.card = data.card
			self:_cards()
		end
		self:_pill(false)
		self:_offer()
		self:_layout()
	end
end

function GameOver._pill(self: any, instant: boolean)
	local data = self.payload
	local total = math.floor(tonumber(data.total) or 0)
	-- döküm satırları
	local rows = {}
	for _, line in (if type(data.lines) == "table" then data.lines else {}) do
		local key, amount = line[1], tonumber(line[2]) or 0
		local label = Medals.LABELS[key] or tostring(key)
		local sign = if amount >= 0 then "+" else "−"
		table.insert(rows, string.format('%s <font color="#FBBF24">%s%s</font>', label, sign, commas(math.abs(amount))))
	end
	if #rows == 0 then
		table.insert(rows, if data.failed then "Couldn't save your Medals. They'll come next match." else "No Medals this match")
	end
	table.insert(rows, string.format('<b>Total <font color="#FBBF24">+%s</font></b>', commas(total)))
	if tonumber(data.balance) then
		table.insert(rows, string.format('<font color="#94A3B8">Balance %s</font>', commas(tonumber(data.balance) or 0)))
	end
	;(self.breakdown:FindFirstChild("Lines") :: TextLabel).Text = table.concat(rows, "\n")
	-- günlük sınır (yalnız solo maçlarda var)
	local d = data.day
	if type(d) == "table" and d.solo then
		local text = string.format("Solo today: %s / %s Medals", commas(tonumber(d.soloUsed) or 0), commas(tonumber(d.soloMax) or 0))
		if data.limited then
			text = "Daily solo limit reached · " .. text
		end
		self.daily.Text = text
	else
		self.daily.Text = ""
	end
	-- sayarak artar
	self.countId = (self.countId or 0) + 1
	local id = self.countId
	if instant or total <= 0 then
		self.amount.Text = "+" .. Medals.text(total)
		return
	end
	task.spawn(function()
		local t0 = os.clock()
		local dur = 1.2
		while self.countId == id do
			local k = math.min(1, (os.clock() - t0) / dur)
			local e = 1 - (1 - k) ^ 3
			self.amount.Text = "+" .. Medals.text(math.floor(total * e + 0.5))
			if k >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
	end)
end

--- 2X MEDALS teklifi: game pass kimliği varsa ve oyuncuda yoksa (bu maçın ne kadar fazla ödeyeceğini söyler).
function GameOver._offer(self: any)
	local id = Assets.GamePasses.medals2x
	local owned = self.inv ~= nil and self.inv.double == true
	local show = type(id) == "number" and id ~= 0 and not owned and self.payload ~= nil
	self.offer.Visible = show
	if show then
		local label = self.offer:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = string.format("2X MEDALS · this match would pay +%s more", commas(tonumber(self.payload.total) or 0))
		end
	end
end

-- Solo maç ---------------------------------------------------------------------------------

--- Solo maç başladı (mode: "tutorial" | "easy" | "normal" | "hard" | "insane").
function GameOver.soloStart(self: any, mode: string)
	self.solo = { mode = mode, reported = false }
	self.payload = nil -- (önceki maçın dökümü bu maçın ekranında görünmesin)
	if self.remote then
		self.remote:FireServer("soloStart", mode)
	else
		self.pendingStart = mode
	end
end

--- Solo maçın sonucunu bir kez bildirir (tracker: Shared.Medals.Tracker, pid: oyuncu, left: maç bitmeden çıktı).
function GameOver.soloReport(self: any, tracker: any, pid: number, left: boolean)
	local s = self.solo
	if s == nil or s.reported or tracker == nil or pid == 0 then
		return
	end
	s.reported = true
	pcall(function()
		tracker:step() -- (düşüşü hemen sayılsın: maç duraklamış olabilir)
	end)
	local r = tracker:result(pid, left)
	if self.remote then
		self.remote:FireServer("soloResult", r)
	end
end

--- Solo maçın kartları (yerel izleyiciden).
function GameOver.soloCard(_self: any, tracker: any, pid: number): any
	return if tracker then tracker:card(pid) else nil
end

return GameOver
