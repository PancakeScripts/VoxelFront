				<Item class="ModuleScript" referent="RBXF5FB00BF371244749F9EBFC0ABA8DC7F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- SamRings: tüm SAM menzilleri, dönen kesikli halkalar olarak (repo SAMRadiusPass). Silo, SAM, şehir, atom ya da
-- hidrojen kurarken ve SAM / bomba düğmesinin üstüne gelince görünür. Kendi SAM'larım yeşil, müttefiklerim sarı,
-- diğerleri kırmızı; aynı taraftaki menziller tek birleşik şekil gibi (iç içe yaylar çizilmez).
-- Halka parçaları harita katmanında ölçek konumlu kısa düz çizgiler (Frame); kaydırmada güncellenmez, yalnız dönerken.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Look = require(Shared:WaitForChild("Look"))
local WorldLayer = require(script.Parent.WorldLayer)
local SamGeom = require(script.Parent.SamGeom)

local SamRings = {}
SamRings.__index = SamRings

local LR = Look.Range
local MAX_CHORD = 0.22 -- radyan: daha uzun kesikler birkaç düz parçaya bölünür (yay düzgün görünsün)

export type Ring = { x: number, y: number, r: number, color: Color3, alpha: number, spin: number, group: number }

export type SamRings = typeof(setmetatable(
	{} :: {
		layer: WorldLayer.WorldLayer,
		box: Frame,
		pool: { Frame },
		used: number,
		rings: { Ring },
		arcs: { { SamGeom.Arc } },
		visible: boolean,
		lastStep: number,
	},
	SamRings
))

function SamRings.new(layer: WorldLayer.WorldLayer): SamRings
	local box = Instance.new("Frame")
	box.Name = "SamRings"
	box.BackgroundTransparency = 1
	box.Size = UDim2.fromScale(1, 1)
	box.ZIndex = 4
	box.Visible = false
	box.Parent = layer.under
	return setmetatable({
		layer = layer,
		box = box,
		pool = {},
		used = 0,
		rings = {},
		arcs = {},
		visible = false,
		lastStep = -1,
	}, SamRings)
end

-- Halkaları değiştirir (yapı listesi gelince). Birleşik şekil için örtülmeyen yaylar burada bir kez hesaplanır.
function SamRings.set(self: SamRings, rings: { Ring })
	self.rings = rings
	local byGroup: { [number]: { SamGeom.Circle } } = {}
	local circles: { SamGeom.Circle } = {}
	for i, r in rings do
		local c = { x = r.x, y = r.y, r = r.r }
		circles[i] = c
		local g = byGroup[r.group]
		if not g then
			g = {}
			byGroup[r.group] = g
		end
		table.insert(g, c)
	end
	local arcs = {}
	for i, r in rings do
		arcs[i] = SamGeom.uncovered(circles[i], byGroup[r.group])
	end
	self.arcs = arcs
	self.lastStep = -1
end

function SamRings.setVisible(self: SamRings, v: boolean)
	if self.visible ~= v then
		self.visible = v
		self.box.Visible = v
		self.lastStep = -1
	end
end

local function piece(self: SamRings): Frame
	self.used += 1
	local f = self.pool[self.used]
	if f then
		f.Visible = true
		return f
	end
	local nf = Instance.new("Frame")
	nf.BorderSizePixel = 0
	nf.AnchorPoint = Vector2.new(0.5, 0.5)
	nf.ZIndex = 4
	nf.Parent = self.box
	self.pool[self.used] = nf
	return nf
end

-- Her karede (en çok 30 Hz): kesiklerin yeri dönüşe göre.
function SamRings.step(self: SamRings, now: number)
	if not self.visible then
		return
	end
	if self.lastStep >= 0 and now - self.lastStep < 1 / 30 then
		return
	end
	self.lastStep = now
	self.used = 0
	local L = self.layer
	local w, h = L.w, L.h
	local thick = LR.samWidth
	for i, ring in self.rings do
		local shift = now * LR.samSpeed * ring.spin
		local pieces = SamGeom.dashes(ring.r, self.arcs[i] or {}, LR.samDash, LR.samGap, shift)
		local tr = 1 - (1 - LR.samTransparency) * ring.alpha
		for _, p in pieces do
			local a0, a1 = p[1], p[2]
			local n = math.max(1, math.ceil((a1 - a0) / MAX_CHORD))
			for k = 0, n - 1 do
				local s = a0 + (a1 - a0) * k / n
				local e = a0 + (a1 - a0) * (k + 1) / n
				local x0, y0 = ring.x + ring.r * math.cos(s), ring.y + ring.r * math.sin(s)
				local x1, y1 = ring.x + ring.r * math.cos(e), ring.y + ring.r * math.sin(e)
				local dx, dy = x1 - x0, y1 - y0
				local len = math.sqrt(dx * dx + dy * dy)
				local f = piece(self)
				f.Position = UDim2.fromScale((x0 + x1) / 2 / w, (y0 + y1) / 2 / h)
				f.Size = UDim2.new(len / w, 0, thick / h, 0)
				f.Rotation = math.deg(math.atan2(dy, dx))
				f.BackgroundColor3 = ring.color
				f.BackgroundTransparency = tr
			end
		end
	end
	for k = self.used + 1, #self.pool do
		local f = self.pool[k]
		if f.Visible then
			f.Visible = false
		end
	end
end

return SamRings
]]></ProtectedString>
