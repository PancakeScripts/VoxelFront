					<ProtectedString name="Source"><![CDATA[--!strict
-- Cosmetics: kasadan çıkan eşyalar. RoWorld src/shared/Data/Cosmetics.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.).
--   skins  toprağın deseni: toprağın üstüne döşenen 1 bitlik maske (mask pikselleri 2^scale tile genişliğinde). '#'
--          ikinci renktir: oyuncunun kendi rengi açılmış (tone > 0) ya da koyulaşmış (tone < 0), ya da sabit `accent` rengi
--          (efsanevi skinler). Skinler YALNIZ kasadan çıkar.
--   flags  gerçek ülke bayrakları (Shared.CrateArt; Wikimedia Commons, kamu malı / CC0): haritada adının ve sıralama
--          tablosunda adının yanında görünür. Her bayrak Common.
--   mağaza bayrakları (Shared.ShopFlags; "shop_<anahtar>"): oyuna özel tasarımlar, Epic / Legendary; YALNIZ mağazadan
--          alınır, kasada (Cosmetics.all) yoktur; eşya olarak her yerde (giyme, koleksiyon) diğer bayraklar gibidir.
-- Kasa önce RARITIES oranlarıyla bir nadirlik seçer, sonra o nadirlikte oyuncunun sahip olmadığı bir eşyayı (eşit
-- olasılıkla); hiç eşyası kalmayan nadirlikler düşer, kalanların oranları orantılı büyür (odds(): oyuncunun kendi
-- oranları; Roblox'un ücretli rastgele eşya kuralları gereği her satın almadan önce gösterilir). Asla aynı eşya iki kez çıkmaz.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local CrateArt = require(Shared:WaitForChild("CrateArt"))
local ShopFlags = require(Shared:WaitForChild("ShopFlags"))
local Assets = require(Shared:WaitForChild("Assets"))

local Cosmetics = {}

Cosmetics.RARITIES = {
	{ id = "common", name = "Common", odds = 0.62, color = Color3.fromRGB(154, 166, 178) },
	{ id = "rare", name = "Rare", odds = 0.25, color = Color3.fromRGB(61, 139, 255) },
	{ id = "epic", name = "Epic", odds = 0.10, color = Color3.fromRGB(163, 91, 255) },
	{ id = "legendary", name = "Legendary", odds = 0.03, color = Color3.fromRGB(255, 178, 46) },
}

--- (maske satırları yukarıdan aşağı; her satır aynı genişlikte)
Cosmetics.skins = {
	-- Common
	{ id = "stripes", name = "Stripes", rarity = "common", scale = 1, tone = -0.22, mask = { "##.." } },
	{ id = "bands", name = "Bands", rarity = "common", scale = 1, tone = -0.22, mask = { "#", "#", ".", "." } },
	{ id = "checker", name = "Checker", rarity = "common", scale = 1, tone = -0.18, mask = { "#.", ".#" } },
	{ id = "diagonal", name = "Diagonal", rarity = "common", scale = 1, tone = -0.24, mask = { "#...", ".#..", "..#.", "...#" } },
	{ id = "dots", name = "Dots", rarity = "common", scale = 1, tone = 0.32, mask = { "....", ".#..", "....", "...." } },
	{ id = "grid", name = "Grid", rarity = "common", scale = 0, tone = -0.26, mask = { "####", "#...", "#...", "#..." } },
	-- Rare
	{ id = "bricks", name = "Bricks", rarity = "rare", scale = 0, tone = -0.3, mask = { "########", "#.......", "#.......", "########", "....#...", "....#..." } },
	{ id = "waves", name = "Waves", rarity = "rare", scale = 1, tone = -0.24, mask = { "#......#", ".#....#.", "..#..#..", "...##..." } },
	{ id = "diamonds", name = "Diamonds", rarity = "rare", scale = 0, tone = -0.26, mask = { "...##...", "..#..#..", ".#....#.", "#......#", "#......#", ".#....#.", "..#..#..", "...##..." } },
	{ id = "crosshatch", name = "Crosshatch", rarity = "rare", scale = 0, tone = -0.24, mask = { "#...#", ".#.#.", "..#..", ".#.#.", "#...#" } },
	{ id = "zigzag", name = "Zigzag", rarity = "rare", scale = 1, tone = -0.3, mask = { "#...#...", ".#.#.#.#", "..#...#." } },
	{ id = "cobble", name = "Cobble", rarity = "rare", scale = 0, tone = -0.24, mask = { "..####..", ".#....#.", "#......#", "#......#", "####....", "....#..#", ".....##." } },
	-- Epic
	{ id = "stars", name = "Starfield", rarity = "epic", scale = 0, tone = 0.42, mask = { "..........", "...#......", "..###.....", "...#......", "..........", ".......#..", "......###.", ".......#..", "..........", ".........." } },
	{ id = "camo", name = "Camouflage", rarity = "epic", scale = 1, tone = -0.3, mask = {
		"..###.......##..", ".#####.....####.", ".######...#####.", "..####.....###..", "...##..........#", "#.........###.##", "##......######..", "###....#######..",
		".##.....#####...", "..........##....", "....##.........#", "...#####......##", "..#######....###", "...#####......#.", "....###.........", "................",
	} },
	{ id = "circuit", name = "Circuit", rarity = "epic", scale = 0, tone = 0.34, mask = { "#####...", "....#...", "....#.##", "....###.", "##......", ".#......", ".####..#", "....####" } },
	{ id = "hex", name = "Hive", rarity = "epic", scale = 0, tone = -0.26, mask = { ".####....", "#....#...", "#....#...", ".####....", "....#####", "...#....#", "...#....#", "....#####" } },
	{ id = "tartan", name = "Tartan", rarity = "epic", scale = 0, tone = -0.22, mask = { "##..#...", "##..#...", "########", "##..#...", "########", "##..#...", "##..#...", "##..#..." } },
	-- Legendary: her rengin üstünde sabit bir vurgu rengi
	{ id = "gilded", name = "Gilded", rarity = "legendary", scale = 0, accent = Color3.fromRGB(233, 185, 73), mask = { "...##...", "..#..#..", ".#....#.", "#......#", "#......#", ".#....#.", "..#..#..", "...##..." } },
	{ id = "frost", name = "Frost", rarity = "legendary", scale = 0, accent = Color3.fromRGB(242, 248, 255), mask = { "...#....", ".#.#.#..", "..###...", "#######.", "..###...", ".#.#.#..", "...#....", "........" } },
	{ id = "obsidian", name = "Obsidian", rarity = "legendary", scale = 0, accent = Color3.fromRGB(21, 21, 28), mask = { "#...#", ".#.#.", "..#..", ".#.#.", "#...#" } },
	{ id = "ember", name = "Ember", rarity = "legendary", scale = 1, accent = Color3.fromRGB(255, 106, 43), mask = { "#......#", ".#....#.", "..#..#..", "...##..." } },
}

--- İkinci renkli karelerin opaklığı (0..1; RoWorld SECONDARY_ALPHA 190 / 255).
Cosmetics.SECONDARY_ALPHA = 190 / 255

export type Item = { id: string, kind: string, name: string, rarity: string, [string]: any }

local items: { [string]: Item } = {}
local order: { Item } = {}
for _, s in Cosmetics.skins do
	local it: any = table.clone(s)
	it.kind = "skin"
	items[it.id] = it
	table.insert(order, it)
end
for _, f in CrateArt.flags do
	local it: any = { id = "flag_" .. f[1], kind = "flag", code = f[1], name = f[2], rarity = "common", atlas = f[3], x = f[4], y = f[5], w = f[6], h = f[7] }
	items[it.id] = it
	table.insert(order, it)
end

-- (mağaza bayrakları: kimlikle bulunur, kasadaki sıraya girmez)
for _, f in ShopFlags.list do
	local it: any = { id = "shop_" .. f.key, kind = "flag", shop = true, key = f.key, name = f.name, rarity = f.rarity, x = f.rect[1], y = f.rect[2], w = f.rect[3], h = f.rect[4] }
	items[it.id] = it
end

function Cosmetics.item(id: any): Item?
	return if type(id) == "string" then items[id] else nil
end

--- Kasadaki her eşya (önce skinler, sonra koda göre bayraklar).
function Cosmetics.all(): { Item }
	return order
end

--- Ülke kodunun (ISO 3166-1, küçük harf: "tr") bayrağı (yoksa nil).
function Cosmetics.flagOf(code: string?): Item?
	return if type(code) == "string" then items["flag_" .. string.lower(code)] else nil
end

function Cosmetics.rarity(id: string): any
	for _, r in Cosmetics.RARITIES do
		if r.id == id then
			return r
		end
	end
	return Cosmetics.RARITIES[1]
end

--- Eşyanın görseli: (resim, x, y, w, h). Resim kimliği boşsa "".
function Cosmetics.image(it: any): (string, number, number, number, number)
	if it == nil then
		return "", 0, 0, 0, 0
	end
	if it.kind == "flag" and it.shop then
		return (Assets.CrateArt :: any).special or "", it.x, it.y, it.w, it.h
	end
	if it.kind == "flag" then
		return (Assets.CrateArt.flags :: any)[it.atlas] or "", it.x, it.y, it.w, it.h
	end
	local c = CrateArt.skins[it.id]
	if c == nil then
		return "", 0, 0, 0, 0
	end
	return Assets.CrateArt.skins, c[1], c[2], c[3], c[4]
end

--- Eşyayı bir ImageLabel'a koyar (bayrak: oranı korunur; skin: pikselli).
function Cosmetics.paint(label: ImageLabel, it: any)
	local img, x, y, w, h = Cosmetics.image(it)
	label.Image = img
	label.ImageRectOffset = Vector2.new(x, y)
	label.ImageRectSize = Vector2.new(w, h)
	label.ScaleType = Enum.ScaleType.Fit
	label.ResampleMode = if it and it.kind == "skin" then Enum.ResamplerMode.Pixelated else Enum.ResamplerMode.Default
end

--- Oyuncunun nadirlik başına kendi oranları: RARITIES oranları, sahip olmadığı eşyası kalan nadirlikler arasında.
--- { { rarity, odds, left } } RARITIES sırasıyla; oranların toplamı 1 (her şeye sahipse hepsi 0).
function Cosmetics.odds(owned: { [string]: any }): { { rarity: any, odds: number, left: number } }
	local out = {}
	local total = 0.0
	for _, r in Cosmetics.RARITIES do
		local left = 0
		for _, it in order do
			if it.rarity == r.id and not owned[it.id] then
				left += 1
			end
		end
		table.insert(out, { rarity = r, odds = if left > 0 then r.odds else 0.0, left = left })
		if left > 0 then
			total += r.odds
		end
	end
	for _, e in out do
		e.odds = if total > 0 then e.odds / total else 0.0
	end
	return out
end

--- Kasa aç: oyuncunun sahip olmadığı bir eşya (her şeye sahipse nil). r1, r2 [0, 1) arasında.
function Cosmetics.roll(owned: { [string]: any }, r1: number, r2: number): string?
	local odds = Cosmetics.odds(owned)
	local x = r1
	local pick = nil
	for _, e in odds do
		if e.odds > 0 then
			pick = e
			if x < e.odds then
				break
			end
			x -= e.odds
		end
	end
	if pick == nil then
		return nil
	end
	local pool = {}
	for _, it in order do
		if it.rarity == pick.rarity.id and not owned[it.id] then
			table.insert(pool, it.id)
		end
	end
	return pool[math.clamp(math.floor(r2 * #pool) + 1, 1, #pool)]
end

--- Skin maskesinin (x, y) karesi ikinci renkte mi (x, y tile; 0'dan).
function Cosmetics.isSecond(skin: any, x: number, y: number): boolean
	local rows = skin.mask
	local row = rows[((y // (2 ^ skin.scale)) % #rows) + 1]
	local mx = (x // (2 ^ skin.scale)) % #row + 1
	return string.sub(row, mx, mx) == "#"
end

--- Bir skinin `color` (sahibinin rengi) üstündeki ikinci rengi.
function Cosmetics.second(skin: any, color: Color3): Color3
	if typeof(skin.accent) == "Color3" then
		return skin.accent
	end
	local t = tonumber(skin.tone) or -0.2
	if t >= 0 then
		return Color3.new(color.R + (1 - color.R) * t, color.G + (1 - color.G) * t, color.B + (1 - color.B) * t)
	end
	return Color3.new(color.R * (1 + t), color.G * (1 + t), color.B * (1 + t))
end

return Cosmetics
]]></ProtectedString>
