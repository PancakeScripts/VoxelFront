					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- LobbyRules: online eşleştirmenin kuralları. Saf mantık (servis yok): hem sunucuda hem testte (Server.Dev.LobbyTests) çalışır.
-- RoWorld src/server/Lobbies/LobbyRules.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.); değişiklikler: iki tür lobi (Solo
-- Online = herkes kendi için, Team Online = 2-4 takım; World'e özel lobi yok), haritalar Shared.Maps.Catalog'dan, harita her
-- lobide rastgele ve aynı türün bir öncekinden farklı, takım sayısı da öyle; lobi dolunca maç beklemeden başlar (start_due).
--
-- Lobi = sıradaki bir online maç: harita, oyuncu sınırı, başlama zamanı (os.time() saniyesi; tüm sunucular SharedClock ile
-- aynı saati okur) ve maçı oynatacak ayrılmış (reserved) sunucu. Normal sunucular açık lobiyi oyunculara gösterir,
-- katılanları lobinin sunucusuna ışınlar; maç sunucusu başlama zamanı gelince ya da lobi dolunca maçı başlatır.
--   * TARGET_OPEN lobi açık tutulur, LOBBY_INTERVAL_S arayla başlar; her biri en çok LOBBY_OPEN_S açık kalır.
--   * Başlamaya JOIN_CLOSE_S kala katılım kapanır (ışınlanma birkaç saniye sürer).
--   * Harita rastgele, son RECENT_MAPS haritadan farklı.

local LobbyRules = {}

LobbyRules.TARGET_OPEN = 1
--- Lobi türleri: herkes kendi için (kayıtta mode yok) ve takım maçı (mode = "team", teams = 2..4). Her türden TARGET_OPEN
--- lobi ayrı ayrı açık tutulur.
LobbyRules.MODE_FFA = "ffa"
LobbyRules.MODE_TEAM = "team"
LobbyRules.TEAM_COUNTS = { 2, 3, 4 }
LobbyRules.LOBBY_OPEN_S = 90
LobbyRules.LOBBY_INTERVAL_S = 45
LobbyRules.MIN_LEAD_S = 45
LobbyRules.JOIN_CLOSE_S = 6
LobbyRules.RECENT_MAPS = 1
LobbyRules.MIN_PLAYERS = 10
LobbyRules.MAX_PLAYERS = 50
--- Lobi kaydı başladıktan sonra bu kadar yaşar (maç sunucusu açılışta okur).
LobbyRules.RECORD_TTL_AFTER_START_S = 15 * 60
--- Başlamış maçın sunucusu kaydını bu aralıkla tazeler; tazelenmeyen (çökmüş) maç listeden düşer.
LobbyRules.LIVE_BEAT_S = 30
LobbyRules.LIVE_STALE_S = 100

export type Lobby = {
	id: string,
	map: string,
	map_name: string,
	max: number,
	starts: number, -- os.time() saniyesi
	created: number,
	players: number, -- maç sunucusundaki (ya da yolda olan) insanlar
	status: string, -- "open" | "started" | "closed"
	beat: number?, -- başlamış maçın son tazeleme zamanı
	code: string?, -- ayrılmış sunucunun erişim kodu (yalnız sunucuda; istemciye asla gitmez)
	psid: string?, -- ayrılmış sunucunun PrivateServerId'si
	seats: { [string]: number }?, -- koltuk defteri: kullanıcı kimliği -> koltuğu aldığı an
	mode: string?, -- "team": takım maçı; nil: herkes kendi için
	teams: number?, -- takım maçının takım sayısı (2..4)
}

--- Lobinin türü (MODE_FFA / MODE_TEAM).
function LobbyRules.mode_of(l: { [string]: any }): string
	return if l.mode == LobbyRules.MODE_TEAM then LobbyRules.MODE_TEAM else LobbyRules.MODE_FFA
end

--- Rastgele takım sayısı (TEAM_COUNTS), bir önceki takım lobisininkinden farklı; `r` [0, 1).
function LobbyRules.pick_teams(prev: number?, r: number): number
	local pool = {}
	for _, n in LobbyRules.TEAM_COUNTS do
		if n ~= prev then
			table.insert(pool, n)
		end
	end
	return pool[math.clamp(math.floor(r * #pool) + 1, 1, #pool)]
end

--- Takım maçının oyuncu sınırı: takım sayısının katına aşağı yuvarlanır (takımlar eşit dolabilsin).
function LobbyRules.team_max(max: number, teams: number): number
	return math.max(teams, math.floor(max / teams) * teams)
end

-- Koltuklar ----------------------------------------------------------------------------------
-- Oyuncu Solo Online'a basınca depo onu uygun en yakın lobiye tek adımda oturtur (take). Kayıt koltukları kimin
-- tuttuğunu bilir: hiç gelmeyen ya da bekleme odasından ayrılan oyuncunun koltuğu geri verilir.

LobbyRules.MAX_SEATS = 60
--- Koltuğu alıp bu kadar sürede maç sunucusuna varmayan oyuncunun koltuğu geri verilir.
LobbyRules.ARRIVE_S = 30

export type TakeSpec = {
	n: number,
	uids: { string },
	at: number,
	close_before: number,
	start_before: number,
	id: string?,
	candidates: { string }?,
	mode: string?, -- istenen lobi türü (nil: MODE_FFA)
}

--- No lobby is ever scheduled further ahead than this; a record beyond it was written with a wrong clock.
LobbyRules.MAX_AHEAD_S = LobbyRules.LOBBY_OPEN_S + LobbyRules.TARGET_OPEN * LobbyRules.LOBBY_INTERVAL_S + 120

function LobbyRules.take_spec(n: number, uids: { string }, now: number, id: string?, mode: string?): TakeSpec
	return {
		n = n,
		uids = uids,
		at = now,
		close_before = now + LobbyRules.JOIN_CLOSE_S,
		start_before = now + LobbyRules.MAX_AHEAD_S,
		id = id,
		mode = mode,
	}
end

--- `l` `spec`'in istediği koltukları verebilir mi.
function LobbyRules.fits(l: Lobby, spec: TakeSpec): boolean
	return l.status == "open"
		and l.starts > spec.close_before
		and l.starts <= spec.start_before
		and l.players + spec.n <= l.max
		and (spec.id == nil or spec.id == l.id)
		and LobbyRules.mode_of(l) == (spec.mode or LobbyRules.MODE_FFA)
end

--- `spec`'in koltukları alınmış `l` (yeni tablo; `l` değişmez).
function LobbyRules.seated(l: Lobby, spec: TakeSpec): Lobby
	local c = table.clone(l)
	local seats = if l.seats ~= nil then table.clone(l.seats) else {}
	local count = 0
	for _ in seats do
		count += 1
	end
	for _, u in spec.uids do
		if seats[u] == nil and count < LobbyRules.MAX_SEATS then
			seats[u] = spec.at
			count += 1
		end
	end
	c.players += spec.n
	c.seats = seats
	return c
end

--- `uids`'in koltukları geri verilmiş `l` (yalnız defterdekiler ve lobi açıkken): yeni kayıt ve geri verilen sayı.
function LobbyRules.released(l: Lobby, uids: { string }): (Lobby, number)
	if l.status ~= "open" or l.seats == nil then
		return l, 0
	end
	local seats = table.clone(l.seats)
	local n = 0
	for _, u in uids do
		if seats[u] ~= nil then
			seats[u] = nil
			n += 1
		end
	end
	if n == 0 then
		return l, 0
	end
	local c = table.clone(l)
	c.seats = seats
	c.players = math.max(0, l.players - n)
	return c, n
end

--- Bekleyen lobinin geri verilecek koltukları: gelip ayrılanlar ve koltuğu alıp ARRIVE_S içinde gelmeyenler.
function LobbyRules.lapsed_seats(l: Lobby, present: { [string]: boolean }, arrived: { [string]: boolean }, now: number): { string }
	local out = {}
	for u, at in l.seats or {} do
		if present[u] then
			continue
		end
		if arrived[u] or now - at >= LobbyRules.ARRIVE_S then
			table.insert(out, u)
		end
	end
	table.sort(out)
	return out
end

-- Talep: bir lobiyi doldurandan fazla oyuncu gelirse ardı ardına başlayan ek lobiler açılır (boş koltuk hep olsun).

LobbyRules.DEMAND_WINDOW_S = 120
LobbyRules.FILL_AHEAD_S = 20
LobbyRules.MAX_OPEN = 4
LobbyRules.MIN_INTERVAL_S = 8

export type Demand = { rate: number, size: number }

--- Talep: `rate` = saniyede alınan koltuk (son DEMAND_WINDOW_S'de açılan lobilerin oyuncuları), `size` = ortalama boyutları.
function LobbyRules.demand(list: { Lobby }, now: number, window: number?): Demand
	local w = math.clamp(window or LobbyRules.DEMAND_WINDOW_S, 30, LobbyRules.DEMAND_WINDOW_S)
	local seats, sizes, n = 0, 0, 0
	for _, l in list do
		if l.created > now - w and l.created <= now then
			seats += math.min(l.players, l.max)
			sizes += l.max
			n += 1
		end
	end
	return { rate = seats / w, size = if n > 0 then sizes / n else LobbyRules.MAX_PLAYERS }
end

--- Haritanın online oyuncu sınırı (Catalog'daki onlineMax), en çok `server` (Players.MaxPlayers: ötesi "GameFull" ışınlanma hatası).
function LobbyRules.max_players(map_max: number?, server: number?): number
	local full = math.clamp(math.floor(map_max or LobbyRules.MAX_PLAYERS), LobbyRules.MIN_PLAYERS, LobbyRules.MAX_PLAYERS)
	if type(server) == "number" and server >= LobbyRules.MIN_PLAYERS then
		full = math.min(full, math.floor(server))
	end
	return full
end

--- Rastgele harita: `ids` arasından, `recent`'tekiler (son RECENT_MAPS harita) hariç; `r` [0, 1). Hepsi yakında oynanmışsa herhangi biri.
function LobbyRules.pick_map(ids: { string }, recent: { string }, r: number): string?
	local pool = {}
	for _, id in ids do
		if table.find(recent, id) == nil then
			table.insert(pool, id)
		end
	end
	if #pool == 0 then
		pool = ids
	end
	if #pool == 0 then
		return nil
	end
	return pool[math.clamp(math.floor(r * #pool) + 1, 1, #pool)]
end

--- Henüz katılınabilir mi (açık, dolu değil, başlamaya yeterince var).
function LobbyRules.joinable(l: Lobby, now: number): boolean
	return l.status == "open" and l.players < l.max and now < l.starts - LobbyRules.JOIN_CLOSE_S
end

--- Maç sunucusu maçı şimdi başlatmalı mı: başlama zamanı geldi ya da lobi doldu ve koltuk sahiplerinin hepsi geldi.
function LobbyRules.start_due(l: Lobby, now: number, present: number): boolean
	return now >= l.starts or (present > 0 and present >= l.max)
end

--- TARGET_OPEN katılınabilir lobi olsun diye şimdi açılacak lobilerin başlama zamanları: en geç katılınabilir başlamanın
--- (ya da now + MIN_LEAD_S) ardından, LOBBY_INTERVAL_S arayla. Dolu lobiler sonrakileri geciktirmez. Hiçbiri LOBBY_OPEN_S'den
--- ileride başlamaz. Başlamasına LOBBY_INTERVAL_S / 2'den az kalan lobi sayılmaz: o kapanmadan sıradaki açılır.
--- `demand`: koltuk hızla alınıyorsa daha çok lobi (en çok MAX_OPEN), dolma süresi kadar aralıkla.
function LobbyRules.missing_starts(open: { Lobby }, now: number, target: number?, demand: Demand?): { number }
	local joinable = 0
	local free = 0
	local latest = 0
	local cover = LobbyRules.LOBBY_INTERVAL_S / 2
	for _, l in open do
		if LobbyRules.joinable(l, now) then
			if l.starts - now > cover then
				joinable += 1
				free += l.max - l.players
			end
			if l.starts > latest then
				latest = l.starts
			end
		end
	end
	local base = target or LobbyRules.TARGET_OPEN
	local want_free = 0
	local interval = LobbyRules.LOBBY_INTERVAL_S
	local size = LobbyRules.MAX_PLAYERS
	if demand ~= nil and demand.rate > 0 then
		want_free = demand.rate * LobbyRules.FILL_AHEAD_S
		size = math.max(1, demand.size)
		interval = math.clamp(size / demand.rate, LobbyRules.MIN_INTERVAL_S, LobbyRules.LOBBY_INTERVAL_S)
	end
	local out = {}
	local next_start = math.max(now + LobbyRules.MIN_LEAD_S, latest + interval)
	while joinable < base or (free < want_free and joinable < math.max(base, LobbyRules.MAX_OPEN)) do
		if next_start > now + LobbyRules.LOBBY_OPEN_S then
			break
		end
		table.insert(out, next_start)
		joinable += 1
		free += size
		next_start += interval
	end
	return out
end

function LobbyRules.plausible(l: Lobby, now: number): boolean
	return l.starts <= now + LobbyRules.MAX_AHEAD_S
end

--- İstemcinin gördüğü lobi (erişim kodu / sunucu kimliği yok). starts_in = katılımın kapanmasına kalan süre: menüdeki
--- geri sayım 0 olunca lobi listeden çıkar, sıradaki görünür.
function LobbyRules.public_view(l: Lobby, now: number): { [string]: any }
	return {
		id = l.id,
		map = l.map,
		map_name = l.map_name,
		max = l.max,
		players = math.min(l.players, l.max),
		starts_in = math.max(0, l.starts - LobbyRules.JOIN_CLOSE_S - now),
		joinable = LobbyRules.joinable(l, now),
		mode = LobbyRules.mode_of(l),
		teams = if LobbyRules.mode_of(l) == LobbyRules.MODE_TEAM then l.teams else nil,
	}
end

--- Depodan okunan kaydı temizler (bozuk ya da eski sürümün yazdığı kayıt); kullanılamazsa nil.
function LobbyRules.decode(v: any): Lobby?
	if type(v) ~= "table" then
		return nil
	end
	if type(v.id) ~= "string" or type(v.map) ~= "string" or type(v.starts) ~= "number" or type(v.max) ~= "number" then
		return nil
	end
	-- koltuk defteri (boş olan dizi olarak dönebilir: Roblox {}'i [] yazar)
	local seats = nil
	if type(v.seats) == "table" then
		seats = {}
		local n = 0
		for u, at in v.seats do
			if type(u) == "string" and #u <= 24 and type(at) == "number" and n < LobbyRules.MAX_SEATS then
				seats[u] = at
				n += 1
			end
		end
	end
	return {
		id = v.id,
		map = v.map,
		map_name = if type(v.map_name) == "string" then v.map_name else v.map,
		max = math.clamp(math.floor(v.max), 1, 200),
		starts = v.starts,
		created = if type(v.created) == "number" then v.created else v.starts,
		players = if type(v.players) == "number" then math.max(0, math.floor(v.players)) else 0,
		status = if v.status == "started" or v.status == "closed" then v.status else "open",
		beat = if type(v.beat) == "number" then v.beat else nil,
		code = if type(v.code) == "string" then v.code else nil,
		psid = if type(v.psid) == "string" then v.psid else nil,
		seats = seats,
		mode = if v.mode == LobbyRules.MODE_TEAM then LobbyRules.MODE_TEAM else nil,
		teams = if v.mode == LobbyRules.MODE_TEAM and type(v.teams) == "number" then math.clamp(math.floor(v.teams), 2, 4) else nil,
	}
end

return LobbyRules
]]></ProtectedString>
