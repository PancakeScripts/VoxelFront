					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Simulation: oyunun tek doğru kaynağı. Roblox API'si yok; zaman yalnızca tick sayacıdır.
--
-- Akış (her tick):
--   1. Kuyruktaki niyetler ve yeni Execution'lar init edilir.
--   2. Çalışan Execution'lar tick edilir; biten çıkarılır (swap-remove).
--   3. Faz güncellenir: spawn -> run -> ended -> (yeni tur) spawn.
--   4. Oyun fazında askerler artar, elemeler ve kazanma kontrol edilir.
-- Durumu yalnızca Execution'lar ve bu tick adımları değiştirir; dışarıdan sadece `submit` çağrılır.
--
-- Bağımlılıklar (`parts`) dışarıdan verilir: { Rng, Economy, Heap, Naval, Spawn, Attack, Cancel, Tribe, Build, Boat, Trade, Nation, Warship, Diplomacy, Diplo, Nuke, Rail, Train, Teams? }.
-- Teams yalnız takım maçında (setTeams) gerekir.
-- Böylece Core modülleri birbirini yol ile require etmez; hem Roblox'ta hem Luau CLI testlerinde aynen çalışır.

local Simulation = {}
Simulation.__index = Simulation

local MAX_QUEUED_INTENTS = 4096

export type Simulation = typeof(setmetatable(
	{} :: {
		world: any,
		cfg: any,
		parts: any,
		territory: any,
		rng: any,
		tickNo: number,
		phase: string, -- "spawn" | "run" | "ended"
		spawnTicksLeft: number,
		silent: boolean,
		round: number,
		runTicks: number,
		endTicksLeft: number,
		winner: number, -- 0 = yok
		-- Takım maçı (Core/Teams): takım sayısı (0 = herkes kendi için), oyuncunun takımı (0 = yok: bot, izleyici),
		-- birlikte gelen grubu (parti: aynı takıma), kazanan takım.
		teamCount: number,
		team: { [number]: number },
		group: { [number]: any },
		winnerTeam: number,
		playerCount: number, -- şimdiye dek verilen pid sayısı (pid'ler yeniden kullanılmaz)
		alive: { [number]: boolean },
		present: { [number]: boolean }, -- bağlı insan oyuncu (elenmiş olsa da)
		wantsPlay: { [number]: boolean? },
		roundHadHumans: boolean,
		inRound: { [number]: boolean? },
		freePids: { number },
		donatedAt: { [number]: number },
		lastDelete: { [number]: number },
		railFail: any,
		mirvsLaunched: number,
		isBot: { [number]: boolean },
		isNation: { [number]: boolean },
		name: { [number]: string },
		troops: { [number]: number },
		spawned: { [number]: boolean },
		locked: { [number]: boolean },
		spawnTiles: { [number]: { number } },
		spawnCenter: { [number]: number },
		intents: { { pid: number, intent: any } },
		intentCount: number,
		newExecs: { any },
		executions: { any },
		executionCount: number,
		events: { { pid: number, code: string, detail: any? } },
		attackIndex: { [number]: any },
		attackCount: { [number]: number },
		gold: { [number]: number },
		structByTile: { [number]: any },
		structList: { any },
		fx: any,
		structCount: { [number]: { [string]: number } },
		constructed: { [number]: { [string]: number } },
		rail: any,
		trainCount: number,
		nationSpots: { { name: string, x: number, y: number } }?,
		tribeNames: { names: { string } }?,
		pace: (() -> ())?, -- tick içinde güvenli noktalarda çağrılır (kare bütçesi dolduysa işi sonraki kareye bırakır)
		cityLevels: { [number]: number },
		posts: { [number]: { any } },
		boatCount: { [number]: number },
		tradeCount: number,
		shoreTmp: { number },
		warshipCount: { [number]: number },
		dip: any,
		routeCache: { [number]: any },
		siteMapCache: any,
		bigWarnAt: { [number]: number }, -- (güçlü komşu uyarısı: pid*65536+komşu -> tick; pid*65536 -> herhangi biri)
	},
	Simulation
))

function Simulation.new(world: any, cfg: any, seed: number, parts: any): Simulation
	local self = setmetatable({
		world = world,
		cfg = cfg,
		parts = parts,
		territory = if parts.Territory then parts.Territory.new(world) else nil,
		rng = parts.Rng.new(seed),
		tickNo = 0,
		phase = "spawn",
		spawnTicksLeft = math.floor(cfg.SPAWN_PHASE_SECONDS * cfg.TICK_RATE + 0.5),
		silent = false,
		round = 1,
		runTicks = 0,
		endTicksLeft = 0,
		winner = 0,
		teamCount = 0,
		team = {},
		group = {},
		winnerTeam = 0,
		playerCount = 0,
		alive = {},
		present = {},
		roundHadHumans = false, -- bu turda en az bir insan oynadı
		wantsPlay = {}, -- insan "Oyna"ya bastı (sonraki turlara da otomatik katılır)
		inRound = {}, -- insan bu turda oynuyor (kazanma koşulu "tüm insanlar elendi" yalnız bunları sayar)
		freePids = {} :: { number },
		donatedAt = {},
		lastDelete = {},
		railFail = nil :: any,
		mirvsLaunched = 0, -- yeni turda boşalan (bot / ayrılmış) kimlikler yeniden kullanılır
		isBot = {},
		isNation = {},
		name = {},
		troops = {},
		spawned = {},
		locked = {},
		spawnTiles = {},
		spawnCenter = {},
		intents = {},
		intentCount = 0,
		newExecs = {},
		executions = {},
		executionCount = 0,
		events = {},
		attackIndex = {},
		attackCount = {},
		gold = {},
		structByTile = {},
		structList = {},
		fx = nil :: any,
		structCount = {},
		constructed = {},
		rail = nil :: any,
		trainCount = 0,
		nationSpots = nil :: { { name: string, x: number, y: number } }?,
		tribeNames = nil :: { names: { string } }?,
		pace = nil :: (() -> ())?,
		cityLevels = {},
		posts = {},
		boatCount = {},
		tradeCount = 0,
		shoreTmp = {},
		warshipCount = {},
		siteMapCache = nil :: any,
		dip = nil :: any,
		routeCache = {},
		bigWarnAt = {},
	}, Simulation)
	parts.Diplomacy.init(self)
	parts.Rail.init(self)
	-- Yapının bulunduğu tile el değiştirirse: şehir yeni sahibe geçer, kule yıkılır, sahipsiz kalırsa kaybolur.
	world.onChange = function(tile: number, _old: number, new: number)
		local st = self.structByTile[tile]
		if st then
			self:onStructureTileChanged(st, new)
		end
	end
	return self
end

-- Oyuncular ----------------------------------------------------------------

local function newPlayer(self: Simulation, name: string, bot: boolean, nation: boolean?): number
	-- Önce boşalmış kimlik: her turda 200+ bot yeniden doğduğu için kimlikler (ve kimlik başına döngüler) turdan tura büyümesin.
	local pid = table.remove(self.freePids)
	if not pid then
		pid = self.playerCount + 1
		assert(pid <= self.cfg.MAP_MAX_OWNER_ID, "player id limit exceeded")
		self.playerCount = pid
	end
	self.present[pid] = nil
	self.wantsPlay[pid] = nil
	self.inRound[pid] = nil
	self.spawnTiles[pid] = nil
	self.spawnCenter[pid] = nil
	self.alive[pid] = true
	self.isBot[pid] = bot
	self.isNation[pid] = nation == true
	self.name[pid] = name
	self.troops[pid] = if nation then self.cfg.NATION_START_TROOPS elseif bot then self.cfg.BOT_START_TROOPS else self.cfg.START_TROOPS
	self.spawned[pid] = false
	self.locked[pid] = false
	self.attackCount[pid] = 0
	self.gold[pid] = if bot and not nation then 0 else self.cfg.START_GOLD
	self.structCount[pid] = { city = 0, post = 0, port = 0, silo = 0, sam = 0, factory = 0 }
	self.constructed[pid] = { city = 0, post = 0, port = 0, silo = 0, sam = 0, factory = 0 }
	self.cityLevels[pid] = 0
	self.posts[pid] = {}
	self.boatCount[pid] = 0
	self.warshipCount[pid] = 0
	self.team[pid] = 0
	self.group[pid] = nil
	return pid
end

-- Takımlar (Core/Teams) -------------------------------------------------------------

-- n: 2..4 takım; başka bir değer herkes kendi için (FFA). Botlar doğmadan (spawnBots) önce çağrılır.
function Simulation.setTeams(self: Simulation, n: number?)
	self.teamCount = if self.parts.Teams then self.parts.Teams.count(n) else 0
end

-- pid'i bir takıma koyar: grubu (parti) bir takımdaysa oraya, değilse Teams.pick (insan: en az insanlı, ulus: en az üyeli).
local function assignTeam(self: Simulation, pid: number)
	local n = self.teamCount
	if n == 0 or (self.isBot[pid] and not self.isNation[pid]) then
		self.team[pid] = 0
		return
	end
	local humans, members = table.create(n, 0), table.create(n, 0)
	local g = self.group[pid]
	local groupTeam = 0
	for p = 1, self.playerCount do
		local t = self.team[p]
		if p ~= pid and t and t ~= 0 and self.alive[p] then
			members[t] += 1
			if not self.isBot[p] then
				humans[t] += 1
			end
			if g ~= nil and groupTeam == 0 and self.group[p] == g then
				groupTeam = t
			end
		end
	end
	self.team[pid] = if groupTeam ~= 0 then groupTeam else self.parts.Teams.pick(humans, members, not self.isBot[pid])
end

-- İnsan oyuncu. `spectator` ise menüde/izleyici olarak başlar (Oyna'ya basınca `join`); değilse hemen katılır.
-- group (isteğe bağlı): birlikte gelenlerin ortak anahtarı (parti); takım maçında aynı takıma konurlar.
function Simulation.addPlayer(self: Simulation, name: string, spectator: boolean?, group: any?): number
	local pid = newPlayer(self, name, false)
	self.present[pid] = true
	self.group[pid] = group
	if spectator then
		self.alive[pid] = false
	else
		self.wantsPlay[pid] = true
		self.inRound[pid] = true
		self.roundHadHumans = true
		assignTeam(self, pid)
	end
	return pid
end

-- Oyna: başlangıç fazındaysa hemen katılır, oyun sürüyorsa sonraki turu bekler (repo: başlamış oyuna girilmez).
-- Döner: "joined" | "waiting" | "already"
function Simulation.join(self: Simulation, pid: number): string
	if not self.present[pid] or self.isBot[pid] then
		return "already"
	end
	self.wantsPlay[pid] = true
	if self.alive[pid] then
		return "already"
	end
	if self.phase == "spawn" then
		self.alive[pid] = true
		self.inRound[pid] = true
		self.roundHadHumans = true
		self.spawned[pid] = false
		self.locked[pid] = false
		self.troops[pid] = self.cfg.START_TROOPS
		self.gold[pid] = self.cfg.START_GOLD
		assignTeam(self, pid)
		return "joined"
	end
	return "waiting"
end

-- Menüye dön: oyundan çekilir (toprağı sahipsiz kalır), sonraki turlara otomatik katılmaz; bağlı kalır ve izler.
function Simulation.leaveToMenu(self: Simulation, pid: number)
	if not self.present[pid] or self.isBot[pid] then
		return
	end
	self.wantsPlay[pid] = false
	if self.alive[pid] then
		self:removePlayer(pid)
		self.present[pid] = true
	end
	self.inRound[pid] = false
end

-- Bot ekler, rastgele yerleştirir ve davranış Execution'ını başlatır. Yerleşemezse nil.
function Simulation.addBot(self: Simulation, name: string): number?
	local pid = newPlayer(self, name, true)
	if not self.parts.Spawn.placeBot(self, pid) then
		self.alive[pid] = false
		return nil
	end
	self:addExecution(self.parts.Tribe.new(pid))
	return pid
end

-- Nation: bot gibi yapay zekâ ama insan ekonomisiyle (Medium); yapı kurar. isBot=true "insan değil" demektir.
function Simulation.addNation(self: Simulation, name: string, x: number?, y: number?): number?
	local pid = newPlayer(self, name, true, true)
	local placed = false
	if x and y then
		placed = self.parts.Spawn.placeNear(self, pid, x, y)
	end
	if not placed and not self.parts.Spawn.placeBot(self, pid) then
		self.alive[pid] = false
		return nil
	end
	self:addExecution(self.parts.Tribe.new(pid))
	return pid
end

-- Oyuncu oyundan çıktı (sunucudan ayrıldı): toprağı, askeri, yapıları ve süren saldırıları olduğu gibi kalır, AFK bir
-- oyuncu gibi (bot devralınmaz; başkaları ona saldırabilir). Artık "burada" sayılmaz: kazanma koşulundaki insanlardan düşer.
-- Henüz yerleşmemişse (başlangıç fazı) tamamen çıkarılır: yokken onun yerine yerleştirilmez.
function Simulation.detachPlayer(self: Simulation, pid: number)
	if not self.spawned[pid] or not self.alive[pid] then
		self:removePlayer(pid)
		return
	end
	self.present[pid] = false
	self.wantsPlay[pid] = false
end

-- Oyuncu ayrılınca toprağı sahipsiz kalır. (Tüm haritayı bir kez tarar; ayrılma nadirdir.)
function Simulation.removePlayer(self: Simulation, pid: number)
	self.present[pid] = false
	if not self.alive[pid] then
		return
	end
	for k = 1, self.executionCount do
		local e = self.executions[k]
		if e and (e.kind == "attack" or e.kind == "boat") and e.pid == pid then
			e:finish(self)
		end
	end
	self.parts.Diplomacy.removePlayer(self, pid)
	self.alive[pid] = false
	self.troops[pid] = 0
	self.spawnTiles[pid] = nil
	self.attackCount[pid] = 0
	self:clearStructures(pid)
	local world = self.world
	if world:tilesOwnedBy(pid) > 0 then
		for i = 0, world.size - 1 do
			if world:ownerAt(i) == pid then
				world:setOwner(i, 0)
			end
		end
	end
end

-- pid'nin karadan komşu olduğu bir `owner` var mı? (0: sahipsiz kara)
function Simulation.bordersOwner(self: Simulation, pid: number, owner: number): boolean
	local world = self.world
	local nb: { number } = {}
	for t in world:borderOf(pid) do
		local n = world:neighbors(t, nb)
		for k = 1, n do
			local u = nb[k]
			if world:ownerAt(u) == owner and (owner ~= 0 or world:isLand(u)) then
				return true
			end
		end
	end
	return false
end

function Simulation.clearStructures(self: Simulation, pid: number)
	for i = #self.structList, 1, -1 do
		local st = self.structList[i]
		if st and st.pid == pid then
			self:removeStructure(st)
		end
	end
end

-- Hiç toprağı kalmayan oyuncu elenir: asker sıfırlanır, saldırıları biter, oyuncuya "eliminated" bildirilir.
function Simulation.checkEliminated(self: Simulation, pid: number)
	if not self.alive[pid] or not self.spawned[pid] or self.world:tilesOwnedBy(pid) > 0 then
		return
	end
	for k = 1, self.executionCount do
		local e = self.executions[k]
		if e and (e.kind == "attack" or e.kind == "boat" or e.kind == "warship") and e.pid == pid then
			e:finish(self)
		end
	end
	self.alive[pid] = false
	self.troops[pid] = 0
	self.spawnTiles[pid] = nil
	self.attackCount[pid] = 0
	self.parts.Diplomacy.removePlayer(self, pid)
	self:clearStructures(pid)
	if not self.isBot[pid] then
		self:emit(pid, "eliminated")
	end
end

-- Yapılar --------------------------------------------------------------------

-- Sahip olunan seviye toplamı (inşaat halindeki yapı 1 sayılır).
function Simulation.levelsOwned(self: Simulation, pid: number, what: string): number
	local n = 0
	for _, st in self.structList do
		if st.pid == pid and st.type == what then
			n += if st.ready then st.level else 1
		end
	end
	return n
end

-- Repo: maliyetteki n = min(sahip olunan seviye toplamı, bugüne dek kurulan/yükseltilen sayısı), liman ve fabrika aynı sayaçta.
local COST_GROUP: { [string]: { string } } = {
	city = { "city" },
	port = { "port", "factory" },
	factory = { "factory", "port" },
	post = { "post" },
	silo = { "silo" },
	sam = { "sam" },
}

function Simulation.structureCost(self: Simulation, pid: number, what: string): number
	local cfg = self.cfg
	local n = 0
	for _, t in COST_GROUP[what] or { what } do
		n += math.min(self:levelsOwned(pid, t), self.constructed[pid][t] or 0)
	end
	if what == "city" then
		return math.min(cfg.CITY_COST_MAX, 2 ^ n * cfg.CITY_COST_BASE)
	end
	if what == "port" then
		return math.min(cfg.PORT_COST_MAX, 2 ^ n * cfg.PORT_COST_BASE)
	end
	if what == "factory" then
		return math.min(cfg.FACTORY_COST_MAX, 2 ^ n * cfg.FACTORY_COST_BASE)
	end
	if what == "silo" then
		return cfg.SILO_COST
	end
	if what == "sam" then
		return math.min(cfg.SAM_COST_MAX, (n + 1) * cfg.SAM_COST_STEP)
	end
	return math.min(cfg.POST_COST_MAX, (n + 1) * cfg.POST_COST_STEP)
end

local function removeFrom(list: { any }, item: any)
	local i = table.find(list, item)
	if i then
		list[i] = list[#list]
		list[#list] = nil
	end
end

local function activate(self: Simulation, st: any)
	st.ready = true
	if st.type == "city" then
		self.cityLevels[st.pid] += st.level
	elseif st.type == "post" then
		table.insert(self.posts[st.pid], st)
	end
	if st.type == "factory" or st.type == "city" or st.type == "port" then
		self.parts.Rail.onReady(self, st) -- demiryolu istasyonu (fabrika menzilindeyse)
	end
end

function Simulation.addStructure(self: Simulation, tile: number, what: string, pid: number, buildTicks: number)
	local st = { tile = tile, type = what, pid = pid, level = 1, readyTick = self.tickNo + buildTicks, buildTicks = buildTicks, ready = false, queue = {} :: { number }, upTick = -1000, upFrom = 0, deleteAt = nil :: number? }
	self.structByTile[tile] = st
	table.insert(self.structList, st)
	self.structCount[pid][what] += 1
	self.constructed[pid][what] = (self.constructed[pid][what] or 0) + 1
	if buildTicks <= 0 then
		activate(self, st)
	end
end

function Simulation.removeStructure(self: Simulation, st: any)
	if self.structByTile[st.tile] ~= st then
		return
	end
	self.structByTile[st.tile] = nil
	removeFrom(self.structList, st)
	if st.station then
		self.parts.Rail.removeStation(self, st)
	end
	self.structCount[st.pid][st.type] -= 1
	if st.ready then
		if st.type == "city" then
			self.cityLevels[st.pid] -= st.level
		elseif st.type == "post" then
			removeFrom(self.posts[st.pid], st)
		end
	end
end

function Simulation.upgradeCity(self: Simulation, st: any)
	if st.type == "sam" then
		st.upFrom = self.parts.Nuke.samRange(self.cfg, st, self.tickNo) -- menzil yükseltme süresince yavaşça artar
		st.upTick = self.tickNo
	end
	st.level += 1
	self.constructed[st.pid][st.type] = (self.constructed[st.pid][st.type] or 0) + 1
	if st.ready and st.type == "city" then
		self.cityLevels[st.pid] += 1
	end
end

function Simulation.onStructureTileChanged(self: Simulation, st: any, newOwner: number)
	if newOwner == 0 or st.type == "post" or newOwner == st.pid then
		if newOwner ~= st.pid then
			if newOwner ~= 0 then
				self:emit(st.pid, "structDestroyed", newOwner, st.type) -- (fethedilen savunma karakolu yıkılır)
			end
			self:removeStructure(st)
		end
		return
	end
	-- şehir/liman fethedildi: yeni sahibe geçer (seviyesiyle)
	local old = st.pid
	self:emit(old, "structCaptured", newOwner, st.type)
	self.structCount[old][st.type] -= 1
	if st.ready and st.type == "city" then
		self.cityLevels[old] -= st.level
	end
	st.pid = newOwner
	self.structCount[newOwner][st.type] += 1
	if st.ready and st.type == "city" then
		self.cityLevels[newOwner] += st.level
	end
end

function Simulation.hasPostNear(self: Simulation, tile: number, owner: number): boolean
	local list = self.posts[owner]
	if not list or #list == 0 then
		return false
	end
	local w = self.world.width
	local x, y = tile % w, tile // w
	local r2 = self.cfg.DEFENSE_POST_RANGE ^ 2
	for _, p in list do
		local dx, dy = p.tile % w - x, p.tile // w - y
		if dx * dx + dy * dy <= r2 then
			return true
		end
	end
	return false
end

-- pid'nin `what` türü yapılarından tile'a en yakın olanı (maxDist içinde). completedOnly ise inşaatı biten.
function Simulation.nearestOwnStructure(self: Simulation, pid: number, what: string, tile: number, completedOnly: boolean): any?
	local w = self.world.width
	local x, y = tile % w, tile // w
	local best, bestD = nil, self.cfg.STRUCTURE_MIN_DIST ^ 2
	for _, st in self.structList do
		if st.pid == pid and st.type == what and (st.ready or not completedOnly) then
			local dx, dy = st.tile % w - x, st.tile // w - y
			local d = dx * dx + dy * dy
			if d <= bestD then
				best, bestD = st, d
			end
		end
	end
	return best
end

-- Yükseltilecek yapı (repo PlayerImpl.findExistingUnitToUpgrade + isUnitValidToUpgrade): tıklanan yere 15 tile
-- (STRUCTURE_MIN_DIST) içindeki aynı türden EN YAKIN yapı — kimin olursa olsun, inşaattaki dahil. O yapı benimse,
-- inşaatı bitmişse ve silinmek üzere değilse yükseltilir; değilse nil (yeni yapı kurulmaya çalışılır).
-- İstemci önizlemesi de aynı kuralı uygular.
function Simulation.upgradeTarget(self: Simulation, pid: number, what: string, tile: number): any?
	local w = self.world.width
	local x, y = tile % w, tile // w
	local best, bestD = nil, self.cfg.STRUCTURE_MIN_DIST ^ 2 + 1
	for _, st in self.structList do
		if st.type == what then
			local dx, dy = st.tile % w - x, st.tile // w - y
			local d = dx * dx + dy * dy
			if d < bestD then
				best, bestD = st, d
			end
		end
	end
	if best and best.pid == pid and best.ready and not best.deleteAt then
		return best
	end
	return nil
end

-- Yapı yeri ve liman yeri: repo kuralları src/shared/Sites.luau'da (istemci önizlemesi de aynı kodu kullanır).
local function siteMap(self: Simulation): any
	local m = self.siteMapCache
	if m then
		return m
	end
	local world = self.world
	local w = world.width
	m = {
		w = w,
		h = world.height,
		owner = function(t: number): number
			return world:ownerAt(t)
		end,
		isShore = function(t: number): boolean
			return world:shoreComponent(t) ~= nil
		end,
		structures = function(cx: number, cy: number, reach: number): { number }
			local out: { number } = {}
			local r2 = reach * reach
			for _, st in self.structList do
				local dx, dy = st.tile % w - cx, st.tile // w - cy
				if dx * dx + dy * dy <= r2 then
					out[#out + 1] = st.tile
				end
			end
			return out
		end,
	}
	self.siteMapCache = m
	return m
end

function Simulation.findStructureSite(self: Simulation, pid: number, tile: number): number?
	return self.parts.Sites.structure(siteMap(self), pid, tile, self.cfg.STRUCTURE_MIN_DIST)
end

function Simulation.findPortSite(self: Simulation, pid: number, tile: number): number?
	return self.parts.Sites.port(siteMap(self), pid, tile, self.cfg.STRUCTURE_MIN_DIST)
end

-- Ticaret: her hazır liman TRADE_CHECK_TICKS'te bir, seviyesi kadar şansla gemi çıkarır (repo PortExecution).
function Simulation.tradeStep(self: Simulation)
	local T = self.parts.Trade
	local cfg = self.cfg
	for _, st in self.structList do
		if st.type == "port" and st.ready and (self.tickNo + st.readyTick) % cfg.TRADE_CHECK_TICKS == 0 and self.alive[st.pid] then
			T.portTick(self, st)
		end
	end
end

-- Bot tavanı oyuncu tavanının üçte biridir.
function Simulation.maxTroopsOf(self: Simulation, pid: number): number
	local cityBonus = (self.cityLevels[pid] or 0) * self.cfg.CITY_TROOP_INCREASE
	local m = self.parts.Economy.maxTroops(self.cfg, self.world:tilesOwnedBy(pid), cityBonus)
	if self.isNation[pid] then
		return m * self.cfg.NATION_MAX_TROOPS_MULT
	elseif self.isBot[pid] then
		return m / self.cfg.BOT_MAX_TROOPS_DIV
	end
	return m
end

function Simulation.allSpawned(self: Simulation): boolean
	local any = false
	for pid = 1, self.playerCount do
		if self.alive[pid] and not self.isBot[pid] then
			any = true
			if not self.spawned[pid] then
				return false
			end
		end
	end
	return any
end

-- Niyetler, Execution'lar ve olaylar --------------------------------------------------

-- Niyeti kuyruğa alır. Doğrulama Execution.init içinde yapılır; burada yalnızca biçim ve yaşayan oyuncu kontrol edilir.
function Simulation.submit(self: Simulation, pid: number, intent: any): boolean
	if not self.alive[pid] or type(intent) ~= "table" or self.intentCount >= MAX_QUEUED_INTENTS then
		return false
	end
	local n = self.intentCount + 1
	self.intentCount = n
	self.intents[n] = { pid = pid, intent = intent }
	return true
end

-- Sunucu içi Execution (ör. botun saldırısı). Sonraki tick'in başında init edilir.
function Simulation.addExecution(self: Simulation, exec: any)
	table.insert(self.newExecs, exec)
end

-- İstemciye görsel olay (efekt) yollar; tick sonunda toplu gönderilir.
function Simulation.pushFx(self: Simulation, e: any)
	local l = self.fx
	if not l then
		l = {}
		self.fx = l
	end
	table.insert(l, e)
end

-- Take Over (RoWorld Sim.take_over, AGPL-3.0, © 2026 Snick Co.): düşmüş insan `old`, yapay zekâ ulusu `target`'ı yönetir;
-- toprağı, askeri, altını, yapıları ve ittifakları kalır, yapay zekâsı durur, oyuncunun adını alır. Yalnız ulus (kabile değil).
function Simulation.canTakeOver(self: Simulation, old: number, target: number): boolean
	return self.phase == "run"
		and old >= 1
		and old <= self.playerCount
		and not self.isBot[old]
		and not self.alive[old]
		and self.present[old] == true
		and target >= 1
		and target <= self.playerCount
		and self.isNation[target] == true
		and self.alive[target] == true
		and self.spawned[target] == true
		and self.world:tilesOwnedBy(target) > 0
end

function Simulation.takeOver(self: Simulation, old: number, target: number): boolean
	if not self:canTakeOver(old, target) then
		return false
	end
	for k = 1, self.executionCount do
		local e = self.executions[k]
		if e and e.kind == "tribe" and e.pid == target then
			e.done = true -- (yapay zekâsı durur)
		end
	end
	local was = self.name[target]
	;(self :: any).takenFrom = (self :: any).takenFrom or {}
	;(self :: any).takenFrom[target] = was -- (rengi ulusun adından kalır)
	self.isBot[target] = false
	self.isNation[target] = false
	self.name[target] = self.name[old]
	self.present[target] = true
	self.wantsPlay[target] = true
	self.inRound[target] = true
	self.locked[target] = true
	self.group[target] = self.group[old]
	self.present[old] = nil
	self.wantsPlay[old] = nil
	self.inRound[old] = nil
	self.roundHadHumans = true
	self:emit(target, "tookOver", nil, was)
	return true
end

-- Altın verir; `tile` verilirse (tren, ticaret) insan oyuncunun ekranında o noktada "+ altın" yazısı çıkar (repo BonusEvent).
function Simulation.addGold(self: Simulation, pid: number, amount: number, tile: number?)
	local gm = (self :: any).goldMult
	if gm and gm[pid] then
		amount *= gm[pid] -- (solo maçta alınan x2 Gold: yalnız o maç)
	end
	self.gold[pid] += amount
	if tile and amount >= 1 and not self.isBot[pid] then
		self:pushFx({ k = "gold", pid = pid, tile = tile, g = math.floor(amount) })
	end
end

-- Bağış (repo donateTroops / donateGold): yalnız müttefike, aynı kişiye 10 sn'de bir. Oran: elindekinin yüzdesi.
function Simulation.donate(self: Simulation, pid: number, target: number, what: string, ratio: number)
	local D = self.parts.Diplomacy
	if type(target) ~= "number" or target < 1 or target > self.playerCount or target == pid or not self.alive[target] then
		self:emit(pid, "badTarget")
		return
	end
	if not D.isAllied(self, pid, target) then
		self:emit(pid, "donateNotAlly")
		return
	end
	local key = pid * 65536 + target
	local last = self.donatedAt[key]
	if last and self.tickNo - last < self.cfg.DONATE_COOLDOWN_TICKS then
		self:emit(pid, "donateWait")
		return
	end
	ratio = math.clamp(if type(ratio) == "number" and ratio == ratio then ratio else 0, 0, 1)
	if what == "gold" then
		local amount = math.floor(self.gold[pid] * ratio)
		if amount <= 0 then
			self:emit(pid, "noGold")
			return
		end
		self.gold[pid] -= amount
		self.gold[target] += amount
	else
		local amount = self.troops[pid] * ratio
		if amount < 1 then
			self:emit(pid, "noTroops")
			return
		end
		self.troops[pid] -= amount
		self.troops[target] += amount
	end
	self.donatedAt[key] = self.tickNo
	self:emit(pid, if what == "gold" then "donatedGold" else "donatedTroops")
	self:emit(target, if what == "gold" then "gotGold" else "gotTroops")
end

-- Yapı silme (repo DeleteUnit): kendi toprağında, tıklanan yere 5 tile (manhattan) içindeki en yakın hazır yapı
-- 30 sn sonra yıkılır (bu sürede kırmızı geri sayım çubuğu); 30 sn bekleme.
function Simulation.markDelete(self: Simulation, pid: number, tile: number)
	if self.phase ~= "run" or type(tile) ~= "number" then
		return
	end
	local last = self.lastDelete[pid]
	if last and self.tickNo - last < self.cfg.DELETE_COOLDOWN_TICKS then
		self:emit(pid, "deleteWait")
		return
	end
	local w = self.world.width
	local best, bestD = nil, math.huge
	for _, st in self.structList do
		if st.pid == pid and st.ready and not st.deleteAt then
			local d = math.abs(st.tile % w - tile % w) + math.abs(st.tile // w - tile // w)
			if d <= 5 and d < bestD then
				best, bestD = st, d
			end
		end
	end
	if not best then
		self:emit(pid, "deleteNone")
		return
	end
	best.deleteAt = self.tickNo + self.cfg.DELETE_MARK_TICKS
	best.deleteFrom = self.tickNo
	self.lastDelete[pid] = self.tickNo
	self:emit(pid, "deleteMarked")
end

-- actor: olayın öteki tarafı (adı istemciye gider); what: yapı türü ("city", "port"...: yapı bildirimleri).
function Simulation.emit(self: Simulation, pid: number, code: string, actor: number?, what: string?)
	if self.silent or self.isBot[pid] then
		return
	end
	local detail = nil
	if actor or what then
		detail = { actor = actor, actorName = if actor then self.name[actor] or "?" else nil, what = what }
	end
	table.insert(self.events, { pid = pid, code = code, detail = detail })
end

-- Güçlü komşu uyarısı (RoWorld UIAdvisor): sınırındaki bir oyuncu / ulus / bot (müttefik ya da takım arkadaşı değil)
-- askerce 5 katı ya da daha güçlüyse insan oyuncuya "bigNeighbor" (aynı komşu için 2 dk'da, herhangi biri için 25 sn'de bir).
function Simulation.warnBigNeighbors(self: Simulation)
	local D = self.parts.Diplomacy
	local rate = self.cfg.TICK_RATE
	for pid = 1, self.playerCount do
		if self.present[pid] and self.alive[pid] and self.spawned[pid] and not self.isBot[pid] and self.troops[pid] > 0 then
			local anyKey = pid * 65536
			if self.tickNo - (self.bigWarnAt[anyKey] or -1e9) >= 25 * rate then
				local worst, worstT = 0, 0
				for _, o in D.bordering(self, pid) do
					if not D.isAllied(self, pid, o) and self.troops[o] >= 5 * self.troops[pid] and self.troops[o] > worstT then
						worst, worstT = o, self.troops[o]
					end
				end
				if worst ~= 0 and self.tickNo - (self.bigWarnAt[anyKey + worst] or -1e9) >= 120 * rate then
					self.bigWarnAt[anyKey + worst] = self.tickNo
					self.bigWarnAt[anyKey] = self.tickNo
					self:emit(pid, "bigNeighbor", worst)
				end
			end
		end
	end
end

function Simulation.takeEvents(self: Simulation): { { pid: number, code: string, detail: any? } }
	local list = self.events
	self.events = {}
	return list
end

function Simulation.createExecution(self: Simulation, pid: number, intent: any): any?
	if intent.type == "spawn" then
		return self.parts.Spawn.new(pid, intent.tile)
	elseif intent.type == "attack" then
		-- Hedefle kara sınırı yoksa ve hedef tile verilmişse gemiyle çıkarma yapılır.
		if intent.tile ~= nil and type(intent.target) == "number" and not self:bordersOwner(pid, intent.target) then
			return self.parts.Boat.new(pid, intent.tile, intent.ratio)
		end
		local atk = self.parts.Attack.new(pid, intent.target, intent.ratio)
		atk.fallbackTile = intent.tile
		return atk
	elseif intent.type == "boat" then
		-- radial menüden açık gemi saldırısı (sınır olsa da gemiyle)
		return self.parts.Boat.new(pid, intent.tile, intent.ratio)
	elseif intent.type == "donate" then
		self:donate(pid, intent.target, intent.what, intent.ratio)
		return nil
	elseif intent.type == "delete" then
		self:markDelete(pid, intent.tile)
		return nil
	elseif intent.type == "warshipMove" then
		-- repo MoveWarshipExecution: seçili savaş gemilerinin devriye merkezi değişir (aynı su kütlesindeyse)
		local tile = intent.tile
		local world = self.world
		if type(tile) == "number" and tile >= 0 and tile < world.size and tile % 1 == 0 and world:isWater(tile) and type(intent.ids) == "table" then
			local want: { [number]: boolean } = {}
			for i, id in intent.ids do
				if i > 50 then
					break
				end
				if type(id) == "number" then
					want[id] = true
				end
			end
			local comp = world:waterComponent(tile)
			for k = 1, self.executionCount do
				local e = self.executions[k]
				if e and e.kind == "warship" and not e.done and e.pid == pid and want[e.id] and world:waterComponent(e.tile) == comp then
					e.patrol = tile
					e.target = nil
					if e.state == "patrolling" then
						e.pathDst = -1 -- yeni merkeze doğru hemen yola çıksın
					end
				end
			end
		end
		return nil
	elseif intent.type == "cancel" then
		return self.parts.Cancel.new(pid, intent.target)
	elseif intent.type == "build" then
		return self.parts.Build.new(pid, intent.what, intent.tile, false)
	elseif intent.type == "upgrade" then
		local what = if intent.what == "port" or intent.what == "silo" or intent.what == "sam" or intent.what == "factory" then intent.what else "city"
		return self.parts.Build.new(pid, what, intent.tile, true)
	elseif intent.type == "warship" then
		return self.parts.Warship.new(pid, intent.tile)
	elseif intent.type == "nuke" then
		return self.parts.Nuke.new(pid, if intent.what == "hydro" then "hydro" elseif intent.what == "mirv" then "mirv" else "atom", intent.tile)
	elseif
		intent.type == "ally"
		or intent.type == "allyAccept"
		or intent.type == "allyReject"
		or intent.type == "breakAlly"
		or intent.type == "extendAlly"
		or intent.type == "embargo"
	then
		return self.parts.Diplo.new(pid, intent.type, intent.target, intent.on)
	end
	return nil
end

local function startExecution(self: Simulation, exec: any)
	exec:init(self)
	if not exec.done then
		self.executionCount += 1
		self.executions[self.executionCount] = exec
	end
end

-- Faz ---------------------------------------------------------------------

function Simulation.autoSpawn(self: Simulation, pid: number)
	local size = self.world.size
	self.silent = true
	for _ = 1, 300 do
		local tile = self.rng:int(0, size - 1)
		if self.world:isLand(tile) and self.world:ownerAt(tile) == 0 then
			self.parts.Spawn.new(pid, tile):init(self)
			if self.spawned[pid] then
				break
			end
		end
	end
	self.silent = false
end

function Simulation.startRun(self: Simulation)
	for pid = 1, self.playerCount do
		if self.alive[pid] and not self.isBot[pid] and not self.spawned[pid] then
			self:autoSpawn(pid)
		end
	end
	self.phase = "run"
	self.runTicks = 0
	for pid = 1, self.playerCount do
		if self.spawned[pid] then
			self.locked[pid] = true
		end
	end
end

function Simulation.growTroops(self: Simulation)
	local eco = self.parts.Economy
	local cfg = self.cfg
	for pid = 1, self.playerCount do
		if self.alive[pid] and self.spawned[pid] then
			local maxT = self:maxTroopsOf(pid)
			local t = self.troops[pid]
			local add = eco.growth(cfg, t, maxT)
			if self.isNation[pid] then
				add *= cfg.NATION_GROWTH_MULT
			elseif self.isBot[pid] then
				add *= cfg.BOT_GROWTH_MULT
			end
			local tm = (self :: any).troopMult
			if tm and tm[pid] then
				add *= tm[pid] -- (solo maçta alınan x2 Troops: yalnız o maç)
			end
			local nextT = t + add
			if nextT > maxT and t <= maxT then
				nextT = maxT
			end
			self.troops[pid] = nextT
			local gm = (self :: any).goldMult
			self.gold[pid] += (if self.isBot[pid] and not self.isNation[pid] then cfg.BOT_GOLD_PER_TICK else cfg.GOLD_PER_TICK) * (if gm and gm[pid] then gm[pid] else 1)
		end
	end
end

-- Kazanma: karanın %WIN_PERCENT'inden fazlası, süre dolması ya da tüm insanların elenmesi.
-- Takım maçında takımın toplam toprağı sayılır; kazanan oyuncu o takımın en büyüğüdür (winnerTeam).
function Simulation.checkWin(self: Simulation)
	local world, cfg = self.world, self.cfg
	local best, bestTiles = 0, -1
	local bestTeam = 0
	local teamTiles: { number }, teamTop: { number }, teamTopTiles: { number } = {}, {}, {}
	local humansPresent, humansAlive, humansWaiting = 0, 0, 0
	for pid = 1, self.playerCount do
		if self.present[pid] and not self.isBot[pid] and not self.inRound[pid] and self.wantsPlay[pid] then
			humansWaiting += 1
		end
		if self.alive[pid] and self.spawned[pid] then
			local n = world:tilesOwnedBy(pid)
			if n > bestTiles then
				best, bestTiles = pid, n
			end
			local t = self.team[pid] or 0
			if t ~= 0 then
				teamTiles[t] = (teamTiles[t] or 0) + n
				if n > (teamTopTiles[t] or -1) then
					teamTop[t], teamTopTiles[t] = pid, n
				end
			end
		end
		if self.present[pid] and self.inRound[pid] and not self.isBot[pid] then
			humansPresent += 1
			if self.alive[pid] then
				humansAlive += 1
			end
		end
	end
	if self.teamCount > 0 then
		local top = -1
		for t = 1, self.teamCount do
			if teamTop[t] and teamTiles[t] > top then
				bestTeam, top = t, teamTiles[t]
			end
		end
		if bestTeam ~= 0 then
			best, bestTiles = teamTop[bestTeam], top
		end
	end
	-- Bu turda oynayan insanların hepsi elendi / menüye döndü; ya da kimse oynamıyorken biri "Oyna"ya bastı
	-- (botların turu bitsin, bekleyen kısa bir aradan sonra yeni turda başlasın).
	-- (solo maç oyuncu düşünce bitmez: Take Over teklifi ve izleme; RoWorld "solo never ends on the human's death")
	local humansOut = self.roundHadHumans and humansAlive == 0 and not cfg.SOLO_KEEP_ON_DEATH
	local nobodyButWaiting = humansAlive == 0 and humansWaiting > 0
	if best == 0 and not humansOut and not nobodyButWaiting then
		return
	end
	local won = bestTiles * 100 > (world.landCount - world.falloutCount) * cfg.WIN_PERCENT -- serpintili kara sayılmaz (repo)
	local timeUp = self.runTicks >= cfg.ROUND_MAX_SECONDS * cfg.TICK_RATE
	if won or timeUp or humansOut or nobodyButWaiting then
		self.winner = best
		self.winnerTeam = bestTeam
		self.phase = "ended"
		self.endTicksLeft = (if nobodyButWaiting and not humansOut and not won then 3 else cfg.ROUND_END_SECONDS) * cfg.TICK_RATE
		-- Sürmekte olan saldırılar durur.
		for k = 1, self.executionCount do
			local e = self.executions[k]
			if e and (e.kind == "attack" or e.kind == "boat" or e.kind == "trade" or e.kind == "warship" or e.kind == "nuke") then
				e:finish(self)
			end
		end
	end
end

-- Yeni tur: harita sıfırlanır, botlar yeniden doğar, bağlı insanlar yeniden spawn seçer.
function Simulation.newRound(self: Simulation)
	local cfg = self.cfg
	self.world:reset()
	if self.territory then self.territory:reset() end
	table.clear(self.executions)
	self.executionCount = 0
	table.clear(self.newExecs)
	table.clear(self.attackIndex)
	self.tradeCount = 0
	self.parts.Diplomacy.init(self)
	table.clear(self.structByTile)
	table.clear(self.structList)
	self.parts.Rail.reset(self)
	self.fx = nil
	table.clear(self.intents)
	self.intentCount = 0
	table.clear(self.freePids)
	table.clear(self.donatedAt)
	table.clear(self.routeCache)
	table.clear(self.bigWarnAt)
	self.railFail = nil
	table.clear(self.lastDelete)
	-- (solo maçın tek seferlik x2 Troops / x2 Gold'u ve Take Over'la alınan ulusların eski adları yalnız o tur için)
	;(self :: any).troopMult = nil
	;(self :: any).goldMult = nil
	;(self :: any).takenFrom = nil
	self.roundHadHumans = false
	for pid = 1, self.playerCount do
		self.team[pid] = 0 -- (yeni turda takımlar yeniden dağıtılır)
	end
	for pid = self.playerCount, 1, -1 do
		self.spawnTiles[pid] = nil
		self.spawnCenter[pid] = nil
		self.attackCount[pid] = 0
		self.gold[pid] = if self.isBot[pid] and not self.isNation[pid] then 0 else self.cfg.START_GOLD
		self.structCount[pid] = { city = 0, post = 0, port = 0, silo = 0, sam = 0, factory = 0 }
		self.constructed[pid] = { city = 0, post = 0, port = 0, silo = 0, sam = 0, factory = 0 }
		self.cityLevels[pid] = 0
		self.posts[pid] = {}
		self.boatCount[pid] = 0
		self.warshipCount[pid] = 0
		self.spawned[pid] = false
		self.locked[pid] = false
		if self.isBot[pid] or not self.present[pid] then
			-- bot (yeniden doğacak) ya da ayrılmış insan: kimlik boşa çıkar
			self.alive[pid] = false
			self.present[pid] = nil
			self.freePids[#self.freePids + 1] = pid -- tersten gidildiği için table.remove küçük kimlikleri önce verir
		elseif self.wantsPlay[pid] then
			self.alive[pid] = true
			self.inRound[pid] = true
			self.roundHadHumans = true
			self.troops[pid] = cfg.START_TROOPS
		else
			self.alive[pid] = false
			self.inRound[pid] = false
		end
	end
	for pid = 1, self.playerCount do
		if self.inRound[pid] and self.alive[pid] and not self.isBot[pid] then
			assignTeam(self, pid)
		end
	end
	self.round += 1
	self.winner = 0
	self.winnerTeam = 0
	self.phase = "spawn"
	self.spawnTicksLeft = math.floor(cfg.SPAWN_PHASE_SECONDS * cfg.TICK_RATE + 0.5)
	self:spawnBots()
end

-- pace (isteğe bağlı): her yerleştirmeden sonra çağrılır (menü arka planı kare bütçesiyle kurulur).
function Simulation.spawnBots(self: Simulation, pace: (() -> ())?)
	local spots = self.nationSpots
	local nations: { number } = {}
	for i = 1, self.cfg.NATION_COUNT do
		local spot = spots and spots[i]
		local pid = if spot then self:addNation(spot.name, spot.x, spot.y) else self:addNation("Nation " .. i)
		if pid then
			nations[#nations + 1] = pid
		end
		if pace then
			pace()
		end
	end
	if self.teamCount > 0 then
		-- uluslar karışık sırayla en az üeyeli takıma (harita sırası bölge bölge olduğu için karıştırılır)
		for i = #nations, 2, -1 do
			local j = self.rng:int(1, i)
			nations[i], nations[j] = nations[j], nations[i]
		end
		for _, pid in nations do
			assignTeam(self, pid)
		end
	end
	local names = self.tribeNames
	local used: { [string]: boolean } = {}
	for i = 1, self.cfg.BOT_COUNT do
		local name = "Bot " .. (self.round * 1000 + i)
		if names then
			-- hazır listeden tam ad (ör. "Red Heron"); çakışmayı birkaç denemeyle önler
			for _ = 1, 20 do
				local n = names.names[self.rng:int(1, #names.names)]
				if not used[n] then
					name = n
					break
				end
			end
			used[name] = true
		end
		self:addBot(name)
		if pace then
			pace()
		end
	end
end

-- Tick ---------------------------------------------------------------------

function Simulation.tick(self: Simulation)
	self.tickNo += 1
	if self.parts.Naval then
		self.parts.Naval.nodesThisTick = 0
	end

	-- 1) niyetler ve yeni execution'lar
	local queued = self.intentCount
	for k = 1, queued do
		local item = self.intents[k]
		self.intents[k] = nil :: any
		if self.alive[item.pid] then
			local exec = self:createExecution(item.pid, item.intent)
			if exec then
				startExecution(self, exec)
			end
		end
	end
	self.intentCount = 0
	if #self.newExecs > 0 then
		local list = self.newExecs
		self.newExecs = {}
		for _, exec in list do
			startExecution(self, exec)
		end
	end

	-- 2) Repodaki gibi oluşturulma sırası korunur. Swap-remove biten bir
 	-- cephenin yerine son cepheyi öne çekip eşzamanlı fetih sonucunu değiştiriyordu.
 local pace = self.pace or function() end
 local list, count = self.executions, self.executionCount
 for i = 1, count do
  local e = list[i]
  if not e.done then e:tick(self); pace() end
 end
 local kept = 0
 for i = 1, count do
  local e = list[i]
  if not e.done then kept += 1; list[kept] = e end
 end
 for i = kept + 1, count do list[i] = nil end
 self.executionCount = kept

	-- 3) faz ve 4) asker artışı / elemeler / kazanma
	if self.phase == "spawn" then
		self.spawnTicksLeft -= 1
		local grace = math.ceil(self.cfg.SPAWN_GRACE_SECONDS * self.cfg.TICK_RATE)
		if self.spawnTicksLeft > grace and self:allSpawned() then
			self.spawnTicksLeft = grace
		end
		if self.spawnTicksLeft <= 0 then
			self.spawnTicksLeft = 0
			self:startRun()
		end
	elseif self.phase == "run" then
		self.runTicks += 1
		if self.territory then self.territory:step(self) end
		pace()
		for pid = 1, self.playerCount do
			self:checkEliminated(pid)
		end
		local doomed: { any }? = nil
		for _, st in self.structList do
			if not st.ready and self.tickNo >= st.readyTick then
				activate(self, st)
			end
			if st.deleteAt and self.tickNo >= st.deleteAt then
				doomed = doomed or {}
				table.insert(doomed :: { any }, st)
			end
		end
		if doomed then
			for _, st in doomed do
				self:removeStructure(st)
			end
		end
		self:growTroops()
		pace()
		self.parts.Diplomacy.tick(self)
		self.parts.Nuke.step(self)
		pace()
		self.parts.Rail.step(self)
		pace()
		self:tradeStep()
		pace()
		if self.tickNo % 10 == 0 then
			self:checkWin()
		end
		if self.tickNo % 50 == 0 then
			self:warnBigNeighbors()
		end
	else
		self.endTicksLeft -= 1
		if self.endTicksLeft <= 0 then
			self:newRound()
		end
	end
end

return Simulation
]]></ProtectedString>
