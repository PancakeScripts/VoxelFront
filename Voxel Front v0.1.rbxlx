					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Teleports: online lobiler için TeleportService: maç sunucusu ayırma, oyuncuları oraya gönderme, normal bir sunucuya geri
-- gönderme. Studio'da ışınlanma olmaz: `studio` sahte değerler döner (send "studio" der; çağıran maçı aynı sunucuda oynatabilir).
-- RoWorld src/server/Lobbies/Teleports.luau'dan alındı (AGPL-3.0, © 2026 Snick Co.).

local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

local Teleports = {}

Teleports.RETRIES = 3
--- Bir oyuncu için yola çıkmış geri dönüş bu süre içinde yeniden başlatılmaz (iki kez basılan çıkış ya da tam o sırada biten
--- maç "already in progress" hatası verir).
Teleports.PENDING_S = 20

function Teleports.live(place_id: number)
	local t = {}
	local pending: { [Player]: number } = {}
	TeleportService.TeleportInitFailed:Connect(function(player: Player)
		pending[player] = nil
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(player: Player)
		pending[player] = nil
	end)

	function t.reserve(): (string, string)
		local code, psid = TeleportService:ReserveServer(place_id)
		return code, psid
	end

	function t.send(players: { Player }, code: string, data: { [string]: any }): (boolean, string?)
		local opts = Instance.new("TeleportOptions")
		opts.ReservedServerAccessCode = code
		opts:SetTeleportData(data)
		local last: any = nil
		for attempt = 1, Teleports.RETRIES do
			local ok, err = pcall(function()
				TeleportService:TeleportAsync(place_id, players, opts)
			end)
			if ok then
				return true, nil
			end
			last = err
			task.wait(attempt)
		end
		warn("[Lobbies] teleport failed: " .. tostring(last))
		return false, "The teleport failed. Try again."
	end

	--- `data` (isteğe bağlı) normal sunucuya ışınlanma verisi olarak gider.
	function t.to_hub(players: { Player }, data: { [string]: any }?): (boolean, string?)
		local now = os.clock()
		local list = {}
		for _, p in players do
			if p.Parent ~= nil and (pending[p] == nil or now - pending[p] > Teleports.PENDING_S) then
				pending[p] = now
				table.insert(list, p)
			end
		end
		if #list == 0 then
			return true, nil -- (hepsi zaten yolda)
		end
		local ok, err = pcall(function()
			if data ~= nil then
				local opts = Instance.new("TeleportOptions")
				opts:SetTeleportData(data)
				TeleportService:TeleportAsync(place_id, list, opts)
			else
				TeleportService:TeleportAsync(place_id, list)
			end
		end)
		if not ok then
			for _, p in list do
				pending[p] = nil
			end
			local msg = tostring(err)
			if string.find(msg, "already in progress", 1, true) then
				return true, nil
			end
			warn("[Lobbies] return teleport failed: " .. msg)
		end
		return ok, if ok then nil else tostring(err)
	end

	return t
end

--- Studio yerine geçenleri. `on_send(players, code, data, psid)` verilirse gönderme ona yapılır (maç aynı sunucuda oynanır).
function Teleports.studio(on_send: ((any, string, any, string) -> (boolean, string?))?)
	local n = 0
	local psid_of: { [string]: string } = {}
	local t = {}
	function t.reserve(): (string, string)
		n += 1
		local code, psid = "studio-code-" .. n, "studio-psid-" .. n
		psid_of[code] = psid
		return code, psid
	end
	function t.send(players: { Player }, code: string, data: any): (boolean, string?)
		if on_send ~= nil and psid_of[code] ~= nil then
			return on_send(players, code, data, psid_of[code])
		end
		return false, "studio"
	end
	function t.to_hub(_players: { Player }, _data: any): (boolean, string?)
		return true, nil
	end
	return t
end

function Teleports.for_place(place_id: number, on_studio_send: ((any, string, any, string) -> (boolean, string?))?)
	if RunService:IsStudio() then
		return Teleports.studio(on_studio_send)
	end
	return Teleports.live(place_id)
end

return Teleports
]]></ProtectedString>
