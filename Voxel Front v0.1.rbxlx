					<ProtectedString name="Source"><![CDATA[--!strict
-- Tüm sabitler burada. Denge değerleri oyun testiyle ayarlanır; kodun içine gömülmez.
-- Asker formülleri OpenFront topluluk wikisindeki (Attacking Guide, v23/v34) kural yapısından alınmıştır;
-- sayısal ölçekler bu oyuna göre başlangıç değeridir.

local Config = {
	-- Paket sürümü: zip adıyla aynı (frontline-asama-N.zip; düzeltmeler asama-N.1, N.2).
	-- Ekranda ve Output'ta görünür; Studio'da doğru dosyaların senkronlandığını buradan anlarsın.
	VERSION = "asama-37",

	-- Oyun mantığı sabit adımla çalışır: 10 tick / saniye.
	TICK_RATE = 10,
	TICK_SECONDS = 0.1,
	-- Bir Heartbeat karesinde en fazla kaç tick yetiştirilir (yavaş sunucuda kilitlenmeyi önler).
	MAX_CATCHUP_TICKS = 3,

	-- Harita
	MAP_MAX_OWNER_ID = 65535, -- owner buffer'ı u16

	-- Kamera sınırları
	VIEW_ZOOM_OUT_SLACK = 0.1, -- uzaklaşınca kamera, haritayı sığdıran görünümden en fazla %10 geniş
	VIEW_PAN_OVERSHOOT = 0.2, -- kaydırınca kamera haritanın dışına, kendi boyutunun en fazla %20'si kadar taşar

	-- Başlangıç (spawn) fazı
	SPAWN_PHASE_SECONDS = 20, -- başlangıç fazı (repoda çok oyunculuda 200 tick = 20 sn)
	SPAWN_GRACE_SECONDS = 5, -- (bize özgü) herkes seçtiyse kalan süre buna indirilir
	ONLINE_SPAWN_SECONDS = 20, -- (RoWorld MP_SPAWN_TICKS 200 = 20 sn) online maçta toprak seçimi: her zaman tam bu kadar (kısalmaz); lobinin süresi bitmeden bu kadar önce başlar
	SPAWN_RADIUS = 4, -- başlangıçta sahiplenilen dairenin yarıçapı (tile)

	-- Asker ekonomisi (iç değerler; ekranda TROOP_DISPLAY_DIV'e bölünerek gösterilir)
	START_TROOPS = 25000,
	-- Tavan = FACTOR * (tile^EXP * MULT + BASE) + şehir bonusu
	MAX_TROOPS_FACTOR = 2,
	MAX_TROOPS_TILE_EXP = 0.6,
	MAX_TROOPS_TILE_MULT = 1000,
	MAX_TROOPS_BASE = 50000,
	-- Tick başına artış = (BASE + asker^EXP / DIV) * (1 - asker / tavan)
	TROOP_GROWTH_BASE = 10,
	TROOP_GROWTH_EXP = 0.73,
	TROOP_GROWTH_DIV = 4,
	TROOP_DISPLAY_DIV = 10,

	-- Saldırı: OpenFront'un saldırı kurallarına göre (değerler repodaki kuraldan okunup kendi yazımımla uygulandı).
	ATTACK_MAX_ACTIVE = 64, -- (bize özgü, yalnızca bellek koruması) repoda sınır yok; aynı hedefe saldırılar birleşir
	ATTACK_MIN_TROOPS = 1000, -- bundan az askerle saldırı başlatılamaz
	ATTACK_DEFAULT_RATIO = 0.2, -- istemcide varsayılan gönderim oranı (repodaki varsayılan %20)
	-- Arazi: 1 ova, 2 yayla, 3 dağ. mag = tile'ın kanlılığı (asker kaybı), tileCost = tile'ı almanın yavaşlığı.
	ATTACK_MAG = { [1] = 80, [2] = 100, [3] = 120 },
	ATTACK_TILE_COST = { [1] = 16.5, [2] = 20, [3] = 25 },
	-- Öncelik kuyruğu: öncelik = (rastgele(0..6) + 10) * (1 - kendiKomşuSayısı*0.5 + mag/2) + tick; küçük olan önce alınır.
	ATTACK_PRIORITY_BASE = 10,
	ATTACK_PRIORITY_RANDOM = 6, -- 0..6 dahil
	ATTACK_PRIORITY_MAG = { [1] = 1, [2] = 1.5, [3] = 2 }, -- öncelikteki arazi çarpanı
	ATTACK_BORDER_JITTER = 4, -- sınır boyuna eklenen rastgele 0..4
	-- Sahipsiz toprak
	ATTACK_TERRA_LOSS_DIV = 5, -- saldıran kaybı = mag / 5
	ATTACK_TERRA_SCALE = 2000,
	ATTACK_TERRA_MIN_COST = 5,
	ATTACK_TERRA_MAX_COST = 100,
	-- Oyuncuya karşı
	ATTACK_LOSS_BASE = 0.463,
	ATTACK_LOSS_PER_DENSITY = 0.0039,
	ATTACK_CHEAPEST_RATIO = 0.6,
	ATTACK_SPEED_DIVISOR = 8.55,
	ATTACK_LARGE_MIDPOINT = 300000, -- büyük bölgelerin avantajı bu tile sayısında yarıya gelir
	ATTACK_LARGE_STEEPNESS = 2.5,
	ATTACK_LARGE_ATTACKER_DEPTH = 0.7,
	ATTACK_LARGE_DEFENDER_DEPTH = 0.3,
	ATTACK_LARGE_ATTACKER_SPEED_DEPTH = 0.73,
	ATTACK_RETREAT_MALUS = 25, -- oyuncuya saldırıyı geri çekince askerin bu yüzdesi kaybolur
	DEAD_DEFENDER_TILES = 100, -- savunmacı bu kadar tile'ın altına düşünce toprağı saldırana geçer

	-- Botlar (repodaki "tribe"): ayrı sayılar repodaki TribeExecution/Config değerleridir.
	-- Liman ve ticaret gemileri (repo)
	PORT_COST_BASE = 125000, -- min(PORT_COST_MAX, 2^n * BASE), n = sahip olunan liman
	PORT_COST_MAX = 1000000,
	PORT_BUILD_TICKS = 50,
	PORT_SPAWN_RADIUS = 20, -- tıklamaya manhattan mesafesi içindeki kıyı tile'ı
	TRADE_CHECK_TICKS = 10, -- liman başına gemi çıkarma kontrolü
	TRADE_SHORT_RANGE = 300, -- bu mesafeden yakın limanlar tercih edilmez, altın cezalı
	TRADE_GOLD_MAX = 75000, -- 75000 / (1 + e^(-0.03 (d - 300))) + 50 d
	TRADE_GOLD_RATE = 0.03,
	TRADE_GOLD_PER_TILE = 50,
	TRADE_SAT_MID = 330, -- gemi sayısı doygunluk orta noktası
	TRADE_SAT_PLATEAU_MID = 800,
	TRADE_ROUTE_MAX_NODES = 150000,
	NAV_TICK_BUDGET = 40000, -- (bize özgü) bir tick'te ticaret rotası aramalarına ayrılan düğüm bütçesi

	-- Savaş gemisi (repo)
	WARSHIP_COST_STEP = 250000, -- min(WARSHIP_COST_MAX, (n + 1) * STEP), n = sahip olunan savaş gemisi
	WARSHIP_COST_MAX = 1000000,
	WARSHIP_HEALTH = 1000,
	SHELL_DAMAGE = 250, -- zar: (1..6) -> 200..325 / 250 oranı
	SHELL_SPEED = 3, -- tile/tick
	WARSHIP_SHELL_RATE = 20, -- tick; nakliye gemisine ateşte bekleme yok
	WARSHIP_PATROL_RANGE = 100,
	WARSHIP_TARGET_RANGE = 130,
	WARSHIP_DOCK_RANGE = 5,
	WARSHIP_HEAL_PASSIVE = 1, -- tick başına, limana WARSHIP_HEAL_RANGE içinde
	WARSHIP_HEAL_RANGE = 150,
	WARSHIP_HEAL_PER_PORT_LEVEL = 5, -- limanda bekleyen gemilerin ortak iyileşme havuzu
	WARSHIP_RETREAT_PERCENT = 75, -- can bunun altına düşünce limana çekilir
	WARSHIP_MANUAL_RETREAT_OFF = 50,
	WARSHIP_VET_MAX = 3,
	WARSHIP_VET_DAMAGE_PCT = 20,
	WARSHIP_VET_HEALTH_PCT = 20,
	WARSHIP_VET_TRANSPORT_KILLS = 10, -- bir seviye = 10 nakliye imhası ya da 25 ticaret gemisi ele geçirme
	WARSHIP_VET_TRADE_CAPTURES = 25,
	WARSHIP_CAPTURE_DIST = 5,
	SAFE_FROM_PIRATES_TICKS = 20, -- kıyıya değen su tile'ından sonra ticaret gemisi bu kadar tick korunur
	WARSHIP_ROUTE_MAX_NODES = 40000,

	-- İttifak, hain, ambargo (repo)
	ALLIANCE_REQUEST_TICKS = 200, -- istek 20 sn içinde cevaplanmazsa reddedilir
	ALLIANCE_TICKS = 3000, -- ittifak 5 dk sürer
	ALLIANCE_COOLDOWN_TICKS = 300, -- aynı kişiye tekrar istek bekleme süresi (30 sn)
	ALLIANCE_EXT_WINDOW = 300, -- bitmeden son 30 sn'de yenilenebilir
	TRAITOR_TICKS = 300, -- ittifak bozan 30 sn "hain"
	TRAITOR_DEFENSE_DEBUFF = 0.5, -- hainin saldırı kaybı (saldırgan için) x0.5
	TRAITOR_SPEED_DEBUFF = 0.8, -- hainin toprağı x0.8 sürede alınır
	EMBARGO_TEMP_TICKS = 3000, -- saldırıdan doğan geçici ambargo 5 dk

	-- Nation (repo: insan gibi ekonomi; yapı kurar). Aşağıdaki değerler seçilen zorlukla (DIFFICULTY) değişir, başlangıçta "normal".
	NATION_COUNT = 72, -- (bize özgü) repoda haritaya göre değişir
	NATION_START_TROOPS = 12500,
	NATION_MAX_TROOPS_MULT = 0.5,
	NATION_GROWTH_MULT = 0.9,
	NATION_ATTACK_RATE = { 65, 100 }, -- kaç tickte bir karar
	NATION_CONFUSED_X = 10, -- ittifak kararında 1/X ihtimalle rastgele davranır
