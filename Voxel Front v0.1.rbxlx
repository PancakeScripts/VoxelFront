						<ProtectedString name="Source"><![CDATA[--!strict
-- LobbyDirectory: normal (herkese açık) sunucudaki lobi listesi. Oyun genelindeki açık lobi listesini tazeler, az açık lobi
-- varsa yenisini oluşturur (kısa bir kilitle aynı anda tek sunucu), oyunculara gösterir ve katılanları lobinin ayrılmış
-- sunucusuna ışınlar. Tüm sunucular aynı depoyu okur: her yerdeki oyuncular aynı lobileri görür.
-- RoWorld src/server/Lobbies/LobbyDirectory.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.); değişiklikler: Solo Online ve Team
-- Online lobileri (World'e özel lobi, izleyici ve parti yok), haritalar Catalog'dan, harita (ve takım sayısı) rastgele ve aynı
-- türün bir öncekinden farklı. Her türün lobileri ayrı planlanır, ayrı gösterilir ve ayrı doldurulur.
--
--   deps = {
--     store = LobbyStore (list, put, remove, lock, bind_psid, take, release),
--     teleport = { reserve = function() -> (code, psid), send = function(players, code, data) -> (ok, err?) },
--     maps = function() -> { { id, name, max } },   -- haritalar ve online oyuncu sınırları
--     now = function() -> number,                  -- ortak saat (SharedClock.now)
--     rand = function() -> number,                 -- [0, 1)
--     new_id = function() -> string,
--     log = function(text)?,
--     server_size = function() -> number?,         -- bir sunucunun alabildiği en çok oyuncu (Players.MaxPlayers)
--     uid_of = function(player) -> string?,        -- oyuncunun kullanıcı kimliği (varsayılan tostring(player.UserId))
--     wait = function(seconds)?,                   -- testte verilir (varsayılan task.wait)
--     kinds = function() -> { string }?,           -- planlanacak lobi türleri (varsayılan yalnız "ffa")
--   }
local LobbyRules = require(script.Parent.LobbyRules)

local LobbyDirectory = {}
LobbyDirectory.__index = LobbyDirectory

--- (Hub yalnız Solo Online penceresi açık bir oyuncu varken okur: çok sunuculu oyunda ortak listeye daha az yük)
LobbyDirectory.REFRESH_S = 5.0
LobbyDirectory.LOCK_TTL_S = 10
--- Kilidi alamayan sunucu bu aralıkta rastgele bir süre sonra yeniden ister (her tazelemede değil: çok sunucu kilidi
--- sürekli isteyince depo zorlanır). Tutan sunucu her tazelemede yeniler.
LobbyDirectory.LOCK_RETRY_S = { 8.0, 16.0 }
--- Başlama zamanından bu kadar sonra hala "açık" olan lobiye kimse katılmamıştır: silinir.
LobbyDirectory.STALE_AFTER_S = 30
--- Koltuk ayırma denemesi sayısı.
LobbyDirectory.JOIN_TRIES = 3
--- join'in nedeni: şu an hiçbir lobide yer yok (çağıran oyuncuyu sıraya alır).
LobbyDirectory.NO_ROOM = "no room"
--- join'in nedeni: depoya ulaşılamıyor ve bu sunucunun listesinde de yer yok.
LobbyDirectory.UNREACHABLE = "Couldn't reach the match list. Try again in a moment."
--- Sıradakiler bu aralıkla yeniden denenir...
LobbyDirectory.QUEUE_RETRY_S = 1.0
--- ...her seferinde en çok bu kadarı (depo çağrısı sınırlı)...
LobbyDirectory.QUEUE_BATCH = 4
--- ...ve en çok bu kadar bekler.
LobbyDirectory.QUEUE_MAX_S = 120

--- Sırada bekleyen: `key` (oyuncu başına bir), `since`, `mode` (lobi türü; nil: MODE_FFA); `members()` -> ışınlanacak
--- oyuncular ya da artık gidemezse nil; `done(ok, reason, lobby, players)` oturunca ya da sıradan çıkınca.
export type QueueEntry = {
	key: string,
	since: number,
	mode: string?,
	party: (() -> any)?, -- (ışınlanma verisindeki parti; members ile aynı anda sorulur)
	members: () -> { any }?,
	done: (boolean, string?, LobbyRules.Lobby?, { any }?) -> (),
}

function LobbyDirectory.new(deps: { [string]: any })
	local self = setmetatable({}, LobbyDirectory)
	self.deps = deps
	self._lobbies = {} :: { LobbyRules.Lobby }
	self._refresh_in = 0.0
	self._recent = {} :: { [string]: { string } } -- tür -> son haritalar (liste boşken bu sunucunun hafızası)
	self._recent_teams = nil :: number? -- son takım lobisinin takım sayısı (aynı şekilde)
	self._busy = false
	self._queue = {} :: { QueueEntry }
	self._queue_in = 0.0
	self._queue_busy = false
	self._lock_retry_at = -math.huge
	self.demand = nil :: LobbyRules.Demand? -- (Solo Online'ın; tür başına `demands`)
	self.demands = {} :: { [string]: LobbyRules.Demand }
	return self
end

function LobbyDirectory._kinds(self: any): { string }
	local f = self.deps.kinds
	return if f ~= nil then f() else { LobbyRules.MODE_FFA }
end

function LobbyDirectory._log(self: any, text: string)
	local log = self.deps.log
	if log then
		log("[Lobbies] " .. text)
	end
end

--- Önbellekteki lobiler (tick her REFRESH_S'de tazeler).
function LobbyDirectory.lobbies(self: any): { LobbyRules.Lobby }
	return self._lobbies
end

--- İstemcilerin gördüğü: henüz katılınabilir açık lobiler, en yakın başlayan önce (dolu ya da katılımı kapanmış
--- olan gizlenir: oyuncular sıradakine gider; missing_starts onu zaten planladı). `mode`: yalnız o tür (nil: hepsi).
function LobbyDirectory.view(self: any, mode: string?): { any }
	local now = self.deps.now()
	local out = {}
	for _, l in self._lobbies do
		if l.status == "open" and LobbyRules.joinable(l, now) and (mode == nil or LobbyRules.mode_of(l) == mode) then
			table.insert(out, LobbyRules.public_view(l, now))
		end
	end
	return out
end

--- Her kare: listeyi ara ara tazeler ve tamamlar. Depo çağrıları beklediği için tazeleme kendi iş parçacığında çalışır.
function LobbyDirectory.tick(self: any, dt: number, spawn: ((() -> ()) -> ())?)
	self._refresh_in -= dt
	if self._refresh_in > 0 or self._busy then
		return
	end
	self._refresh_in = LobbyDirectory.REFRESH_S
	self._busy = true
	local run = function()
		local ok, err = pcall(self.refresh, self)
		if not ok then
			self:_log("refresh failed: " .. tostring(err))
		end
		self._busy = false
	end
	if spawn then
		spawn(run)
	else
		run()
	end
end

--- Depoyu okur, bayatlamış lobileri atar, eksikleri oluşturur (kilit bu sunucudaysa).
function LobbyDirectory.refresh(self: any)
	local deps = self.deps
	local now = deps.now()
	local list: { LobbyRules.Lobby } = {}
	for _, v in deps.store.list() do
		local l = LobbyRules.decode(v)
		if l == nil then
			continue
		end
		if l.status == "open" and l.starts < now - LobbyDirectory.STALE_AFTER_S then
			-- başlamadan kimse katılmadı: gider
			pcall(deps.store.remove, l.id)
			continue
		end
		if l.status == "open" and not LobbyRules.plausible(l, now) then
			-- yanlış saatle yazılmış (saati ileri giden bir sunucu): listelenmez, sayılmaz
			continue
		end
		table.insert(list, l)
	end
	table.sort(list, function(a, b)
		return a.starts < b.starts
	end)
	self._lobbies = list
	local oldest = now
	for _, l in list do
		oldest = math.min(oldest, l.created)
	end
	-- tür başına talep ve eksik lobiler (her tür kendi lobileriyle)
	local want: { { any } } = {} -- { başlama, tür }
	for _, kind in self:_kinds() do
		local sub = {}
		for _, l in list do
			if LobbyRules.mode_of(l) == kind then
				table.insert(sub, l)
			end
		end
		local d = LobbyRules.demand(sub, now, math.min(LobbyRules.DEMAND_WINDOW_S, now - oldest))
		self.demands[kind] = d
		if kind == LobbyRules.MODE_FFA then
			self.demand = d
		end
		for _, starts in LobbyRules.missing_starts(sub, now, nil, d) do
			table.insert(want, { starts, kind })
		end
	end
	if #want > 0 and now >= self._lock_retry_at then
		if deps.store.lock("scheduler", LobbyDirectory.LOCK_TTL_S) then
			self._lock_retry_at = -math.huge
			for _, w in want do
				local ok, l = pcall(self.create, self, w[1], w[2])
				if ok and l ~= nil then
					table.insert(self._lobbies, l)
				elseif not ok then
					self:_log("create failed: " .. tostring(l))
				end
			end
		else
			-- başka bir sunucuda: lobileri o oluşturur
			local r = LobbyDirectory.LOCK_RETRY_S
			self._lock_retry_at = now + r[1] + deps.rand() * (r[2] - r[1])
		end
	end
end

--- `starts`'ta başlayan bir lobi oluşturur (ayrılmış sunucu + depo kaydı). `mode`: lobi türü (varsayılan MODE_FFA).
function LobbyDirectory.create(self: any, starts: number, mode: string?): LobbyRules.Lobby?
	local deps = self.deps
	local kind = mode or LobbyRules.MODE_FFA
	local maps = deps.maps()
	local ids = {}
	for _, m in maps do
		table.insert(ids, m.id)
	end
	-- oyun genelinde aynı türün en son lobilerinin haritaları (her sunucu aynı listeyi okur; liste boşken bu sunucunun
	-- hafızası), yeniden eskiye
	local latest = {}
	for _, l in self._lobbies do
		if LobbyRules.mode_of(l) == kind then
			table.insert(latest, l)
		end
	end
	table.sort(latest, function(a, b)
		return a.starts > b.starts
	end)
	local recent = {}
	for _, l in latest do
		if #recent >= LobbyRules.RECENT_MAPS then
			break
		end
		table.insert(recent, l.map)
	end
	if #recent == 0 then
		recent = self._recent[kind] or {}
	end
	local map_id = LobbyRules.pick_map(ids, recent, deps.rand())
	if map_id == nil then
		return nil
	end
	-- takım sayısı: son takım lobisininkinden farklı
	local teams: number? = nil
	if kind == LobbyRules.MODE_TEAM then
		local prev = if latest[1] then latest[1].teams else self._recent_teams
		teams = LobbyRules.pick_teams(prev, deps.rand())
		self._recent_teams = teams
	end
	local info = nil
	for _, m in maps do
		if m.id == map_id then
			info = m
			break
		end
	end
	local mine = self._recent[kind] or {}
	self._recent[kind] = mine
	table.insert(mine, 1, map_id)
	while #mine > LobbyRules.RECENT_MAPS do
		table.remove(mine)
	end
	local max = LobbyRules.max_players(
		if info then info.max else nil,
		if type(deps.server_size) == "function" then deps.server_size() else nil
	)
	if teams ~= nil then
		max = LobbyRules.team_max(max, teams)
	end
	local code, psid = deps.teleport.reserve()
	local now = deps.now()
	local l: LobbyRules.Lobby = {
		id = deps.new_id(),
		map = map_id,
		map_name = if info then info.name else map_id,
		max = max,
		starts = starts,
		created = now,
		players = 0,
		status = "open",
		code = code,
		psid = psid,
		mode = if teams ~= nil then LobbyRules.MODE_TEAM else nil,
		teams = teams,
	}
	local ttl = math.max(60, starts - now + LobbyRules.RECORD_TTL_AFTER_START_S)
	deps.store.put(l, ttl)
	if psid ~= nil then
		deps.store.bind_psid(psid, l.id, ttl)
	end
	self:_log(string.format("created %s on %s (%d players%s) starting in %ds", l.id, l.map, l.max, if teams then ", " .. teams .. " teams" else "", starts - now))
	return l
end

function LobbyDirectory._uid(self: any, p: any): string
	local f = self.deps.uid_of
	if f ~= nil then
		local u = f(p)
		if u ~= nil then
			return u
		end
	end
	local ok, u = pcall(function()
		return p.UserId
	end)
	return if ok and u ~= nil then tostring(u) else tostring(p)
end

--- Bu sunucunun listesindeki, henüz katılım alan açık lobiler, en yakın başlayan önce (depo arayamadığı için sırayla denenir;
--- depoya ulaşılamazsa buraya gidilir).
function LobbyDirectory._open(self: any, now: number, mode: string?): { LobbyRules.Lobby }
	local out = {}
	local kind = mode or LobbyRules.MODE_FFA
	for _, l in self._lobbies do
		if l.status == "open" and l.starts > now + LobbyRules.JOIN_CLOSE_S and LobbyRules.plausible(l, now) and LobbyRules.mode_of(l) == kind then
			table.insert(out, l)
		end
	end
	table.sort(out, function(a, b)
		return a.starts < b.starts
	end)
	return out
end

--- `players`'ı yeri olan en yakın online maça tek depo adımında oturtur ve oraya ışınlar (bekler). `opts.id`: yalnız o lobi;
--- `opts.mode`: lobi türü (varsayılan MODE_FFA); `opts.wanted()`: ışınlamadan önce sorulur (false: koltuklar geri verilir);
--- `opts.party`: ışınlanma verisine eklenir (maç sunucusu partiyi aynı takıma koyar).
--- Döner: ok, neden, lobi (yer yoksa neden NO_ROOM).
function LobbyDirectory.join(self: any, players: { any }, opts: { [string]: any }?): (boolean, string?, LobbyRules.Lobby?)
	local deps = self.deps
	local o: { [string]: any } = opts or {}
	local n = math.max(1, #players)
	local uids = {}
	for _, p in players do
		table.insert(uids, self:_uid(p))
	end
	local now = deps.now()
	local spec = LobbyRules.take_spec(n, uids, now, o.id, o.mode)
	local open = self:_open(now, o.mode)
	local ids = {}
	for _, l in open do
		table.insert(ids, l.id)
	end
	spec.candidates = ids
	local ok, v = false, nil
	for attempt = 1, LobbyDirectory.JOIN_TRIES do
		ok, v = pcall(deps.store.take, spec)
		if ok then
			break
		end
		if attempt < LobbyDirectory.JOIN_TRIES then
			local wait = deps.wait or task.wait
			wait(0.15 + deps.rand() * 0.4 * attempt)
		end
	end
	local l: LobbyRules.Lobby? = nil
	if ok then
		l = LobbyRules.decode(v)
		if l == nil then
			return false, LobbyDirectory.NO_ROOM, nil
		end
	else
		-- depoya ulaşılamıyor: bu sunucunun listesinde yeri olan en yakın lobi (maç sunucusu gelenleri sayar ve kaydı düzeltir)
		for _, c in open do
			if LobbyRules.fits(c, spec) and c.code ~= nil then
				c.players += n
				l = table.clone(c)
				break
			end
		end
		if l == nil then
			self:_log("join failed: " .. tostring(v))
			return false, LobbyDirectory.UNREACHABLE, nil
		end
		self:_log("join without a reservation (store busy): " .. tostring(v))
	end
	local lobby = l :: LobbyRules.Lobby
	local function give_back()
		if ok then
			pcall(deps.store.release, lobby.id, uids)
		end
	end
	if lobby.code == nil then
		give_back()
		return false, "That match is gone.", nil
	end
	if o.wanted ~= nil and not o.wanted() then
		give_back()
		return false, "cancelled", lobby
	end
	local sent, terr = deps.teleport.send(players, lobby.code, { lobby = lobby.id, map = lobby.map, party = o.party })
	if not sent then
		give_back()
		return false, terr or "The teleport failed. Try again.", lobby
	end
	-- koltukları burada da işle: liste hemen göstersin
	for _, c in self._lobbies do
		if c.id == lobby.id then
			c.players = lobby.players
		end
	end
	return true, nil, lobby
end

--- `uids`'in `id` lobisindeki koltuklarını geri verir (başladıktan sonra başarısız olan ışınlanma). Bekler.
function LobbyDirectory.release(self: any, id: string, uids: { string }): number
	local ok, res, n = pcall(self.deps.store.release, id, uids)
	if not ok then
		self:_log("release failed: " .. tostring(res))
		return 0
	end
	return tonumber(n) or 0
end

--- Oyuncuyu koltuk sırasına alır; anahtar başına bir kayıt (yenisi eskisinin yerine geçer).
function LobbyDirectory.enqueue(self: any, e: QueueEntry)
	self:dequeue(e.key)
	table.insert(self._queue, e)
end

--- `key`'i sıradan çıkarır (sıradaysa true). `done` çağrılmaz.
function LobbyDirectory.dequeue(self: any, key: string): boolean
	for i, e in self._queue do
		if e.key == key then
			table.remove(self._queue, i)
			return true
		end
	end
	return false
end

function LobbyDirectory.queued(self: any, key: string): QueueEntry?
	for _, e in self._queue do
		if e.key == key then
			return e
		end
	end
	return nil
end

function LobbyDirectory.queue_size(self: any): number
	return #self._queue
end

--- Sıra üzerinden bir geçiş: en eski önce, en çok QUEUE_BATCH depo çağrısı; bir türde yer yoksa bu geçişte o türden
--- başkası denenmez. Bekler.
function LobbyDirectory.serve_queue(self: any)
	local now = self.deps.now()
	local calls = 0
	local full: { [string]: boolean } = {}
	for _, e in table.clone(self._queue) do
		if calls >= LobbyDirectory.QUEUE_BATCH then
			break
		end
		if self:queued(e.key) ~= e then
			continue -- (bu arada sıradan çıktı)
		end
		local kind = e.mode or LobbyRules.MODE_FFA
		if full[kind] then
			continue
		end
		if now - e.since > LobbyDirectory.QUEUE_MAX_S then
			self:dequeue(e.key)
			e.done(false, "timeout", nil)
			continue
		end
		local players = e.members()
		if players == nil or #players == 0 then
			self:dequeue(e.key)
			e.done(false, "gone", nil)
			continue
		end
		calls += 1
		local ok, reason, l = self:join(players, {
			mode = e.mode,
			party = if e.party then e.party() else nil,
			wanted = function(): boolean
				return self:queued(e.key) == e
			end,
		})
		if ok then
			self:dequeue(e.key)
			e.done(true, nil, l, players)
		elseif reason == LobbyDirectory.NO_ROOM then
			full[kind] = true
		elseif reason ~= "cancelled" then
			self:dequeue(e.key)
			e.done(false, reason, l, players)
		end
	end
end

--- Her kare: sırayı her QUEUE_RETRY_S'de bir işler (kendi iş parçacığında).
function LobbyDirectory.tick_queue(self: any, dt: number, spawn: ((() -> ()) -> ())?)
	self._queue_in -= dt
	if self._queue_in > 0 or self._queue_busy or #self._queue == 0 then
		return
	end
	self._queue_in = LobbyDirectory.QUEUE_RETRY_S
	self._queue_busy = true
	local run = function()
		local ok, err = pcall(self.serve_queue, self)
		if not ok then
			self:_log("queue failed: " .. tostring(err))
		end
		self._queue_busy = false
	end
	if spawn then
		spawn(run)
	else
		run()
	end
end

return LobbyDirectory
]]></ProtectedString>
