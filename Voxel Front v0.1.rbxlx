						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">1c14f2467dd4fbf50afa546d00013921</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX51A1EB71EF0E4A5CAD00157FF73AFFD1">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- FloatText: haritada saldırı / genişleme / gemi gönderilince tıklanan yerin biraz üstünde beliren kısa onay
-- ("Attacking Brazil with 24.5K"). Hap biçimli koyu kutu, kenarı onayın renginde; büyüyerek belirir, yukarı süzülür ve
-- kaybolur. Üst barın altında, alt barın üstünde kalır (bounds). PC'de ve mobilde aynı.
-- RoWorld src/client/UI/FloatText.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.): ölçüler, renk ve zamanlamalar onunki.
--
--   FloatText.spawn(parent, x, y, text, icon?, color)   x, y: mutlak ekran noktası (tıklanan yer)
--   FloatText.bounds = function() -> (left, top, right, bottom)  (mutlak; her karede yeniden okunur)

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Fonts = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Fonts"))

local FloatText = {}

FloatText.bounds = nil :: (() -> (number, number, number, number))?

FloatText.GREEN = Color3.new(0.37, 0.89, 0.6) -- genişleme (sahipsiz toprak)
FloatText.AMBER = Color3.new(1.0, 0.71, 0.278) -- saldırı
FloatText.CYAN = Color3.new(0.31, 0.82, 1.0) -- gemiyle

local GAP = 22 -- tıklanan yerle kutunun alt kenarı arası
local RISE = 26 -- süzülme
local EDGE = 8 -- alanın kenarından en az

function FloatText.spawn(parent: GuiBase2d, x: number, y: number, text: string, icon: string?, color: Color3)
	if text == "" then
		return
	end
	local pill = Instance.new("Frame")
	pill.Name = "FloatText"
	pill.AnchorPoint = Vector2.new(0.5, 1)
	pill.AutomaticSize = Enum.AutomaticSize.XY
	pill.Size = UDim2.new()
	pill.BackgroundColor3 = Color3.new(0.03, 0.045, 0.1)
	pill.BackgroundTransparency = 1
	pill.BorderSizePixel = 0
	pill.Active = false
	pill.ZIndex = 90
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = pill
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = color
	stroke.Thickness = 1
	stroke.Transparency = 1
	stroke.Parent = pill
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)
	pad.PaddingTop = UDim.new(0, 5)
	pad.PaddingBottom = UDim.new(0, 5)
	pad.Parent = pill
	local row = Instance.new("UIListLayout")
	row.FillDirection = Enum.FillDirection.Horizontal
	row.VerticalAlignment = Enum.VerticalAlignment.Center
	row.SortOrder = Enum.SortOrder.LayoutOrder
	row.Padding = UDim.new(0, 7)
	row.Parent = pill
	local labels: { TextLabel } = {}
	local function label(t: string, size: number, c: Color3, order: number)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.AutomaticSize = Enum.AutomaticSize.XY
		l.Size = UDim2.new()
		l.FontFace = Font.fromId(Fonts.ID, Enum.FontWeight.Bold)
		l.TextSize = size
		l.TextColor3 = c
		l.TextTransparency = 1
		l.Text = t
		l.LayoutOrder = order
		l.ZIndex = 91
		l.Parent = pill
		table.insert(labels, l)
	end
	if icon ~= nil and icon ~= "" then
		label(icon, 14, color, 1)
	end
	label(text, 13, color:Lerp(Color3.new(1, 1, 1), 0.35), 2)
	local scale = Instance.new("UIScale")
	scale.Scale = 0.85
	scale.Parent = pill
	local alpha = Instance.new("NumberValue") -- 0..1 görünürlük
	local rise = Instance.new("NumberValue")
	local function place()
		local origin = parent.AbsolutePosition
		local sz = pill.AbsoluteSize
		local left, top, right, bottom = origin.X, origin.Y, origin.X + parent.AbsoluteSize.X, origin.Y + parent.AbsoluteSize.Y
		if FloatText.bounds then
			local ok, l, t, r, b = pcall(FloatText.bounds)
			if ok and type(l) == "number" and r > l then
				left, top, right, bottom = l, t, r, b
			end
		end
		local cx = math.clamp(x, left + EDGE + sz.X / 2, math.max(left + EDGE + sz.X / 2, right - EDGE - sz.X / 2))
		local by = math.clamp(y - GAP - rise.Value, top + EDGE + sz.Y, math.max(top + EDGE + sz.Y, bottom - EDGE))
		pill.Position = UDim2.fromOffset(cx - origin.X, by - origin.Y)
		local a = alpha.Value
		pill.BackgroundTransparency = 1 - 0.92 * a
		stroke.Transparency = 1 - 0.55 * a
		for _, l in labels do
			l.TextTransparency = 1 - a
		end
	end
	place()
	pill.Parent = parent
	local conn = RunService.RenderStepped:Connect(place)
	TweenService:Create(alpha, TweenInfo.new(0.12), { Value = 1 }):Play()
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(rise, TweenInfo.new(1.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { Value = RISE }):Play()
	task.delay(1.05, function()
		TweenService:Create(alpha, TweenInfo.new(0.45), { Value = 0 }):Play()
	end)
	task.delay(1.52, function()
		conn:Disconnect()
		pill:Destroy()
		alpha:Destroy()
		rise:Destroy()
	end)
end

return FloatText
]]></ProtectedString>
