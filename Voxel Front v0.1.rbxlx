					<Item class="ModuleScript" referent="RBXDF386C06D62D43BC9266ABF2B9D9009A">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Train: tren (OpenFront TrainExecution + TrainStation durak kuralları).
--   * Kaynak fabrika istasyonundan hedef istasyona, kümedeki istasyon zinciri boyunca ray tile'larını izler; tick başına 2 tile.
--   * Her durakta (şehir / liman) altın: tren sahibi ile durak sahibi ayrıysa İKİSİ de alır; aynıysa bir kez.
--       altın = max(5000, taban - 5000 x max(0, ticaret durak sayısı - 9)); taban: kendi 10K, müttefik 35K, diğer 25K.
--     Fabrika durağından altın yok (ama durak sayılmaz).
--   * Sıradaki durak yıkılırsa ya da ticarete kapanırsa (ambargo) tren yok olur.
--   * Görüntü: istemci yolu (tile listesi) bir kez alır, lokomotifi/vagonları saat ile o yolda ilerletir.

local Train = {}
Train.__index = Train

export type Train = typeof(setmetatable(
	{} :: {
		kind: string,
		id: number,
		pid: number,
		src: any,
		dst: any,
		path: { number },
		stops: { { idx: number, station: any } },
		nextStop: number,
		pos: number,
		visited: number,
		done: boolean,
	},
	Train
))

local nextId = 500000

function Train.new(pid: number, src: any, dst: any): Train
	nextId += 1
	return setmetatable({
		kind = "train",
		id = nextId,
		pid = pid,
		src = src,
		dst = dst,
		path = {},
		stops = {},
		nextStop = 1,
		pos = 1,
		visited = 0,
		done = false,
	}, Train)
end

local function pushFx(sim: any, e: any)
	local l = sim.fx
	if not l then
		l = {}
		sim.fx = l
	end
	table.insert(l, e)
end

function Train.finish(self: Train, sim: any)
	if self.done then
		return
	end
	self.done = true
	sim.trainCount = math.max(0, sim.trainCount - 1)
	pushFx(sim, { k = "trainEnd", id = self.id })
end

function Train.init(self: Train, sim: any)
	self.done = true
	local Rail = sim.parts.Rail
	if self.src.dead or self.dst.dead then
		return
	end
	local stations = Rail.findStationsPath(self.src, self.dst)
	if not stations or #stations < 2 then
		return
	end
	local path: { number } = {}
	local stops = {}
	for i = 1, #stations - 1 do
		local a, b = stations[i], stations[i + 1]
		local rail = a.nbr[b]
		if not rail then
			return
		end
		local tiles = rail.tiles
		if rail.from == a then
			for k = (if i == 1 then 1 else 2), #tiles do
				path[#path + 1] = tiles[k]
			end
		else
			for k = (if i == 1 then #tiles else #tiles - 1), 1, -1 do
				path[#path + 1] = tiles[k]
			end
		end
		stops[#stops + 1] = { idx = #path, station = b }
	end
	if #path < 2 then
		return
	end
	self.path = path
	self.stops = stops
	self.done = false
	sim.trainCount += 1
	pushFx(sim, { k = "trainStart", id = self.id, pid = self.pid, pts = path })
end

local function relation(sim: any, a: number, b: number): string
	if a == b then
		return "self"
	elseif sim.parts.Diplomacy.isAllied(sim, a, b) then
		return "ally"
	end
	return "other"
end

local function stationReached(self: Train, sim: any, station: any)
	local st = station.st
	if st.type ~= "city" and st.type ~= "port" then
		return
	end
	local gold = sim.parts.Rail.trainGold(sim.cfg, relation(sim, self.pid, st.pid), self.visited)
	sim:addGold(self.pid, gold, st.tile)
	if st.pid ~= self.pid then
		sim:addGold(st.pid, gold, st.tile)
	end
	self.visited += 1
end

function Train.tick(self: Train, sim: any)
	if self.done then
		return
	end
	local stop = self.stops[self.nextStop]
	if not stop or not sim.alive[self.pid] then
		self:finish(sim)
		return
	end
	-- sıradaki durak yıkıldı ya da ticarete kapandı
	if stop.station.dead or not sim.parts.Rail.tradeAvailable(sim, stop.station, self.pid) then
		self:finish(sim)
		return
	end
	self.pos += sim.cfg.TRAIN_SPEED
	while stop and self.pos >= stop.idx do
		stationReached(self, sim, stop.station)
		self.nextStop += 1
		stop = self.stops[self.nextStop]
		if stop and (stop.station.dead or not sim.parts.Rail.tradeAvailable(sim, stop.station, self.pid)) then
			self:finish(sim)
			return
		end
	end
	if not stop then
		self:finish(sim)
	end
end

return Train
]]></ProtectedString>
							<string name="ScriptGuid">{6E7F8E36-7C44-4F8B-8227-691EFDCBE159}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Train</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">15474ccd123c712a0af50f5100000e06</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXEF91369F98314A6CA6C0DBBA8B8E5719">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Tribe: bot davranışı (OpenFront'taki "tribe" botlarının kendi yazımı).
--   * Her bot kendi aralığında (40-80 tick) karar verir; ilk kararında sahipsiz topraktan saldırır.
--   * Sahipsiz toprak komşusu olduğu sürece oraya genişler (evde %10-20 asker bırakır).
--   * Asker, tavanın %50-60'ına gelince oyunculara/botlara saldırır; üzerine saldırana önce karşılık verir.
--   * Komşu insan oyuncuya saldırma kararı %50 ihtimalle atlanır; botlara her zaman saldırır.
--   * Oyuncuya saldırırken evde %30-40 asker bırakır.
-- Ulusların rastgele deniz saldırıları NationNaval'da; küçük botların yakın boş arazi açılımı Naval'da.

local Tribe = {}
Tribe.__index = Tribe

export type Tribe = typeof(setmetatable(
	{} :: {
		kind: string,
		pid: number,
		done: boolean,
		rng: any,
		attackRate: number,
		attackTick: number,
		trigger: number,
		reserve: number,
		expand: number,
		started: boolean,
		neighborsTN: boolean,
		nb: { number },
		placements: number,
	},
	Tribe
))

function Tribe.new(pid: number): Tribe
	return setmetatable({
		kind = "tribe",
		pid = pid,
		done = false,
		rng = nil :: any,
		attackRate = 60,
		attackTick = 0,
		trigger = 0.55,
		reserve = 0.35,
		expand = 0.15,
		started = false,
		neighborsTN = true,
		nb = {},
		placements = 0,
	}, Tribe)
end

function Tribe.init(self: Tribe, sim: any)
	local cfg = sim.cfg
	local rng = sim.parts.Rng.new(self.pid * 7919 + 13)
	self.rng = rng
	local rate = if sim.isNation[self.pid] then cfg.NATION_ATTACK_RATE else cfg.BOT_ATTACK_RATE
	self.attackRate = rng:int(rate[1], rate[2] - 1)
	self.attackTick = rng:int(0, self.attackRate - 1)
	self.trigger = rng:int(cfg.BOT_TRIGGER_RATIO[1], cfg.BOT_TRIGGER_RATIO[2] - 1) / 100
	self.reserve = rng:int(cfg.BOT_RESERVE_RATIO[1], cfg.BOT_RESERVE_RATIO[2] - 1) / 100
	self.expand = rng:int(cfg.BOT_EXPAND_RATIO[1], cfg.BOT_EXPAND_RATIO[2] - 1) / 100
end

-- Sınırdaki komşuları: oyuncu pid listesi ve sahipsiz kara komşusu var mı.
local function scanNeighbors(self: Tribe, sim: any): ({ number }, boolean, { number })
	local world = sim.world
	local seen: { [number]: boolean } = {}
	local list: { number } = {}
	local tn = false
	for t in world:borderOf(self.pid) do
		local n = world:neighbors(t, self.nb)
		for k = 1, n do
			local u = self.nb[k]
			local o = world:ownerAt(u)
			if o ~= self.pid then
				if o == 0 then
					if world:isLand(u) then
						tn = true
					end
				elseif not seen[o] and sim.alive[o] then
					seen[o] = true
					list[#list + 1] = o
				end
			end
		end
	end
	table.sort(list) -- sözlük gezme sırası belirsiz; sıralayıp deterministik yapılır
	-- Müttefikler saldırı listesinden ayrılır.
	local friends: { number } = {}
	local enemies: { number } = {}
	for _, o in list do
		if sim.parts.Diplomacy.isAllied(sim, self.pid, o) then
			friends[#friends + 1] = o
		else
			enemies[#enemies + 1] = o
		end
	end
	return enemies, tn, friends
end

local function sendAttack(self: Tribe, sim: any, target: number, neighborList: { number }, hasTN: boolean): boolean
	if target == 0 then
		if not hasTN then
			return false
		end
	else
		if table.find(neighborList, target) == nil then
			return false -- bu yardımcı kara saldırısı içindir; ulusların deniz kararı NationNaval'da
		end
	end
	local troops = sim.troops[self.pid]
	local maxT = sim:maxTroopsOf(self.pid)
	local keep = maxT * (if target == 0 then self.expand else self.reserve)
	local amount = troops - keep
	if amount < 1 or troops <= 0 then
		return false
	end
	sim:addExecution(sim.parts.Attack.new(self.pid, target, math.min(amount / troops, 1)))
	return true
end

local function largestIncoming(self: Tribe, sim: any): number?
	local best, who = 0, nil
	for _, a in sim.attackIndex do
		if a.target == self.pid and a.troops > best and sim.alive[a.pid] then
			best, who = a.troops, a.pid
		end
	end
	return who
end

function Tribe.tick(self: Tribe, sim: any)
	if not sim.alive[self.pid] then
		self.done = true
		return
	end
	local attract = sim.attract ~= nil -- menü arkasındaki maç: yalnız kara savaşı (yapı, gemi, bomba, diplomasi yok)
	if sim.phase == "run" and sim.isNation[self.pid] and not attract then
		local off = (sim.tickNo - self.attackTick) % self.attackRate
		if off == 0 or off == self.attackRate // 3 or off == (self.attackRate * 2) // 3 then
			sim.parts.Nation.structures(self, sim)
			sim.parts.Diplomacy.nationRespond(sim, self.rng, self.pid)
		end
	end
	if sim.phase ~= "run" or sim.tickNo % self.attackRate ~= self.attackTick then
		return
	end

	local neighbors, hasTN, friends = scanNeighbors(self, sim)
	if sim.isNation[self.pid] and not attract then
		sim.parts.Nation.warshipSpawn(self, sim)
		sim.parts.Nation.nuke(self, sim)
	end
	-- Kara komşusu yoksa gemiyle sahipsiz toprağa açılır (repo: bot kıyıdan ~5 tile ötesini hedefler).
	if not attract and not sim.isNation[self.pid] and #neighbors == 0 and not hasTN and self.started and (sim.boatCount[self.pid] or 0) < sim.cfg.BOAT_MAX then
		local ratio0 = sim.troops[self.pid] / math.max(sim:maxTroopsOf(self.pid), 1)
		if ratio0 >= self.trigger then
			local target = sim.parts.Naval.expansionTarget(sim.world, self.pid)
			if target then
				sim:addExecution(sim.parts.Boat.new(self.pid, target, self.expand))
			end
		end
		return
	end
	if not self.started then
		self.started = true
		if not sim.isNation[self.pid] then
			sendAttack(self, sim, 0, neighbors, hasTN)
			return
		end
	end

	if self.neighborsTN or (sim.isNation[self.pid] and hasTN) then
		if hasTN then
			if sendAttack(self, sim, 0, neighbors, hasTN) then
				return
			end
		else
			self.neighborsTN = false
		end
	end

	if not attract and sim.isNation[self.pid] and sim.parts.NationNaval.maybeAttack(self, sim, neighbors) then return end
	if not attract and sim.isNation[self.pid] then
		local D = sim.parts.Diplomacy
		-- Müttefiki bozup saldırmak (Medium kuralları)
		local betrayed = D.nationBetray(sim, self.pid, friends, neighbors)
		if betrayed then
			sendAttack(self, sim, betrayed, { betrayed }, hasTN)
			return
		end
		D.nationSend(sim, self.rng, self.pid, neighbors)
	end

	-- Saldırıya hazır mı?
	local ratio = sim.troops[self.pid] / math.max(sim:maxTroopsOf(self.pid), 1)
	if ratio < self.trigger then
		return
	end
	local attacker = largestIncoming(self, sim)
	if attacker and sendAttack(self, sim, attacker, neighbors, hasTN) then
		return
	end
	-- rastgele sırayla komşular
	for i = #neighbors, 2, -1 do
		local j = self.rng:int(1, i)
		neighbors[i], neighbors[j] = neighbors[j], neighbors[i]
	end
	for _, n in neighbors do
		local humanLike = not sim.isBot[n] or sim.isNation[n]
		if humanLike and self.rng:int(0, 1) == 0 then
			continue
		end
		if sendAttack(self, sim, n, neighbors, hasTN) then
			return
		end
	end
end

return Tribe
]]></ProtectedString>
							<string name="ScriptGuid">{A5B5AD75-1A8E-41F4-89C8-2981D32EFD2F}</string>
