				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Profile: oyuncunun kalıcı küçük kaydı (DataStore "frontline_profile", anahtar "u<UserId>"):
--   { tutorial = "started" | "done" | "skipped" | nil, matches = başladığı maç sayısı, tips = { [ipucu]: true } }
-- Gelişte okunur (3 deneme); oyuncu öznitelikleri:
--   FrontlineNew = true: hiç oynamamış yeni oyuncu (ilk solo maçı tutorial olur: Client.Tutorial) | false
--   FrontlineMatches = şimdiye dek başladığı maç sayısı (ilk 5 maçta saldırılar evde asker bırakır: Client)
--   FrontlineTips = görülmüş Coach ipuçları, virgülle (Client.Coach her ipucunu oyuncuya bir kez gösterir)
-- Kayıt okunamazsa FrontlineNew = false (eski oyuncuya tutorial açılmasın) ve bu oturumda kayıt yazılmaz.
-- Tutorial "started" ancak oyuncu başlangıç yerini seçince yazılır: yüklenemeyip çıkan (yavaş telefon) sonraki girişte yine
-- tutorial alır.
-- İstemci -> sunucu (ReplicatedStorage.FrontlineProfile, RemoteEvent):
--   ("tutorial", step)          "Tutorial" hunisinin adımı (Profile.FUNNEL; her oynayışta her adım bir kez: Telemetry.funnel)
--   ("tutorialEnd", how, step)  "done" | "skipped" (skipped: TutorialSkipped olayı, değer = kaldığı adım)
--   ("tip", id)                 bir Coach ipucu görüldü (Profile.TIPS)
--   ("match")                   bir maç başladı (sayaç; MATCH_GAP_S'de en çok bir). İstemci artık göndermez: maçları
--                               Server.Analytics sayar (Profile.countMatch; solo ve online her maç).
-- Studio: workspace özniteliği DevTutorial = true ise herkes yeni sayılır (deneme için).
-- RoWorld src/server/Analytics.luau'daki Tutorial hunisinden uyarlandı (AGPL-3.0, © 2026 Snick Co.).

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Telemetry = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Telemetry"))

local Profile = {}

Profile.STORE = "frontline_profile"
Profile.REMOTE = "FrontlineProfile"
--- "Tutorial" hunisinin adımları (Client.Tutorial aynı sırayla bildirir).
Profile.FUNNEL = { "Started", "Spawned", "First Tap", "Grew", "Attacked", "Used Slider", "Built City", "Completed" }
Profile.MATCH_GAP_S = 10
--- Client.Coach'un bir kez gösterilen ipuçları (başka ad kaydedilmez).
Profile.TIPS = { expand = true, ratio = true, city = true, contact = true, boat = true, select = true, attacked = true }

local function tipList(tips: any): string
	local out = {}
	if type(tips) == "table" then
		for id, on in tips do
			if on == true and Profile.TIPS[id] then
				table.insert(out, id)
			end
		end
	end
	table.sort(out)
	return table.concat(out, ",")
end
--- Maç sayacı (Profile.start kurar): oyuncunun bu maçtan önceki maç sayısını döner ve sayacı artırır.
Profile.countMatch = function(_p: Player): number
	return 0
end

local function key(p: Player): string
	return "u" .. tostring(p.UserId)
end

function Profile.start()
	if ReplicatedStorage:FindFirstChild(Profile.REMOTE) then
		return
	end
	local remote = Instance.new("RemoteEvent")
	remote.Name = Profile.REMOTE
	remote.Parent = ReplicatedStorage
	local okStore, store = pcall(function()
		-- (Server.DsGate: sunucunun DataStore bütçesine göre bekler, sınıra takılan isteği yeniden dener)
		return require(script.Parent:WaitForChild("DsGate")).wrap(DataStoreService:GetDataStore(Profile.STORE))
	end)
	local loaded: { [Player]: boolean } = {}
	local runs: { [Player]: { id: string, steps: { [number]: boolean } } } = {}
	local lastMatch: { [Player]: number } = {}

	-- kayıt değişikliği (UpdateAsync, 3 deneme); kayıt okunamamış oyuncuya yazılmaz
	local function update(p: Player, change: (any) -> ())
		if not okStore or not loaded[p] or p.UserId <= 0 then
			return
		end
		task.spawn(function()
			for attempt = 1, 3 do
				local ok = pcall(function()
					(store :: any):UpdateAsync(key(p), function(old: any)
						local d = if type(old) == "table" then old else {}
						change(d)
						return d
					end)
				end)
				if ok then
					return
				end
				task.wait(attempt * 2)
			end
		end)
	end

	local function arrive(p: Player)
		local ok, data = false, nil
		if okStore and p.UserId > 0 then
			for attempt = 1, 3 do
				ok, data = pcall(function()
					return (store :: any):GetAsync(key(p))
				end)
				if ok or p.Parent == nil then
					break
				end
				task.wait(attempt * 2)
			end
		end
		if p.Parent == nil then
			return
		end
		local d = if ok and type(data) == "table" then data else {}
		loaded[p] = ok
		local matches = tonumber(d.matches) or 0
		local isNew = ok and d.tutorial == nil and matches == 0
		if RunService:IsStudio() and workspace:GetAttribute("DevTutorial") == true then
			isNew = true
		end
		p:SetAttribute("FrontlineMatches", matches)
		p:SetAttribute("FrontlineTips", tipList(d.tips))
		p:SetAttribute("FrontlineNew", isNew)
	end
	Players.PlayerAdded:Connect(function(p: Player)
		task.spawn(arrive, p)
	end)
	for _, p in Players:GetPlayers() do
		task.spawn(arrive, p)
	end
	Profile.countMatch = function(p: Player): number
		local before = tonumber(p:GetAttribute("FrontlineMatches")) or 0
		local t = os.clock()
		if t - (lastMatch[p] or -1e9) < Profile.MATCH_GAP_S then
			return math.max(before - 1, 0) -- (az önce sayıldı)
		end
		lastMatch[p] = t
		p:SetAttribute("FrontlineMatches", before + 1)
		update(p, function(d: any)
			d.matches = (tonumber(d.matches) or 0) + 1
		end)
		return before
	end
	Players.PlayerRemoving:Connect(function(p: Player)
		loaded[p] = nil
		runs[p] = nil
		lastMatch[p] = nil
	end)

	remote.OnServerEvent:Connect(function(p: Player, what: any, a: any, b: any)
		if what == "tutorial" then
			local step = tonumber(a)
			if step == nil or step % 1 ~= 0 or Profile.FUNNEL[step] == nil then
				return
			end
			local run = runs[p]
			if step == 1 or run == nil then
				run = { id = HttpService:GenerateGUID(false), steps = {} }
				runs[p] = run
			end
			if run.steps[step] then
				return
			end
			run.steps[step] = true
			Telemetry.funnel(p, "Tutorial", run.id, step, Profile.FUNNEL[step])
			if step == 2 then
				update(p, function(d: any)
					if d.tutorial == nil then
						d.tutorial = "started"
					end
				end)
			end
		elseif what == "tutorialEnd" then
			if a ~= "done" and a ~= "skipped" then
				return
			end
			p:SetAttribute("FrontlineNew", false)
			update(p, function(d: any)
				d.tutorial = a
			end)
			if a == "skipped" then
				Telemetry.count(p, "TutorialSkipped", math.clamp(math.floor(tonumber(b) or 1), 1, #Profile.FUNNEL))
			end
		elseif what == "tip" then
			if type(a) ~= "string" or not Profile.TIPS[a] then
				return
			end
			local have = p:GetAttribute("FrontlineTips")
			local set = {}
			if type(have) == "string" then
				for s in string.gmatch(have, "[^,]+") do
					set[s] = true
				end
			end
			if set[a] then
				return
			end
			set[a] = true
			p:SetAttribute("FrontlineTips", tipList(set))
			update(p, function(d: any)
				if type(d.tips) ~= "table" then
					d.tips = {}
				end
				d.tips[a] = true
			end)
		elseif what == "match" then
			Profile.countMatch(p)
		end
	end)
end

return Profile
]]></ProtectedString>
