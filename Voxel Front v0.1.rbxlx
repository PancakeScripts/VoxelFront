						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Authoritative launch/end events plus full flight snapshots (including late joiners).
local NukeTargets = {}
NukeTargets.__index = NukeTargets
function NukeTargets.new(world: any, cfg: any): any
	return setmetatable({ world = world, cfg = cfg, rings = {} }, NukeTargets)
end
function NukeTargets.remove(self: any, id: number)
	local f = self.rings[id]
	if f then f:Destroy(); self.rings[id] = nil end
end
function NukeTargets.clear(self: any)
	for id in self.rings do self:remove(id) end
end
function NukeTargets.set(self: any, id: number, tile: number, what: string)
	if self.rings[id] then return end
	local r = if what == "atom" then self.cfg.NUKE_ATOM[2] elseif what == "hydro" then self.cfg.NUKE_HYDRO[2] else self.cfg.MIRV_RANGE
	local f = Instance.new("Frame")
	f.Name = "NukeTarget_" .. id
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = self.world:at(tile % self.world.w + 0.5, tile // self.world.w + 0.5)
	f.Size = self.world:size(r * 2, r * 2)
	f.BackgroundColor3 = Color3.fromRGB(239, 40, 40)
	f.BackgroundTransparency = 0.85
	f.BorderSizePixel = 0
	f.Active = false
	f.ZIndex = 6
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = f
	local stroke = Instance.new("UIStroke")
	stroke.Color = f.BackgroundColor3
	stroke.Transparency = 0.15
	stroke.Thickness = 2
	stroke.Parent = f
	f.Parent = self.world.under
	self.rings[id] = f
end
function NukeTargets.sync(self: any, list: { any })
	local seen = {}
	for _, b in list do
		if b.k and b.k >= 4 and type(b.dst) == "number" then
			seen[b.id] = true
			self:set(b.id, b.dst, if b.k == 5 then "hydro" elseif b.k == 6 then "mirv" else "atom")
		end
	end
	for id in self.rings do if not seen[id] then self:remove(id) end end
end
return NukeTargets
]]></ProtectedString>
