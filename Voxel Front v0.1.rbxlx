						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">CosmeticView</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">662b0abb37a5a9fc0b00fc9100005506</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX2119D39B06244DD2A32371C37DAAFF68">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Shop: ana menüdeki SHOP penceresi (StarterGui > FrontlineMenu > ShopCard; Studio'da düzenlenebilir, kod adlara göre bulur).
-- Ürün kartları şablondan (ItemTemplate) kopyalanır; iki satır, sütun sütun dolar (sol üst, altı, sonra sağdaki sütun),
-- sağa taşarsa yatay kayar. Sıra:
--   2X MEDALS game pass (kimliği 0 ya da oyuncuda varsa yok; ana menüdeki 2x düğmesi de oyuncuda varsa gizli)
--   bölge bayrağı (oyuncunun girişteki ülkesi; Medals ile, bir kez)
--   günlük ödül (17 saatte bir 10-50 Medals; alınınca kart kalır, "CLAIMED" ve kalan süre; ana menüdeki Shop düğmesinin
--     FREE! yazısı (Label2) yalnız alınabilirken görünür)
--   günün bayrakları (Shared.ShopFlags: 1 Legendary + 3 Epic, oyuncunun sahip olmadıklarından; UTC 00:00'da yenilenir;
--     Robux ya da Medals ile)
--   Medal paketleri (500 / 1,500 / 4,000 / 10,000; Robux ile).
-- Düğmeler: Robux yeşil, çentikli, solda (Robux simgesi + fiyat); Medals gri, sağda. Sonuçlar bildirimle (Client.Toast):
-- olumlu yeşil + ödül sesi (Assets.Sounds.reward; boşsa crateReveal), olumsuz kırmızı + error sesi. Robux satın almalarının
-- (kasa, solo ürünleri dahil) bittiği de buradan bildirilir. RoWorld src/client/UI/FlagShop.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.).
-- Satın alma hunisi: pencere açılınca "open", Robux penceresi açılmadan önce "click" (Server.Wallet).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared:WaitForChild("Assets"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local ShopFlags = require(Shared:WaitForChild("ShopFlags"))
local Crates = require(script.Parent:WaitForChild("Crates")) -- (Robux fiyatları: Crates.priceOf)
local ButtonDepth = require(script.Parent:WaitForChild("ButtonDepth"))
local Toast = require(script.Parent:WaitForChild("Toast"))

local ORANGE = Color3.fromRGB(255, 181, 71) -- (ana menüdeki Play Solo düğmesinin rengi)
local DARK_TEXT = Color3.fromRGB(20, 14, 4)
local PACKS = {
	{ key = "medals_small", amount = 500 },
	{ key = "medals_medium", amount = 1500 },
	{ key = "medals_large", amount = 4000 },
	{ key = "medals_huge", amount = 10000 },
}

--- Ödül sesi: Assets.Sounds.reward, boşsa kasa açılışının bitiş sesi.
local function rewardSound(): string
	return if Assets.has((Assets.Sounds :: any).reward) then "reward" else "crateReveal"
end

local Shop = {}
Shop.__index = Shop
Shop.rewardSound = rewardSound

local GREEN = Color3.fromRGB(22, 163, 74)
local GREY = Color3.fromRGB(51, 65, 85)
local WHITE = Color3.new(1, 1, 1)

local function commas(n: number): string
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

local function clock(s: number): string
	s = math.max(0, math.floor(s))
	return string.format("%02d:%02d:%02d", s // 3600, (s // 60) % 60, s % 60)
end

function Shop.new(card: Frame, mainButton: GuiButton?, passButton: GuiButton?, close: () -> ())
	local self = setmetatable({}, Shop) :: any
	self.card = card
	self.items = card:WaitForChild("Items") :: ScrollingFrame
	self.template = card:WaitForChild("ItemTemplate") :: Frame
	self.mainButton = mainButton
	self.passButton = passButton
	self.inv = nil :: any
	self.at = os.clock() -- (envanterin geldiği an: geri sayımlar buna göre)
	self.busy = false
	self.cards = {} :: { any }
	;(card:WaitForChild("Close") :: TextButton).Activated:Connect(close)
	local balIcon = card:FindFirstChild("Balance") and card.Balance:FindFirstChild("Icon") :: ImageLabel?
	if balIcon and Assets.has(Assets.Shop.medal) then
		balIcon.Image = Assets.Shop.medal
	end
	-- Medals bakiyesinin sağındaki yeşil "+": mağaza Medal paketlerine kayar
	local add = card:FindFirstChild("Balance") and card.Balance:FindFirstChild("Add") :: TextButton?
	if add then
		add.Activated:Connect(function()
			self:_scrollToPacks()
		end)
	end
	-- ana menüdeki Shop düğmesinin görseli; 2x Medals düğmesinin altında Robux fiyatı
	local shopIcon = mainButton and mainButton:FindFirstChild("Icon") :: ImageLabel?
	if shopIcon and Assets.has(Assets.Shop.shopButton) then
		shopIcon.Image = Assets.Shop.shopButton
	end
	local passId = Assets.GamePasses.medals2x
	local priceRow = passButton and passButton:FindFirstChild("Price") :: Frame?
	if priceRow and type(passId) == "number" and passId ~= 0 then
		local ic = priceRow:FindFirstChild("Icon") :: ImageLabel?
		if ic and Assets.has(Assets.Shop.robux) then
			ic.Image = Assets.Shop.robux
		end
		task.spawn(function()
			local price = Crates.priceOf(passId, Enum.InfoType.GamePass)
			local t = priceRow:FindFirstChild("Text") :: TextLabel?
			if price and t then
				t.Text = tostring(price)
				priceRow.Visible = true
			end
		end)
	end
	-- Robux satın alması bitti (her ürün için tek yerden bildirim)
	local lp = Players.LocalPlayer
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId: number, _productId: number, bought: boolean)
		if userId == lp.UserId and bought then
			Toast.show("Purchase complete!", true, rewardSound())
		end
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(p: Player, _id: number, bought: boolean)
		if p == lp and bought then
			Toast.show("Purchase complete!", true, rewardSound())
		end
	end)
	task.spawn(function()
		local remote = ReplicatedStorage:WaitForChild("FrontlineWallet", 60) :: RemoteEvent?
		local fn = ReplicatedStorage:WaitForChild("FrontlineWalletCall", 60) :: RemoteFunction?
		self.remote = remote
		self.fn = fn
		if remote then
			remote.OnClientEvent:Connect(function(what: any, data: any)
				if what == "inv" and type(data) == "table" then
					self:_set(data)
				end
			end)
		end
		self:_refresh()
	end)
	-- geri sayımlar (saniyede bir): FREE! yazısı, kartlardaki süreler; gün dönünce yeni bayraklar istenir
	task.spawn(function()
		while card.Parent do
			self:_tick()
			task.wait(1)
		end
	end)
	return self
end

function Shop._refresh(self: any)
	local fn = self.fn
	if fn == nil then
		return
	end
	local ok, data = pcall(function()
		return fn:InvokeServer("inv")
	end)
	if ok and type(data) == "table" then
		self:_set(data)
	end
end

function Shop._set(self: any, inv: any)
	if inv.loaded == false and self.inv ~= nil and self.inv.loaded == true then
		return
	end
	local before = self.inv
	self.inv = inv
	self.at = os.clock()
	if self.passButton then
		-- (2x Medals oyuncuda varsa ana menüdeki düğmesi gizli)
		self.passButton.Visible = inv.double ~= true
	end
	local bal = self.card:FindFirstChild("Balance")
	local amount = bal and bal:FindFirstChild("Amount") :: TextLabel?
	if amount then
		amount.Text = commas(tonumber(inv.medals) or 0) .. " Medals"
	end
	-- (kart listesi değiştiyse yeniden kurulur; yoksa yalnız yazılar)
	local function shape(v: any): string
		if v == nil or v.shop == nil then
			return ""
		end
		local ownedFlags = {}
		for _, id in v.shop.flags or {} do
			table.insert(ownedFlags, id .. (if table.find(v.owned or {}, id) then "+" else ""))
		end
		return tostring(v.double) .. "|" .. tostring(v.shop.region) .. "|" .. table.concat(ownedFlags, ",")
	end
	if shape(before) ~= shape(inv) or #self.cards == 0 then
		self:_build()
	else
		self:_tick()
	end
end

--- Medal paketlerinin ilkine yumuşakça kayar.
function Shop._scrollToPacks(self: any)
	local first = self.items:FindFirstChild(PACKS[1].key) :: GuiObject?
	if first == nil then
		return
	end
	local items = self.items
	local x = first.AbsolutePosition.X - items.AbsolutePosition.X + items.CanvasPosition.X - 6
	local maxX = math.max(0, items.AbsoluteCanvasSize.X - items.AbsoluteWindowSize.X)
	local goal = Vector2.new(math.clamp(x, 0, maxX), 0)
	game:GetService("TweenService"):Create(items, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CanvasPosition = goal }):Play()
end

--- Pencere açıldı (Menu).
function Shop.opened(self: any)
	if self.remote then
		self.remote:FireServer("shop", "open", "shop")
	end
	self.items.CanvasPosition = Vector2.zero
	task.spawn(function()
		self:_refresh()
	end)
end

-- Kart kurma -----------------------------------------------------------------------------------

local function setButton(b: TextButton?, text: string?, image: string?, bg: Color3?, fg: Color3?)
	if b == nil then
		return
	end
	b.Visible = text ~= nil
	local label = b:FindFirstChild("Label") :: TextLabel?
	if text then
		if label then
			label.Text = text
		else
			b.Text = text
		end
	end
	if label then
		-- (simge yoksa yazı düğmenin ortasında)
		label.AnchorPoint = Vector2.new(if image then 0 else 0.5, 0.5)
		label.Position = UDim2.fromScale(if image then 0.36 else 0.5, 0.5)
		if fg then
			label.TextColor3 = fg
		end
	end
	local icon = b:FindFirstChild("Icon") :: ImageLabel?
	if icon then
		icon.Visible = image ~= nil
		if image and Assets.has(image) then
			icon.Image = image
		end
	end
	if bg then
		b.BackgroundColor3 = bg
	end
	if fg and label == nil then
		b.TextColor3 = fg
	end
end
Shop.setButton = setButton

--- Düğmenin yazısı (Label varsa onunki).
local function buttonText(b: TextButton): string
	local label = b:FindFirstChild("Label") :: TextLabel?
	return if label then label.Text else b.Text
end

--- Tek düğmeli kartta düğme iki düğmenin yerini kaplar.
local function single(c: Frame, which: string)
	local r = c:FindFirstChild("BuyRobux") :: GuiObject
	local m = c:FindFirstChild("BuyMedals") :: GuiObject
	local left = r.Position
	local right = m.Position.X.Scale + m.Size.X.Scale
	local b = if which == "robux" then r else m
	local other = if which == "robux" then m else r
	other.Visible = false
	b.Position = left
	b.Size = UDim2.new(right - left.X.Scale, 0, b.Size.Y.Scale, b.Size.Y.Offset)
end

function Shop._card(self: any, order: number, kind: string): Frame
	local c = self.template:Clone()
	c.Name = kind
	c.LayoutOrder = order
	c.Visible = true
	c.Parent = self.items
	for _, n in { "BuyRobux", "BuyMedals" } do
		local b = c:FindFirstChild(n) :: GuiObject?
		if b then
			ButtonDepth.add(b)
		end
	end
	return c
end

function Shop._build(self: any)
	for _, c in self.items:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	self.cards = {}
	local inv = self.inv
	if inv == nil or inv.loaded == false then
		return
	end
	local shop = inv.shop or {}
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	-- 2X MEDALS
	local passId = Assets.GamePasses.medals2x
	if type(passId) == "number" and passId ~= 0 and inv.double ~= true then
		local c = self:_card(nextOrder(), "Medals2x")
		;(c:FindFirstChild("Image") :: ImageLabel).Image = Assets.Shop.medals2x
		;(c:FindFirstChild("Title") :: TextLabel).Text = "2X MEDALS"
		;(c:FindFirstChild("Sub") :: TextLabel).Text = "Every match pays double"
		;(c:FindFirstChild("Note") :: TextLabel).Text = "Forever"
		single(c, "robux")
		local b = c:FindFirstChild("BuyRobux") :: TextButton
		setButton(b, "…", Assets.Shop.robux)
		task.spawn(function()
			local price = Crates.priceOf(passId, Enum.InfoType.GamePass)
			if price and b.Parent then
				setButton(b, tostring(price), Assets.Shop.robux)
			end
		end)
		b.Activated:Connect(function()
			if self.remote then
				self.remote:FireServer("shop", "click", "medals2x")
			end
			MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, passId)
		end)
		table.insert(self.cards, { kind = "pass", frame = c })
	end
	-- bölge bayrağı
	local rf = Cosmetics.item(shop.region)
	if rf then
		local c = self:_card(nextOrder(), "Region")
		Cosmetics.paint(c:FindFirstChild("Image") :: ImageLabel, rf)
		;(c:FindFirstChild("Title") :: TextLabel).Text = rf.name
		;(c:FindFirstChild("Sub") :: TextLabel).Text = "Your country's flag"
		;(c:FindFirstChild("Note") :: TextLabel).Text = "Shown next to your name"
		single(c, "medals")
		local b = c:FindFirstChild("BuyMedals") :: TextButton
		setButton(b, commas(ShopFlags.REGION_PRICE), Assets.Shop.medal)
		b.Activated:Connect(function()
			self:_call(b, "buyRegion")
		end)
		table.insert(self.cards, { kind = "region", frame = c })
	end
	-- günlük ödül
	do
		local c = self:_card(nextOrder(), "Daily")
		local img = if Assets.has(Assets.Shop.dailyReward) then Assets.Shop.dailyReward else Assets.Shop.medal
		;(c:FindFirstChild("Image") :: ImageLabel).Image = img
		;(c:FindFirstChild("Title") :: TextLabel).Text = "DAILY REWARD"
		-- (vereceği miktar: "24 Medals", solunda küçük Medal simgesi)
		local sub = c:FindFirstChild("Sub") :: TextLabel
		sub.Text = string.format("%d Medals", tonumber(shop.dailyAmount) or 0)
		local si = c:FindFirstChild("SubIcon") :: ImageLabel?
		if si then
			si.Image = Assets.Shop.medal
			si.Visible = true
			sub.Position = UDim2.new(sub.Position.X.Scale + 0.095, 0, sub.Position.Y.Scale, 0)
			sub.Size = UDim2.new(sub.Size.X.Scale - 0.095, 0, sub.Size.Y.Scale, 0)
		end
		single(c, "medals")
		local b = c:FindFirstChild("BuyMedals") :: TextButton
		b.Activated:Connect(function()
			self:_call(b, "claimDaily")
		end)
		table.insert(self.cards, { kind = "daily", frame = c, button = b })
	end
	-- günün bayrakları
	for _, id in shop.flags or {} do
		local it = Cosmetics.item(id)
		if it and it.shop then
			local price = (ShopFlags.PRICES :: any)[it.rarity]
			local r = Cosmetics.rarity(it.rarity)
			local c = self:_card(nextOrder(), "Flag_" .. it.key)
			Cosmetics.paint(c:FindFirstChild("Image") :: ImageLabel, it)
			;(c:FindFirstChild("Title") :: TextLabel).Text = it.name
			local sub = c:FindFirstChild("Sub") :: TextLabel
			sub.Text = string.upper(r.name) .. " · TODAY ONLY"
			sub.TextColor3 = r.color
			local st = c:FindFirstChild("Rarity") :: UIStroke?
			if st then
				st.Color = r.color
			end
			local owned = table.find(inv.owned or {}, id) ~= nil
			local rb = c:FindFirstChild("BuyRobux") :: TextButton
			local mb = c:FindFirstChild("BuyMedals") :: TextButton
			;(c:FindFirstChild("Owned") :: TextLabel).Visible = owned
			local productId = (Assets.Products :: any)[price.product] or 0
			if owned then
				rb.Visible = false
				mb.Visible = false
			else
				setButton(mb, commas(price.medals), Assets.Shop.medal)
				if productId == 0 then
					single(c, "medals")
				else
					setButton(rb, tostring(price.robux), Assets.Shop.robux)
					task.spawn(function()
						local p = Crates.priceOf(productId)
						if p and rb.Parent then
							setButton(rb, tostring(p), Assets.Shop.robux)
						end
					end)
					rb.Activated:Connect(function()
						if self.fn == nil then
							return
						end
						pcall(function()
							self.fn:InvokeServer("flagIntent", id)
						end)
						if self.remote then
							self.remote:FireServer("shop", "click", price.product)
						end
						MarketplaceService:PromptProductPurchase(Players.LocalPlayer, productId)
					end)
				end
				mb.Activated:Connect(function()
					self:_call(mb, "buyFlag", id)
				end)
			end
			table.insert(self.cards, { kind = "flag", frame = c })
		end
	end
	-- Medal paketleri (Robux ile)
	for _, pack in PACKS do
		local productId = (Assets.Products :: any)[pack.key] or 0
		if productId ~= 0 then
			local c = self:_card(nextOrder(), pack.key)
			;(c:FindFirstChild("Image") :: ImageLabel).Image = (Assets.ShopImages :: any)[pack.key] or ""
			;(c:FindFirstChild("Title") :: TextLabel).Text = commas(pack.amount) .. " MEDALS"
			;(c:FindFirstChild("Sub") :: TextLabel).Text = "Medal pack"
			;(c:FindFirstChild("Note") :: TextLabel).Text = "Spend them in the shop"
			single(c, "robux")
			local b = c:FindFirstChild("BuyRobux") :: TextButton
			setButton(b, "…", Assets.Shop.robux)
			task.spawn(function()
				local p = Crates.priceOf(productId)
				if p and b.Parent then
					setButton(b, tostring(p), Assets.Shop.robux)
				end
			end)
			b.Activated:Connect(function()
				if self.remote then
					self.remote:FireServer("shop", "click", pack.key)
				end
				MarketplaceService:PromptProductPurchase(Players.LocalPlayer, productId)
			end)
			table.insert(self.cards, { kind = "pack", frame = c })
		end
	end
	self:_tick()
end

--- Sunucuya bir alışveriş isteği; olmazsa düğmede kısaca nedeni yazar.
function Shop._call(self: any, b: TextButton, what: string, a: any)
	if self.busy or self.fn == nil then
		return
	end
	self.busy = true
	local ok, r1, r2 = pcall(function()
		return self.fn:InvokeServer(what, a)
	end)
	self.busy = false
	if not ok then
		return
	end
	-- (sonuç bildirimle: olumlu yeşil + ödül sesi, olumsuz kırmızı + error sesi)
	if r1 == true then
		if what == "claimDaily" then
			Toast.show(string.format("+%d Medals!", tonumber(r2) or 0), true, rewardSound())
		else
			Toast.show("Flag unlocked and equipped!", true, rewardSound())
		end
	elseif r2 == "not enough" then
		Toast.show("Not enough Medals", false)
	elseif r2 == "not ready" then
		Toast.show("Your daily reward isn't ready yet", false)
	elseif r2 == "owned" or r2 == "bought" then
		Toast.show("You already own this", false)
	elseif r2 ~= "too fast" and r2 ~= "busy" then
		Toast.show("Something went wrong. Try again.", false)
	end
	self:_tick()
end

--- Saniyede bir: geri sayımlar, günlük ödülün düğmesi, FREE! yazısı; gün döndüyse yeni bayraklar.
function Shop._tick(self: any)
	local inv = self.inv
	local shop = inv and inv.shop
	local free = false
	if shop then
		local passed = os.clock() - self.at
		local dailyLeft = (tonumber(shop.dailyIn) or 0) - passed
		local resetLeft = (tonumber(shop.resetIn) or 0) - passed
		free = dailyLeft <= 0
		-- (ödül yeniden alınabilir oldu: vereceği yeni miktar sunucudan)
		if free and not self.wasFree and (tonumber(shop.dailyIn) or 0) > 0 and not self.asking then
			self.asking = true
			task.spawn(function()
				self:_refresh()
				self.asking = false
			end)
		end
		self.wasFree = free
		for _, card in self.cards do
			if card.kind == "daily" then
				local note = card.frame:FindFirstChild("Note") :: TextLabel
				local b = card.button :: TextButton
				-- (alınabilirken Play Solo turuncusu, siyah yazı; alındıysa gri)
				if free then
					note.Text = "Ready to claim!"
					setButton(b, "CLAIM", nil, ORANGE, DARK_TEXT)
				else
					note.Text = "Next in " .. clock(dailyLeft)
					setButton(b, "CLAIMED", nil, GREY, WHITE)
				end
				local sub = card.frame:FindFirstChild("Sub") :: TextLabel
				sub.Text = string.format("%d Medals", tonumber(shop.dailyAmount) or 0)
			elseif card.kind == "flag" then
				local note = card.frame:FindFirstChild("Note") :: TextLabel
				note.Text = "New flags in " .. clock(resetLeft)
			end
		end
		if resetLeft <= 0 and not self.asking then
			-- (UTC 00:00: sunucudan yeni günün bayrakları)
			self.asking = true
			task.spawn(function()
				task.wait(2)
				self:_refresh()
				self.asking = false
			end)
		end
	end
	if self.mainButton then
		local label = self.mainButton:FindFirstChild("Label2") :: GuiObject?
		if label then
			label.Visible = free and inv ~= nil and inv.loaded ~= false
		end
	end
end

return Shop
]]></ProtectedString>
