				</Item>
				<Item class="ModuleScript" referent="RBXF4CA122204054298912CD6C372929B19">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Fx: haritadaki kısa ömürlü görsel efektler (repo FxPass + WorldTextPass karşılığı). Hepsi WorldLayer'ın üst
-- katmanında, tile birimiyle yerleşir (kaydırma/zoom'da kendiliğinden yerinde kalır).
--   conquest  : fetih — çapraz kılıçlar + "+ 178.0K" (2.5 sn, %10 belirme, %60 sönme)
--   gold      : tren/ticaret altını — "+ 25.0K" yükselerek söner (1.5 sn)
--   shell     : savaş gemisi mermisi — küçük piksel, çıkıştan hedefe
--   samShot   : SAM füzesi — açık mavi piksel ve kısa iz, önleme noktasına
--   nuke      : nükleer patlama — parlama diski + genişleyen şok dalgası halkası (1.5 sn, yarıçap x 1.5)
--   samBoom   : SAM önleme patlaması — küçük parlama (0.8 sn)
--   hit       : mermi isabeti — minik patlama (repo FX MiniExplosion, 4 x 70 ms)
--   sunk      : batan savaş gemisi — patlama + kararıp küçülen gemi (repo UnitExplosion + SinkingShip, ~1.3 sn)

local Fonts = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Fonts"))
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Assets = require(Shared:WaitForChild("Assets"))
local Look = require(Shared:WaitForChild("Look"))
local WorldLayer = require(script.Parent.WorldLayer)

local Fx = {}
Fx.__index = Fx

type Item = {
	kind: string,
	born: number,
	life: number,
	delay: number,
	frames: { GuiObject },
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	r: number,
}

export type Fx = typeof(setmetatable({} :: { layer: WorldLayer.WorldLayer, items: { Item }, fmt: (number) -> string, zoom: number }, Fx))

function Fx.new(layer: WorldLayer.WorldLayer, fmt: (number) -> string): Fx
	return setmetatable({ layer = layer, items = {}, fmt = fmt, zoom = 1 }, Fx)
end

local function frame(self: Fx, z: number): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.ZIndex = z
	f.Parent = self.layer.over
	return f
end

local function text(self: Fx, s: string, z: number): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.FontFace = Fonts.main
	l.TextScaled = true
	l.Text = s
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.TextStrokeTransparency = 0.2
	l.ZIndex = z
	l.Parent = self.layer.over
	return l
end

local function circle(f: GuiObject)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
end

local GOLD_TEXT = Color3.fromRGB(253, 224, 71)

-- Sabit piksel boylu "+ 25.0K [altın]" satırı (zoomdan bağımsız okunur). Altın görseli Assets.Icons.gold; boşsa
-- sarı bir sikke çizilir. `parent` verilmezse üst katmana, ortası (x, y) olacak şekilde konur.
local function goldRow(self: Fx, s: string, textSize: number, z: number): Frame
	local row = Instance.new("Frame")
	row.Name = "GoldRow"
	row.BackgroundTransparency = 1
	row.AnchorPoint = Vector2.new(0.5, 0.5)
	row.Size = UDim2.fromOffset(math.max(160, textSize * 9), textSize + 6) -- (büyük yazıda satır sığsın)
	row.ZIndex = z
	row:SetAttribute("Group", true)
	local lay = Instance.new("UIListLayout")
	lay.FillDirection = Enum.FillDirection.Horizontal
	lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
	lay.VerticalAlignment = Enum.VerticalAlignment.Center
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Padding = UDim.new(0, 3)
	lay.Parent = row
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromOffset(0, textSize + 4)
	l.FontFace = Fonts.main
	l.TextSize = textSize
	l.Text = s
	l.TextColor3 = GOLD_TEXT
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.TextStrokeTransparency = 0.2
	l.LayoutOrder = 1
	l.ZIndex = z
	l.Parent = row
	local isz = math.floor(textSize * 1.15)
	if Assets.has(Assets.Icons.gold) then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromOffset(isz, isz)
		img.Image = Assets.Icons.gold
		img.ScaleType = Enum.ScaleType.Fit
		img.LayoutOrder = 2
		img.ZIndex = z
		img.Parent = row
	else
		local coin = Instance.new("Frame")
		coin.BorderSizePixel = 0
		coin.Size = UDim2.fromOffset(isz - 4, isz - 4)
		coin.BackgroundColor3 = Color3.fromRGB(250, 204, 21)
		coin.LayoutOrder = 2
		coin.ZIndex = z
		circle(coin)
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(161, 98, 7)
		st.Thickness = 1.5
		st.Parent = coin
		coin.Parent = row
	end
	row.Parent = self.layer.over
	return row
end

local function push(self: Fx, kind: string, life: number, frames: { GuiObject }, x0: number, y0: number, x1: number?, y1: number?, r: number?, delay: number?)
	table.insert(self.items, {
		kind = kind,
		born = os.clock(),
		life = life,
		delay = delay or 0,
		frames = frames,
		x0 = x0,
		y0 = y0,
		x1 = x1 or x0,
		y1 = y1 or y0,
		r = r or 0,
	})
end

-- Fetih: kendi fethim (repo yalnız fethedenin ekranında gösterir).
function Fx.conquest(self: Fx, x: number, y: number, gold: number)
	local L = self.layer
	local icon: GuiObject
	if Assets.has(Assets.Fx.conquest) then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.AnchorPoint = Vector2.new(0.5, 0.5)
		img.Image = Assets.Fx.conquest
		img.ZIndex = 20
		img.Parent = L.over
		icon = img
	else
		icon = text(self, Assets.Fallback.Fx.conquest, 20)
		;(icon :: TextLabel).TextStrokeTransparency = 0.4
	end
	-- sabit piksel boy: uzaktan da yakından da aynı okunur
	icon.AnchorPoint = Vector2.new(0.5, 1)
	icon.Position = L:at(x, y)
	icon.Size = UDim2.fromOffset(44, 44)
	local row = goldRow(self, "+ " .. self.fmt(gold), 26, 20)
	row.AnchorPoint = Vector2.new(0.5, 0)
	row.Position = L:at(x, y)
	push(self, "conquest", 2.5, { icon, row }, x, y)
end

-- Tren / ticaret altını.
function Fx.gold(self: Fx, x: number, y: number, gold: number)
	local L = self.layer
	local row = goldRow(self, "+ " .. self.fmt(gold), 13, 19)
	row.Position = L:at(x, y - 3)
	push(self, "gold", 1.5, { row }, x, y - 3)
end

-- Mermi / füze: (x0,y0) -> (x1,y1), `dur` saniyede, `delay` saniye sonra çıkar.
function Fx.projectile(self: Fx, kind: string, x0: number, y0: number, x1: number, y1: number, dur: number, delay: number, color: Color3)
	local L = self.layer
	local frames: { GuiObject } = {}
	local count = if kind == "samShot" then 3 else 1 -- füzenin kısa izi
	for i = 1, count do
		local f: GuiObject
		local img = if kind == "samShot" then Assets.Units.samMissile else Assets.Units.shell
		if i == 1 and Assets.has(img) then
			local il = Instance.new("ImageLabel")
			il.BackgroundTransparency = 1
			il.AnchorPoint = Vector2.new(0.5, 0.5)
			il.Image = img
			il.ZIndex = 18
			il.Parent = L.over
			f = il
			f.Size = L:size(2, 2, 4, 4)
		else
			local fr = frame(self, 18 - i)
			fr.BackgroundColor3 = color
			fr.BackgroundTransparency = (i - 1) * 0.35
			f = fr
			-- mermi: Look.Ship.shellTiles (repo 1 tile), en az / en çok piksel; boy her karede zoomdan
			local px = math.clamp(self.zoom * Look.Ship.shellTiles, Look.Ship.shellMinPx, Look.Ship.shellMaxPx)
			f.Size = UDim2.fromOffset(px, px)
		end
		f.Position = L:at(x0, y0)
		f.Visible = delay <= 0
		frames[i] = f
	end
	push(self, kind, dur, frames, x0, y0, x1, y1, 0, delay)
end

-- Mermi isabeti: minik turuncu-beyaz parlama (repo MiniExplosion).
function Fx.hit(self: Fx, x: number, y: number)
	local f = frame(self, 17)
	f.BackgroundColor3 = Color3.fromRGB(255, 220, 140)
	circle(f)
	f.Position = self.layer:at(x, y)
	f.Size = self.layer:size(3, 3, 5, 5)
	push(self, "hit", 0.28, { f }, x, y)
end

-- Batan savaş gemisi: kısa patlama + gemi renginde kararıp küçülen daire (repo UnitExplosion + SinkingShip).
function Fx.sunk(self: Fx, x: number, y: number, color: Color3)
	local L = self.layer
	local ship = frame(self, 16)
	ship.BackgroundColor3 = color
	circle(ship)
	ship.Position = L:at(x, y)
	ship.Size = L:size(Look.Ship.warship.tiles, Look.Ship.warship.tiles, Look.Ship.warship.minPx, Look.Ship.warship.minPx)
	local boom = frame(self, 17)
	boom.BackgroundColor3 = Color3.fromRGB(255, 196, 100)
	circle(boom)
	boom.Position = L:at(x, y)
	boom.Size = L:size(0, 0)
	push(self, "sunk", 1.3, { ship, boom }, x, y, nil, nil, Look.Ship.warship.tiles)
end

-- Nükleer patlama (r = dış yarıçap) ya da SAM önleme patlaması.
function Fx.explosion(self: Fx, x: number, y: number, r: number, big: boolean)
	local L = self.layer
	local flash: GuiObject
	local img = if big then Assets.Fx.explosion else Assets.Fx.samExplosion
	if Assets.has(img) then
		local il = Instance.new("ImageLabel")
		il.BackgroundTransparency = 1
		il.AnchorPoint = Vector2.new(0.5, 0.5)
		il.Image = img
		il.ZIndex = 16
		il.Parent = L.over
		flash = il
	else
		local f = frame(self, 16)
		f.BackgroundColor3 = if big then Color3.fromRGB(255, 244, 214) else Color3.fromRGB(186, 230, 253)
		circle(f)
		flash = f
	end
	flash.Position = L:at(x, y)
	flash.Size = L:size(0, 0)
	local ring = frame(self, 15)
	ring.BackgroundTransparency = 1
	circle(ring)
	local st = Instance.new("UIStroke")
	st.Thickness = if big then 3 else 2
	st.Color = if big then Color3.fromRGB(255, 237, 213) else Color3.fromRGB(224, 242, 254)
	st.Parent = ring
	ring.Position = L:at(x, y)
	ring.Size = L:size(0, 0)
	push(self, if big then "nuke" else "samBoom", if big then 1.5 else 0.8, { flash, ring }, x, y, nil, nil, r)
end

local function setAlpha(f: GuiObject, a: number)
	-- a: 1 görünür, 0 kayıp
	if f:GetAttribute("Group") then
		for _, c in f:GetChildren() do
			if c:IsA("GuiObject") then
				setAlpha(c, a)
			end
		end
		return
	end
	if f:IsA("TextLabel") then
		f.TextTransparency = 1 - a
		f.TextStrokeTransparency = 1 - a * 0.8
	elseif f:IsA("ImageLabel") then
		f.ImageTransparency = 1 - a
	else
		f.BackgroundTransparency = 1 - a
		local st = f:FindFirstChildOfClass("UIStroke")
		if st then
			st.Transparency = 1 - a
		end
	end
end

-- Her kare: ilerletir, biteni siler.
function Fx.step(self: Fx)
	local now = os.clock()
	local L = self.layer
	local i = 1
	local items = self.items
	while i <= #items do
		local it = items[i]
		local t = (now - it.born - it.delay) / it.life
		if t >= 1 then
			for _, f in it.frames do
				f:Destroy()
			end
			items[i] = items[#items]
			items[#items] = nil
			if it.kind == "shell" then
				self:hit(it.x1, it.y1) -- repo: mermi hedefe varınca minik patlama
			end
			continue
		end
		if t >= 0 then
			if it.kind == "conquest" then
				local a = if t < 0.1 then t / 0.1 elseif t > 0.4 then 1 - (t - 0.4) / 0.6 else 1
				for _, f in it.frames do
					setAlpha(f, a)
				end
			elseif it.kind == "gold" then
				local y = it.y0 - t * 1.5 * 3 -- 3 tile/sn yükselir
				it.frames[1].Position = L:at(it.x0, y)
				setAlpha(it.frames[1], if t > 0.6 then 1 - (t - 0.6) / 0.4 else 1)
			elseif it.kind == "shell" or it.kind == "samShot" then
				local px = math.clamp(self.zoom * Look.Ship.shellTiles, Look.Ship.shellMinPx, Look.Ship.shellMaxPx)
				for k, f in it.frames do
					local tk = math.max(0, t - (k - 1) * 0.06)
					f.Visible = true
					f.Position = L:at(it.x0 + (it.x1 - it.x0) * tk, it.y0 + (it.y1 - it.y0) * tk)
					if it.kind == "shell" and not f:IsA("ImageLabel") then
						f.Size = UDim2.fromOffset(px, px)
					end
				end
			elseif it.kind == "hit" then
				setAlpha(it.frames[1], 1 - t)
			elseif it.kind == "sunk" then
				local ship, boom = it.frames[1], it.frames[2]
				-- gemi kararıp küçülerek batar; patlama ilk %30'da büyüyüp söner
				local k = 1 - t
				ship.Size = L:size(it.r * (0.4 + 0.6 * k), it.r * (0.4 + 0.6 * k), 4, 4)
				ship.BackgroundColor3 = ship.BackgroundColor3:Lerp(Color3.fromRGB(30, 40, 60), math.min(1, t * 0.08))
				setAlpha(ship, k)
				local bt = math.min(1, t / 0.3)
				boom.Size = L:size(it.r * 1.4 * bt, it.r * 1.4 * bt, 0, 0)
				setAlpha(boom, if t < 0.3 then 0.9 else math.max(0, 0.9 * (1 - (t - 0.3) / 0.2)))
			elseif it.kind == "nuke" or it.kind == "samBoom" then
				local flash, ring = it.frames[1], it.frames[2]
				-- parlama hızla büyür ve söner; halka 1.5 x yarıçapa genişler
				local ft = math.min(1, t / 0.35)
				local fr = it.r * (0.3 + 0.7 * (1 - (1 - ft) ^ 2))
				flash.Size = L:size(fr * 2, fr * 2)
				setAlpha(flash, if t < 0.15 then 0.95 else math.max(0, 0.95 * (1 - (t - 0.15) / 0.5)))
				local rr = it.r * 1.5 * (1 - (1 - t) ^ 2)
				ring.Size = L:size(rr * 2, rr * 2)
				setAlpha(ring, 1 - t)
			end
		end
		i += 1
	end
end

function Fx.clear(self: Fx)
	for _, it in self.items do
		for _, f in it.frames do
			f:Destroy()
		end
	end
	table.clear(self.items)
end

return Fx
]]></ProtectedString>
