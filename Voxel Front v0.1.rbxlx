					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Toast: mağaza / kasa bildirimi (StarterGui > FrontlineMenu > Toast; Studio'da düzenlenebilir). Olumlu: yeşil arka plan ve
-- kenar; olumsuz: kırmızı ve "error" sesi. Yeni bildirim eskisinin yerine geçer; birkaç saniye sonra kaybolur.
--   Toast.show(text, good, sound?)   sound: olumluda çalacak ses anahtarı (Assets.Sounds; boşsa çalmaz)

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Sound = require(script.Parent:WaitForChild("Sound"))

local Toast = {}

local GOOD_BG, GOOD_STROKE = Color3.fromRGB(20, 83, 45), Color3.fromRGB(74, 222, 128)
local BAD_BG, BAD_STROKE = Color3.fromRGB(127, 29, 29), Color3.fromRGB(248, 113, 113)
local SHOW_S = 2.6

local serial = 0

local function frame(): Frame?
	local gui = Players.LocalPlayer:FindFirstChild("PlayerGui")
	local menu = gui and gui:FindFirstChild("FrontlineMenu")
	return menu and menu:FindFirstChild("Toast") :: Frame?
end

function Toast.show(text: string, good: boolean, sound: string?)
	if good then
		if sound then
			Sound.play(sound)
		end
	else
		Sound.play("error")
	end
	local f = frame()
	if f == nil then
		return
	end
	serial += 1
	local mine = serial
	f.BackgroundColor3 = if good then GOOD_BG else BAD_BG
	local stroke = f:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if good then GOOD_STROKE else BAD_STROKE
	end
	local label = f:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = text
	end
	f.BackgroundTransparency = 0
	f.Visible = true
	task.delay(SHOW_S, function()
		if serial ~= mine then
			return
		end
		local tw = TweenService:Create(f, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
		tw:Play()
		tw.Completed:Wait()
		if serial == mine then
			f.Visible = false
			f.BackgroundTransparency = 0
		end
	end)
end

return Toast
]]></ProtectedString>
						<string name="ScriptGuid">{CB9046D7-3221-4AA6-A032-9A4B0F84AC70}</string>
