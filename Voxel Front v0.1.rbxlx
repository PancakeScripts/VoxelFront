					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Crates: ana menüdeki CRATES penceresi (StarterGui > FrontlineMenu > CratesCard; Studio'da düzenlenebilir, kod adlara göre
-- bulur). RoWorld src/client/UI/CrateButton.luau, CrateOpening.luau ve Locker.luau'dan uyarlandı (AGPL-3.0, © 2026 Snick Co.).
--   CRATES sekmesi: kasa sayısı, OPEN CRATE, düşme oranları (her satın almadan önce görünür: Roblox'un ücretli rastgele eşya
--     kuralları), Robux ile 1 / 3 / 10 kasa (ürün kimliği 0 olan düğme gizli), toplanan / toplam.
--   Index (CRATES sekmesinde, sağ altta): kasadaki bütün skinler / bayraklar; sahip olunanlarda OWNED. Satırda 4 eşya.
--     Sağ üstteki kare mavi düğme (Expand; görseli Assets.Shop.indexExpand) Index'i sağ alt köşesi yerinde kalarak
--     kasa penceresinin içini dolduracak kadar büyütür (kenarlarda sağ alttaki kadar boşluk; satırda 5 eşya; arka planı
--     aynı görünen renkte opaklaşır); büyükken X'in yerinde BACK (IndexBack) görünür ve geri küçültür.
--   OPEN CRATE gizliyken (kasa yok) altındakiler (Collected, satın alma düğmeleri) onun yerine kayar; satın alma
--     düğmelerinden görünenler sırayla dizilir (Studio'daki ilk yerlerinden).
--   COLLECTION sekmesi: sahip olunan skinler ve bayraklar; basınca giyilir / çıkarılır.
--   Açılış: önce sunucu eşyayı seçer (Server.Wallet; şans burada değişmez), sonra ekranın ortasındaki şeritte
--     (StarterGui > FrontlineMenu > CrateReel) eşyalar sağdan sola kayar, yavaşlayarak durur; çıkan eşya ortadaki çizginin
--     üstünde, ama tam ortada değil (sembolik animasyon). Geçerken "crateTick", bitince "crateReveal" sesi (Assets.Sounds).
--     Sonra çıkan eşya, nadirliği, giyildi mi.
-- Ücretli rastgele eşyaların yasak olduğu yerde (sunucunun PolicyService kontrolü: oyuncu özniteliği FrontlineCrates)
-- ana menüdeki Crates düğmesi gizlenir.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Sound = require(script.Parent:WaitForChild("Sound"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared:WaitForChild("Assets"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))

local Crates = {}
Crates.__index = Crates

local GOLD = Color3.fromRGB(251, 191, 36)
local DARK = Color3.fromRGB(32, 22, 6)
local PANEL2 = Color3.fromRGB(30, 41, 59)
local TEXT = Color3.fromRGB(241, 245, 249)
local RANK = { common = 1, rare = 2, epic = 3, legendary = 4 }

-- (yazı: 1 kasa yalnız fiyat "32"; diğerleri "60 • 3 CRATES"; fiyatın solunda Robux simgesi: Assets.Shop.robux)
local BUY = {
	Buy1 = { keys = { "crate_first", "crate" }, label = "1 CRATE", suffix = nil },
	Buy3 = { keys = { "crate3" }, label = "3 CRATES", suffix = "3 CRATES" },
	Buy10 = { keys = { "crate10" }, label = "10 CRATES", suffix = "10 CRATES" },
}

-- Robux fiyatları Roblox'tan (RoWorld UI/Prices gibi: MarketplaceService:GetProductInfo, PriceInRobux; bölgeye ve fiyat
-- testlerine göre değişir, bu yüzden elle yazılmaz) ve REFRESH_S'de bir yeniden sorulur.
local REFRESH_S = 600
local prices: { [number]: { price: number, at: number } } = {}
local function priceOf(id: number, kind: Enum.InfoType?): number?
	local known = prices[id]
	if known and os.clock() - known.at < REFRESH_S then
		return known.price
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(id, kind or Enum.InfoType.Product)
	end)
	if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
		prices[id] = { price = info.PriceInRobux, at = os.clock() }
		return info.PriceInRobux
	end
	return if known then known.price else nil
end
Crates.priceOf = priceOf

function Crates.new(card: Frame, mainButton: GuiButton?, close: () -> ())
	local self = setmetatable({}, Crates) :: any
	self.card = card
	self.page = card:WaitForChild("CratePage") :: Frame
	self.collection = card:WaitForChild("CollectionPage") :: Frame
	self.reveal = card:WaitForChild("Reveal") :: Frame
	self.inv = { medals = 0, owned = {}, equipped = {}, crates = 0, cratesBought = 0, cratesAllowed = false }
	self.filter = "skin"
	self.indexFilter = "skin"
	self.busy = false
	-- (yerleşim: Studio'daki ilk yerler; OPEN CRATE gizliyken altındakiler yukarı kayar)
	do
		local open = self.page:FindFirstChild("Open") :: GuiObject?
		local coll = self.page:FindFirstChild("Collected") :: GuiObject?
		local buyF = self.page:FindFirstChild("Buy") :: GuiObject?
		self.home = {
			open = if open then open.Position else nil,
			collected = if coll then coll.Position else nil,
			buy = if buyF then buyF.Position else nil,
			buttons = {},
		}
		if buyF then
			for _, n in { "Buy1", "Buy3", "Buy10" } do
				local b = buyF:FindFirstChild(n) :: GuiObject?
				if b then
					table.insert(self.home.buttons, b.Position)
				end
			end
		end
	end
	local index = self.page:FindFirstChild("Index")
	if index then
		-- (büyütme: Studio'daki ilk yer, boyut, renk ve saydamlık)
		local countLabel = index:FindFirstChild("Count") :: GuiObject?
		self.indexHome = {
			pos = index.Position,
			size = index.Size,
			color = index.BackgroundColor3,
			alpha = index.BackgroundTransparency,
			count = if countLabel then countLabel.Position else nil,
		}
		self.expanded = false
		local ex = index:FindFirstChild("Expand") :: ImageButton?
		if ex then
			if Assets.has(Assets.Shop.indexExpand) then
				ex.Image = Assets.Shop.indexExpand
			end
			ex.Activated:Connect(function()
				self:_expand(true, false)
			end)
		end
		local back = card:FindFirstChild("IndexBack") :: TextButton?
		if back then
			back.Visible = false
			back.Activated:Connect(function()
				self:_expand(false, false)
			end)
		end
		for name, kind in { Skins = "skin", Flags = "flag" } do
			local b = index:FindFirstChild(name) :: TextButton?
			if b then
				b.Activated:Connect(function()
					self.indexFilter = kind
					self:_index(true)
				end)
			end
		end
	end
	local tabs = card:WaitForChild("Tabs")
	local art = self.page:FindFirstChild("Art") :: ImageLabel?
	if art and Assets.has(Assets.Shop.crate) then
		art.Image = Assets.Shop.crate -- (boşken Studio'da verilen görsel kalır)
	end
	-- (ana menüdeki Crates düğmesinde de kasa görseli)
	local mainIcon = mainButton and mainButton:FindFirstChild("Icon") :: ImageLabel?
	if mainIcon and Assets.has(Assets.Shop.crate) then
		mainIcon.Image = Assets.Shop.crate
	end
	;(card:WaitForChild("Close") :: TextButton).Activated:Connect(close)
	;(tabs:WaitForChild("CratesTab") :: TextButton).Activated:Connect(function()
		self:tab("crates")
	end)
	;(tabs:WaitForChild("CollectionTab") :: TextButton).Activated:Connect(function()
		self:tab("collection")
	end)
	local filter = self.collection:WaitForChild("Filter")
	;(filter:WaitForChild("Skins") :: TextButton).Activated:Connect(function()
		self.filter = "skin"
		self:_grid()
	end)
	;(filter:WaitForChild("Flags") :: TextButton).Activated:Connect(function()
		self.filter = "flag"
		self:_grid()
	end)
	;(self.page:WaitForChild("Open") :: TextButton).Activated:Connect(function()
		self:_open()
	end)
	;(self.reveal:WaitForChild("Ok") :: TextButton).Activated:Connect(function()
		self.reveal.Visible = false
	end)
	local buy = self.page:WaitForChild("Buy")
	for name, def in BUY do
		local b = buy:FindFirstChild(name) :: TextButton?
		if b then
			b.Activated:Connect(function()
				local key = self:_product(def)
				local id = if key then (Assets.Products :: any)[key] else 0
				if key and id ~= 0 then
					if self.remote then
						self.remote:FireServer("shop", "click", key)
					end
					MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
				end
			end)
		end
	end
	local test = self.page:FindFirstChild("TestCrate") :: TextButton?
	if test then
		test.Visible = RunService:IsStudio()
		test.Activated:Connect(function()
			if self.fn and not self.busy then
				self.busy = true
				pcall(function()
					self.fn:InvokeServer("devCrate")
				end)
				self.busy = false
			end
		end)
	end
	-- ana menüdeki Crates düğmesi yalnız ücretli rastgele eşyaya izin verilen yerde; gizliyken altındaki düğmeler (Shop,
	-- 2x Medals) birer yukarı kayar (Studio'daki yerlerine göre)
	local lp = Players.LocalPlayer
	local chain: { GuiObject } = {}
	local chainHome: { UDim2 } = {}
	if mainButton then
		for _, n in { "Crates", "Shop", "Medals2x" } do
			local b = (mainButton.Parent :: Instance):FindFirstChild(n) :: GuiObject?
			if b then
				table.insert(chain, b)
				table.insert(chainHome, b.Position)
			end
		end
	end
	local function policy()
		if mainButton then
			local on = lp:GetAttribute("FrontlineCrates") == true
			mainButton.Visible = on
			local slot = 1
			for i, b in chain do
				if b ~= mainButton or on then
					b.Position = chainHome[slot]
					slot += 1
				end
			end
		end
	end
	lp:GetAttributeChangedSignal("FrontlineCrates"):Connect(policy)
	policy()
	task.spawn(function()
		local remote = ReplicatedStorage:WaitForChild("FrontlineWallet", 60) :: RemoteEvent?
		local fn = ReplicatedStorage:WaitForChild("FrontlineWalletCall", 60) :: RemoteFunction?
		self.remote = remote
		self.fn = fn
		if remote then
			remote.OnClientEvent:Connect(function(what: any, data: any)
				if what == "inv" and type(data) == "table" then
					self:_set(data)
				end
			end)
		end
		if fn then
			local ok, data = pcall(function()
				return fn:InvokeServer("inv")
			end)
			if ok and type(data) == "table" then
				self:_set(data)
			end
		end
	end)
	self:tab("crates")
	return self
end

--- Pencere açıldı (Menu): satın alma hunisinin ilk adımı.
function Crates.opened(self: any)
	self.reveal.Visible = false
	self:_expand(false, true)
	self:tab("crates")
	if self.remote then
		self.remote:FireServer("shop", "open", "crates")
	end
	self:_prices()
	self:_index(false)
end

function Crates.tab(self: any, which: string)
	if which ~= "crates" then
		self:_expand(false, true)
	end
	self.page.Visible = which == "crates"
	self.collection.Visible = which == "collection"
	local tabs = self.card:FindFirstChild("Tabs")
	if tabs then
		for name, on in { CratesTab = which == "crates", CollectionTab = which == "collection" } do
			local b = tabs:FindFirstChild(name) :: TextButton?
			if b then
				b.BackgroundColor3 = if on then GOLD else PANEL2
				b.TextColor3 = if on then DARK else TEXT
			end
		end
	end
	if which == "collection" then
		self:_grid()
	end
end

--- Bir düğmenin ürünü (ilk kasa: hiç kasa almamış oyuncuya, kimliği varsa).
function Crates._product(self: any, def: any): string?
	for _, key in def.keys do
		local id = (Assets.Products :: any)[key]
		if type(id) == "number" and id ~= 0 and (key ~= "crate_first" or (self.inv.cratesBought or 0) == 0) then
			return key
		end
	end
	return nil
end

--- Satın alma düğmeleri: kimliği olmayan gizli; fiyat Roblox'tan.
function Crates._prices(self: any)
	local buy = self.page:FindFirstChild("Buy")
	if buy == nil then
		return
	end
	for name, def in BUY do
		local b = buy:FindFirstChild(name) :: TextButton?
		if b then
			local key = self:_product(def)
			b.Visible = key ~= nil and self.inv.cratesAllowed == true
			local icon = b:FindFirstChild("Icon") :: ImageLabel?
			if icon and Assets.has(Assets.Shop.robux) then
				icon.Image = Assets.Shop.robux
			end
			if key then
				if b.Text == "" or not string.find(b.Text, "%d") then
					b.Text = def.label
				end
				local id = (Assets.Products :: any)[key]
				task.spawn(function()
					local price = priceOf(id)
					if price then
						b.Text = if def.suffix then string.format("%d  •  %s", price, def.suffix) else tostring(price)
					end
				end)
			end
		end
	end
	self:_layout()
end

--- Yerleşim: OPEN CRATE gizliyse Collected onun yerine, satın alma düğmeleri aynı kadar yukarı; görünen satın alma
--- düğmeleri boşluk bırakmadan sırayla (Studio'daki ilk yerleri sırasıyla).
function Crates._layout(self: any)
	local h = self.home
	local open = self.page:FindFirstChild("Open") :: GuiObject?
	local coll = self.page:FindFirstChild("Collected") :: GuiObject?
	local buy = self.page:FindFirstChild("Buy") :: GuiObject?
	local shift = 0
	if open and h.open and h.collected and not open.Visible then
		shift = h.collected.Y.Scale - h.open.Y.Scale
	end
	if coll and h.collected then
		coll.Position = UDim2.new(h.collected.X.Scale, h.collected.X.Offset, h.collected.Y.Scale - shift, h.collected.Y.Offset)
	end
	if buy and h.buy then
		buy.Position = UDim2.new(h.buy.X.Scale, h.buy.X.Offset, h.buy.Y.Scale - shift, h.buy.Y.Offset)
		local slot = 1
		for _, n in { "Buy1", "Buy3", "Buy10" } do
			local b = buy:FindFirstChild(n) :: GuiObject?
			if b and b.Visible and h.buttons[slot] then
				b.Position = h.buttons[slot]
				slot += 1
			end
		end
	end
end

--- Index'i büyütür (on) ya da eski yerine küçültür; instant: animasyonsuz (pencere açılırken / sekme değişince).
function Crates._expand(self: any, on: boolean, instant: boolean)
	local index = self.page:FindFirstChild("Index") :: Frame?
	local home = self.indexHome
	if index == nil or home == nil or (self.expanded == on and not instant) then
		return
	end
	self.expanded = on
	local close = self.card:FindFirstChild("Close") :: GuiObject?
	local back = self.card:FindFirstChild("IndexBack") :: GuiObject?
	local ex = index:FindFirstChild("Expand") :: GuiObject?
	if close then
		close.Visible = not on
	end
	if back then
		back.Visible = on
	end
	if ex then
		ex.Visible = not on
	end
	-- satırda 4 (küçük) / 5 (büyük) eşya
	local grid = index:FindFirstChild("Grid")
	local gl = grid and grid:FindFirstChildOfClass("UIGridLayout")
	if gl then
		gl.CellSize = if on then UDim2.new(0.185, 0, 0.185, 0) else UDim2.new(0.235, 0, 0.235, 0)
	end
	local pos, size = home.pos, home.size
	local color, alpha = home.color, home.alpha
	local countLabel = index:FindFirstChild("Count") :: GuiObject?
	local countPos = home.count
	if on then
		-- sağ alt köşe yerinde kalır; sol üst, kartın köşesine sağ alttaki boşluk kadar yaklaşır
		local pageP, pageS = self.page.AbsolutePosition, self.page.AbsoluteSize
		local cardP, cardS = self.card.AbsolutePosition, self.card.AbsoluteSize
		local br = pageP + Vector2.new(pageS.X * (home.pos.X.Scale + home.size.X.Scale), pageS.Y * (home.pos.Y.Scale + home.size.Y.Scale))
		local gap = (cardP + cardS) - br
		local tl = cardP + gap
		pos = UDim2.fromScale((tl.X - pageP.X) / pageS.X, (tl.Y - pageP.Y) / pageS.Y)
		size = UDim2.fromScale((br.X - tl.X) / pageS.X, (br.Y - tl.Y) / pageS.Y)
		-- (opak olurken görünen renk aynı kalsın: kendi rengi kartın rengiyle saydamlığı oranında karışır)
		color = home.color:Lerp(self.card.BackgroundColor3, home.alpha)
		alpha = 0
		-- ("N / M owned" yazısı büyükken BACK'in soluna kayar: sağ kenarı BACK'in 10 piksel solunda)
		if countLabel and countPos and back then
			local w = br.X - tl.X
			local right = back.AbsolutePosition.X - 10
			countPos = UDim2.new((right - tl.X) / w - countLabel.Size.X.Scale, 0, countPos.Y.Scale, countPos.Y.Offset)
		end
	end
	for _, tw in self.indexTweens or {} do
		tw:Cancel()
	end
	if instant then
		index.Position, index.Size = pos, size
		index.BackgroundColor3, index.BackgroundTransparency = color, alpha
		if countLabel and countPos then
			countLabel.Position = countPos
		end
		self.indexTweens = {}
		return
	end
	local a = TweenService:Create(index, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = pos, Size = size })
	if countLabel and countPos then
		TweenService:Create(countLabel, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = countPos }):Play()
	end
	-- (arka plan büyümeden daha hızlı opaklaşır; küçülürken sona doğru eski saydamlığına)
	local b = TweenService:Create(index, TweenInfo.new(if on then 0.15 else 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = color, BackgroundTransparency = alpha })
	self.indexTweens = { a, b }
	a:Play()
	b:Play()
end

--- Index: kasadaki bütün skinler ya da bayraklar (rebuild: filtre değişti; yoksa yalnız OWNED işaretleri güncellenir).
function Crates._index(self: any, rebuild: boolean)
	local index = self.page:FindFirstChild("Index")
	if index == nil then
		return
	end
	local grid = index:FindFirstChild("Grid") :: ScrollingFrame?
	local template = index:FindFirstChild("ItemTemplate") :: Frame?
	if grid == nil or template == nil then
		return
	end
	for name, kind in { Skins = "skin", Flags = "flag" } do
		local b = index:FindFirstChild(name) :: TextButton?
		if b then
			local on = self.indexFilter == kind
			b.BackgroundColor3 = if on then GOLD else PANEL2
			b.TextColor3 = if on then DARK else TEXT
		end
	end
	if rebuild or self.indexCells == nil or self.indexKind ~= self.indexFilter then
		for _, c in grid:GetChildren() do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		local list = {}
		for _, it in Cosmetics.all() do
			if it.kind == self.indexFilter then
				table.insert(list, it)
			end
		end
		table.sort(list, function(a: any, b: any)
			if a.rarity ~= b.rarity then
				return (RANK[a.rarity] or 0) > (RANK[b.rarity] or 0)
			end
			return a.name < b.name
		end)
		local cells = {}
		self.indexBuild = (self.indexBuild or 0) + 1
		local build = self.indexBuild
		self.indexCells = cells
		self.indexKind = self.indexFilter
		self.indexTotal = #list
		for i, it in list do
			-- (258 bayrak bir anda kurulunca kısa donma olur: 25'te bir kareye yayılır)
			if i % 25 == 0 then
				task.wait()
				if self.indexBuild ~= build then
					return -- (arada başka filtre seçildi)
				end
			end
			local c = template:Clone()
			c.Name = it.id
			c.LayoutOrder = i
			c.Visible = true
			Cosmetics.paint(c:FindFirstChild("Image") :: ImageLabel, it)
			;(c:FindFirstChild("Name") :: TextLabel).Text = it.name
			local st = c:FindFirstChild("Rarity") :: UIStroke?
			if st then
				st.Color = Cosmetics.rarity(it.rarity).color
			end
			local tag = c:FindFirstChild("Owned") :: TextLabel?
			if tag then
				tag.Visible = (self.owned or {})[it.id] == true
			end
			c.Parent = grid
			cells[it.id] = c
			if i == 1 then
				grid.CanvasPosition = Vector2.zero
			end
		end
	end
	local have = 0
	for id, c in self.indexCells do
		local mine = (self.owned or {})[id] == true
		if mine then
			have += 1
		end
		local tag = c:FindFirstChild("Owned") :: TextLabel?
		if tag then
			tag.Visible = mine
		end
	end
	local count = index:FindFirstChild("Count") :: TextLabel?
	if count then
		count.Text = string.format("%d / %d owned", have, self.indexTotal or 0)
	end
end

function Crates._set(self: any, inv: any)
	if inv.loaded == false and self.inv.loaded == true then
		return -- (kaydı okunmadan verilmiş eski bir cevap, okunmuş kaydın üstüne yazılmasın)
	end
	self.inv = inv
	local owned: { [string]: boolean } = {}
	for _, id in (inv.owned or {}) :: { string } do
		owned[id] = true
	end
	self.owned = owned
	local n = math.floor(tonumber(inv.crates) or 0)
	;(self.page:FindFirstChild("Count") :: TextLabel).Text = string.format("You have %d crate%s", n, if n == 1 then "" else "s")
	local open = self.page:FindFirstChild("Open") :: TextButton
	open.Visible = n > 0
	;(self.page:FindFirstChild("Collected") :: TextLabel).Text = string.format("Collected %d / %d", #(inv.owned or {}), #Cosmetics.all())
	-- oranlar (oyuncunun kendi oranları: sahip olduğu eşyalar düşer)
	local odds = self.page:FindFirstChild("Odds")
	if odds then
		for _, e in Cosmetics.odds(owned) do
			local row = odds:FindFirstChild(e.rarity.id) :: TextLabel?
			if row then
				row.Text = string.format("%s   %.1f%%   ·   %d left", e.rarity.name, e.odds * 100, e.left)
				row.TextColor3 = e.rarity.color
			end
		end
	end
	local allowed = inv.cratesAllowed == true
	;(self.page:FindFirstChild("Blocked") :: TextLabel).Visible = not allowed
	if odds then
		odds.Visible = allowed
	end
	self:_prices()
	if self.indexCells ~= nil then
		self:_index(false)
	end
	if self.collection.Visible then
		self:_grid()
	end
end

function Crates._open(self: any)
	if self.busy or self.fn == nil then
		return
	end
	self.busy = true
	local ok, got, item = pcall(function()
		return self.fn:InvokeServer("openCrate")
	end)
	local it = if ok and got == true then Cosmetics.item(item) else nil
	if it == nil then
		self.busy = false
		return
	end
	-- (kayarken kasa penceresi geçici kapanır, şerit açık kalır; bitince pencere "YOU GOT" ile geri gelir)
	local was = self.card.Visible
	self.card.Visible = false
	pcall(function()
		self:_spin(it)
	end)
	self.card.Visible = was
	self.busy = false
	local r = Cosmetics.rarity(it.rarity)
	Cosmetics.paint(self.reveal:FindFirstChild("Image") :: ImageLabel, it)
	;(self.reveal:FindFirstChild("Name") :: TextLabel).Text = it.name
	local rl = self.reveal:FindFirstChild("Rarity") :: TextLabel
	rl.Text = string.upper(r.name) .. " " .. (if it.kind == "skin" then "SKIN" else "FLAG")
	rl.TextColor3 = r.color
	local worn = (self.inv.equipped or {})[it.kind] == it.id
	;(self.reveal:FindFirstChild("Status") :: TextLabel).Text = if worn then "Equipped" else "Added to your collection"
	self.reveal.Visible = true
end

--- Açılış animasyonu (bekler): çıkan eşya `it`, şeridin WIN. hücresi; diğerleri nadirlik oranlarıyla rastgele (yalnız görünüş).
function Crates._spin(self: any, it: any)
	local reel = self.card.Parent and self.card.Parent:FindFirstChild("CrateReel") :: Frame?
	if reel == nil then
		return
	end
	local strip = reel:FindFirstChild("Strip") :: Frame
	local track = strip:FindFirstChild("Track") :: Frame
	local template = reel:FindFirstChild("ItemTemplate") :: Frame
	for _, c in track:GetChildren() do
		c:Destroy()
	end
	reel.Visible = true
	task.wait() -- (şeridin boyutu belli olsun)
	local H, W = strip.AbsoluteSize.Y, strip.AbsoluteSize.X
	local ch = H * 0.8
	local cw = ch * 1.3
	local step = cw + ch * 0.12
	local N, WIN = 60, 52
	local rng = Random.new()
	local pools: { [string]: { any } } = {}
	for _, x in Cosmetics.all() do
		pools[x.rarity] = pools[x.rarity] or {}
		table.insert(pools[x.rarity], x)
	end
	local function pick(): any
		local r, acc = rng:NextNumber(), 0
		for _, ra in Cosmetics.RARITIES do
			acc += ra.odds
			local pool = pools[ra.id]
			if r < acc and pool and #pool > 0 then
				return pool[rng:NextInteger(1, #pool)]
			end
		end
		local pool = pools.common
		return pool[rng:NextInteger(1, #pool)]
	end
	for i = 1, N do
		local x = if i == WIN then it else pick()
		local c = template:Clone()
		c.Name = "Cell" .. i
		c.Visible = true
		c.Size = UDim2.fromOffset(cw, ch)
		c.Position = UDim2.fromOffset((i - 1) * step, (H - ch) / 2)
		Cosmetics.paint(c:FindFirstChild("Image") :: ImageLabel, x)
		local bar = c:FindFirstChild("Bar") :: Frame?
		if bar then
			bar.BackgroundColor3 = Cosmetics.rarity(x.rarity).color
		end
		c.Parent = track
	end
	local center = W / 2
	-- (çizgi çıkan eşyanın içinde rastgele bir yerde durur: kenara yakın da olabilir)
	local finalX = center - ((WIN - 1) * step + rng:NextNumber(0.06, 0.94) * cw)
	track.Position = UDim2.fromOffset(center - (2 * step + cw * 0.5), 0)
	local DURATION, SKIP_S, SKIP_HIDE_S = 6.5, 0.5, 0.7
	local goal = { Position = UDim2.fromOffset(finalX, 0) }
	local tween = TweenService:Create(track, TweenInfo.new(DURATION, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goal)
	local endsAt = os.clock() + DURATION
	local done = false
	-- SKIP: kalan kayma 0.5 sn'de (hızlanarak değil, yine yavaşlayarak) biter; bitmesine 0.7 sn'den az kalmışsa düğme yok
	local skip = reel:FindFirstChild("Skip") :: TextButton?
	local skipConn: RBXScriptConnection? = nil
	if skip then
		skip.Visible = true
		skipConn = skip.Activated:Connect(function()
			if done or endsAt - os.clock() < SKIP_HIDE_S then
				return
			end
			skip.Visible = false
			tween:Pause()
			local fast = TweenService:Create(track, TweenInfo.new(SKIP_S, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
			endsAt = os.clock() + SKIP_S
			fast.Completed:Connect(function()
				done = true
			end)
			fast:Play()
		end)
	end
	local last: number? = nil
	local conn = RunService.RenderStepped:Connect(function()
		local idx = math.floor((center - track.Position.X.Offset) / step)
		if idx ~= last then
			last = idx
			Sound.play("crateTick")
		end
		if skip and skip.Visible and endsAt - os.clock() < SKIP_HIDE_S then
			skip.Visible = false
		end
	end)
	tween.Completed:Connect(function(state: Enum.PlaybackState)
		if state == Enum.PlaybackState.Completed then
			done = true
		end
	end)
	tween:Play()
	while not done do
		RunService.Heartbeat:Wait()
	end
	conn:Disconnect()
	if skipConn then
		skipConn:Disconnect()
	end
	if skip then
		skip.Visible = false
	end
	task.wait(0.6)
	Sound.play("crateReveal")
	reel.Visible = false
end

function Crates._grid(self: any)
	local filter = self.collection:FindFirstChild("Filter")
	if filter then
		for name, on in { Skins = self.filter == "skin", Flags = self.filter == "flag" } do
			local b = filter:FindFirstChild(name) :: TextButton?
			if b then
				b.BackgroundColor3 = if on then GOLD else PANEL2
				b.TextColor3 = if on then DARK else TEXT
			end
		end
	end
	local grid = self.collection:FindFirstChild("Grid") :: ScrollingFrame
	local template = self.collection:FindFirstChild("ItemTemplate") :: TextButton
	for _, c in grid:GetChildren() do
		if c:IsA("GuiButton") then
			c:Destroy()
		end
	end
	local eq = self.inv.equipped or {}
	local list = {}
	for id in self.owned or {} do
		local it = Cosmetics.item(id)
		if it and it.kind == self.filter then
			table.insert(list, it)
		end
	end
	table.sort(list, function(a: any, b: any)
		if a.rarity ~= b.rarity then
			return (RANK[a.rarity] or 0) > (RANK[b.rarity] or 0)
		end
		return a.name < b.name
	end)
	for i, it in list do
		local c = template:Clone()
		c.Name = it.id
		c.LayoutOrder = i
		c.Visible = true
		Cosmetics.paint(c:FindFirstChild("Image") :: ImageLabel, it)
		;(c:FindFirstChild("Name") :: TextLabel).Text = it.name
		local st = c:FindFirstChild("Rarity") :: UIStroke?
		if st then
			st.Color = Cosmetics.rarity(it.rarity).color
		end
		local worn = eq[it.kind] == it.id
		;(c:FindFirstChild("Worn") :: TextLabel).Visible = worn
		c.Activated:Connect(function()
			if self.busy or self.fn == nil then
				return
			end
			self.busy = true
			pcall(function()
				self.fn:InvokeServer("equip", it.kind, if worn then false else it.id)
			end)
			self.busy = false
		end)
		c.Parent = grid
	end
	;(self.collection:FindFirstChild("Empty") :: TextLabel).Visible = #list == 0
	local function nameOf(id: any): string
		local it = Cosmetics.item(id)
		return if it then it.name else "none"
	end
	;(self.collection:FindFirstChild("Worn") :: TextLabel).Text = string.format("Skin: %s  ·  Flag: %s", nameOf(eq.skin), nameOf(eq.flag))
end

return Crates
]]></ProtectedString>
						<string name="ScriptGuid">{D3ED3D56-7FDC-4E8D-81F5-F6F09AB8A536}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
