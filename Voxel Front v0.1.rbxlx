						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- OpenFront NationAttackBehavior: random transport attacks, Medium / FFA.
-- Reference d1f236242864f506a040f2d56cc5ddd41bf27612; CREDITS.md / LICENSE-OpenFront.txt.
local NationNaval = {}

-- Each search gets its own failed-player cache, as in findRandomBoatTarget.
function NationNaval.findTarget(t: any, sim: any, source: number, neighbors: { number }, highInterest: boolean, plan: any): any
	local w, pid, rng = sim.world, t.pid, t.rng
	local x, y = source % w.width, source // w.width
	local unreachable = {}
	for _ = 1, 500 do
		local rx, ry = rng:int(x - 150, x + 149), rng:int(y - 150, y + 149)
		local tile = w:index(rx, ry)
		if tile == nil or not w:isLand(tile) then continue end
		local owner = w:ownerAt(tile)
		if owner == pid then continue end
		if owner ~= 0 then
			if unreachable[owner] or not sim.alive[owner] or not sim.spawned[owner] then continue end
			if table.find(neighbors, owner) then continue end
			-- FFA: equal troops are allowed by the upstream '>' check.
			if sim.troops[owner] > sim.troops[pid] then continue end
		end
		if highInterest then
			if owner ~= 0 and (not sim.isBot[owner] or sim.isNation[owner]) then continue end
		elseif owner ~= 0 and sim.parts.Diplomacy.isAllied(sim, pid, owner) then
			continue
		end
		-- canBuildTransportShip rejects friendly targets in either search pass.
		if owner ~= 0 and sim.parts.Diplomacy.isAllied(sim, pid, owner) then
			unreachable[owner] = true
			continue
		end
		local route = plan(tile)
		if sim.pace then sim.pace() end -- rota aramaları pahalı: kare bütçesi dolduysa sonraki kareye
		if not route then
			if owner ~= 0 then unreachable[owner] = true end
			continue
		end
		return { tile = tile, launch = route.launch, landing = route.landing }
	end
	return nil
end

-- Medium's sail() checks both shores against hostile warships (range + 20).
function NationNaval.safeToSail(sim: any, pid: number, launch: number, landing: number): boolean
	local w = sim.world.width
	local function manhattan(a: number, b: number): number
		return math.abs(a % w - b % w) + math.abs(a // w - b // w)
	end
	local length = manhattan(launch, landing)
	local range = sim.cfg.WARSHIP_TARGET_RANGE + 20
	local minX, maxX = math.min(launch % w, landing % w) - range, math.max(launch % w, landing % w) + range
	local minY, maxY = math.min(launch // w, landing // w) - range, math.max(launch // w, landing // w) + range
	for i = 1, sim.executionCount do
		local e = sim.executions[i]
		if not e or e.kind ~= 'warship' or e.done or e.pid == pid or sim.parts.Diplomacy.isAllied(sim, pid, e.pid) then continue end
		local tile = e:position()
		local x, y = tile % w, tile // w
		if x < minX or x > maxX or y < minY or y > maxY then continue end
		for _, p in { launch, landing } do
			if (x - p % w) ^ 2 + (y - p // w) ^ 2 <= range * range then
				if 4 * length >= manhattan(tile, p) - 10 then return false end
				break
			end
		end
	end
	return true
end

function NationNaval.attackWithRandomBoat(t: any, sim: any, neighbors: { number }): boolean
	local pid, w, N = t.pid, sim.world, sim.parts.Naval
	if (sim.boatCount[pid] or 0) >= sim.cfg.BOAT_MAX then return false end
	local shores = {}
	for _, tile in w:orderedBorderOf(pid) do
		if tile ~= -1 and w:shoreComponent(tile) then shores[#shores + 1] = tile end
	end
	if #shores == 0 then return false end
	local source = shores[t.rng:int(1, #shores)]
	local comps = N.reachableComps(w, pid)
	local function plan(tile: number): any
		local landing = N.findLanding(w, w:ownerAt(tile), tile, comps)
		if not landing then return nil end
		local path, launch = N.findRoute(w, pid, landing)
		if not path or not launch then return nil end
		return { launch = launch, landing = landing }
	end
	local found = NationNaval.findTarget(t, sim, source, neighbors, true, plan)
	if not found then found = NationNaval.findTarget(t, sim, source, neighbors, false, plan) end
	if not found or not NationNaval.safeToSail(sim, pid, found.launch, found.landing) then return false end
	if sim.troops[pid] / 5 < 1 then return false end
	sim:addExecution(sim.parts.Boat.new(pid, found.tile, 0.2))
	return true
end

-- Returns true when a land-neighbor turn is spent trying a random boat,
-- even if no target is found: upstream chooseAttack() returns on that branch.
function NationNaval.maybeAttack(t: any, sim: any, neighbors: { number }): boolean
	local incoming = false
	for i = 1, sim.executionCount do
		local e = sim.executions[i]
		if e and e.kind == 'attack' and not e.done and e.target == t.pid and e.troops > 0 and sim.alive[e.pid]
			and not sim.parts.Diplomacy.isAllied(sim, t.pid, e.pid) then incoming = true; break end
	end
	if incoming and t.rng:int(0, 1) == 0 then return false end
	local odds = if #neighbors == 0 then 5 else 10
	if t.rng:int(0, odds - 1) ~= 0 then return false end
	NationNaval.attackWithRandomBoat(t, sim, neighbors)
	return #neighbors > 0
end

return NationNaval
]]></ProtectedString>
