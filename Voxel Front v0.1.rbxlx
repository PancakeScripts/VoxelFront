						<ProtectedString name="Source"><![CDATA[--!strict
-- Menu: ana menü (Oyna / Ayarlar / Nasıl oynanır), tur sonu ve elenme kartı. Öğeler StarterGui > FrontlineMenu'de
-- (src/gui/FrontlineMenu.model.json); Studio'da serbestçe düzenlenebilir, kod öğeleri ADLARINA göre bulur.
-- Repo karşılıkları: ana sayfa (oyna + ayarlar), WinModal (kazanan, sonraki tur), elenince "izlemeye devam".

local Fonts = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Fonts"))
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Assets = require(Shared:WaitForChild("Assets"))
local Session = require(Shared:WaitForChild("Session")) -- ayarlar, zorluk ve harita menüye dönünce kaybolmasın
local Catalog = require(Shared:WaitForChild("Maps"):WaitForChild("Catalog"))
local Credits = require(Shared:WaitForChild("Credits"))

local Menu = {}
Menu.__index = Menu

export type Settings = { names: boolean, attackNumbers: boolean, alerts: boolean, icons: boolean, sounds: boolean }

export type Callbacks = {
	onPlay: () -> (),
	onMapChange: ((string?) -> ())?, -- arkadaki harita: verilen harita (Solo Online penceresi) ya da nil = seçili solo harita
	onVisibility: ((boolean) -> ())?,
	onPause: (() -> boolean)?,
	onResume: (() -> ())?,
	onMenu: () -> (),
	onSettings: (s: Settings) -> (),
}

export type EndModel = { title: string, sub: string, color: Color3, stats: string, playLabel: string?, paused: boolean? }

export type Menu = typeof(setmetatable(
	{} :: {
		gui: ScreenGui,
		cb: Callbacks,
		settings: Settings,
		shade: Frame,
		main: Frame,
		settingsCard: Frame,
		helpCard: Frame,
		endCard: Frame,
		burger: TextButton,
		open: string, -- "main" | "end" | ""
		closedAt: number,
		setup: Frame,
		onlineSetup: Frame,
		teamSetup: Frame,
		partyCard: Frame,
		picker: Frame,
		difficulty: string,
		paused: boolean,
		current: Frame?,
		settingsReturn: Frame?,
		settingsButton: TextButton,
	},
	Menu
))

local function find(parent: Instance, path: string): any
	local cur: Instance = parent
	for part in string.gmatch(path, "[^/]+") do
		local nxt = cur:FindFirstChild(part)
		if not nxt then
			error("[Frontline] menu element not found: " .. parent.Name .. "/" .. path .. " (don't rename StarterGui > FrontlineMenu children)")
		end
		cur = nxt
	end
	return cur
end

-- Basınca hafifçe küçülen düğme hissi.
local function press(b: GuiButton)
	local sc = b:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	sc.Parent = b
	b.MouseButton1Down:Connect(function()
		TweenService:Create(sc, TweenInfo.new(0.08), { Scale = 0.94 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(sc, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	b.MouseLeave:Connect(function()
		sc.Scale = 1
	end)
end

function Menu.new(gui: ScreenGui, cb: Callbacks, version: string): Menu
	local self = setmetatable({
		gui = gui,
		cb = cb,
		settings = Session.settings,
		shade = find(gui, "Shade"),
		main = find(gui, "Main"),
		settingsCard = find(gui, "SettingsCard"),
		helpCard = find(gui, "HelpCard"),
		endCard = find(gui, "EndCard"),
		burger = find(gui, "Burger"),
		settingsButton = find(gui, "Burger"), -- (bindHud: oyunda alt barın solundaki ayarlar düğmesiyle değişir)
		current = nil,
		settingsReturn = nil,
		open = "",
		closedAt = -1,
		setup = find(gui, "Setup"),
		onlineSetup = find(gui, "OnlineSetup"),
		teamSetup = find(gui, "TeamSetup"),
		partyCard = find(gui, "PartyCard"),
		picker = find(gui, "MapPicker"),
		difficulty = Session.difficulty,
		paused = false,
	}, Menu)
	;(find(self.main, "Foot") :: TextLabel).Text = "© OpenFront and Contributors · GNU AGPL v3, no warranty: See How to Play"
	;(self :: any).feedbackCard = find(gui, "FeedbackCard") -- (sol üstteki Feedback düğmesinin penceresi)
	;(self :: any).gameOverFrame = find(gui, "GameOver") -- (maç sonu ekranı: Client.GameOver)
	;(self :: any).cratesCard = find(gui, "CratesCard") -- (ana menüdeki Crates düğmesinin penceresi: Client.Crates)
	;(self :: any).shopCard = find(gui, "ShopCard") -- (ana menüdeki Shop düğmesinin penceresi: Client.Shop)
	;(self :: any).soloShopCard = find(gui, "SoloShopCard") -- (solo maçtaki Shop düğmesinin penceresi: Client.SoloShop)
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		-- mobil: kartlar ekranın çoğunu kaplasın
		for _, c in { self.settingsCard, self.helpCard, self.endCard, self.partyCard, (self :: any).feedbackCard } do
			c.Size = UDim2.new(math.min(0.95, c.Size.X.Scale * 2.4), c.Size.X.Offset, math.min(0.95, c.Size.Y.Scale * 1.5), c.Size.Y.Offset)
		end
	end

	-- Ana menü paneli: küçük ekranda ekranın daha büyük, büyük ekranda daha küçük bir payını kaplar.
	local dock = find(self.main, "Dock") :: Frame
	local panel = find(self.setup, "Panel") :: Frame
	local partyPanel = find(self.main, "PartyPanel") :: Frame
	local partyBase = self.partyCard.Size -- (mobilde büyütülmüş oran)
	local safeProbe: Frame? = nil -- (cihazın güvenli alanı: telefon çentiği; aşağıda üst bar ekranında kurulur)
	local function fitDock()
		local screen = gui.AbsoluteSize
		local h = 130 + screen.Y * 0.2
		local w = math.min(h * 1.85, screen.X * 0.92)
		dock.Size = UDim2.fromOffset(w, w / 1.85)
		-- soldaki Party kutusu: telefon çentiğinin sağında (güvenli alanın kenarı; çentiğin kendisinden zaten biraz
		-- ileride, ayrıca boşluk eklenmez), çentiksiz ekranda kenardan küçük boşlukla; ana panele oranlı, ekranın en çok
		-- %30'u; ortadaki ana panele binmez, aralarında boşluk kalır
		local gap = screen.X * 0.015
		local left = gap
		if safeProbe then
			left = math.max(left, safeProbe.AbsolutePosition.X - gui.AbsolutePosition.X)
		end
		local dockLeft = (screen.X - w) / 2
		local pw = math.max(0, math.min(w * 0.62, screen.X * 0.3, dockLeft - gap - left))
		partyPanel.Position = UDim2.new(0, left, 0.5, 0)
		partyPanel.Size = UDim2.fromOffset(pw, pw / 1.85)
		-- Party penceresi: genişliği eskisi gibi, boyu daha uzun; ekranın ortasında, altında ve üstünde %5 boşluk kalır
		local cw = math.min(partyBase.X.Scale * screen.X, partyBase.Y.Scale * screen.Y * 0.85)
		self.partyCard.Size = UDim2.fromOffset(cw, math.min(screen.Y * 0.9, cw * 1.45))
		-- hazırlık ekranı da aynı mantıkla
		local ph = math.min(150 + screen.Y * 0.25, screen.X * 0.94 / 2.75, screen.Y * 0.72)
		panel.Size = UDim2.fromOffset(ph * 2.75, ph)
		;(find(self.onlineSetup, "Panel") :: Frame).Size = panel.Size -- (Solo / Team Online pencereleri aynı boyda)
		;(find(self.teamSetup, "Panel") :: Frame).Size = panel.Size
		-- How to Play penceresi: yatayda neredeyse ekran boyu (solda güvenli alan / boşluk, sağında sekmeler ve boşluk),
		-- dikeyde Roblox üst barının altından ekranın altına kadar, kenarlarda boşlukla; ekrandan taşmaz
		local help = self.helpCard
		local tabsF = help:FindFirstChild("Tabs") :: Frame?
		local m = math.max(12, math.floor(math.min(screen.X, screen.Y) * 0.04))
		local sl, sr = 0, 0
		if safeProbe then
			sl = safeProbe.AbsolutePosition.X - gui.AbsolutePosition.X
			sr = screen.X - sl - safeProbe.AbsoluteSize.X
		end
		local tabW = math.clamp(math.floor(screen.X * 0.12), 96, 170)
		local tabH = math.clamp(math.floor(screen.Y * 0.075), 30, 48)
		local tgap = 10
		local hLeft = math.max(m, sl)
		local hw = math.max(200, screen.X - hLeft - math.max(m, sr) - tgap - tabW)
		local hTop = math.max(m, GuiService.TopbarInset.Max.Y + math.floor(m * 0.5))
		local hBottom = screen.Y - m
		local hh = math.max(160, math.min(hBottom - hTop, screen.Y * 0.86))
		help.Size = UDim2.fromOffset(hw, hh)
		help.Position = UDim2.fromOffset(hLeft + hw / 2, (hTop + hBottom) / 2)
		if tabsF then
			tabsF.Size = UDim2.fromOffset(tabW, tabH * 2 + 8)
			for _, b in tabsF:GetChildren() do
				if b:IsA("GuiButton") then
					b.Size = UDim2.new(1, 0, 0, tabH)
				end
			end
		end
		-- harita seçim ekranı: ekranın dışına taşmaz
		local pw = math.min(screen.X * 0.94, screen.Y * 0.84 * 1.7)
		;(find(self.picker, "Panel") :: Frame).Size = UDim2.fromOffset(pw, pw / 1.7)
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitDock)
	fitDock()

	-- Online satırları: sağda hap biçimli etiket (Badge: JOIN / JOIN TEAMS ...), boyu satıra göre. Başlık yazısı etiketin
	-- soluna kadar gelir, uzarsa (başka dile çeviride) küçülür; etikete binmez.
	for _, name in { "SoloOnline", "TeamOnline" } do
		local row = find(dock, name) :: TextButton
		local badge = find(row, "Badge") :: Frame
		local text = find(badge, "Soon") :: TextLabel
		local rowPad = row:FindFirstChildOfClass("UIPadding") :: UIPadding
		local badgePad = badge:FindFirstChildOfClass("UIPadding")
		local list = badge:FindFirstChildOfClass("UIListLayout")
		local dot = badge:FindFirstChild("Dot") :: Frame?
		local function fitBadge()
			local h = badge.AbsoluteSize.Y
			if h <= 0 then
				return
			end
			text.TextSize = math.max(8, math.floor(h * 0.55 + 0.5))
			if badgePad then
				badgePad.PaddingLeft = UDim.new(0, math.floor(h * 0.5 + 0.5))
				badgePad.PaddingRight = badgePad.PaddingLeft
			end
			if list then
				list.Padding = UDim.new(0, math.floor(h * 0.25 + 0.5))
			end
			if dot then
				local d = math.max(4, math.floor(h * 0.32 + 0.5))
				dot.Size = UDim2.fromOffset(d, d)
			end
			local margin = math.floor(row.AbsoluteSize.X * 0.025 + 0.5)
			local right = badge.AbsoluteSize.X + margin + math.floor(h * 0.4 + 0.5)
			if rowPad then
				rowPad.PaddingRight = UDim.new(0, right)
			end
			badge.Position = UDim2.new(1, right - margin, 0.5, 0) -- (içerik kutusunun sağından satırın sağ kenarına - margin)
		end
		badge:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitBadge)
		row:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitBadge)
		fitBadge()
	end

	-- Üst bar düğmeleri: Roblox'un kendi düğmeleri gibi görünür ve onların sağında durur (RoWorld Main'deki ölçüler).
	local topbar = Instance.new("ScreenGui")
	topbar.Name = "FrontlineTopbar"
	topbar.IgnoreGuiInset = true
	topbar.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	topbar.ResetOnSpawn = false
	topbar.DisplayOrder = 100 -- diğer tüm ekranların üstünde
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.BackgroundTransparency = 1
	bar.Parent = topbar
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 8)
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Parent = bar
	local function topButton(name: string, order: number, glyph: string, icon: string): TextButton
		local b = Instance.new("TextButton")
		b.Name = name
		b.LayoutOrder = order
		b.Size = UDim2.fromOffset(44, 44)
		b.BackgroundColor3 = Color3.fromRGB(18, 18, 21)
		b.BackgroundTransparency = 0.08
		b.BorderSizePixel = 0
		b.FontFace = Fonts.main
		b.TextSize = 20
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Text = if icon ~= "" then "" else glyph
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = b
		if icon ~= "" then
			local img = Instance.new("ImageLabel")
			img.BackgroundTransparency = 1
			img.AnchorPoint = Vector2.new(0.5, 0.5)
			img.Position = UDim2.fromScale(0.5, 0.5)
			img.Size = UDim2.fromScale(0.62, 0.62)
			img.Image = icon
			img.Parent = b
		end
		b.Parent = bar
		return b
	end
	self.burger = topButton("Menu", 1, "🚪", Assets.Icons.topExit) -- (çıkış: oyunu durdurup "leave the game?" penceresini açar)
	-- Feedback düğmesi: Roblox düğmesinin altında, sol kenarı onunla hizalı; çıkış düğmesi gibi görünür, 2.5 kat geniş
	-- ("✉ Feedback"). Feedback penceresini açar (aşağıda). Ana menüde ve oyunda (başka pencere açık değilken) görünür.
	local feedbackBtn = topButton("Feedback", 2, "✉ Feedback", "")
	feedbackBtn.Parent = topbar
	feedbackBtn.Size = UDim2.fromOffset(110, 31) -- (Roblox düğmelerinden %30 ince)
	feedbackBtn.TextSize = 14 -- (yazının çevresinde boşluk kalsın)
	;(self :: any).feedbackButton = feedbackBtn
	-- (ayarlar düğmesi üst barda değil: oyunda alt barın solunda, Hud kurar, bindHud bağlar)
	local function layoutBar()
		local inset = GuiService.TopbarInset
		local height = if inset.Height > 0 then inset.Height else 58
		local left = (if inset.Width > 0 then inset.Min.X else 164) + 8
		local barY = inset.Min.Y + math.max(0, height - 44 - 2)
		bar.Position = UDim2.fromOffset(left, barY)
		bar.Size = UDim2.fromOffset(44, 44)
		-- (Roblox düğmesi üst barın solunda, güvenli alanın kenarından 16 piksel içeride; Feedback onun altında, 8 px boşlukla)
		feedbackBtn.Position = UDim2.fromOffset(16, barY + 44 + 8)
	end
	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(layoutBar)
	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(fitDock) -- (How to Play penceresi Roblox üst barının altında)
	layoutBar()
	-- güvenli alanı ölçen görünmez çerçeve (bu ekran DeviceSafeInsets: sol kenarı çentiğin sağı)
	local probe = Instance.new("Frame")
	probe.Name = "SafeArea"
	probe.BackgroundTransparency = 1
	probe.Size = UDim2.fromScale(1, 1)
	probe.Active = false
	probe.Parent = topbar
	safeProbe = probe
	probe:GetPropertyChangedSignal("AbsolutePosition"):Connect(fitDock)
	topbar.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	fitDock()

	local function only(f: Frame?)
		self.current = f
		if f == nil and self.shade.Visible then
			self.closedAt = os.clock() -- kapatan tıkın bırakılışı haritaya geçmesin
		end
		self.main.Visible = f == self.main
		self.setup.Visible = f == self.setup
		self.onlineSetup.Visible = f == self.onlineSetup
		self.teamSetup.Visible = f == self.teamSetup
		self.partyCard.Visible = f == self.partyCard
		self.picker.Visible = f == self.picker
		self.settingsCard.Visible = f == self.settingsCard
		self.helpCard.Visible = f == self.helpCard
		;(self :: any).feedbackCard.Visible = f == (self :: any).feedbackCard
		;(self :: any).feedbackButton.Visible = f == nil or f == self.main
		self.endCard.Visible = f == self.endCard
		;(self :: any).gameOverFrame.Visible = f == (self :: any).gameOverFrame
		;(self :: any).cratesCard.Visible = f == (self :: any).cratesCard
		;(self :: any).shopCard.Visible = f == (self :: any).shopCard
		;(self :: any).soloShopCard.Visible = f == (self :: any).soloShopCard
		self.shade.Visible = f ~= nil
		self.burger.Visible = f == nil
		if cb.onVisibility then cb.onVisibility(f ~= nil) end
		-- ana menü ekranlarında arkadaki harita düz kararmaz: kenarlar (vinyet) ve üst / alt geçişler koyuluğu verir (RoWorld başlık ekranı)
		local backdrop = f == self.main or f == self.setup or f == self.onlineSetup or f == self.teamSetup or f == self.partyCard or f == self.picker or f == self.settingsCard or f == self.helpCard
			or f == (self :: any).feedbackCard or f == (self :: any).cratesCard or f == (self :: any).shopCard
		self.shade.BackgroundTransparency = if backdrop then 1 else 0.45
		-- (maç sonu ekranında da kenar gölgeleri: Menu.showGameOver yavaşça açar; başka ekranda hemen tam)
		local over = f == (self :: any).gameOverFrame
		for _, tw in (self :: any)._edgeTweens or {} do
			tw:Cancel()
		end
		;(self :: any)._edgeTweens = {}
		for _, name in { "Vignette", "TopShade", "BottomShade" } do
			local fx = self.shade:FindFirstChild(name) :: GuiObject?
			if fx then
				fx.Visible = backdrop or over
				if fx:IsA("ImageLabel") then
					fx.ImageTransparency = 0
				else
					fx.BackgroundTransparency = 0
				end
			end
		end
		-- (Solo / Team Online penceresi açıldı / kapandı, menüde mi: bindOnline, bindParty)
		for _, hook in (self :: any)._screenHooks do
			hook(f)
		end
	end
	;(self :: any)._only = only
	;(self :: any)._screenHooks = {}

	local play = find(self.main, "Dock/Play") :: TextButton
	press(play)
	play.Activated:Connect(function()
		only(self.setup)
	end)
	-- Maç hazırlık ekranı
	local setupBack = find(panel, "Back") :: TextButton
	press(setupBack)
	setupBack.Activated:Connect(function()
		only(self.main)
	end)
	local body = find(panel, "Body") :: Frame -- Back dışındaki öğeler bu saydam çerçevede
	local go = find(body, "Play") :: TextButton
	press(go)
	go.Activated:Connect(function()
		only(nil)
		self.open = ""
		cb.onPlay()
	end)
	-- (Tutorial: yeni oyuncunun ilk maçı kendiliğinden başlar: solo PLAY ile aynı yol)
	;(self :: any)._startSolo = function()
