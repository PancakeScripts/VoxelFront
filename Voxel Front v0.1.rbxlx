					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXE3AB8DBF98F84488A56F9436A7DAC310">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Online: istemcinin online maç tarafı. Maç sunucusunda (lobinin ayrılmış sunucusu; Studio'da aynı sunucudaki yerel maç) ana
-- menü yerine bekleme odası açılır: arkada maçın haritası döner, geri sayım ve bekleyenler görünür. Maç başlayınca oyun
-- gerçek remote'larla (FrontlineNet) kurulur; harita bu cihazda çözülür, maçın kendisi sunucuda çalışır. Maçtan ayrılan ya da
-- maçı biten normal sunucuya döner (yayında ışınlanma; Studio'da istemci ana menüyle yeniden kurulur).
--
--   Online.detect(client) -> online?   (nil: normal sunucu; Studio'da yerel maça giriş / çıkışı da dinler)
--   online.map, online.wait(gui), online.net(), online.match(), online.bindGame(menu, menuCb), online.leave()
--   Online.reboot(client)              istemciyi baştan kurar (Online.cleanup varsa önce o)

local Fonts = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Fonts"))
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Protocol = require(Shared:WaitForChild("Protocol"))
local MapData = require(Shared:WaitForChild("MapData"))
local Session = require(Shared:WaitForChild("Session"))
local Maps = Shared:WaitForChild("Maps")
local Catalog = require(Maps:WaitForChild("Catalog"))

local Online = {}

--- Maç ekranının bellekteki parçalarını bırakır (maç kurulunca istemci atar).
Online.cleanup = nil :: (() -> ())?
--- Ayrılınca ışınlanma bu kadar sürede olmazsa ana menüye dönülür.
Online.LEAVE_FALLBACK_S = 15
--- Maç ekranından ana menüye dönerken ışınlanma olmazsa dönüş isteği bu aralıkla yinelenir (sunucu aynı oyuncuyu 20 sn
--- içinde ikinci kez göndermez).
Online.LEAVE_RETRY_S = 21

-- bu açılışta istemci online maçta mı (ayrılınca da "hub" bunu menüye döndürür)
local inMatch = false

function Online.reboot(client: Instance)
	local c = Online.cleanup
	Online.cleanup = nil
	if c then
		pcall(c)
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	for _, name in { "FrontlineMap", "FrontlineHud", "FrontlineMenu", "FrontlineRadial", "FrontlineTopbar", "FrontlineLeaving" } do
		local old = playerGui:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local sounds = game:GetService("SoundService"):FindFirstChild("FrontlineSounds")
	if sounds then
		sounds:Destroy()
	end
	Session.reloaded = true
	local fresh = client:Clone()
	fresh.Parent = client.Parent
	client:Destroy()
end

-- Studio: katılınca maç bu sunucuda açılır ("enter"), bitince ya da ayrılınca menüye dönülür ("hub").
local function listenMoves(client: Instance)
	task.spawn(function()
		local lobby = ReplicatedStorage:WaitForChild(Protocol.LobbyFolder, 15)
		local move = if lobby then lobby:WaitForChild(Protocol.MatchMove, 5) :: RemoteEvent? else nil
		if move == nil or client.Parent == nil then
			return
		end
		move.OnClientEvent:Connect(function(what: any)
			if what == "enter" and not Session.online then
				Session.online = true
				Online.reboot(client)
			elseif what == "hub" and inMatch then
				Session.online = false
				Online.reboot(client)
			end
		end)
	end)
end

function Online.detect(client: Instance): any?
	if not game:IsLoaded() then
		game.Loaded:Wait()
	end
	inMatch = false
	listenMoves(client)
	local folder = ReplicatedStorage:FindFirstChild(Protocol.MatchFolder)
	if (Session :: any).online == nil then
		-- ilk açılış: maç sunucusunda bu klasör vardır, eşleştirme (hub) klasörü yoktur
		(Session :: any).online = folder ~= nil and ReplicatedStorage:FindFirstChild(Protocol.LobbyFolder) == nil
	end
	if not (Session :: any).online then
		return nil
	end
	folder = folder or ReplicatedStorage:WaitForChild(Protocol.MatchFolder, 10)
	if folder == nil then
		(Session :: any).online = false
		return nil
	end
	-- harita, maç sunucusu lobi kaydını bulunca yazılır
	local t0 = os.clock()
	while folder:GetAttribute("Map") == nil and folder.Parent ~= nil and os.clock() - t0 < 60 do
		task.wait(0.2)
	end
	local mapId = folder:GetAttribute("Map")
	if type(mapId) ~= "string" or Catalog[mapId] == nil then
		(Session :: any).online = false
		return nil
	end

	inMatch = true
	local self: { [string]: any } = { map = mapId, folder = folder }
	local leftAt: number? = nil

	--- Maçtan ayrıl: normal sunucuya dönüşü ister.
	function self.leave()
		if leftAt then
			return
		end
		leftAt = os.clock()
		;(Session :: any).online = false
		local r = folder:FindFirstChild(Protocol.MatchLeave) :: RemoteEvent?
		if r then
			r:FireServer()
		end
	end

	--- Bekleme odası: maç başlayana dek bekler (ayrılınca dönmez; istemci yeniden kurulur).
	function self.wait(gui: ScreenGui)
		require(script.Parent.Sound).play("queueStart") -- (bekleme odası açıldı; RoWorld queue_start)
		local topbar = Players.LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("FrontlineTopbar") :: ScreenGui?
		if topbar then
			topbar.Enabled = false -- (menü / ayarlar bekleme odasında açılmaz)
		end
		-- arkada yarı saydam koyu zemin ve ana menüdeki kenar / köşe gölgeleri (menünün Shade'inin kopyası); maç başlarken 0.5 sn'de kaybolur
		local shade: Frame? = nil
		local menuShade = gui:FindFirstChild("Shade")
		if menuShade and menuShade:IsA("Frame") then
			local s = menuShade:Clone()
			s.Name = "WaitShade"
			s.BackgroundTransparency = 0.6
			s.Visible = true
			for _, c in s:GetChildren() do
				if c:IsA("GuiObject") then
					c.Visible = true
				end
			end
			s.Parent = gui
			shade = s
		end
		local card = Instance.new("Frame")
		card.Name = "WaitingRoom"
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.fromScale(0.42, 0.5) -- (genişlik sabit; gelenlerin adları için uzun)
		card.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
		card.BackgroundTransparency = 0.25
		card.BorderSizePixel = 0
		card.ZIndex = 60
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 16)
		corner.Parent = card
		-- çerçeve: menüdeki pencerelerin klasik kenarlığı (SettingsCard gibi)
		local border = Instance.new("UIStroke")
		border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		border.Color = Color3.fromRGB(71, 85, 105)
		border.Thickness = 2
		border.Parent = card
		local aspect = Instance.new("UISizeConstraint")
		aspect.MinSize = Vector2.new(300, 260)
		aspect.Parent = card
		local function text(name: string, y: number, h: number, color: Color3): TextLabel
			local l = Instance.new("TextLabel")
			l.Name = name
			l.BackgroundTransparency = 1
			l.Position = UDim2.fromScale(0.05, y)
			l.Size = UDim2.fromScale(0.9, h)
			l.FontFace = Fonts.main
			l.TextScaled = true
			l.TextColor3 = color
			l.ZIndex = 61
			l.Parent = card
			return l
		end
		local title = text("MapName", 0.05, 0.136, Color3.fromRGB(241, 245, 249))
		local players = text("Players", 0.2, 0.088, Color3.fromRGB(148, 163, 184))
		-- gelenlerin adları: tek yazıda, virgülle, sol üstten başlar; sığmayanın sonu "…" (kart büyümez)
		local names = text("Names", 0.3, 0.3, Color3.fromRGB(203, 213, 225))
		names.TextScaled = false
		names.FontFace = Font.fromId(Fonts.ID, Enum.FontWeight.Bold) -- (bir kademe ince: ExtraBold yerine Bold)
		names.TextWrapped = true
		names.TextXAlignment = Enum.TextXAlignment.Left
		names.TextYAlignment = Enum.TextYAlignment.Top
		names.TextTruncate = Enum.TextTruncate.AtEnd
		names.Text = ""
		local starts = text("StartsIn", 0.63, 0.11, Color3.fromRGB(255, 181, 71))
		local leave = Instance.new("TextButton")
		leave.Name = "Leave"
		leave.AnchorPoint = Vector2.new(0.5, 0)
		leave.Position = UDim2.fromScale(0.5, 0.79)
		leave.Size = UDim2.fromScale(0.4, 0.122)
		leave.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
		leave.BorderSizePixel = 0
		leave.FontFace = Fonts.main
		leave.TextScaled = true
		leave.TextColor3 = Color3.new(1, 1, 1)
		leave.Text = "Leave"
		leave.ZIndex = 61
		local lc = Instance.new("UICorner")
		lc.CornerRadius = UDim.new(0, 12)
		lc.Parent = leave
		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0.18, 0)
		pad.PaddingBottom = UDim.new(0.18, 0)
		pad.Parent = leave
		leave.Parent = card
		require(script.Parent.ButtonDepth).add(leave) -- (altında koyu taban: menüdeki tuşlar gibi)
		card.Parent = gui
		leave.Activated:Connect(function()
			self.leave()
		end)
		while true do
			if folder.Parent == nil then
				break
			end
			local phase = folder:GetAttribute("Phase")
			if phase ~= "lobby" and not leftAt then
				break
			end
			local name = folder:GetAttribute("MapName")
			title.Text = string.upper(if type(name) == "string" then name else mapId)
			local teams = tonumber(folder:GetAttribute("Teams")) or 0 -- (takım maçı: takım sayısı)
			players.Text = string.format("%d / %d players", tonumber(folder:GetAttribute("Players")) or 0, tonumber(folder:GetAttribute("Max")) or 0)
				.. (if teams > 0 then string.format(" · %d teams", teams) else "")
			local list = folder:GetAttribute("Names")
			names.Text = if type(list) == "string" then list else ""
			names.TextSize = math.max(10, math.floor(card.AbsoluteSize.Y * 0.05 + 0.5))
			local left = tonumber(folder:GetAttribute("StartsIn")) or -1
			if leftAt then
				starts.Text = "Leaving…"
				leave.Visible = false
				if os.clock() - leftAt > Online.LEAVE_FALLBACK_S then
					Online.reboot(client) -- (ışınlanma olmadı: ana menü)
					return
				end
			elseif left < 0 then
				starts.Text = "Waiting for players…"
			elseif left == 0 then
				starts.Text = "Starting…"
			else
				starts.Text = string.format("Starting in %d:%02d", left // 60, left % 60)
			end
			task.wait(0.25)
		end
		card:Destroy()
		if shade then
			local s = shade
			local TweenService = game:GetService("TweenService")
			local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(s, info, { BackgroundTransparency = 1 }):Play()
			for _, c in s:GetChildren() do
				if c:IsA("ImageLabel") then
					TweenService:Create(c, info, { ImageTransparency = 1 }):Play()
				elseif c:IsA("Frame") then
					TweenService:Create(c, info, { BackgroundTransparency = 1 }):Play()
				end
			end
			task.delay(0.55, function()
				s:Destroy()
			end)
		end
		if topbar then
			topbar.Enabled = true
		end
	end

	--- Maçın remote'ları (LocalNet ile aynı adlar).
	function self.net(): any
		local net = ReplicatedStorage:WaitForChild(Protocol.Folder, 30)
		assert(net, "the match server didn't answer")
		return {
			getMap = net:WaitForChild(Protocol.GetMap),
			getState = net:WaitForChild(Protocol.GetState),
			intent = net:WaitForChild(Protocol.Intent),
			delta = net:WaitForChild(Protocol.Delta),
			stats = net:WaitForChild(Protocol.Stats),
			notice = net:WaitForChild(Protocol.Notice),
			boats = net:WaitForChild(Protocol.Boats),
			fx = net:WaitForChild(Protocol.Fx),
			attacks = net:WaitForChild(Protocol.Attacks),
		}
	end

	--- Solo maçın yerine geçen: harita bu cihazda çözülür; durdurma / sıfırlama / zorluk sunucudaki maçta yoktur.
	function self.match(): any
		local map = Catalog[mapId]
		local info = require(Maps[map.module])
		local tileBytes = MapData.decodeWorld(Shared:WaitForChild(map.folder), info.width * info.height)
		task.wait()
		local terrain = MapData.gameplay(tileBytes)
		local function none(...: any) end
		return { tileBytes = tileBytes, terrain = terrain, join = none, setRunning = none, reset = none, stop = none, setDifficulty = none }
	end

	--- Ana menüye dönüş: menü bu (maç) sunucusunda açılmaz; normal sunucuya ışınlanana dek ekranı kaplayan "Returning…"
	--- yazısı kalır (tıklamalar alttaki menüye geçmez). Işınlanma olmazsa istek LEAVE_RETRY_S'de bir yinelenir.
	local function showLeaving()
		local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
		if playerGui:FindFirstChild("FrontlineLeaving") then
			return
		end
		local sg = Instance.new("ScreenGui")
		sg.Name = "FrontlineLeaving"
		sg.IgnoreGuiInset = true
		sg.ResetOnSpawn = false
		sg.DisplayOrder = 200 -- (üst bar düğmeleri dahil her şeyin üstünde)
		local cover = Instance.new("TextButton")
		cover.Name = "Cover"
		cover.AutoButtonColor = false
		cover.Text = ""
		cover.Size = UDim2.fromScale(1, 1)
		cover.BackgroundColor3 = Color3.fromRGB(2, 6, 23)
		cover.BackgroundTransparency = 0.1
		cover.BorderSizePixel = 0
		cover.Parent = sg
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.BackgroundTransparency = 1
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromScale(0.5, 0.5)
		label.Size = UDim2.fromScale(0.7, 0.07)
		label.FontFace = Fonts.main
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(241, 245, 249)
		label.Text = "Returning to the main menu…"
		label.Parent = cover
		sg.Parent = playerGui
		task.spawn(function()
			while true do
				task.wait(Online.LEAVE_RETRY_S)
				if sg.Parent == nil then
					return
				end
				local r = folder:FindFirstChild(Protocol.MatchLeave) :: RemoteEvent?
				if r then
					r:FireServer()
				end
			end
		end)
	end

	--- Maç ekranı: sunucudaki maç durmaz (menü kartı açılır, oyun sürer); kartın ana menü düğmesi maçtan ayrılır ve
	--- oyuncuyu normal sunucuya gönderir (bu sunucuda ana menü açılmaz); tek tur oynanır (tur sonu kartı yalnız kapanır).
	function self.bindGame(menu: any, menuCb: any)
		local solo = menuCb.onMenu
		-- (sunucudaki maç diğer oyuncular için durdurulamaz: çıkış penceresinin başlığı bunu söyler)
		menu.pauseTitle = "MATCH IS STILL RUNNING"
		menuCb.onPause = function(): boolean
			return true
		end
		menuCb.onResume = function() end
		menuCb.onPlay = function() end
		menuCb.onMenu = function()
			if menu.current == menu.main then
				solo()
				showLeaving()
				self.leave()
			end
		end
	end

	return self
end

return Online
]]></ProtectedString>
						<string name="ScriptGuid">{1F1EDB12-8676-4BA2-9E41-8156DDB8DAA8}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Online</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
