			<Item class="ModuleScript" referent="RBX7F695F459B4949F786213CEA5DA16363">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- OwnerRuns: owner buffer'ının (tile başına u16) RLE ile sıkıştırılmış tam görüntüsü.
-- Geç katılan oyuncuya ve atlanan pakette yeniden senkron için kullanılır.
-- Düzen: ardışık run'lar, her biri [u16 owner][u32 uzunluk] (6 bayt). Boş harita birkaç run'a iner.

local RUN_BYTES = 6

local OwnerRuns = {}

function OwnerRuns.encode(owner: buffer, size: number): buffer
	local runs: { number } = {}
	local n = 0
	if size > 0 then
		local current = buffer.readu16(owner, 0)
		local length = 1
		for i = 1, size - 1 do
			local v = buffer.readu16(owner, i * 2)
			if v == current then
				length += 1
			else
				runs[n + 1] = current
				runs[n + 2] = length
				n += 2
				current = v
				length = 1
			end
		end
		runs[n + 1] = current
		runs[n + 2] = length
		n += 2
	end
	local out = buffer.create(n // 2 * RUN_BYTES)
	for r = 0, n // 2 - 1 do
		buffer.writeu16(out, r * RUN_BYTES, runs[r * 2 + 1])
		buffer.writeu32(out, r * RUN_BYTES + 2, runs[r * 2 + 2])
	end
	return out
end

-- Paketi `target` owner buffer'ına yazar. Uzunluklar haritayla uyuşmazsa false döner.
function OwnerRuns.decode(packed: buffer, target: buffer, size: number): boolean
	local len = buffer.len(packed)
	if len % RUN_BYTES ~= 0 then
		return false
	end
	local pos = 0
	for r = 0, len // RUN_BYTES - 1 do
		local value = buffer.readu16(packed, r * RUN_BYTES)
		local length = buffer.readu32(packed, r * RUN_BYTES + 2)
		if pos + length > size then
			return false
		end
		for i = pos, pos + length - 1 do
			buffer.writeu16(target, i * 2, value)
		end
		pos += length
	end
	return pos == size
end

return OwnerRuns
]]></ProtectedString>
