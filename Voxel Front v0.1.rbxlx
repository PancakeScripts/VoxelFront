				</Item>
				<Item class="ModuleScript" referent="RBX26E06FC2286347AF9D7A965462170C4A">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Alignment: Aligner'ı Roblox ile konuşturan ince katman.
-- Fare ham ekran koordinatı verir; GUI'nin çizim başlangıcı cihaza göre (üst bar, çentik, telefon
-- simülatörü) kayık olabilir. Bu kayma tahmin edilmez: imlecin altına görünmez sonda hücreleri
-- konur, motorun hangisinin içinde olduğunu bildirmesiyle ölçülür.

local Aligner = require(script.Parent.Aligner)

local Alignment = {}
Alignment.__index = Alignment

export type Alignment = typeof(setmetatable(
	{} :: {
		aligner: any,
		probes: { Frame },
		rawX: number,
		rawY: number,
		hasMouse: boolean,
	},
	Alignment
))

-- parent: sondaların konacağı, ekranı kaplayan çerçeve (konumu GUI orijinine oturur).
function Alignment.new(parent: GuiObject): Alignment
	local self = setmetatable({
		aligner = Aligner.new(),
		probes = {},
		rawX = 0,
		rawY = 0,
		hasMouse = false,
	}, Alignment)
	for k = 1, Aligner.CELLS do
		local probe = Instance.new("Frame")
		probe.Name = "AlignProbe" .. k
		probe.BackgroundTransparency = 1
		probe.BorderSizePixel = 0
		probe.Active = true
		probe.Visible = false
		probe.ZIndex = 50
		probe.Parent = parent
		probe.MouseMoved:Connect(function(x: number, y: number)
			self.aligner:hit(k, x, y)
			self:place(x, y)
		end)
		self.probes[k] = probe
	end
	return self
end

function Alignment.place(self: Alignment, rawX: number, rawY: number)
	if not self.aligner:active(rawX, rawY) then
		for _, p in self.probes do
			p.Visible = false
		end
		return
	end
	local rects = self.aligner:layout(rawX, rawY)
	for k, probe in self.probes do
		local r = rects[k]
		probe.Position = UDim2.fromOffset(r.x, r.y)
		probe.Size = UDim2.fromOffset(r.w, r.h)
		probe.Visible = true
	end
end

-- Her fare hareketinde çağır (ham koordinat).
function Alignment.onMouse(self: Alignment, rawX: number, rawY: number)
	self.hasMouse = true
	self.rawX, self.rawY = rawX, rawY
	self:place(rawX, rawY)
end

function Alignment.toGui(self: Alignment, rawX: number, rawY: number): (number, number)
	return self.aligner:toGui(rawX, rawY)
end

function Alignment.ready(self: Alignment): boolean
	return self.aligner.everConverged
end

function Alignment.offset(self: Alignment): (number, number)
	return self.aligner.offX, self.aligner.offY
end

return Alignment
]]></ProtectedString>
