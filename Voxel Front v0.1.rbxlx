				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- ShopFlags: mağazanın güne özel bayrakları (oyuna özel tasarımlar; kasadan çıkmaz). RoWorld'ün bayrak dükkanı gibi
-- (src/shared/Data/Shop.luau): her gün (UTC 00:00) oyuncunun sahip olmadıklarından 3 Epic + 1 Legendary; fiyat nadirliğe göre,
-- Robux ya da Medals ile. Görseller tek toplu resimde (Assets.CrateArt.special, shop_flags.png): { x, y, w, h }.
-- Yeni bayrak: toplu resme ekle, buraya bir satır yaz (anahtar asla değişmez: oyuncuların kaydında "shop_<anahtar>").

local ShopFlags = {}

--- Nadirliğe göre fiyat (Robux fiyatı Creator Hub'daki ürününkidir: Assets.Products.shopflag_epic / _legendary).
ShopFlags.PRICES = {
	epic = { robux = 49, medals = 3000, product = "shopflag_epic" },
	legendary = { robux = 99, medals = 6000, product = "shopflag_legendary" },
}
--- Günde: 3 Epic + 1 Legendary.
ShopFlags.DAILY = { epic = 3, legendary = 1 }
--- Oyuncunun kendi ülkesinin bayrağı (Medals ile, bir kez).
ShopFlags.REGION_PRICE = 2000
--- Günlük ödül: bu kadar saatte bir, bu aralıkta rastgele Medals.
ShopFlags.DAILY_REWARD_S = 17 * 3600
ShopFlags.DAILY_REWARD_MIN = 10
ShopFlags.DAILY_REWARD_MAX = 50

ShopFlags.list = {
	{ key = "silver_eagle", name = "Silver Eagle", rarity = "epic", rect = { 6, 4, 228, 152 } },
	{ key = "golden_drake", name = "Golden Drake", rarity = "epic", rect = { 246, 4, 228, 152 } },
	{ key = "amethyst_crown", name = "Amethyst Crown", rarity = "epic", rect = { 486, 4, 228, 152 } },
	{ key = "golden_stag", name = "Golden Stag", rarity = "epic", rect = { 726, 4, 228, 152 } },
	{ key = "white_wolf", name = "White Wolf", rarity = "epic", rect = { 6, 164, 228, 152 } },
	{ key = "blue_comet", name = "Blue Comet", rarity = "epic", rect = { 246, 164, 228, 152 } },
	{ key = "crimson_howl", name = "Crimson Howl", rarity = "epic", rect = { 486, 164, 228, 152 } },
	{ key = "royal_blades", name = "Royal Blades", rarity = "epic", rect = { 726, 164, 228, 152 } },
	{ key = "golden_lion", name = "Golden Lion", rarity = "epic", rect = { 6, 324, 228, 152 } },
	{ key = "celestial_phoenix", name = "Celestial Phoenix", rarity = "legendary", rect = { 244, 334, 232, 131 } },
	{ key = "blazing_lion", name = "Blazing Lion", rarity = "legendary", rect = { 486, 324, 228, 152 } },
	{ key = "crimson_dragon", name = "Crimson Dragon", rarity = "legendary", rect = { 726, 324, 228, 152 } },
	{ key = "storm_trident", name = "Storm Trident", rarity = "legendary", rect = { 6, 484, 228, 152 } },
}

--- Bir UTC günü (0, 1, 2, ...) ve o günün bitmesine kalan saniye.
function ShopFlags.day(t: number?): (number, number)
	local now = t or os.time()
	local d = math.floor(now / 86400)
	return d, (d + 1) * 86400 - now
end

--- Oyuncunun günün bayrakları (eşya kimlikleri "shop_<anahtar>"): sahip olmadıklarından, gün ve oyuncuya göre rastgele
--- (aynı gün aynı oyuncuya hep aynı seçim), önce Legendary sonra Epic'ler. Kalmadıysa daha az.
function ShopFlags.pick(owned: { [string]: any }, day: number, userId: number): { string }
	local rng = Random.new((day * 7919 + userId * 104729) % 2147483647)
	local out = {}
	for _, rarity in { "legendary", "epic" } do
		local pool = {}
		for _, f in ShopFlags.list do
			local id = "shop_" .. f.key
			if f.rarity == rarity and not owned[id] then
				table.insert(pool, id)
			end
		end
		for i = #pool, 2, -1 do
			local j = rng:NextInteger(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end
		for i = 1, math.min((ShopFlags.DAILY :: any)[rarity], #pool) do
			table.insert(out, pool[i])
		end
	end
	return out
end

return ShopFlags
]]></ProtectedString>
