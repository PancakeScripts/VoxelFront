local hover = Instance.new("Frame")
hover.Name = "Hover"
hover.BackgroundTransparency = 1
hover.BorderSizePixel = 0
hover.Visible = false
hover.ZIndex = 5
hover.Parent = frame
local hoverStroke = Instance.new("UIStroke")
