	["Zambia"] = "#659e41", -- (seçildi)
	["Latvia"] = "#bc4b87", -- (seçildi)
	["Bhutan"] = "#915dc5", -- (seçildi)
	["Indonesia"] = "#aa6cd4",
	["East Antarctica"] = "#9e8af9", -- (seçildi)
	["Oman"] = "#fb942c",
	["Morocco"] = "#fcb542",
	["Uruguay"] = "#c54476",
	["Bolivia"] = "#ef6a9a",
	["Alaska"] = "#3596c8", -- (seçildi)
	["Yukon"] = "#40cd9b", -- (seçildi)
	["California"] = "#cf93fb", -- (seçildi)
	["Texas"] = "#5872d2", -- (seçildi)
	["Quebec"] = "#c1cf5c", -- (seçildi)
	["Benin"] = "#fb83bf", -- (seçildi)
	["Senegal"] = "#e05d3d",
	["Kenya"] = "#f8cc43",
	["Pakistan"] = "#bf9cfb",
	["Sri Lanka"] = "#dd577e", -- (seçildi)
}

local PlayerColors = {}

local BOT_GRAY = { 209, 205, 199 }
local kinds: { [number]: number } = {}
local names: { [number]: string } = {} -- ulus adları (rengi adına göre)
local teams: { [number]: number } = {} -- takım maçı: oyuncunun takımı (yoksa / 0: kendi rengi)
local cache: { [number]: { number } } = {}
local named: { [string]: { number } } = {}

local function parse(hex: string): { number }
	local n = tonumber(string.sub(hex, 2), 16) or 0
	return { bit32.rshift(n, 16), bit32.band(bit32.rshift(n, 8), 255), bit32.band(n, 255) }
end

local parsed: { { { number } } } = {}
for k, list in { Palettes.human, Palettes.nation, Palettes.bot } do
	local p = {}
	for i, hex in list do
		p[i] = parse(hex)
	end
	parsed[k] = p
end

-- HSL dönüşümleri (0-255 tamsayı rgb <-> 0..1 h, s, l).
local function toHsl(r: number, g: number, b: number): (number, number, number)
	local rf, gf, bf = r / 255, g / 255, b / 255
	local mx, mn = math.max(rf, gf, bf), math.min(rf, gf, bf)
	local l = (mx + mn) / 2
	local h, s = 0, 0
	if mx ~= mn then
		local d = mx - mn
		s = if l > 0.5 then d / (2 - mx - mn) else d / (mx + mn)
		if mx == rf then
			h = (gf - bf) / d + (if gf < bf then 6 else 0)
		elseif mx == gf then
			h = (bf - rf) / d + 2
		else
			h = (rf - gf) / d + 4
		end
		h /= 6
	end
	return h, s, l
end

local function fromHsl(h: number, s: number, l: number): (number, number, number)
	local function hue(p: number, q: number, t: number): number
		if t < 0 then
			t += 1
		end
		if t > 1 then
			t -= 1
		end
		if t < 1 / 6 then
			return p + (q - p) * 6 * t
		elseif t < 1 / 2 then
			return q
		elseif t < 2 / 3 then
			return p + (q - p) * (2 / 3 - t) * 6
		end
		return p
	end
	local r2: number, g2: number, b2: number = l, l, l
	if s ~= 0 then
		local q = if l < 0.5 then l * (1 + s) else l + s - l * s
		local p = 2 * l - q
		r2, g2, b2 = hue(p, q, h + 1 / 3), hue(p, q, h), (hue(p, q, h - 1 / 3))
	end
	return math.floor(r2 * 255 + 0.5), math.floor(g2 * 255 + 0.5), math.floor(b2 * 255 + 0.5)
end

-- Takım tonu: ana rengin parlaklığı oyuncuya göre biraz kayar (takımdakiler birbirinden ayırt edilsin, takım belli olsun).
local SHADE_STEPS = { 0, 0.07, -0.07, 0.13, -0.12, 0.035, -0.035, 0.1, -0.1 }
local function teamShade(t: number, pid: number): { number }
	local base = parse(Teams.BASE[Teams.name(t)] or "#888888")
	local h, s, l = toHsl(base[1], base[2], base[3])
	local r, g, b = fromHsl(h, s, math.clamp(l + SHADE_STEPS[(pid * 7) % #SHADE_STEPS + 1], 0.2, 0.8))
	return { r, g, b }
end

-- Türü (ve ulusun adını) kaydeder; önceki değerden farklıysa true döner (istemci o oyuncuyu yeniden boyar).
function PlayerColors.setKind(pid: number, kind: number, name: string?): boolean
	local old = kinds[pid] or 0
	local newName = if kind == 1 and name ~= "" then name else nil
	if old == kind and names[pid] == newName then
		return false
	end
	kinds[pid] = kind
	names[pid] = newName
	cache[pid] = nil
	return true
end

-- Adına göre ulus rengi (tabloda yoksa nil).
local function byName(name: string?): { number }?
	if name == nil then
		return nil
	end
	local c = named[name]
	if c == nil then
		local hex = NATION_COLORS[name]
		if hex == nil then
			return nil
		end
		c = parse(hex)
		named[name] = c
	end
	return c
end

function PlayerColors.kindOf(pid: number): number
	return kinds[pid] or 0
end

-- Takımı kaydeder (0 = takımsız); değiştiyse true (istemci o oyuncuyu yeniden boyar).
function PlayerColors.setTeam(pid: number, t: number): boolean
	if (teams[pid] or 0) == t then
		return false
	end
	teams[pid] = if t ~= 0 then t else nil
	cache[pid] = nil
	return true
end

function PlayerColors.teamOf(pid: number): number
	return teams[pid] or 0
end

-- Takımın ana rengi (lider tablosu, takım adı).
function PlayerColors.team(t: number): (number, number, number)
	local c = parse(Teams.BASE[Teams.name(t)] or "#888888")
	return c[1], c[2], c[3]
end

function PlayerColors.resetKinds()
	table.clear(kinds)
	table.clear(names)
	table.clear(teams)
	table.clear(cache)
end

-- 0-255 tamsayı r, g, b. pid 0 (sahipsiz) için gri.
function PlayerColors.rgb(pid: number): (number, number, number)
	if pid <= 0 then
		return 128, 128, 128
	end
	local c = cache[pid]
	if not c then
		local kind = kinds[pid] or 0
		local t = teams[pid]
		if t then
			c = teamShade(t, pid)
		elseif kind == 2 then
			c = BOT_GRAY -- botlar hep aynı gri (OpenFront "Bot" rengi #d1cdc7)
		elseif kind == 1 and byName(names[pid]) then
			c = byName(names[pid]) :: { number }
		else
			local list = parsed[kind + 1]
			c = list[(pid * 17) % #list + 1]
		end
		cache[pid] = c
	end
	return c[1], c[2], c[3]
end

-- Ulusun rengi (menü arka planı gibi oyuncusuz çizimler için): adı tabloda varsa o, yoksa ulus paletinden i. renk.
function PlayerColors.nation(i: number, name: string?): (number, number, number)
	local c = byName(name)
	if c == nil then
		local list = parsed[2]
		c = list[(i * 17) % #list + 1]
	end
	local cc = c :: { number }
	return cc[1], cc[2], cc[3]
end

-- Sınır rengi: dolgu renginin HSL parlaklığı 0.125 azaltılır (repoda borderDarken).
function PlayerColors.border(r: number, g: number, b: number): (number, number, number)
	local h, s, l = toHsl(r, g, b)
	return fromHsl(h, s, math.max(0, l - 0.125))
end

return PlayerColors
]]></ProtectedString>
