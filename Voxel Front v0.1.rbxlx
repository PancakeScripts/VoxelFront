					<string name="Name">Dev</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1c14f2467dd4fbf50afa546d0000ef25</UniqueId>
				</Properties>
				<Item class="ModuleScript" referent="RBXCE1C7BB9B57F45EABF78F03B5337900A">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- LobbyTests: LobbyRules testleri (RoWorld tests/lobbies.luau'daki kural testlerinden uyarlandı, AGPL-3.0, © 2026 Snick Co.).
-- Oyunda çalışmaz; Studio'da elle: require(game.ServerScriptService.Server.Dev.LobbyTests).run()
-- Döner: { passed, failed, lines } (lines: her denetimin sonucu).

local LobbyRules = require(script.Parent.Parent.Lobbies.LobbyRules)
local Catalog = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Maps"):WaitForChild("Catalog"))

local LobbyTests = {}

function LobbyTests.run()
	local passed, failed, lines = 0, 0, {}
	local function expect(cond: any, what: string)
		if cond then
			passed += 1
			table.insert(lines, "  ok   " .. what)
		else
			failed += 1
			table.insert(lines, "FAIL " .. what)
		end
	end
	local function lobby(t: { [string]: any }): any
		local l = { id = "x", map = "world", map_name = "World", max = 50, starts = 100, created = 0, players = 0, status = "open" }
		for k, v in t do
			l[k] = v
		end
		return l
	end

	-- Harita sınırları
	for _, id in Catalog.order do
		local m = Catalog[id].onlineMax
		expect(type(m) == "number" and m >= LobbyRules.MIN_PLAYERS and m <= LobbyRules.MAX_PLAYERS, id .. " online sınırı 10..50: " .. tostring(m))
		expect(LobbyRules.max_players(m, 60) == m, id .. ": 60 kişilik sunucuda haritanın kendi sınırı")
	end
	expect(LobbyRules.max_players(50, 30) == 30, "sunucunun alabildiğinden fazla koltuk yok")
	expect(LobbyRules.max_players(50, 5) == 50, "MIN_PLAYERS altındaki sunucu boyu sınır sayılmaz (Studio)")
	expect(LobbyRules.max_players(500, nil) == 50 and LobbyRules.max_players(2, nil) == 10, "10..50 aralığına sıkıştırılır")

	-- Harita seçimi: rastgele, bir öncekiyle aynı değil
	do
		local ids = Catalog.order
		local rng = Random.new(7)
		local last = nil
		local repeats, counts = 0, {}
		for _ = 1, 6000 do
			local id = LobbyRules.pick_map(ids, if last then { last } else {}, rng:NextNumber())
			if id == last then
				repeats += 1
			end
			counts[id] = (counts[id] or 0) + 1
			last = id
		end
		expect(repeats == 0, "aynı harita arka arkaya hiç gelmez (" .. repeats .. " kez)")
		local fair = true
		for _, id in ids do
			local share = (counts[id] or 0) / 6000
			fair = fair and share > 0.12 and share < 0.22
		end
		expect(fair, "her harita yaklaşık eşit sıklıkta seçilir")
		expect(LobbyRules.pick_map({ "world" }, { "world" }, 0.5) == "world", "tek harita varsa o seçilir")
		expect(LobbyRules.pick_map({}, {}, 0.5) == nil, "harita yoksa nil")
		expect(LobbyRules.pick_map(ids, {}, 0.9999) == ids[#ids] and LobbyRules.pick_map(ids, {}, 0) == ids[1], "r'nin uç değerleri listede kalır")
	end

	-- Zamanlama
	local now = 1000
	local starts = LobbyRules.missing_starts({}, now)
	expect(#starts == LobbyRules.TARGET_OPEN and starts[1] == now + LobbyRules.MIN_LEAD_S, "boş liste -> bir lobi, MIN_LEAD_S sonra")
	expect(starts[#starts] <= now + LobbyRules.LOBBY_OPEN_S, "her lobi LOBBY_OPEN_S içinde başlar")
	do
		-- dolan ya da başlayan lobiler arka arkaya: plan LOBBY_OPEN_S'i aşmaz, hep katılınabilir bir lobi vardır
		local t = 7000
		local list = {}
		local worst, gaps, n = 0, 0, 0
		for step = 1, 300 do
			for _, st in LobbyRules.missing_starts(list, t) do
				n += 1
				table.insert(list, lobby({ id = "v" .. n, starts = st, created = t, max = 30 }))
				worst = math.max(worst, st - t)
			end
			local joinable = 0
			for _, l in list do
				if LobbyRules.joinable(l, t) then
					joinable += 1
				end
			end
			if joinable == 0 then
				gaps += 1
			end
			if step % 3 == 0 then
				-- en yakın lobi doldu (dolu lobi beklemeden başlar)
				local soonest = nil
				for _, l in list do
					if LobbyRules.joinable(l, t) and (soonest == nil or l.starts < soonest.starts) then
						soonest = l
					end
				end
				if soonest then
					soonest.players = soonest.max
					soonest.status = "started"
				end
			end
			t += 3
		end
		expect(worst <= LobbyRules.LOBBY_OPEN_S, "dolan lobiler arka arkaya: hiçbir lobi " .. LobbyRules.LOBBY_OPEN_S .. " sn'den ileri planlanmaz (en kötü " .. worst .. ")")
		expect(gaps == 0, "her an katılınabilir bir lobi var (" .. gaps .. " kez yok)")
	end
	do
		local full = { lobby({ id = "a", starts = now + 60, players = 50 }) }
		local nxt = LobbyRules.missing_starts(full, now)
		expect(#nxt == 1 and nxt[1] == now + LobbyRules.MIN_LEAD_S, "dolan lobinin yerine hemen yenisi açılır")
		local busy = LobbyRules.missing_starts({}, now, nil, { rate = 3, size = 50 })
		expect(#busy > 1 and #busy <= LobbyRules.MAX_OPEN, "yoğun talepte birden çok lobi açılır (" .. #busy .. "), en çok MAX_OPEN")
		local soon = { lobby({ id = "s", starts = now + 10 }) }
		expect(#LobbyRules.missing_starts(soon, now) == 1, "başlamasına az kalan lobinin ardından sıradaki önceden açılır")
		local d = LobbyRules.demand({ lobby({ created = now - 10, players = 20, max = 40 }), lobby({ created = now - 500, players = 50 }) }, now)
		expect(math.abs(d.rate - 20 / 120) < 1e-6 and d.size == 40, "talep yalnız son 2 dakikanın lobilerini sayar")
	end

	-- Katılım ve koltuklar
	do
		local l = lobby({ starts = now + 30, players = 3, code = "secret", psid = "p" })
		expect(LobbyRules.joinable(l, now), "açık lobiye katılınır")
		expect(not LobbyRules.joinable(lobby({ starts = now + 30, players = 50 }), now), "dolu lobiye katılınamaz")
		expect(not LobbyRules.joinable(lobby({ starts = now + LobbyRules.JOIN_CLOSE_S }), now), "başlamaya JOIN_CLOSE_S kala katılım kapanır")
		local view = LobbyRules.public_view(l, now)
		expect(view.code == nil and view.psid == nil and view.starts_in == 30 - LobbyRules.JOIN_CLOSE_S and view.players == 3 and view.max == 50, "istemci erişim kodunu görmez")
		local spec = LobbyRules.take_spec(1, { "11" }, now)
		expect(LobbyRules.fits(l, spec), "uygun lobi koltuk verir")
		local s1 = LobbyRules.seated(l, spec)
		expect(s1.players == 4 and s1.seats["11"] == now and l.players == 3, "koltuk alınır; eski kayıt değişmez")
		local s2 = LobbyRules.seated(s1, spec)
		expect(s2.players == 5 and s2.seats["11"] == now, "aynı oyuncunun defter kaydı bir kez tutulur")
		expect(not LobbyRules.fits(lobby({ starts = now + 30, players = 50 }), spec), "dolu lobi koltuk vermez")
		expect(not LobbyRules.fits(lobby({ starts = now + 3 }), spec), "kapanmış lobi koltuk vermez")
		expect(not LobbyRules.fits(lobby({ starts = now + LobbyRules.MAX_AHEAD_S + 10 }), spec), "yanlış saatle yazılmış lobi koltuk vermez")
		expect(not LobbyRules.fits(l, LobbyRules.take_spec(1, { "11" }, now, "other")), "başka lobi istenince bu lobi verilmez")
		local r1, n1 = LobbyRules.released(s1, { "11", "99" })
		expect(n1 == 1 and r1.players == 3 and r1.seats["11"] == nil, "koltuk geri verilir (yalnız defterdeki)")
		local started = table.clone(s1)
		started.status = "started"
		local _, n2 = LobbyRules.released(started, { "11" })
		expect(n2 == 0, "başlamış maçta koltuk geri verilmez")
		local led = lobby({ seats = { a = now - 5, b = now - 40, c = now - 40, d = now - 5 } })
		local lapsed = LobbyRules.lapsed_seats(led, { a = true, c = true }, { d = true }, now)
		expect(table.concat(lapsed, ",") == "b,d", "gelmeyen ve gelip ayrılanın koltuğu geri verilir: " .. table.concat(lapsed, ","))
	end

	-- Başlama
	do
		local l = lobby({ starts = now + 30, max = 40 })
		expect(not LobbyRules.start_due(l, now, 10), "zaman gelmedi, dolu değil: bekler")
		expect(LobbyRules.start_due(l, now + 30, 1), "zaman gelince başlar")
		expect(LobbyRules.start_due(l, now, 40), "lobi dolunca beklemeden başlar")
		expect(not LobbyRules.start_due(lobby({ starts = now + 30, max = 0 }), now, 0), "kimse yokken dolu sayılmaz")
	end

	-- Kayıt okuma
	do
		expect(LobbyRules.decode(nil) == nil and LobbyRules.decode({ id = "a" }) == nil, "bozuk kayıt atılır")
		local d = LobbyRules.decode({ id = "a", map = "asia", starts = 5, max = 999, players = -3, status = "weird", seats = {} })
		expect(d ~= nil and d.max == 200 and d.players == 0 and d.status == "open" and d.map_name == "asia", "değerler sınırlanır")
		local d2 = LobbyRules.decode({ id = "a", map = "asia", starts = 5, max = 40, seats = { ["12"] = 3, [1] = 4, [string.rep("x", 30)] = 1 } })
		expect(d2 ~= nil and d2.seats["12"] == 3 and d2.seats[1] == nil, "defterde yalnız geçerli kayıtlar kalır")
		expect(LobbyRules.plausible(lobby({ starts = now + 60 }), now) and not LobbyRules.plausible(lobby({ starts = now + 9999 }), now), "yanlış saatle yazılmış kayıt ayırt edilir")
	end

	return { passed = passed, failed = failed, lines = lines }
end

return LobbyTests
]]></ProtectedString>
