						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
--!native
-- Attack: OpenFront AttackExecution / EngineConfig kurallarının Luau uyarlaması (CREDITS.md).
--
--   * Sınır tile'ları bir min-yığında tutulur. Öncelik = (rastgele + 10) * (1 - kendiKomşu*0.5 + arazi/2) + tick.
--     Küçük olan önce alınır: kendi komşusu çok olan tile (cep) hızla kapanır, eski kayıtlar önce işlenir -> düzgün, yuvarlak ilerleme.
--   * Her tick bir "bütçe" (1.0) vardır; her fethedilen tile bütçeden tickFraction kadar harcar. Bütçe bitene dek tile alınır.
--   * Kayıp ve hız formülleri Attack.logic içindedir (sahipsiz toprak ve oyuncuya karşı ayrı).
--   * Karşılıklı saldırılar birbirini götürür; aynı hedefe ikinci saldırı eskisine eklenir.
--   * Savunmacı DEAD_DEFENDER_TILES'ın altına düşünce toprağının tamamı saldırana geçer; 0 tile = elenir.
--   * Sınır kalmazsa kalan asker geri döner; asker 1'in altına düşerse saldırı biter.

local Attack = {}
Attack.__index = Attack

export type Attack = typeof(setmetatable(
	{} :: {
		kind: string,
		pid: number,
		target: number,
		ratio: number,
		troops: number,
		done: boolean,
		heap: any,
		H: any,
		border: { [number]: boolean },
		borderSize: number,
		rng: any,
		nb: { number },
		nb2: { number },
		opts: any,
		fallbackTile: any,
		counted: boolean,
	},
	Attack
))

-- opts (gemi çıkarması): { troops = gemideki asker, source = iniş tile'ı }. Asker zaten oyuncudan düşülmüştür.
function Attack.new(pid: number, target: number, ratio: number, opts: any?): Attack
	return setmetatable({
		kind = "attack",
		pid = pid,
		target = target,
		ratio = ratio,
		troops = 0,
		done = false,
		heap = nil :: any,
		H = nil :: any,
		border = {},
		borderSize = 0,
		rng = nil :: any,
		nb = {},
		nb2 = {},
		opts = opts,
		fallbackTile = nil,
		counted = false,
	}, Attack)
end

local function key(pid: number, target: number): number
	return pid * 65536 + target
end

local function clamp(v: number, lo: number, hi: number): number
	return math.min(math.max(v, lo), hi)
end

-- Büyük bölgelerin avantajı: küçükte ~1, devasa bölgede 1-depth'e iner (logaritmik sigmoid).
local function largeBonus(cfg: any, tiles: number, depth: number): number
	local x = math.log(math.max(tiles, 1))
	local mid = math.log(cfg.ATTACK_LARGE_MIDPOINT)
	local s = 1 / (1 + math.exp(-cfg.ATTACK_LARGE_STEEPNESS * (x - mid)))
	return 1 - depth * s
end

-- Tek tile için sonuç: (saldıran kaybı, savunmacı kaybı, tick bütçesinden harcanan pay).
-- defTroops nil ise hedef sahipsiz topraktır.
function Attack.logic(
	cfg: any,
	terrain: number,
	attackTroops: number,
	attackerTiles: number,
	defTroops: number?,
	defTiles: number,
	borderSize: number,
	attackerIsBot: boolean?,
	defenderHasPost: boolean?,
	defenderIsTraitor: boolean?,
	falloutMul: number?,
	defenderIsBot: boolean?
): (number, number, number)
	local mag = cfg.ATTACK_MAG[terrain] or cfg.ATTACK_MAG[1]
	local tileCost = cfg.ATTACK_TILE_COST[terrain] or cfg.ATTACK_TILE_COST[1]
	if falloutMul then
		mag *= falloutMul -- serpintili tile: kayıp ve süre çarpanı (repo)
		tileCost *= falloutMul
	end
	attackTroops = math.max(attackTroops, 1)
	borderSize = math.max(borderSize, 1)
	if defTroops ~= nil and defenderHasPost then
		mag *= cfg.DEFENSE_POST_DEFENSE_BONUS
		tileCost *= cfg.DEFENSE_POST_SPEED_BONUS
	end

	if defTroops == nil then
		local budget = borderSize * 2
		local cost = clamp(cfg.ATTACK_TERRA_SCALE * tileCost / attackTroops, cfg.ATTACK_TERRA_MIN_COST, cfg.ATTACK_TERRA_MAX_COST)
		return mag / (if attackerIsBot then cfg.BOT_TERRA_LOSS_DIV else cfg.ATTACK_TERRA_LOSS_DIV), 0, cost / budget
	end

	if defenderIsBot and not attackerIsBot then mag *= 0.7 end -- repo BOT_DEFENDER_LOSS_MULT
	local largeAtt = largeBonus(cfg, attackerTiles, cfg.ATTACK_LARGE_ATTACKER_DEPTH)
	local largeDef = largeBonus(cfg, defTiles, cfg.ATTACK_LARGE_DEFENDER_DEPTH)
	local density = defTroops / math.max(defTiles, 1)
	local ratio = defTroops / attackTroops
	local attackerLoss = mag
		* (if defenderIsTraitor then cfg.TRAITOR_DEFENSE_DEBUFF else 1)
		* clamp(ratio, cfg.ATTACK_CHEAPEST_RATIO, 2)
		* (cfg.ATTACK_LOSS_BASE * largeAtt * largeDef + cfg.ATTACK_LOSS_PER_DENSITY * density)
	local speedCost = (clamp(ratio, 0.82, 7.5) * clamp(ratio / 20, 1, 50)) / cfg.ATTACK_SPEED_DIVISOR
	local largeAttSpeed = largeBonus(cfg, attackerTiles, cfg.ATTACK_LARGE_ATTACKER_SPEED_DEPTH)
	return attackerLoss,
		density,
		speedCost * tileCost * largeAttSpeed * largeDef * (if defenderIsTraitor then cfg.TRAITOR_SPEED_DEBUFF else 1) / borderSize
end

-- Sınır -----------------------------------------------------------------------------

local function ownedNeighborCount(self: Attack, world: any, t: number): number
	local n = world:neighbors(t, self.nb2)
	local c = 0
	for k = 1, n do
		if world:ownerAt(self.nb2[k]) == self.pid then
			c += 1
		end
	end
	return c
end

-- Hedefin u tile'ını (saldırana komşu) sınıra ekler, öncelikle yığına koyar.
local function addOne(self: Attack, sim: any, u: number)
	local world, cfg = sim.world, sim.cfg
	if not self.border[u] then
		self.border[u] = true
		self.borderSize += 1
	end
	local mag = cfg.ATTACK_PRIORITY_MAG[world:terrainAt(u)] or 1
	local mine = ownedNeighborCount(self, world, u)
	local priority = (self.rng:int(0, cfg.ATTACK_PRIORITY_RANDOM) + cfg.ATTACK_PRIORITY_BASE) * (1 - mine * 0.5 + mag / 2)
		+ sim.tickNo
	self.H.push(self.heap, u, priority)
end

-- t'nin hedefe ait komşularını sınıra ekler. (Fetihten ÖNCE çağrılır: t henüz saldıranın sayılmaz.)
local function addNeighbors(self: Attack, sim: any, t: number)
	local world = sim.world
	local n = world:neighbors(t, self.nb)
	for k = 1, n do
		local u = self.nb[k]
		if world:isLand(u) and world:ownerAt(u) == self.target then
			addOne(self, sim, u)
		end
	end
end

-- Repo gibi saldıranın sınırı eklenme sırasıyla taranır. Küçük hedefin sınırını
-- taramak aynı tile'ı farklı sayıda/sırada kuyruğa koyarak cephenin şeklini değiştiriyordu.
local function refresh(self: Attack, sim: any)
	local world = sim.world
	self.H.clear(self.heap)
	table.clear(self.border)
	self.borderSize = 0
	for _, t in world:orderedBorderOf(self.pid) do
		if t ~= -1 then
			addNeighbors(self, sim, t)
		end
	end
end

function Attack.finish(self: Attack, sim: any, malusPercent: number?)
	if self.kind == "ended" then
		return
	end
	self.kind = "ended"
	self.done = true
	if sim.alive[self.pid] then
		local survivors = self.troops * (1 - (malusPercent or 0) / 100)
		sim.troops[self.pid] += survivors
	end
	self.troops = 0
	if sim.attackIndex[key(self.pid, self.target)] == self then
		sim.attackIndex[key(self.pid, self.target)] = nil
	end
	if self.counted then
		sim.attackCount[self.pid] = math.max(0, (sim.attackCount[self.pid] or 0) - 1)
	end
end

-- Savunmacının toprağını saldırana (ya da başka komşu oyunculara) devreder; bu tile'sız kalan oyuncu elenir.
function Attack.conquerPlayer(sim: any, pid: number, target: number, lastTile: number?)
	local world = sim.world
	-- Fethedilen oyuncunun altını saldırana geçer (repo conquerGoldAmount: bot ve ulus tamamı, insan yarısı).
	local loot = sim.gold[target] or 0
	local captured = 0
	if loot > 0 then
		captured = if sim.isBot[target] then loot else loot / sim.cfg.CONQUER_GOLD_HUMAN_DIV
		sim.gold[pid] = (sim.gold[pid] or 0) + captured
		sim.gold[target] = 0
	end
	-- Fetih efekti (repo ConquestEvent): fethedilenin bölgesinin ortasında çapraz kılıçlar + "+ altın".
	if not sim.isBot[pid] then
		local center = world:centerOf(target) or lastTile -- son tile da alındıysa fethedilen yer
		if center then
			sim:pushFx({ k = "conquest", pid = pid, tile = center, g = math.floor(captured), name = sim.name[target], human = not sim.isBot[target] })
		end
	end
end

local function absorb(self: Attack, sim: any, lastTile: number?)
	local world, target = sim.world, self.target
	Attack.conquerPlayer(sim, self.pid, target, lastTile)
	-- Hedefin tile'ları: sınır tile'larından başlayıp kendi tile'ları üzerinden yayılarak toplanır (tüm harita taranmaz).
	local tiles: { number } = {}
	local seen: { [number]: boolean } = {}
	local queue: { number } = {}
	for t in world:borderOf(target) do
		seen[t] = true
		queue[#queue + 1] = t
	end
	local nbs: { number } = {}
	local head = 1
	while head <= #queue do
		local t = queue[head]
		head += 1
		tiles[#tiles + 1] = t
		local n = world:neighbors(t, nbs)
		for k = 1, n do
			local u = nbs[k]
			if not seen[u] and world:ownerAt(u) == target then
				seen[u] = true
				queue[#queue + 1] = u
			end
		end
	end
	-- Repo target.tiles(): sahiplenme sırası; hash/BFS sırası devralanı değiştirmemeli.
	table.sort(tiles, function(a: number, b: number): boolean
		return buffer.readu32(world.claimOrder, a * 4) < buffer.readu32(world.claimOrder, b * 4)
	end)
	local out: { number } = {}
	for _ = 1, 100 do
		local progressed = false
		local keep: { number } = {}
		for _, t in tiles do
			local n = world:neighbors(t, out)
			local given = false
			for k = 1, n do
				if world:ownerAt(out[k]) == self.pid then
					world:setOwner(t, self.pid)
					given = true
					break
				end
			end
			if not given then
				for k = 1, n do
					local o = world:ownerAt(out[k])
					if o ~= 0 and o ~= target and not sim.parts.Diplomacy.isAllied(sim, o, target) then
						world:setOwner(t, o)
						given = true
						break
					end
				end
			end
			if given then
				progressed = true
			else
				keep[#keep + 1] = t
			end
		end
		tiles = keep
		if not progressed or #tiles == 0 then
			break
		end
	end
	sim:checkEliminated(target)
end

-- Repo AttackExecution.init: oyuncuya saldırıda (botlar hariç) hedef saldırana geçici ambargo koyar ve ondan gelen
-- ittifak isteğini reddeder. Gemiyle çıkarma da bir saldırıdır (repo: iniş anında AttackExecution kurulur) — sınır
-- kırmızısı (ambargo tonu) bu yüzden gemi saldırısında da iner inmez görünür.
local function hostileStart(sim: any, pid: number, target: number)
	if target ~= 0 and (not sim.isBot[target] or sim.isNation[target]) and (not sim.isBot[pid] or sim.isNation[pid]) then
		local D = sim.parts.Diplomacy
		D.addEmbargo(sim, target, pid, true)
		local req = D.findRequest(sim, target, pid)
		if req then
			D.reject(sim, req)
		end
	end
end

-- Karşılıklı saldırı birbirini götürür (repo): hedefin bana sürmekte olan saldırısı varsa askerler düşülür. Yok olan
-- saldırının askeri geri verilmez. true dönerse bu saldırı tamamen eridi.
local function cancelOpposing(self: Attack, sim: any): boolean
	if self.target == 0 then
		return false
	end
	-- Kara ve çıkarma cepheleri dahil tüm karşı saldırılar, oluşturulma sırası.
 for k = 1, sim.executionCount do
  local incoming = sim.executions[k]
  if not incoming or incoming.kind ~= "attack" or incoming.done or incoming.pid ~= self.target or incoming.target ~= self.pid then continue end
  if incoming.troops > self.troops then
   incoming.troops -= self.troops
   self.troops = 0
   return true
  end
  self.troops -= incoming.troops
  incoming.troops = 0
  incoming:finish(sim)
 end
 return false
end

-- Repo: yeni bir kara saldırısı aynı hedefe giden diğer saldırıları (gemi çıkarmaları dahil) kendine katar.
local function absorbFronts(sim: any, into: Attack)
	for k = 1, sim.executionCount do
		local e = sim.executions[k]
		if e and e ~= into and e.kind == "attack" and not e.done and e.pid == into.pid and e.target == into.target then
			into.troops += e.troops
			e.troops = 0
			e:finish(sim)
		end
	end
end

function Attack.init(self: Attack, sim: any)
	self.done = true
	local cfg, pid, target = sim.cfg, self.pid, self.target

	-- Gemi çıkarması: asker hazır, sınır yalnızca iniş tile'ından başlar; başka saldırıyla birleşmez, sayaca girmez.
	if self.opts then
		local troops = self.opts.troops :: number
		local valid = sim.alive[pid]
			and (target == 0 or (sim.alive[target] and sim.spawned[target] and not sim.parts.Diplomacy.isAllied(sim, pid, target)))
		if valid then
			hostileStart(sim, pid, target)
			local Heap = sim.parts.Heap
			self.heap = Heap.new()
			self.H = Heap
			self.rng = sim.parts.Rng.new(123)
			addNeighbors(self, sim, self.opts.source)
			if Heap.size(self.heap) > 0 then
				self.troops = troops
				if cancelOpposing(self, sim) then
					return
				end
				self.done = false
				return
			end
		end
		if sim.alive[pid] then
			sim.troops[pid] += troops
		end
		return
	end
	local ratio = self.ratio

	if type(target) ~= "number" or target ~= target or target % 1 ~= 0 or target < 0 or target > sim.playerCount then
		sim:emit(pid, "badTarget")
		return
	end
	if type(ratio) ~= "number" or ratio ~= ratio or ratio <= 0 or ratio > 1 then
		sim:emit(pid, "badTarget")
		return
	end
	if sim.phase ~= "run" then
		sim:emit(pid, "notStarted")
		return
	end
	if not sim.spawned[pid] then
		sim:emit(pid, "notSpawned")
		return
	end
	if target == pid or (target ~= 0 and not (sim.alive[target] and sim.spawned[target])) then
		sim:emit(pid, "badTarget")
		return
	end

	local D = sim.parts.Diplomacy
	if target ~= 0 and D.isAllied(sim, pid, target) then
		sim:emit(pid, if D.sameTeam(sim, pid, target) then "teammate" else "allied")
		return
	end

	local amount = math.floor(math.min(sim.troops[pid] * ratio, sim.troops[pid]))
	if amount < cfg.ATTACK_MIN_TROOPS then
		sim:emit(pid, "noTroops")
		return
	end

	-- Oyuncuya saldırı: hedef saldırgandan geçici ambargo koyar ve ondan gelen ittifak isteğini reddeder. (Botlar hariç)
	hostileStart(sim, pid, target)

	-- Repoda her yeni kara saldırısı yeni execution'dır. Önce karşı saldırı
 	-- düşülür, sağ kalırsa eski kendi cephelerini devralır (ters sıra farklı sonuç verir).
 local existing = sim.attackIndex[key(pid, target)]
 if not existing and (sim.attackCount[pid] or 0) >= cfg.ATTACK_MAX_ACTIVE then
		sim:emit(pid, "tooMany")
		return
	end

	local Heap = sim.parts.Heap
	self.heap = Heap.new()
	self.H = Heap
	self.rng = sim.parts.Rng.new(123)
	refresh(self, sim)
	if Heap.size(self.heap) == 0 then
		if self.fallbackTile ~= nil then
			-- Karadan saldırılacak yer yok: gemiyle dene.
			sim:addExecution(sim.parts.Boat.new(pid, self.fallbackTile, self.ratio))
		else
			sim:emit(pid, "noBorder")
		end
		return
	end

	sim.troops[pid] -= amount
	self.troops = amount

	-- Karşılıklı saldırı birbirini götürür.
	if cancelOpposing(self, sim) then
		return
	end
	absorbFronts(sim, self)

	self.done = false
	sim.attackIndex[key(pid, target)] = self
	sim.attackCount[pid] = (sim.attackCount[pid] or 0) + 1
	self.counted = true
end

function Attack.tick(self: Attack, sim: any)
	if self.done then
		return
	end
	local cfg, world, pid, target = sim.cfg, sim.world, self.pid, self.target
	if not sim.alive[pid] then
		self:finish(sim)
		return
	end
	if target ~= 0 and not sim.alive[target] then
		self:finish(sim)
		return
	end
	if target ~= 0 and sim.parts.Diplomacy.isAllied(sim, pid, target) then
		self:finish(sim) -- repo: yeni ittifak, gönüllü geri çekilme cezası uygulanmaz
		return
	end

	local borderSize = self.borderSize + self.rng:int(0, cfg.ATTACK_BORDER_JITTER)
	local budget = 1
	local heap = self.heap
	local guard = 0
	while budget > 0 do
		guard += 1
		if guard > 20000 then
			break
		end
		if self.troops < 1 then
			self.troops = 0
			self:finish(sim)
			return
		end
		if sim.parts.Heap.size(heap) == 0 then
			self:finish(sim) -- (eskiden bitmeden önce tüm sınır boşuna yeniden kuruluyordu)
			return
		end

		local t = sim.parts.Heap.pop(heap) :: number
		if self.border[t] then
			self.border[t] = nil
			self.borderSize -= 1
		end

		if world:ownerAt(t) == target and world:isLand(t) then
			-- hâlâ saldıranın sınırında mı?
			local n = world:neighbors(t, self.nb)
			local onBorder = false
			for k = 1, n do
				if world:ownerAt(self.nb[k]) == pid then
					onBorder = true
					break
				end
			end
			if onBorder then
				addNeighbors(self, sim, t)
				local defTroops: number? = nil
				local defTiles = 1
				if target ~= 0 then
					defTroops = sim.troops[target]
					defTiles = world:tilesOwnedBy(target)
				end
				local lossA, lossD, fraction = Attack.logic(
					cfg,
					world:terrainAt(t),
					self.troops,
					world:tilesOwnedBy(pid),
					defTroops,
					defTiles,
					borderSize,
					sim.isBot[pid] and not sim.isNation[pid],
					target ~= 0 and sim:hasPostNear(t, target),
					target ~= 0 and sim.parts.Diplomacy.isTraitor(sim, target),
					if world:hasFallout(t) then cfg.FALLOUT_DEFENSE - cfg.FALLOUT_DEFENSE_SLOPE * world.falloutCount / math.max(world.landCount, 1) else nil,
					target ~= 0 and sim.isBot[target] and not sim.isNation[target]
				)
				budget -= fraction
				self.troops -= lossA
				if target ~= 0 then
					sim.troops[target] = math.max(0, sim.troops[target] - math.floor(lossD))
				end
				world:setOwner(t, pid)
				if target ~= 0 and world:tilesOwnedBy(target) < cfg.DEAD_DEFENDER_TILES then
					absorb(self, sim, t)
					if not sim.alive[target] then
						self:finish(sim)
						return
					end
				end
			end
		end
	end
end

-- Cephe hattı kümeleri (repo AttackImpl.clusteredPositions): saldırının sınır tile'ları 8 komşulukla bağlı kümelere ayrılır,
-- her kümeden ağırlık merkezine en yakın gerçek sınır tile'ı seçilir. Büyükten küçüğe; `minSize`'dan küçükler atılır
-- (en büyük her zaman kalır); en çok `maxClusters` döner. Sınır boşsa boş liste.
function Attack.clusters(self: Attack, world: any, minSize: number, maxClusters: number): { number }
	local w = world.width
	local visited: { [number]: boolean } = {}
	local found: { { tile: number, size: number } } = {}
	local border = self.border
	for start in border do
		if not visited[start] then
			visited[start] = true
			local queue = { start }
			local qi = 1
			local sx, sy = 0, 0
			while qi <= #queue do
				local t = queue[qi]
				qi += 1
				local x, y = t % w, t // w
				sx += x
				sy += y
				for dy = -1, 1 do
					for dx = -1, 1 do
						if dx ~= 0 or dy ~= 0 then
							local nx, ny = x + dx, y + dy
							if nx >= 0 and nx < w and ny >= 0 and ny < world.height then
								local n = ny * w + nx
								if border[n] and not visited[n] then
									visited[n] = true
									queue[#queue + 1] = n
								end
							end
						end
					end
				end
			end
			local count = #queue
			local cx, cy = sx / count, sy / count
			local best, bestD = queue[1], math.huge
			for _, t in queue do
				local dx, dy = t % w - cx, t // w - cy
				local d = dx * dx + dy * dy
				if d < bestD then
					bestD = d
					best = t
				end
			end
			found[#found + 1] = { tile = best, size = count }
		end
	end
	table.sort(found, function(a: { tile: number, size: number }, b: { tile: number, size: number }): boolean
		return a.size > b.size
	end)
	local out: { number } = {}
	if #found == 0 then
		return out
	end
	if #found == 1 then
		return { found[1].tile }
	end
	for _, c in found do
		if c.size >= minSize and #out < maxClusters then
			out[#out + 1] = c.tile
		end
	end
	if #out == 0 then
		out[1] = found[1].tile
	end
	return out
end

return Attack
]]></ProtectedString>
