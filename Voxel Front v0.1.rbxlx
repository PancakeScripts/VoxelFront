					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">662b0abb37a5a9fc0b00fc910000396f</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXC4DFB7AF8A1F46CBBABB68C28D2AD90B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- CrateArt: kasa eşyalarının toplu resimlerdeki yerleri (görsel kimlikleri Shared.Assets.CrateArt'ta).
--   flags: gerçek ülke bayrakları (Wikimedia Commons, kamu malı / CC0; RoWorld'deki bayrak setiyle aynı):
--          { kod, ad, resim (1..5 = flags_1..5.png), x, y, w, h }  ->  ImageRectOffset = x, y; ImageRectSize = w, h
--   skins: skin önizlemeleri (skin_previews.png) { x, y, w, h }; ResampleMode Pixelated ile çizilir.
-- Yerler bayrakları çizen araçtan çıktı (RoWorld tools/assets/make_flags.py ile aynı ölçüler); elle değiştirme.

local CrateArt = {}

CrateArt.flags = {
	{ "ac", "Ascension Island", 1, 2, 11, 116, 58 },
	{ "ad", "Andorra", 1, 126, 2, 108, 76 },
	{ "ae", "United Arab Emirates", 1, 242, 11, 116, 58 },
	{ "af", "Afghanistan", 1, 363, 2, 114, 76 },
	{ "ag", "Antigua and Barbuda", 1, 483, 2, 114, 76 },
	{ "ai", "Anguilla", 1, 602, 11, 116, 58 },
	{ "al", "Albania", 1, 727, 2, 106, 76 },
	{ "am", "Armenia", 1, 842, 11, 116, 58 },
	{ "ao", "Angola", 1, 3, 82, 114, 76 },
	{ "aq", "Antarctica", 1, 123, 82, 114, 76 },
	{ "ar", "Argentina", 1, 242, 83, 116, 73 },
	{ "as", "American Samoa", 1, 362, 91, 116, 58 },
	{ "at", "Austria", 1, 483, 82, 114, 76 },
	{ "au", "Australia", 1, 602, 91, 116, 58 },
	{ "aw", "Aruba", 1, 723, 82, 114, 76 },
	{ "ax", "Aland Islands", 1, 842, 82, 116, 76 },
