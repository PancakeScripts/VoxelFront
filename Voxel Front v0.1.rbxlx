					<Item class="ModuleScript" referent="RBX5F9FE839309443F4B1A2A299FB5EC221">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Cancel: sürmekte olan bir saldırıyı geri çeker; kalan asker oyuncuya döner.

local Cancel = {}
Cancel.__index = Cancel

export type Cancel = typeof(setmetatable({} :: { pid: number, target: number, done: boolean }, Cancel))

function Cancel.new(pid: number, target: number): Cancel
	return setmetatable({ pid = pid, target = target, done = false }, Cancel)
end

function Cancel.init(self: Cancel, sim: any)
	self.done = true
	if type(self.target) ~= "number" then
		return
	end
	local attack = sim.attackIndex[self.pid * 65536 + self.target]
	if attack then
		-- Oyuncuya yönelik saldırıyı geri çekmek askerin bir kısmına mal olur.
		attack:finish(sim, if self.target ~= 0 then sim.cfg.ATTACK_RETREAT_MALUS else 0)
	end
end

function Cancel.tick(_self: Cancel, _sim: any) end

return Cancel
]]></ProtectedString>
