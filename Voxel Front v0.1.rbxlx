				<Item class="ModuleScript" referent="RBX19B015BD06EA4656894EC9C61E5B00FC">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Trails: nakliye gemisinin arkasında bıraktığı iz, piksel merdiveni yerine düz çizgi parçaları olarak.
-- Geminin (yumuşak hareket eden) konumu örneklenir; örnekler yeni bir doğrudan TOL tile'dan fazla saparsa o noktada
-- köşe sabitlenir (çevrimiçi Douglas-Peucker). Köşe, iki yanından CUT tile kesilerek yumuşatılır (pah), böylece
-- dönüşler keskin görünmez. Çizgiler WorldLayer'ın alt katmanında olduğundan kaydırma/zoom'da yeniden çizilmez.

local WorldLayer = require(script.Parent.WorldLayer)

local Trails = {}
Trails.__index = Trails

local TOL = 0.9 -- sapma eşiği (tile)
local CUT = 2.2 -- köşe pahı (tile, en çok)
local THICK = 0.7 -- çizgi kalınlığı (tile)
local MIN_PX = 0.7 -- uzaktan bakınca da görünsün
local SAMPLE = 0.6 -- bu kadar ilerlemeden yeni örnek alınmaz

type Trail = {
	color: Color3,
	thick: number,
	poly: boolean, -- true: düzgün eğri (bomba yayı) için sabit aralıklı köşeler
	frames: { Frame },
	ax: number, -- son sabit köşe
	ay: number,
	sx: number, -- canlı parçanın başlangıcı (pahdan sonra)
	sy: number,
	px: number?, -- son sabit parçanın başı (pah için kısaltılabilir)
	py: number?,
	lastSeg: Frame?,
	samples: { number }, -- köşeden beri örnekler (x, y, x, y ...)
	lx: number, -- son örnek
	ly: number,
	live: Frame,
}

export type Trails = typeof(setmetatable({} :: { layer: WorldLayer.WorldLayer, list: { [any]: Trail } }, Trails))

function Trails.new(layer: WorldLayer.WorldLayer): Trails
	return setmetatable({ layer = layer, list = {} }, Trails)
end

local function seg(self: Trails, t: Trail): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = t.color
	if t.poly then
		f.BackgroundTransparency = 0.15
	end
	f.ZIndex = 3
	f.Parent = self.layer.under
	table.insert(t.frames, f)
	return f
end

-- Yeni iz (renk: oyuncu rengi denize %85 karışmış).
function Trails.start(self: Trails, id: any, color: Color3, x: number, y: number)
	if self.list[id] then
		return
	end
	local t: Trail = {
		color = color,
		thick = THICK,
		poly = false,
		frames = {},
		ax = x,
		ay = y,
		sx = x,
		sy = y,
		px = nil,
		py = nil,
		lastSeg = nil,
		samples = {},
		lx = x,
		ly = y,
		live = nil :: any,
	}
	t.live = seg(self, t)
	self.layer:line(t.live, x, y, x, y, THICK, MIN_PX)
	self.list[id] = t
end

local function deviation(ax: number, ay: number, bx: number, by: number, px: number, py: number): number
	local dx, dy = bx - ax, by - ay
	local len = math.sqrt(dx * dx + dy * dy)
	if len < 1e-6 then
		return math.sqrt((px - ax) ^ 2 + (py - ay) ^ 2)
	end
	return math.abs((px - ax) * dy - (py - ay) * dx) / len
end

-- Geminin şu anki konumu (tile, ondalıklı).
function Trails.point(self: Trails, id: any, x: number, y: number)
	local t = self.list[id]
	if not t then
		return
	end
	local L = self.layer
	if (x - t.lx) ^ 2 + (y - t.ly) ^ 2 >= SAMPLE * SAMPLE then
		-- köşeden şimdiki konuma doğru; örneklerden biri fazla saparsa son örnekte köşe sabitlenir
		local s = t.samples
		local bent = false
		for i = 1, #s, 2 do
			if deviation(t.ax, t.ay, x, y, s[i], s[i + 1]) > TOL then
				bent = true
				break
			end
		end
		if bent and #s >= 2 then
			local cx, cy = s[#s - 1], s[#s]
			-- sabit parça: canlı başlangıçtan köşeye
			local d1x, d1y = cx - t.sx, cy - t.sy
			local len1 = math.sqrt(d1x * d1x + d1y * d1y)
			local d2x, d2y = x - cx, y - cy
			local len2 = math.sqrt(d2x * d2x + d2y * d2y)
			local cut = math.min(CUT, len1 * 0.45, len2 * 0.45)
			local ex, ey = cx, cy
			local nx, ny = cx, cy
			if cut > 0.05 and len1 > 0 and len2 > 0 then
				ex, ey = cx - d1x / len1 * cut, cy - d1y / len1 * cut
				nx, ny = cx + d2x / len2 * cut, cy + d2y / len2 * cut
			end
			local fixed = t.live
			L:line(fixed, t.sx, t.sy, ex, ey, THICK, MIN_PX)
			if ex ~= nx or ey ~= ny then
				L:line(seg(self, t), ex, ey, nx, ny, THICK, MIN_PX) -- pah parçası
			end
			t.lastSeg = fixed
			t.ax, t.ay = cx, cy
			t.sx, t.sy = nx, ny
			t.live = seg(self, t)
			table.clear(s)
		end
		table.insert(s, x)
		table.insert(s, y)
		t.lx, t.ly = x, y
	end
	L:line(t.live, t.sx, t.sy, x, y, THICK, MIN_PX)
end

-- Bomba izi: yay zaten pürüzsüz olduğundan her POLY_STEP tile'da bir köşe sabitlenir (kısa düz parçalar eğriyi
-- izler, piksel merdiveni oluşmaz). Canlı parça son köşeden bombanın şu anki yerine uzanır.
local POLY_STEP = 3
function Trails.startPoly(self: Trails, id: any, color: Color3, x: number, y: number, thick: number)
	if self.list[id] then
		return
	end
	local t: Trail = {
		color = color,
		thick = thick,
		poly = true,
		frames = {},
		ax = x,
		ay = y,
		sx = x,
		sy = y,
		px = nil,
		py = nil,
		lastSeg = nil,
		samples = {},
		lx = x,
		ly = y,
		live = nil :: any,
	}
	t.live = seg(self, t)
	self.layer:line(t.live, x, y, x, y, thick, MIN_PX)
	self.list[id] = t
end

function Trails.pointPoly(self: Trails, id: any, x: number, y: number)
	local t = self.list[id]
	if not t then
		return
	end
	self.layer:line(t.live, t.sx, t.sy, x, y, t.thick, MIN_PX)
	if (x - t.sx) ^ 2 + (y - t.sy) ^ 2 >= POLY_STEP * POLY_STEP then
		t.sx, t.sy = x, y
		t.live = seg(self, t)
		self.layer:line(t.live, x, y, x, y, t.thick, MIN_PX)
	end
end

function Trails.has(self: Trails, id: any): boolean
	return self.list[id] ~= nil
end

function Trails.remove(self: Trails, id: any)
	local t = self.list[id]
	if not t then
		return
	end
	for _, f in t.frames do
		f:Destroy()
	end
	self.list[id] = nil
end

function Trails.clear(self: Trails)
	for id in self.list do
		self:remove(id)
	end
end

return Trails
]]></ProtectedString>
