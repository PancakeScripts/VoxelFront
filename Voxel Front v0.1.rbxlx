			<Item class="ModuleScript" referent="RBXFAAE0E5F89B648A087CFC9B2ADF040AF">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- MapHash: sahiplik haritasının parmak izi (online maçta istemcinin haritası sunucununkiyle aynı mı). Tile başına terimlerin
-- toplamıdır (mod 2^32), bu yüzden tile değişince tüm harita taranmadan güncellenir: h = step(h, tile, eski, yeni).
-- Değer ağdaki sahip değeridir (serpintili sahipsiz tile 0x8000 dahil); sahipsiz (0) tile'ın terimi 0.

local MapHash = {}

local P = 65521
local M = 4294967296

function MapHash.term(tile: number, v: number): number
	if v == 0 then
		return 0
	end
	return ((tile + 1) % P * ((v * 40503 + 12345) % P + 1) + tile * 31) % M
end

function MapHash.step(h: number, tile: number, old: number, new: number): number
	if old == new then
		return h
	end
	return (h + MapHash.term(tile, new) - MapHash.term(tile, old)) % M
end

--- Tüm haritanın parmak izi (u16 sahip tamponu; yalnız tam durum yüklenince).
function MapHash.full(owners: buffer, size: number): number
	local h = 0
	for i = 0, size - 1 do
		local v = buffer.readu16(owners, i * 2)
		if v ~= 0 then
			h = (h + MapHash.term(i, v)) % M
		end
	end
	return h
end

return MapHash
]]></ProtectedString>
