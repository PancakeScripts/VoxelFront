						<string name="Name">StructMath</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">15474ccd123c712a0af50f5100000be3</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX8B71C0A3F5444150AACA8CEB428770D5">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Structures: haritadaki yapı simgeleri (repo StructurePass + StructureLevelPass + BarPass ilerleme çubuğu).
--   * Şekil türe göre: şehir daire, liman beşgen, fabrika altıgen, savunma kulesi sekizgen, SAM kare, silo üçgen.
--   * Dolgu = sahibinin bölge rengi (koyulaştırılmış), kenar = sınır rengi (çok koyu); ortada beyaz simge.
--   * İnşaat sürerken gri; silinmek üzere işaretliyse kırmızı çarpı; seviye 2+ ise üstünde rakam.
--   * Boy zoomla repo formülüyle değişir (Look.Structure): uzakta nokta, orta zoomda sabit piksel, yakında haritayla büyür.
-- Simgeler harita boyutundaki bir katmanda ÖLÇEK konumuyla durur: kaydırmada hiçbir şey güncellenmez, boy yalnız zoom
-- piksel boyu değiştirince güncellenir.

local Fonts = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Fonts"))
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Look = require(Shared:WaitForChild("Look"))
local Assets = require(Shared:WaitForChild("Assets"))
local PlayerColors = require(Shared:WaitForChild("PlayerColors"))
local Icons = require(script.Parent.Icons)
local StructMath = require(script.Parent.StructMath)

local Structures = {}
Structures.__index = Structures

local LS = Look.Structure
local TYPES = { "city", "port", "factory", "post", "sam", "silo" }

export type Entry = {
	root: Frame,
	shape: ImageLabel?,
	fill: ImageLabel?,
	glyph: ImageLabel?,
	letter: TextLabel?,
	outline: ImageLabel?, -- yapı düğmesinin üstüne gelince beyaz dış çizgi (repo build-button highlight)
	level: TextLabel,
	bar: Frame,
	barFill: Frame,
	cross: Frame,
	kind: string,
	tile: number,
	sig: string,
	st: any,
}

export type Structures = typeof(setmetatable(
	{} :: {
		layer: Frame,
		w: number,
		h: number,
		zoom: number,
		px: { [string]: number },
		entries: { [number]: Entry }, -- tile -> görsel
		list: { any },
		ghost: Entry?,
		ghostUp: Entry?,
		useImages: boolean,
		myPid: number,
		highlight: { [string]: boolean }?, -- yapı düğmesi üstündeyken vurgulanan türler (diğerleri soluk)
	},
	Structures
))

local function corner(p: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(r, 0)
	c.Parent = p
end

function Structures.new(layer: Frame, mapW: number, mapH: number): Structures
	local self = setmetatable({
		layer = layer,
		w = mapW,
		h = mapH,
		zoom = 1,
		px = {},
		entries = {},
		list = {},
		ghost = nil :: Entry?,
		ghostUp = nil :: Entry?,
		useImages = true,
		myPid = 0,
		highlight = nil :: { [string]: boolean }?,
	}, Structures)
	-- şekil maskelerini önceden hazırla (EditableImage açılamazsa eski kare/daire çizimine düşülür)
	for _, k in TYPES do
		if not Icons.shape(k, 0) or not Icons.shape(k, LS.borderWidth / (LS.scale[k] or 1)) then
			self.useImages = false
			break
		end
	end
	self:setZoom(1)
	return self
end

-- Bir yapı görseli kurar (harita katmanında, ölçek konumlu).
local function build(self: Structures, kind: string, z: number): Entry
	local root = Instance.new("Frame")
	root.Name = "S_" .. kind
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.ZIndex = z
	root.Active = false
	local sc = LS.scale[kind] or 1
	local shape, fill, glyph, letter = nil, nil, nil, nil
	if self.useImages then
		local s = Instance.new("ImageLabel")
		s.Name = "Shape"
		s.BackgroundTransparency = 1
		s.Size = UDim2.fromScale(1, 1)
		s.ImageContent = Icons.shape(kind, 0) :: Content
		s.ZIndex = z
		s.Parent = root
		shape = s
		local f = Instance.new("ImageLabel")
		f.Name = "Fill"
		f.BackgroundTransparency = 1
		f.Size = UDim2.fromScale(1, 1)
		f.ImageContent = Icons.shape(kind, LS.borderWidth / sc) :: Content
		f.ZIndex = z
		f.Parent = root
		fill = f
	else
		-- yedek: renkli daire / yuvarlak kare + kenar
		root.BackgroundTransparency = 0
		corner(root, if kind == "city" or kind == "port" then 0.5 else 0.2)
		local st = Instance.new("UIStroke")
		st.Name = "Stroke"
		st.Thickness = 2
		st.Parent = root
	end
	local g = Instance.new("ImageLabel")
	g.Name = "Glyph"
	g.BackgroundTransparency = 1
	g.AnchorPoint = Vector2.new(0.5, 0.5)
	local gs = (LS.iconFill[kind] or 0.85) / sc
	local gy = 0.5
	if self.useImages then
		-- görsel şeklin kenar çizgisinin içine tam sığsın: ölçülmüş boy (Look.Structure.glyphFit); yoksa şeklin içindeki en
		-- büyük kare
		local fit = (LS :: any).glyphFit and (LS :: any).glyphFit[kind]
		if fit then
			gs = fit[1] * 0.98
			gy = 0.5 + fit[2]
		else
			local box, dy = Icons.innerBox(kind, LS.borderWidth / sc)
			gs = box * 0.96
			gy = 0.5 + dy
		end
	end
	g.Position = UDim2.fromScale(0.5, gy)
	g.Size = UDim2.fromScale(gs, gs)
	g.ScaleType = Enum.ScaleType.Fit
	g.ZIndex = z + 1
	g.Parent = root
	if Icons.apply(g, kind, (Assets.Structures :: any)[kind]) then
		glyph = g
	else
		g:Destroy()
		local l = Instance.new("TextLabel")
		l.Name = "Letter"
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.fromScale(0.5, gy)
		l.Size = UDim2.fromScale(gs, gs)
		l.FontFace = Fonts.main
		l.TextScaled = true
		l.TextColor3 = Color3.new(1, 1, 1)
		l.Text = (Assets.Fallback.Structures :: any)[kind] or "?"
		l.ZIndex = z + 1
		l.Parent = root
		letter = l
	end
	-- seviye rakamı (repo StructureLevelPass: beyaz, koyu kenarlı, simgenin üst kenarında)
	local lv = Instance.new("TextLabel")
	lv.Name = "Level"
	lv.BackgroundTransparency = 1
	lv.AnchorPoint = Vector2.new(0.5, 0.5)
	local lh = LS.levelText * 2 / sc
	lv.Size = UDim2.fromScale(1.4, lh)
	lv.Position = UDim2.fromScale(0.5, 0.5 - 0.75 * 0.5 / sc)
	lv.FontFace = Fonts.main
	lv.TextScaled = true
	lv.TextColor3 = Color3.new(1, 1, 1)
	lv.TextStrokeColor3 = Color3.new(0, 0, 0)
	lv.TextStrokeTransparency = 0
	lv.ZIndex = z + 2
	lv.Visible = false
	lv.Parent = root
	-- ilerleme çubuğu (repo BarPass: 14x3 tile, merkezin 6 tile altında) — boyu setZoom'da
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.AnchorPoint = Vector2.new(0.5, 0.5)
	bar.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	bar.BorderSizePixel = 0
	bar.ZIndex = z + 2
	bar.Visible = false
	bar.Parent = root
	local bf = Instance.new("Frame")
	bf.Name = "Fill"
	bf.BorderSizePixel = 0
	bf.Size = UDim2.fromScale(0, 1)
	bf.ZIndex = z + 3
	bf.Parent = bar
	-- silinme çarpısı (repo: kırmızı X)
	local cross = Instance.new("Frame")
	cross.Name = "Delete"
	cross.BackgroundTransparency = 1
	cross.Size = UDim2.fromScale(1, 1)
	cross.ZIndex = z + 2
	cross.Visible = false
	cross.Parent = root
	for i = 1, 2 do
		local line = Instance.new("Frame")
		line.BorderSizePixel = 0
		line.BackgroundColor3 = Color3.fromRGB(255, 64, 64)
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.Position = UDim2.fromScale(0.5, 0.5)
		line.Size = UDim2.new(1.2, 0, 0.09, 0)
		line.Rotation = if i == 1 then 45 else -45
		line.ZIndex = z + 2
		line.Parent = cross
	end
	root.Parent = self.layer
	return {
		root = root,
		shape = shape,
		fill = fill,
		glyph = glyph,
		letter = letter,
		outline = nil,
		level = lv,
		bar = bar,
		barFill = bf,
		cross = cross,
		kind = kind,
		tile = -1,
		sig = "",
		st = nil,
	}
end

-- Renkler (repo structure.frag.glsl): dolgu = bölge rengi x fillDarken; kenar = sınır rengi x borderDarken
-- (kendi yapılarımda kenar için bölge rengi: benim sınırım açık gri olduğundan).
local function colors(self: Structures, pid: number, ready: boolean): (Color3, Color3)
	if not ready then
		return LS.buildingFill, LS.buildingBorder
	end
	local r, g, b = PlayerColors.rgb(pid)
	local fr, fg, fb = StructMath.darken(r, g, b, LS.fillDarken)
	local br, bg, bb = r, g, b
	if pid ~= self.myPid then
		br, bg, bb = PlayerColors.border(r, g, b)
	end
	br, bg, bb = StructMath.darken(br, bg, bb, LS.borderDarken)
	return Color3.fromRGB(fr, fg, fb), Color3.fromRGB(br, bg, bb)
end

-- alpha nil = haritadaki gerçek yapı (vurgulama soluklaştırması uygulanır); sayı = önizleme.
local function paint(self: Structures, e: Entry, pid: number, ready: boolean, tint: Color3?, alpha: number?)
	local fillC, borderC = colors(self, pid, ready)
	if tint then
		fillC = fillC:Lerp(tint, 0.5)
		borderC = borderC:Lerp(tint, 0.5)
	end
	local a = alpha or 1
	local hl = self.highlight
	if alpha == nil and hl then
		if hl[e.kind] then
			-- vurgulanan tür: şeklin dışında beyaz bant (repo highlightOutlineWidth 0.04)
			if not e.outline and self.useImages then
				local o = Instance.new("ImageLabel")
				o.Name = "Outline"
				o.BackgroundTransparency = 1
				o.Size = UDim2.fromScale(1, 1)
				o.ImageContent = Icons.shape(e.kind, -LS.highlightOutline / (LS.scale[e.kind] or 1)) :: Content
				o.ImageColor3 = Color3.new(1, 1, 1)
				o.ZIndex = e.root.ZIndex - 1 -- şeklin altında: yalnız dışarı taşan bant görünür
				o.Parent = e.root
				e.outline = o
			end
		else
			a *= LS.highlightDim
		end
	end
	if e.outline then
		e.outline.Visible = alpha == nil and hl ~= nil and hl[e.kind] == true
	end
	local tr = 1 - a
	if e.shape and e.fill then
		e.shape.ImageColor3 = borderC
		e.fill.ImageColor3 = fillC
		e.shape.ImageTransparency = tr
		e.fill.ImageTransparency = tr
	else
		e.root.BackgroundColor3 = fillC
		e.root.BackgroundTransparency = tr
		local st = e.root:FindFirstChild("Stroke") :: UIStroke?
		if st then
			st.Color = borderC
			st.Transparency = tr
		end
	end
	local gc = if tint then Color3.new(1, 1, 1):Lerp(tint, 0.5) else Color3.new(1, 1, 1)
	if e.glyph then
		e.glyph.ImageColor3 = gc
		e.glyph.ImageTransparency = tr
	elseif e.letter then
		e.letter.TextColor3 = gc
		e.letter.TextTransparency = tr
	end
	e.level.TextTransparency = tr
	e.level.TextStrokeTransparency = tr
end

local function sizeEntry(self: Structures, e: Entry)
	local p = self.px[e.kind] or 20
	e.root.Size = UDim2.fromOffset(p, p)
	local dots = StructMath.dots(LS :: any, self.zoom)
	if e.glyph then
		e.glyph.Visible = not dots
	elseif e.letter then
		e.letter.Visible = not dots
	end
	e.level.Visible = e.st ~= nil and e.st.level > 1 and not dots
end

-- çubuk: 14 x 3 tile, merkezin 6 tile altında (en az 14 x 3 piksel, simgenin altında kalır)
local function sizeBar(self: Structures, e: Entry)
	local z = self.zoom
	local p = self.px[e.kind] or 20
	e.bar.Size = UDim2.fromOffset(math.max(14, 14 * z), math.max(3, 3 * z))
	e.bar.Position = UDim2.new(0.5, 0, 0.5, math.max(p * 0.5 + 3, 6 * z))
end

-- Zoom değişince: tür başına piksel boyu değiştiyse simgeleri yeniden boyutlandırır.
function Structures.setZoom(self: Structures, zoom: number)
	self.zoom = zoom
	local changed = false
	for _, k in TYPES do
		local p = StructMath.px(LS :: any, k, zoom)
		if self.px[k] ~= p then
			self.px[k] = p
			changed = true
		end
	end
	local dotsNow = StructMath.dots(LS :: any, zoom)
	if changed or (self :: any).lastDots ~= dotsNow then
		(self :: any).lastDots = dotsNow
		for _, e in self.entries do
			sizeEntry(self, e)
		end
	end
end

-- Yapının ekrandaki piksel boyu (fare ile yakalama için).
function Structures.sizeOf(self: Structures, kind: string): number
	return self.px[kind] or 20
end

-- Sunucudan gelen yapı listesiyle eşitler. st: { tile, type, pid, level, ready, bar, p, d, del? }
function Structures.sync(self: Structures, list: { any }, myPid: number)
	if myPid ~= self.myPid then
		self.myPid = myPid
		for _, e in self.entries do
			e.sig = "" -- renkler değişebilir (benim kenar rengim)
		end
	end
	self.list = list
	local seen: { [number]: boolean } = {}
	for _, st in list do
		local tile = st.tile :: number
		seen[tile] = true
		local e = self.entries[tile]
		if e and e.kind ~= st.type then
			e.root:Destroy()
			e = nil
			self.entries[tile] = nil
		end
		if not e then
			local ne = build(self, st.type, 6)
			ne.tile = tile
			local x, y = tile % self.w, tile // self.w
			ne.root.Position = UDim2.fromScale((x + 0.5) / self.w, (y + 0.5) / self.h)
			self.entries[tile] = ne
			sizeEntry(self, ne)
			e = ne
		end
		local ent = e :: Entry
		ent.st = st
		local sig = table.concat({ st.pid, st.level, tostring(st.ready), tostring(st.bar == "delete") }, "|")
		if ent.sig ~= sig then
			ent.sig = sig
			paint(self, ent, st.pid, st.ready, nil, nil)
			ent.level.Text = tostring(st.level)
			ent.cross.Visible = st.bar == "delete"
		end
		ent.level.Visible = st.level > 1 and not StructMath.dots(LS :: any, self.zoom)
		local hasBar = st.bar ~= nil and st.p ~= nil
		if hasBar and not ent.bar.Visible then
			sizeBar(self, ent)
		end
		ent.bar.Visible = hasBar
	end
	for tile, e in self.entries do
		if not seen[tile] then
			e.root:Destroy()
			self.entries[tile] = nil
		end
	end
end

-- İlerleme çubukları her karede (sunucu saniyede bir yollar; arası tick hızıyla tahmin).
function Structures.step(self: Structures, elapsed: number, tickRate: number, colorOf: (p: number, bar: string) -> Color3)
	for _, e in self.entries do
		local st = e.st
		if st and st.bar and st.p and st.d then
			local p = math.clamp(st.p + elapsed * tickRate / st.d, 0, 1)
			e.barFill.Size = UDim2.fromScale(p, 1)
			e.barFill.BackgroundColor3 = colorOf(p, st.bar)
			sizeBar(self, e)
		end
	end
end

-- Kurma önizlemesi (repo: yarı saydam; yükseltmede yeşil, yapılamazsa kırmızı ton; yükseltilecek yapı yeşil parlar).
-- kind nil ise gizler.
function Structures.setGhost(self: Structures, kind: string?, x: number?, y: number?, pid: number, state: string, upTile: number?)
	local g = self.ghost
	if kind == nil or x == nil or y == nil then
		if g then
			g.root.Visible = false
		end
		if self.ghostUp then
			(self.ghostUp :: Entry).root.Visible = false
		end
		return
	end
	if not g or g.kind ~= kind then
		if g then
			g.root:Destroy()
		end
		g = build(self, kind, 10)
		self.ghost = g
	end
	local ge = g :: Entry
	sizeEntry(self, ge)
	ge.root.Position = UDim2.fromScale((x :: number) / self.w, (y :: number) / self.h)
	local tint = if state == "upgrade" then Color3.new(0, 0.8, 0) elseif state == "bad" then Color3.new(0.8, 0.2, 0.2) else nil
	paint(self, ge, pid, true, tint, Look.Ghost.alpha)
	ge.root.Visible = true
	-- yükseltilecek yapıyı yeşil vurgula
	local up = self.ghostUp
	if upTile and state == "upgrade" then
		if not up or up.kind ~= kind then
			if up then
				up.root:Destroy()
			end
			up = build(self, kind, 9)
			self.ghostUp = up
		end
		local ue = up :: Entry
		sizeEntry(self, ue)
		ue.root.Position = UDim2.fromScale((upTile % self.w + 0.5) / self.w, (upTile // self.w + 0.5) / self.h)
		paint(self, ue, pid, true, Color3.new(0, 0.8, 0), Look.Ghost.upgradeAlpha)
		ue.root.Visible = true
	elseif up then
		up.root.Visible = false
	end
end

-- Yapı düğmesinin üstüne gelince (repo ToggleStructureEvent): verilen türler beyaz çizgiyle vurgulanır, diğerleri
-- soluklaşır (Look.Structure.highlightDim). nil = normal.
function Structures.setHighlight(self: Structures, types: { [string]: boolean }?)
	local old = self.highlight
	local same = (old == nil) == (types == nil)
	if same and old and types then
		for k in old do
			if not types[k] then
				same = false
			end
		end
		for k in types do
			if not old[k] then
				same = false
			end
		end
	end
	if same then
		return
	end
	self.highlight = types
	for _, e in self.entries do
		if e.st then
			paint(self, e, e.st.pid, e.st.ready, nil, nil)
		end
	end
end

function Structures.clear(self: Structures)
	for _, e in self.entries do
		e.root:Destroy()
	end
	table.clear(self.entries)
end

return Structures
]]></ProtectedString>
